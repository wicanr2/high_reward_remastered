+// windowVerdict 的算術：5% 邊界、skip 優先、視窗長度不為正。
+func TestWindowVerdictArithmetic(t *testing.T) {
+	const window = 2.0
+	want := window * TickHz // 應有的 tick 數（約 36.4）
+	edge := want * 0.95     // 邊界（約 34.6）
+	lo := uint64(math.Floor(edge))
+	hi := uint64(math.Ceil(edge))
+	if float64(lo) >= edge || float64(hi) < edge || hi != lo+1 {
+		t.Fatalf("夾具假設不成立：edge ＝ %v、lo ＝ %d、hi ＝ %d", edge, lo, hi)
+	}
+	now, last := simAt(window), simAt(0)
+	cases := []struct {
+		name  string
+		now   time.Time
+		last  time.Time
+		ticks uint64
+		held  int
+		dirty bool
+		want  adaptVerdict
+	}{
+		{"落後 5% 以上（邊界下一個整數）", now, last, lo, 0, false, verdictLower},
+		{"剛好不落後 5%（邊界上一個整數）", now, last, hi, 0, false, verdictOK},
+		{"完全不落後", now, last, uint64(math.Ceil(want)), 0, false, verdictOK},
+		{"tick 為 0", now, last, 0, 0, false, verdictLower},
+		{"超前", now, last, 1000, 0, false, verdictOK},
+		{"held 大於 0 優先於落後", now, last, 0, 1, false, verdictSkip},
+		{"dirty 優先於落後", now, last, 0, 0, true, verdictSkip},
+		{"held 與 dirty 都有", now, last, 0, 3, true, verdictSkip},
+		{"held 大於 0、不落後", now, last, 100, 1, false, verdictSkip},
+		{"視窗長度為 0：不評估為落後", last, last, 0, 0, false, verdictOK},
+		{"視窗長度為負：不評估為落後", last, now, 0, 0, false, verdictOK},
+		{"視窗長度不為正，held 大於 0", last, last, 0, 1, false, verdictSkip},
+	}
+	for _, c := range cases {
+		if got := windowVerdict(c.now, c.last, c.ticks, c.held, c.dirty); got != c.want {
+			t.Errorf("%s：windowVerdict ＝ %v，應為 %v", c.name, got, c.want)
+		}
+	}
+	// 視窗長度隨 now 與 lastCheck 的差變動（不是固定 2 秒）：4 秒的視窗應有 72.8 個 tick
+	if got := windowVerdict(simAt(4), simAt(0), uint64(math.Floor(4*TickHz*0.94)), 0, false); got != verdictLower {
+		t.Errorf("4 秒視窗落後 6%%：%v", got)
+	}
+	if got := windowVerdict(simAt(4), simAt(0), uint64(math.Ceil(4*TickHz*0.96)), 0, false); got != verdictOK {
+		t.Errorf("4 秒視窗落後 4%%：%v", got)
+	}
+	if verdictSkip == verdictOK || verdictOK == verdictLower || verdictSkip == verdictLower {
+		t.Fatal("三種裁決必須互異")
+	}
+}
