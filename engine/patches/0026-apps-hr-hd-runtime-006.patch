+// -race：前端執行緒並行 HoldAdapt／放開，同時模擬執行緒反覆呼叫 adapt（Run 的檢查點）。
+func TestHoldGateSessionConcurrent(t *testing.T) {
+	s, _ := newAdaptSession(300_000)
+	var stop atomic.Bool
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for !stop.Load() {
+				rel := s.HoldAdapt()
+				rel()
+				rel()
+			}
+		}()
+	}
+	for i := 1; i <= 2000; i++ {
+		s.m.Ticks++ // 永遠落後
+		s.adapt(simAt(float64(2 * i)))
+	}
+	stop.Store(true)
+	wg.Wait()
+	if h, _ := s.hg.take(); h != 0 {
+		t.Fatalf("全部放開後 held ＝ %d", h)
+	}
+}
+
+// 靜態檢查：session.go 非註解行中 adapt( 只出現兩處（定義與 Run 的一次呼叫）；take() 只在 adapt 內呼叫一次；
+// lastCheck、checkTicks 不再是 Run 的區域變數。
+func TestHoldGateStaticChecks(t *testing.T) {
+	b, err := os.ReadFile("session.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var adaptLines, takeLines []string
+	for i, line := range strings.Split(string(b), "\n") {
+		code := line
+		if j := strings.Index(code, "//"); j >= 0 {
+			code = code[:j]
+		}
+		if strings.Contains(code, "adapt(") {
+			adaptLines = append(adaptLines, fmt.Sprintf("%d: %s", i+1, strings.TrimSpace(line)))
+		}
+		if strings.Contains(code, ".take()") {
+			takeLines = append(takeLines, fmt.Sprintf("%d: %s", i+1, strings.TrimSpace(line)))
+		}
+		if strings.Contains(code, "lastCheck :=") || strings.Contains(code, "checkTicks :=") || strings.Contains(code, "var checkTicks") {
+			t.Errorf("session.go:%d lastCheck、checkTicks 應是 Session 欄位，不是區域變數", i+1)
+		}
+	}
+	if len(adaptLines) != 2 || !strings.Contains(adaptLines[0], "s.adapt(now)") || !strings.Contains(adaptLines[1], "func (s *Session) adapt(") {
+		t.Errorf("session.go 非註解行的 adapt( 應只有 Run 的一次呼叫與定義：%v", adaptLines)
+	}
+	if len(takeLines) != 1 || !strings.Contains(takeLines[0], "s.hg.take()") {
+		t.Errorf("session.go 的 take() 應只在 adapt 內呼叫一次：%v", takeLines)
+	}
+}
