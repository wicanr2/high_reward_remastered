+// Session 薄包裝：machine.New() 加 Session 字面值（interval 大於 MinInterval，logf 非 nil，因為降頻會呼叫 setInterval 改 IRQ0Base）。
+func newAdaptSession(interval uint64) (*Session, *[]string) {
+	var logs []string
+	s := &Session{m: machine.New(), interval: interval, logf: func(f string, a ...any) { logs = append(logs, fmt.Sprintf(f, a...)) }}
+	s.lastCheck, s.checkTicks = simT0, 0
+	return s, &logs
+}
+
+func TestHoldGateSessionAdaptWrapper(t *testing.T) {
+	// 落後、無持有：降頻為 90%，記一行，視窗基準重設
+	s, logs := newAdaptSession(300_000)
+	s.m.Ticks = 10 // 2 秒應有約 36 個
+	s.adapt(simAt(2))
+	if !s.lowered || s.interval != 270_000 || len(*logs) != 1 {
+		t.Fatalf("落後應降頻：lowered ＝ %v、interval ＝ %d、日誌 %v", s.lowered, s.interval, *logs)
+	}
+	if s.m.IRQ0Base != 270_000*17000/65536 {
+		t.Fatalf("setInterval 應改 IRQ0Base：%d", s.m.IRQ0Base)
+	}
+	if !s.lastCheck.Equal(simAt(2)) || s.checkTicks != 10 {
+		t.Fatalf("視窗基準應重設為現在：lastCheck ＝ %v、checkTicks ＝ %d", s.lastCheck, s.checkTicks)
+	}
+	// 不落後：不動
+	s, logs = newAdaptSession(300_000)
+	s.m.Ticks = 40
+	s.adapt(simAt(2))
+	if s.lowered || s.interval != 300_000 || len(*logs) != 0 || s.checkTicks != 40 {
+		t.Fatalf("不落後不該降頻：%v %d %v", s.lowered, s.interval, *logs)
+	}
+	// 持有中：不降頻、不記日誌，基準仍重設；放開後下一個視窗（dirty）不評估，再下一個才恢復
+	s, logs = newAdaptSession(300_000)
+	rel := s.HoldAdapt()
+	s.m.Ticks = 10
+	s.adapt(simAt(2))
+	if s.lowered || s.interval != 300_000 || len(*logs) != 0 || !s.lastCheck.Equal(simAt(2)) || s.checkTicks != 10 {
+		t.Fatalf("持有中：lowered ＝ %v、interval ＝ %d、日誌 %v、lastCheck ＝ %v", s.lowered, s.interval, *logs, s.lastCheck)
+	}
+	rel()
+	rel() // 冪等
+	s.m.Ticks = 20
+	s.adapt(simAt(4)) // 放開所在的視窗（dirty）
+	if s.lowered || s.interval != 300_000 || len(*logs) != 0 || s.checkTicks != 20 {
+		t.Fatalf("放開後第一個檢查點應不評估：lowered ＝ %v、日誌 %v", s.lowered, *logs)
+	}
+	s.m.Ticks = 30
+	s.adapt(simAt(6)) // 下一個完整視窗：恢復原判斷（正對照）
+	if !s.lowered || s.interval != 270_000 || len(*logs) != 1 {
+		t.Fatalf("下一個完整視窗應恢復降頻：lowered ＝ %v、interval ＝ %d、日誌 %v", s.lowered, s.interval, *logs)
+	}
+	// 下限判斷留在薄包裝：interval 為 0 或不大於 MinInterval 時直接返回，不改 lowered、不記日誌（但基準仍重設）
+	for _, iv := range []uint64{0, MinInterval, MinInterval - 1} {
+		s, logs = newAdaptSession(iv)
+		s.m.Ticks = 10
+		s.adapt(simAt(2))
+		if s.lowered || s.interval != iv || len(*logs) != 0 || !s.lastCheck.Equal(simAt(2)) {
+			t.Errorf("interval ＝ %d：lowered ＝ %v、interval ＝ %d、日誌 %v", iv, s.lowered, s.interval, *logs)
+		}
+	}
+	// 降到下限：MinInterval 加一點，一次降頻被截在 MinInterval
+	s, _ = newAdaptSession(MinInterval + 1000)
+	s.m.Ticks = 10
+	s.adapt(simAt(2))
+	if !s.lowered || s.interval != MinInterval {
+		t.Fatalf("應截在下限：interval ＝ %d", s.interval)
+	}
+	// 視窗長度為 0：什麼都不做
+	s, logs = newAdaptSession(300_000)
+	s.adapt(simT0)
+	if s.lowered || len(*logs) != 0 {
+		t.Fatalf("視窗長度為 0：lowered ＝ %v、日誌 %v", s.lowered, *logs)
+	}
+}
