@@ -0,0 +1,515 @@
+package hd
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// docs/spec/006 第 4 節與第 10 節：CheckTheme、基底 theme 的逐圖降級、ErrorStats、Preload 的 ctx 取消與 progress。
+// 全部用 writeTheme 在暫存目錄組出的假 theme，不含原版素材。
+
+// ---------- CheckTheme ----------
+
+func TestCheckThemeNilBase(t *testing.T) {
+	dir := writeTheme(t, []fakeRow{{hash: hx('a'), id: "X", w: 4, h: 2, pal: "MAIN", hd: "x.png", pngW: 8, pngH: 4}}, "MAIN")
+	a, err := CheckTheme(nil, dir, 2)
+	if err == nil || a != nil {
+		t.Fatalf("base 為 nil 應回錯誤：a ＝ %v、err ＝ %v", a, err)
+	}
+	if !strings.Contains(err.Error(), "base 為 nil") {
+		t.Fatalf("錯誤訊息要點名 base 為 nil，而不是每個雜湊都「不在基底清冊」：%v", err)
+	}
+	// 對照：有基底時同一個目錄通過
+	if _, err := CheckTheme(baseAssets(t), dir, 2); err != nil {
+		t.Fatalf("對照組應通過：%v", err)
+	}
+}
+
+// 空 hd 欄的列：只略過 PNG 檢查，hash、尺寸、pal 仍檢查。
+func TestCheckThemeEmptyHDColumn(t *testing.T) {
+	base := baseAssets(t)
+	cases := []struct {
+		name string
+		row  fakeRow
+		pals []string
+		want string // 空 ＝ 應被接受
+	}{
+		{"pal 存在", fakeRow{hash: hx('c'), id: "C", w: 6, h: 3, pal: "MAIN"}, []string{"MAIN"}, ""},
+		{"pal 不存在", fakeRow{hash: hx('c'), id: "C", w: 6, h: 3, pal: "NOPE"}, []string{"MAIN"}, "不在 palettes.tsv"},
+		{"雜湊不在基底", fakeRow{hash: hx('d'), id: "D", w: 6, h: 3, pal: "MAIN"}, []string{"MAIN"}, "雜湊不在基底清冊"},
+		{"尺寸與基底不同", fakeRow{hash: hx('c'), id: "C", w: 7, h: 3, pal: "MAIN"}, []string{"MAIN"}, "基底清冊是 6x3"},
+	}
+	for _, c := range cases {
+		dir := writeTheme(t, []fakeRow{c.row}, c.pals...)
+		a, err := CheckTheme(base, dir, 2)
+		if c.want == "" {
+			if err != nil || a == nil {
+				t.Errorf("%s：應被接受：%v", c.name, err)
+			}
+			continue
+		}
+		if err == nil || a != nil || !strings.Contains(err.Error(), c.want) {
+			t.Errorf("%s：應以「%s」被拒絕：a ＝ %v、err ＝ %v", c.name, c.want, a, err)
+		}
+	}
+}
+
+// 成功時回傳載入好的 *Assets（不必再解析一次 TSV），可直接 Get。
+func TestCheckThemeReturnsLoadedAssets(t *testing.T) {
+	base := baseAssets(t)
+	dir := writeTheme(t, []fakeRow{
+		{hash: hx('a'), id: "A", w: 4, h: 2, pal: "MAIN", hd: "ai/a.png", pngW: 8, pngH: 4, fill: snapColA},
+		{hash: hx('c'), id: "C", w: 6, h: 3, pal: "MAIN"},
+	}, "MAIN")
+	a, err := CheckTheme(base, dir, 2)
+	if err != nil || a == nil {
+		t.Fatal(err)
+	}
+	if a.Dir != dir || a.S != 2 || a.Lookup(hx('a')) == nil || a.Palette("MAIN") == nil {
+		t.Fatalf("回傳的 Assets 不完整：%+v", a)
+	}
+	if as := a.Get(hx('a')); as == nil || as.Img.Pix[3] != 255 || as.Img.Pix[0] != snapColA[0] {
+		t.Fatalf("Get 應解出實心 PNG：%+v", as)
+	}
+	if a.Get(hx('c')) != nil {
+		t.Fatal("空 hd 欄的列沒有 HD 圖，Get 應回 nil")
+	}
+	if n, _ := a.ErrorStats(); n != 0 {
+		t.Fatalf("空 hd 欄不是錯誤，Errors ＝ %d", n)
+	}
+}
+
+// TSV 層錯誤（清冊或調色盤缺檔、格式錯誤）一律回錯誤。
+func TestCheckThemeTSVLevelErrors(t *testing.T) {
+	base := baseAssets(t)
+	good := func() string {
+		return writeTheme(t, []fakeRow{{hash: hx('a'), id: "A", w: 4, h: 2, pal: "MAIN", hd: "a.png", pngW: 8, pngH: 4}}, "MAIN")
+	}
+	cases := map[string]func(dir string){
+		"清冊缺檔":  func(dir string) { os.Remove(filepath.Join(dir, "catalog.tsv")) },
+		"調色盤缺檔": func(dir string) { os.Remove(filepath.Join(dir, "palettes.tsv")) },
+		"清冊缺欄位": func(dir string) {
+			os.WriteFile(filepath.Join(dir, "catalog.tsv"), []byte("hash\tid\n"+hx('a')+"\tA\n"), 0o644)
+		},
+		"清冊雜湊長度不對": func(dir string) {
+			os.WriteFile(filepath.Join(dir, "catalog.tsv"), []byte("hash\tid\tw\th\tkind\tpal\thd\nabc\tA\t4\t2\tsprite\tMAIN\t\n"), 0o644)
+		},
+		"調色盤不是 16 色": func(dir string) {
+			os.WriteFile(filepath.Join(dir, "palettes.tsv"), []byte("name\tpalette16\nMAIN\t000000 000001\n"), 0o644)
+		},
+	}
+	for name, mutate := range cases {
+		dir := good()
+		mutate(dir)
+		if a, err := CheckTheme(base, dir, 2); err == nil || a != nil {
+			t.Errorf("%s：應回錯誤（a ＝ %v）", name, a)
+		}
+		// 基底 theme 走 LoadAssets，同樣的 TSV 層錯誤也被拒絕
+		if a, err := LoadAssets(dir, 2); err == nil || a != nil {
+			t.Errorf("%s：LoadAssets 應回錯誤", name)
+		}
+	}
+}
+
+// 問題數超過上限時，錯誤訊息列出前 maxThemeProblems 項並註明另有幾項；順序決定性。
+func TestCheckThemeManyProblemsDeterministic(t *testing.T) {
+	base := baseAssets(t)
+	var rows []fakeRow
+	for i := 0; i < maxThemeProblems+5; i++ {
+		rows = append(rows, fakeRow{hash: fmt.Sprintf("%064x", i+1000), id: fmt.Sprintf("ID%02d", i), w: 4, h: 2, pal: "MAIN"})
+	}
+	dir := writeTheme(t, rows, "MAIN")
+	_, e1 := CheckTheme(base, dir, 2)
+	_, e2 := CheckTheme(base, dir, 2)
+	if e1 == nil || e2 == nil || e1.Error() != e2.Error() {
+		t.Fatalf("同一個目錄兩次檢查的訊息應相同：%v / %v", e1, e2)
+	}
+	if !strings.Contains(e1.Error(), "共 25 項") || !strings.Contains(e1.Error(), "另有 5 項") {
+		t.Fatalf("訊息應記總數與另有幾項：%v", e1)
+	}
+	if n := strings.Count(e1.Error(), "雜湊不在基底清冊"); n != maxThemeProblems {
+		t.Fatalf("列出 %d 項，應為上限 %d", n, maxThemeProblems)
+	}
+}
+
+// ---------- 基底 theme 的逐圖降級 ----------
+
+// 基底 theme 只在 TSV 層錯誤時拒絕；PNG 缺檔、尺寸不符、調色盤缺名維持逐圖退回基底層，其餘圖照常。
+func TestBaseThemePerImageDegradation(t *testing.T) {
+	const S = 2
+	rows := []fakeRow{
+		{hash: hx('1'), id: "MISSING", w: 4, h: 4, pal: "MAIN", hd: "m/missing.png"},                             // PNG 缺檔
+		{hash: hx('2'), id: "SIZE", w: 4, h: 4, pal: "MAIN", hd: "m/size.png", pngW: 7, pngH: 8, fill: snapColB}, // 尺寸不符
+		{hash: hx('3'), id: "PAL", w: 4, h: 4, pal: "NOPE", hd: "m/pal.png", pngW: 8, pngH: 8, fill: snapColB},   // 調色盤缺名
+		{hash: hx('4'), id: "GOOD", w: 4, h: 4, pal: "MAIN", hd: "m/good.png", pngW: 8, pngH: 8, fill: snapColA}, // 正常
+	}
+	dir := writeTheme(t, rows, "MAIN")
+	a, err := LoadAssets(dir, S) // 基底 theme 的載入：逐圖問題不拒絕
+	if err != nil {
+		t.Fatalf("逐圖問題不該讓基底 theme 整個被拒絕：%v", err)
+	}
+	// 四個戳記並排：x ＝ 0、4、8、12，各 4x4
+	const W, H = 16, 4
+	mp, dac := testPalDAC()
+	px := make([]uint8, W*H)
+	for i := range px {
+		px[i] = 1
+	}
+	var stamps []*Stamp
+	for i, r := range rows {
+		stamps = append(stamps, &Stamp{Kind: KindSprite, X: i * 4, Y: 0, W: 4, H: 4, Hash: r.hash, E: filled(16, 1), Seq: uint64(i + 1)})
+	}
+	compose := func(as *Assets) []byte {
+		out := make([]byte, W*S*H*S*4)
+		NewComposer(as, S).Compose(out, px, W, H, mp, &dac, stamps)
+		return out
+	}
+	out := compose(a)
+	base := compose(nil)
+	at := func(buf []byte, x, y int) [4]uint8 {
+		o := (y*W*S + x) * 4
+		return [4]uint8{buf[o], buf[o+1], buf[o+2], buf[o+3]}
+	}
+	for i := 0; i < 3; i++ { // 前三個：退回基底層（與沒有素材的輸出逐像素相同）
+		for _, p := range [][2]int{{i * 8, 0}, {i*8 + 7, 7}} {
+			if at(out, p[0], p[1]) != at(base, p[0], p[1]) {
+				t.Errorf("%s 應退回基底層：(%d,%d) ＝ %v，基底層 %v", rows[i].id, p[0], p[1], at(out, p[0], p[1]), at(base, p[0], p[1]))
+			}
+		}
+	}
+	if at(out, 24, 0) != snapColA || at(out, 31, 7) != snapColA {
+		t.Errorf("GOOD 應照常畫 HD：%v %v", at(out, 24, 0), at(out, 31, 7))
+	}
+	if at(base, 24, 0) == snapColA {
+		t.Fatal("夾具無效：基底層與 GOOD 的顏色相同")
+	}
+	n, first := a.ErrorStats()
+	if n != 3 || !strings.Contains(first, "MISSING") {
+		t.Fatalf("ErrorStats ＝ (%d, %q)，應為 3 筆、第一筆是 PNG 缺檔（戳記順序）", n, first)
+	}
+	compose(a) // 每個雜湊只記一次
+	if n2, _ := a.ErrorStats(); n2 != 3 {
+		t.Fatalf("同一雜湊的失敗只記一次：第二幀後 n ＝ %d", n2)
+	}
+}
+
+// ---------- ErrorStats ----------
+
+func TestErrorStatsBasics(t *testing.T) {
+	var nilAssets *Assets
+	if n, first := nilAssets.ErrorStats(); n != 0 || first != "" {
+		t.Fatalf("nil 的 ErrorStats ＝ (%d, %q)", n, first)
+	}
+	dir := writeTheme(t, []fakeRow{
+		{hash: hx('a'), id: "OK", w: 4, h: 2, pal: "MAIN", hd: "a.png", pngW: 8, pngH: 4},
+		{hash: hx('b'), id: "BAD1", w: 4, h: 2, pal: "MAIN", hd: "b.png"},
+		{hash: hx('c'), id: "BAD2", w: 4, h: 2, pal: "MAIN", hd: "c.png"},
+	}, "MAIN")
+	a, _ := LoadAssets(dir, 2)
+	if n, first := a.ErrorStats(); n != 0 || first != "" {
+		t.Fatalf("尚無錯誤：(%d, %q)", n, first)
+	}
+	a.Get(hx('a'))
+	a.Get(hx('b'))
+	n1, first1 := a.ErrorStats()
+	if n1 != 1 || !strings.Contains(first1, "BAD1") {
+		t.Fatalf("(%d, %q)", n1, first1)
+	}
+	a.Get(hx('c'))
+	n2, first2 := a.ErrorStats()
+	if n2 != 2 || first2 != first1 {
+		t.Fatalf("n 增加後 first 仍是整個 Assets 的第一筆（不是新增的第一筆）：(%d, %q)，先前 %q", n2, first2, first1)
+	}
+	a.Release()
+	if n, first := a.ErrorStats(); n != 0 || first != "" {
+		t.Fatalf("Release 後歸零：(%d, %q)", n, first)
+	}
+}
+
+// 並行的 Get（合成執行緒 append）與 ErrorStats 讀取在 -race 下無競爭；n 單調不減；n 大於 0 時 first 恆等於同一筆。
+func TestErrorStatsConcurrentMonotonic(t *testing.T) {
+	const M = 80
+	var rows []fakeRow
+	for i := 0; i < M; i++ {
+		rows = append(rows, fakeRow{hash: fmt.Sprintf("%064x", i+1), id: fmt.Sprintf("E%02d", i), w: 4, h: 2, pal: "MAIN", hd: fmt.Sprintf("e%02d.png", i)})
+	}
+	dir := writeTheme(t, rows, "MAIN")
+	a, err := LoadAssets(dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	var stop atomic.Bool
+	var readerFail atomic.Value
+	var reads atomic.Int64
+	for r := 0; r < 3; r++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			last, firstSeen := 0, ""
+			for !stop.Load() {
+				n, first := a.ErrorStats()
+				reads.Add(1)
+				switch {
+				case n < last:
+					readerFail.Store(fmt.Sprintf("n 倒退：%d → %d", last, n))
+					return
+				case n > 0 && first == "":
+					readerFail.Store("n > 0 但 first 為空")
+					return
+				case n == 0 && first != "":
+					readerFail.Store("n ＝ 0 但 first 不為空")
+					return
+				case firstSeen != "" && first != firstSeen:
+					readerFail.Store(fmt.Sprintf("first 變了：%q → %q", firstSeen, first))
+					return
+				}
+				last = n
+				if first != "" {
+					firstSeen = first
+				}
+				runtime.Gosched()
+			}
+		}()
+	}
+	var gw sync.WaitGroup
+	for g := 0; g < 4; g++ {
+		gw.Add(1)
+		go func(g int) {
+			defer gw.Done()
+			r := rand.New(rand.NewSource(int64(g)))
+			for _, i := range r.Perm(M) {
+				a.Get(fmt.Sprintf("%064x", i+1))
+				runtime.Gosched()
+			}
+		}(g)
+	}
+	gw.Wait()
+	stop.Store(true)
+	wg.Wait()
+	if v := readerFail.Load(); v != nil {
+		t.Fatal(v)
+	}
+	if n, first := a.ErrorStats(); n != M || first == "" {
+		t.Fatalf("最後 ErrorStats ＝ (%d, %q)，應為 (%d, 非空)", n, first, M)
+	}
+	if reads.Load() < 10 {
+		t.Fatalf("測試無效：讀取者只讀了 %d 次", reads.Load())
+	}
+}
+
+// ---------- Preload ----------
+
+func preloadFixture(t *testing.T, good, bad int) (*Assets, []string) {
+	t.Helper()
+	var rows []fakeRow
+	var hashes []string
+	for i := 0; i < good; i++ {
+		h := fmt.Sprintf("%064x", i+1)
+		rows = append(rows, fakeRow{hash: h, id: fmt.Sprintf("G%02d", i), w: 4, h: 2, pal: "MAIN", hd: fmt.Sprintf("g%02d.png", i), pngW: 8, pngH: 4, fill: snapColA})
+		hashes = append(hashes, h)
+	}
+	for i := 0; i < bad; i++ { // 最後排序的雜湊都是壞的（缺檔）
+		h := strings.Repeat("f", 60) + fmt.Sprintf("%04x", i)
+		rows = append(rows, fakeRow{hash: h, id: fmt.Sprintf("B%02d", i), w: 4, h: 2, pal: "MAIN", hd: fmt.Sprintf("b%02d.png", i)})
+		hashes = append(hashes, h)
+	}
+	a, err := LoadAssets(writeTheme(t, rows, "MAIN"), 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sort.Strings(hashes)
+	return a, hashes
+}
+
+// ctx 在迴圈開頭被取消：回 err != nil，ok 可以大於 0；已解碼的部分留在快取。
+func TestPreloadCancelAtLoopHead(t *testing.T) {
+	a, _ := preloadFixture(t, 5, 0)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	calls := 0
+	ok, failed, err := a.Preload(ctx, func(done, total int) {
+		calls++
+		if done == 2 {
+			cancel() // 第二筆之後取消，下一次迴圈開頭應停止
+		}
+	})
+	if err == nil {
+		t.Fatal("ctx 被取消，err 應不為 nil")
+	}
+	if ok != 2 || failed != 0 || calls != 2 {
+		t.Fatalf("(ok, failed, calls) ＝ (%d, %d, %d)，應為 (2, 0, 2)：取消後不該再解碼", ok, failed, calls)
+	}
+	if err != context.Canceled {
+		t.Fatalf("err ＝ %v，應為 ctx.Err()", err)
+	}
+}
+
+// 迴圈跑完回 err ＝ nil，即使 ctx 在跑完之後才被取消（最後一筆的 progress 內取消）。
+func TestPreloadCompletedThenCanceled(t *testing.T) {
+	a, _ := preloadFixture(t, 4, 1)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ok, failed, err := a.Preload(ctx, func(done, total int) {
+		if done == total {
+			cancel()
+		}
+	})
+	if err != nil || ok != 4 || failed != 1 {
+		t.Fatalf("跑完後才取消：(%d, %d, %v)，應為 (4, 1, nil)", ok, failed, err)
+	}
+	if ctx.Err() == nil {
+		t.Fatal("測試無效：ctx 沒有被取消")
+	}
+}
+
+// 起點就已取消：不解碼、不呼叫 progress。
+func TestPreloadAlreadyCanceled(t *testing.T) {
+	a, _ := preloadFixture(t, 3, 0)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	calls := 0
+	ok, failed, err := a.Preload(ctx, func(int, int) { calls++ })
+	if err == nil || ok != 0 || failed != 0 || calls != 0 {
+		t.Fatalf("(%d, %d, %v)，progress %d 次", ok, failed, err, calls)
+	}
+}
+
+// 清冊 hd 欄全空：(0, 0, nil)，不呼叫 progress，沒有 Errors。
+func TestPreloadEmptyHDColumn(t *testing.T) {
+	dir := writeTheme(t, []fakeRow{
+		{hash: hx('a'), id: "A", w: 4, h: 2, pal: "MAIN"},
+		{hash: hx('b'), id: "B", w: 4, h: 2, pal: "MAIN"},
+	}, "MAIN")
+	a, _ := LoadAssets(dir, 2)
+	calls := 0
+	ok, failed, err := a.Preload(context.Background(), func(int, int) { calls++ })
+	if ok != 0 || failed != 0 || err != nil || calls != 0 {
+		t.Fatalf("(%d, %d, %v)，progress %d 次，應為 (0, 0, nil) 且不呼叫", ok, failed, err, calls)
+	}
+	if n, _ := a.ErrorStats(); n != 0 {
+		t.Fatalf("Errors ＝ %d", n)
+	}
+	// 清冊完全空也一樣
+	empty, _ := LoadAssets(writeTheme(t, nil, "MAIN"), 2)
+	if ok, failed, err := empty.Preload(context.Background(), nil); ok != 0 || failed != 0 || err != nil {
+		t.Fatalf("空清冊：(%d, %d, %v)", ok, failed, err)
+	}
+}
+
+// progress 是阻塞點：阻塞期間，另一個 goroutine 對任意雜湊的 Get 與 ErrorStats() 不被擋、無競爭
+// （progress 在 a.mu 之外呼叫；防禦性測試：正常路徑不會有並行的 Get）。
+func TestPreloadProgressBlockingDoesNotBlockOthers(t *testing.T) {
+	a, hashes := preloadFixture(t, 4, 1) // 排序後最後一個是壞的
+	badHash := hashes[len(hashes)-1]
+	gate := make(chan struct{})
+	entered := make(chan struct{})
+	var once sync.Once
+	type result struct {
+		ok, failed int
+		err        error
+	}
+	res := make(chan result, 1)
+	go func() {
+		ok, failed, err := a.Preload(context.Background(), func(done, total int) {
+			if done == 1 {
+				once.Do(func() { close(entered) })
+				<-gate // 阻塞在 progress 內
+			}
+		})
+		res <- result{ok, failed, err}
+	}()
+	select {
+	case <-entered:
+	case <-time.After(10 * time.Second):
+		t.Fatal("Preload 沒有呼叫 progress")
+	}
+	// 此刻 Preload 停在第一筆的 progress 內；另一個 goroutine 做 Get 與 ErrorStats
+	other := make(chan string, 1)
+	go func() {
+		if as := a.Get(hashes[len(hashes)-2]); as == nil { // 尚未被 Preload 處理的好圖
+			other <- "好圖的 Get 回 nil"
+			return
+		}
+		if as := a.Get(badHash); as != nil { // 壞圖：Get 回 nil，並記錄一筆錯誤
+			other <- "壞圖的 Get 不為 nil"
+			return
+		}
+		if n, first := a.ErrorStats(); n != 1 || !strings.Contains(first, "B00") {
+			other <- fmt.Sprintf("ErrorStats ＝ (%d, %q)", n, first)
+			return
+		}
+		other <- ""
+	}()
+	select {
+	case msg := <-other:
+		if msg != "" {
+			t.Fatal(msg)
+		}
+	case <-time.After(5 * time.Second):
+		close(gate) // 讓 Preload 結束，免得測試殘留 goroutine
+		t.Fatal("progress 阻塞期間 Get 或 ErrorStats 被擋住")
+	}
+	close(gate)
+	select {
+	case r := <-res:
+		if r.err != nil || r.ok != 4 || r.failed != 1 {
+			t.Fatalf("Preload ＝ (%d, %d, %v)，應為 (4, 1, nil)", r.ok, r.failed, r.err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("放行後 Preload 沒有結束")
+	}
+	if n, _ := a.ErrorStats(); n != 1 {
+		t.Fatalf("壞圖只記一次：n ＝ %d", n)
+	}
+}
+
+// Release：快取與錯誤清空，清冊與調色盤保留，之後 Get 重新延遲解碼；先前取得的 *Asset 不受影響。
+func TestReleaseSemantics(t *testing.T) {
+	a, hashes := preloadFixture(t, 2, 1)
+	if _, _, err := a.Preload(context.Background(), nil); err != nil {
+		t.Fatal(err)
+	}
+	held := a.Get(hashes[0])
+	if held == nil {
+		t.Fatal("好圖應已載入")
+	}
+	if n, first := a.ErrorStats(); n != 1 || first == "" {
+		t.Fatalf("預載後 ErrorStats ＝ (%d, %q)", n, first)
+	}
+	snapshot := append([]byte(nil), held.Img.Pix...)
+	a.Release()
+	if n, first := a.ErrorStats(); n != 0 || first != "" {
+		t.Fatalf("Release 後 ErrorStats ＝ (%d, %q)", n, first)
+	}
+	if a.Lookup(hashes[0]) == nil || a.Palette("MAIN") == nil {
+		t.Fatal("Release 後清冊與調色盤應保留")
+	}
+	if total, withHD := a.Entries(); total != 3 || withHD != 3 {
+		t.Fatalf("Entries ＝ %d、%d", total, withHD)
+	}
+	if !bytes.Equal(held.Img.Pix, snapshot) {
+		t.Fatal("Release 不該改動先前 Get 回傳的圖")
+	}
+	again := a.Get(hashes[0])
+	if again == nil || again == held {
+		t.Fatalf("Release 後 Get 應重新解碼出新的 *Asset（again ＝ %p、held ＝ %p）", again, held)
+	}
+	if a.Get(hashes[2]) != nil { // 壞圖重新記錄
+		t.Fatal("壞圖仍應回 nil")
+	}
+	if n, _ := a.ErrorStats(); n != 1 {
+		t.Fatalf("Release 後重新記錄壞圖：n ＝ %d", n)
+	}
+}
