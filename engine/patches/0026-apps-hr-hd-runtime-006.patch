+package runtime
+
+import (
+	"sync"
+	"time"
+)
+
+// 預載與模擬降頻（docs/spec/006 第 4 節「預載與模擬降頻」）。
+//
+// Run 每 2 秒做一次降頻檢查，判斷整個視窗內的 tick 數是否落後 5% 以上。前端切換 HD theme 時的預載是單核解碼，
+// 與模擬、合成、UI 同時進行，雙核機器上可能讓視窗落後而永久降頻。所以前端在切換交易期間持有 holdGate；
+// 與持有時間相交的視窗（含放開當下所在的視窗）只重設基準、不評估。
+
+// holdGate 記錄目前的持有數 held，與「自上次 take 以來有過放開」的 dirty。
+// 放開在同一個臨界區內同時減計數並設 dirty，所以放開之後的第一次 take 一定看到 held 大於 0 或 dirty。
+type holdGate struct {
+	mu    sync.Mutex
+	held  int
+	dirty bool
+}
+
+// hold 取得一次持有，回傳放開函式。放開函式冪等：第二次以後的呼叫什麼都不做（計數不會變負，
+// 也不會吃掉另一個持有者的保護）。
+func (g *holdGate) hold() (release func()) {
+	g.mu.Lock()
+	g.held++
+	g.mu.Unlock()
+	done := false // 受 g.mu 保護
+	return func() {
+		g.mu.Lock()
+		defer g.mu.Unlock()
+		if done {
+			return
+		}
+		done = true
+		g.held--
+		g.dirty = true
+	}
+}
+
+// take 回傳目前的持有數與 dirty，並清除 dirty。Run 只在視窗已滿 2 秒的檢查點呼叫（否則會提早清掉 dirty，
+// 讓下一個檢查點漏掉「放開所在的視窗」）。
+func (g *holdGate) take() (held int, dirty bool) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	held, dirty = g.held, g.dirty
+	g.dirty = false
+	return
+}
+
+// adaptVerdict 是一次降頻檢查的裁決。
+type adaptVerdict int
+
+const (
+	// verdictSkip：視窗與持有時間相交（held 大於 0 或 dirty），不評估，只重設基準。
+	verdictSkip adaptVerdict = iota
+	// verdictOK：視窗內的 tick 數沒有落後 5% 以上。
+	verdictOK
+	// verdictLower：視窗內的 tick 數落後 5% 以上。只表示落後；是否真的降頻（interval 的下限等）由 Session 決定。
+	verdictLower
+)
+
+func (v adaptVerdict) String() string {
+	switch v {
+	case verdictSkip:
+		return "skip"
+	case verdictOK:
+		return "ok"
+	case verdictLower:
+		return "lower"
+	}
+	return "?"
+}
+
+// windowVerdict 是降頻決策的純函式（可注入時鐘）：視窗從 lastCheck 到 now，期間模擬走了 ticks 個 tick。
+// held 大於 0 或 dirty 時回 skip（優先於 tick 數的判斷）；否則 tick 數落後應有數（視窗秒數 × TickHz）的 5% 以上回 lower；
+// 其餘（含視窗長度不為正）回 ok。
+func windowVerdict(now, lastCheck time.Time, ticks uint64, held int, dirty bool) adaptVerdict {
+	if held > 0 || dirty {
+		return verdictSkip
+	}
+	want := now.Sub(lastCheck).Seconds() * TickHz
+	if want <= 0 || float64(ticks) >= want*0.95 {
+		return verdictOK
+	}
+	return verdictLower
+}
+
+// HoldAdapt 取得一次降頻檢查的持有，回傳放開函式（冪等）。持有期間，以及放開當下所在的視窗，
+// Run 的降頻檢查只重設視窗基準、不評估。前端在 HD theme 切換交易（受理 F2 到完成、被拒或丟棄）期間持有。
+func (s *Session) HoldAdapt() (release func()) { return s.hg.hold() }
diff --git a/apps/hr/runtime/holdgate_test.go b/apps/hr/runtime/holdgate_test.go
