+++ b/apps/hr/runtime/holdgate_test.go
@@ -0,0 +1,663 @@
+package runtime
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"math/rand"
+	"os"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// docs/spec/006 第 4 節「預載與模擬降頻」與第 10 節 HoldAdapt 列：holdGate、windowVerdict、Session 的薄包裝。
+// 純邏輯的測試不需要原版；只有 TestHoldGateRunIntegration 需要（缺檔 skip）。
+// 指令：HR_RACE=1 HR_TEST_RUN='HoldGate|WindowVerdict' tools/play.sh test-diag
+
+var simT0 = time.Unix(1_700_000_000, 0)
+
+func simAt(sec float64) time.Time { return simT0.Add(time.Duration(sec * float64(time.Second))) }
+
+// behindTicks 是 5% 以上落後的 tick 數（應有數的 90%），healthyTicks 是不落後的（應有數）。
+func behindTicks(window float64) uint64  { return uint64(math.Floor(window * TickHz * 0.90)) }
+func healthyTicks(window float64) uint64 { return uint64(math.Ceil(window * TickHz)) }
+
+type simEvent struct {
+	at  float64
+	op  string // "hold" 或 "release"
+	who string
+}
+
+type simResult struct {
+	held    int
+	dirty   bool
+	verdict adaptVerdict
+}
+
+// simulate 以注入時鐘重現 Run 的檢查點：依時間順序套用事件，在每個檢查點 take()、裁決、重設視窗基準。
+// 每個視窗的 tick 數都落後 5% 以上（behind ＝ true），或都不落後。
+func simulate(t *testing.T, events []simEvent, checks []float64, behind bool) []simResult {
+	t.Helper()
+	var g holdGate
+	rel := map[string]func(){}
+	last := 0.0
+	var out []simResult
+	ev := 0
+	for _, c := range checks {
+		for ev < len(events) && events[ev].at <= c {
+			e := events[ev]
+			switch e.op {
+			case "hold":
+				rel[e.who] = g.hold()
+			case "release":
+				rel[e.who]()
+			default:
+				t.Fatalf("未知的事件 %q", e.op)
+			}
+			ev++
+		}
+		held, dirty := g.take()
+		ticks := healthyTicks(c - last)
+		if behind {
+			ticks = behindTicks(c - last)
+		}
+		out = append(out, simResult{held, dirty, windowVerdict(simAt(c), simAt(last), ticks, held, dirty)})
+		last = c
+	}
+	if ev != len(events) {
+		t.Fatalf("還有 %d 個事件在最後一個檢查點之後", len(events)-ev)
+	}
+	return out
+}
+
+func wantVerdicts(t *testing.T, name string, got []simResult, want ...adaptVerdict) {
+	t.Helper()
+	var gv []adaptVerdict
+	for _, r := range got {
+		gv = append(gv, r.verdict)
+	}
+	if fmt.Sprint(gv) != fmt.Sprint(want) {
+		t.Errorf("%s：裁決 %v，應為 %v（細節 %+v）", name, gv, want, got)
+	}
+}
+
+func TestHoldGateBasics(t *testing.T) {
+	var g holdGate
+	if h, d := g.take(); h != 0 || d {
+		t.Fatalf("初始 take ＝ (%d, %v)", h, d)
+	}
+	r1 := g.hold()
+	r2 := g.hold()
+	if h, d := g.take(); h != 2 || d {
+		t.Fatalf("兩個持有：(%d, %v)", h, d)
+	}
+	r1()
+	if h, d := g.take(); h != 1 || !d {
+		t.Fatalf("放開一個：(%d, %v)，應為 (1, true)", h, d)
+	}
+	if h, d := g.take(); h != 1 || d {
+		t.Fatalf("take 讀取後清 dirty：(%d, %v)，應為 (1, false)", h, d)
+	}
+	r2()
+	if h, d := g.take(); h != 0 || !d {
+		t.Fatalf("全部放開：(%d, %v)，應為 (0, true)", h, d)
+	}
+	if h, d := g.take(); h != 0 || d {
+		t.Fatalf("(%d, %v)，應為 (0, false)", h, d)
+	}
+}
+
+// 案例 (1)：持有 [0.5, 2.15]，放開落在第二個視窗；放開所在的視窗也不評估，第三個視窗才恢復（正對照）。
+func TestHoldGateWindowCase1(t *testing.T) {
+	ev := []simEvent{{0.5, "hold", "a"}, {2.15, "release", "a"}}
+	got := simulate(t, ev, []float64{2, 4, 6}, true)
+	wantVerdicts(t, "案例 1", got, verdictSkip, verdictSkip, verdictLower)
+	if got[0].held != 1 || got[1].held != 0 || !got[1].dirty || got[2].dirty {
+		t.Errorf("案例 1 的 take 細節不對：%+v", got)
+	}
+}
+
+// 案例 (2)：持有完全落在第一個視窗內 [0.5, 1.5]，只走 dirty 路徑。
+func TestHoldGateWindowCase2(t *testing.T) {
+	ev := []simEvent{{0.5, "hold", "a"}, {1.5, "release", "a"}}
+	got := simulate(t, ev, []float64{2, 4}, true)
+	wantVerdicts(t, "案例 2", got, verdictSkip, verdictLower)
+	if got[0].held != 0 || !got[0].dirty {
+		t.Errorf("案例 2 第一個檢查點應是 (0, dirty)：%+v", got[0])
+	}
+}
+
+// 案例 (3)：持有跨三個檢查點 [0.5, 4.5]。
+func TestHoldGateWindowCase3(t *testing.T) {
+	ev := []simEvent{{0.5, "hold", "a"}, {4.5, "release", "a"}}
+	got := simulate(t, ev, []float64{2, 4, 6, 8}, true)
+	wantVerdicts(t, "案例 3", got, verdictSkip, verdictSkip, verdictSkip, verdictLower)
+}
+
+// 案例 (4)：兩個持有重疊（A [0.5, 1.0]、B [0.8, 2.15]）。
+func TestHoldGateWindowCase4(t *testing.T) {
+	ev := []simEvent{{0.5, "hold", "A"}, {0.8, "hold", "B"}, {1.0, "release", "A"}, {2.15, "release", "B"}}
+	got := simulate(t, ev, []float64{2, 4, 6}, true)
+	wantVerdicts(t, "案例 4", got, verdictSkip, verdictSkip, verdictLower)
+	if got[0].held != 1 || !got[0].dirty { // B 仍持有，A 設過 dirty
+		t.Errorf("案例 4 第一個檢查點應是 (1, dirty)：%+v", got[0])
+	}
+}
+
+// 對照：沒有持有時每個落後的視窗都是 lower；不落後的視窗是 ok；持有時不落後的視窗也是 skip（skip 優先）。
+func TestHoldGateWindowControls(t *testing.T) {
+	wantVerdicts(t, "無持有、落後", simulate(t, nil, []float64{2, 4, 6}, true), verdictLower, verdictLower, verdictLower)
+	wantVerdicts(t, "無持有、不落後", simulate(t, nil, []float64{2, 4, 6}, false), verdictOK, verdictOK, verdictOK)
+	ev := []simEvent{{0.5, "hold", "a"}, {2.15, "release", "a"}}
+	wantVerdicts(t, "持有、不落後", simulate(t, ev, []float64{2, 4, 6}, false), verdictSkip, verdictSkip, verdictOK)
+}
+
+// 案例 (5)：release 呼叫多次，計數不得變負，也不吃掉另一個持有者的保護。
+func TestHoldGateReleaseIdempotent(t *testing.T) {
+	var g holdGate
+	a := g.hold()
+	b := g.hold()
+	a()
+	a()
+	a()
+	if h, d := g.take(); h != 1 || !d {
+		t.Fatalf("A 放開三次後 take ＝ (%d, %v)，應為 (1, true)：B 的保護不得被吃掉", h, d)
+	}
+	b()
+	b()
+	if h, d := g.take(); h != 0 || !d {
+		t.Fatalf("B 放開兩次後 take ＝ (%d, %v)，應為 (0, true)", h, d)
+	}
+	if h, d := g.take(); h != 0 || d {
+		t.Fatalf("重複的 release 不該再設 dirty：(%d, %v)", h, d)
+	}
+	// 計數不得變負：之後再持有一次應是 1
+	c := g.hold()
+	if h, _ := g.take(); h != 1 {
+		t.Fatalf("重複放開後再持有，held ＝ %d，應為 1（計數變負了）", h)
+	}
+	c()
+	// 並行的重複放開
+	r := g.hold()
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); r() }()
+	}
+	wg.Wait()
+	g.take()
+	if h, d := g.take(); h != 0 || d {
+		t.Fatalf("並行重複放開後：(%d, %v)", h, d)
+	}
+	if h, _ := func() (int, bool) { x := g.hold(); defer x(); return g.take() }(); h != 1 {
+		t.Fatalf("並行重複放開後再持有，held ＝ %d，應為 1", h)
+	}
+}
+
+// 案例 (6a)：release 之後緊接的第一次 take（其間沒有別的 take）必回 held > 0 或 dirty。
+// 每個 release() 與緊接的 take() 包在測試層的互斥鎖內（保證兩者之間沒有別的 take），hold() 在鎖外並行。-race。
+func TestHoldGateConcurrentReleaseThenTake(t *testing.T) {
+	var g holdGate
+	var pair sync.Mutex
+	const G, N = 8, 1500
+	var pairs, viol atomic.Int64
+	var wg sync.WaitGroup
+	for i := 0; i < G; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			r := rand.New(rand.NewSource(int64(i)))
+			for k := 0; k < N; k++ {
+				rel := g.hold() // 鎖外並行
+				for s := r.Intn(50); s > 0; s-- {
+					_ = s * s
+				}
+				pair.Lock()
+				rel()
+				h, d := g.take()
+				pair.Unlock()
+				pairs.Add(1)
+				if h <= 0 && !d {
+					viol.Add(1)
+				}
+			}
+		}(i)
+	}
+	wg.Wait()
+	if viol.Load() != 0 {
+		t.Fatalf("%d / %d 次 release 之後緊接的 take 回 (0, false)", viol.Load(), pairs.Load())
+	}
+	if pairs.Load() != G*N {
+		t.Fatalf("pairs ＝ %d", pairs.Load())
+	}
+	if h, _ := g.take(); h != 0 {
+		t.Fatalf("全部放開後 held ＝ %d", h)
+	}
+}
+
+// 案例 (6b)：自由並行（無互斥）。一個 taker 持續 take，多個持有者持續 hold／release；以全域原子時戳記錄每個動作前後。
+// 對每次 take T_i（前一次是 T_{i-1}）與每個持有週期 c，若 c 的 hold() 在 T_i 開始前已回傳，且 c 的 release() 在 T_{i-1} 回傳之後才開始，
+// 則視窗 (T_{i-1}, T_i) 與持有相交，T_i 必回 held > 0 或 dirty。這涵蓋規格的不變式（release 之後緊接的第一次 take，
+// 其間沒有別的 take 回傳），也涵蓋持有橫跨 take 的情形。
+// 時戳的判準都是保守的充分條件：時戳大小只在「確定先後」時才讓不變式成為前提，不會誤判。
+// 代價：release() 與 take() 時間上重疊的情形不在前提內，所以這個檢查抓不到「放開不是原子」的實作
+// （先設 dirty、放開鎖、之後才減計數）；那一類由 TestHoldGateConcurrentNeverHeldAndDirty 負責。
+// 持有者之間留有空檔（held 常為 0），所以 dirty 路徑與 held > 0 路徑都會被走到。
+func TestHoldGateConcurrentFreeRunInvariant(t *testing.T) {
+	var g holdGate
+	var clock atomic.Int64
+	type cycle struct{ hr, rs, rr int64 } // hold 回傳後、release 開始前、release 回傳後的時戳
+	type takeRec struct {
+		ts, te int64
+		held   int
+		dirty  bool
+	}
+	const G, N = 3, 4000
+	cycles := make([][]cycle, G)
+	var wg sync.WaitGroup
+	var holdersDone atomic.Bool
+	for i := 0; i < G; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			r := rand.New(rand.NewSource(int64(100 + i)))
+			cs := make([]cycle, 0, N)
+			for k := 0; k < N; k++ {
+				rel := g.hold()
+				hr := clock.Add(1)
+				for s := r.Intn(6); s > 0; s-- {
+					runtime.Gosched()
+				}
+				if r.Intn(16) == 0 {
+					time.Sleep(time.Duration(r.Intn(100)) * time.Microsecond) // 偶爾橫跨 take
+				}
+				rs := clock.Add(1)
+				rel()
+				rr := clock.Add(1)
+				cs = append(cs, cycle{hr, rs, rr})
+				if r.Intn(8) == 0 { // 空檔：held 為 0
+					time.Sleep(time.Duration(r.Intn(100)) * time.Microsecond)
+				} else {
+					runtime.Gosched()
+				}
+			}
+			cycles[i] = cs
+		}(i)
+	}
+	var takes []takeRec
+	taker := make(chan struct{})
+	go func() {
+		defer close(taker)
+		for {
+			done := holdersDone.Load()
+			ts := clock.Add(1)
+			h, d := g.take()
+			te := clock.Add(1)
+			takes = append(takes, takeRec{ts, te, h, d})
+			if done { // holders 全部結束之後還做了一次 take
+				return
+			}
+			time.Sleep(30 * time.Microsecond)
+		}
+	}()
+	wg.Wait()
+	holdersDone.Store(true)
+	<-taker
+
+	var covered, literal, heldSeen, dirtySeen int
+	var firstBad string
+	for i, tk := range takes {
+		prevEnd := int64(0)
+		if i > 0 {
+			prevEnd = takes[i-1].te
+		}
+		if tk.held > 0 {
+			heldSeen++
+		} else if tk.dirty {
+			dirtySeen++
+		}
+		for _, cs := range cycles {
+			for _, c := range cs {
+				if c.hr < tk.ts && c.rs > prevEnd { // 視窗與這個持有週期確定相交
+					covered++
+					if tk.held <= 0 && !tk.dirty && firstBad == "" {
+						firstBad = fmt.Sprintf("take #%d（ts %d、te %d）回 (0, false)，但持有週期 hold 回傳於 %d、release 開始於 %d（前一次 take 結束於 %d）", i, tk.ts, tk.te, c.hr, c.rs, prevEnd)
+					}
+				}
+			}
+		}
+	}
+	// 規格的字面不變式：對每次 release() 回傳，緊接其後開始的第一次 take()（其間沒有別的 take() 回傳）必回 held > 0 或 dirty。
+	// 前提的充分條件：T 是第一個 ts 大於 rr 的 take，前一次 take 在 release 開始之前就已回傳（te 小於 rs）。
+	for _, cs := range cycles {
+		for _, c := range cs {
+			j := sort.Search(len(takes), func(i int) bool { return takes[i].ts > c.rr })
+			if j == len(takes) {
+				continue
+			}
+			prevEnd := int64(0)
+			if j > 0 {
+				prevEnd = takes[j-1].te
+			}
+			if prevEnd < c.rs {
+				literal++
+				if takes[j].held <= 0 && !takes[j].dirty && firstBad == "" {
+					firstBad = fmt.Sprintf("release 回傳於 %d，緊接的 take #%d 回 (0, false)", c.rr, j)
+				}
+			}
+		}
+	}
+	t.Logf("takes ＝ %d；視窗與持有相交的檢查 %d 次；字面不變式檢查 %d 次；held>0 的 take %d、只有 dirty 的 take %d", len(takes), covered, literal, heldSeen, dirtySeen)
+	if firstBad != "" {
+		t.Fatal(firstBad)
+	}
+	if covered < 200 || literal < 100 || heldSeen == 0 || dirtySeen == 0 {
+		t.Fatalf("測試無效：檢查次數太少或沒有觀察到兩種情形（相交 %d、字面 %d、held>0 %d、dirty %d）", covered, literal, heldSeen, dirtySeen)
+	}
+	if h, _ := g.take(); h != 0 {
+		t.Fatalf("全部放開後 held ＝ %d", h)
+	}
+}
+
+// 放開是原子的：單一持有者，每次 release() 之後等到「在 release 回傳之後才開始」的一次 take 完成，才進行下一次 hold()。
+// 這個協定下 take 不可能看到 (held ＝ 1, dirty ＝ true)：dirty 只由 release 設起，而下一次 hold 發生時 dirty 已被一次 take 清掉。
+// 放開若不是原子的（先設 dirty、放開鎖、之後才減計數），並行的 take 會在中間看到這個組合。
+// 另有有效性閘門：必須看過 (1, false)（take 落在持有期間）與 (0, true)（放開之後的 take）。
+func TestHoldGateConcurrentNeverHeldAndDirty(t *testing.T) {
+	var g holdGate
+	var started, finished atomic.Int64 // taker 的第 n 次 take：started 在呼叫前遞增，finished 在回傳後記錄 n
+	var stop atomic.Bool
+	var both, heldOnly, dirtyOnly, takes atomic.Int64
+	taker := make(chan struct{})
+	go func() {
+		defer close(taker)
+		for !stop.Load() {
+			n := started.Add(1)
+			h, d := g.take()
+			finished.Store(n)
+			takes.Add(1)
+			switch {
+			case h > 0 && d:
+				both.Add(1)
+			case h > 0:
+				heldOnly.Add(1)
+			case d:
+				dirtyOnly.Add(1)
+			}
+			runtime.Gosched()
+		}
+	}()
+	const N = 1500
+	for k := 0; k < N; k++ {
+		rel := g.hold()
+		for s := 0; s < 4; s++ {
+			runtime.Gosched()
+		}
+		rel()
+		s0 := started.Load() // release 已回傳；第 s0+1 次以後的 take 才在 release 之後開始
+		deadline := time.Now().Add(10 * time.Second)
+		for finished.Load() <= s0 {
+			if time.Now().After(deadline) {
+				stop.Store(true)
+				t.Fatal("等不到 release 之後開始的 take")
+			}
+			runtime.Gosched()
+		}
+	}
+	stop.Store(true)
+	<-taker
+	t.Logf("takes ＝ %d；(held>0, dirty) %d 次；只有 held>0 %d 次；只有 dirty %d 次", takes.Load(), both.Load(), heldOnly.Load(), dirtyOnly.Load())
+	if both.Load() != 0 {
+		t.Fatalf("take 看到 (held>0, dirty) %d 次：放開不是原子的", both.Load())
+	}
+	if heldOnly.Load() == 0 || dirtyOnly.Load() == 0 {
+		t.Fatalf("測試無效：沒有觀察到持有期間的 take（%d）或放開之後的 take（%d）", heldOnly.Load(), dirtyOnly.Load())
+	}
+}
