+	"strings"
+	"testing"
+)
+
+// 測試用的假 theme：全部是測試內組出的檔案，不含任何原版素材。
+
+const testPal = "000000 000001 000002 000003 000004 000005 000006 000007 000008 000009 00000A 00000B 00000C 00000D 00000E FFFFFF"
+
+type fakeRow struct {
+	hash, id string
+	w, h     int
+	pal, hd  string
+	pngW     int // 0 ＝ 不寫檔；否則寫這個寬度、高度 2h 的 PNG
+	pngH     int
+	// fill 是 PNG 的實心顏色（NRGBA）；alpha 為 0（預設）時整張全透明，drawStamp 會略過每個像素，
+	// 這樣的素材無法分辨 A、B（docs/spec/006 第 10 節 hdView 列）。需要在 Compose 輸出上區分素材時，alpha 要設 255。
+	fill [4]uint8
+}
+
+func hx(c byte) string { return strings.Repeat(string(c), 64) }
+
+func writeTheme(t *testing.T, rows []fakeRow, pals ...string) string {
+	t.Helper()
+	dir := t.TempDir()
+	var cat strings.Builder
+	cat.WriteString("hash\tid\tw\th\tkind\tpal\thd\n")
+	for _, r := range rows {
+		cat.WriteString(r.hash + "\t" + r.id + "\t" + itoa(r.w) + "\t" + itoa(r.h) + "\tsprite\t" + r.pal + "\t" + r.hd + "\n")
+		if r.pngW > 0 {
+			p := filepath.Join(dir, "x2", filepath.FromSlash(r.hd))
+			os.MkdirAll(filepath.Dir(p), 0o755)
+			f, _ := os.Create(p)
+			im := image.NewNRGBA(image.Rect(0, 0, r.pngW, r.pngH))
+			if r.fill[3] != 0 {
+				for i := 0; i < len(im.Pix); i += 4 {
+					copy(im.Pix[i:i+4], r.fill[:])
+				}
+			}
+			png.Encode(f, im)
+			f.Close()
+		}
+	}
+	os.WriteFile(filepath.Join(dir, "catalog.tsv"), []byte(cat.String()), 0o644)
+	pt := "name\tpalette16\n"
+	for _, p := range pals {
+		pt += p + "\t" + testPal + "\n"
+	}
+	os.WriteFile(filepath.Join(dir, "palettes.tsv"), []byte(pt), 0o644)
+	return dir
+}
+
+func baseAssets(t *testing.T) *Assets {
+	t.Helper()
+	dir := writeTheme(t, []fakeRow{
+		{hash: hx('a'), id: "A:0", w: 4, h: 2, pal: "MAIN", hd: "m/a.png", pngW: 8, pngH: 4},
+		{hash: hx('b'), id: "A:1", w: 4, h: 2, pal: "MAIN", hd: "m/b.png", pngW: 8, pngH: 4},
+		{hash: hx('c'), id: "A:2", w: 6, h: 3, pal: "MAIN"}, // 沒有 HD 圖
+	}, "MAIN")
+	a, err := LoadAssets(dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+
+func TestCheckThemeAcceptsPartialAndReordered(t *testing.T) {
+	base := baseAssets(t)
+	// 只涵蓋部分雜湊（缺 c），列序與 id 內容都和基底不同，調色盤另有一個
+	dir := writeTheme(t, []fakeRow{
+		{hash: hx('b'), id: "Z:9;Z:8", w: 4, h: 2, pal: "MAIN", hd: "ai/b.png", pngW: 8, pngH: 4},
+		{hash: hx('a'), id: "other", w: 4, h: 2, pal: "ALT", hd: "ai/a.png", pngW: 8, pngH: 4},
+	}, "MAIN", "ALT")
+	a, err := CheckTheme(base, dir, 2)
+	if err != nil {
+		t.Fatalf("部分涵蓋、列序不同的 theme 應被接受：%v", err)
+	}
+	if total, withHD := a.Entries(); total != 2 || withHD != 2 {
+		t.Fatalf("Entries ＝ %d、%d", total, withHD)
+	}
+}
+
+// 負對照：每一種不符都要被拒絕，且訊息點名原因。
+func TestCheckThemeRejects(t *testing.T) {
+	base := baseAssets(t)
+	cases := []struct {
+		name string
+		rows []fakeRow
+		pals []string
+		want string
+	}{
+		{"雜湊不在基底", []fakeRow{{hash: hx('d'), id: "X", w: 4, h: 2, pal: "MAIN", hd: "x.png", pngW: 8, pngH: 4}}, []string{"MAIN"}, "雜湊不在基底清冊"},
+		{"尺寸與基底不同", []fakeRow{{hash: hx('a'), id: "X", w: 5, h: 2, pal: "MAIN", hd: "x.png", pngW: 10, pngH: 4}}, []string{"MAIN"}, "基底清冊是 4x2"},
+		{"調色盤缺名", []fakeRow{{hash: hx('a'), id: "X", w: 4, h: 2, pal: "NOPE", hd: "x.png", pngW: 8, pngH: 4}}, []string{"MAIN"}, "不在 palettes.tsv"},
+		{"PNG 缺檔", []fakeRow{{hash: hx('a'), id: "X", w: 4, h: 2, pal: "MAIN", hd: "missing.png"}}, []string{"MAIN"}, "HD 圖缺檔"},
+		{"PNG 尺寸不符", []fakeRow{{hash: hx('a'), id: "X", w: 4, h: 2, pal: "MAIN", hd: "x.png", pngW: 7, pngH: 4}}, []string{"MAIN"}, "PNG 是 7x4，應為 8x4"},
+	}
+	for _, c := range cases {
+		dir := writeTheme(t, c.rows, c.pals...)
+		a, err := CheckTheme(base, dir, 2)
+		if err == nil || a != nil {
+			t.Errorf("%s：應被拒絕", c.name)
+			continue
+		}
+		if !strings.Contains(err.Error(), c.want) {
+			t.Errorf("%s：錯誤訊息 %q 應含 %q", c.name, err, c.want)
+		}
+	}
+	// 清冊缺檔
+	if _, err := CheckTheme(base, filepath.Join(t.TempDir(), "nope"), 2); err == nil {
+		t.Error("缺清冊應回錯誤")
+	}
+}
+
+func TestPreloadReleaseAndFailures(t *testing.T) {
+	// b 的 PNG 尺寸不符：預載時算失敗，之後 Get 回 nil（退回基底層）
+	dir := writeTheme(t, []fakeRow{
+		{hash: hx('a'), id: "A:0", w: 4, h: 2, pal: "MAIN", hd: "m/a.png", pngW: 8, pngH: 4},
+		{hash: hx('b'), id: "A:1", w: 4, h: 2, pal: "MAIN", hd: "m/b.png", pngW: 7, pngH: 4},
+		{hash: hx('c'), id: "A:2", w: 6, h: 3, pal: "MAIN"},
+	}, "MAIN")
+	a, err := LoadAssets(dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var seen []int
+	ok, failed, err := a.Preload(context.Background(), func(done, total int) { seen = append(seen, done*10+total) })
+	if err != nil || ok != 1 || failed != 1 {
+		t.Fatalf("Preload ＝ ok %d、failed %d、err %v，應為 1、1、nil", ok, failed, err)
+	}
+	if len(seen) != 2 || seen[1]%10 != 2 {
+		t.Fatalf("進度回報 %v，應為 2 次、total ＝ 2（沒有 HD 圖的列不算）", seen)
+	}
+	if a.Get(hx('a')) == nil || a.Get(hx('b')) != nil {
+		t.Fatal("預載後 Get 的結果不對")
+	}
+	if len(a.Errors) != 1 {
+		t.Fatalf("Errors ＝ %v", a.Errors)
+	}
+	// Release：快取與錯誤清空，清冊與調色盤保留，之後可重新解碼
+	a.Release()
+	if len(a.Errors) != 0 || a.Lookup(hx('a')) == nil || a.Palette("MAIN") == nil {
+		t.Fatal("Release 後清冊與調色盤應保留、錯誤清空")
+	}
+	if a.Get(hx('a')) == nil {
+		t.Fatal("Release 後 Get 應重新解碼")
+	}
+}
+
+func TestPreloadCancel(t *testing.T) {
+	dir := writeTheme(t, []fakeRow{
+		{hash: hx('a'), id: "A:0", w: 4, h: 2, pal: "MAIN", hd: "m/a.png", pngW: 8, pngH: 4},
+		{hash: hx('b'), id: "A:1", w: 4, h: 2, pal: "MAIN", hd: "m/b.png", pngW: 8, pngH: 4},
+	}, "MAIN")
+	a, _ := LoadAssets(dir, 2)
+	ctx, cancel := context.WithCancel(context.Background())
+	n := 0
+	ok, failed, err := a.Preload(ctx, func(done, total int) {
+		n++
+		cancel() // 第一筆之後取消
+	})
+	if err == nil || n != 1 || ok+failed != 1 {
+		t.Fatalf("取消後應停止：n ＝ %d、ok ＝ %d、failed ＝ %d、err ＝ %v", n, ok, failed, err)
+	}
+}
