 	scratch []bandScratch
 }
 
+// composerOption 是 newComposer 的建構選項（只給測試用）。
+type composerOption func(*Composer)
+
+// withRereadPerStamp 讓 Compose 每個戳記重讀 A（快照測試的負對照，docs/spec/006 第 10 節）。
+func withRereadPerStamp() composerOption { return func(c *Composer) { c.rereadPerStamp = true } }
+
 // NewComposer 建立合成器；a 可為 nil（只做基底層放大，戳記照樣遮蔽但沒有 HD 可畫）。
-func NewComposer(a *Assets, s int) *Composer {
