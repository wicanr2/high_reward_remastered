+	mu    sync.Mutex
+	cache map[string]*Asset // nil 值表示載入失敗或沒有 HD，不重試
+	// Errors 是載入失敗與不一致的紀錄（每個雜湊最多一筆）。合成執行緒在 mu 下 append，Release 會把它設為 nil，
+	// 所以其他執行緒不可直接讀這個欄位（docs/spec/006 第 4 節），改用帶鎖的 ErrorStats。
+	Errors []string
+
+	getHook atomic.Pointer[getHook] // 測試控制點，見 SetGetHook
+}
+
+// getHook 是 SetGetHook 安裝的一次性鉤子。
+type getHook struct {
+	f     func(hash string)
+	fired atomic.Bool
+}
+
+// SetGetHook 安裝測試控制點（docs/spec/006 第 4 節「測試控制點與可觀察手段」），只給測試用：
+// 安裝之後第一次 Get 在進入時、查快取之前、a.mu 之外呼叫 f(hash)，之後不再呼叫（一次性，每次安裝各一次）。
+// f 為 nil 解除。在 mu 之外呼叫，所以 f 可以阻塞或呼叫 ErrorStats、Release、Composer.SetAssets 而不死鎖。
+// 觸發前提是 Get 真的被呼叫：Assets 非 nil，Compose 的戳記至少一個通過驗證（compose_draw.go）。
+func (a *Assets) SetGetHook(f func(hash string)) {
+	if f == nil {
+		a.getHook.Store(nil)
+		return
+	}
+	a.getHook.Store(&getHook{f: f})
+}
+
+// ErrorStats 帶鎖回傳目前 Errors 的筆數 n，以及整個 Assets 的第一筆錯誤原因 first（沒有錯誤則為空字串；
+// first 不是「新增的第一筆」）。已套用的 Assets 不 Release，所以 n 單調不減；Release 會把兩者歸零。
+func (a *Assets) ErrorStats() (n int, first string) {
+	if a == nil {
+		return 0, ""
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if len(a.Errors) == 0 {
+		return 0, ""
+	}
+	return len(a.Errors), a.Errors[0]
 }
 
 // LoadAssets 讀 dir/catalog.tsv、dir/palettes.tsv；HD 圖在 dir/x<S>/。清冊缺檔回錯誤。
@@ -162,6 +199,9 @@ func (a *Assets) Get(hash string) *Asset {
 	if a == nil {
 		return nil
 	}
+	if h := a.getHook.Load(); h != nil && h.fired.CompareAndSwap(false, true) {
+		h.f(hash) // 測試控制點：在 mu 之外、查快取之前
+	}
 	a.mu.Lock()
 	defer a.mu.Unlock()
 	if as, ok := a.cache[hash]; ok {
