diff --git a/apps/hr/hd/snapshot_test.go b/apps/hr/hd/snapshot_test.go
new file mode 100644
index 0000000..487f68d
--- /dev/null
+++ b/apps/hr/hd/snapshot_test.go
@@ -0,0 +1,373 @@
+package hd
+
+import (
+	"bytes"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// docs/spec/006 第 4 節與第 10 節：Composer.A 原子指標與 Compose 的整幀快照、Release 與 Compose 並行、SetGetHook。
+// 素材是 writeTheme 在暫存目錄寫出的真 PNG（實心、alpha 255），不含任何原版素材。
+
+const (
+	snapW, snapH, snapS = 16, 8, 2
+	snapStampW          = 4 // 戳記 4x4，第一個在 (0,0)，第二個在 (8,0)，互不重疊
+)
+
+var (
+	snapColA = [4]uint8{200, 30, 30, 255}
+	snapColB = [4]uint8{30, 30, 200, 255}
+)
+
+// testPalDAC 回傳與 testPal 逐項相同的 DAC，使淡入淡出表為恆等（素材顏色原樣輸出，A、B 的差異不被縮放掩蓋）。
+func testPalDAC() (mp [16]uint8, dac [256][3]uint8) {
+	for i := 0; i < 16; i++ {
+		mp[i] = uint8(i)
+		dac[i] = [3]uint8{0, 0, uint8(i)}
+	}
+	dac[15] = [3]uint8{255, 255, 255}
+	return
+}
+
+type snapFix struct {
+	A, B   *Assets
+	px     []uint8
+	stamps []*Stamp
+	mp     [16]uint8
+	dac    [256][3]uint8
+	refA   []byte // 只用 A 的輸出
+	refB   []byte // 只用 B 的輸出
+}
+
+func (f *snapFix) compose(c *Composer) []byte {
+	out := make([]byte, snapW*snapS*snapH*snapS*4)
+	c.Compose(out, f.px, snapW, snapH, f.mp, &f.dac, f.stamps)
+	return out
+}
+
+func newSnapFix(t *testing.T) *snapFix {
+	t.Helper()
+	mk := func(col [4]uint8) *Assets {
+		dir := writeTheme(t, []fakeRow{
+			{hash: hx('1'), id: "S:1", w: snapStampW, h: snapStampW, pal: "MAIN", hd: "s/1.png", pngW: snapStampW * snapS, pngH: snapStampW * snapS, fill: col},
+			{hash: hx('2'), id: "S:2", w: snapStampW, h: snapStampW, pal: "MAIN", hd: "s/2.png", pngW: snapStampW * snapS, pngH: snapStampW * snapS, fill: col},
+		}, "MAIN")
+		a, err := LoadAssets(dir, snapS)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return a
+	}
+	f := &snapFix{A: mk(snapColA), B: mk(snapColB)}
+	f.mp, f.dac = testPalDAC()
+	f.px = make([]uint8, snapW*snapH)
+	for i := range f.px {
+		f.px[i] = 1
+	}
+	f.stamps = []*Stamp{
+		{Kind: KindSprite, X: 0, Y: 0, W: snapStampW, H: snapStampW, Hash: hx('1'), E: filled(snapStampW*snapStampW, 1), Seq: 1},
+		{Kind: KindSprite, X: 8, Y: 0, W: snapStampW, H: snapStampW, Hash: hx('2'), E: filled(snapStampW*snapStampW, 1), Seq: 2},
+	}
+	f.refA = f.compose(NewComposer(f.A, snapS))
+	f.refB = f.compose(NewComposer(f.B, snapS))
+	// 夾具自檢：A、B 的輸出必須不同，且兩個戳記區域都是素材顏色（否則下面的測試沒有鑑別力）
+	if bytes.Equal(f.refA, f.refB) {
+		t.Fatal("夾具無效：只用 A 與只用 B 的輸出相同")
+	}
+	for _, c := range []struct {
+		ref []byte
+		col [4]uint8
+	}{{f.refA, snapColA}, {f.refB, snapColB}} {
+		for _, p := range [][2]int{{0, 0}, {7, 7}, {16, 0}, {23, 7}} { // 兩個戳記的角落（輸出座標）
+			if got := pixelAt(c.ref, p[0], p[1]); got != c.col {
+				t.Fatalf("夾具無效：(%d,%d) ＝ %v，應為素材顏色 %v", p[0], p[1], got, c.col)
+			}
+		}
+		if got := pixelAt(c.ref, 12, 0); got == snapColA || got == snapColB { // 兩個戳記之間是基底層
+			t.Fatalf("夾具無效：戳記外 (12,0) 不是基底層：%v", got)
+		}
+	}
+	return f
+}
+
+func pixelAt(buf []byte, x, y int) [4]uint8 {
+	o := (y*snapW*snapS + x) * 4
+	return [4]uint8{buf[o], buf[o+1], buf[o+2], buf[o+3]}
+}
+
+// 決定性：A 的第一個戳記的第一次 Get 進入時（查快取之前），同步 SetAssets(B)；整幀輸出必須逐位元等於只用 A。
+func TestComposeSnapshotDeterministic(t *testing.T) {
+	f := newSnapFix(t)
+	c := NewComposer(f.A, snapS)
+	fired := 0
+	var firstHash string
+	f.A.SetGetHook(func(h string) {
+		fired++
+		firstHash = h
+		c.SetAssets(f.B) // 在 Compose 進行中換素材
+	})
+	out := f.compose(c)
+	if fired != 1 {
+		t.Fatalf("鉤子觸發 %d 次，應為 1（沒觸發則測試沒有換素材，無效）", fired)
+	}
+	if firstHash != hx('1') {
+		t.Fatalf("鉤子應在第一個戳記的 Get 觸發，實際雜湊 %s", firstHash[:8])
+	}
+	if c.A.Load() != f.B {
+		t.Fatal("鉤子內的 SetAssets(B) 沒有生效")
+	}
+	if !bytes.Equal(out, f.refA) {
+		t.Fatalf("Compose 進行中換素材，整幀輸出應仍等於只用 A；第二個戳記 (16,0) ＝ %v", pixelAt(out, 16, 0))
+	}
+	// 換素材從下一次 Compose 起生效
+	if next := f.compose(c); !bytes.Equal(next, f.refB) {
+		t.Fatal("下一次 Compose 應整幀用 B")
+	}
+}
+
+// 負對照：rereadPerStamp 讓每個戳記重讀 A，第二個戳記取到 B，輸出必須不同；否則上面的測試沒有鑑別力。
+func TestComposeSnapshotNegativeControl(t *testing.T) {
+	f := newSnapFix(t)
+	c := newComposer(f.A, snapS, withRereadPerStamp())
+	fired := 0
+	f.A.SetGetHook(func(string) {
+		fired++
+		c.SetAssets(f.B)
+	})
+	out := f.compose(c)
+	if fired != 1 {
+		t.Fatalf("鉤子觸發 %d 次，應為 1", fired)
+	}
+	if bytes.Equal(out, f.refA) {
+		t.Fatal("負對照無效：逐戳記重讀時輸出仍等於只用 A")
+	}
+	if got := pixelAt(out, 0, 0); got != snapColA {
+		t.Fatalf("第一個戳記已取得 A，應為 A 的顏色：%v", got)
+	}
+	if got := pixelAt(out, 16, 0); got != snapColB {
+		t.Fatalf("逐戳記重讀時第二個戳記應取到 B：%v", got)
+	}
+}
+
+// 統計式輔助：GOMAXPROCS 至少 2，N 不小於 200 幀，切換者與合成者以通道交握（每幀一次，不跑自由競速），
+// 每幀輸出必須逐位元等於全 A 或全 B，且兩種都至少出現一次。偶數幀不在 Compose 期間切換（決定性地保證兩種都出現），
+// 奇數幀在 Compose 期間持續 SetAssets 交替，與快照載入競爭。
+func TestComposeSnapshotStatistical(t *testing.T) {
+	if runtime.GOMAXPROCS(0) < 2 {
+		old := runtime.GOMAXPROCS(2)
+		t.Cleanup(func() { runtime.GOMAXPROCS(old) })
+	}
+	f := newSnapFix(t)
+	const N = 400
+	c := NewComposer(f.A, snapS)
+	type job struct{}
+	start := make(chan job)
+	done := make(chan []byte)
+	go func() {
+		for range start {
+			done <- f.compose(c)
+		}
+		close(done)
+	}()
+	var nA, nB, mixed int
+	other := func(a *Assets) *Assets {
+		if a == f.A {
+			return f.B
+		}
+		return f.A
+	}
+	for k := 0; k < N; k++ {
+		cur := f.A
+		if k%4 >= 2 {
+			cur = f.B
+		}
+		c.SetAssets(cur) // 這一幀開始前的素材（交握：Compose 還沒開始）
+		start <- job{}
+		var out []byte
+		if k%2 == 0 {
+			out = <-done // 偶數幀：Compose 期間不切換，輸出必為 cur
+		} else {
+			flip := cur
+		spin:
+			for {
+				select {
+				case out = <-done:
+					break spin
+				default:
+					flip = other(flip)
+					c.SetAssets(flip)
+					runtime.Gosched()
+				}
+			}
+		}
+		switch {
+		case bytes.Equal(out, f.refA):
+			nA++
+		case bytes.Equal(out, f.refB):
+			nB++
+		default:
+			mixed++
+		}
+	}
+	close(start)
+	<-done
+	t.Logf("N ＝ %d：全 A %d、全 B %d、混合 %d", N, nA, nB, mixed)
+	if mixed != 0 {
+		t.Fatalf("%d 幀混用了兩套素材", mixed)
+	}
+	if nA == 0 || nB == 0 {
+		t.Fatalf("測試無效：全 A %d 幀、全 B %d 幀，兩種都要出現", nA, nB)
+	}
+}
+
+// SetAssets(nil) ＝ 暫停 HD：之後的 Compose 只做基底層放大，與沒有素材的 Composer 輸出相同。
+func TestComposeSetAssetsNil(t *testing.T) {
+	f := newSnapFix(t)
+	c := NewComposer(f.A, snapS)
+	if !bytes.Equal(f.compose(c), f.refA) {
+		t.Fatal("起點應等於 refA")
+	}
+	c.SetAssets(nil)
+	base := f.compose(NewComposer(nil, snapS))
+	if got := f.compose(c); !bytes.Equal(got, base) {
+		t.Fatal("SetAssets(nil) 之後應只做基底層放大")
+	}
+	if bytes.Equal(base, f.refA) {
+		t.Fatal("夾具無效：基底層與 refA 相同")
+	}
+	c.SetAssets(f.B)
+	if !bytes.Equal(f.compose(c), f.refB) {
+		t.Fatal("恢復素材後應用 B")
+	}
+}
+
+// Release 與 Compose 並行：一個 goroutine 連續 Compose，另一個連續 Release（素材是真 PNG，Get 能重新解碼），
+// 每幀輸出逐位元等於參考輸出。-race 下無競爭。
+func TestReleaseConcurrentWithCompose(t *testing.T) {
+	f := newSnapFix(t)
+	c := NewComposer(f.A, snapS)
+	var stop atomic.Bool
+	var releases atomic.Int64
+	var wg sync.WaitGroup
+	for r := 0; r < 2; r++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for !stop.Load() {
+				f.A.Release()
+				releases.Add(1)
+				runtime.Gosched()
+			}
+		}()
+	}
+	// 觀察者：Release 之後 Get 會重新解碼，所以看得到不同的 *Asset 指標（證明 Release 真的和 Compose 交錯）
+	seen := map[*Asset]bool{}
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for !stop.Load() {
+			if as := f.A.Get(hx('1')); as != nil {
+				seen[as] = true
+			}
+			runtime.Gosched()
+		}
+	}()
+	const N = 300
+	bad := -1
+	for k := 0; k < N && bad < 0; k++ {
+		if !bytes.Equal(f.compose(c), f.refA) {
+			bad = k
+		}
+	}
+	stop.Store(true)
+	wg.Wait()
+	if bad >= 0 {
+		t.Fatalf("第 %d 幀的輸出與參考輸出不同", bad)
+	}
+	t.Logf("%d 幀；Release %d 次；觀察到 %d 個不同的 *Asset", N, releases.Load(), len(seen))
+	if releases.Load() < 10 || len(seen) < 2 {
+		t.Fatalf("測試無效：Release %d 次、不同 *Asset %d 個（Release 沒有和 Compose 交錯）", releases.Load(), len(seen))
+	}
+}
+
+// SetGetHook 的語意：進入 Get 時、查快取之前、a.mu 之外呼叫；一次性（每次安裝各一次）；nil 解除。
+func TestSetGetHook(t *testing.T) {
+	f := newSnapFix(t)
+	a := f.A
+	var calls []string
+	a.SetGetHook(func(h string) { calls = append(calls, h) })
+	// 快取已有時鉤子仍觸發（查快取之前）：先讓 hx('1') 進快取
+	if a.Get(hx('1')) == nil {
+		t.Fatal("Get 應成功")
+	}
+	if len(calls) != 1 || calls[0] != hx('1') {
+		t.Fatalf("第一次 Get 應觸發鉤子：%v", calls)
+	}
+	a.Get(hx('1'))
+	a.Get(hx('2'))
+	if len(calls) != 1 {
+		t.Fatalf("鉤子是一次性的，之後的 Get 不再觸發：%d 次", len(calls))
+	}
+	// 重新安裝：再來一次（對已在快取的雜湊也觸發）
+	a.SetGetHook(func(h string) { calls = append(calls, "again:"+h[:4]) })
+	a.Get(hx('1'))
+	if len(calls) != 2 || !strings.HasPrefix(calls[1], "again:") {
+		t.Fatalf("重新安裝後第一次 Get 應再觸發：%v", calls)
+	}
+	// nil 解除
+	a.SetGetHook(func(string) { t.Error("已解除的鉤子不該被呼叫") })
+	a.SetGetHook(nil)
+	a.Get(hx('2'))
+	// nil 素材不 panic、不觸發
+	var nilAssets *Assets
+	if nilAssets.Get(hx('1')) != nil {
+		t.Fatal("nil 素材的 Get 應回 nil")
+	}
+}
+
+// 鉤子在 a.mu 之外：鉤子內呼叫 ErrorStats、Release、Get（其他雜湊）不死鎖。
+func TestSetGetHookOutsideLock(t *testing.T) {
+	f := newSnapFix(t)
+	a := f.A
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		a.SetGetHook(func(string) {
+			a.ErrorStats()
+			a.Release()
+			a.Get(hx('2'))
+		})
+		if a.Get(hx('1')) == nil {
+			t.Error("鉤子之後 Get 仍應成功")
+		}
+	}()
+	select {
+	case <-finished:
+	case <-time.After(10 * time.Second):
+		t.Fatal("鉤子內呼叫 ErrorStats、Release 卡死：鉤子可能在 a.mu 之內被呼叫")
+	}
+}
+
+// docs/spec/006 第 4 節：play 套件的 hdView 測試用「只有表頭的 TSV」建 Assets，戳記的雜湊不在清冊也要觸發鉤子；
+// 此時 Get 回 nil，輸出與素材無關（等於只有基底層）。
+func TestSetGetHookFiresForHashNotInCatalog(t *testing.T) {
+	f := newSnapFix(t)
+	empty, err := LoadAssets(writeTheme(t, nil, "MAIN"), snapS)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := NewComposer(empty, snapS)
+	var got []string
+	empty.SetGetHook(func(h string) { got = append(got, h) })
+	out := f.compose(c)
+	if len(got) != 1 || got[0] != hx('1') {
+		t.Fatalf("鉤子應在第一個戳記的 Get 觸發一次：%v", got)
+	}
+	if base := f.compose(NewComposer(nil, snapS)); !bytes.Equal(out, base) {
+		t.Fatal("清冊沒有的雜湊：輸出應等於只有基底層")
+	}
+}
diff --git a/apps/hr/hd/theme.go b/apps/hr/hd/theme.go
new file mode 100644
index 0000000..9dc74fb
--- /dev/null
+++ b/apps/hr/hd/theme.go
@@ -0,0 +1,156 @@
+package hd
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"image"
+	_ "image/png" // image.DecodeConfig 讀 PNG 檔頭
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// 以下是 docs/spec/006 第 4 節的 theme 支援：預載、釋放、檢查。
+
+// Preload 逐筆解碼所有有 HD 圖的清冊列（Get 的延遲解碼提前做完），在每次迴圈開頭檢查 ctx，取消即停。
+// progress 非 nil 時每解碼一筆呼叫一次（done 從 1 起，total 是有 HD 圖的清冊列數），呼叫時不持有任何鎖，
+// 所以 progress 阻塞期間其他執行緒的 Get 與 ErrorStats 不受影響。
+//
+// 回傳成功解碼數 ok 與失敗數 failed（失敗的原因記在 Errors，並且該筆之後 Get 回 nil，退回基底層）：
+//   - err ＝ nil：迴圈跑完（即使 ctx 在跑完之後才被取消）；清冊的 hd 欄全空時回 (0, 0, nil)；
+//   - err ≠ nil：ctx 在迴圈開頭被取消（err 是 ctx.Err()），已解碼的部分留在快取，ok 可以大於 0。
+//     呼叫端丟棄這份預載時要自己 Release。
+//
+// 解碼順序依雜湊排序（決定性）。
+func (a *Assets) Preload(ctx context.Context, progress func(done, total int)) (ok, failed int, err error) {
+	hashes := make([]string, 0, len(a.cat))
+	for h, e := range a.cat {
+		if e.HD != "" {
+			hashes = append(hashes, h)
+		}
+	}
+	sort.Strings(hashes)
+	for i, h := range hashes {
+		if err := ctx.Err(); err != nil {
+			return ok, failed, err
+		}
+		if a.Get(h) != nil {
+			ok++
+		} else {
+			failed++
+		}
+		if progress != nil {
+			progress(i+1, len(hashes))
+		}
+	}
+	return ok, failed, nil
+}
+
+// Release 清空解碼快取與錯誤紀錄（保留清冊與調色盤）。之後 Get 會重新延遲解碼。
+//
+// 只用在尚未套用的預載被丟棄或被拒時（docs/spec/006 第 4 節「常駐策略」）：由載入 goroutine 在回報結果之前
+// 同步呼叫，此時沒有其他使用者。已套用（常駐）的 Assets 不 Release。Release 會清掉錯誤原因，
+// 所以要先讀 ErrorStats 再 Release。先前 Get 回傳的 *Asset 不受影響（Release 只換掉快取表，不改圖），
+// 與 Compose 並行呼叫也安全。
+func (a *Assets) Release() {
+	a.mu.Lock()
+	a.cache = map[string]*Asset{}
+	a.Errors = nil
+	a.mu.Unlock()
+}
+
+// Entries 回傳清冊列數與有 HD 圖的列數。
+func (a *Assets) Entries() (total, withHD int) {
+	for _, e := range a.cat {
+		total++
+		if e.HD != "" {
+			withHD++
+		}
+	}
+	return
+}
+
+// maxThemeProblems 是 CheckTheme 回報的問題數上限。
+const maxThemeProblems = 20
+
+// CheckTheme 是衍生 theme 的嚴格檢查（docs/spec/006 第 4 節「檢查的內容」）。它載入 dir 的清冊與調色盤，
+// 成功時回傳載入好的 *Assets（呼叫端不必再解析一次 TSV），並依 base（基底 theme，辨識用的清冊）對每一列檢查：
+//   - hash 必須存在於 base，且 w、h 相同（允許只涵蓋部分雜湊，缺的回退基底層）；
+//   - pal 名稱必須存在於 dir 自己的 palettes.tsv（hd 欄為空的列也檢查）；
+//   - hd 欄非空的列，PNG 必須存在且尺寸是 S×w 乘 S×h（只讀檔頭，不解碼；內容契約由發行前的驗收工具負責）。
+//     hd 欄為空的列（沒有 HD 圖）只略過這一項。
+//
+// 有任何一項不符就回錯誤（列出前 maxThemeProblems 項），整個 theme 被拒絕。比對以 hash 為鍵，不依列序，
+// 也不比 id、kind、pal 欄的內容（id 是以分號合併的清單，列序不同時會不同，docs/spec/004 第 3.3 節）。
+// base 為 nil 回明確錯誤，不 panic（基底 theme 本身不經 CheckTheme）。清冊或調色盤 TSV 讀不了也回錯誤。
+func CheckTheme(base *Assets, dir string, s int) (*Assets, error) {
+	if base == nil {
+		return nil, errors.New("CheckTheme：base 為 nil（衍生 theme 需要基底 theme 的清冊可比對；基底 theme 本身不經 CheckTheme）")
+	}
+	a, err := LoadAssets(dir, s)
+	if err != nil {
+		return nil, err
+	}
+	hashes := make([]string, 0, len(a.cat))
+	for h := range a.cat {
+		hashes = append(hashes, h)
+	}
+	sort.Strings(hashes) // 回報的問題順序決定性
+	var problems []string
+	add := func(format string, args ...any) {
+		if len(problems) < maxThemeProblems {
+			problems = append(problems, fmt.Sprintf(format, args...))
+		}
+	}
+	bad := 0
+	for _, h := range hashes {
+		e := a.cat[h]
+		short := h[:8]
+		be := base.Lookup(h)
+		if be == nil {
+			bad++
+			add("%s（%s）：雜湊不在基底清冊", short, e.ID)
+			continue
+		}
+		if be.W != e.W || be.H != e.H {
+			bad++
+			add("%s（%s）：尺寸 %dx%d，基底清冊是 %dx%d", short, e.ID, e.W, e.H, be.W, be.H)
+		}
+		if a.pals[e.Pal] == nil {
+			bad++
+			add("%s（%s）：調色盤 %q 不在 palettes.tsv", short, e.ID, e.Pal)
+		}
+		if e.HD == "" {
+			continue
+		}
+		p := filepath.Join(dir, "x"+strconv.Itoa(s), filepath.FromSlash(e.HD))
+		f, err := os.Open(p)
+		if err != nil {
+			bad++
+			add("%s（%s）：HD 圖缺檔：%v", short, e.ID, err)
+			continue
+		}
+		cfg, _, err := image.DecodeConfig(f)
+		f.Close()
+		if err != nil {
+			bad++
+			add("%s（%s）：不是可讀的 PNG：%v", short, e.ID, err)
+			continue
+		}
+		if cfg.Width != e.W*s || cfg.Height != e.H*s {
+			bad++
+			add("%s（%s）：PNG 是 %dx%d，應為 %dx%d", short, e.ID, cfg.Width, cfg.Height, e.W*s, e.H*s)
+		}
+	}
+	if bad > 0 {
+		more := ""
+		if bad > len(problems) {
+			more = fmt.Sprintf("（另有 %d 項）", bad-len(problems))
+		}
+		return nil, fmt.Errorf("theme %s 未通過檢查，共 %d 項不符%s：\n  %s", dir, bad, more, strings.Join(problems, "\n  "))
+	}
+	return a, nil
+}
diff --git a/apps/hr/hd/theme_spec_test.go b/apps/hr/hd/theme_spec_test.go
