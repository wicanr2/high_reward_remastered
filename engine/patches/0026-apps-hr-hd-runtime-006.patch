+// Run 的檢查點接線（需要原版，缺檔 skip）：間隔設成永遠跑不到（每個 tick 一億道指令），第一個 2 秒檢查點必判落後。
+// 對照組（無持有）會降頻；持有到結束的、以及在視窗中途放開的（dirty 路徑）都不降頻，視窗基準仍前進。
+func TestHoldGateRunIntegration(t *testing.T) {
+	if testing.Short() {
+		t.Skip("-short")
+	}
+	root := origRoot(t)
+	run := func(releaseAt time.Duration, hold bool) (s *Session, started time.Time) {
+		s, err := Open(root, Options{Interval: 100_000_000, NoDiag: true})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if hold {
+			rel := s.HoldAdapt()
+			if releaseAt > 0 {
+				tm := time.AfterFunc(releaseAt, rel)
+				defer tm.Stop()
+			}
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 2700*time.Millisecond)
+		defer cancel()
+		started = time.Now()
+		if st := s.Run(ctx); st != nil {
+			t.Fatalf("Run 提早停機：%s", st.Msg)
+		}
+		return s, started
+	}
+	// 對照：無持有，第一個檢查點降頻
+	s, started := run(0, false)
+	if !s.lowered || s.interval != 90_000_000 {
+		t.Fatalf("對照組（無持有）應降頻：lowered ＝ %v、interval ＝ %d", s.lowered, s.interval)
+	}
+	if !s.lastCheck.After(started.Add(1900 * time.Millisecond)) {
+		t.Fatalf("對照組的視窗基準沒有前進（lastCheck 距開始 %v）：檢查點沒有執行", s.lastCheck.Sub(started))
+	}
+	// 持有到結束
+	s, started = run(0, true)
+	if s.lowered || s.interval != 100_000_000 {
+		t.Fatalf("持有期間不該降頻：lowered ＝ %v、interval ＝ %d", s.lowered, s.interval)
+	}
+	if !s.lastCheck.After(started.Add(1900 * time.Millisecond)) {
+		t.Fatalf("持有時視窗基準仍要前進（lastCheck 距開始 %v）", s.lastCheck.Sub(started))
+	}
+	if h, _ := s.hg.take(); h != 1 {
+		t.Fatalf("Run 結束時持有數 ＝ %d，應為 1", h)
+	}
+	// 在視窗中途放開（1 秒時）：第一個檢查點走 dirty 路徑，不降頻
+	s, started = run(time.Second, true)
+	if s.lowered || s.interval != 100_000_000 {
+		t.Fatalf("視窗中途放開，放開所在的視窗不該降頻：lowered ＝ %v、interval ＝ %d", s.lowered, s.interval)
+	}
+	if !s.lastCheck.After(started.Add(1900 * time.Millisecond)) {
+		t.Fatalf("視窗基準沒有前進（lastCheck 距開始 %v）：檢查點沒有執行，測試無效", s.lastCheck.Sub(started))
+	}
+	if h, d := s.hg.take(); h != 0 || d {
+		t.Fatalf("檢查點應已消費 dirty：(%d, %v)", h, d)
+	}
+}
