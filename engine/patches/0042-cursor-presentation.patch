+func TestCursorMalformedDataFallsBackWithoutMutation(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		edit func(*Frame, []byte) []byte
+	}{
+		{"short memory", func(_ *Frame, b []byte) []byte { return b[:cursorData+0x1bd1+804] }},
+		{"wrong frame size", func(f *Frame, b []byte) []byte { f.W = 639; return b }},
+		{"short pixels", func(f *Frame, b []byte) []byte { f.Px = f.Px[:len(f.Px)-1]; return b }},
+		{"shape width", func(_ *Frame, b []byte) []byte { b[cursorData+0x2a9] = 39; return b }},
+		{"shape height", func(_ *Frame, b []byte) []byte { b[cursorData+0x2ab] = 31; return b }},
+		{"shape flags", func(_ *Frame, b []byte) []byte { b[cursorData+0x2ad] = 0; return b }},
+		{"paint flags", func(_ *Frame, b []byte) []byte { b[cursorData+0x1bd5] = 0; return b }},
+		{"background width", func(_ *Frame, b []byte) []byte { b[cursorData+0x21] = 4; return b }},
+		{"background height", func(_ *Frame, b []byte) []byte { b[cursorData+0x23] = 31; return b }},
+		{"background x", func(_ *Frame, b []byte) []byte { b[cursorData+0x1d] = 80; return b }},
+		{"background y", func(_ *Frame, b []byte) []byte { binary.LittleEndian.PutUint16(b[cursorData+0x1f:], 400); return b }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f, mem := cursorFixture()
+			mem = tc.edit(f, mem)
+			raw := append([]byte(nil), f.Px...)
+			before := append([]byte(nil), mem...)
+			ok, pending, _ := prepareCursor(f, mem, [4]int{})
+			if ok || pending || f.Cursor != nil || f.CursorBackground != nil {
+				t.Fatal("malformed data must use original frame")
+			}
+			if !bytes.Equal(f.Px, raw) || !bytes.Equal(mem, before) {
+				t.Fatal("malformed data modified original")
+			}
+		})
+	}
+}
