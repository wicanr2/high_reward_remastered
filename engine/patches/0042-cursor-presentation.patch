+func TestCursorPendingFrameExpiresWithoutNewSnapshot(t *testing.T) {
+	f, mem := cursorFixture()
+	f.Px[140*640+96] = 2
+	s := &Session{m: machine.New()}
+	s.m.Mem = mem
+	s.d = dos.New(s.m, "")
+	now := time.Unix(100, 0)
+	s.captureCursor(f, now)
+	f.Stamps = []*hd.Stamp{{Site: hd.CursorSite}}
+	if f.presentationAt(now.Add(499*time.Millisecond)) != nil {
+		t.Fatal("published unfinished draw before deadline")
+	}
+	for _, ms := range []int{500, 600, 2000} {
+		p := f.presentationAt(now.Add(time.Duration(ms) * time.Millisecond))
+		if p == nil || p.CursorManaged || p.CursorPending || p.Cursor != nil || p.CursorBackground != nil {
+			t.Fatalf("last pending frame did not fall back at %d ms", ms)
+		}
+		if !bytes.Equal(p.Px, f.Px) || len(p.Stamps) != 1 || p.Stamps[0].Site != hd.CursorSite {
+			t.Fatal("fallback must retain raw pixels and original stamps")
+		}
+	}
+	if !f.CursorPending || !f.CursorManaged {
+		t.Fatal("presentation mutated immutable snapshot")
+	}
+}
