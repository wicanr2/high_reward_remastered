index 0000000..fff01b9
--- /dev/null
+++ b/apps/hr/play/cursor.go
@@ -0,0 +1,54 @@
+package main
+
+import (
+	"bytes"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+func cursorPosition(c *hrrt.Cursor, x, y int) (int, int, bool) {
+	if c == nil || x < 0 || y < 0 || x >= logicalW || y >= logicalH {
+		return 0, 0, false
+	}
+	x, y = cursorToGame(x, y)
+	if c.MaxX > 0 {
+		x = min(c.MaxX, max(c.MinX, x))
+	}
+	if c.MaxY > 0 {
+		y = min(c.MaxY, max(c.MinY, y+40)) - 40
+	}
+	return max(0, x-c.HotX) * 2, max(0, y-c.HotY) * 2, true
+}
+
+func (g *game) drawCursor(screen *ebiten.Image) {
+	f := g.drawnFrame
+	if f == nil || f.Cursor == nil || !f.CursorManaged {
+		return
+	}
+	x, y := g.env.cursor()
+	x, y, ok := cursorPosition(f.Cursor, x, y)
+	if !ok {
+		return
+	}
+	rgba := make([]byte, 40*32*4)
+	for i, p := range f.Cursor.Pixels {
+		if p == hd.Transparent {
+			continue
+		}
+		c := f.DAC[f.Map[p&15]]
+		copy(rgba[i*4:], []byte{c[0], c[1], c[2], 255})
+	}
+	if g.imgCursor == nil {
+		g.imgCursor = ebiten.NewImage(40, 32)
+	}
+	if !bytes.Equal(rgba, g.cursorRGBA) {
+		g.imgCursor.WritePixels(rgba)
+		g.cursorRGBA = rgba
+	}
+	op := &ebiten.DrawImageOptions{}
+	op.GeoM.Scale(2, 2)
+	op.GeoM.Translate(float64(x), float64(y))
+	screen.DrawImage(g.imgCursor, op)
+}
