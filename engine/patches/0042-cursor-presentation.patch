diff --git a/apps/hr/runtime/cursor.go b/apps/hr/runtime/cursor.go
new file mode 100644
index 0000000..2353d58
--- /dev/null
+++ b/apps/hr/runtime/cursor.go
@@ -0,0 +1,148 @@
+package runtime
+
+import (
+	"encoding/binary"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+)
+
+// Cursor 是規格 010 的不可變顯示資訊，座標界限仍採 DOS 的 VGA 座標。
+type Cursor struct {
+	Pixels                 []uint8
+	HotX, HotY             int
+	MinX, MaxX, MinY, MaxY int
+}
+
+// Presentation 回傳顯示專用底圖；nil 表示有界的重畫等待。
+// 原始快照、診斷與 RGBA 始終保留原始 VRAM。
+func (f *Frame) Presentation() *Frame {
+	return f.presentationAt(time.Now())
+}
+
+func (f *Frame) presentationAt(now time.Time) *Frame {
+	if f.CursorPending {
+		if !f.CursorDeadline.IsZero() && !now.Before(f.CursorDeadline) {
+			// 模擬器停止後也能到期，不修改已發布的原始快照。
+			c := *f
+			c.Cursor, c.CursorBackground = nil, nil
+			c.CursorManaged, c.CursorPending = false, false
+			c.CursorDeadline = time.Time{}
+			return &c
+		}
+		return nil
+	}
+	if !f.CursorManaged {
+		return f
+	}
+	c := *f
+	if f.CursorBackground != nil {
+		c.Px = f.CursorBackground
+	}
+	c.Stamps = make([]*hd.Stamp, 0, len(f.Stamps))
+	for _, st := range f.Stamps {
+		if st.Site != hd.CursorSite {
+			c.Stamps = append(c.Stamps, st)
+		}
+	}
+	return &c
+}
+
+const cursorData = 0x3e500
+
+func cursorSprite(b []byte) (hd.Sprite, bool) {
+	if len(b) < 805 || binary.LittleEndian.Uint16(b) != 40 || binary.LittleEndian.Uint16(b[2:]) != 32 || b[4] != 1 {
+		return hd.Sprite{}, false
+	}
+	s, err := hd.DecodePlanarSprite(b[:805])
+	return s, err == nil
+}
+
+// prepareCursor 只讀原始記憶體及像素。false 是未知格式，pending 是已知格式的中間畫面。
+func prepareCursor(f *Frame, mem []byte, bounds [4]int) (managed, pending bool, reason string) {
+	if f.W != 640 || f.H != 480 || len(f.Px) != 640*480 || len(mem) < cursorData+0x1bd1+805 {
+		return false, false, "畫面尺寸或資料長度不符"
+	}
+	d := mem[cursorData:]
+	u16 := func(o int) int { return int(binary.LittleEndian.Uint16(d[o:])) }
+	shape, ok := cursorSprite(d[0x2a9:])
+	if !ok {
+		return false, false, "游標精靈格式不支援或尚未初始化"
+	}
+	if u16(0x19) == 0 && u16(0x1b) == 0 {
+		return true, false, ""
+	}
+	if u16(0x19) != 1 || u16(0x1b) != 1 {
+		return true, true, ""
+	}
+	paint, ok := cursorSprite(d[0x1bd1:])
+	if !ok {
+		return false, false, "當輪繪圖精靈格式不支援"
+	}
+	x, y := u16(0x1d)*8, u16(0x1f)+40
+	if u16(0x21) != 5 || u16(0x23) != 32 || x < 0 || x >= 640 || y < 40 || y >= 440 {
+		return false, false, "背景位置或尺寸不符"
+	}
+	n := 0
+	for j := 0; j < 32 && y+j < 440; j++ {
+		for i := 0; i < 40 && x+i < 640; i++ {
+			p := paint.Idx[j*40+i]
+			if p == hd.Transparent {
+				continue
+			}
+			n++
+			if f.Px[(y+j)*640+x+i] != p {
+				return true, true, ""
+			}
+		}
+	}
+	if n == 0 {
+		return true, true, ""
+	}
+	clean := append([]uint8(nil), f.Px...)
+	bg := d[0x1d+8 : 0x1d+648]
+	for j := 0; j < 32 && y+j < 440; j++ {
+		for i := 0; i < 40 && x+i < 640; i++ {
+			if paint.Idx[j*40+i] == hd.Transparent {
+				continue
+			}
+			v := uint8(0)
+			for plane := 0; plane < 4; plane++ {
+				v |= ((bg[j*20+plane*5+i/8] >> uint(7-i%8)) & 1) << uint(plane)
+			}
+			clean[(y+j)*640+x+i] = v
+		}
+	}
+	f.CursorBackground = clean
+	f.Cursor = &Cursor{Pixels: shape.Idx, HotX: u16(0x2a5), HotY: u16(0x2a7), MinX: bounds[0], MaxX: bounds[1], MinY: bounds[2], MaxY: bounds[3]}
+	return true, false, ""
+}
+
+func (s *Session) captureCursor(f *Frame, now time.Time) {
+	m := s.d.Mouse
+	managed, pending, reason := prepareCursor(f, s.m.Mem, [4]int{int(m.MinX), int(m.MaxX), int(m.MinY), int(m.MaxY)})
+	if pending {
+		if s.cursorWaitAt.IsZero() {
+			s.cursorWaitAt = now
+		}
+		f.CursorDeadline = s.cursorWaitAt.Add(500 * time.Millisecond)
+		if !now.Before(f.CursorDeadline) {
+			managed, pending = false, false
+			reason = "重畫等待超過 500 毫秒"
+		}
+	} else {
+		s.cursorWaitAt = time.Time{}
+	}
+	f.CursorManaged, f.CursorPending = managed, pending
+	if reason != "" {
+		if s.cursorLogged == nil {
+			s.cursorLogged = make(map[string]bool)
+		}
+		if !s.cursorLogged[reason] {
+			if s.logf != nil {
+				s.logf("游標呈現回退原版：%s", reason)
+			}
+			s.cursorLogged[reason] = true
+		}
+	}
+}
diff --git a/apps/hr/runtime/cursor_test.go b/apps/hr/runtime/cursor_test.go
