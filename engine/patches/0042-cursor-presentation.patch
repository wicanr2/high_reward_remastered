+func TestCursorPresentationRestoresOnlyOpaquePixels(t *testing.T) {
+	f, mem := cursorFixture()
+	before := append([]byte(nil), mem...)
+	raw := append([]byte(nil), f.Px...)
+	ok, pending, _ := prepareCursor(f, mem, [4]int{0, 639, 40, 439})
+	if !ok || pending || f.Cursor == nil {
+		t.Fatal("valid cursor rejected")
+	}
+	if f.CursorBackground[140*640+96] != 6 || f.CursorBackground[140*640+97] != 9 {
+		t.Fatal("background or transparency changed")
+	}
+	if !bytes.Equal(mem, before) || !bytes.Equal(f.Px, raw) {
+		t.Fatal("modified oracle")
+	}
+	f.CursorManaged = true
+	f.Stamps = []*hd.Stamp{{Site: hd.CursorSite}, {Site: 1}}
+	p := f.Presentation()
+	if len(p.Stamps) != 1 || p.Stamps[0].Site != 1 || len(f.Stamps) != 2 {
+		t.Fatal("stale cursor stamp or mutated frame")
+	}
+	if f.Px[140*640+96] != 1 || p.Px[140*640+96] != 6 {
+		t.Fatal("raw and presentation mixed")
+	}
+}
