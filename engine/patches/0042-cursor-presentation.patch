+func TestCursorHiddenAndUnsupported(t *testing.T) {
+	f, mem := cursorFixture()
+	binary.LittleEndian.PutUint16(mem[cursorData+0x19:], 0)
+	binary.LittleEndian.PutUint16(mem[cursorData+0x1b:], 0)
+	ok, pending, _ := prepareCursor(f, mem, [4]int{})
+	if !ok || pending || f.Cursor != nil {
+		t.Fatal("hidden")
