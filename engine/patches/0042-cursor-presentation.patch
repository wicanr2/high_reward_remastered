index 0000000..9419739
--- /dev/null
+++ b/apps/hr/runtime/cursor_test.go
@@ -0,0 +1,284 @@
+package runtime
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/machine"
+	"testing"
+	"time"
+)
+
+func TestCursorPresentationClipsAtGameEdges(t *testing.T) {
+	for _, pos := range [][2]int{{0, 40}, {632, 40}, {0, 439}, {632, 439}} {
+		t.Run(fmt.Sprintf("%d-%d", pos[0], pos[1]), func(t *testing.T) {
+			f, mem := cursorFixture()
+			d := mem[cursorData:]
+			binary.LittleEndian.PutUint16(d[0x1d:], uint16(pos[0]/8))
+			binary.LittleEndian.PutUint16(d[0x1f:], uint16(pos[1]-40))
+			for i := range f.Px {
+				f.Px[i] = 9
+			}
+			// 40×32 的色 1 不透明精靈，保存背景為色 6。
+			for y := 0; y < 32; y++ {
+				for x := 0; x < 5; x++ {
+					for _, off := range []int{0x2a9, 0x1bd1} {
+						d[off+5+y*25+x] = 0xff
+						d[off+5+y*25+20+x] = 0xff
+					}
+					d[0x1d+8+y*20+5+x] = 0xff
+					d[0x1d+8+y*20+10+x] = 0xff
+				}
+				for x := 0; x < 40; x++ {
+					if pos[0]+x < 640 && pos[1]+y < 440 {
+						f.Px[(pos[1]+y)*640+pos[0]+x] = 1
+					}
+				}
+			}
+			raw := append([]byte(nil), f.Px...)
+			before := append([]byte(nil), mem...)
+			ok, pending, _ := prepareCursor(f, mem, [4]int{0, 639, 40, 439})
+			if !ok || pending || f.Cursor == nil {
+				t.Fatal("clipped cursor rejected")
+			}
+			for y := 0; y < 480; y++ {
+				for x := 0; x < 640; x++ {
+					want := byte(9)
+					if x >= pos[0] && x < min(640, pos[0]+40) && y >= pos[1] && y < min(440, pos[1]+32) {
+						want = 6
+					}
+					if f.CursorBackground[y*640+x] != want {
+						t.Fatalf("pixel %d,%d: got %d want %d", x, y, f.CursorBackground[y*640+x], want)
+					}
+				}
+			}
+			if !bytes.Equal(f.Px, raw) || !bytes.Equal(mem, before) {
+				t.Fatal("edge cleanup modified original")
+			}
+		})
+	}
+}
