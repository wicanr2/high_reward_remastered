+func TestCursorNormalPathDoesNotChangeMachine(t *testing.T) {
+	root := origRoot(t)
+	var sessions [2]*Session
+	for i := range sessions {
+		s, err := Open(root, Options{SmoothCursor: i == 1, NoPacing: true})
+		if err != nil {
+			t.Fatal(err)
+		}
+		sessions[i] = s
+		if st := s.RunSteps(30000000); st.Kind != StopSteps {
+			t.Fatal(st)
+		}
+		for n := 0; n < 4; n++ {
+			s.RunToPoll(2000000)
+		}
+		s.SnapshotNow()
+	}
+	a, b := sessions[0], sessions[1]
+	if !bytes.Equal(a.m.Mem, b.m.Mem) || !bytes.Equal(a.Frame().Px, b.Frame().Px) || a.m.Steps != b.m.Steps {
+		t.Fatal("presentation changed original state")
+	}
+	if a.Frame().CursorManaged || b.Frame().Cursor == nil || !b.Frame().CursorManaged {
+		t.Fatal("normal cursor not connected")
+	}
+}
