+	f.CursorManaged = ok
+	f.Stamps = []*hd.Stamp{{Site: hd.CursorSite}}
+	if len(f.Presentation().Stamps) != 0 {
+		t.Fatal("hidden stale stamp")
+	}
+	mem[cursorData+0x2a9] = 39
+	ok, pending, _ = prepareCursor(f, mem, [4]int{})
+	if ok || pending {
+		t.Fatal("unsupported must fall back")
+	}
+}
