+package main
+
+import (
+	"time"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+	"testing"
+)
+
+func TestCursorPositionImmediateAndBounds(t *testing.T) {
+	c := &hrrt.Cursor{MaxX: 639, MinY: 40, MaxY: 439}
+	for x := 100; x < 116; x++ {
+		got, y, ok := cursorPosition(c, x*2, 202)
+		if !ok || got != x*2 || y != 202 {
+			t.Fatalf("snapped x=%d: %d,%d", x, got, y)
+		}
+	}
+	c.MinX, c.MaxX, c.MinY, c.MaxY = 265, 375, 205, 235
+	x, y, ok := cursorPosition(c, 10, 10)
+	if !ok || x != 530 || y != 330 {
+		t.Fatal("title bounds")
+	}
+	x, y, ok = cursorPosition(c, 1200, 700)
+	if !ok || x != 750 || y != 390 {
+		t.Fatal("inclusive upper bounds")
+	}
+	c.HotX, c.HotY = 3, 4
+	x, y, _ = cursorPosition(c, 600, 350)
+	if x != 594 || y != 342 {
+		t.Fatal("hotspot")
+	}
+	c = &hrrt.Cursor{HotX: 5, HotY: 5}
+	x, y, _ = cursorPosition(c, 0, 0)
+	if x != 0 || y != 0 {
+		t.Fatal("hotspot lower clamp")
+	}
+	for _, p := range [][2]int{{-1, 0}, {0, -1}, {1280, 1}, {1, 800}} {
+		if _, _, ok := cursorPosition(c, p[0], p[1]); ok {
+			t.Fatal("outside window")
+		}
+	}
+	if _, _, ok := cursorPosition(nil, 100, 100); ok {
+		t.Fatal("hidden cursor")
+	}
+}
+
+func TestCursorFrameMatchesRetainedOriginalImage(t *testing.T) {
+	gr := newGameRig(t, themeOriginal, []themeID{themeHD})
+	g := gr.g
+	g.ensureImages()
+	screen := ebiten.NewImage(logicalW, logicalH)
+	f := gr.ss.frame
+	f.CursorManaged = true
+	f.Cursor = &hrrt.Cursor{}
+	g.drawGame(screen)
+	original := g.drawnFrame
+	if original == nil || original.Cursor == nil {
+		t.Fatal("original frame not uploaded")
+	}
+	// 上一次 HD 底圖的游標已隱藏；原版底圖仍是舊的 visible 快照。
+	g.hdFrame = newFakeFrame(vramW, vramH, 2)
+	g.drawnFrame = g.hdFrame
+	gr.ss.frame = newFakeFrame(vramW, vramH, 3)
+	gr.ss.frame.CursorPending = true
+	gr.ss.frame.CursorDeadline = time.Now().Add(100 * time.Millisecond)
+	g.drawGame(screen)
+	if g.drawnFrame != original {
+		t.Fatal("retained original image used cursor from another GPU image")
+	}
+	// 沒有新快照，原本 Pending 的同一張 frame 仍會到期發布 raw。
+	time.Sleep(time.Until(gr.ss.frame.CursorDeadline) + time.Millisecond)
+	g.drawGame(screen)
+	if g.drawnFrame == original || g.drawnFrame.CursorManaged || g.lastSq != 3 {
+		t.Fatal("stopped pending frame never reached original GPU image")
+	}
+}
+
+func TestCursorUnrestrictedBoundsAndFarEdges(t *testing.T) {
+	c := &hrrt.Cursor{MinX: 100, MinY: 100} // Max=0：不套用該軸範圍。
+	for _, tc := range []struct{ x, y, wantX, wantY int }{
+		{0, 0, 0, 0}, {1, 1, 0, 0}, {1279, 799, 1278, 798},
+	} {
+		x, y, ok := cursorPosition(c, tc.x, tc.y)
+		if !ok || x != tc.wantX || y != tc.wantY {
+			t.Fatalf("position %d,%d: %d,%d %v", tc.x, tc.y, x, y, ok)
+		}
+	}
+	c = &hrrt.Cursor{MinX: 500, MaxX: 100, MinY: 300, MaxY: 200}
+	x, y, ok := cursorPosition(c, 0, 0)
+	if !ok || x != 200 || y != 320 {
+		t.Fatal("inverted bounds differ from DOS sequential clamp")
+	}
+}
