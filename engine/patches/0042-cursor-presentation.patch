+func cursorFixture() (*Frame, []byte) {
+	f := &Frame{W: 640, H: 480, Px: make([]byte, 640*480)}
+	mem := make([]byte, machine.MemSize)
+	d := mem[cursorData:]
+	put := func(o, n int) { binary.LittleEndian.PutUint16(d[o:], uint16(n)) }
+	put(0x19, 1)
+	put(0x1b, 1)
+	put(0x1d, 12)
+	put(0x1f, 100)
+	put(0x21, 5)
+	put(0x23, 32)
+	for _, off := range []int{0x2a9, 0x1bd1} {
+		put(off, 40)
+		put(off+2, 32)
+		d[off+4] = 1
+		d[off+5] = 0x80
+		d[off+5+20] = 0x80
+	}
+	// 一個不透明色 1 像素；背景色 6，透明鄰格刻意維持色 9。
+	f.Px[140*640+96] = 1
+	f.Px[140*640+97] = 9
+	d[0x1d+8+5] = 0x80
+	d[0x1d+8+10] = 0x80
+	return f, mem
+}
