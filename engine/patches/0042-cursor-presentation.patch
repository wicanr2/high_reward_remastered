+func TestCursorPendingDeadlineDoesNotReset(t *testing.T) {
+	f, mem := cursorFixture()
+	f.Px[140*640+96] = 2
+	s := &Session{m: machine.New()}
+	s.m.Mem = mem
+	s.d = dos.New(s.m, "")
+	now := time.Unix(100, 0)
+	for _, ms := range []int{0, 100, 400, 500, 600, 900} {
+		frame := &Frame{W: f.W, H: f.H, Px: f.Px}
+		s.captureCursor(frame, now.Add(time.Duration(ms)*time.Millisecond))
+		if frame.CursorPending != (ms < 500) || frame.Cursor != nil {
+			t.Fatalf("deadline reset at %d", ms)
+		}
+		if ms >= 500 && frame.Presentation() != frame {
+			t.Fatal("fallback must use raw and no native cursor")
+		}
+	}
+	f.Px[140*640+96] = 1
+	s.captureCursor(f, now.Add(time.Second))
+	if f.Cursor == nil || !s.cursorWaitAt.IsZero() {
+		t.Fatal("did not recover")
+	}
+}
