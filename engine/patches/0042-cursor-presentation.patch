+func TestCursorIntermediateFlagsAndEmptyMaskWait(t *testing.T) {
+	for _, flags := range [][2]uint16{{0, 1}, {1, 0}, {2, 1}} {
+		f, mem := cursorFixture()
+		binary.LittleEndian.PutUint16(mem[cursorData+0x19:], flags[0])
+		binary.LittleEndian.PutUint16(mem[cursorData+0x1b:], flags[1])
+		ok, pending, _ := prepareCursor(f, mem, [4]int{})
+		if !ok || !pending || f.Cursor != nil || f.CursorBackground != nil {
+			t.Fatalf("intermediate flags %v published cursor", flags)
+		}
+	}
+	f, mem := cursorFixture()
+	mem[cursorData+0x1bd1+5+20] = 0
+	ok, pending, _ := prepareCursor(f, mem, [4]int{})
+	if !ok || !pending {
+		t.Fatal("empty mask must wait for a complete draw")
+	}
+}
