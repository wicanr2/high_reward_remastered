+		t.Errorf("loading 時 F2：state ＝ %v、toast ＝ %q、Preload ＝ %d", r.sw.State(), r.toast(langTW), l.count("Preload"))
+	}
+	r.clk.advance(loadTimeout)
+	r.tick()
+	r.clk.advance(3 * time.Second) // 讓上一則 toast 過期，確認是新的忽略提示
