+	}
+	for _, c := range cases {
+		got := resolveStartup(c.f, c.env, c.p, c.avail)
+		if got.Theme != c.theme || got.Lang != c.lang || got.Muted != c.muted || got.HDHooks != c.hooks {
+			t.Errorf("%s：結果 theme ＝ %q、lang ＝ %q、muted ＝ %v、hooks ＝ %v，應為 %q、%q、%v、%v",
+				c.name, got.Theme, got.Lang, got.Muted, got.HDHooks, c.theme, c.lang, c.muted, c.hooks)
+		}
+		for _, sub := range c.logSubs {
+			if !hasLog(got, sub) {
+				t.Errorf("%s：日誌應含 %q，實際 %v", c.name, sub, got.Logs)
+			}
+		}
+		if c.noLogs && len(got.Logs) != 0 {
+			t.Errorf("%s：不該有日誌，實際 %v", c.name, got.Logs)
+		}
+	}
+}
+
+// 偏好設定的值不可用時不覆寫檔案（resolveStartup 只回計畫，不寫任何東西；寫入只經 prefsWriter 的補丁）。
+func TestResolveStartupDoesNotTouchPrefsFile(t *testing.T) {
+	dir := t.TempDir()
+	path := prefsPath(dir)
+	want := `{"version":1,"theme":"ai","lang":"xx"}`
+	os.WriteFile(path, []byte(want), 0o644)
+	p := loadPrefs(path)
+	_ = resolveStartup(startupFlags{}, startupEnv{}, p, []themeID{themeOriginal, themeHD})
+	if got := readStr(t, path); got != want {
+		t.Fatalf("啟動不該改偏好設定檔：%q", got)
+	}
+}
+
+// ---- loadThemes：用只含 TSV 的暫存目錄（不含任何原版素材） ----
+
+func hx64(c byte) string { return strings.Repeat(string(c), 64) }
+
+type tsvRow struct {
+	hash string
+	w, h int
+	pal  string
+	hd   string
+}
+
+// writeTSVTheme 在暫存目錄寫 catalog.tsv 與 palettes.tsv（調色盤名稱 MAIN）。
+func writeTSVTheme(t *testing.T, rows []tsvRow) string {
+	t.Helper()
+	dir := t.TempDir()
+	var b strings.Builder
+	b.WriteString("hash\tid\tw\th\tkind\tpal\thd\n")
+	for _, r := range rows {
+		b.WriteString(r.hash + "\tS:" + r.hash[:4] + "\t" + strconv.Itoa(r.w) + "\t" + strconv.Itoa(r.h) + "\tsprite\t" + r.pal + "\t" + r.hd + "\n")
+	}
+	if err := os.WriteFile(filepath.Join(dir, "catalog.tsv"), []byte(b.String()), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	pal := "MAIN\t" + strings.TrimSpace(strings.Repeat("000000 ", 16)) + "\n"
+	if err := os.WriteFile(filepath.Join(dir, "palettes.tsv"), []byte("name\tpalette16\n"+pal), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return dir
+}
+
+func TestLoadThemes(t *testing.T) {
+	rowX := tsvRow{hash: hx64('a'), w: 4, h: 4, pal: "MAIN"}
+	rowY := tsvRow{hash: hx64('b'), w: 4, h: 4, pal: "MAIN"}
+	rowXbadSize := tsvRow{hash: hx64('a'), w: 8, h: 4, pal: "MAIN"}
+	rowXbadPal := tsvRow{hash: hx64('a'), w: 4, h: 4, pal: "NOPE"}
+	rowXpng := tsvRow{hash: hx64('a'), w: 4, h: 4, pal: "MAIN", hd: "s/missing.png"}
+	var lg lineLog
+
+	t.Run("兩個都通過：hd 是基底，ai 是衍生", func(t *testing.T) {
+		hdDir, aiDir := writeTSVTheme(t, []tsvRow{rowX, rowY}), writeTSVTheme(t, []tsvRow{rowX})
+		ts := loadThemes(map[themeID]string{themeHD: hdDir, themeAI: aiDir}, 2, lg.logf)
+		if ts.Base != themeHD || ts.BaseAssets() == nil || ts.Assets[themeHD] == nil || ts.Assets[themeAI] == nil {
+			t.Fatalf("結果 %+v", ts)
+		}
+		if got := ts.Available(); !reflect.DeepEqual(got, []themeID{themeOriginal, themeHD, themeAI}) {
+			t.Errorf("Available ＝ %v", got)
+		}
+		es := ts.Entries()
+		if len(es) != 2 || es[0].id != themeHD || es[1].id != themeAI || es[0].loader == nil || es[1].assets != ts.Assets[themeAI] {
+			t.Errorf("Entries ＝ %+v", es)
+		}
+	})
+	t.Run("衍生 theme 的檢查不符就不可用", func(t *testing.T) {
+		for name, row := range map[string]tsvRow{"雜湊不在基底": rowY, "尺寸不符": rowXbadSize, "調色盤缺名": rowXbadPal, "PNG 缺檔": rowXpng} {
+			hdDir, aiDir := writeTSVTheme(t, []tsvRow{rowX}), writeTSVTheme(t, []tsvRow{row})
+			lg = lineLog{}
+			ts := loadThemes(map[themeID]string{themeHD: hdDir, themeAI: aiDir}, 2, lg.logf)
+			if ts.Base != themeHD || ts.Assets[themeAI] != nil {
+				t.Errorf("%s：ai 應被拒絕：%+v", name, ts.Assets)
+			}
+			if got := ts.Available(); !reflect.DeepEqual(got, []themeID{themeOriginal, themeHD}) {
+				t.Errorf("%s：Available ＝ %v", name, got)
+			}
+			if !lg.has("未通過檢查") {
+				t.Errorf("%s：應記一行：%v", name, lg.all())
+			}
+		}
+	})
+	t.Run("只有 hd-ai：它是基底，不經 CheckTheme", func(t *testing.T) {
+		// 這份 ai 清冊的列若拿去對 hd 基底檢查會被拒（尺寸不符），當基底則只過 LoadAssets
+		aiDir := writeTSVTheme(t, []tsvRow{rowXbadSize, rowY})
+		ts := loadThemes(map[themeID]string{themeAI: aiDir}, 2, nil)
+		if ts.Base != themeAI || ts.BaseAssets() == nil {
+			t.Fatalf("結果 %+v", ts)
+		}
+		if got := ts.Available(); !reflect.DeepEqual(got, []themeID{themeOriginal, themeAI}) {
+			t.Errorf("Available ＝ %v", got)
+		}
+	})
+	t.Run("hd 的 TSV 壞掉：hd-ai 成為基底，記一行", func(t *testing.T) {
+		badHD := t.TempDir() // 沒有 catalog.tsv
+		aiDir := writeTSVTheme(t, []tsvRow{rowX})
+		lg = lineLog{}
+		ts := loadThemes(map[themeID]string{themeHD: badHD, themeAI: aiDir}, 2, lg.logf)
+		if ts.Base != themeAI || ts.Assets[themeHD] != nil {
+			t.Fatalf("結果 %+v", ts)
+		}
+		if !lg.has("載入失敗") {
+			t.Errorf("應記一行：%v", lg.all())
+		}
+	})
+	t.Run("沒有任何目錄", func(t *testing.T) {
+		ts := loadThemes(nil, 2, nil)
+		if ts.Base != "" || ts.BaseAssets() != nil || !reflect.DeepEqual(ts.Available(), []themeID{themeOriginal}) || len(ts.Entries()) != 0 {
+			t.Fatalf("結果 %+v", ts)
+		}
+		var nilSet *themeSet
+		if nilSet.BaseAssets() != nil || len(nilSet.Available()) != 1 || len(nilSet.Entries()) != 0 {
+			t.Error("nil themeSet 應安全")
+		}
+	})
+	t.Run("兩個都壞", func(t *testing.T) {
+		ts := loadThemes(map[themeID]string{themeHD: t.TempDir(), themeAI: t.TempDir()}, 2, nil)
+		if ts.Base != "" || len(ts.Assets) != 0 {
+			t.Fatalf("結果 %+v", ts)
+		}
+	})
+}
diff --git a/apps/hr/play/switcher.go b/apps/hr/play/switcher.go
new file mode 100644
index 0000000..7586dc8
--- /dev/null
+++ b/apps/hr/play/switcher.go
@@ -0,0 +1,461 @@
+package main
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+// F2 的 theme 切換狀態機（docs/spec/006 第 4 節）。純邏輯：經縫隙（seams.go）注入素材載入器、時鐘、HoldAdapt 與
+// hdView，不依賴 ebiten。所有欄位只由 UI 執行緒（Update）讀寫；唯一的背景 goroutine 是預載，它的結果經通道回到
+// UI，進度只寫 toaster（有鎖）。時間全部以注入時鐘的 Now() 差值判斷，沒有 time.AfterFunc。
+//
+// 用法（B2 在 game.go）：每次 Update 呼叫一次 Tick；F2 呼叫 PressF2；結束時呼叫 Quit。
+// 顯示來源（imgOrig 或 imgHD）由 Display() 與 SetDisplay 回呼告知。
+
+const (
+	loadTimeout   = 60 * time.Second // 預載計時器
+	applyWait     = 2 * time.Second  // applying 等 ready 非空的上限
+	errCheckEvery = 60 * time.Second // 已套用 theme 的 ErrorStats 檢查間隔
+	timeoutLimit  = 2                // 連續逾時達此數，theme 標為不可用
+	toastLife     = 2 * time.Second  // 使用者操作的提示壓過載入進度的時間
+)
+
+// switchState 是切換狀態機的狀態。
+type switchState int
+
+const (
+	stIdle       switchState = iota
+	stLoading                // goroutine 在預載
+	stCancelling             // 已請求取消（計時器或程式結束），goroutine 尚未回來
+	stApplying               // 目標素材就緒，hdView.SetAssets 已呼叫，等第一張新畫面或 2 秒
+)
+
+func (s switchState) String() string {
+	switch s {
+	case stIdle:
+		return "idle"
+	case stLoading:
+		return "loading"
+	case stCancelling:
+		return "cancelling"
+	case stApplying:
+		return "applying"
+	}
+	return "?"
+}
+
+// displaySource 是畫面顯示的來源。
+type displaySource int
+
+const (
+	srcOriginal displaySource = iota // imgOrig：執行層快照放大 2 倍
+	srcHD                            // imgHD：hdView 合成的畫面 1:1
+)
+
+// loadResult 是預載 goroutine 回報給 UI 的結果。
+type loadResult struct {
+	ok, failed int
+	err        error  // 非 nil ＝ ctx 在迴圈頭被取消（Preload 的契約）
+	errN       int    // 被拒與丟棄路徑：goroutine 在 Release 之前讀到的 ErrorStats
+	errFirst   string // 同上，整個 Assets 的第一筆原因
+}
+
+// toastMsg 是一則提示：字串表的鍵與引數。引數中的 themeID 在顯示時依當時的語言換成名稱，
+// 所以載入期間切換語言，提示與進度改用新語言。
+type toastMsg struct {
+	key  string
+	args []any
+	raw  string // 非空 ＝ 固定文字（例如 F4 提示的語言名稱，用目標語言自己的名稱），不查字串表
+}
+
+// toaster 管理左下最後一行的提示與載入進度（docs/spec/006 第 3 節）：同一時間只有一則，
+// 使用者操作的提示壓過載入進度 toastLife 秒，之後進度恢復顯示（到結束）。進度由預載 goroutine 寫入，所以有鎖。
+type toaster struct {
+	mu        sync.Mutex
+	user      toastMsg
+	userEnd   time.Time
+	prog      bool
+	progTheme themeID
+	progDone  int
+	progTotal int
+}
+
+// Show 顯示使用者操作的提示，toastLife 後消失；新的取代舊的。
+func (t *toaster) Show(now time.Time, key string, args ...any) {
+	t.mu.Lock()
+	t.user, t.userEnd = toastMsg{key: key, args: args}, now.Add(toastLife)
+	t.mu.Unlock()
+}
+
+// ShowRaw 顯示固定文字的提示（不查字串表），規則同 Show。F4 的提示用它：顯示目標語言自己的名稱（langNames）。
+func (t *toaster) ShowRaw(now time.Time, text string) {
+	t.mu.Lock()
+	t.user, t.userEnd = toastMsg{raw: text}, now.Add(toastLife)
+	t.mu.Unlock()
+}
+
+// SetProgress 設定載入進度（可由任何 goroutine 呼叫）。
+func (t *toaster) SetProgress(id themeID, done, total int) {
+	t.mu.Lock()
+	t.prog, t.progTheme, t.progDone, t.progTotal = true, id, done, total
+	t.mu.Unlock()
+}
+
+// ClearProgress 結束載入進度的顯示。
+func (t *toaster) ClearProgress() {
+	t.mu.Lock()
+	t.prog = false
+	t.mu.Unlock()
+}
+
+// Current 回傳 now 這一刻要顯示的文字（l 語言）；沒有就回 ("", false)。
+func (t *toaster) Current(now time.Time, l lang) (string, bool) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if now.Before(t.userEnd) {
+		return toastText(l, t.user), true
+	}
+	if t.prog {
+		pct := 0
+		if t.progTotal > 0 {
+			pct = t.progDone * 100 / t.progTotal
+		}
+		return toastText(l, toastMsg{key: "toast.theme.load", args: []any{t.progTheme, pct}}), true
+	}
+	return "", false
+}
+
+func toastText(l lang, m toastMsg) string {
+	if m.raw != "" {
+		return m.raw
+	}
+	args := make([]any, len(m.args))
+	for i, a := range m.args {
+		if id, ok := a.(themeID); ok {
+			args[i] = themeName(l, id)
+		} else {
+			args[i] = a
+		}
+	}
+	return tr(l, m.key, args...)
+}
+
+// switcherConfig 是 newSwitcher 的參數。
+type switcherConfig struct {
+	Themes     []themeEntry            // 可切換的 HD theme（hd、ai 的順序）；不含 original
+	Start      themeID                 // 啟動時的 theme（HD theme 視為已常駐：沿用延遲解碼，不預載）
+	View       viewControl             // 必填
+	Hold       holder                  // HoldAdapt；nil ＝ 不保護（測試或沒有 Session）
+	Clock      clock                   // nil ＝ 真實時鐘
+	Commit     func(p prefsPatch)      // 提交偏好設定補丁（切換完成時）；nil ＝ 不提交
+	Logf       func(string, ...any)    // nil ＝ 不記
+	Toast      *toaster                // nil ＝ 內部建一個
+	SetDisplay func(src displaySource) // 顯示來源改變時的回呼；nil ＝ 不通知（呼叫端讀 Display()）
+}
+
+// switcher 是 F2 的切換狀態機。
+type switcher struct {
+	view       viewControl
+	hold       holder
+	clk        clock
+	commit     func(prefsPatch)
+	logf       func(string, ...any)
+	toast      *toaster
+	setDisplay func(displaySource)
+
+	themes   map[themeID]themeEntry
+	cur      themeID // 目前 theme：進入 applying 時就更新為目標
+	display  displaySource
+	state    switchState
+	resident map[themeID]bool // 已載入並套用過（或啟動時使用）的 HD theme，常駐不 Release
+	rejected map[themeID]bool // 本次執行不可用（被拒，或連續逾時兩次）
+	timeouts map[themeID]int  // 連續逾時計數
+	baseline map[themeID]int  // ErrorStats 基準 n，每個 Assets 一份
+
+	target     themeID
+	timerFired bool // 進入 loading 時清除；計時器觸發時設
+	loadStart  time.Time
+	cancel     context.CancelFunc
+	results    chan loadResult
+	applyStart time.Time
+	release    func() // 目前交易持有的 HoldAdapt 的放開函式；每個 HD 目標交易恰好一取一放
+
+	lastErrCheck time.Time
+}
+
+func newSwitcher(c switcherConfig) *switcher {
+	s := &switcher{
+		view: c.View, hold: c.Hold, clk: c.Clock, commit: c.Commit, logf: c.Logf, toast: c.Toast, setDisplay: c.SetDisplay,
+		themes: map[themeID]themeEntry{}, cur: themeOriginal, display: srcOriginal,
+		resident: map[themeID]bool{}, rejected: map[themeID]bool{}, timeouts: map[themeID]int{}, baseline: map[themeID]int{},
+	}
+	if s.clk == nil {
+		s.clk = realClock{}
+	}
+	if s.logf == nil {
+		s.logf = func(string, ...any) {}
+	}
+	if s.commit == nil {
+		s.commit = func(prefsPatch) {}
+	}
+	if s.setDisplay == nil {
+		s.setDisplay = func(displaySource) {}
+	}
+	if s.toast == nil {
+		s.toast = &toaster{}
+	}
+	for _, e := range c.Themes {
+		s.themes[e.id] = e
+	}
+	if _, ok := s.themes[c.Start]; ok {
+		s.cur, s.display = c.Start, srcHD
+		s.resident[c.Start] = true
+		s.baseline[c.Start] = 0
+	}
+	s.lastErrCheck = s.clk.Now()
+	return s
+}
+
+// Current 是目前的 theme。
+func (s *switcher) Current() themeID { return s.cur }
+
+// Display 是目前的顯示來源。
+func (s *switcher) Display() displaySource { return s.display }
+
+// State 是目前的狀態。
+func (s *switcher) State() switchState { return s.state }
+
+// Toast 是提示與載入進度（F3、F4 的提示也經它顯示）。
+func (s *switcher) Toast() *toaster { return s.toast }
+
+// Usable 是目前可切換的 theme（original 加沒有被拒的 HD theme，依循環順序），F1 狀態列用。
+func (s *switcher) Usable() []themeID {
+	out := []themeID{themeOriginal}
+	for _, id := range hdThemes {
+		if _, ok := s.themes[id]; ok && !s.rejected[id] {
+			out = append(out, id)
+		}
+	}
+	return out
+}
+
+func (s *switcher) avail() []themeID {
+	var out []themeID
+	for _, id := range hdThemes {
+		if _, ok := s.themes[id]; ok {
+			out = append(out, id)
+		}
+	}
+	return out
+}
+
+func (s *switcher) showToast(key string, args ...any) { s.toast.Show(s.clk.Now(), key, args...) }
+
+func (s *switcher) acquireHold() {
+	if s.hold != nil {
+		s.release = s.hold.HoldAdapt()
+	}
+}
+
+func (s *switcher) releaseHold() {
+	if s.release != nil {
+		s.release()
+		s.release = nil
+	}
+}
+
+// PressF2 受理 F2。非 idle 時忽略（不排隊），toast 顯示「載入中」。
+func (s *switcher) PressF2() {
+	if s.state != stIdle {
+		s.showToast("toast.theme.busy")
+		return
+	}
+	next, ok := nextTheme(s.cur, s.avail(), s.rejected)
+	if !ok {
+		s.showToast("toast.theme.none")
+		return
+	}
+	if next == themeOriginal {
+		s.switchToOriginal()
+		return
+	}
+	s.acquireHold() // 每個 HD 目標的交易恰好取得一次
+	if s.resident[next] {
+		s.enterApplying(s.themes[next], false)
+		return
+	}
+	s.startLoad(s.themes[next])
+}
+
+// switchToOriginal 是回 original 的即時路徑：全在 UI 執行緒，不取得 HoldAdapt。目前 HD theme 的 Assets 保留常駐。
+func (s *switcher) switchToOriginal() {
+	s.cur = themeOriginal
+	s.display = srcOriginal
+	s.setDisplay(srcOriginal)
+	s.view.SetAssets(nil)
+	s.commit(themePatch(themeOriginal))
+	s.showToast("toast.theme", themeOriginal)
+	s.logf("theme ready: %s", themeOriginal)
+}
+
+// startLoad 啟動預載 goroutine，進入 loading。進入時清除 timerFired（上一個交易以「完整預載被接受」結束時它可能仍為真）。
+func (s *switcher) startLoad(e themeEntry) {
+	ctx, cancel := context.WithCancel(context.Background())
+	ch := make(chan loadResult, 1)
+	s.target, s.cancel, s.results = e.id, cancel, ch
+	s.timerFired = false
+	s.loadStart = s.clk.Now()
+	s.state = stLoading
+	s.toast.SetProgress(e.id, 0, 0)
+	s.logf("theme %s：開始預載", e.id)
+	toast, loader, id := s.toast, e.loader, e.id
+	go func() {
+		ok, failed, err := loader.Preload(ctx, func(done, total int) { toast.SetProgress(id, done, total) })
+		res := loadResult{ok: ok, failed: failed, err: err}
+		if err != nil || ok == 0 {
+			// 被拒與丟棄路徑：在回報之前同步讀 ErrorStats（Release 會清掉原因）再 Release 目標（未套用、沒有其他使用者）。
+			res.errN, res.errFirst = loader.ErrorStats()
+			loader.Release()
+		}
+		ch <- res
+	}()
+}
+
+// Tick 每次 Update 呼叫一次：處理預載結果（結果優先於計時器）、60 秒計時器、applying 的完成、已套用 theme 的錯誤檢查。
+func (s *switcher) Tick() {
+	now := s.clk.Now()
+	switch s.state {
+	case stLoading, stCancelling:
+		select {
+		case res := <-s.results:
+			s.onResult(res, s.timerFired)
+		default:
+			if s.state == stLoading && now.Sub(s.loadStart) >= loadTimeout {
+				s.timerFired = true
+				s.cancel()
+				s.state = stCancelling
+			}
+		}
+	case stApplying:
+		if s.view.Ready() {
+			s.finishApply()
+		} else if now.Sub(s.applyStart) >= applyWait {
+			s.logf("theme %s：等不到新畫面（%v），仍切換顯示來源", s.cur, applyWait)
+			s.finishApply()
+		}
+	}
+	s.checkErrors(now)
+}
+
+// Quit 是程式結束的取消：取消 ctx，timerFired 維持原值（loading 時為假），進入 cancelling。
+func (s *switcher) Quit() {
+	if s.state != stLoading && s.state != stCancelling {
+		return
+	}
+	if s.cancel != nil {
+		s.cancel()
+	}
+	s.state = stCancelling
+}
+
+// onResult 是預載結果的唯一處理函式（docs/spec/006 第 4 節）。timerFired 是進入這次結果時計時器是否已觸發：
+// err != nil 時，為真就是計時器逾時，為假就是程式結束（取消來源只有這兩個）。
+//  1. err != nil：goroutine 已在回報前 Release 目標。逾時計數加一，達 2 標為不可用；程式結束不計數。放開 HoldAdapt，idle。
+//  2. err ＝ nil 且 ok ＝ 0（含清冊 hd 欄全空的 (0, 0)）：標為不可用並記一行。放開 HoldAdapt，idle。
+//  3. err ＝ nil 且 ok > 0：預載是完整的，即使計時器已經觸發也接受，逾時計數歸零，目標成為常駐，進入 applying。
+func (s *switcher) onResult(res loadResult, timerFired bool) {
+	if s.state != stLoading && s.state != stCancelling {
+		return
+	}
+	id := s.target
+	s.toast.ClearProgress()
+	if s.cancel != nil {
+		s.cancel()
+		s.cancel = nil
+	}
+	s.results = nil
+	switch {
+	case res.err != nil:
+		if timerFired {
+			s.timeouts[id]++
+			n := s.timeouts[id]
+			s.logf("theme %s：預載逾時（%v），已取消並丟棄（連續第 %d 次）", id, loadTimeout, n)
+			if n >= timeoutLimit {
+				s.rejected[id] = true
+				s.logf("theme %s：連續逾時 %d 次，本次執行標為不可用", id, n)
+			}
+			s.showToast("toast.theme.timeout", id)
+		} else {
+			s.logf("theme %s：預載因程式結束而取消", id)
+		}
+		s.endTransaction()
+	case res.ok == 0:
+		s.rejected[id] = true
+		if res.failed > 0 {
+			s.logf("theme %s：預載解碼成功數為 0（失敗 %d 張），本次執行標為不可用；首筆原因：%s", id, res.failed, res.errFirst)
+		} else {
+			s.logf("theme %s：清冊沒有 HD 圖（預載 0 張），本次執行標為不可用", id)
+		}
+		s.showToast("toast.theme.failed", id)
+		s.endTransaction()
+	default:
+		s.timeouts[id] = 0
+		s.resident[id] = true
+		if res.failed > 0 {
+			s.logf("theme %s：預載完成，成功 %d 張，失敗 %d 張（失敗的圖退回基底層）", id, res.ok, res.failed)
+		} else {
+			s.logf("theme %s：預載完成，%d 張", id, res.ok)
+		}
+		s.enterApplying(s.themes[id], true)
+	}
+}
+
+func (s *switcher) endTransaction() {
+	s.releaseHold()
+	s.state = stIdle
+}
+
+// enterApplying：目標素材就緒。fresh（剛預載成功）時把 ErrorStats 基準設為當時的 n（預載階段的失敗已在 onResult
+// 記過）；常駐的目標不重設基準（切走期間沒有 Get，n 不變）。先設基準再 SetAssets（之後合成才會增加 n）。
+func (s *switcher) enterApplying(e themeEntry, fresh bool) {
+	if fresh {
+		n, _ := e.loader.ErrorStats()
+		s.baseline[e.id] = n
+	}
+	s.cur = e.id
+	s.state = stApplying
+	s.applyStart = s.clk.Now()
+	s.view.SetAssets(e.assets)
+}
+
+// finishApply：該世代第一張新畫面已發佈（或 2 秒到期）。更新顯示來源（從 original 來才需要，HD 到 HD 不變）、
+// toast、記 theme ready、提交偏好補丁、放開 HoldAdapt。
+func (s *switcher) finishApply() {
+	if s.display != srcHD {
+		s.display = srcHD
+		s.setDisplay(srcHD)
+	}
+	s.showToast("toast.theme", s.cur)
+	s.logf("theme ready: %s", s.cur)
+	s.commit(themePatch(s.cur))
+	s.endTransaction()
+}
+
+// checkErrors 每 errCheckEvery 檢查已套用 theme 的逐圖錯誤：n 比基準增加時記一行（新增筆數與整個 Assets 的
+// 第一筆原因），記錄後基準前進；不逐筆記。已套用的 Assets 不 Release，所以 n 單調不減。
+func (s *switcher) checkErrors(now time.Time) {
+	if now.Sub(s.lastErrCheck) < errCheckEvery {
+		return
+	}
+	s.lastErrCheck = now
+	e, ok := s.themes[s.cur]
+	if !ok {
+		return
+	}
+	n, first := e.loader.ErrorStats()
+	if base := s.baseline[s.cur]; n > base {
+		s.logf("theme %s：新增 %d 筆圖片載入問題（目前共 %d 筆；整個 theme 的第一筆原因：%s）", s.cur, n-base, n, first)
+		s.baseline[s.cur] = n
+	}
+}
