+// ---- 結束、診斷、停機 ----
+
+func TestUpdateQuitDiagAndStop(t *testing.T) {
+	gr := newGameRig(t, themeOriginal, nil)
+	gr.fe.ctrl = true
+	gr.mustFrame(ebiten.KeyD)
+	if !reflect.DeepEqual(gr.ss.diag, []string{"Ctrl+D"}) {
+		t.Errorf("Ctrl+D 應請求診斷：%v", gr.ss.diag)
+	}
+	if err := gr.frame(ebiten.KeyQ); err != ebiten.Termination {
+		t.Errorf("Ctrl+Q 應回 Termination：%v", err)
+	}
+	gr.fe.ctrl = false
+
+	// 正常結束
+	gr.stopCh <- &hrrt.Stop{Kind: hrrt.StopQuit, Msg: "quit"}
+	if err := gr.frame(); err != ebiten.Termination {
+		t.Errorf("正常停機應回 Termination：%v", err)
+	}
+
+	// 異常停機：存現場、顯示停機提示、之後不再送輸入，但前端保留鍵仍然有效
+	gr2 := newGameRig(t, themeOriginal, nil)
+	gr2.stopCh <- &hrrt.Stop{Kind: hrrt.StopStackOverflow, Msg: "堆疊溢位"}
+	gr2.fe.cx, gr2.fe.cy = 100, 100
+	gr2.mustFrame()
+	if !gr2.g.stopped() {
+		t.Fatal("異常停機後 stopped() 應為真")
+	}
+	if len(gr2.ss.crash) != 1 || !strings.Contains(gr2.ss.crash[0], "stack overflow") || gr2.g.crashDir == "" {
+		t.Errorf("應存現場：%v dir＝%q", gr2.ss.crash, gr2.g.crashDir)
+	}
+	if got := gr2.ss.take(); len(got) != 0 {
+		t.Errorf("停機後不該再送滑鼠輸入：%+v", got)
+	}
+	gr2.mustFrame(ebiten.KeyF4)
+	if gr2.g.lang != langCN {
+		t.Error("停機後 F4 仍應生效")
+	}
+	// 停機提示用目前語言，路徑套用省略規則
+	ht := newHudText(gr2.g.fonts, gr2.g.lang)
+	lines := ht.stop(stopKindName(gr2.g.stop.Kind), gr2.g.crashDir)
+	if len(lines) != 2 || !strings.HasPrefix(lines[0], "已停机：stack overflow") || !strings.HasPrefix(lines[1], "现场存档：") {
+		t.Errorf("停機提示：%q", lines)
+	}
+
+	// 現場存檔失敗：記一行，不顯示目錄
+	gr3 := newGameRig(t, themeOriginal, nil)
+	gr3.ss.crashErr = errors.New("磁碟已滿")
+	gr3.stopCh <- &hrrt.Stop{Kind: hrrt.StopCPUError, Msg: "x"}
+	gr3.mustFrame()
+	if gr3.g.crashDir != "" || !gr3.glog.has("存停機現場失敗") {
+		t.Errorf("crashDir ＝ %q、日誌 %v", gr3.g.crashDir, gr3.glog.all())
+	}
+	if l := newHudText(gr3.g.fonts, langEN).stop("CPU error", gr3.g.crashDir); len(l) != 1 {
+		t.Errorf("沒有現場目錄時停機提示只有一行：%q", l)
+	}
+}
