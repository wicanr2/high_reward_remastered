+// 結果優先：同一次 Tick 內計時器已逾時、結果也已到達，先處理結果（不先觸發計時器）。
+func TestSwitcherResultWinsOverTimerInSameTick(t *testing.T) {
+	r := newRig(t, themeOriginal, themeHD)
+	r.press()
+	if !waitUntil(10*time.Second, func() bool { return len(r.sw.results) == 1 }) {
+		t.Fatal("預載結果沒有送達")
+	}
+	r.clk.advance(61 * time.Second)
+	r.tick() // 同一次 Tick：計時器已逾時，結果也在通道內
+	if r.sw.State() != stApplying || r.sw.timerFired || r.sw.timeouts[themeHD] != 0 {
+		t.Fatalf("結果應優先：state ＝ %v、timerFired ＝ %v、計數 ＝ %d", r.sw.State(), r.sw.timerFired, r.sw.timeouts[themeHD])
+	}
+	r.completeApply()
