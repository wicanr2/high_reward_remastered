+		return errAt("barrier-wait", "等不到 B 的合成開始（pub ＝ %d）", f.v.stats().Pub)
+	}
+	st := f.v.stats()
+	if st.Pub != 0 || st.Ready || st.Discards != 1 {
+		return errAt("barrier-assert", "B 開始合成時 A 那一輪應已被丟棄：pub ＝ %d、ready ＝ %v、discards ＝ %d", st.Pub, st.Ready, st.Discards)
