+package main
+
+import (
+	"image"
+	"image/color"
+	"image/png"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+)
+
+// 切換狀態機搭配真的 *hd.Assets（Preload、ErrorStats、Release）與真的 hdView 的整合測試：
+// 假件測試證明狀態機的邏輯，這裡證明縫隙的真實實作接得起來（簽名與語意一致）。素材是暫存目錄裡的假 theme，不含原版素材。
+
+// writeRealTheme 寫一個 theme：每個 hash 一列（4x4，S ＝ 2 所以 PNG 是 8x8）；ok 為真的列有真 PNG，否則 PNG 缺檔。
+func writeRealTheme(t *testing.T, rows map[string]bool) string {
+	t.Helper()
+	var trs []tsvRow
+	for h := range rows {
+		trs = append(trs, tsvRow{hash: h, w: 4, h: 4, pal: "MAIN", hd: "s/" + h[:8] + ".png"})
+	}
+	dir := writeTSVTheme(t, trs)
+	for _, r := range trs {
+		if !rows[r.hash] {
+			continue
+		}
+		path := filepath.Join(dir, "x2", filepath.FromSlash(r.hd))
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		img := image.NewNRGBA(image.Rect(0, 0, 8, 8))
+		for y := 0; y < 8; y++ {
+			for x := 0; x < 8; x++ {
+				img.SetNRGBA(x, y, color.NRGBA{R: 200, G: 30, B: 30, A: 255})
+			}
+		}
+		f, err := os.Create(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := png.Encode(f, img); err != nil {
+			t.Fatal(err)
+		}
+		f.Close()
+	}
+	return dir
+}
+
+func loadReal(t *testing.T, rows map[string]bool) *hd.Assets {
+	t.Helper()
+	a, err := hd.LoadAssets(writeRealTheme(t, rows), 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+
+// realRig 與 rig 相同，但 theme 的 loader 是真的 *hd.Assets。
+func realRig(t *testing.T, a *hd.Assets) *rig {
+	t.Helper()
+	log := &evLog{}
+	r := &rig{t: t, log: log, clk: newFakeClock(), hold: &fakeHolder{log: log},
+		view:    &fakeView{log: log, names: map[*hd.Assets]string{a: "hd"}},
+		loaders: map[themeID]*fakeLoader{}, assets: map[themeID]*hd.Assets{themeHD: a}}
+	r.sw = newSwitcher(switcherConfig{
+		Themes: []themeEntry{{id: themeHD, assets: a, loader: a}}, Start: themeOriginal, View: r.view, Hold: r.hold, Clock: r.clk,
+		Commit: func(p prefsPatch) { log.add("commit %s", p); r.commits = append(r.commits, p) },
+		Logf:   func(f string, x ...any) { log.add("log: "+f, x...) },
+	})
+	t.Cleanup(r.sw.Quit)
+	return r
+}
+
+// 真的 Assets，全部 PNG 缺檔：Preload 回 (0, 2, nil)；ErrorStats 在 Release 之前讀取，所以日誌有真正的首筆原因；
+// Release 之後真的 Assets 的錯誤歸零。
+func TestSwitcherRealAssetsRejectedKeepsFirstReason(t *testing.T) {
+	a := loadReal(t, map[string]bool{strings.Repeat("a", 64): false, strings.Repeat("b", 64): false})
+	r := realRig(t, a)
+	r.press()
+	r.settle(stIdle)
+	if !r.sw.rejected[themeHD] {
+		t.Fatal("應標為不可用")
+	}
+	if r.log.idx("失敗 2 張") < 0 || r.log.idx("no such file") < 0 && r.log.idx("cannot find") < 0 {
+		t.Errorf("日誌應含失敗數與真正的首筆原因（ErrorStats 在 Release 之前讀取）：%v", r.log.all())
+	}
+	if n, first := a.ErrorStats(); n != 0 || first != "" {
+		t.Errorf("Release 之後錯誤應歸零：(%d, %q)", n, first)
+	}
+	r.wantHold(1, 1)
+}
+
+// 真的 Assets，清冊 hd 欄全空：Preload 回 (0, 0, nil)，沒有 Errors 項目，日誌用固定文字。
+func TestSwitcherRealAssetsEmptyHDColumn(t *testing.T) {
+	r := realRig(t, emptyAssets(t))
+	r.press()
+	r.settle(stIdle)
+	if !r.sw.rejected[themeHD] || r.log.idx("清冊沒有 HD 圖") < 0 || r.log.idx("首筆原因") >= 0 {
+		t.Errorf("(0, 0) 應用固定文字並標為不可用：%v", r.log.all())
+	}
+	r.wantHold(1, 1)
+}
+
+// 真的 Assets 與真的 hdView：original → hd 成功路徑。部分失敗（一張有圖、一張缺檔）照常切換，
+// 預載階段的失敗記一行；hdView 收到目標素材後真的合成並發佈，狀態機因 ready 非空而完成。
+func TestSwitcherIntegrationRealAssetsAndHDView(t *testing.T) {
+	good := strings.Repeat("a", 64)
+	a := loadReal(t, map[string]bool{good: true, strings.Repeat("b", 64): false})
+	src := &fakeSource{}
+	f := newFakeFrame(64, 48, 1)
+	f.Stamps[0].Hash = good
+	src.set(f)
+	hv := newHDView(src, nil, 2) // original 啟動：hdView 暫停
+	t.Cleanup(hv.close)
+	log := &evLog{}
+	clk := newFakeClock()
+	hold := &fakeHolder{log: log}
+	var commits []prefsPatch
+	sw := newSwitcher(switcherConfig{
+		Themes: []themeEntry{{id: themeHD, assets: a, loader: a}}, Start: themeOriginal, View: hv, Hold: hold, Clock: clk,
+		Commit: func(p prefsPatch) { commits = append(commits, p) },
+		Logf:   func(f string, x ...any) { log.add("log: "+f, x...) },
+		SetDisplay: func(s displaySource) {
+			if s == srcHD {
+				log.add("display=hd")
+			}
+		},
+	})
+	t.Cleanup(sw.Quit)
+	if hv.Ready() || hv.Pub() != 0 {
+		t.Fatal("暫停的 hdView 不該有畫面")
+	}
+	sw.PressF2()
+	if !waitUntil(10*time.Second, func() bool { sw.Tick(); return sw.State() == stIdle }) {
+		t.Fatalf("切換沒有完成（state ＝ %v）：%v", sw.State(), log.all())
+	}
+	if hv.Pub() < 1 || !hv.Ready() || hv.stats().PubFrom != a {
+		t.Errorf("hdView 應以目標素材發佈：pub ＝ %d、ready ＝ %v", hv.Pub(), hv.Ready())
+	}
+	if sw.Display() != srcHD || sw.Current() != themeHD || len(commits) != 1 || commits[0].String() != "{theme=hd}" {
+		t.Errorf("display ＝ %v、current ＝ %v、commits ＝ %v", sw.Display(), sw.Current(), commits)
+	}
+	if log.idx("失敗 1 張") < 0 || log.idx("theme ready: hd") < 0 || log.idx("display=hd") < 0 {
+		t.Errorf("日誌：%v", log.all())
+	}
+	if tk, rl := hold.counts(); tk != 1 || rl != 1 {
+		t.Errorf("HoldAdapt 取放 ＝ (%d, %d)", tk, rl)
+	}
+	if n, _ := a.ErrorStats(); n != 1 {
+		t.Errorf("成功路徑不 Release：真的 Assets 的錯誤應保留（1 筆），實際 %d", n)
+	}
+	// 回 original：hdView 暫停（SetAssets(nil)），ready 清空；Assets 常駐（錯誤紀錄仍在）
+	sw.PressF2()
+	if sw.Current() != themeOriginal || hv.Ready() {
+		t.Errorf("回 original：current ＝ %v、ready ＝ %v", sw.Current(), hv.Ready())
+	}
+	if n, _ := a.ErrorStats(); n != 1 {
+		t.Errorf("常駐的 Assets 不 Release：%d", n)
+	}
+}
diff --git a/apps/hr/play/switcher_test.go b/apps/hr/play/switcher_test.go
new file mode 100644
index 0000000..dcb32bd
--- /dev/null
+++ b/apps/hr/play/switcher_test.go
@@ -0,0 +1,1185 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+)
+
+// docs/spec/006 第 4 節與第 10 節「切換狀態機與 onResult」：假 assetLoader、viewControl、holder，注入時鐘。
+// 所有時間（60 秒逾時、2 秒等待、60 秒錯誤檢查）都由假時鐘推進，沒有真實等待。
+
+// ---- 假件 ----
+
+// evLog 是各假件共用的事件日誌（記錄跨假件的先後順序）。
+type evLog struct {
+	mu sync.Mutex
+	ev []string
+}
+
+func (l *evLog) add(format string, a ...any) {
+	l.mu.Lock()
+	l.ev = append(l.ev, fmt.Sprintf(format, a...))
+	l.mu.Unlock()
+}
+
+func (l *evLog) all() []string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([]string(nil), l.ev...)
+}
+
+// idx 回傳第一個含 sub 的事件的索引（沒有回 -1）。
+func (l *evLog) idx(sub string) int {
+	for i, e := range l.all() {
+		if strings.Contains(e, sub) {
+			return i
+		}
+	}
+	return -1
+}
+
+func (l *evLog) count(sub string) int {
+	n := 0
+	for _, e := range l.all() {
+		if strings.Contains(e, sub) {
+			n++
+		}
+	}
+	return n
+}
+
+type fakeClock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func newFakeClock() *fakeClock { return &fakeClock{t: time.Date(2026, 10, 4, 12, 0, 0, 0, time.UTC)} }
+
+func (c *fakeClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.t
+}
+
+func (c *fakeClock) advance(d time.Duration) {
+	c.mu.Lock()
+	c.t = c.t.Add(d)
+	c.mu.Unlock()
+}
+
+// fakeHolder 記錄 HoldAdapt 的取放次數。放開函式刻意不冪等：重複放開會讓 released 多算，測試才看得到。
+type fakeHolder struct {
+	log             *evLog
+	mu              sync.Mutex
+	taken, released int
+}
+
+func (h *fakeHolder) HoldAdapt() func() {
+	h.mu.Lock()
+	h.taken++
+	h.mu.Unlock()
+	h.log.add("hold")
+	return func() {
+		h.mu.Lock()
+		h.released++
+		h.mu.Unlock()
+		h.log.add("unhold")
+	}
+}
+
+func (h *fakeHolder) counts() (taken, released int) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.taken, h.released
+}
+
+// fakeView 假的 hdView：SetAssets 清 ready（與真實一致），publish() 由測試模擬「新畫面已發佈」。
+type fakeView struct {
+	log   *evLog
+	names map[*hd.Assets]string
+	mu    sync.Mutex
+	ready bool
+	pub   uint64
+}
+
+func (v *fakeView) SetAssets(a *hd.Assets) {
+	name := "nil"
+	if a != nil {
+		name = v.names[a]
+	}
+	v.log.add("view.SetAssets(%s)", name)
+	v.mu.Lock()
+	v.ready = false
+	v.mu.Unlock()
+}
+
+func (v *fakeView) Ready() bool {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return v.ready
+}
+
+func (v *fakeView) Pub() uint64 {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return v.pub
+}
+
+func (v *fakeView) publish() {
+	v.mu.Lock()
+	v.ready = true
+	v.pub++
+	v.mu.Unlock()
+}
+
+type loadMode int
+
+const (
+	loadImmediate  loadMode = iota // 立刻回 (ok, failed, nil)
+	loadBlockCtx                   // 阻塞到 ctx 取消，回 (partial, 0, ctx.Err())
+	loadWaitSignal                 // 阻塞到 open()，忽略 ctx，回 (ok, failed, nil)（模擬「跑完全部後計時器才觸發」）
+)
+
+// fakeLoader 是假的 assetLoader：記錄呼叫日誌（Preload、ErrorStats、Release 的先後），可注入慢速載入。
+// ErrorStats 在 Release 之後回 (0, "")，與真實的 Assets 一致（Release 會清掉錯誤原因），
+// 所以「Release 前讀取」的違反在日誌的首筆原因上看得到。
+type fakeLoader struct {
+	name  string
+	log   *evLog
+	mu    sync.Mutex
+	calls []string
+
+	mode       loadMode
+	ok, failed int
+	partial    int
+	steps      int // loadImmediate 呼叫 progress 的次數（預設 4）
+	sig        chan struct{}
+	sigOnce    sync.Once
+	started    chan struct{}
+
+	errN     int
+	errFirst string
+}
+
+func (l *fakeLoader) record(call string) {
+	l.mu.Lock()
+	l.calls = append(l.calls, call)
+	l.mu.Unlock()
+	l.log.add("loader(%s).%s", l.name, call)
+}
+
+func (l *fakeLoader) callList() []string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([]string(nil), l.calls...)
+}
+
+func (l *fakeLoader) count(call string) int {
+	n := 0
+	for _, c := range l.callList() {
+		if c == call {
+			n++
+		}
+	}
+	return n
+}
+
+func (l *fakeLoader) open() { l.sigOnce.Do(func() { close(l.sig) }) }
+
+func (l *fakeLoader) setErrors(n int, first string) {
+	l.mu.Lock()
+	l.errN, l.errFirst = n, first
+	l.mu.Unlock()
+}
+
+func (l *fakeLoader) Preload(ctx context.Context, progress func(done, total int)) (int, int, error) {
+	l.record("Preload")
+	select {
+	case l.started <- struct{}{}:
+	default:
+	}
+	switch l.mode {
+	case loadBlockCtx:
+		progress(1, 10)
+		<-ctx.Done()
+		return l.partial, 0, ctx.Err()
+	case loadWaitSignal:
+		<-l.sig
+		return l.ok, l.failed, nil
+	}
+	steps := l.steps
+	if steps == 0 {
+		steps = 4
+	}
+	for i := 1; i <= steps; i++ {
+		progress(i, steps)
+	}
+	return l.ok, l.failed, nil
+}
+
+func (l *fakeLoader) ErrorStats() (int, string) {
+	l.record("ErrorStats")
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.errN, l.errFirst
+}
+
+func (l *fakeLoader) Release() {
+	l.record("Release")
+	l.mu.Lock()
+	l.errN, l.errFirst = 0, ""
+	l.mu.Unlock()
+}
+
+// rig 是切換狀態機的測試台。
+type rig struct {
+	t       *testing.T
+	log     *evLog
+	clk     *fakeClock
+	hold    *fakeHolder
+	view    *fakeView
+	sw      *switcher
+	loaders map[themeID]*fakeLoader
+	assets  map[themeID]*hd.Assets
+	commits []prefsPatch
+}
+
+func newRig(t *testing.T, start themeID, ids ...themeID) *rig {
+	t.Helper()
+	log := &evLog{}
+	r := &rig{t: t, log: log, clk: newFakeClock(), hold: &fakeHolder{log: log},
+		view:    &fakeView{log: log, names: map[*hd.Assets]string{}},
+		loaders: map[themeID]*fakeLoader{}, assets: map[themeID]*hd.Assets{}}
+	var entries []themeEntry
+	for _, id := range ids {
+		a := emptyAssets(t)
+		l := &fakeLoader{name: string(id), log: log, ok: 5, sig: make(chan struct{}), started: make(chan struct{}, 1)}
+		r.assets[id], r.loaders[id] = a, l
+		r.view.names[a] = string(id)
+		entries = append(entries, themeEntry{id: id, assets: a, loader: l})
+	}
+	r.sw = newSwitcher(switcherConfig{
+		Themes: entries, Start: start, View: r.view, Hold: r.hold, Clock: r.clk,
+		Commit: func(p prefsPatch) {
+			log.add("commit %s", p)
+			r.commits = append(r.commits, p)
+		},
+		Logf: func(f string, a ...any) { log.add("log: "+f, a...) },
+		SetDisplay: func(s displaySource) {
+			if s == srcHD {
+				log.add("display=hd")
+			} else {
+				log.add("display=orig")
+			}
+		},
+	})
+	t.Cleanup(func() {
+		r.sw.Quit()
+		for _, l := range r.loaders {
+			l.open()
+		}
+	})
+	return r
+}
+
+func (r *rig) press() { r.sw.PressF2() }
+func (r *rig) tick()  { r.sw.Tick() }
+
+// settle 反覆 Tick（預載在真實的 goroutine 內跑，結果經通道回來）直到狀態是 want。
+func (r *rig) settle(want switchState) {
+	r.t.Helper()
+	if !waitUntil(10*time.Second, func() bool { r.sw.Tick(); return r.sw.State() == want }) {
+		r.t.Fatalf("等不到狀態 %v（目前 %v）；日誌：%v", want, r.sw.State(), r.log.all())
+	}
+}
+
+// completeApply 模擬「新畫面已發佈」並讓 applying 完成。
+func (r *rig) completeApply() {
+	r.t.Helper()
+	r.view.publish()
+	r.tick()
+	if r.sw.State() != stIdle {
+		r.t.Fatalf("applying 之後應為 idle，實際 %v", r.sw.State())
+	}
+}
+
+func (r *rig) toast(l lang) string {
+	s, _ := r.sw.Toast().Current(r.clk.Now(), l)
+	return s
+}
+
+func (r *rig) commitStrings() []string {
+	var out []string
+	for _, c := range r.commits {
+		out = append(out, c.String())
+	}
+	return out
+}
+
+func (r *rig) wantHold(taken, released int) {
+	r.t.Helper()
+	if tk, rl := r.hold.counts(); tk != taken || rl != released {
+		r.t.Errorf("HoldAdapt 取放 ＝ (%d, %d)，應為 (%d, %d)", tk, rl, taken, released)
+	}
+}
+
+func (r *rig) wantCalls(id themeID, want ...string) {
+	r.t.Helper()
+	if got := r.loaders[id].callList(); !reflect.DeepEqual(got, want) {
+		r.t.Errorf("loader(%s) 的呼叫日誌 ＝ %v，應為 %v", id, got, want)
+	}
+}
+
+func (r *rig) wantOrder(subs ...string) {
+	r.t.Helper()
+	prev := -1
+	for _, s := range subs {
+		i := r.log.idx(s)
+		if i < 0 {
+			r.t.Errorf("日誌沒有 %q：%v", s, r.log.all())
+			return
+		}
+		if i <= prev {
+			r.t.Errorf("%q 應在前一項之後（索引 %d ≤ %d）：%v", s, i, prev, r.log.all())
+		}
+		prev = i
+	}
+}
