+func findFunc(files map[string]*ast.File, file, name string) *ast.FuncDecl {
+	for _, d := range files[file].Decls {
+		if fd, ok := d.(*ast.FuncDecl); ok && fd.Name.Name == name {
+			return fd
+		}
+	}
+	return nil
+}
