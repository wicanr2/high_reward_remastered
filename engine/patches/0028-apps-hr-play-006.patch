+// (0, 0)：清冊 hd 欄全空。沒有 Errors 項目，日誌用固定文字。
+func TestSwitcherRejectedEmptyCatalog(t *testing.T) {
+	r := newRig(t, themeOriginal, themeHD)
+	l := r.loaders[themeHD]
