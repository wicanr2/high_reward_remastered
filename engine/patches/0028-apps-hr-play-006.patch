+// 程式結束後 UI 迴圈已停止、onResult 不會被呼叫，所以直接呼叫 onResult(err != nil, timerFired ＝ false)，
+// 不模擬 UI 迴圈；對照組 timerFired ＝ true 要計數（偵測器不是恆為假）。
+func TestSwitcherOnResultDistinguishesTimerFromQuit(t *testing.T) {
+	for _, c := range []struct {
+		timerFired bool
+		wantCount  int
+	}{{false, 0}, {true, 1}} {
+		r := newRig(t, themeOriginal, themeHD)
+		l := r.loaders[themeHD]
+		l.mode = loadBlockCtx
+		r.press()
+		<-l.started
+		r.sw.onResult(loadResult{err: context.Canceled}, c.timerFired)
+		if got := r.sw.timeouts[themeHD]; got != c.wantCount {
+			t.Errorf("onResult(err, timerFired ＝ %v)：逾時計數 ＝ %d，應為 %d", c.timerFired, got, c.wantCount)
+		}
+		if r.sw.State() != stIdle {
+			t.Errorf("onResult 之後應為 idle：%v", r.sw.State())
+		}
+		r.wantHold(1, 1)
+	}
+}
