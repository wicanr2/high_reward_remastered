+// tr 回傳 l 語言的字串並套用格式；缺鍵時退回繁體中文，再缺回傳鍵名（測試保證不會發生）。
+func tr(l lang, key string, args ...any) string {
+	s, ok := trTable[l][key]
+	if !ok {
+		if s, ok = trTable[langTW][key]; !ok {
+			s = key
+		}
+	}
+	if len(args) == 0 {
+		return s
+	}
+	return fmt.Sprintf(s, args...)
+}
+
+// themeName 是 theme 在 l 語言的顯示名稱（原版、HD、AI 重繪）。
+func themeName(l lang, id themeID) string { return tr(l, "theme."+string(id)) }
+
+// themeListText 是 F1 狀態列「可用」清單：各 theme 的顯示名稱，以該語言的分隔符連接。
+func themeListText(l lang, ids []themeID) string {
+	names := make([]string, len(ids))
+	for i, id := range ids {
+		names[i] = themeName(l, id)
+	}
+	return strings.Join(names, tr(l, "list.sep"))
+}
+
+// toASCII 把非 ASCII 字元換成 '?'（字型載入失敗時退回 DebugPrintAt，它只畫得出 ASCII，docs/spec/006 第 3 節）。
+func toASCII(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if (r < 0x20 && r != '\n') || r > 0x7E {
+			r = '?'
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// trASCII 是 ASCII 英文版的字串（退回字型用）：英文字串表套用格式後，非 ASCII 字元換成 '?'。
+func trASCII(key string, args ...any) string { return toASCII(tr(langEN, key, args...)) }
