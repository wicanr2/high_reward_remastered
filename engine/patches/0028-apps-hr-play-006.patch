+// main.go 的接線測試：所有結束路徑都經 quit（docs/spec/006 第 7 節、第 10 節的靜態檢查）與啟動接線。
+
+func parseSources(t testing.TB, srcs map[string]string) (*token.FileSet, map[string]*ast.File) {
+	t.Helper()
+	fset := token.NewFileSet()
+	out := map[string]*ast.File{}
+	for name, src := range srcs {
+		f, err := parser.ParseFile(fset, name, src, 0)
+		if err != nil {
+			t.Fatalf("%s：%v", name, err)
+		}
+		out[name] = f
+	}
+	return fset, out
+}
+
+// parsePackage 解析本目錄所有非測試的 .go 檔。
+func parsePackage(t testing.TB) (*token.FileSet, map[string]*ast.File) {
+	t.Helper()
+	ents, err := os.ReadDir(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	srcs := map[string]string{}
+	for _, e := range ents {
+		n := e.Name()
+		if strings.HasSuffix(n, ".go") && !strings.HasSuffix(n, "_test.go") {
+			b, err := os.ReadFile(n)
+			if err != nil {
+				t.Fatal(err)
+			}
+			srcs[n] = string(b)
+		}
+	}
+	if len(srcs) < 10 {
+		t.Fatalf("只找到 %d 個原始檔", len(srcs))
+	}
+	return parseSources(t, srcs)
+}
+
+func isExitCall(c *ast.CallExpr) (string, bool) {
+	sel, ok := c.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return "", false
+	}
+	x, ok := sel.X.(*ast.Ident)
+	if !ok {
+		return "", false
+	}
+	switch {
+	case x.Name == "os" && sel.Sel.Name == "Exit":
+		return "os.Exit", true
+	case x.Name == "syscall" && sel.Sel.Name == "Exit":
+		return "syscall.Exit", true
+	case x.Name == "log" && strings.HasPrefix(sel.Sel.Name, "Fatal"):
+		return "log." + sel.Sel.Name, true
+	}
+	return "", false
+}
+
+func isCallTo(n ast.Node, name string) (*ast.CallExpr, bool) {
+	c, ok := n.(*ast.CallExpr)
+	if !ok {
+		return nil, false
+	}
+	switch f := c.Fun.(type) {
+	case *ast.Ident:
+		return c, f.Name == name
+	case *ast.SelectorExpr:
+		return c, f.Sel.Name == name
+	}
+	return nil, false
+}
+
+// exitViolations 找出不被允許的結束呼叫（os.Exit、syscall.Exit、log.Fatal*）。允許的位置只有三處：
+//   - main.go 的 quit（所有結束路徑的唯一出口）；
+//   - errwin.go 的 fail（啟動失敗的錯誤視窗，偏好設定寫入者尚未建立）；
+//   - main.go 的 main 中、第一個 newPrefsWriter 呼叫之前（寫入者尚未建立，沒有東西要 flush），且不在函式字面值內
+//     （字面值可能在寫入者建立之後才執行）。
+func exitViolations(fset *token.FileSet, files map[string]*ast.File) []string {
+	var out []string
+	names := make([]string, 0, len(files))
+	for n := range files {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		for _, d := range files[name].Decls {
+			fd, ok := d.(*ast.FuncDecl)
+			if !ok || fd.Body == nil {
+				continue
+			}
+			fn := fd.Name.Name
+			if fd.Recv != nil {
+				fn = "(方法)" + fn
+			}
+			var prefsPos token.Pos
+			if name == "main.go" && fn == "main" {
+				ast.Inspect(fd.Body, func(n ast.Node) bool {
+					if c, ok := isCallTo(n, "newPrefsWriter"); ok && !prefsPos.IsValid() {
+						prefsPos = c.Pos()
+					}
+					return true
+				})
+			}
+			var walk func(n ast.Node, inLit bool)
+			walk = func(n ast.Node, inLit bool) {
+				ast.Inspect(n, func(x ast.Node) bool {
+					if lit, ok := x.(*ast.FuncLit); ok && x != n {
+						walk(lit.Body, true)
+						return false
+					}
+					c, ok := x.(*ast.CallExpr)
+					if !ok {
+						return true
+					}
+					what, isExit := isExitCall(c)
+					if !isExit {
+						return true
+					}
+					allowed := false
+					switch {
+					case inLit:
+					case name == "main.go" && fn == "quit":
+						allowed = true
+					case name == "errwin.go" && fn == "fail":
+						allowed = true
+					case name == "main.go" && fn == "main":
+						allowed = prefsPos.IsValid() && c.Pos() < prefsPos
+					}
+					if !allowed {
+						out = append(out, fset.Position(c.Pos()).String()+"："+what+" 出現在 "+fn+"（函式字面值內 ＝ "+map[bool]string{true: "是", false: "否"}[inLit]+"）")
+					}
+					return true
+				})
+			}
+			walk(fd.Body, false)
+		}
+	}
+	return out
+}
