+// applying 等 ready 非空或 2 秒：2 秒到期仍切換（已知差異），記一行。
+func TestSwitcherApplyingTimesOutAfter2Seconds(t *testing.T) {
+	r := newRig(t, themeOriginal, themeHD)
+	r.press()
+	r.settle(stApplying)
+	r.clk.advance(1900 * time.Millisecond)
+	r.tick()
+	if r.sw.State() != stApplying {
+		t.Fatal("1.9 秒不該逾時")
+	}
+	r.clk.advance(100 * time.Millisecond)
+	r.tick()
+	if r.sw.State() != stIdle || r.sw.Display() != srcHD {
+		t.Fatalf("2 秒到期仍切換：state ＝ %v、display ＝ %v", r.sw.State(), r.sw.Display())
+	}
+	if r.log.idx("等不到新畫面") < 0 {
+		t.Error("2 秒逾時應記一行")
+	}
+	r.wantOrder("display=hd", "log: theme ready: hd", "commit {theme=hd}", "unhold")
+	r.wantHold(1, 1)
+}
+
+// HD 到 HD：顯示來源不變（不呼叫 SetDisplay）；切到 original 是即時路徑（順序：顯示來源、SetAssets(nil)、提交補丁、
+// theme ready），不取得 HoldAdapt；切回已常駐的 theme 直接 applying，沒有 Preload 也沒有 Release。
+func TestSwitcherHDToHDOriginalAndResident(t *testing.T) {
+	r := newRig(t, themeHD, themeHD, themeAI)
+	r.press() // hd → ai（未常駐）
+	if r.sw.State() != stLoading {
+		t.Fatalf("hd 到 ai 要預載：%v", r.sw.State())
+	}
+	r.settle(stApplying)
+	r.completeApply()
+	if r.sw.Current() != themeAI || r.log.idx("display=") >= 0 {
+		t.Fatalf("HD 到 HD 顯示來源不變：current ＝ %v、日誌 ＝ %v", r.sw.Current(), r.log.all())
+	}
+	r.wantHold(1, 1)
+
+	r.press() // ai → original：即時
+	if r.sw.State() != stIdle || r.sw.Current() != themeOriginal || r.sw.Display() != srcOriginal {
+		t.Fatalf("回 original 是即時路徑：%v、%v、%v", r.sw.State(), r.sw.Current(), r.sw.Display())
+	}
+	r.wantOrder("display=orig", "view.SetAssets(nil)", "commit {theme=original}", "log: theme ready: original")
+	r.wantHold(1, 1) // original 目標不取得
+	if n := r.log.count("commit {theme=original}"); n != 1 {
+		t.Errorf("回 original 應提交一次補丁，實際 %d 次", n)
+	}
+
+	r.press() // original → hd（已常駐）：直接 applying
+	if r.sw.State() != stApplying || r.sw.Current() != themeHD {
+		t.Fatalf("切回常駐的 theme 應直接 applying：%v、%v", r.sw.State(), r.sw.Current())
+	}
+	if r.sw.Display() != srcOriginal {
+		t.Fatal("applying 期間顯示來源仍是原版")
+	}
+	r.completeApply()
+	if r.sw.Display() != srcHD {
+		t.Fatal("新畫面發佈後顯示來源換成 HD")
+	}
+	r.wantCalls(themeHD) // 啟動 theme：從頭到尾沒有 Preload、ErrorStats、Release
+	r.wantCalls(themeAI, "Preload", "ErrorStats")
+	if r.log.count("Release") != 0 {
+		t.Error("已套用的常駐 theme 不 Release")
+	}
+	r.wantHold(2, 2)
+	if n := r.log.count("display=hd"); n != 1 {
+		t.Errorf("display=hd 應只在 original 到 HD 時出現一次，實際 %d", n)
+	}
+}
