+// 真的 hdView：暫停（素材為 nil）時 ready 為空 → writePNG 回 errNoFrame → 退回；恢復並發佈後存 1280x800。
+func TestScreenshotWithRealHDView(t *testing.T) {
+	src := &fakeSource{}
+	src.set(newFakeFrame(vramW, vramH, 1))
+	hv := newHDView(src, nil, hdScale)
+	t.Cleanup(hv.close)
+
+	gr := newGameRig(t, themeHD, []themeID{themeHD}, withHV(hv))
+	gr.mustFrame(ebiten.KeyF12)
+	got := shots(t, gr.dir)
+	if len(got) != 1 || pngSize(t, got[0]) != image.Pt(640, 400) || !gr.glog.has("改存原版快照") {
+		t.Fatalf("hdView 暫停：%v、日誌 %v", got, gr.glog.all())
+	}
+	if err := hv.writePNG(filepath.Join(gr.dir, "x.png")); !errors.Is(err, errNoFrame) {
+		t.Fatalf("暫停的 hdView.writePNG 應回 errNoFrame：%v", err)
+	}
+
+	hv.SetAssets(emptyAssets(t))
+	if !waitUntil(10*time.Second, hv.Ready) {
+		t.Fatal("hdView 沒有發佈畫面")
+	}
+	gr2 := newGameRig(t, themeHD, []themeID{themeHD}, withHV(hv))
+	gr2.mustFrame(ebiten.KeyF12)
+	if got := shots(t, gr2.dir); len(got) != 1 || pngSize(t, got[0]) != image.Pt(1280, 800) {
+		t.Errorf("hdView 就緒：%v", got)
+	}
+}
