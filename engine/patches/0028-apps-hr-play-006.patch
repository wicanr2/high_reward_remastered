+		"Saves: /home/user/.config/high_reward/saves",
+		"Screenshots: /home/user/.config/high_reward/screenshots",
+		"Data folder: /home/user/.config/high_reward",
+	}
+	if len(got) != len(want) {
+		t.Fatalf("%d 行，應為 %d", len(got), len(want))
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("第 %d 行：%q，應為 %q", i, got[i], want[i])
+		}
+	}
+	// 列配置常數與內容對得上
+	if !strings.HasPrefix(got[rowKeys], "F1") || !strings.HasPrefix(got[rowKeys+rowKeysN-1], "Ctrl+Q") {
+		t.Errorf("按鍵表列配置不符：%q … %q", got[rowKeys], got[rowKeys+rowKeysN-1])
+	}
+	if !strings.HasPrefix(got[rowStatus], "Theme:") || !strings.HasPrefix(got[rowStats], "steps") || !strings.HasPrefix(got[rowStats+rowStatsN-1], "TPS") ||
+		!strings.HasPrefix(got[rowDiag], "Last diagnostics") || !strings.HasPrefix(got[rowTips], "Play with") {
+		t.Errorf("狀態、統計、診斷、提示的列配置不符")
+	}
+	for i := range got {
+		if isStatsRow(i) != (i >= 13 && i <= 15) {
+			t.Errorf("isStatsRow(%d) 不符", i)
+		}
+	}
+}
+
+func TestPanelLinesAllLanguages(t *testing.T) {
+	for _, l := range langOrder {
+		face := mustFace(t, l)
+		info := normalInfo()
+		lines := panelLines(l, face, info)
+		join := strings.Join(lines, "\n")
+		// 按鍵名與狀態欄位出現在對的列
+		for i, key := range []string{"F1", "F2", "F3", "F4", "F11", "F12", "Ctrl+D", "Ctrl+Q"} {
+			if !strings.Contains(lines[rowKeys+i], key) {
+				t.Errorf("%s：按鍵表第 %d 行應含 %q：%q", l, i, key, lines[rowKeys+i])
+			}
+		}
+		for _, want := range []string{langNames[l], themeName(l, themeHD), tr(l, "game.text.orig"), "123456789", "0F00", "59.9", info.Diag, info.SaveDir, info.ShotsDir} {
+			if want == "" || !strings.Contains(join, want) {
+				t.Errorf("%s：面板缺 %q", l, want)
+			}
+		}
+		// 聲音三態
+		for st, key := range map[soundState]string{soundOn: "on", soundOff: "off", soundNA: "sound.na"} {
+			i := info
+			i.Sound = st
+			if got := panelLines(l, face, i)[rowStatus+3]; !strings.Contains(got, tr(l, key)) {
+				t.Errorf("%s：聲音狀態 %v 應含 %q：%q", l, st, tr(l, key), got)
+			}
+		}
+		// 降頻
+		i := info
+		i.Stats.Lowered = true
+		if got := panelLines(l, face, i)[rowStats]; !strings.HasSuffix(got, tr(l, "yes")) {
+			t.Errorf("%s：降頻為真應以 %q 結尾：%q", l, tr(l, "yes"), got)
+		}
+		// 沒有診斷
+		i = info
+		i.Diag = ""
+		if got := panelLines(l, face, i)[rowDiag]; !strings.Contains(got, tr(l, "diag.none")) {
+			t.Errorf("%s：沒有診斷應顯示 %q：%q", l, tr(l, "diag.none"), got)
+		}
+	}
+	// 五種語言的 F1 面板彼此不同（F4 循環後畫面會變）
+	seen := map[string]lang{}
+	for _, l := range langOrder {
+		k := strings.Join(panelLines(l, mustFace(t, l), normalInfo()), "\n")
+		if o, dup := seen[k]; dup {
+			t.Errorf("%s 與 %s 的面板內容相同", l, o)
+		}
+		seen[k] = l
+	}
+}
+
+// 靜態與統計兩層的分界：統計三行以外的行不含統計數字；統計欄位變動只影響統計行。
+func TestPanelStatsRowsAreTheOnlyOnesThatChange(t *testing.T) {
+	face := mustFace(t, langEN)
+	a := panelLines(langEN, face, normalInfo())
+	i := normalInfo()
+	i.Stats = frozenStats
+	b := panelLines(langEN, face, i)
+	for r := range a {
+		same := a[r] == b[r]
+		if isStatsRow(r) == same {
+			t.Errorf("第 %d 行：統計列 ＝ %v，兩次輸出相同 ＝ %v", r, isStatsRow(r), same)
+		}
+	}
+}
+
+// 面板文字的組裝成本：只記錄；一般編譯下只設數量級的上限（50／500 毫秒，共用機器上不會因負載抖動誤判），-race 下慢十倍以上，不斷言。
+// 正式使用時經 panelCache 每秒至多組裝一次（TestPanelCacheOncePerSecond）。數字記在收據。
+func TestPanelLinesCost(t *testing.T) {
+	const n = 30
+	for _, l := range []lang{langTW, langEN} {
+		face := mustFace(t, l)
+		start := time.Now()
+		for i := 0; i < n; i++ {
+			panelLines(l, face, normalInfo())
+		}
+		per := time.Since(start) / n
+		long := extremeInfos()["拉丁長路徑"]
+		start = time.Now()
+		for i := 0; i < n; i++ {
+			panelLines(l, face, long)
+		}
+		perLong := time.Since(start) / n
+		t.Logf("%s：panelLines 每次 %v（正常輸入）、%v（三條約 1700 字元的路徑），race ＝ %v", l, per, perLong, raceEnabled)
+		if !raceEnabled && (per > 50*time.Millisecond || perLong > 500*time.Millisecond) {
+			t.Errorf("%s：組裝成本 %v／%v，超過 50／500 毫秒", l, per, perLong)
+		}
+	}
+}
+
+// panelCache：鍵沒變且不到 1 秒就沿用；鍵變了（語言、theme、聲音、診斷、路徑）立刻重組；滿 1 秒重組（統計更新）。
+func TestPanelCacheOncePerSecond(t *testing.T) {
+	t0 := time.Date(2026, 10, 4, 12, 0, 0, 0, time.UTC)
+	var c panelCache
+	computes := 0
+	compute := func() []string { computes++; return []string{"x"} }
+	for k := 0; k < 180; k++ { // 3 秒、60 Hz
+		c.get("k", t0.Add(time.Duration(k)*time.Second/60), compute)
+	}
+	if computes != 3 {
+		t.Errorf("3 秒內重組 %d 次，應為 3（0、1、2 秒）", computes)
+	}
+	c.get("other", t0.Add(3*time.Second+time.Millisecond), compute)
+	if computes != 4 {
+		t.Errorf("鍵變了應立刻重組：%d", computes)
+	}
+	c.get("other", t0.Add(3*time.Second+2*time.Millisecond), compute)
+	if computes != 4 {
+		t.Errorf("鍵沒變、不到 1 秒不該重組：%d", computes)
+	}
+}
+
+// staticKey 涵蓋所有靜態欄位（任何一個變了，面板的靜態行就可能不同），不含統計。
+func TestPanelStaticKeyCoversStaticFields(t *testing.T) {
+	base := normalInfo()
+	k0 := base.staticKey()
+	mut := map[string]func(*panelInfo){
+		"版本":    func(i *panelInfo) { i.Version += "x" },
+		"theme": func(i *panelInfo) { i.Theme = themeOriginal },
+		"可用清單":  func(i *panelInfo) { i.Usable = []themeID{themeOriginal} },
+		"聲音":    func(i *panelInfo) { i.Sound = soundOff },
+		"診斷":    func(i *panelInfo) { i.Diag = "other" },
+		"存檔目錄":  func(i *panelInfo) { i.SaveDir += "x" },
+		"截圖目錄":  func(i *panelInfo) { i.ShotsDir += "x" },
+		"資料目錄":  func(i *panelInfo) { i.DataDir += "x" },
+	}
+	for name, f := range mut {
+		i := base
+		f(&i)
+		if i.staticKey() == k0 {
+			t.Errorf("%s 變了，staticKey 沒變", name)
+		}
+	}
+	i := base
+	i.Stats = frozenStats
+	if i.staticKey() != k0 {
+		t.Error("統計變了不該影響 staticKey")
+	}
+	// 欄位邊界不混淆
+	a, b := base, base
+	a.SaveDir, a.ShotsDir = "ab", "c"
+	b.SaveDir, b.ShotsDir = "a", "bc"
+	if a.staticKey() == b.staticKey() {
+		t.Error("欄位邊界混淆")
+	}
+}
