+package main
+
+import (
+	"embed"
+	"fmt"
+
+	"golang.org/x/image/font"
+	"golang.org/x/image/font/opentype"
+)
+
+// 內嵌的介面字型（docs/spec/006 第 3、6 節）：fonts/ 內的五份 Noto Sans CJK 子集（tools/gen_ui_fonts.sh 產生，OFL）。
+// 整個目錄內嵌：授權檔 OFL.txt 與來源記錄 SOURCE.txt 隨執行檔一起走（OFL 第 2 條要求每份複本帶版權聲明與授權）。
+//
+//go:embed fonts
+var uiFontFS embed.FS
+
+// uiFontEm 是 F1 面板的字面 em（像素）。fonts_test.go 的 uiFontPx 與它同值；面板測試走這裡的正式載入路徑，
+// 不用測試自己建的字面，免得兩邊的參數日後分岔而量到不是畫出來的那個字面。
+const uiFontEm = 22
+
+// loadFontBytes 讀 l 語言的字型檔位元組。測試可以替換它來注入壞字型（docs/spec/006 第 10 節的字型載入函式變數）。
+var loadFontBytes = func(l lang) ([]byte, error) {
+	return uiFontFS.ReadFile("fonts/ui-" + string(l) + ".otf")
+}
+
+// newUIFace 由字型位元組建立介面字面：em 22 像素、72 DPI、不做 hinting（與子集的度量、墨跡測試相同的參數）。
+// 字面不是並行安全的（opentype.Face），只能在 UI 執行緒使用。
+func newUIFace(b []byte) (font.Face, error) {
+	f, err := opentype.Parse(b)
+	if err != nil {
+		return nil, err
+	}
+	face, err := opentype.NewFace(f, &opentype.FaceOptions{Size: uiFontEm, DPI: 72, Hinting: font.HintingNone})
+	if err != nil {
+		return nil, err
+	}
+	// 能解析但不能用的字型（例如被截斷、缺基本拉丁字母）也算失敗：退回 ASCII 比畫出方框好。
+	if _, ok := face.GlyphAdvance('A'); !ok {
+		return nil, fmt.Errorf("字型缺少基本拉丁字母")
+	}
+	return face, nil
