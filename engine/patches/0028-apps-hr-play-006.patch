+package main
+
+import (
+	"context"
+	"time"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	"github.com/hajimehoshi/ebiten/v2/inpututil"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// 測試縫隙（docs/spec/006 第 10 節）：命名的介面與函式變數，讓測試不依賴 ebiten 的全域輸入狀態、GPU 與原版。
+// 正式實作各自在注解裡指出；編譯期斷言放在檔尾，介面與實作脫鉤時第一時間在這裡失敗。
+
+// frameSource 是 hdView 對畫面來源的唯一依賴（*hrrt.Session 實作）。
+type frameSource interface{ Frame() *hrrt.Frame }
+
+// inputSink 接收前端送給遊戲的輸入事件（*hrrt.Session 實作）。
+type inputSink interface{ Input(ev hrrt.Event) }
+
+// pressDuration 取代 inpututil.KeyPressDuration：ebiten 的按鍵狀態是全域的，單元測試設不了。
+var pressDuration func(ebiten.Key) int = inpututil.KeyPressDuration
+
+// justPressed 取代 inpututil.IsKeyJustPressed（同理）。
+var justPressed func(ebiten.Key) bool = inpututil.IsKeyJustPressed
+
+// assetLoader 是切換狀態機對一個 HD theme 素材的操作（*hd.Assets 實作；測試用假實作記錄呼叫日誌、注入慢速載入）。
+type assetLoader interface {
+	Preload(ctx context.Context, progress func(done, total int)) (ok, failed int, err error)
+	Release()
+	ErrorStats() (n int, first string)
+}
+
+// clock 是時間來源。切換狀態機的 60 秒逾時、2 秒等待與 60 秒的 ErrorStats 檢查都以 Now() 差值判斷，
+// 沒有 time.AfterFunc，所以測試用假時鐘可以精確控制。
+type clock interface{ Now() time.Time }
+
+type realClock struct{}
+
+func (realClock) Now() time.Time { return time.Now() }
+
+// holder 是 HoldAdapt 的介面（*hrrt.Session 實作）。呼叫一次取得一次保護，回傳的 release 冪等。
+type holder interface{ HoldAdapt() (release func()) }
+
+// viewControl 是前端對 hdView 的介面。
+type viewControl interface {
+	SetAssets(a *hd.Assets) // nil ＝ 暫停；非 nil ＝ 恢復並使用該素材（單一臨界區內改素材、遞增世代、清 ready）
+	Ready() bool            // ready 是否非空（該世代已有發佈的畫面）
+	Pub() uint64            // 發佈計數
+}
+
+var (
+	_ frameSource = (*hrrt.Session)(nil)
+	_ inputSink   = (*hrrt.Session)(nil)
+	_ holder      = (*hrrt.Session)(nil)
+	_ assetLoader = (*hd.Assets)(nil)
+	_ viewControl = (*hdView)(nil)
+	_ clock       = realClock{}
+)
diff --git a/apps/hr/play/startup.go b/apps/hr/play/startup.go
