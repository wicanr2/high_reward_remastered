+// game.go 的單元測試：用假的 gameSession 與 gameEnv，不需要 GPU、視窗與原版（docs/spec/006 第 10 節）。
+
+// fakeSession 記錄 game 對 Session 的呼叫。
+type fakeSession struct {
+	mu         sync.Mutex
+	events     []hrrt.Event
+	frame      *hrrt.Frame
+	stats      hrrt.Stats
+	statsCalls int
+	diag       []string
+	frameReqs  int
+	crash      []string
+	crashErr   error
+}
+
+func (s *fakeSession) Frame() *hrrt.Frame { return s.frame }
+func (s *fakeSession) Input(ev hrrt.Event) {
+	s.mu.Lock()
+	s.events = append(s.events, ev)
+	s.mu.Unlock()
+}
+func (s *fakeSession) Stats() hrrt.Stats {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.statsCalls++
+	return s.stats
+}
+func (s *fakeSession) RequestFrame() { s.mu.Lock(); s.frameReqs++; s.mu.Unlock() }
+func (s *fakeSession) RequestDiag(reason string) {
+	s.mu.Lock()
+	s.diag = append(s.diag, reason)
+	s.mu.Unlock()
+}
+func (s *fakeSession) CrashDump(dir, reason string) error {
+	s.mu.Lock()
+	s.crash = append(s.crash, dir+"|"+reason)
+	s.mu.Unlock()
+	return s.crashErr
+}
+func (s *fakeSession) take() []hrrt.Event {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := s.events
+	s.events = nil
+	return out
+}
+
+// fakeEnv 是 gameEnv 與 seams.go 的 justPressed、pressDuration 的假實作。
+type fakeEnv struct {
+	clk       *fakeClock
+	cx, cy    int
+	ctrl, alt bool
+	runes     []rune
+	titles    []string
+	fs        []bool
+	just      map[ebiten.Key]bool // 這一幀剛按下
+	press     map[ebiten.Key]int  // 按住的幀數（特殊鍵的 pressDuration）
+}
+
+func (e *fakeEnv) env() gameEnv {
+	return gameEnv{
+		now:    e.clk.Now,
+		cursor: func() (int, int) { return e.cx, e.cy },
+		keyDown: func(k ebiten.Key) bool {
+			return (k == ebiten.KeyControl && e.ctrl) || (k == ebiten.KeyAlt && e.alt)
+		},
+		mouseJustDown: func(ebiten.MouseButton) bool { return false },
+		mouseJustUp:   func(ebiten.MouseButton) bool { return false },
+		chars:         func() []rune { return e.runes },
+		setTitle:      func(s string) { e.titles = append(e.titles, s) },
+		setFullscreen: func(b bool) { e.fs = append(e.fs, b) },
+	}
+}
+
+func (e *fakeEnv) install(t *testing.T) {
+	oldJ, oldP := justPressed, pressDuration
+	justPressed = func(k ebiten.Key) bool { return e.just[k] }
+	pressDuration = func(k ebiten.Key) int { return e.press[k] }
+	t.Cleanup(func() { justPressed, pressDuration = oldJ, oldP })
+}
+
+type gameRig struct {
+	*rig
+	g       *game
+	ss      *fakeSession
+	fe      *fakeEnv
+	glog    lineLog
+	gcommit []prefsPatch
+	dir     string
+	stopCh  chan *hrrt.Stop
+}
+
+type rigOpt func(*gameRig, *gameConfig)
+
+func withSound() rigOpt {
+	return func(gr *gameRig, c *gameConfig) { c.Snd = sound.NewEngine() }
+}
+
+func withHV(hv *hdView) rigOpt { return func(gr *gameRig, c *gameConfig) { c.HV = hv } }
+
+func withPNGHD(f func(string) error) rigOpt {
+	return func(gr *gameRig, c *gameConfig) { c.PNGHD = f }
+}
+
+func withFreeze() rigOpt { return func(gr *gameRig, c *gameConfig) { c.Freeze = true } }
+
+func newGameRig(t *testing.T, start themeID, themes []themeID, opts ...rigOpt) *gameRig {
+	t.Helper()
+	r := newRig(t, start, themes...)
+	gr := &gameRig{rig: r, ss: &fakeSession{frame: newFakeFrame(vramW, vramH, 1)}, dir: t.TempDir(), stopCh: make(chan *hrrt.Stop, 1)}
+	gr.fe = &fakeEnv{clk: r.clk, just: map[ebiten.Key]bool{}, press: map[ebiten.Key]int{}}
+	gr.fe.install(t)
+	env := gr.fe.env()
+	cfg := gameConfig{
+		Session: gr.ss, Stop: gr.stopCh, SW: r.sw, Lang: langTW, DataDir: gr.dir, SaveDir: filepath.Join(gr.dir, "saves"),
+		Logf: gr.glog.logf, Env: &env, Fonts: newFontSet(gr.glog.logf),
+		Commit: func(p prefsPatch) { gr.gcommit = append(gr.gcommit, p) },
+	}
+	for _, o := range opts {
+		o(gr, &cfg)
+	}
+	gr.g = newGame(cfg)
+	return gr
+}
+
+// frame 模擬一次 Update：keys 是這一幀剛按下的鍵。
+func (gr *gameRig) frame(keys ...ebiten.Key) error {
+	gr.fe.just = map[ebiten.Key]bool{}
+	for _, k := range keys {
+		gr.fe.just[k] = true
+	}
+	err := gr.g.Update()
+	gr.fe.just = map[ebiten.Key]bool{}
+	return err
+}
+
+func (gr *gameRig) mustFrame(keys ...ebiten.Key) {
+	gr.t.Helper()
+	if err := gr.frame(keys...); err != nil {
+		gr.t.Fatalf("Update：%v", err)
+	}
+}
+
+// prime 先跑一幀並丟掉第一次的滑鼠移動事件（g.mx 起始為 -1，第一幀一定會送一次移動），之後游標不動就不再有事件。
+func (gr *gameRig) prime() {
+	gr.t.Helper()
+	gr.fe.cx, gr.fe.cy = 700, 500
+	gr.mustFrame()
+	gr.ss.take()
+}
+
+func (gr *gameRig) commitList() []string {
+	var out []string
+	for _, c := range gr.gcommit {
+		out = append(out, c.String())
+	}
+	return out
+}
