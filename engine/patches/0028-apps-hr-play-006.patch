+// 有畫面後 upload 與 writePNG 恢復。writePNG 假設 640x480 幾何，這裡用滿尺寸的假畫面。
+// 用 B 的阻塞鉤子讓「SetAssets(B) 之後、B 發佈之前」的視窗固定下來。
+func TestHDViewReadyEmptySemantics(t *testing.T) {
+	f := newHVFix(t, hvMode{}, 640, 480, false, true)
+	if !waitUntil(hvWait, func() bool { return f.v.Ready() }) {
+		t.Fatal("A 沒有發佈")
+	}
+	dir := t.TempDir()
+	// ready 非空：upload 與 writePNG 正常
+	calls, size := 0, 0
+	pub, ok := f.v.upload(0, func(b []byte) { calls++; size = len(b) })
+	if !ok || pub != 1 || calls != 1 || size != 640*2*480*2*4 {
+		t.Fatalf("ready 非空時 upload ＝ (%d, %v)，fn 呼叫 %d 次，緩衝區 %d bytes", pub, ok, calls, size)
+	}
+	if _, ok := f.v.upload(1, func([]byte) { calls++ }); ok || calls != 1 {
+		t.Fatalf("同一個發佈計數不該再上傳")
+	}
+	p1 := filepath.Join(dir, "a.png")
+	if err := f.v.writePNG(p1); err != nil {
+		t.Fatalf("ready 非空時 writePNG：%v", err)
+	}
+	if fh, err := os.Open(p1); err != nil {
+		t.Fatal(err)
+	} else {
+		cfg, _, derr := image.DecodeConfig(fh)
+		fh.Close()
+		if derr != nil || cfg.Width != 1280 || cfg.Height != 800 {
+			t.Fatalf("PNG 應為 1280x800：%+v（%v）", cfg, derr)
+		}
+	}
+	// 切到 B 並卡住：ready 清空，B 還沒發佈
+	f.v.SetAssets(f.B)
+	if !recvWithin(f.hB.in, hvWait) {
+		t.Fatal("B 的合成沒有開始")
+	}
+	if f.v.Ready() {
+		t.Fatal("SetAssets 之後、B 發佈之前 ready 應為空")
+	}
+	calls = 0
+	for _, last := range []uint64{0, 1, 5} { // 不論 pub 與 lastPub 是否相同
+		if _, ok := f.v.upload(last, func([]byte) { calls++ }); ok || calls != 0 {
+			t.Errorf("ready 為空時 upload(%d) 應回 false 且不呼叫 fn", last)
+		}
+	}
+	p2 := filepath.Join(dir, "b.png")
+	if err := f.v.writePNG(p2); !errors.Is(err, errNoFrame) {
+		t.Fatalf("ready 為空時 writePNG ＝ %v，應為 errNoFrame", err)
+	}
+	if _, err := os.Stat(p2); err == nil {
+		t.Error("ready 為空時 writePNG 不該建檔（不複製）")
+	}
+	// B 發佈後恢復
+	f.hB.open()
+	if !waitUntil(hvWait, func() bool { return f.v.stats().Pub == 2 }) {
+		t.Fatal("B 沒有發佈")
+	}
+	if pub, ok := f.v.upload(1, func([]byte) { calls++ }); !ok || pub != 2 || calls != 1 {
+		t.Fatalf("B 發佈後 upload(1) ＝ (%d, %v)", pub, ok)
+	}
+	if err := f.v.writePNG(p2); err != nil {
+		t.Fatalf("B 發佈後 writePNG：%v", err)
+	}
+}
+
+// 子項 (5)：HD 到 HD 在停機（來源不再有新 Seq）時，upload 在 ready 為空期間回 false，新畫面發佈後把它放進顯示緩衝區
+// （以發佈計數比對，不用遊戲 Seq）。模擬遊戲的 Draw 迴圈：每幀呼叫 upload，只在回 true 時更新 lastPub 與顯示。
+func TestHDViewHDToHDWhileStopped(t *testing.T) {
+	f := newHVFix(t, hvMode{}, 64, 48, false, true)
+	var lastPub uint64
+	uploads := 0
+	draw := func() {
+		if pub, ok := f.v.upload(lastPub, func([]byte) { uploads++ }); ok {
+			lastPub = pub
+		}
+	}
+	if !waitUntil(hvWait, func() bool { return f.v.Ready() }) {
+		t.Fatal("A 沒有發佈")
+	}
+	draw()
+	if uploads != 1 || lastPub != 1 {
+		t.Fatalf("A 的畫面應上傳一次：uploads ＝ %d、lastPub ＝ %d", uploads, lastPub)
+	}
+	f.v.SetAssets(f.B) // 停機：Seq 不會再增加
+	if !recvWithin(f.hB.in, hvWait) {
+		t.Fatal("B 的合成沒有開始（last 沒有重設？）")
+	}
+	for i := 0; i < 5; i++ {
+		draw()
+	}
+	if uploads != 1 {
+		t.Fatalf("B 發佈前 ready 為空，不該上傳（避免閃出清空的緩衝區）：uploads ＝ %d", uploads)
+	}
+	f.hB.open()
+	if !waitUntil(hvWait, func() bool { return f.v.stats().Pub == 2 }) {
+		t.Fatal("B 沒有發佈")
+	}
+	draw()
+	if uploads != 2 || lastPub != 2 {
+		t.Fatalf("B 的新畫面應放進顯示緩衝區：uploads ＝ %d、lastPub ＝ %d", uploads, lastPub)
+	}
+	draw()
+	if uploads != 2 {
+		t.Fatalf("同一張畫面不該重複上傳：uploads ＝ %d", uploads)
+	}
+}
+
+// 暫停：assets 為 nil 時 run 不合成；以 nil 建立的 hdView 一開始就是暫停，SetAssets(非 nil) 恢復。
+// 屏障：等 run 的鏡像 seen ＝ epoch（它已經跑過一輪暫停狀態）才斷言沒有合成，且 A 的 Get 鉤子沒有觸發。
+func TestHDViewStartsPausedWithNil(t *testing.T) {
+	src := &fakeSource{}
+	src.set(newFakeFrame(64, 48, 1))
+	A := emptyAssets(t)
+	h := newBlockHook()
+	h.install(A)
+	v := newHDView(src, nil, 2)
+	t.Cleanup(v.close)
+	t.Cleanup(h.open)
+	if !waitUntil(hvWait, func() bool { s := v.stats(); return s.Seen == s.Epoch && s.Epoch == 1 }) {
+		t.Fatal("run 沒有跑過暫停的一輪")
+	}
+	time.Sleep(20 * time.Millisecond) // 之後再多跑幾輪
+	if s := v.stats(); s.Pub != 0 || s.Ready || s.Discards != 0 {
+		t.Fatalf("暫停中不該合成：%+v", s)
+	}
+	select {
+	case <-h.in:
+		t.Fatal("暫停中不該呼叫 Get（鉤子被觸發）")
+	default:
+	}
+	v.SetAssets(A)
+	if !recvWithin(h.in, hvWait) {
+		t.Fatal("恢復後應開始合成")
+	}
+	h.open()
+	if !waitUntil(hvWait, func() bool { return v.stats().Pub == 1 }) {
+		t.Fatal("恢復後沒有發佈")
+	}
+}
+
+// 壓力（-race）：不斷在 A、B、nil 之間切換，同時取樣不變式：ready 非空時，發佈所用的素材必然就是目前的素材
+// （發佈要求世代未變，SetAssets 又同時清 ready，所以不會出現「ready 是舊素材的畫面」）。
+func TestHDViewStressInvariant(t *testing.T) {
+	f := newHVFix(t, hvMode{}, 64, 48, false, false)
+	targets := []*hd.Assets{f.A, f.B, nil, f.B, f.A, nil}
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; ; i++ {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			f.v.SetAssets(targets[i%len(targets)])
+			time.Sleep(300 * time.Microsecond)
+		}
+	}()
+	bad, samples, readySeen := 0, 0, 0
+	deadline := time.Now().Add(1500 * time.Millisecond)
+	for time.Now().Before(deadline) {
+		f.v.mu.Lock()
+		ready, from, cur := f.v.readyIdx >= 0, f.v.pubFrom, f.v.assets
+		f.v.mu.Unlock()
+		samples++
+		if ready {
+			readySeen++
+			if from != cur {
+				bad++
+			}
+		}
+		time.Sleep(100 * time.Microsecond)
+	}
+	close(stop)
+	wg.Wait()
+	if bad != 0 {
+		t.Errorf("不變式被違反 %d 次（取樣 %d 次，ready 非空 %d 次）", bad, samples, readySeen)
+	}
+	t.Logf("取樣 %d 次，ready 非空 %d 次", samples, readySeen)
+}
+
+func TestHDViewCloseIdempotent(t *testing.T) {
+	src := &fakeSource{}
+	v := newHDView(src, nil, 2)
+	v.close()
+	v.close() // 重複呼叫不 panic、不卡住
+}
