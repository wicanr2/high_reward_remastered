+
+// fakeSource 是假的 frameSource：同一張畫面（Seq 從 1 起，不提供新 Seq ＝ 靜態畫面）。
+type fakeSource struct {
+	mu sync.Mutex
+	f  *hrrt.Frame
+}
+
+func (s *fakeSource) Frame() *hrrt.Frame {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.f
+}
+
+func (s *fakeSource) set(f *hrrt.Frame) {
+	s.mu.Lock()
+	s.f = f
+	s.mu.Unlock()
+}
+
+// newFakeFrame 回傳 w x h 的假畫面：像素全是 1、一個通過驗證的 4x4 戳記在 (0,0)（期望像素全是 1，雜湊不在任何清冊）。
+func newFakeFrame(w, h int, seq uint64) *hrrt.Frame {
+	px := make([]uint8, w*h)
+	for i := range px {
+		px[i] = 1
+	}
+	e := make([]byte, 16)
+	for i := range e {
+		e[i] = 1
+	}
+	var mp [16]uint8
+	for i := range mp {
+		mp[i] = uint8(i)
+	}
+	return &hrrt.Frame{W: w, H: h, Px: px, Map: mp, Seq: seq,
+		Stamps: []*hd.Stamp{{Kind: hd.KindSprite, X: 0, Y: 0, W: 4, H: 4, Hash: strings.Repeat("a", 64), E: e, Seq: 1}}}
+}
+
+// emptyAssets 回傳只有表頭的清冊與調色盤載入的 *Assets（每次呼叫回傳不同的指標）。
+func emptyAssets(t testing.TB) *hd.Assets {
+	t.Helper()
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "catalog.tsv"), []byte("hash\tid\tw\th\tkind\tpal\thd\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "palettes.tsv"), []byte("name\tpalette16\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	a, err := hd.LoadAssets(dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return a
+}
+
+// blockHook 是 SetGetHook 的一次性阻塞鉤子：Get 進入時送出 in 訊號並阻塞到 open()。
+type blockHook struct {
+	in      chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func newBlockHook() *blockHook {
+	return &blockHook{in: make(chan struct{}, 1), release: make(chan struct{})}
+}
+
+func (h *blockHook) install(a *hd.Assets) {
+	a.SetGetHook(func(string) {
+		h.in <- struct{}{}
+		<-h.release
+	})
+}
+
+func (h *blockHook) open() { h.once.Do(func() { close(h.release) }) }
+
+func recvWithin(ch <-chan struct{}, d time.Duration) bool {
+	select {
+	case <-ch:
+		return true
+	case <-time.After(d):
+		return false
+	}
+}
+
+// stageErr 標出 scenario 在哪一步失敗；負對照靠它確認「因為突變而失敗」，不是別的原因。
+type stageErr struct{ stage, msg string }
+
+func (e *stageErr) Error() string { return e.stage + "：" + e.msg }
+
+func errAt(stage, format string, a ...any) error {
+	return &stageErr{stage: stage, msg: fmt.Sprintf(format, a...)}
+}
+
+func stageOf(err error) string {
+	var se *stageErr
+	if errors.As(err, &se) {
+		return se.stage
+	}
+	return ""
+}
+
+// hvMode 是 scenario 的模式：skip ＝ hdView 以 withSkipEpochCheck 建立（負對照）。
+type hvMode struct{ skip bool }
+
+// failWait 是「預期在突變下等不到」的等待時間：正常模式給足（含 -race 的慢速），突變模式縮短以節省時間。
+func (m hvMode) failWait() time.Duration {
+	if m.skip {
+		return 700 * time.Millisecond
+	}
+	return 10 * time.Second
+}
+
+const hvWait = 10 * time.Second
+
+type hvFix struct {
+	src    *fakeSource
+	v      *hdView
+	A, B   *hd.Assets
+	hA, hB *blockHook
