+func TestPrefsWriteAtomicLeavesNoTemp(t *testing.T) {
+	dir := t.TempDir()
+	path := prefsPath(dir)
+	for i := 0; i < 20; i++ {
+		if err := writePrefs(path, themePatch(themeHD), nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	ents, _ := os.ReadDir(dir)
+	if len(ents) != 1 || ents[0].Name() != "prefs.json" {
+		var names []string
+		for _, e := range ents {
+			names = append(names, e.Name())
+		}
+		t.Fatalf("目錄裡應只有 prefs.json，實際 %v", names)
+	}
+	// 目標目錄不存在時自動建立
+	deep := filepath.Join(dir, "a", "b", "prefs.json")
+	if err := writePrefs(deep, langPatch(langJA), nil); err != nil || loadPrefs(deep).Lang != "ja" {
+		t.Fatalf("巢狀目錄寫入失敗：%v", err)
+	}
+	// 寫不進去（目標是非空目錄）：回錯誤，不留暫存檔
+	bad := filepath.Join(dir, "isdir")
+	os.Mkdir(bad, 0o755)
+	os.WriteFile(filepath.Join(bad, "x"), []byte("x"), 0o644)
+	if err := writePrefs(bad, soundPatch(true), nil); err == nil {
+		t.Fatal("目標是非空目錄時應回錯誤")
+	}
+	ents, _ = os.ReadDir(dir)
+	for _, e := range ents {
+		if strings.HasSuffix(e.Name(), ".tmp") {
+			t.Fatalf("留下暫存檔 %s", e.Name())
+		}
+	}
+}
+
+// 損壞的各種形式：原檔改名為 .bad（內容就是原本的位元組），用預設寫新檔，記一行。
+func TestPrefsCorruptRenamedToBad(t *testing.T) {
+	for _, in := range corruptPrefs {
+		dir := t.TempDir()
+		path := prefsPath(dir)
+		os.WriteFile(path, []byte(in), 0o644)
+		var lg lineLog
+		if err := writePrefs(path, themePatch(themeHD), lg.logf); err != nil {
+			t.Fatalf("%q：%v", in, err)
+		}
+		if got := readStr(t, path+".bad"); got != in {
+			t.Errorf("%q：.bad 的內容是 %q", in, got)
+		}
+		if p, st := parsePrefs([]byte(readStr(t, path))); st != prefsOK || p.Theme != "hd" || p.Lang != "" || p.Sound != nil {
+			t.Errorf("%q：新檔 %+v（狀態 %d）", in, p, st)
+		}
+		if !lg.has(".bad") {
+			t.Errorf("%q：沒有記一行改名的日誌：%v", in, lg.all())
+		}
+	}
+	// 控制組：合法檔案不改名（偵測器不是恆真）
+	dir := t.TempDir()
+	path := prefsPath(dir)
+	os.WriteFile(path, []byte(`{"version":1,"lang":"ko"}`), 0o644)
+	if err := writePrefs(path, themePatch(themeHD), nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path + ".bad"); err == nil {
+		t.Error("合法檔案不該產生 .bad")
+	}
+	// 舊的 .bad 被覆蓋
+	dir = t.TempDir()
+	path = prefsPath(dir)
+	os.WriteFile(path+".bad", []byte("older"), 0o644)
+	os.WriteFile(path, []byte("{"), 0o644)
+	if err := writePrefs(path, themePatch(themeHD), nil); err != nil {
+		t.Fatal(err)
+	}
+	if got := readStr(t, path+".bad"); got != "{" {
+		t.Errorf("舊的 .bad 應被覆蓋，內容 %q", got)
+	}
+}
+
+// 兩個執行個體：損壞的判斷用「每次寫入時剛讀到的位元組」，不是啟動時留下的旗標。
+// 晚到的寫入者不該把對方剛寫好的有效檔改名成 .bad，也不該蓋掉對方的欄位。
+func TestPrefsCorruptJudgedOnEveryWrite(t *testing.T) {
+	dir := t.TempDir()
+	path := prefsPath(dir)
+	os.WriteFile(path, []byte(`[1,2]`), 0o644)
+	var lg lineLog
+	w := newPrefsWriter(path, lg.logf)
+	w.Submit(themePatch(themeHD))
+	if !waitUntil(5*time.Second, func() bool {
+		b, err := os.ReadFile(path)
+		p, st := parsePrefs(b)
+		return err == nil && st == prefsOK && p.Theme == "hd"
+	}) {
+		t.Fatal("第一次寫入沒有完成")
+	}
+	if got := readStr(t, path+".bad"); got != `[1,2]` {
+		t.Fatalf("第一次寫入應把損壞檔改名：.bad ＝ %q", got)
+	}
+	// 另一個執行個體寫了有效檔
+	os.WriteFile(path, []byte(`{"version":1,"lang":"ko","other":7}`), 0o644)
+	w.Submit(soundPatch(false))
+	if !waitUntil(5*time.Second, func() bool {
+		p, _ := parsePrefs([]byte(readStr(t, path)))
+		return p.Sound != nil && !*p.Sound
+	}) {
+		t.Fatal("第二次寫入沒有完成")
+	}
+	w.Close()
+	if got := readStr(t, path+".bad"); got != `[1,2]` {
+		t.Errorf("對方剛寫的有效檔被改名成 .bad 了（.bad ＝ %q）", got)
+	}
+	m, _ := classifyPrefs([]byte(readStr(t, path)))
+	if string(m["lang"]) != `"ko"` || string(m["other"]) != "7" || string(m["sound"]) != "false" {
+		t.Errorf("對方的欄位應保留、本次的欄位應寫入：%s", readStr(t, path))
+	}
+}
+
+// version 不是 1：原樣保留 version 與未知欄位，只改被切換的欄位；不改名。
+func TestPrefsOtherVersionPreserved(t *testing.T) {
+	dir := t.TempDir()
+	path := prefsPath(dir)
+	os.WriteFile(path, []byte(`{"version":2,"theme":"ai","lang":"ja","future":{"x":[1,2]}}`), 0o644)
+	if err := writePrefs(path, soundPatch(false), nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path + ".bad"); err == nil {
+		t.Error("version 非 1 不是損壞，不該改名")
+	}
+	m, st := classifyPrefs([]byte(readStr(t, path)))
+	if st != prefsOtherVersion || string(m["version"]) != "2" || string(m["future"]) != `{"x":[1,2]}` || string(m["theme"]) != `"ai"` || string(m["lang"]) != `"ja"` || string(m["sound"]) != "false" {
+		t.Errorf("寫回的內容 %s", readStr(t, path))
+	}
+}
+
+// 只寫被切換的欄位；值已知但目前不可用（例如 "ai" 而沒有 hd-ai/）不被覆寫。
+func TestPrefsOnlyToggledFieldsWritten(t *testing.T) {
+	dir := t.TempDir()
+	path := prefsPath(dir)
+	w := newPrefsWriter(path, nil)
+	w.Submit(themePatch(themeHD))
+	w.Close()
+	if got := readStr(t, path); got != "{\"version\":1,\"theme\":\"hd\"}\n" {
+		t.Errorf("只切換 theme 時檔案是 %q", got)
+	}
+	os.WriteFile(path, []byte(`{"version":1,"theme":"ai","lang":"ko"}`), 0o644)
+	w = newPrefsWriter(path, nil)
+	w.Submit(soundPatch(true))
+	w.Close()
+	m, _ := classifyPrefs([]byte(readStr(t, path)))
+	if string(m["theme"]) != `"ai"` || string(m["lang"]) != `"ko"` || string(m["sound"]) != "true" {
+		t.Errorf("沒被切換的欄位應保留：%s", readStr(t, path))
+	}
+}
+
+// 寫入者建立時不寫任何東西；旗標與環境變數啟動的值不進補丁，只有被切換的欄位會持久化。
+func TestPrefsFlagValuesNotPersisted(t *testing.T) {
+	dir := t.TempDir()
+	path := prefsPath(dir)
+	w := newPrefsWriter(path, nil)
+	w.Close()
+	if ents, _ := os.ReadDir(dir); len(ents) != 0 {
+		t.Fatalf("沒有 Submit 時不該寫任何東西：%v", ents)
+	}
+	// 以旗標與環境變數啟動：-theme original、-lang en、-mute、HR_MUTE
+	p := loadPrefs(path)
+	plan := resolveStartup(startupFlags{Theme: "original", ThemeGiven: true, Lang: "en", LangGiven: true, Mute: true, MuteGiven: true},
+		startupEnv{Mute: "1"}, p, []themeID{themeOriginal, themeHD})
+	if plan.Theme != themeOriginal || plan.Lang != langEN || !plan.Muted {
+		t.Fatalf("啟動計畫 %+v", plan)
+	}
+	// 使用者只按了 F4（切到 ko）：只有 lang 被寫入
+	w = newPrefsWriter(path, nil)
+	w.Submit(langPatch(langKO))
+	w.Close()
+	if got := readStr(t, path); got != "{\"version\":1,\"lang\":\"ko\"}\n" {
+		t.Errorf("旗標的值不該被持久化，檔案是 %q", got)
+	}
+}
+
+// F2 後立刻 F4：兩個欄位都寫入（合併待套用的補丁）；同欄位後者覆蓋。用卡住的第一次寫入讓補丁累積，確定性。
+func TestPrefsWriterMergesPendingPatches(t *testing.T) {
+	var mu sync.Mutex
+	var got []prefsPatch
+	gate := make(chan struct{})
+	var once sync.Once
+	open := func() { once.Do(func() { close(gate) }) }
+	t.Cleanup(open)
+	started := make(chan struct{}, 1)
+	save := func(path string, p prefsPatch, logf func(string, ...any)) error {
+		mu.Lock()
+		got = append(got, p)
+		n := len(got)
+		mu.Unlock()
+		if n == 1 {
+			started <- struct{}{}
+			<-gate
+		}
+		return nil
+	}
+	w := newWriterWith(t, prefsPath(t.TempDir()), nil, save)
+	w.Submit(themePatch(themeHD))
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("第一次寫入沒有開始")
+	}
+	w.Submit(langPatch(langKO))
+	w.Submit(themePatch(themeAI))
+	w.Submit(soundPatch(false))
+	w.Submit(soundPatch(true))
+	open()
+	w.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	if len(got) != 2 {
+		t.Fatalf("應寫入 2 次（第一次，加上合併後的一次），實際 %d 次：%v", len(got), got)
+	}
+	if got[0].String() != "{theme=hd}" {
+		t.Errorf("第一次的補丁是 %s", got[0])
+	}
+	if got[1].String() != "{theme=ai lang=ko sound=true}" {
+		t.Errorf("合併後的補丁是 %s，應為 {theme=ai lang=ko sound=true}", got[1])
+	}
+}
+
+func TestPrefsWriterF2ThenF4BothPersisted(t *testing.T) {
+	path := prefsPath(t.TempDir())
+	w := newPrefsWriter(path, nil)
+	w.Submit(themePatch(themeAI))
+	w.Submit(langPatch(langJA))
+	w.Close()
+	p := loadPrefs(path)
+	if p.Theme != "ai" || p.Lang != "ja" {
+		t.Fatalf("F2 後立刻 F4，兩個欄位都應寫入：%+v", p)
+	}
+}
+
+// Close 最多等 1 秒：寫入卡住時逾時返回，記一行。
+func TestPrefsCloseTimesOut(t *testing.T) {
+	if prefsCloseTimeout != time.Second {
+		t.Fatalf("Close 的逾時預設應為 1 秒，實際 %v", prefsCloseTimeout)
+	}
+	gate := make(chan struct{})
+	var once sync.Once
+	open := func() { once.Do(func() { close(gate) }) }
+	t.Cleanup(open)
+	inSave := make(chan struct{}, 1)
+	save := func(path string, p prefsPatch, logf func(string, ...any)) error {
+		inSave <- struct{}{}
+		<-gate
+		return nil
+	}
+	var lg lineLog
+	w := newWriterWith(t, prefsPath(t.TempDir()), lg.logf, save)
+	w.Submit(themePatch(themeHD))
+	select {
+	case <-inSave:
+	case <-time.After(5 * time.Second):
+		t.Fatal("寫入沒有開始")
+	}
+	start := time.Now()
+	done := make(chan struct{})
+	go func() { w.Close(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		open()
+		t.Fatal("Close 在寫入卡住時沒有於逾時內返回")
+	}
+	if el := time.Since(start); el < 900*time.Millisecond || el > 3*time.Second {
+		t.Errorf("Close 花了 %v，應約 1 秒", el)
+	}
+	if !lg.has("放棄") {
+		t.Errorf("逾時應記一行：%v", lg.all())
+	}
+	open()
+	<-w.done // 放行後背景 goroutine 結束，不外洩
+}
+
+func TestPrefsCloseFlushesAndIsIdempotent(t *testing.T) {
+	path := prefsPath(t.TempDir())
+	w := newPrefsWriter(path, nil)
+	for _, th := range []themeID{themeOriginal, themeHD, themeAI, themeOriginal, themeHD} {
+		w.Submit(themePatch(th))
+	}
+	w.Close()
+	if got := loadPrefs(path); got.Theme != "hd" {
+		t.Fatalf("最後一份應是 hd：%+v", got)
+	}
+	w.Submit(themePatch(themeAI)) // Close 之後的提交被忽略，不 panic
+	w.Close()                     // 重複 Close 無害
+	if got := loadPrefs(path); got.Theme != "hd" {
+		t.Fatalf("Close 之後的提交不該寫入：%+v", got)
+	}
+	w.Submit(prefsPatch{}) // 空補丁不觸發寫入，不 panic
+}
+
+// 寫入失敗只記一行，行程內狀態不受影響，之後的提交仍會嘗試。
+func TestPrefsWriteFailureIsLoggedOnly(t *testing.T) {
+	var mu sync.Mutex
+	calls := 0
+	save := func(path string, p prefsPatch, logf func(string, ...any)) error {
+		mu.Lock()
+		calls++
+		mu.Unlock()
+		return fmt.Errorf("磁碟已滿")
+	}
+	var lg lineLog
+	w := newWriterWith(t, prefsPath(t.TempDir()), lg.logf, save)
+	w.Submit(themePatch(themeHD))
+	if !waitUntil(5*time.Second, func() bool { return lg.has("磁碟已滿") }) {
+		t.Fatal("寫入失敗沒有記錄")
+	}
+	w.Submit(langPatch(langEN))
+	w.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	if calls != 2 {
+		t.Errorf("失敗之後的提交仍應嘗試寫入，寫入次數 %d", calls)
+	}
+}
+
+// 啟動清理崩潰殘留的 .prefs-*.tmp（盡力而為）：老的刪，新的（可能是另一個執行個體正在寫的）與其他檔案不動。
+func TestPrefsStartupCleansStaleTemp(t *testing.T) {
+	dir := t.TempDir()
+	old := filepath.Join(dir, ".prefs-crashed.tmp")
+	fresh := filepath.Join(dir, ".prefs-inflight.tmp")
+	other := filepath.Join(dir, ".prefs-note.txt")
+	keep := prefsPath(dir)
+	for _, p := range []string{old, fresh, other, keep} {
+		os.WriteFile(p, []byte("x"), 0o644)
+	}
+	past := time.Now().Add(-2 * time.Hour)
+	if err := os.Chtimes(old, past, past); err != nil {
+		t.Fatal(err)
+	}
+	w := newPrefsWriter(keep, nil)
+	w.Close()
+	if _, err := os.Stat(old); err == nil {
+		t.Error("崩潰殘留的暫存檔應被清掉")
+	}
+	for _, p := range []string{fresh, other, keep} {
+		if _, err := os.Stat(p); err != nil {
+			t.Errorf("%s 不該被刪：%v", filepath.Base(p), err)
+		}
+	}
+}
