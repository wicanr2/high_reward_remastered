+// onResult 第 2 條：err ＝ nil 且 ok ＝ 0，標為不可用；日誌含首筆原因（證明 ErrorStats 在 Release 之前讀取）；
+// 呼叫日誌順序 Preload、ErrorStats、Release；nextTheme 略過；不提交補丁；放開 HoldAdapt。
+func TestSwitcherRejectedZeroSuccess(t *testing.T) {
+	r := newRig(t, themeOriginal, themeHD)
+	l := r.loaders[themeHD]
+	l.ok, l.failed = 0, 3
+	l.setErrors(3, "x/bad.png：尺寸不符")
+	r.press()
+	r.settle(stIdle)
+	if !r.sw.rejected[themeHD] || !reflect.DeepEqual(r.sw.Usable(), []themeID{themeOriginal}) {
+		t.Errorf("應標為不可用：rejected ＝ %v、Usable ＝ %v", r.sw.rejected, r.sw.Usable())
+	}
+	r.wantCalls(themeHD, "Preload", "ErrorStats", "Release")
+	if r.log.idx("bad.png") < 0 || r.log.idx("首筆原因") < 0 {
+		t.Errorf("日誌應含首筆原因（ErrorStats 在 Release 之前讀取）：%v", r.log.all())
+	}
+	if r.log.idx("view.SetAssets") >= 0 || len(r.commits) != 0 || r.sw.Display() != srcOriginal || r.sw.Current() != themeOriginal {
+		t.Errorf("被拒不改變狀態：%v", r.log.all())
+	}
+	r.wantOrder("成功數為 0", "unhold")
+	r.wantHold(1, 1)
+	if got := r.toast(langTW); got != tr(langTW, "toast.theme.failed", "HD") {
+		t.Errorf("toast ＝ %q", got)
+	}
+	// nextTheme 略過它：沒有其他 theme，F2 不動作
+	r.clk.advance(3 * time.Second)
+	r.press()
+	if r.sw.State() != stIdle || r.toast(langTW) != tr(langTW, "toast.theme.none") {
+		t.Errorf("被拒之後 F2 應提示沒有其他 theme：%q", r.toast(langTW))
+	}
+	r.wantHold(1, 1)
+	r.wantCalls(themeHD, "Preload", "ErrorStats", "Release") // 沒有再預載
+}
