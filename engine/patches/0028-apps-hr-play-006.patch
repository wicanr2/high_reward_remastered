+++ b/apps/hr/play/startup.go
@@ -0,0 +1,275 @@
+package main
+
+import (
+	"fmt"
+	"slices"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+)
+
+// theme 的代號、循環順序、載入與啟動時的取捨（docs/spec/006 第 4、5、7 節）。純函式為主，
+// 唯一做檔案 I/O 的是 loadThemes（只讀 TSV 與 PNG 檔頭）。
+
+type themeID string
+
+const (
+	themeOriginal themeID = "original"
+	themeHD       themeID = "hd"
+	themeAI       themeID = "ai"
+)
+
+// themeCycle 是 F2 的循環順序：original → hd → ai → original。
+var themeCycle = []themeID{themeOriginal, themeHD, themeAI}
+
+// hdThemes 是需要素材目錄的 HD theme，依載入順序（hd/ 優先）。
+var hdThemes = []themeID{themeHD, themeAI}
+
+func parseTheme(s string) (themeID, bool) {
+	for _, t := range themeCycle {
+		if string(t) == s {
+			return t, true
+		}
+	}
+	return "", false
+}
+
+// pickThemes 決定基底 theme 與衍生 theme（docs/spec/006 第 4 節「載入的順序與基底 theme」）。
+// loaded 是各 HD theme 的 hd.LoadAssets 是否成功（沒找到目錄的 theme 不在表內或為 false）。
+// 基底 ＝ 依 hd、ai 的順序第一個載入成功的 HD theme；其後載入成功的是衍生 theme，要過 hd.CheckTheme。
+// 沒有任何 HD theme 載入成功時 base 為空字串。
+func pickThemes(loaded map[themeID]bool) (base themeID, derived []themeID) {
+	for _, id := range hdThemes {
+		if !loaded[id] {
+			continue
+		}
+		if base == "" {
+			base = id
+		} else {
+			derived = append(derived, id)
+		}
+	}
+	return base, derived
+}
+
+// nextTheme 回傳 F2 要切到的 theme：依 themeCycle 的順序從 cur 的下一個開始，略過不在 avail 內的與被拒（rejected）的。
+// original 永遠可用。繞一圈回到 cur 都沒有其他可用的 theme 時回 (cur, false)（F2 顯示「沒有其他 theme」，不改變狀態）。
+// cur 不在循環內（未知值）時從 original 開始。
+func nextTheme(cur themeID, avail []themeID, rejected map[themeID]bool) (themeID, bool) {
+	usable := func(id themeID) bool {
+		if id == themeOriginal {
+			return true
+		}
+		return slices.Contains(avail, id) && !rejected[id]
+	}
+	i := slices.Index(themeCycle, cur)
+	for step := 1; step <= len(themeCycle); step++ {
+		cand := themeCycle[(i+step)%len(themeCycle)]
+		if cand == cur {
+			break
+		}
+		if usable(cand) {
+			return cand, true
+		}
+	}
+	return cur, false
+}
+
+// themeEntry 是切換狀態機管理的一個 HD theme：assets 交給 hdView 與 Session，loader 做預載、釋放與錯誤統計
+// （正式實作就是 assets 本身）。
+type themeEntry struct {
+	id     themeID
+	assets *hd.Assets
+	loader assetLoader
+}
+
+// themeSet 是 loadThemes 的結果。
+type themeSet struct {
+	Base   themeID                // 基底 theme；空 ＝ 沒有任何可用的 HD theme
+	Assets map[themeID]*hd.Assets // 載入成功且（衍生 theme）通過檢查的 HD theme
+}
+
+// BaseAssets 是基底 theme 的素材（Session 的 HDAssets）；沒有時為 nil。
+func (ts *themeSet) BaseAssets() *hd.Assets {
+	if ts == nil || ts.Base == "" {
+		return nil
+	}
+	return ts.Assets[ts.Base]
+}
+
+// Available 是 resolveStartup 的 available：original 加上載入成功的 HD theme，依循環順序。
+func (ts *themeSet) Available() []themeID {
+	out := []themeID{themeOriginal}
+	if ts == nil {
+		return out
+	}
+	for _, id := range hdThemes {
+		if ts.Assets[id] != nil {
+			out = append(out, id)
+		}
+	}
+	return out
+}
+
+// Entries 是切換狀態機要管理的 HD theme（依 hd、ai 的順序）。
+func (ts *themeSet) Entries() []themeEntry {
+	var out []themeEntry
+	if ts == nil {
+		return out
+	}
+	for _, id := range hdThemes {
+		if a := ts.Assets[id]; a != nil {
+			out = append(out, themeEntry{id: id, assets: a, loader: a})
+		}
+	}
+	return out
+}
+
+// loadThemes 依 docs/spec/006 第 4 節載入 HD theme：dirs 是各 HD theme 的素材目錄（空字串 ＝ 沒找到）。
+//  1. 依 hd、ai 的順序呼叫 hd.LoadAssets（只讀兩個 TSV），失敗的 theme 不可用，記一行；
+//  2. 基底 ＝ 第一個載入成功的（pickThemes）；
+//  3. 衍生 theme 用 hd.CheckTheme(base, dir, scale) 嚴格檢查，不符就不可用，記一行。
+//
+// 預設的啟動 theme 沿用延遲解碼，不預載。
+func loadThemes(dirs map[themeID]string, scale int, logf func(string, ...any)) *themeSet {
+	if logf == nil {
+		logf = func(string, ...any) {}
+	}
+	ts := &themeSet{Assets: map[themeID]*hd.Assets{}}
+	loaded := map[themeID]*hd.Assets{}
+	ok := map[themeID]bool{}
+	for _, id := range hdThemes {
+		dir := dirs[id]
+		if dir == "" {
+			continue
+		}
+		a, err := hd.LoadAssets(dir, scale)
+		if err != nil {
+			logf("theme %s（%s）的清冊或調色盤載入失敗，不可用：%v", id, dir, err)
+			continue
+		}
+		loaded[id], ok[id] = a, true
+	}
+	base, derived := pickThemes(ok)
+	if base == "" {
+		return ts
+	}
+	ts.Base = base
+	ts.Assets[base] = loaded[base]
+	logf("HD 素材目錄（基底 theme %s）：%s", base, dirs[base])
+	for _, id := range derived {
+		a, err := hd.CheckTheme(loaded[base], dirs[id], scale)
+		if err != nil {
+			logf("theme %s（%s）未通過檢查，不可用：%v", id, dirs[id], err)
+			continue
+		}
+		ts.Assets[id] = a
+		logf("HD 素材目錄（theme %s）：%s", id, dirs[id])
+	}
+	return ts
+}
+
+// startupFlags 是命令列旗標（只放與啟動 theme、語言、聲音有關的）。*Given 是 flag.Visit 判斷「有明確給」。
+type startupFlags struct {
+	Theme      string
+	ThemeGiven bool
+	NoHD       bool // -no-hd：不開 HD 掛鉤、不建立 hdView、F2 沒有其他 theme（與 -theme original 不同）
+	Lang       string
+	LangGiven  bool
+	Mute       bool
+	MuteGiven  bool
+}
+
+// startupEnv 是影響啟動的環境變數。
+type startupEnv struct {
+	Mute string // HR_MUTE
+}
+
+// startupPlan 是 resolveStartup 的結果。
+type startupPlan struct {
+	Theme   themeID
+	Lang    lang
+	Muted   bool
+	HDHooks bool     // 是否開 HD 掛鉤、建立 hdView（有 HD theme 可用且沒有 -no-hd）
+	Logs    []string // 要記到日誌的行（旗標或偏好設定的值不認得、不可用）
+}
+
+// resolveStartup 決定啟動時的 theme、介面語言與靜音（docs/spec/006 第 4、5、7 節）。優先序一致：
+// 命令列旗標、環境變數（目前只有 HR_MUTE）、偏好設定、預設。
+//
+//   - theme：-theme，其次偏好設定，其次第一個可用的 HD theme（有 hd/ 是 hd，只有 hd-ai/ 是 ai），都沒有是 original。
+//     值未知或該 theme 不可用時，當作沒給，往下一個來源找並記一行，不致命；偏好設定的值不覆寫檔案內容。
+//   - -no-hd：HDHooks 為假，可用的 theme 只有 original（-theme hd 因此「不可用」）。
+//   - -hd、-hd-ai 只決定目錄（paths.go），不選 theme，不在這裡處理。
+//   - lang：-lang，其次偏好設定，其次 zh-TW；值未知退回下一個來源並記一行。
+//   - 聲音：resolveMute（docs/spec/007 第 5.4 節）。
+//
+// avail 是可用的 theme（themeSet.Available()：original 加載入成功的 HD theme）。
+// 旗標與環境變數啟動的值不會被持久化：偏好設定只由「被切換的欄位」的補丁寫入（prefs.go）。
+func resolveStartup(f startupFlags, env startupEnv, p prefs, avail []themeID) startupPlan {
+	var plan startupPlan
+	logf := func(format string, a ...any) { plan.Logs = append(plan.Logs, fmt.Sprintf(format, a...)) }
+
+	usable := map[themeID]bool{themeOriginal: true}
+	var firstHD themeID
+	if !f.NoHD {
+		for _, id := range hdThemes {
+			if slices.Contains(avail, id) {
+				usable[id] = true
+				if firstHD == "" {
+					firstHD = id
+				}
+			}
+		}
+	}
+	plan.HDHooks = firstHD != ""
+
+	// theme
+	plan.Theme = themeOriginal
+	if firstHD != "" {
+		plan.Theme = firstHD
+	}
+	chosen := false
+	if f.ThemeGiven {
+		id, known := parseTheme(f.Theme)
+		switch {
+		case !known:
+			logf("-theme %q 不認得（應為 original、hd、ai），退回預設", f.Theme)
+		case !usable[id]:
+			logf("-theme %s 目前不可用（沒有素材目錄、未通過檢查，或指定了 -no-hd），退回預設", id)
+		default:
+			plan.Theme, chosen = id, true
+		}
+	}
+	if !chosen && p.Theme != "" {
+		id, known := parseTheme(p.Theme)
+		switch {
+		case !known:
+			logf("偏好設定的 theme %q 不認得，用預設（不覆寫檔案內容）", p.Theme)
+		case !usable[id]:
+			logf("偏好設定的 theme %s 目前不可用，用預設（不覆寫檔案內容）", id)
+		default:
+			plan.Theme = id
+		}
+	}
+
+	// 介面語言
+	plan.Lang = langTW
+	chosen = false
+	if f.LangGiven {
+		if l, ok := parseLang(f.Lang); ok {
+			plan.Lang, chosen = l, true
+		} else {
+			logf("-lang %q 不認得（應為 zh-TW、zh-CN、ko、en、ja），退回預設", f.Lang)
+		}
+	}
+	if !chosen && p.Lang != "" {
+		if l, ok := parseLang(p.Lang); ok {
+			plan.Lang = l
+		} else {
+			logf("偏好設定的 lang %q 不認得，用預設（不覆寫檔案內容）", p.Lang)
+		}
+	}
+
+	plan.Muted = resolveMute(f.MuteGiven, f.Mute, env.Mute, p.Sound)
+	return plan
+}
