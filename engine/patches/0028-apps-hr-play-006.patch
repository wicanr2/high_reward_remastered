+			if len(forwarded[k]) != 0 {
+				t.Errorf("F%d 是前端保留鍵，卻被轉成遊戲事件：%+v", n, forwarded[k])
+			}
+		default: // F5 至 F10 照舊送進遊戲，掃描碼 0x3F 至 0x44
+			want := hrrt.KeyEvent(uint8(0x3F+(n-5)), 0)
+			if len(forwarded[k]) != 1 || forwarded[k][0] != want {
+				t.Errorf("F%d 應送進遊戲 %+v，實際 %+v", n, want, forwarded[k])
