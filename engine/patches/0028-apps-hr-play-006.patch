+// ---- Layout 與游標換算 ----
+
+// 邏輯畫面固定 1280x800：在每個 theme 狀態（original、HD、切換的每個階段）與任意視窗大小下，Layout 都回 1280x800。
+func TestLayoutAlwaysLogicalSize(t *testing.T) {
+	sizes := [][2]int{{640, 400}, {1280, 800}, {1920, 1080}, {3840, 2160}, {1, 1}, {0, 0}, {800, 600}, {1281, 801}}
+	check := func(gr *gameRig, stage string) {
+		t.Helper()
+		for _, sz := range sizes {
+			if w, h := gr.g.Layout(sz[0], sz[1]); w != 1280 || h != 800 {
+				t.Errorf("%s：Layout(%d, %d) ＝ (%d, %d)，應為 (1280, 800)", stage, sz[0], sz[1], w, h)
+			}
+		}
+	}
+	gr := newGameRig(t, themeOriginal, []themeID{themeHD})
+	check(gr, "original")
+	gr.mustFrame(ebiten.KeyF2)
+	gr.settle(stApplying)
+	check(gr, "切換中（applying）")
+	gr.view.publish()
+	gr.mustFrame()
+	if gr.sw.Current() != themeHD || gr.sw.Display() != srcHD {
+		t.Fatalf("切換後應為 HD：%v %v", gr.sw.Current(), gr.sw.Display())
+	}
+	check(gr, "HD")
+	gr.mustFrame(ebiten.KeyF2)
+	if gr.sw.Current() != themeOriginal {
+		t.Fatalf("再按 F2 應回 original：%v", gr.sw.Current())
+	}
+	check(gr, "回 original")
+	gr2 := newGameRig(t, themeHD, []themeID{themeHD})
+	check(gr2, "啟動即 HD")
+}
