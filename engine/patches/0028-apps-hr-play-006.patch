+func TestI18NStaticStringsFitPanelWidth(t *testing.T) {
+	verbs := regexp.MustCompile(`%[-+# 0-9.]*[a-zA-Z]`)
+	for _, l := range langOrder {
+		_, face := newFace(t, readFont(t, string(l)))
