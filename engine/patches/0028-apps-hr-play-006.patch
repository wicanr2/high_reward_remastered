+}
+
+// 子項 (1)：卡住 A，SetAssets(nil)，放行 A，等 discards ＝ 1（丟棄路徑在 mu 下遞增），此刻 pub ＝ 0 且 ready 為空。
+func scenario1(t *testing.T, m hvMode) error {
+	f := newHVFix(t, m, 64, 48, true, false)
+	if !recvWithin(f.hA.in, hvWait) {
+		return errAt("setup", "A 的合成沒有開始")
+	}
+	f.v.SetAssets(nil)
+	f.hA.open()
+	if !waitUntil(m.failWait(), func() bool { return f.v.stats().Discards == 1 }) {
+		return errAt("wait-discards", "等不到 discards ＝ 1（實際 %d，pub ＝ %d）", f.v.stats().Discards, f.v.stats().Pub)
+	}
+	st := f.v.stats()
+	if st.Pub != 0 || st.Ready {
