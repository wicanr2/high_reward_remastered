--- /dev/null
+++ b/apps/hr/play/panel.go
@@ -0,0 +1,237 @@
+package main
+
+import (
+	"strconv"
+	"strings"
+	"time"
+
+	"golang.org/x/image/font"
+)
+
+// F1 功能說明的內容（docs/spec/006 第 3 節）。本檔只有純函式與快取判斷：組出 21 行文字並套用超長處理，不碰 ebiten 與 GPU，
+// 所以面板邊界可以在單元測試裡用真字面量測。繪製在 overlay.go。
+
+// 面板的列配置（21 行預算：標題 1、按鍵表 8、狀態 4、統計 3、診斷 1、提示 4）。
+const (
+	rowTitle  = 0
+	rowKeys   = 1  // 1 至 8
+	rowStatus = 9  // 9 至 12
+	rowStats  = 13 // 13 至 15：另一層，至多每秒重畫一次
+	rowDiag   = 16
+	rowTips   = 17 // 17 至 20
+
+	rowKeysN  = 8
+	rowStatsN = 3
+)
+
+func isStatsRow(i int) bool { return i >= rowStats && i < rowStats+rowStatsN }
+
+// soundState 是 F1 狀態列的聲音狀態。
+type soundState int
+
+const (
+	soundOn soundState = iota
+	soundOff
+	soundNA // 沒有聲音引擎
+)
+
+// panelStats 是統計三行的欄位（沿用 Session.Stats 與 ebiten.ActualTPS／ActualFPS）。
+type panelStats struct {
+	Steps, Ticks    uint64
+	SimSeconds      float64
+	Interval        uint64
+	Lowered         bool
+	MinSP, StackTop uint16
+	OpenFiles       int
+	TPS, FPS        float64
+}
+
+// frozenStats 是 HR_TEST_FREEZE_UI=1 時統計欄位的固定常數（端對端截圖要可重現）。
+var frozenStats = panelStats{Steps: 98765432, Ticks: 2424, SimSeconds: 233, Interval: 300000, MinSP: 0x0E10, StackTop: 0x1000, OpenFiles: 2, TPS: 60, FPS: 60}
+
+// panelInfo 是 panelLines 的輸入。介面語言由 panelLines 的 lang 參數決定；遊戲內文字語言在 M10 之前一律是繁體中文（原版）。
+type panelInfo struct {
+	Version                    string
+	Theme                      themeID
+	Usable                     []themeID
+	Sound                      soundState
+	Stats                      panelStats
+	Diag                       string // 最近一份診斷的目錄名；空 ＝ 沒有
+	SaveDir, ShotsDir, DataDir string
+}
+
+// composePanel 組出面板的 21 行。t 是字串表查詢（含格式化），uiName 是介面語言的顯示名稱，fit 是每行的超長處理。
+func composePanel(t func(key string, args ...any) string, uiName string, info panelInfo, fit func(string) string) []string {
+	lines := make([]string, 0, panelRows)
+	add := func(s string) { lines = append(lines, fit(s)) }
+
+	add(t("app.title", info.Version))
+	for _, k := range []string{"key.f1", "key.f2", "key.f3", "key.f4", "key.f11", "key.f12", "key.ctrld", "key.ctrlq"} {
+		add(t(k))
+	}
+
+	names := make([]string, len(info.Usable))
+	for i, id := range info.Usable {
+		names[i] = t("theme." + string(id))
+	}
+	add(t("status.theme", t("theme."+string(info.Theme)), strings.Join(names, t("list.sep"))))
+	add(t("status.ui", uiName))
+	add(t("status.game", t("game.text.orig")))
+	var snd string
+	switch info.Sound {
+	case soundOn:
+		snd = t("on")
+	case soundOff:
+		snd = t("off")
+	default:
+		snd = t("sound.na")
+	}
+	add(t("status.sound", snd))
+
+	st := info.Stats
+	lowered := t("no")
+	if st.Lowered {
+		lowered = t("yes")
+	}
+	add(t("stat.line1", st.Steps, st.Ticks, st.SimSeconds, st.Interval, lowered))
+	add(t("stat.line2", st.MinSP, st.StackTop, st.OpenFiles))
+	add(t("stat.line3", st.TPS, st.FPS))
+
+	diag := info.Diag
+	if diag == "" {
+		diag = t("diag.none")
+	}
+	add(t("diag.last", diag))
+
+	add(t("tip.mouse"))
+	add(t("tip.saves", info.SaveDir))
+	add(t("tip.shots", info.ShotsDir))
+	add(t("tip.data", info.DataDir))
+	return lines
+}
+
+// panelLines 組出 l 語言的面板 21 行，每行都已套用超長處理（寬度不超過 hudW，中間以「…」省略，缺字以 ? 取代）。
+func panelLines(l lang, face font.Face, info panelInfo) []string {
+	t := func(key string, args ...any) string { return tr(l, key, args...) }
+	return composePanel(t, langNames[l], info, func(s string) string { return fitLine(face, s, hudW) })
+}
+
+// panelLinesASCII 是字型載入失敗時的 ASCII 英文版（DebugPrintAt 只畫得出 ASCII）：同樣 21 行，英文字串表，
+// 非 ASCII 字元換成 ?，寬度以 DebugPrint 的字寬（6 像素）計。介面語言顯示代號而非名稱（名稱多半不是 ASCII）。
+func panelLinesASCII(l lang, info panelInfo) []string {
+	return composePanel(trASCII, string(l), info, func(s string) string { return fitASCII(s, hudW/debugCharW) })
+}
+
+// ---- 超長處理（docs/spec/006 第 3 節） ----
+
+const ellipsis = "…"
+
+// sanitizeLine 把控制字元（text.Draw 會把 \n 當換行）與字面缺的字元（GlyphIndex ＝ 0，會畫出 .notdef 方框）換成 ?。
+func sanitizeLine(face font.Face, s string) string {
+	var b strings.Builder
+	b.Grow(len(s))
+	for _, r := range s {
+		if r < 0x20 || r == 0x7F {
+			r = '?'
+		} else if _, ok := face.GlyphAdvance(r); !ok {
+			r = '?'
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// lineWidth 是一行畫出來占用的寬度（像素）：前進量與墨跡右緣取大者。兩者通常相同；墨跡右緣可能超出前進量
+// （字形右側外溢），空白結尾則前進量較大。
+func lineWidth(face font.Face, s string) int {
+	w := font.MeasureString(face, s).Ceil()
+	b, _ := font.BoundString(face, s)
+	if r := b.Max.X.Ceil(); r > w {
+		w = r
+	}
+	return w
+}
+
+// fitLine 讓 s 在 face 下的寬度不超過 maxW：缺字與控制字元換成 ?；過寬時保留頭尾、中間以「…」省略，不換行。
+func fitLine(face font.Face, s string, maxW int) string {
+	s = sanitizeLine(face, s)
+	return fitWith(s, ellipsis, func(x string) bool { return lineWidth(face, x) <= maxW })
+}
+
+// debugCharW 是 ebitenutil.DebugPrintAt 的字寬（像素）。
+const debugCharW = 6
+
+// fitASCII 是 ASCII 退回版的超長處理：最多 maxChars 個字元，過長時中間以「...」省略。
+func fitASCII(s string, maxChars int) string {
+	var b strings.Builder
+	for _, r := range s {
+		if r < 0x20 || r > 0x7E {
+			r = '?'
+		}
+		b.WriteRune(r)
+	}
+	return fitWith(b.String(), "...", func(x string) bool { return len(x) <= maxChars })
+}
+
+// fitWith 是共用的中間省略：fits(s) 為真就原樣回傳；否則找最多的保留字元數 keep，使 頭 ＋ ellipsis ＋ 尾 放得下
+// （頭 ceil(keep/2) 個、尾 floor(keep/2) 個字元）。keep 越大越寬，所以二分搜尋；連 keep ＝ 0 都放不下就回 ellipsis。
+func fitWith(s, ell string, fits func(string) bool) string {
+	if fits(s) {
+		return s
+	}
+	r := []rune(s)
+	build := func(keep int) string {
+		head, tail := (keep+1)/2, keep/2
+		return string(r[:head]) + ell + string(r[len(r)-tail:])
+	}
+	lo, hi := 0, len(r)-1
+	if hi < 0 {
+		return ell
+	}
+	for lo < hi {
+		mid := (lo + hi + 1) / 2
+		if fits(build(mid)) {
+			lo = mid
+		} else {
+			hi = mid - 1
+		}
+	}
+	// 二分搜尋假設寬度隨 keep 單調；字面若有例外（外溢的墨跡），往下收斂到真正放得下為止
+	for lo > 0 && !fits(build(lo)) {
+		lo--
+	}
+	return build(lo)
+}
+
+// lineBaseline 是第 i 行的基線：上緣 ＋ Ascent（取整）＋ lineStep × i。每行各自呼叫 text.Draw，基線由呼叫端算，
+// 不用 \n（text.Draw 的換行用 Metrics().Height，非整數，多行基線會逐行漂移；docs/spec/006 第 3 節）。
+func lineBaseline(face font.Face, top, i int) int {
+	return top + face.Metrics().Ascent.Floor() + lineStep*i
+}
+
+// ---- 面板文字的快取 ----
+
+// staticKey 是 info 中靜態部分（除了統計以外的欄位）的鍵：鍵沒變，靜態行的內容就不會變。
+func (i panelInfo) staticKey() string {
+	ids := make([]string, len(i.Usable))
+	for n, id := range i.Usable {
+		ids[n] = string(id)
+	}
+	return strings.Join([]string{i.Version, string(i.Theme), strings.Join(ids, ","), strconv.Itoa(int(i.Sound)), i.Diag, i.SaveDir, i.ShotsDir, i.DataDir}, "\x00")
+}
+
+// panelCache 讓 F1 面板的 21 行文字不必每幀重組（超長路徑的量測不便宜）：鍵（語言、字面種類、靜態欄位）沒變，
+// 且距上次組裝不到 1 秒就沿用；統計三行因此至多每秒更新一次，與統計層的重畫間隔一致。
+type panelCache struct {
+	key   string
+	at    time.Time
+	lines []string
+}
+
+func (c *panelCache) get(key string, now time.Time, compute func() []string) []string {
+	if c.lines != nil && c.key == key && now.Sub(c.at) < time.Second {
+		return c.lines
+	}
+	c.key, c.at, c.lines = key, now, compute()
+	return c.lines
+}
diff --git a/apps/hr/play/panel_test.go b/apps/hr/play/panel_test.go
