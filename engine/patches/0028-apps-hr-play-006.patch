+// 每行各自呼叫 text.Draw，基線由呼叫端算：第 i 行基線 ＝ 上緣 ＋ Ascent（取整）＋ 32 × i。
+// 若改用 \n，基線的間距是 Metrics().Height（約 31.86，非整數）；這裡確認間距恰為 32，且與 Height 的累加不同。
+func TestLineBaselines(t *testing.T) {
+	for _, l := range langOrder {
+		face := mustFace(t, l)
+		asc := face.Metrics().Ascent.Floor()
+		if asc != 25 { // Ascent 25.52 像素；取下限讓墨跡在 32 像素格內（TestGlyphInkInsideRowCell：取上限 26 時 '|' 的下緣是 33）
+			t.Errorf("%s：Ascent 取整 ＝ %d，em 22 預期 25", l, asc)
+		}
+		for i := 0; i < panelRows; i++ {
+			if got := lineBaseline(face, 0, i) - lineBaseline(face, 0, 0); got != lineStep*i {
+				t.Errorf("%s：第 %d 行基線距第 0 行 %d，應為 %d", l, i, got, lineStep*i)
+			}
+			if got := lineBaseline(face, 100, i); got != 100+asc+lineStep*i {
+				t.Errorf("%s：上緣 100 的第 %d 行基線 %d", l, i, got)
+			}
+		}
+		// 對照：用 Height 累加到第 20 行會漂移（31.86 × 20 ＝ 637.2，與 640 差 2.8 像素）
+		h := face.Metrics().Height
+		drift := fixed.Int26_6(lineStep*20*64) - 20*h
+		if drift.Round() < 2 {
+			t.Errorf("%s：Height 累加的漂移只有 %v 像素，\\n 方案與固定行距沒有可觀察差異", l, drift)
+		}
+	}
+}
+
+// 墨跡在行的 32 像素格內：每個子集字元以 lineBaseline 的基線畫出，上緣 ≥ 0、下緣 ≤ 32，所以相鄰疊加層的矩形在墨跡層級也不相交。
+func TestGlyphInkInsideRowCell(t *testing.T) {
+	for _, l := range langOrder {
+		face := mustFace(t, l)
+		base := lineBaseline(face, 0, 0)
+		for _, r := range charsetFile(t, string(l)) {
+			b, _, ok := face.GlyphBounds(r)
+			if !ok || b.Empty() {
+				continue
+			}
+			if top := base + b.Min.Y.Floor(); top < 0 {
+				t.Errorf("%s：U+%04X %q 墨跡上緣 %d < 0", l, r, r, top)
+			}
+			if bot := base + b.Max.Y.Ceil(); bot > lineStep {
+				t.Errorf("%s：U+%04X %q 墨跡下緣 %d > %d", l, r, r, bot, lineStep)
+			}
+		}
+	}
+}
