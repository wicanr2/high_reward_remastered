+// 超長處理：中間以「…」省略、不換行；缺字與控制字元以 ? 取代；沒超長就原樣。
+func TestFitLine(t *testing.T) {
+	face := mustFace(t, langEN)
+
+	if got := fitLine(face, "short line", hudW); got != "short line" {
+		t.Errorf("沒超長應原樣：%q", got)
+	}
+	long := "/home/user/" + strings.Repeat("dir/", 400) + "file.txt"
+	got := fitLine(face, long, hudW)
+	if got == long || !strings.Contains(got, ellipsis) {
+		t.Fatalf("超長應被省略：%q", shorten(got))
+	}
+	if strings.Count(got, ellipsis) != 1 {
+		t.Errorf("應只有一個省略號：%q", got)
+	}
+	i := strings.Index(got, ellipsis)
+	head, tail := got[:i], got[i+len(ellipsis):]
+	if !strings.HasPrefix(long, head) || !strings.HasSuffix(long, tail) {
+		t.Errorf("頭尾應來自原字串：head＝%q tail＝%q", head, tail)
+	}
+	if !strings.HasPrefix(head, "/home/user/") || !strings.HasSuffix(tail, "file.txt") {
+		t.Errorf("路徑的頭（根目錄）與尾（檔名）都應保留：head＝%q tail＝%q", shorten(head), tail)
+	}
+	// 最大化：再多保留一個字元就放不下
+	keep := len([]rune(head)) + len([]rune(tail))
+	r := []rune(long)
+	more := keep + 1
+	cand := string(r[:(more+1)/2]) + ellipsis + string(r[len(r)-more/2:])
+	if lineWidth(face, cand) <= hudW {
+		t.Errorf("保留 %d 個字元仍放得下，fitLine 只保留了 %d 個", more, keep)
+	}
+	// 寬度預算很小時退到只剩省略號，不 panic
+	if got := fitLine(face, long, 1); got != ellipsis {
+		t.Errorf("預算 1 像素應只剩省略號：%q", got)
+	}
+	if got := fitLine(face, "", hudW); got != "" {
+		t.Errorf("空字串：%q", got)
+	}
+
+	// 缺字：龘不在任何子集內 → ?；控制字元 → ?
+	if got := fitLine(face, "a龘b", hudW); got != "a?b" {
+		t.Errorf("缺字應換成 ?：%q", got)
+	}
+	if got := fitLine(face, "a\nb\r\tc\x7f", hudW); got != "a?b??c?" {
+		t.Errorf("控制字元應換成 ?：%q", got)
+	}
+	// 缺字替換的是「子集缺的字」而不是「非 ASCII」：中文子集裡的中文字保留
+	zh := mustFace(t, langTW)
+	if got := fitLine(zh, "已停機龘", hudW); got != "已停機?" {
+		t.Errorf("子集內的中文字應保留、缺字換 ?：%q", got)
+	}
+	// 冪等
+	if again := fitLine(face, got, hudW); again != got {
+		t.Errorf("fitLine 應冪等：%q → %q", got, again)
+	}
+}
