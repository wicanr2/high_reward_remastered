+	}
+	gr.mustFrame(ebiten.KeyF3)
+	if gr.g.snd.Muted() {
+		t.Error("再按 F3 應取消靜音")
+	}
+	if s, _ := newHudText(gr.g.fonts, langEN).toast(gr.sw.Toast(), gr.clk.Now()); s != "Sound: on" {
+		t.Errorf("F3 toast：%q", s)
