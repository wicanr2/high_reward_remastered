+// 偵測器本身要有鑑別力（正對照）：違規的原始碼必須被抓到，合規的不能誤報。
+func TestExitDetectorCatchesViolations(t *testing.T) {
+	cases := []struct {
+		name string
+		srcs map[string]string
+		want int
+	}{
+		{"一般函式", map[string]string{"x.go": "package main\nfunc helper() { os.Exit(1) }\n"}, 1},
+		{"log.Fatal", map[string]string{"x.go": "package main\nfunc helper() { log.Fatalf(\"x\") }\n"}, 1},
+		{"main 在寫入者建立之後", map[string]string{"main.go": "package main\nfunc main() { pw := newPrefsWriter(); _ = pw; os.Exit(1) }\n"}, 1},
+		{"main 在寫入者建立之前", map[string]string{"main.go": "package main\nfunc main() { os.Exit(2); pw := newPrefsWriter(); _ = pw }\n"}, 0},
+		{"main 的函式字面值（寫入者建立前定義、之後可能執行）", map[string]string{"main.go": "package main\nfunc main() { f := func() { os.Exit(2) }; _ = f; pw := newPrefsWriter(); _ = pw }\n"}, 1},
+		{"main 沒有寫入者", map[string]string{"main.go": "package main\nfunc main() { os.Exit(2) }\n"}, 1},
+		{"quit", map[string]string{"main.go": "package main\nfunc quit(code int) { os.Exit(code) }\n"}, 0},
+		{"quit 在別的檔案", map[string]string{"other.go": "package main\nfunc quit(code int) { os.Exit(code) }\n"}, 1},
+		{"fail 在 errwin.go", map[string]string{"errwin.go": "package main\nfunc fail() { os.Exit(2) }\n"}, 0},
+		{"fail 在別的檔案", map[string]string{"other.go": "package main\nfunc fail() { os.Exit(2) }\n"}, 1},
+		{"方法", map[string]string{"main.go": "package main\nfunc (td *teardown) quit(code int) { os.Exit(code) }\n"}, 1},
+	}
+	for _, c := range cases {
+		fset, files := parseSources(t, c.srcs)
+		if got := exitViolations(fset, files); len(got) != c.want {
+			t.Errorf("%s：抓到 %d 個違規，應為 %d：%v", c.name, len(got), c.want, got)
+		}
+	}
+}
