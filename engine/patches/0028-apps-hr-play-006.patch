+	gr.mustFrame(ebiten.KeyF1) // 關閉：同一幀 help 已是 false，字元與按住的 Enter 在這一幀就送進遊戲
+	if got := gr.ss.take(); len(got) != 3 {
+		t.Errorf("關閉說明的那一幀起應恢復送進遊戲：%+v", got)
+	}
+	gr.fe.ctrl = true
+	gr.mustFrame()
+	if got := gr.ss.take(); len(got) != 0 {
+		t.Errorf("Ctrl 按住不該送進遊戲：%+v", got)
+	}
+}
