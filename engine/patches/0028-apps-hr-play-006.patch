+
+// 子項 (2)：卡住 A，SetAssets(B)，放行 A，等 B 的 inCompose（屏障：run 是單一 goroutine，B 的 Compose 開始時
+// A 那一輪的發佈決定必然已做完），此刻 pub ＝ 0 且 ready 為空；放行 B，等 pub ＝ 1，pubFrom ＝ B。
+// 來源不提供新 Seq（涵蓋 last 重設與素材世代一起改變）。
+func scenario2(t *testing.T, m hvMode) error {
