+// newHVFix 建立假來源、素材 A 與 B、（選用的）阻塞鉤子與 hdView（以 A 起始）。
+// 清理：先放行所有鉤子再 close()（close 的 wg.Wait 會在阻塞的鉤子上永遠不回）。
+func newHVFix(t *testing.T, m hvMode, fw, fh int, hookA, hookB bool) *hvFix {
+	t.Helper()
+	f := &hvFix{src: &fakeSource{}, A: emptyAssets(t), B: emptyAssets(t), hA: newBlockHook(), hB: newBlockHook(), frameW: fw, frameH: fh}
+	f.src.set(newFakeFrame(fw, fh, 1))
+	if hookA {
+		f.hA.install(f.A)
+	}
+	if hookB {
+		f.hB.install(f.B)
+	}
+	var opts []hdViewOption
+	if m.skip {
+		opts = append(opts, withSkipEpochCheck())
+	}
+	f.v = newHDView(f.src, f.A, 2, opts...)
