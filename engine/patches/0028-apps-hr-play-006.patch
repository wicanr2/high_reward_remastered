+	if !waitUntil(m.failWait(), func() bool { return f.v.stats().Pub == 2 }) {
+		return errAt("wait-pub2", "恢復後沒有重新合成（靜態畫面，pub ＝ %d）", f.v.stats().Pub)
+	}
+	if f.v.stats().PubFrom != f.B {
+		return errAt("assert-pubFrom", "pubFrom 應為 B")
+	}
