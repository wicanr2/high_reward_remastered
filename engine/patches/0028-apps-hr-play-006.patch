+// F1 面板文字經 panelCache：180 個 60 Hz 的幀只問 Session.Stats 3 次（每秒一次），統計行在滿 1 秒時更新；
+// 靜態欄位（theme、聲音、語言）變了立刻重組。
+func TestPanelTextCache(t *testing.T) {
+	gr := newGameRig(t, themeOriginal, []themeID{themeHD}, withSound())
+	ht := newHudText(gr.g.fonts, langEN)
+	gr.ss.stats = hrrt.Stats{Steps: 1}
+	var first, last []string
+	for k := 0; k < 180; k++ {
+		if k == 100 {
+			gr.ss.stats = hrrt.Stats{Steps: 2}
+		}
+		if k == 119 {
+			last = gr.g.panelText(ht, gr.clk.Now())
+		}
+		got := gr.g.panelText(ht, gr.clk.Now())
+		if k == 0 {
+			first = got
+		}
+		gr.clk.advance(time.Second / 60)
+	}
+	if gr.ss.statsCalls != 3 {
+		t.Errorf("Stats 呼叫 %d 次，應為 3", gr.ss.statsCalls)
+	}
+	if !strings.HasPrefix(first[rowStats], "steps 1 ") || !strings.HasPrefix(last[rowStats], "steps 1 ") {
+		t.Errorf("1 秒內統計行不該更新：%q %q", first[rowStats], last[rowStats])
+	}
+	if got := gr.g.panelText(ht, gr.clk.Now()); !strings.HasPrefix(got[rowStats], "steps 2 ") {
+		t.Errorf("滿 1 秒後統計行應更新：%q", got[rowStats])
+	}
+	// 靜態欄位變了：立刻重組
+	gr.mustFrame(ebiten.KeyF3) // 聲音：開 → 關（第一次 Update 會寫 telemetry，也會問一次 Stats，所以在它之後取基準）
+	calls := gr.ss.statsCalls
+	got := gr.g.panelText(ht, gr.clk.Now())
+	if !strings.HasSuffix(got[rowStatus+3], "off") || gr.ss.statsCalls != calls+1 {
+		t.Errorf("聲音狀態變了應立刻重組：%q、Stats 呼叫 %d → %d", got[rowStatus+3], calls, gr.ss.statsCalls)
+	}
+	// 語言（hudText）變了：立刻重組成新語言
+	htTW := newHudText(gr.g.fonts, langTW)
+	if got := gr.g.panelText(htTW, gr.clk.Now()); !strings.HasPrefix(got[rowKeys], "F1　功能說明") {
+		t.Errorf("語言變了應立刻重組：%q", got[rowKeys])
+	}
+}
