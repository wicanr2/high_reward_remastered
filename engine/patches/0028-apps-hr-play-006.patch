+// loadOriginalPCM 讀原版目錄內的 SOUND_E.PCM（檔名大小寫不分），並核對大小與 required.tsv 一致。
+// 檔案缺失或大小不符時回 nil 與原因：音效關閉，音樂不受影響（docs/spec/007 第 5.4 節）。
+func loadOriginalPCM(root string) ([]byte, error) {
+	var want int64 = -1
+	for _, rf := range hrrt.RequiredFiles() {
+		if equalFold(rf.Name, "SOUND_E.PCM") {
+			want = rf.Size
+		}
+	}
+	ents, err := os.ReadDir(root)
+	if err != nil {
+		return nil, err
+	}
+	for _, e := range ents {
+		if equalFold(e.Name(), "SOUND_E.PCM") {
+			b, err := os.ReadFile(filepath.Join(root, e.Name()))
+			if err != nil {
+				return nil, err
+			}
+			if want >= 0 && int64(len(b)) != want {
+				return nil, fmt.Errorf("SOUND_E.PCM 大小 %d，應為 %d", len(b), want)
+			}
+			return b, nil
+		}
+	}
+	return nil, fmt.Errorf("找不到 SOUND_E.PCM")
+}
