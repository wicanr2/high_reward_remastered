+// ---- 截圖 ----
+
+func pngSize(t *testing.T, path string) image.Point {
+	t.Helper()
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	cfg, err := png.DecodeConfig(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return image.Pt(cfg.Width, cfg.Height)
+}
+
+func shots(t *testing.T, dir string) []string {
+	t.Helper()
+	m, _ := filepath.Glob(filepath.Join(dir, "screenshots", "*.png"))
+	return m
+}
+
+// F12 截圖依「目前 theme」選路徑（original 存 640x400，HD 存 1280x800），不依 hv 是否存在；
+// HD theme 下 writePNG 回 errNoFrame（ready 為空）時，退回存原版快照（640x400）並記一行。
+func TestScreenshotByTheme(t *testing.T) {
+	// original：即使有 HD 掛鉤，也存 640x400，且不呼叫 HD 的 writePNG
+	called := 0
+	gr := newGameRig(t, themeOriginal, []themeID{themeHD}, withPNGHD(func(string) error { called++; return nil }))
+	gr.mustFrame(ebiten.KeyF12)
+	if got := shots(t, gr.dir); len(got) != 1 || pngSize(t, got[0]) != image.Pt(640, 400) || called != 0 {
+		t.Errorf("original：%v、HD 呼叫 %d 次", got, called)
+	}
+
+	// HD 且 ready 為空（errNoFrame，包了一層）：退回原版快照並記一行
+	gr = newGameRig(t, themeHD, []themeID{themeHD}, withPNGHD(func(string) error { return fmt.Errorf("寫入：%w", errNoFrame) }))
+	gr.mustFrame(ebiten.KeyF12)
+	got := shots(t, gr.dir)
+	if len(got) != 1 || pngSize(t, got[0]) != image.Pt(640, 400) {
+		t.Fatalf("HD、ready 為空：%v", got)
+	}
+	if !gr.glog.has("改存原版快照") {
+		t.Errorf("退回時應記一行：%v", gr.glog.all())
+	}
+
+	// HD 且畫面就緒：存 HD 解析度，不退回
+	gr = newGameRig(t, themeHD, []themeID{themeHD}, withPNGHD(func(path string) error {
+		img := image.NewRGBA(image.Rect(0, 0, 1280, 800))
+		f, err := os.Create(path)
+		if err != nil {
+			return err
+		}
+		defer f.Close()
+		return png.Encode(f, img)
+	}))
+	gr.mustFrame(ebiten.KeyF12)
+	if got := shots(t, gr.dir); len(got) != 1 || pngSize(t, got[0]) != image.Pt(1280, 800) {
+		t.Errorf("HD、就緒：%v", got)
+	}
+	if gr.glog.has("改存原版快照") {
+		t.Errorf("就緒時不該退回：%v", gr.glog.all())
+	}
+
+	// HD 且其他錯誤：不退回、不留檔、記錯誤
+	gr = newGameRig(t, themeHD, []themeID{themeHD}, withPNGHD(func(string) error { return errors.New("磁碟已滿") }))
+	gr.mustFrame(ebiten.KeyF12)
+	if got := shots(t, gr.dir); len(got) != 0 || !gr.glog.has("截圖失敗") {
+		t.Errorf("其他錯誤：%v %v", got, gr.glog.all())
+	}
+
+	// 沒有 Session 畫面：什麼都不做
+	gr = newGameRig(t, themeOriginal, nil)
+	gr.ss.frame = nil
+	gr.mustFrame(ebiten.KeyF12)
+	if got := shots(t, gr.dir); len(got) != 0 {
+		t.Errorf("沒有畫面：%v", got)
+	}
+}
