+	td.run()
+	if time.Since(start) > 3*time.Second {
+		t.Errorf("收拾花了 %v", time.Since(start))
+	}
+	if r.sw.State() != stCancelling {
+		t.Errorf("sw.Quit 應取消預載：%v", r.sw.State())
+	}
+	mu.Lock()
+	if len(saved) != 1 || saved[0] != "{lang=ko}" {
+		t.Errorf("pw.Close 應 flush 待寫的補丁：%v", saved)
+	}
+	mu.Unlock()
+	select {
+	case <-hv.stop:
+	default:
+		t.Error("hv.close 應停掉合成")
+	}
+	if strings.Join(after, "") != "ab" {
+		t.Errorf("其餘收尾的順序：%v", after)
+	}
+	pw.Submit(langPatch(langJA)) // Close 之後的提交被忽略，不 panic
+
+	// nil 欄位安全（沒有 HD 掛鉤時 hv 為 nil）
+	(&teardown{}).run()
+}
