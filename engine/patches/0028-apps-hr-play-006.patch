+++ b/apps/hr/play/panel_test.go
@@ -0,0 +1,610 @@
+package main
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/image/font"
+	"golang.org/x/image/math/fixed"
+)
+
+// docs/spec/006 第 3 節與第 10 節的 F1 面板測試。面板文字由純函式 panelLines 組出，用真字面量測，不需要 GPU。
+
+// mustFace 走正式的載入路徑（fontsrc.go 的 loadFontBytes 與 newUIFace）：面板測試量的就是畫出來用的那個字面，
+// 不用 fonts_test.go 自己建的字面。
+func mustFace(t testing.TB, l lang) font.Face {
+	t.Helper()
+	b, err := loadFontBytes(l)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := newUIFace(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return f
+}
+
+// 兩種獨立的量法（docs/spec/006 第 10 節）：前進量（font.MeasureString）與墨跡右緣（font.BoundString）。
+// 刻意不呼叫 lineWidth：測試不能用被測程式自己的量法驗自己。
+func advanceWidth(face font.Face, s string) int { return font.MeasureString(face, s).Ceil() }
+
+func inkRightEdge(face font.Face, s string) int {
+	b, _ := font.BoundString(face, s)
+	return b.Max.X.Ceil()
+}
