+
+// fontSet 管理每個語言的字面：建立後長期保留（每個語言一個，切換語言不重建）；載入失敗的語言記一行並退回 ASCII。
+// 只在 UI 執行緒使用（字面不是並行安全的，載入結果也不加鎖）。
+type fontSet struct {
+	logf   func(string, ...any)
+	faces  map[lang]font.Face
+	failed map[lang]bool
+}
+
+func newFontSet(logf func(string, ...any)) *fontSet {
+	if logf == nil {
+		logf = func(string, ...any) {}
+	}
+	return &fontSet{logf: logf, faces: map[lang]font.Face{}, failed: map[lang]bool{}}
+}
+
+// face 回傳 l 語言的字面；字型載入失敗回 nil（呼叫端退回 DebugPrintAt 的 ASCII 英文版，功能不受影響）。
+// 失敗只在第一次記一行標準錯誤，之後不重試也不重複記。
+func (fs *fontSet) face(l lang) font.Face {
+	if f, ok := fs.faces[l]; ok {
+		return f
+	}
+	if fs.failed[l] {
+		return nil
+	}
+	b, err := loadFontBytes(l)
+	var f font.Face
+	if err == nil {
+		f, err = newUIFace(b)
+	}
+	if err != nil {
+		fs.failed[l] = true
+		fs.logf("介面字型 %s 載入失敗，F1 與提示退回 ASCII 英文版：%v", l, err)
+		return nil
+	}
+	fs.faces[l] = f
+	return f
+}
