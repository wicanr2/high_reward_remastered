+
+// docs/spec/006 第 4、5、7 節：theme 的選取、循環、載入，以及啟動時的優先序。
+
+func TestPickThemes(t *testing.T) {
+	cases := []struct {
+		name    string
+		loaded  map[themeID]bool
+		base    themeID
+		derived []themeID
+	}{
+		{"沒有任何 HD theme", nil, "", nil},
+		{"都載入失敗", map[themeID]bool{themeHD: false, themeAI: false}, "", nil},
+		{"只有 hd", map[themeID]bool{themeHD: true}, themeHD, nil},
+		{"只有 hd-ai：它是基底（不經 CheckTheme）", map[themeID]bool{themeAI: true}, themeAI, nil},
+		{"兩個都成功：hd 優先，ai 是衍生", map[themeID]bool{themeHD: true, themeAI: true}, themeHD, []themeID{themeAI}},
+		{"hd 的 TSV 壞掉：hd-ai 成為基底", map[themeID]bool{themeHD: false, themeAI: true}, themeAI, nil},
+		{"hd 成功、ai 失敗", map[themeID]bool{themeHD: true, themeAI: false}, themeHD, nil},
+	}
+	for _, c := range cases {
+		base, derived := pickThemes(c.loaded)
+		if base != c.base || !reflect.DeepEqual(derived, c.derived) {
+			t.Errorf("%s：pickThemes ＝ (%q, %v)，應為 (%q, %v)", c.name, base, derived, c.base, c.derived)
+		}
+	}
+}
+
+func TestNextTheme(t *testing.T) {
+	all := []themeID{themeHD, themeAI}
+	cases := []struct {
+		name     string
+		cur      themeID
+		avail    []themeID
+		rejected map[themeID]bool
+		want     themeID
+		ok       bool
+	}{
+		{"original 到 hd", themeOriginal, all, nil, themeHD, true},
+		{"hd 到 ai", themeHD, all, nil, themeAI, true},
+		{"ai 回 original", themeAI, all, nil, themeOriginal, true},
+		{"只有 hd：original 到 hd", themeOriginal, []themeID{themeHD}, nil, themeHD, true},
+		{"只有 hd：hd 回 original", themeHD, []themeID{themeHD}, nil, themeOriginal, true},
+		{"只有 ai：original 到 ai", themeOriginal, []themeID{themeAI}, nil, themeAI, true},
+		{"只有 ai：ai 回 original", themeAI, []themeID{themeAI}, nil, themeOriginal, true},
+		{"只有 original：F2 不動作", themeOriginal, nil, nil, themeOriginal, false},
+		{"只有 original（avail 為空切片）", themeOriginal, []themeID{}, nil, themeOriginal, false},
+		{"被拒的 hd 被略過", themeOriginal, all, map[themeID]bool{themeHD: true}, themeAI, true},
+		{"被拒的 ai 被略過", themeHD, all, map[themeID]bool{themeAI: true}, themeOriginal, true},
+		{"全部被拒：F2 不動作", themeOriginal, all, map[themeID]bool{themeHD: true, themeAI: true}, themeOriginal, false},
+		{"目前在 hd，ai 被拒：回 original", themeHD, all, map[themeID]bool{themeAI: true}, themeOriginal, true},
+		{"目前在 hd，唯一的其他 theme 被拒，仍可回 original", themeHD, []themeID{themeHD}, map[themeID]bool{themeAI: true}, themeOriginal, true},
+		{"original 不受 rejected 影響", themeAI, all, map[themeID]bool{themeOriginal: true}, themeOriginal, true},
+		{"目前 theme 未知：從 original 開始", themeID("bogus"), all, nil, themeOriginal, true},
+		{"不在 avail 的 theme 不會被選", themeOriginal, []themeID{themeAI}, map[themeID]bool{}, themeAI, true},
+	}
+	for _, c := range cases {
+		got, ok := nextTheme(c.cur, c.avail, c.rejected)
+		if got != c.want || ok != c.ok {
+			t.Errorf("%s：nextTheme ＝ (%q, %v)，應為 (%q, %v)", c.name, got, ok, c.want, c.ok)
+		}
+	}
+	// 完整循環：original → hd → ai → original
+	cur := themeOriginal
+	for i, want := range []themeID{themeHD, themeAI, themeOriginal, themeHD} {
+		next, ok := nextTheme(cur, all, nil)
+		if !ok || next != want {
+			t.Fatalf("第 %d 次 F2 是 %q，應為 %q", i+1, next, want)
+		}
+		cur = next
+	}
+}
+
+func TestParseTheme(t *testing.T) {
+	for _, s := range []string{"original", "hd", "ai"} {
+		if id, ok := parseTheme(s); !ok || string(id) != s {
+			t.Errorf("parseTheme(%q) 應成功", s)
+		}
+	}
+	for _, s := range []string{"", "HD", "hd-ai", "Original", "neon"} {
+		if _, ok := parseTheme(s); ok {
+			t.Errorf("parseTheme(%q) 應失敗", s)
+		}
+	}
+}
+
+func hasLog(p startupPlan, sub string) bool {
+	for _, l := range p.Logs {
+		if strings.Contains(l, sub) {
+			return true
+		}
+	}
+	return false
+}
+
+func TestResolveStartup(t *testing.T) {
+	both := []themeID{themeOriginal, themeHD, themeAI}
+	hdOnly := []themeID{themeOriginal, themeHD}
+	aiOnly := []themeID{themeOriginal, themeAI}
+	none := []themeID{themeOriginal}
+	cases := []struct {
+		name    string
+		f       startupFlags
+		env     startupEnv
+		p       prefs
+		avail   []themeID
+		theme   themeID
+		lang    lang
+		muted   bool
+		hooks   bool
+		logSubs []string // 日誌必須含有（空 ＝ 不檢查）
+		noLogs  bool     // 不該有日誌
+	}{
+		{name: "全部沒給：第一個可用的 HD theme", avail: both, theme: themeHD, lang: langTW, hooks: true, noLogs: true},
+		{name: "只有 hd-ai：預設是 ai", avail: aiOnly, theme: themeAI, lang: langTW, hooks: true, noLogs: true},
+		{name: "沒有 HD：original，不開掛鉤", avail: none, theme: themeOriginal, lang: langTW, hooks: false, noLogs: true},
+		{name: "偏好設定 original 勝過預設", p: prefs{Theme: "original"}, avail: both, theme: themeOriginal, lang: langTW, hooks: true},
+		{name: "偏好設定 ai", p: prefs{Theme: "ai"}, avail: both, theme: themeAI, lang: langTW, hooks: true},
+		{name: "偏好設定 ai 但沒有 hd-ai：用預設並記一行", p: prefs{Theme: "ai"}, avail: hdOnly, theme: themeHD, lang: langTW, hooks: true, logSubs: []string{"ai", "不覆寫"}},
+		{name: "偏好設定 theme 不認得：用預設並記一行", p: prefs{Theme: "neon"}, avail: both, theme: themeHD, lang: langTW, hooks: true, logSubs: []string{"neon"}},
+		{name: "-theme original：保留掛鉤（與 -no-hd 不同）", f: startupFlags{Theme: "original", ThemeGiven: true}, avail: both, theme: themeOriginal, lang: langTW, hooks: true, noLogs: true},
+		{name: "-theme 勝過偏好設定", f: startupFlags{Theme: "original", ThemeGiven: true}, p: prefs{Theme: "ai"}, avail: both, theme: themeOriginal, lang: langTW, hooks: true},
+		{name: "-theme ai 勝過偏好設定 original", f: startupFlags{Theme: "ai", ThemeGiven: true}, p: prefs{Theme: "original"}, avail: both, theme: themeAI, lang: langTW, hooks: true},
+		{name: "-theme hd 不可用：退回下一個來源（偏好設定）並記一行", f: startupFlags{Theme: "ai", ThemeGiven: true}, p: prefs{Theme: "original"}, avail: hdOnly, theme: themeOriginal, lang: langTW, hooks: true, logSubs: []string{"-theme ai"}},
+		{name: "-theme 不可用且沒有偏好設定：預設", f: startupFlags{Theme: "ai", ThemeGiven: true}, avail: hdOnly, theme: themeHD, lang: langTW, hooks: true, logSubs: []string{"-theme ai"}},
+		{name: "-theme 未知值：退回預設，不致命", f: startupFlags{Theme: "neon", ThemeGiven: true}, avail: both, theme: themeHD, lang: langTW, hooks: true, logSubs: []string{"neon"}},
+		{name: "-theme 空字串（明確給了空值）：視為未知", f: startupFlags{Theme: "", ThemeGiven: true}, avail: both, theme: themeHD, lang: langTW, hooks: true, logSubs: []string{"-theme"}},
+		{name: "-no-hd：original，不開掛鉤", f: startupFlags{NoHD: true}, avail: both, theme: themeOriginal, lang: langTW, hooks: false, noLogs: true},
+		{name: "-no-hd 加偏好設定 hd：仍是 original", f: startupFlags{NoHD: true}, p: prefs{Theme: "hd"}, avail: both, theme: themeOriginal, lang: langTW, hooks: false, logSubs: []string{"hd"}},
+		{name: "-no-hd 加 -theme hd：hd 不可用，記一行", f: startupFlags{NoHD: true, Theme: "hd", ThemeGiven: true}, avail: both, theme: themeOriginal, lang: langTW, hooks: false, logSubs: []string{"-theme hd"}},
+		{name: "-no-hd 加 -theme original", f: startupFlags{NoHD: true, Theme: "original", ThemeGiven: true}, avail: both, theme: themeOriginal, lang: langTW, hooks: false, noLogs: true},
+		// 語言
+		{name: "-lang 勝過偏好設定", f: startupFlags{Lang: "en", LangGiven: true}, p: prefs{Lang: "ko"}, avail: none, theme: themeOriginal, lang: langEN, noLogs: true},
+		{name: "偏好設定 lang", p: prefs{Lang: "ko"}, avail: none, theme: themeOriginal, lang: langKO, noLogs: true},
+		{name: "-lang 未知值：退回偏好設定並記一行", f: startupFlags{Lang: "fr", LangGiven: true}, p: prefs{Lang: "ja"}, avail: none, theme: themeOriginal, lang: langJA, logSubs: []string{"fr"}},
+		{name: "-lang 未知值且沒有偏好設定：zh-TW", f: startupFlags{Lang: "fr", LangGiven: true}, avail: none, theme: themeOriginal, lang: langTW, logSubs: []string{"fr"}},
+		{name: "偏好設定 lang 不認得：zh-TW 並記一行", p: prefs{Lang: "xx"}, avail: none, theme: themeOriginal, lang: langTW, logSubs: []string{"xx", "不覆寫"}},
+		{name: "-lang 與 -theme 互不影響", f: startupFlags{Lang: "ja", LangGiven: true, Theme: "original", ThemeGiven: true}, p: prefs{Theme: "ai", Lang: "ko"}, avail: both, theme: themeOriginal, lang: langJA, hooks: true},
+		// 聲音（resolveMute 的 13 種組合在 sound_startup_test.go；這裡確認有接上優先序）
+		{name: "偏好設定 sound:false 靜音", p: prefs{Sound: bp(false)}, avail: none, theme: themeOriginal, lang: langTW, muted: true, noLogs: true},
+		{name: "HR_MUTE＝1 靜音", env: startupEnv{Mute: "1"}, avail: none, theme: themeOriginal, lang: langTW, muted: true},
+		{name: "HR_MUTE＝0 壓過偏好設定 sound:false", env: startupEnv{Mute: "0"}, p: prefs{Sound: bp(false)}, avail: none, theme: themeOriginal, lang: langTW, muted: false},
