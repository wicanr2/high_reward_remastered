+// 游標換算恆為 x/2、y/2（再限制在遊戲區內），不隨 theme 狀態改變。
+func TestCursorAlwaysHalf(t *testing.T) {
+	cases := []struct{ x, y, wx, wy int }{
+		{0, 0, 0, 0},
+		{1, 1, 0, 0},
+		{2, 2, 1, 1},
+		{101, 75, 50, 37},
+		{640, 400, 320, 200},
+		{1278, 798, 639, 399},
+		{1279, 799, 639, 399},
+		{2000, 1500, 639, 399}, // 超出邏輯畫面：限制在遊戲區內
+		{-5, -3, 0, 0},
+	}
+	for _, st := range []struct {
+		name  string
+		start themeID
+	}{{"original", themeOriginal}, {"HD", themeHD}} {
+		for _, c := range cases {
+			gr := newGameRig(t, st.start, []themeID{themeHD})
+			gr.prime()
+			gr.fe.cx, gr.fe.cy = c.x, c.y
+			gr.mustFrame()
+			want := []hrrt.Event{hrrt.MouseMoveEvent(c.wx, c.wy)}
+			if got := gr.ss.take(); !reflect.DeepEqual(got, want) {
+				t.Errorf("%s：游標 (%d, %d)：事件 %+v，應為 %+v", st.name, c.x, c.y, got, want)
+			}
+		}
+	}
+	if x, y := cursorToGame(101, 75); x != 50 || y != 37 {
+		t.Errorf("cursorToGame(101, 75) ＝ (%d, %d)", x, y)
+	}
+	// 切換進行中（applying）也一樣
+	gr := newGameRig(t, themeOriginal, []themeID{themeHD})
+	gr.prime()
+	gr.mustFrame(ebiten.KeyF2)
+	gr.settle(stApplying)
+	gr.fe.cx, gr.fe.cy = 301, 201
+	gr.mustFrame()
+	if got := gr.ss.take(); !reflect.DeepEqual(got, []hrrt.Event{hrrt.MouseMoveEvent(150, 100)}) {
+		t.Errorf("applying 中：%+v", got)
+	}
+}
