diff --git a/apps/hr/play/overlay.go b/apps/hr/play/overlay.go
new file mode 100644
index 0000000..509cd2d
--- /dev/null
+++ b/apps/hr/play/overlay.go
@@ -0,0 +1,286 @@
+package main
+
+import (
+	"image"
+	"image/color"
+	"slices"
+	"time"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	"github.com/hajimehoshi/ebiten/v2/ebitenutil"
+	"github.com/hajimehoshi/ebiten/v2/text"
+	"golang.org/x/image/font"
+)
+
+// 疊加層（docs/spec/006 第 3 節）：邏輯畫面固定 1280x800，三個疊加層各占固定矩形，互不相交。
+//
+//	F1 面板    左上，y 16 至 688（21 行）          開著才畫
+//	停機提示   左下，y 688 至 752（2 行）          停機後一直顯示，不論 F1
+//	toast      左下最後一行，y 752 至 784（1 行）  同一時間只有一則（載入進度與使用者提示由 toaster 決定先後）
+//
+// 繪製與測試都讀同一組常數。
+
+const (
+	logicalW, logicalH = gameW * 2, gameH * 2 // 邏輯畫面：遊戲區 640x400 的 2 倍，不隨 theme 改變
+	hudMargin          = 16
+	hudW               = logicalW - 2*hudMargin // 1248：每行文字的寬度預算
+	lineStep           = 32                     // 固定行距（em 22 的自然行高是 31.86，取 32 讓基線整齊）
+
+	panelRows = 21
+	stopRows  = 2
+	toastRows = 1
+
+	panelY = hudMargin
+	panelH = panelRows * lineStep
+	stopY  = panelY + panelH
+	stopH  = stopRows * lineStep
+	toastY = stopY + stopH
+	toastH = toastRows * lineStep
+)
+
+// layerKind 是疊加層的種類。
+type layerKind int
+
+const (
+	layerPanel layerKind = iota
+	layerStop
+	layerToast
+)
+
+func (k layerKind) String() string {
+	switch k {
+	case layerPanel:
+		return "panel"
+	case layerStop:
+		return "stop"
+	case layerToast:
+		return "toast"
+	}
+	return "?"
+}
+
+// rect 是疊加層占用的矩形（邏輯畫面座標）。
+func (k layerKind) rect() image.Rectangle {
+	switch k {
+	case layerPanel:
+		return image.Rect(hudMargin, panelY, hudMargin+hudW, panelY+panelH)
+	case layerStop:
+		return image.Rect(hudMargin, stopY, hudMargin+hudW, stopY+stopH)
+	default:
+		return image.Rect(hudMargin, toastY, hudMargin+hudW, toastY+toastH)
+	}
+}
+
+// overlayLayers 決定這一幀要畫哪些疊加層（依繪製順序）：F1 面板只在開著時畫；停機提示停機後一直畫，不論 F1；
+// toast 有內容才畫，且測試模式（HR_TEST_FREEZE_UI）不畫 toast 與載入進度。
+func overlayLayers(help, stopped, hasToast, freeze bool) []layerKind {
+	var out []layerKind
+	if help {
+		out = append(out, layerPanel)
+	}
+	if stopped {
+		out = append(out, layerStop)
+	}
+	if hasToast && !freeze {
+		out = append(out, layerToast)
+	}
+	return out
+}
+
+// hudText 是一個語言下的疊加層文字：face 為 nil 表示字型載入失敗，退回 ASCII 英文版（DebugPrintAt）。
+type hudText struct {
+	l    lang
+	face font.Face
+}
+
+func newHudText(fs *fontSet, l lang) hudText { return hudText{l: l, face: fs.face(l)} }
+
+func (h hudText) ascii() bool { return h.face == nil }
+
+// t 查字串表：正常用 l 語言，退回版用英文且只含 ASCII。
+func (h hudText) t(key string, args ...any) string {
+	if h.ascii() {
+		return trASCII(key, args...)
+	}
+	return tr(h.l, key, args...)
+}
+
+// fit 對單行套用超長處理（寬度預算 hudW）。
+func (h hudText) fit(s string) string {
+	if h.ascii() {
+		return fitASCII(s, hudW/debugCharW)
+	}
+	return fitLine(h.face, s, hudW)
+}
+
+// panel 是 F1 面板的 21 行。
+func (h hudText) panel(info panelInfo) []string {
+	if h.ascii() {
+		return panelLinesASCII(h.l, info)
+	}
+	return panelLines(h.l, h.face, info)
+}
+
+// stop 是停機提示：第一行停機原因，第二行現場存檔目錄（有才有）。路徑可能很長，同樣套用超長處理。
+func (h hudText) stop(kind, dumpDir string) []string {
+	out := []string{h.fit(h.t("stop.msg", kind))}
+	if dumpDir != "" {
+		out = append(out, h.fit(h.t("stop.dump", dumpDir)))
+	}
+	return out
+}
+
+// toast 是 now 這一刻 toast 行的文字（toaster 已決定使用者提示與載入進度的先後）。
+func (h hudText) toast(tt *toaster, now time.Time) (string, bool) {
+	l := h.l
+	if h.ascii() {
+		l = langEN
+	}
+	s, ok := tt.Current(now, l)
+	if !ok {
+		return "", false
+	}
+	return h.fit(s), true
+}
+
+// layerGate 決定一層快取影像要不要重畫：內容（行）沒變就不重畫；minGap 大於 0 時內容變了也至多每 minGap 重畫一次
+// （統計層每秒一次）；key（語言、字面種類、測試模式）變了一律立刻重畫。
+type layerGate struct {
+	minGap time.Duration
+
+	key   string
+	lines []string
+	at    time.Time
+	drawn bool
+	draws int // 累計重畫次數（測試用）
+}
+
+func (g *layerGate) update(key string, lines []string, now time.Time) bool {
+	if g.drawn && g.key == key {
+		if slices.Equal(g.lines, lines) {
+			return false
+		}
+		if g.minGap > 0 && now.Sub(g.at) < g.minGap {
+			return false
+		}
+	}
+	g.key, g.lines, g.at, g.drawn = key, slices.Clone(lines), now, true
+	g.draws++
+	return true
+}
+
+// ---- 繪製（需要 GPU，單元測試不碰；端對端 tools/play.sh gui-lang 與 gui-theme 驗收） ----
+
+var (
+	hudFG         = color.NRGBA{0xF2, 0xF2, 0xF2, 0xFF}
+	panelBGColor  = color.NRGBA{0x0C, 0x10, 0x1C, 0xD2} // 半透明
+	panelBGFrozen = color.NRGBA{0x0C, 0x10, 0x1C, 0xFF} // 測試模式：不透明
+	stopBGColor   = color.NRGBA{0x60, 0x00, 0x00, 0xE0}
+	toastBGColor  = color.NRGBA{0x00, 0x00, 0x00, 0xB4}
+)
+
+// panelBG 是面板底色：半透明；HR_TEST_FREEZE_UI＝1 時不透明。
+func panelBG(freeze bool) color.NRGBA {
+	if freeze {
+		return panelBGFrozen
+	}
+	return panelBGColor
+}
+
+// drawRow 在 dst 畫第 i 行：每行各自呼叫 text.Draw，基線由 lineBaseline 算；face 為 nil 時用 DebugPrintAt。
+func drawRow(dst *ebiten.Image, face font.Face, s string, x, top, i int) {
+	if face != nil {
+		text.Draw(dst, s, face, x, lineBaseline(face, top, i), hudFG)
+		return
+	}
+	ebitenutil.DebugPrintAt(dst, s, x, top+lineStep*i+(lineStep-16)/2)
+}
+
+// hudRenderer 持有疊加層的快取影像（惰性建立：第一次 Draw 才碰 GPU）。
+type hudRenderer struct {
+	static, stats   *ebiten.Image // 面板：靜態層（底色加標題、按鍵表、狀態、診斷、提示）與統計層
+	stopBG, toastBG *ebiten.Image
+	gStatic         layerGate
+	gStats          layerGate
+}
+
+func newHudRenderer() *hudRenderer {
+	return &hudRenderer{gStats: layerGate{minGap: time.Second}}
+}
+
+func filled(w, h int, c color.Color) *ebiten.Image {
+	img := ebiten.NewImage(w, h)
+	img.Fill(c)
+	return img
+}
+
+// drawPanel 畫 F1 面板。靜態部分只在內容變化（F1 開關後的第一幀、語言、theme、聲音狀態、診斷）時重畫到快取影像；
+// 統計三行另一層，至多每秒重畫一次。
+func (r *hudRenderer) drawPanel(screen *ebiten.Image, now time.Time, ht hudText, lines []string, freeze bool) {
+	pr := layerPanel.rect()
+	if r.static == nil {
+		r.static = ebiten.NewImage(pr.Dx(), pr.Dy())
+		r.stats = ebiten.NewImage(pr.Dx(), rowStatsN*lineStep)
+	}
+	key := string(ht.l)
+	if ht.ascii() {
+		key += "|ascii"
+	}
+	if freeze {
+		key += "|freeze"
+	}
+	var statLines, fixedLines []string
+	for i, s := range lines {
+		if isStatsRow(i) {
+			statLines = append(statLines, s)
+		} else {
+			fixedLines = append(fixedLines, s)
+		}
+	}
+	if r.gStatic.update(key, fixedLines, now) {
+		r.static.Fill(panelBG(freeze))
+		for i, s := range lines {
+			if !isStatsRow(i) {
+				drawRow(r.static, ht.face, s, 0, 0, i)
+			}
+		}
+	}
+	if r.gStats.update(key, statLines, now) {
+		r.stats.Clear()
+		for j, s := range statLines {
+			drawRow(r.stats, ht.face, s, 0, 0, j)
+		}
+	}
+	op := &ebiten.DrawImageOptions{}
+	op.GeoM.Translate(float64(pr.Min.X), float64(pr.Min.Y))
+	screen.DrawImage(r.static, op)
+	op = &ebiten.DrawImageOptions{}
+	op.GeoM.Translate(float64(pr.Min.X), float64(pr.Min.Y+rowStats*lineStep))
+	screen.DrawImage(r.stats, op)
+}
+
+// drawStop 畫停機提示（左下 2 行）。
+func (r *hudRenderer) drawStop(screen *ebiten.Image, ht hudText, lines []string) {
+	sr := layerStop.rect()
+	if r.stopBG == nil {
+		r.stopBG = filled(sr.Dx(), sr.Dy(), stopBGColor)
+	}
+	op := &ebiten.DrawImageOptions{}
+	op.GeoM.Translate(float64(sr.Min.X), float64(sr.Min.Y))
+	screen.DrawImage(r.stopBG, op)
+	for i, s := range lines {
+		drawRow(screen, ht.face, s, sr.Min.X, sr.Min.Y, i)
+	}
+}
+
+// drawToast 畫 toast 行（左下最後一行）。
+func (r *hudRenderer) drawToast(screen *ebiten.Image, ht hudText, s string) {
+	rc := layerToast.rect()
+	if r.toastBG == nil {
+		r.toastBG = filled(rc.Dx(), rc.Dy(), toastBGColor)
+	}
+	op := &ebiten.DrawImageOptions{}
+	op.GeoM.Translate(float64(rc.Min.X), float64(rc.Min.Y))
+	screen.DrawImage(r.toastBG, op)
+	drawRow(screen, ht.face, s, rc.Min.X, rc.Min.Y, 0)
+}
diff --git a/apps/hr/play/overlay_test.go b/apps/hr/play/overlay_test.go
new file mode 100644
index 0000000..7b0ac5d
--- /dev/null
+++ b/apps/hr/play/overlay_test.go
@@ -0,0 +1,363 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"image"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+// docs/spec/006 第 3 節的疊加層、第 10 節的字型載入失敗退回與快取層。
+
+// 三個疊加層的矩形：以字面數字寫出規格的位置（y 16 至 688、688 至 752、752 至 784），不讀被測的常數推導預期值。
+func TestOverlayRectsDisjoint(t *testing.T) {
+	want := map[layerKind]image.Rectangle{
+		layerPanel: image.Rect(16, 16, 1264, 688),
+		layerStop:  image.Rect(16, 688, 1264, 752),
+		layerToast: image.Rect(16, 752, 1264, 784),
+	}
+	kinds := []layerKind{layerPanel, layerStop, layerToast}
+	for _, k := range kinds {
+		if got := k.rect(); got != want[k] {
+			t.Errorf("%v 的矩形 ＝ %v，規格是 %v", k, got, want[k])
+		}
+	}
+	for i, a := range kinds {
+		for _, b := range kinds[i+1:] {
+			if r := a.rect().Intersect(b.rect()); !r.Empty() {
+				t.Errorf("%v 與 %v 的矩形相交：%v", a, b, r)
+			}
+		}
+	}
+	// 都在邏輯畫面（1280x800）扣掉 16 像素邊距的範圍內
+	inner := image.Rect(0, 0, 1280, 800).Inset(16)
+	for _, k := range kinds {
+		if !k.rect().In(inner) {
+			t.Errorf("%v 的矩形 %v 超出 %v", k, k.rect(), inner)
+		}
+	}
+	// 高度 ＝ 行數 × 行距
+	for k, rows := range map[layerKind]int{layerPanel: 21, layerStop: 2, layerToast: 1} {
+		if h := k.rect().Dy(); h != rows*32 {
+			t.Errorf("%v 高 %d，應為 %d 行 × 32", k, h, rows)
+		}
+	}
+	// 實際繪製用的列數與矩形一致（繪製與測試讀同一組常數）
+	if panelRows != 21 || stopRows != 2 || toastRows != 1 {
+		t.Errorf("列數常數 ＝ %d、%d、%d", panelRows, stopRows, toastRows)
+	}
+}
+
+// 每一幀要畫哪些層：16 種組合逐列寫出。停機提示停機後一直顯示，不論 F1；測試模式不畫 toast 與載入進度。
+func TestOverlayLayersTable(t *testing.T) {
+	P, S, T := layerPanel, layerStop, layerToast
+	cases := []struct {
+		help, stopped, toast, freeze bool
+		want                         []layerKind
+	}{
+		{false, false, false, false, nil},
+		{true, false, false, false, []layerKind{P}},
+		{false, true, false, false, []layerKind{S}},
+		{true, true, false, false, []layerKind{P, S}}, // 停機提示不論 F1
+		{false, false, true, false, []layerKind{T}},
+		{true, false, true, false, []layerKind{P, T}},
+		{false, true, true, false, []layerKind{S, T}},
+		{true, true, true, false, []layerKind{P, S, T}},
+		{false, false, false, true, nil},
+		{true, false, false, true, []layerKind{P}},
+		{false, true, false, true, []layerKind{S}},
+		{true, true, false, true, []layerKind{P, S}},
+		{false, false, true, true, nil}, // 測試模式：toast 不繪製
+		{true, false, true, true, []layerKind{P}},
+		{false, true, true, true, []layerKind{S}},
+		{true, true, true, true, []layerKind{P, S}},
+	}
+	for _, c := range cases {
+		got := overlayLayers(c.help, c.stopped, c.toast, c.freeze)
+		if len(got) == 0 && len(c.want) == 0 {
+			continue
+		}
+		if !reflect.DeepEqual(got, c.want) {
+			t.Errorf("help＝%v stopped＝%v toast＝%v freeze＝%v：%v，應為 %v", c.help, c.stopped, c.toast, c.freeze, got, c.want)
+		}
+	}
+}
+
+// 使用者提示壓過載入進度 2 秒，之後進度恢復；新的使用者提示取代舊的；進度結束後什麼都不顯示。
+// 經 hudText.toast（疊加層實際用的路徑），文字依目前語言。
+func TestOverlayToastPriority(t *testing.T) {
+	ht := hudText{l: langEN, face: mustFace(t, langEN)}
+	t0 := time.Date(2026, 10, 4, 12, 0, 0, 0, time.UTC)
+	tt := &toaster{}
+	progress := "Loading theme: HD  10%"
+
+	tt.SetProgress(themeHD, 10, 100)
+	if s, ok := ht.toast(tt, t0); !ok || s != progress {
+		t.Fatalf("只有進度：%q %v", s, ok)
+	}
+	tt.Show(t0, "toast.sound.on")
+	for _, c := range []struct {
+		dt   time.Duration
+		want string
+	}{
+		{0, "Sound: on"},
+		{time.Second, "Sound: on"},
+		{2*time.Second - time.Millisecond, "Sound: on"},
+		{2 * time.Second, progress}, // 剛好 2 秒：使用者提示結束，進度恢復
+		{5 * time.Second, progress},
+	} {
+		if s, ok := ht.toast(tt, t0.Add(c.dt)); !ok || s != c.want {
+			t.Errorf("t＋%v：%q %v，應為 %q", c.dt, s, ok, c.want)
+		}
+	}
+	// 新的取代舊的
+	tt.Show(t0.Add(10*time.Second), "toast.sound.off")
+	tt.Show(t0.Add(10*time.Second+500*time.Millisecond), "toast.sound.on")
+	if s, _ := ht.toast(tt, t0.Add(11*time.Second)); s != "Sound: on" {
+		t.Errorf("新的提示應取代舊的：%q", s)
+	}
+	// 載入結束後，使用者提示過期就什麼都沒有
+	tt.ClearProgress()
+	if s, ok := ht.toast(tt, t0.Add(20*time.Second)); ok || s != "" {
+		t.Errorf("進度結束且提示過期：%q %v", s, ok)
+	}
+	// 載入期間切換語言：進度改用新語言
+	tt.SetProgress(themeHD, 50, 100)
+	if s, _ := (hudText{l: langTW, face: mustFace(t, langTW)}).toast(tt, t0.Add(30*time.Second)); s != "載入 theme：HD　50%" {
+		t.Errorf("進度的語言：%q", s)
+	}
+}
+
+// 字型載入失敗（注入壞字型）退回 ASCII：F1 面板、停機提示、toast 都能用，標準錯誤各記一行，功能不依賴字型。
+func TestFontLoadFailureFallsBackToASCII(t *testing.T) {
+	var loads int
+	old := loadFontBytes
+	t.Cleanup(func() { loadFontBytes = old })
+	loadFontBytes = func(l lang) ([]byte, error) {
+		loads++
+		if l == langJA {
+			return []byte("this is not a font"), nil // 能讀到檔，但不是字型
+		}
+		if l == langKO {
+			return nil, errors.New("檔案不存在") // 讀不到
+		}
+		return old(l)
+	}
+	var log lineLog
+	fs := newFontSet(log.logf)
+
+	// 失敗的語言：face 為 nil；重複查詢不重試也不重複記
+	for i := 0; i < 5; i++ {
+		if fs.face(langJA) != nil || fs.face(langKO) != nil {
+			t.Fatal("壞字型應回 nil")
+		}
+	}
+	if n := len(log.all()); n != 2 {
+		t.Errorf("兩個語言各記一行，實際 %d 行：%v", n, log.all())
+	}
+	if !log.has("ja") || !log.has("ko") || !log.has("ASCII") {
+		t.Errorf("日誌應指出語言與退回 ASCII：%v", log.all())
+	}
+	if loads != 2 {
+		t.Errorf("壞字型只應各載入一次，實際 %d 次", loads)
+	}
+	// 其他語言不受影響，面孔長期保留（同一個指標）
+	zh := fs.face(langTW)
+	if zh == nil || fs.face(langTW) != zh {
+		t.Error("正常語言應載入成功且長期保留同一個字面")
+	}
+
+	// 退回版的面板：21 行、全是可印出的 ASCII、英文、介面語言顯示代號
+	info := normalInfo()
+	ht := newHudText(fs, langJA)
+	if !ht.ascii() {
+		t.Fatal("ja 應退回 ASCII")
+	}
+	lines := ht.panel(info)
+	if len(lines) != panelRows {
+		t.Fatalf("退回版 %d 行，應為 %d", len(lines), panelRows)
+	}
+	for i, s := range lines {
+		for _, r := range s {
+			if r < 0x20 || r > 0x7E {
+				t.Errorf("退回版第 %d 行含非 ASCII 字元 %q：%q", i, r, s)
+			}
+		}
+		if len(s) > hudW/debugCharW {
+			t.Errorf("退回版第 %d 行 %d 個字元，超過 %d", i, len(s), hudW/debugCharW)
+		}
+	}
+	wantAt := map[int]string{
+		rowTitle:      "High Reward (?????)  hr-play v0.1.1-hd",
+		rowKeys:       "F1  Help (toggle)",
+		rowKeys + 3:   "F4  Switch interface language",
+		rowStatus:     "Theme: HD (available: Original, HD, AI redraw)",
+		rowStatus + 1: "Interface language: ja",
+		rowStatus + 3: "Sound: on",
+	}
+	for i, w := range wantAt {
+		if lines[i] != w {
+			t.Errorf("退回版第 %d 行：%q，應為 %q", i, lines[i], w)
+		}
+	}
+	// 極端輸入也不超過寬度、不含換行
+	for name, ex := range extremeInfos() {
+		for i, s := range ht.panel(ex) {
+			if len(s) > hudW/debugCharW || strings.ContainsAny(s, "\n\r\t") {
+				t.Errorf("退回版 %s 第 %d 行：長 %d、%q", name, i, len(s), shorten(s))
+			}
+		}
+	}
+	// 停機提示與 toast 也退回
+	stop := ht.stop("stack overflow", "/crash/20261004")
+	if len(stop) != 2 || stop[0] != "Stopped: stack overflow (see the log). Please close the window." || stop[1] != "Crash dump: /crash/20261004" {
+		t.Errorf("退回版停機提示：%q", stop)
+	}
+	now := time.Date(2026, 10, 4, 12, 0, 0, 0, time.UTC)
+	tt := &toaster{}
+	tt.ShowRaw(now, "日本語") // F4 的提示（目標語言自己的名稱）在退回版只剩 ?
+	if s, ok := ht.toast(tt, now); !ok || s != "???" {
+		t.Errorf("退回版 toast：%q %v", s, ok)
+	}
+	tt.Show(now, "toast.sound.off")
+	if s, _ := ht.toast(tt, now); s != "Sound: off" {
+		t.Errorf("退回版 toast（英文）：%q", s)
+	}
+
+	// 正常語言仍用內嵌字型畫自己的語言
+	htTW := newHudText(fs, langTW)
+	if htTW.ascii() || htTW.panel(info)[rowKeys] != "F1　功能說明（開關）" {
+		t.Errorf("zh-TW 不該受 ja 的失敗影響：%q", htTW.panel(info)[rowKeys])
+	}
+}
+
+// 每個語言一個字面、長期保留：載入函式對每個語言只被呼叫一次，切換語言再回來是同一個字面。
+func TestFontSetKeepsOneFacePerLanguage(t *testing.T) {
+	counts := map[lang]int{}
+	old := loadFontBytes
+	t.Cleanup(func() { loadFontBytes = old })
+	loadFontBytes = func(l lang) ([]byte, error) { counts[l]++; return old(l) }
+	fs := newFontSet(nil)
+	first := map[lang]any{}
+	for round := 0; round < 3; round++ {
+		for _, l := range langOrder {
+			f := fs.face(l)
+			if f == nil {
+				t.Fatalf("%s：字型載入失敗", l)
+			}
+			if round == 0 {
+				first[l] = f
+			} else if first[l] != any(f) {
+				t.Errorf("%s：第 %d 輪不是同一個字面", l, round)
+			}
+		}
+	}
+	for _, l := range langOrder {
+		if counts[l] != 1 {
+			t.Errorf("%s：載入 %d 次，應為 1", l, counts[l])
+		}
+	}
+	for i, a := range langOrder {
+		for _, b := range langOrder[i+1:] {
+			if first[a] == first[b] {
+				t.Errorf("%s 與 %s 共用同一個字面", a, b)
+			}
+		}
+	}
+}
+
+// 內嵌的字型與授權檔：與 fonts/ 目錄的檔案位元組相同；OFL 全文在內、沒有 GPL；來源記錄在內。
+func TestEmbeddedFontsAndLicense(t *testing.T) {
+	for _, l := range allLangs {
+		got, err := loadFontBytes(lang(l))
+		if err != nil {
+			t.Fatalf("%s：%v", l, err)
+		}
+		if want := readFont(t, l); !bytes.Equal(got, want) {
+			t.Errorf("%s：內嵌的字型與 fonts/ui-%s.otf 不同（%d 與 %d bytes）", l, l, len(got), len(want))
+		}
+		if _, err := newUIFace(got); err != nil {
+			t.Errorf("%s：%v", l, err)
+		}
+	}
+	ofl, err := uiFontFS.ReadFile("fonts/OFL.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	disk, _ := os.ReadFile(filepath.Join("fonts", "OFL.txt"))
+	if !bytes.Equal(ofl, disk) {
+		t.Error("內嵌的 OFL.txt 與磁碟上的不同")
+	}
+	if !bytes.Contains(ofl, []byte("SIL OPEN FONT LICENSE Version 1.1")) || !bytes.Contains(ofl, []byte("Adobe")) {
+		t.Error("OFL.txt 應含 OFL 1.1 全文與 Adobe 版權聲明")
+	}
+	if bytes.Contains(ofl, []byte("GNU General Public License")) {
+		t.Error("OFL.txt 不該含 GPL 文字")
+	}
+	if src, err := uiFontFS.ReadFile("fonts/SOURCE.txt"); err != nil || !bytes.Contains(src, []byte("fontTools")) {
+		t.Errorf("內嵌的 SOURCE.txt：%v", err)
+	}
+}
+
+// 快取層的重畫判斷：靜態層內容沒變不重畫；統計層至多每秒一次；語言（key）變了立刻重畫。
+func TestLayerGate(t *testing.T) {
+	t0 := time.Date(2026, 10, 4, 12, 0, 0, 0, time.UTC)
+	a, b := []string{"x", "y"}, []string{"x", "z"}
+
+	var st layerGate
+	if !st.update("zh-TW", a, t0) {
+		t.Error("第一次一定要畫")
+	}
+	if st.update("zh-TW", a, t0.Add(time.Hour)) {
+		t.Error("內容沒變不該重畫")
+	}
+	if !st.update("zh-TW", b, t0.Add(time.Hour)) {
+		t.Error("內容變了要重畫")
+	}
+	if !st.update("en", b, t0.Add(time.Hour)) {
+		t.Error("語言變了要重畫")
+	}
+	if st.draws != 3 {
+		t.Errorf("重畫 %d 次，應為 3", st.draws)
+	}
+
+	// 統計層：每個 60 Hz 的幀內容都不同，3 秒內至多重畫在 0、1、2 秒三次
+	gs := layerGate{minGap: time.Second}
+	for k := 0; k < 180; k++ {
+		gs.update("zh-TW", []string{string(rune('a' + k%26)), string(rune('a' + k/26))}, t0.Add(time.Duration(k)*time.Second/60))
+	}
+	if gs.draws != 3 {
+		t.Errorf("統計層 3 秒內重畫 %d 次，應為 3", gs.draws)
+	}
+	// 間隔內語言改變：立刻重畫（否則新語言的標籤要等一秒）
+	gs2 := layerGate{minGap: time.Second}
+	gs2.update("zh-TW", a, t0)
+	if gs2.update("zh-TW", b, t0.Add(100*time.Millisecond)) {
+		t.Error("間隔內內容變了不該重畫")
+	}
+	if !gs2.update("ja", b, t0.Add(200*time.Millisecond)) {
+		t.Error("間隔內語言變了要立刻重畫")
+	}
+	// 沒畫成功的內容不算已畫：間隔過後仍會畫出最新內容
+	gs3 := layerGate{minGap: time.Second}
+	gs3.update("k", a, t0)
+	gs3.update("k", b, t0.Add(500*time.Millisecond)) // 被間隔擋下
+	if !gs3.update("k", b, t0.Add(time.Second)) {
+		t.Error("間隔過後應畫出被擋下的新內容")
+	}
+}
+
+// 面板底色：半透明；測試模式不透明。
+func TestPanelBackground(t *testing.T) {
+	if a := panelBG(false).A; a == 0 || a == 255 {
+		t.Errorf("一般模式的面板底色應為半透明，alpha ＝ %d", a)
+	}
+	if a := panelBG(true).A; a != 255 {
+		t.Errorf("測試模式的面板底色應不透明，alpha ＝ %d", a)
+	}
+}
