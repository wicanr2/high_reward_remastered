+		"全是缺字":     mk(strings.Repeat("龘", 600)),
+		"控制字元":     mk("/tmp/a\nb\tc\rd/" + strings.Repeat("x", 800)),
+		"結尾空白":     mk("/p" + strings.Repeat("　", 150) + strings.Repeat(" ", 250)),
+		"空路徑":      mk(""),
+		"極長診斷名":    func() panelInfo { i := normalInfo(); i.Diag = strings.Repeat("20261004-", 150); return i }(),
+		"極長版本字串":   func() panelInfo { i := normalInfo(); i.Version = strings.Repeat("v", 400); return i }(),
