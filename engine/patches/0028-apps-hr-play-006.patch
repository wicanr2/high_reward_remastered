+		}
+		titles = append(titles, tr(l, "app.title", version))
+		commits = append(commits, fmt.Sprintf("{lang=%s}", l))
+		ht := newHudText(gr.g.fonts, gr.g.lang)
+		if s, ok := ht.toast(gr.sw.Toast(), gr.clk.Now()); !ok || s != langNames[l] {
+			t.Errorf("F4 第 %d 次：toast ＝ %q %v，應為 %q", i+1, s, ok, langNames[l])
+		}
+		if ht.ascii() || ht.l != l {
+			t.Errorf("F4 第 %d 次：提示應用 %s 的字面", i+1, l)
+		}
+	}
+	if !reflect.DeepEqual(gr.fe.titles, titles) {
+		t.Errorf("視窗標題 ＝ %q，應為 %q", gr.fe.titles, titles)
+	}
+	if !reflect.DeepEqual(gr.commitList(), commits) {
