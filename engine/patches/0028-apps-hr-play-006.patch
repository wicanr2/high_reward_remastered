+
+	// F4：語言依序循環，視窗標題與偏好補丁同步，提示用目標語言自己的名稱與字面
+	var titles, commits []string
+	wantLangs := []lang{langCN, langKO, langEN, langJA, langTW}
+	for i, l := range wantLangs {
+		gr.mustFrame(ebiten.KeyF4)
+		if gr.g.lang != l {
