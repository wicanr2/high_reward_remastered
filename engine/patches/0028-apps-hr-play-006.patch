+// HR_TEST_FREEZE_UI：統計欄位固定為常數（也不去問 Session）；一般模式取自 Session。
+func TestPanelInfoFreezeAndNormal(t *testing.T) {
+	gr := newGameRig(t, themeHD, []themeID{themeHD}, withFreeze(), withSound())
+	gr.ss.stats = hrrt.Stats{Steps: 5, Ticks: 6}
+	info := gr.g.panelInfo()
+	if info.Stats != frozenStats || gr.ss.statsCalls != 0 {
+		t.Errorf("測試模式：統計 %+v、Stats() 呼叫 %d 次", info.Stats, gr.ss.statsCalls)
+	}
+	if info.Theme != themeHD || !reflect.DeepEqual(info.Usable, []themeID{themeOriginal, themeHD}) || info.Sound != soundOn {
+		t.Errorf("panelInfo：%+v", info)
+	}
+	if info.DataDir != gr.dir || info.SaveDir != filepath.Join(gr.dir, "saves") || info.ShotsDir != filepath.Join(gr.dir, "screenshots") {
+		t.Errorf("路徑：%+v", info)
+	}
+
+	gr2 := newGameRig(t, themeOriginal, nil)
+	gr2.ss.stats = hrrt.Stats{Steps: 5, Ticks: 6, Interval: 77, Lowered: true, MinSP: 0x1234, StackTop: 0x4321}
+	info = gr2.g.panelInfo()
+	if info.Stats.Steps != 5 || info.Stats.Ticks != 6 || info.Stats.Interval != 77 || !info.Stats.Lowered || info.Stats.MinSP != 0x1234 || info.Stats.StackTop != 0x4321 || gr2.ss.statsCalls != 1 {
+		t.Errorf("一般模式：%+v、Stats() 呼叫 %d 次", info.Stats, gr2.ss.statsCalls)
+	}
+	if info.Sound != soundNA {
+		t.Errorf("沒有聲音引擎應為 soundNA：%v", info.Sound)
+	}
+}
