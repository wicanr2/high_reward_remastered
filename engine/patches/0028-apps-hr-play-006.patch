+// docs/spec/006 第 6 節：五種語言的鍵齊全、非空，格式動詞的順序與個數一致。
+func TestI18NTablesComplete(t *testing.T) {
+	var keys []string
+	for k := range trTable[langTW] {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	if len(keys) < 30 {
+		t.Fatalf("繁體中文只有 %d 個鍵", len(keys))
+	}
+	verbs := regexp.MustCompile(`%[-+# 0-9.]*[a-zA-Z]`)
+	for _, l := range langOrder {
+		tab := trTable[l]
+		if len(tab) != len(keys) {
+			t.Errorf("%s 有 %d 個鍵，繁體中文有 %d 個", l, len(tab), len(keys))
+		}
+		for _, k := range keys {
+			s, ok := tab[k]
+			if !ok || strings.TrimSpace(s) == "" {
+				t.Errorf("%s 缺鍵或為空：%s", l, k)
+				continue
+			}
+			want := strings.Join(verbs.FindAllString(trTable[langTW][k], -1), ",")
+			got := strings.Join(verbs.FindAllString(s, -1), ",")
+			if want != got {
+				t.Errorf("%s 的 %s 格式動詞 %q，繁體中文是 %q", l, k, got, want)
+			}
+		}
+	}
+	for _, l := range langOrder {
+		if langNames[l] == "" {
+			t.Errorf("缺 %s 的語言名稱", l)
+		}
+	}
+}
+
+func TestLangCycleAndParse(t *testing.T) {
+	want := []lang{langCN, langKO, langEN, langJA, langTW}
+	l := langTW
+	for i, w := range want {
+		l = nextLang(l)
+		if l != w {
+			t.Fatalf("F4 第 %d 次是 %s，應為 %s", i+1, l, w)
+		}
+	}
+	for _, s := range []string{"zh-TW", "zh-CN", "ko", "en", "ja"} {
+		if _, ok := parseLang(s); !ok {
+			t.Errorf("parseLang(%q) 應成功", s)
+		}
+	}
+	for _, s := range []string{"", "zh", "EN", "fr", "zh-tw"} {
+		if _, ok := parseLang(s); ok {
+			t.Errorf("parseLang(%q) 應失敗", s)
+		}
+	}
+	if nextLang("bogus") != langTW {
