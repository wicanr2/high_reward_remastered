diff --git a/apps/hr/play/fonts_gen_test.go b/apps/hr/play/fonts_gen_test.go
new file mode 100644
index 0000000..79ef3e1
--- /dev/null
+++ b/apps/hr/play/fonts_gen_test.go
@@ -0,0 +1,55 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// charsetOf 回傳 l 語言的 UI 字元表：該語言全部字串的字元，加 ASCII 可印字元、省略號與問號
+// （動態字串的缺字退回字元，docs/spec/006 第 3 節）。排序、去重、不含控制字元。
+func charsetOf(l lang) []rune {
+	set := map[rune]bool{'…': true, '?': true}
+	for r := rune(0x20); r <= 0x7E; r++ {
+		set[r] = true
+	}
+	for _, s := range trTable[l] {
+		for _, r := range s {
+			if r >= 0x20 && r != 0x7F {
+				set[r] = true
+			}
+		}
+	}
+	// 目標語言自己的名稱（F4 提示用目標語言的字面）已在 trTable 外，另加
+	for _, r := range langNames[l] {
+		set[r] = true
+	}
+	out := make([]rune, 0, len(set))
+	for r := range set {
+		out = append(out, r)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i] < out[j] })
+	return out
+}
+
+// HR_GEN_CHARSET=<目錄> 時，把五份字元表寫成 <目錄>/charset-<語言>.txt（tools/gen_ui_fonts.sh 呼叫）。
+// 字元表入版控，pyftsubset 讀它；不從 Go 原始碼用正規式抓字串（跳脫字元與格式動詞容易漏）。
+func TestGenCharsets(t *testing.T) {
+	dir := os.Getenv("HR_GEN_CHARSET")
+	if dir == "" {
+		t.Skip("沒有設 HR_GEN_CHARSET")
+	}
+	for _, l := range langOrder {
+		var b strings.Builder
+		for _, r := range charsetOf(l) {
+			b.WriteRune(r)
+		}
+		b.WriteByte('\n')
+		if err := os.WriteFile(filepath.Join(dir, "charset-"+string(l)+".txt"), []byte(b.String()), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		t.Logf("%s：%d 個字元", l, len(charsetOf(l)))
+	}
+}
diff --git a/apps/hr/play/fonts_test.go b/apps/hr/play/fonts_test.go
new file mode 100644
index 0000000..224261b
--- /dev/null
+++ b/apps/hr/play/fonts_test.go
@@ -0,0 +1,194 @@
+package main
+
+import (
+	"encoding/binary"
+	"image"
+	"os"
+	"path/filepath"
+	"testing"
+	"unicode"
+
+	"golang.org/x/image/font"
+	"golang.org/x/image/font/opentype"
+	"golang.org/x/image/font/sfnt"
+	"golang.org/x/image/math/fixed"
+)
+
+// docs/spec/006 第 6 節與第 10 節的字型測試：內嵌的五份 Noto Sans CJK 子集（tools/gen_ui_fonts.sh 產生）。
+// 這些測試讀 fonts/ 目錄的檔案（內嵌前的版本）；內嵌後改讀 go:embed 的位元組，判準不變。
+
+const uiFontPx = 22 // F1 面板的字面 em（像素）
+
+func readFont(t *testing.T, l string) []byte {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join("fonts", "ui-"+l+".otf"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+func newFace(t *testing.T, b []byte) (*sfnt.Font, font.Face) {
+	t.Helper()
+	f, err := opentype.Parse(b)
+	if err != nil {
+		t.Fatalf("opentype.Parse：%v", err)
+	}
+	face, err := opentype.NewFace(f, &opentype.FaceOptions{Size: uiFontPx, DPI: 72, Hinting: font.HintingNone})
+	if err != nil {
+		t.Fatalf("opentype.NewFace：%v", err)
+	}
+	return f, face
+}
+
+func charsetFile(t *testing.T, l string) []rune {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join("fonts", "charset-"+l+".txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out []rune
+	for _, r := range string(b) {
+		if r != '\n' {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// inkPixels 回傳字形遮罩內 alpha 非零的像素數。
+func inkPixels(dr image.Rectangle, mask image.Image, maskp image.Point) int {
+	n := 0
+	for y := dr.Min.Y; y < dr.Max.Y; y++ {
+		for x := dr.Min.X; x < dr.Max.X; x++ {
+			_, _, _, a := mask.At(maskp.X+x-dr.Min.X, maskp.Y+y-dr.Min.Y).RGBA()
+			if a != 0 {
+				n++
+			}
+		}
+	}
+	return n
+}
+
+var allLangs = []string{"zh-TW", "zh-CN", "ko", "en", "ja"}
+
+// 字形墨跡：opentype.Parse 與 GlyphIndex 都不會執行 CFF charstring，只有 Glyph（LoadGlyph）會；
+// 所以對字元表每個非空白字元實際畫一次，ok 且遮罩有墨跡。
+// 控制組：空白 ok 但沒有墨跡（偵測器不是恆真）；不在子集內的字元要被辨認出來（見下面的缺字測試）。
+func TestFontsEveryCharHasInk(t *testing.T) {
+	for _, l := range allLangs {
+		_, face := newFace(t, readFont(t, l))
+		chars := charsetFile(t, l)
+		if len(chars) < 90 {
+			t.Fatalf("%s：字元表只有 %d 個字元", l, len(chars))
+		}
+		bad := 0
+		for _, r := range chars {
+			dr, mask, maskp, _, ok := face.Glyph(fixed.P(0, 40), r)
+			if unicode.IsSpace(r) { // 半形與全形（U+3000）空白：ok 但沒有墨跡
+				if !ok || inkPixels(dr, mask, maskp) != 0 {
+					t.Errorf("%s：空白 U+%04X 應 ok 且沒有墨跡（控制組）", l, r)
+				}
+				continue
+			}
+			if !ok {
+				t.Errorf("%s：U+%04X %q Glyph 回 ok＝false", l, r, r)
+				bad++
+				continue
+			}
+			if inkPixels(dr, mask, maskp) == 0 {
+				t.Errorf("%s：U+%04X %q 沒有墨跡", l, r, r)
+				bad++
+			}
+		}
+		t.Logf("%s：%d 個字元，無墨跡或 ok＝false 的 %d 個", l, len(chars), bad)
+	}
+}
+
+// 缺字：不在子集內的字元（每個子集都不含「龘」）要能被辨認出來。動態字串的缺字退回就靠 GlyphIndex。
+func TestFontsMissingGlyphIsDetected(t *testing.T) {
+	const missing = '龘'
+	for _, l := range allLangs {
+		f, face := newFace(t, readFont(t, l))
+		var buf sfnt.Buffer
+		idx, err := f.GlyphIndex(&buf, missing)
+		if err != nil {
+			t.Fatalf("%s：GlyphIndex：%v", l, err)
+		}
+		if idx != 0 {
+			t.Errorf("%s：不該含 U+9F98，GlyphIndex ＝ %d", l, idx)
+		}
+		_, _, _, _, ok := face.Glyph(fixed.P(0, 40), missing)
+		t.Logf("%s：缺字 Glyph 的 ok ＝ %v（GlyphIndex ＝ %d）", l, ok, idx)
+	}
+}
+
+// 選對字面：GlyphAdvance('i') 不等於 GlyphAdvance('W')（選到 Mono 面會相等）。
+// Metrics().Height 約 31.86 只守住 hhea 沒被改壞（10 個面的 hhea 全相同，不能用來辨認字面）。
+func TestFontsProportionalLatinAndMetrics(t *testing.T) {
+	for _, l := range allLangs {
+		_, face := newFace(t, readFont(t, l))
+		ai, ok1 := face.GlyphAdvance('i')
+		aW, ok2 := face.GlyphAdvance('W')
+		if !ok1 || !ok2 {
+			t.Fatalf("%s：GlyphAdvance 回 ok＝false", l)
+		}
+		if ai == aW {
+			t.Errorf("%s：'i' 與 'W' 的前進量相同（%v），可能選到等寬面", l, ai)
+		}
+		h := float64(face.Metrics().Height) / 64
+		if h < 31.7 || h > 32.0 {
+			t.Errorf("%s：Metrics().Height ＝ %.3f，預期約 31.86", l, h)
+		}
+	}
+}
+
+// 子集沒有 GSUB、GPOS、kern：表目錄由測試自己解析（x/image 的 sfnt.Font 沒有公開表目錄）。
+// Kern 對常見字對恆為 0。
+func TestFontsNoLayoutTablesAndKernZero(t *testing.T) {
+	for _, l := range allLangs {
+		b := readFont(t, l)
+		if len(b) < 12 || string(b[:4]) != "OTTO" {
+			t.Fatalf("%s：不是 OTTO 字型", l)
+		}
+		n := int(binary.BigEndian.Uint16(b[4:6]))
+		tags := map[string]bool{}
+		for i := 0; i < n; i++ {
+			off := 12 + 16*i
+			if off+4 > len(b) {
+				t.Fatalf("%s：表目錄截斷", l)
+			}
+			tags[string(b[off:off+4])] = true
+		}
+		for _, bad := range []string{"GSUB", "GPOS", "kern"} {
+			if tags[bad] {
+				t.Errorf("%s：子集不該有 %s 表", l, bad)
+			}
+		}
+		for _, need := range []string{"CFF ", "cmap", "head", "hhea", "hmtx", "name"} {
+			if !tags[need] {
+				t.Errorf("%s：缺 %s 表", l, need)
+			}
+		}
+		_, face := newFace(t, b)
+		for _, p := range [][2]rune{{'A', 'V'}, {'T', 'o'}, {'W', 'a'}, {'f', 'i'}} {
+			if k := face.Kern(p[0], p[1]); k != 0 {
+				t.Errorf("%s：Kern(%q,%q) ＝ %v，子集沒有 GPOS 與 kern，應為 0", l, p[0], p[1], k)
+			}
+		}
+	}
+}
+
+// name ID 0、7、13、14 存在（OFL 第 2 條要求每份複本帶版權聲明與授權）。
+func TestFontsNameIDsPresent(t *testing.T) {
+	for _, l := range allLangs {
+		f, _ := newFace(t, readFont(t, l))
+		var buf sfnt.Buffer
+		for _, id := range []sfnt.NameID{0, 7, 13, 14} {
+			s, err := f.Name(&buf, id)
+			if err != nil || s == "" {
+				t.Errorf("%s：name ID %d 缺（%v）", l, id, err)
+			}
+		}
+	}
+}
