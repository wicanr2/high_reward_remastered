+// os.Exit 只出現在 quit 與偏好設定尚未建立前的 fail 路徑。
+func TestExitOnlyInQuitAndEarlyFail(t *testing.T) {
+	fset, files := parsePackage(t)
+	if v := exitViolations(fset, files); len(v) != 0 {
+		t.Errorf("結束呼叫不在允許的位置：\n%s", strings.Join(v, "\n"))
+	}
+	// 允許的位置確實存在（否則檢查是空的）
+	count := func(file, fn string) int {
+		n := 0
+		for _, d := range files[file].Decls {
+			if fd, ok := d.(*ast.FuncDecl); ok && fd.Name.Name == fn && fd.Recv == nil {
+				ast.Inspect(fd.Body, func(x ast.Node) bool {
+					if c, ok := x.(*ast.CallExpr); ok {
+						if _, ok := isExitCall(c); ok {
+							n++
+						}
+					}
+					return true
+				})
+			}
+		}
+		return n
+	}
+	if count("main.go", "quit") != 1 || count("errwin.go", "fail") != 1 {
+		t.Errorf("quit 與 fail 各應有恰好一個結束呼叫：%d、%d", count("main.go", "quit"), count("errwin.go", "fail"))
+	}
+}
