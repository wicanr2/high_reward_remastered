+// craftInkOnlyOverflow 構造一段文字：接在 prefix 之後成為一行，以 'f' 結尾，整行前進量不超過 hudW，但 'f' 的墨跡右緣超出預算。
+// 填充字元的前進量不同，用背包搜尋找出總前進量落在 (預算 − 外溢量, 預算] 的組合。
+func craftInkOnlyOverflow(t *testing.T, face font.Face, prefix string) string {
+	t.Helper()
+	fAdv, ok := face.GlyphAdvance('f')
+	b, _, ok2 := face.GlyphBounds('f')
+	if !ok || !ok2 {
+		t.Fatal("字面缺 'f'")
+	}
+	over := b.Max.X - fAdv // 墨跡超出前進量的 26.6 單位（約 43）
+	if over <= 0 {
+		t.Fatalf("'f' 沒有右側外溢（%v），無法構造案例", over)
+	}
+	budget := fixed.I(hudW) - font.MeasureString(face, prefix)
+	hi := int(budget - fAdv)  // 填充的前進量上限：加上 'f' 後前進量不超過預算
+	lo := int(hi) - int(over) // 下限：加上 'f' 的外溢後墨跡超過預算（總前進量 > 預算 − 外溢量）
+	fillers := []rune("il.,;:1tIjr-aeocsxzvnuWmMw0")
+	adv := make([]int, len(fillers))
+	for i, r := range fillers {
+		a, _ := face.GlyphAdvance(r)
+		adv[i] = int(a)
+	}
+	// reach[s] ＝ 達到前進量 s 的最後一個填充字元索引（-2 ＝ 不可達，-1 ＝ 起點）
+	reach := make([]int, hi+1)
+	for i := range reach {
+		reach[i] = -2
+	}
+	reach[0] = -1
+	for s := 1; s <= hi; s++ {
+		for i, a := range adv {
+			if a > 0 && s-a >= 0 && reach[s-a] != -2 {
+				reach[s] = i
+				break
+			}
+		}
+	}
+	for s := hi; s > lo; s-- {
+		if reach[s] == -2 {
+			continue
+		}
+		var rs []rune
+		for x := s; x > 0; x -= adv[reach[x]] {
+			rs = append(rs, fillers[reach[x]])
+		}
+		return string(rs) + "f"
+	}
+	t.Fatalf("找不到總前進量落在 (%d, %d] 的填充組合", lo, hi)
+	return ""
+}
