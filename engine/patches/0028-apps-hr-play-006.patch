+// 結束收拾的順序與結構：quit 先 run 再 os.Exit；run 的順序是 sw.Quit、pw.Close、hv.close、其餘收尾；
+// main 的每條結束路徑（RunGame 失敗、正常結束）都經 quit，且 quit 是 main 的最後一個敘述；
+// fail 都在寫入者建立之前。
+func TestQuitOrderAndMainExitPaths(t *testing.T) {
+	_, files := parsePackage(t)
+
+	quit := findFunc(files, "main.go", "quit")
+	if quit == nil || len(quit.Body.List) != 2 {
+		t.Fatalf("quit 應恰有兩個敘述（td.run()、os.Exit）")
+	}
+	if c, ok := quit.Body.List[0].(*ast.ExprStmt).X.(*ast.CallExpr); !ok || !strings.HasSuffix(exprString(c.Fun), "run") {
+		t.Errorf("quit 的第一個敘述應是 td.run()")
+	}
+	if c, ok := quit.Body.List[1].(*ast.ExprStmt).X.(*ast.CallExpr); !ok {
+		t.Errorf("quit 的第二個敘述應是 os.Exit")
+	} else if what, isExit := isExitCall(c); !isExit || what != "os.Exit" {
+		t.Errorf("quit 的第二個敘述應是 os.Exit：%s", what)
+	}
+
+	run := findFunc(files, "main.go", "run")
+	if run == nil {
+		t.Fatal("找不到 teardown.run")
+	}
+	var order []string
+	ast.Inspect(run.Body, func(n ast.Node) bool {
+		if c, ok := n.(*ast.CallExpr); ok {
+			if s := exprString(c.Fun); s == "td.sw.Quit" || s == "td.pw.Close" || s == "td.hv.close" {
+				order = append(order, s)
+			}
+		}
+		return true
+	})
+	if want := []string{"td.sw.Quit", "td.pw.Close", "td.hv.close"}; strings.Join(order, ",") != strings.Join(want, ",") {
+		t.Errorf("收拾順序 ＝ %v，應為 %v", order, want)
+	}
+	// 其餘收尾（after）在三者之後
+	lastClose := token.NoPos
+	var afterPos token.Pos
+	ast.Inspect(run.Body, func(n ast.Node) bool {
+		if c, ok := n.(*ast.CallExpr); ok && exprString(c.Fun) == "td.hv.close" {
+			lastClose = c.Pos()
+		}
+		if r, ok := n.(*ast.RangeStmt); ok && exprString(r.X) == "td.after" {
+			afterPos = r.Pos()
+		}
+		return true
+	})
+	if !afterPos.IsValid() || afterPos < lastClose {
+		t.Errorf("td.after 應在 hv.close 之後")
+	}
+
+	mainFn := findFunc(files, "main.go", "main")
+	var quits, prefsCalls int
+	var prefsPos token.Pos
+	ast.Inspect(mainFn.Body, func(n ast.Node) bool {
+		if _, ok := isCallTo(n, "quit"); ok {
+			quits++
+		}
+		if c, ok := isCallTo(n, "newPrefsWriter"); ok {
+			prefsCalls++
+			prefsPos = c.Pos()
+		}
+		return true
+	})
+	if quits < 2 || prefsCalls != 1 {
+		t.Fatalf("main 內 quit 呼叫 %d 次（應至少 2：RunGame 失敗、正常結束）、newPrefsWriter %d 次（應為 1）", quits, prefsCalls)
+	}
+	last := mainFn.Body.List[len(mainFn.Body.List)-1]
+	if es, ok := last.(*ast.ExprStmt); !ok {
+		t.Errorf("main 的最後一個敘述應是 quit(td, 0)")
+	} else if _, ok := isCallTo(es.X, "quit"); !ok {
+		t.Errorf("main 的最後一個敘述應是 quit(td, 0)")
+	}
+	// fail（啟動失敗）都在偏好設定寫入者建立之前
+	ast.Inspect(mainFn.Body, func(n ast.Node) bool {
+		if c, ok := isCallTo(n, "fail"); ok && c.Pos() > prefsPos {
+			t.Errorf("fail 呼叫在 newPrefsWriter 之後：偏好設定已建立，結束要經 quit")
+		}
+		return true
+	})
+	// 沒有 defer（os.Exit 不執行 defer）
+	ast.Inspect(mainFn.Body, func(n ast.Node) bool {
+		if _, ok := n.(*ast.DeferStmt); ok {
+			t.Errorf("main 不該用 defer：os.Exit 不執行，收尾要寫進 teardown")
+		}
+		return true
+	})
+}
