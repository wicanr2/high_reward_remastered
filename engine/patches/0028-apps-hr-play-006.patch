+)
+
+// docs/spec/006 第 7 節與第 10 節的偏好設定測試。草稿的測試斷言舊行為（損壞與版本不明一律零值、未知欄位忽略、
+// 整份覆寫），升 READY 後反過來：補丁式合併、未知欄位與 version 原樣保留、損壞改名 .bad 且每次寫入判斷。
+
+// lineLog 收集 logf 的輸出（執行緒安全；不用 t.Logf，因為卡住的寫入可能在測試結束後才記）。
+type lineLog struct {
+	mu    sync.Mutex
+	lines []string
+}
+
+func (l *lineLog) logf(format string, a ...any) {
+	l.mu.Lock()
+	l.lines = append(l.lines, fmt.Sprintf(format, a...))
+	l.mu.Unlock()
+}
+
+func (l *lineLog) all() []string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([]string(nil), l.lines...)
+}
+
+func (l *lineLog) has(sub string) bool {
+	for _, s := range l.all() {
+		if strings.Contains(s, sub) {
+			return true
+		}
+	}
+	return false
+}
+
+func waitUntil(d time.Duration, cond func() bool) bool {
+	deadline := time.Now().Add(d)
+	for {
+		if cond() {
+			return true
+		}
+		if time.Now().After(deadline) {
+			return false
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func readStr(t *testing.T, path string) string {
+	t.Helper()
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
+
+// 以注入的寫入函式建立寫入者；寫入者在建立時取用 savePrefs，所以建立後立刻還原全域變數，
+// 背景 goroutine 之後不再讀全域變數（不與其他測試競爭）。
+func newWriterWith(t *testing.T, path string, logf func(string, ...any), save prefsWriteFunc) *prefsWriter {
+	t.Helper()
+	old := savePrefs
+	savePrefs = save
+	defer func() { savePrefs = old }()
+	return newPrefsWriter(path, logf)
+}
+
+func TestPrefsParseLenient(t *testing.T) {
+	cases := []struct {
+		name  string
+		in    string
+		want  prefs
+		state prefsState
+	}{
+		{"全部欄位", `{"version":1,"theme":"hd","lang":"ko","sound":false}`, prefs{Version: 1, Theme: "hd", Lang: "ko", Sound: bp(false)}, prefsOK},
+		{"theme 型別錯誤只讓該欄位用預設", `{"version":1,"theme":5,"lang":"en"}`, prefs{Version: 1, Lang: "en"}, prefsOK},
+		{"sound 型別錯誤", `{"version":1,"sound":"yes","theme":"ai"}`, prefs{Version: 1, Theme: "ai"}, prefsOK},
+		{"lang 是 null", `{"version":1,"lang":null,"theme":"hd"}`, prefs{Version: 1, Theme: "hd"}, prefsOK},
+		{"theme 是物件", `{"version":1,"theme":{"a":1},"sound":true}`, prefs{Version: 1, Sound: bp(true)}, prefsOK},
+		{"未知欄位不影響已知欄位", `{"version":1,"theme":"hd","future_field":123}`, prefs{Version: 1, Theme: "hd"}, prefsOK},
+		{"version 非 1：已知欄位照常讀取", `{"version":2,"theme":"hd","lang":"ja"}`, prefs{Version: 2, Theme: "hd", Lang: "ja"}, prefsOtherVersion},
+		{"version 99", `{"version":99,"theme":"hd"}`, prefs{Version: 99, Theme: "hd"}, prefsOtherVersion},
+		{"值不認得也原樣讀出（合法性由呼叫端判斷）", `{"version":1,"theme":"neon","lang":"fr"}`, prefs{Version: 1, Theme: "neon", Lang: "fr"}, prefsOK},
+	}
+	for _, c := range cases {
+		got, st := parsePrefs([]byte(c.in))
+		if st != c.state {
+			t.Errorf("%s：狀態 %d，應為 %d", c.name, st, c.state)
+		}
+		if got.Version != c.want.Version || got.Theme != c.want.Theme || got.Lang != c.want.Lang || (got.Sound == nil) != (c.want.Sound == nil) || (got.Sound != nil && *got.Sound != *c.want.Sound) {
+			t.Errorf("%s：解析結果 %+v，應為 %+v", c.name, got, c.want)
+		}
+	}
+	if _, st := parsePrefs(nil); st != prefsAbsent {
+		t.Errorf("nil 位元組應為 absent，得到 %d", st)
+	}
+}
+
+// 損壞的各種形式：頂層不是物件、不是合法 JSON、version 缺或不是數字（含空檔）。
+var corruptPrefs = []string{
+	"", "{", "not json", `[1,2]`, `null`, `"hd"`, `42`, `true`,
+	`{"theme":"hd"}`, `{"version":"1","theme":"hd"}`, `{"version":null,"theme":"hd"}`, `{"version":true}`, `{"version":{"a":1}}`,
+	"\xef\xbb\xbf" + `{"version":1}`, // BOM 開頭不是合法 JSON
+}
+
+func TestPrefsCorruptClassification(t *testing.T) {
+	for _, in := range corruptPrefs {
+		if _, st := classifyPrefs([]byte(in)); st != prefsCorrupt {
+			t.Errorf("%q 應判為損壞，得到 %d", in, st)
+		}
+		if got, _ := parsePrefs([]byte(in)); got != (prefs{}) {
+			t.Errorf("%q 損壞時讀取應回零值，得到 %+v", in, got)
+		}
+	}
+	// 控制組：合法的不被判損壞（偵測器不是恆真）
+	for _, in := range []string{`{"version":1}`, " \n{\"version\":1,\"theme\":\"hd\"}\n", `{"version":2}`, `{"version":1.0}`, `{"version":1,"x":[1,{"y":null}]}`} {
+		if _, st := classifyPrefs([]byte(in)); st == prefsCorrupt || st == prefsAbsent {
+			t.Errorf("%q 不該判為損壞，得到 %d", in, st)
+		}
+	}
+	if _, st := classifyPrefs([]byte(`{"version":1.0}`)); st != prefsOK {
+		t.Errorf("version 1.0 數值上是 1")
+	}
+}
+
+func TestApplyPrefsPatch(t *testing.T) {
+	// 檔案不存在：新物件，只有被切換的欄位
+	out, st := applyPrefsPatch(nil, themePatch(themeHD))
+	if st != prefsAbsent || string(out) != "{\"version\":1,\"theme\":\"hd\"}\n" {
+		t.Errorf("不存在時輸出 %q（狀態 %d）", out, st)
+	}
+	// 補丁合併：不同欄位保留（F2 後立刻 F4），同欄位後者覆蓋
+	out, _ = applyPrefsPatch(nil, themePatch(themeHD), langPatch(langKO))
+	if p, _ := parsePrefs(out); p.Theme != "hd" || p.Lang != "ko" || p.Sound != nil {
+		t.Errorf("F2 後接 F4：%q", out)
+	}
+	out, _ = applyPrefsPatch(nil, themePatch(themeHD), themePatch(themeAI), soundPatch(false), soundPatch(true))
+	if p, _ := parsePrefs(out); p.Theme != "ai" || p.Sound == nil || !*p.Sound {
+		t.Errorf("同欄位後者覆蓋：%q", out)
+	}
+	// 未知欄位保留（含巢狀值）；沒被切換的已知欄位也保留
+	old := []byte(`{"version":1,"zzz":{"a":[1,2,{"b":null}]},"theme":"ai","lang":"ja","note":"hello"}`)
+	out, st = applyPrefsPatch(old, soundPatch(false))
+	if st != prefsOK {
+		t.Errorf("狀態 %d", st)
+	}
+	m, _ := classifyPrefs(out)
+	if string(m["zzz"]) != `{"a":[1,2,{"b":null}]}` || string(m["note"]) != `"hello"` || string(m["theme"]) != `"ai"` || string(m["lang"]) != `"ja"` || string(m["sound"]) != `false` {
+		t.Errorf("未知欄位或未被切換的欄位沒有原樣保留：%q", out)
+	}
+	// version 非 1：原樣保留 version 與未知欄位，只改被切換的欄位
+	out, st = applyPrefsPatch([]byte(`{"version":2,"theme":"hd","future":[1,2]}`), langPatch(langEN))
+	m, _ = classifyPrefs(out)
+	if st != prefsOtherVersion || string(m["version"]) != "2" || string(m["future"]) != "[1,2]" || string(m["theme"]) != `"hd"` || string(m["lang"]) != `"en"` {
+		t.Errorf("version 非 1：%q（狀態 %d）", out, st)
+	}
+	// 損壞：從新物件開始，不帶任何舊內容
+	out, st = applyPrefsPatch([]byte(`{"version":"x","secret":1}`), themePatch(themeHD))
+	if st != prefsCorrupt || string(out) != "{\"version\":1,\"theme\":\"hd\"}\n" {
+		t.Errorf("損壞時輸出 %q（狀態 %d）", out, st)
+	}
+	// 輸出一定是合法的 prefsOK 檔案（version 在最前）
+	out, _ = applyPrefsPatch(nil, soundPatch(true), langPatch(langZHCN()), themePatch(themeOriginal))
+	if !strings.HasPrefix(string(out), `{"version":1,`) {
+		t.Errorf("version 應在最前：%q", out)
+	}
+	if _, st := classifyPrefs(out); st != prefsOK {
+		t.Errorf("輸出不是合法的偏好設定：%q", out)
+	}
+}
