+++ b/apps/hr/play/paths_test.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+// docs/spec/006 第 4 節：hd-ai/ 的尋找順序與 hd/ 相同，目錄名換成 hd-ai，旗標 -hd-ai、環境變數 HR_HD_AI。
+
+func TestThemeDirCandidatesOrder(t *testing.T) {
+	for _, name := range []string{"hd", "hd-ai"} {
+		got := themeDirCandidates("/flag", "/env", "/apps/HR.AppImage", "/opt/hr/hr-play", name)
+		want := []string{
+			"/flag",
+			"/env",
+			filepath.Join("/apps", name),
+			filepath.Join("/opt/hr", name),
+			filepath.Join("/opt/Resources", name), // 執行檔旁的 ../Resources（macOS app 的 Contents/MacOS 之外）
+			name,
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s：候選順序 %v，應為 %v", name, got, want)
+		}
+	}
+	// 空來源略過；永遠以目前目錄的 <dirName> 收尾
+	if got := themeDirCandidates("", "", "", "", "hd-ai"); !reflect.DeepEqual(got, []string{"hd-ai"}) {
+		t.Errorf("沒有任何來源時 ＝ %v", got)
+	}
+	if got := themeDirCandidates("", "/env", "", "", "hd"); !reflect.DeepEqual(got, []string{"/env", "hd"}) {
+		t.Errorf("只有環境變數 ＝ %v", got)
+	}
+}
+
+func writeCatalogDir(t *testing.T, dir string) string {
+	t.Helper()
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "catalog.tsv"), []byte("hash\tid\tw\th\tkind\tpal\thd\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return dir
+}
+
+func TestFindHDAI(t *testing.T) {
+	root := t.TempDir()
+	envDir := writeCatalogDir(t, filepath.Join(root, "env-ai"))
+	flagDir := writeCatalogDir(t, filepath.Join(root, "flag-ai"))
+	t.Setenv("APPIMAGE", "")
+	t.Setenv("HR_HD", "")
+	t.Setenv("HR_HD_AI", envDir)
+	if got := findHDAI(""); got != envDir {
+		t.Errorf("環境變數 HR_HD_AI：findHDAI ＝ %q，應為 %q", got, envDir)
+	}
+	if got := findHDAI(flagDir); got != flagDir {
+		t.Errorf("旗標優先於環境變數：findHDAI ＝ %q，應為 %q", got, flagDir)
+	}
+	// 旗標目錄沒有 catalog.tsv：略過，往下一個候選
+	if got := findHDAI(filepath.Join(root, "nowhere")); got != envDir {
+		t.Errorf("旗標目錄不存在時應退到環境變數：%q", got)
+	}
+	// HR_HD 只影響 hd/，不影響 hd-ai/
+	t.Setenv("HR_HD_AI", "")
+	t.Setenv("HR_HD", envDir)
+	if got := findHDAI(""); got == envDir {
+		t.Errorf("HR_HD 不該被 findHDAI 使用")
+	}
+	if got := findHD(""); got != envDir {
+		t.Errorf("findHD 沿用 HR_HD：%q", got)
+	}
+	// AppImage 檔案旁的 hd-ai
+	app := filepath.Join(root, "apps", "HR.AppImage")
+	aiNextToApp := writeCatalogDir(t, filepath.Join(root, "apps", "hd-ai"))
+	t.Setenv("HR_HD", "")
+	t.Setenv("APPIMAGE", app)
+	if got := findHDAI(""); got != aiNextToApp {
+		t.Errorf("AppImage 旁：findHDAI ＝ %q，應為 %q", got, aiNextToApp)
+	}
+	if got := findHD(""); got != "" {
+		t.Errorf("AppImage 旁沒有 hd/，findHD 應回空字串，實際 %q", got)
+	}
+}
diff --git a/apps/hr/play/prefs.go b/apps/hr/play/prefs.go
new file mode 100644
index 0000000..95695b3
--- /dev/null
+++ b/apps/hr/play/prefs.go
@@ -0,0 +1,372 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+)
+
+// 偏好設定（docs/spec/006 第 7 節）：<資料目錄>/prefs.json，
+// {"version":1,"theme":"hd","lang":"zh-TW","sound":true}。
+//
+// 只寫被切換的欄位，以補丁合併：F2 改 theme、F3 改 sound、F4 改 lang。每次切換提交一個欄位補丁（prefsPatch），
+// 背景寫入者合併待套用的補丁（同欄位後者覆蓋、不同欄位保留），再讀目前的檔案、套用補丁、原子寫回。
+// 旗標與環境變數啟動的值不進補丁，所以不會被持久化。
+//
+// 讀取：逐欄位寬鬆解析（型別錯誤只讓該欄位用預設）。損壞（頂層不是物件、不是合法 JSON、version 缺或不是數字）
+// 在讀取時當作沒有偏好，在每次寫入時對「剛讀到的位元組」判斷並把原檔改名為 prefs.json.bad（不用啟動時留下的
+// 旗標，否則兩個執行個體時，晚到的那個會把對方剛寫好的有效檔改名）。version 是數字但不是 1 時，已知欄位照常
+// 讀取，寫回時原樣保留 version 與所有未知欄位。
+// 兩個執行個體同時運行時，讀檔、改欄位、改名之間沒有檔案鎖，窗口縮小到一次寫入，但不是零（已知差異）。
+
+const prefsVersion = 1
+
+// prefs 是解析後的偏好設定（讀取用）。零值 ＝ 沒有偏好。
+type prefs struct {
+	Version int
+	Theme   string // 空 ＝ 沒有；值的合法性（是否可用）由呼叫端判斷，不覆寫檔案內容
+	Lang    string
+	Sound   *bool // nil ＝ 沒有這個欄位
+}
+
+func prefsPath(dataDir string) string { return filepath.Join(dataDir, "prefs.json") }
+
+// prefsPatch 是一次切換要寫入的欄位；nil 的欄位不寫。
+type prefsPatch struct {
+	Theme *string
+	Lang  *string
+	Sound *bool
+}
+
+func themePatch(id themeID) prefsPatch { s := string(id); return prefsPatch{Theme: &s} }
+func langPatch(l lang) prefsPatch      { s := string(l); return prefsPatch{Lang: &s} }
+func soundPatch(on bool) prefsPatch    { return prefsPatch{Sound: &on} }
+
+func (p prefsPatch) empty() bool { return p.Theme == nil && p.Lang == nil && p.Sound == nil }
+
+// merge 把 q 疊到 p 上：q 有的欄位覆蓋 p（同欄位後者覆蓋），其餘保留 p 的。
+func (p prefsPatch) merge(q prefsPatch) prefsPatch {
+	if q.Theme != nil {
+		p.Theme = q.Theme
+	}
+	if q.Lang != nil {
+		p.Lang = q.Lang
+	}
+	if q.Sound != nil {
+		p.Sound = q.Sound
+	}
+	return p
+}
+
+func (p prefsPatch) String() string {
+	var parts []string
+	if p.Theme != nil {
+		parts = append(parts, "theme="+*p.Theme)
+	}
+	if p.Lang != nil {
+		parts = append(parts, "lang="+*p.Lang)
+	}
+	if p.Sound != nil {
+		parts = append(parts, fmt.Sprintf("sound=%v", *p.Sound))
+	}
+	return "{" + strings.Join(parts, " ") + "}"
+}
+
+// prefsState 是對檔案位元組的判斷。
+type prefsState int
+
+const (
+	prefsAbsent       prefsState = iota // 檔案不存在（位元組為 nil）
+	prefsOK                             // 合法物件，version 是數字 1
+	prefsOtherVersion                   // 合法物件，version 是數字但不是 1
+	prefsCorrupt                        // 頂層不是物件、不是合法 JSON，或 version 缺或不是數字
+)
+
+// classifyPrefs 把位元組解成欄位表並判斷狀態。b 為 nil 表示檔案不存在；空檔不是合法 JSON，算損壞。
+func classifyPrefs(b []byte) (map[string]json.RawMessage, prefsState) {
+	if b == nil {
+		return nil, prefsAbsent
+	}
+	t := bytes.TrimSpace(b)
+	if len(t) == 0 || t[0] != '{' || !json.Valid(t) { // null、陣列、字串、數字、壞 JSON
+		return nil, prefsCorrupt
+	}
+	var m map[string]json.RawMessage
+	if err := json.Unmarshal(t, &m); err != nil || m == nil {
+		return nil, prefsCorrupt
+	}
+	raw, ok := m["version"]
+	if !ok || len(raw) == 0 || !(raw[0] == '-' || (raw[0] >= '0' && raw[0] <= '9')) {
+		return nil, prefsCorrupt // 缺，或不是數字（字串、null、布林、物件）
+	}
+	var v float64
+	if err := json.Unmarshal(raw, &v); err != nil {
+		return nil, prefsCorrupt
+	}
+	if v != prefsVersion {
+		return m, prefsOtherVersion
+	}
+	return m, prefsOK
+}
+
+// parsePrefs 逐欄位寬鬆解析：每個已知欄位單獨解碼，型別錯誤只讓該欄位用預設。損壞或不存在回零值。
+func parsePrefs(b []byte) (prefs, prefsState) {
+	m, st := classifyPrefs(b)
+	if st == prefsAbsent || st == prefsCorrupt {
+		return prefs{}, st
+	}
+	var p prefs
+	var v float64
+	if json.Unmarshal(m["version"], &v) == nil {
+		p.Version = int(v)
+	}
+	if raw, ok := m["theme"]; ok {
+		var s string
+		if json.Unmarshal(raw, &s) == nil {
+			p.Theme = s
+		}
+	}
+	if raw, ok := m["lang"]; ok {
+		var s string
+		if json.Unmarshal(raw, &s) == nil {
+			p.Lang = s
+		}
+	}
+	if raw, ok := m["sound"]; ok {
+		var s bool
+		if json.Unmarshal(raw, &s) == nil {
+			p.Sound = &s
+		}
+	}
+	return p, st
+}
+
+// loadPrefs 讀偏好設定；任何問題都回零值（不報錯、不改檔案）。
+func loadPrefs(path string) prefs {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return prefs{}
+	}
+	p, _ := parsePrefs(b)
+	return p
+}
+
+// applyPrefsPatch 把補丁依序套到 old（目前檔案的位元組；nil ＝ 檔案不存在）上，回傳要寫入的位元組與 old 的狀態：
+//   - 補丁只改被切換的欄位（同欄位後者覆蓋、不同欄位保留）；
+//   - 狀態為 prefsOK 或 prefsOtherVersion 時，所有未知欄位與 version 的值原樣保留；
+//   - 狀態為 prefsAbsent 或 prefsCorrupt 時從新物件開始（version 為 1），呼叫端負責把損壞的原檔改名為 .bad。
+//
+// 輸出的欄位順序固定：version 在最前，其餘依鍵名排序。
+func applyPrefsPatch(old []byte, patches ...prefsPatch) ([]byte, prefsState) {
+	m, st := classifyPrefs(old)
+	if m == nil {
+		m = map[string]json.RawMessage{"version": json.RawMessage("1")}
+	}
+	var merged prefsPatch
+	for _, p := range patches {
+		merged = merged.merge(p)
+	}
+	set := func(key string, v any) {
+		b, _ := json.Marshal(v) // string 與 bool 不會失敗
+		m[key] = b
+	}
+	if merged.Theme != nil {
+		set("theme", *merged.Theme)
+	}
+	if merged.Lang != nil {
+		set("lang", *merged.Lang)
+	}
+	if merged.Sound != nil {
+		set("sound", *merged.Sound)
+	}
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		if k != "version" {
+			keys = append(keys, k)
+		}
+	}
+	sort.Strings(keys)
+	keys = append([]string{"version"}, keys...)
+	var buf bytes.Buffer
+	buf.WriteByte('{')
+	for i, k := range keys {
+		if i > 0 {
+			buf.WriteByte(',')
+		}
+		kb, _ := json.Marshal(k)
+		buf.Write(kb)
+		buf.WriteByte(':')
+		var c bytes.Buffer
+		if json.Compact(&c, m[k]) == nil {
+			buf.Write(c.Bytes())
+		} else {
+			buf.Write(m[k])
+		}
+	}
+	buf.WriteString("}\n")
+	return buf.Bytes(), st
+}
+
+// writeAtomic 以暫存檔加改名寫入 path（暫存檔在同一個目錄，名稱 .prefs-*.tmp）。
+func writeAtomic(path string, b []byte) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(path), ".prefs-*.tmp")
+	if err != nil {
+		return err
+	}
+	tmp := f.Name()
+	if _, err := f.Write(b); err != nil {
+		f.Close()
+		os.Remove(tmp)
+		return err
+	}
+	if err := f.Close(); err != nil {
+		os.Remove(tmp)
+		return err
+	}
+	if err := os.Rename(tmp, path); err != nil {
+		os.Remove(tmp)
+		return fmt.Errorf("改名失敗：%w", err)
+	}
+	return nil
+}
+
+// prefsWriteFunc 是寫入函式的型別。logf 可為 nil。
+type prefsWriteFunc func(path string, patch prefsPatch, logf func(string, ...any)) error
+
+// savePrefs 是寫入函式變數：測試可以注入卡住的寫入（docs/spec/006 第 10 節）。newPrefsWriter 建立時取用目前的值。
+var savePrefs prefsWriteFunc = writePrefs
+
+// writePrefs 讀目前的檔案、對剛讀到的位元組判斷損壞（每次寫入都判斷）、套用補丁、原子寫回。
+// 損壞時先把原檔改名為 <path>.bad（覆蓋舊的 .bad）再寫新檔，並記一行。
+func writePrefs(path string, patch prefsPatch, logf func(string, ...any)) error {
+	if logf == nil {
+		logf = func(string, ...any) {}
+	}
+	old, err := os.ReadFile(path)
+	if err != nil {
+		if !errors.Is(err, fs.ErrNotExist) {
+			return err // 讀不到不代表可以蓋掉它
+		}
+		old = nil
+	}
+	out, st := applyPrefsPatch(old, patch)
+	if st == prefsCorrupt {
+		bad := path + ".bad"
+		if err := os.Rename(path, bad); err != nil {
+			return fmt.Errorf("偏好設定損壞，改名為 .bad 失敗：%w", err)
+		}
+		logf("偏好設定損壞，已改名為 %s，用預設並寫入新檔", bad)
+	}
+	return writeAtomic(path, out)
+}
+
+// staleTmpAge 是啟動清理 .prefs-*.tmp 的最小檔齡：崩潰殘留一定比它老，而另一個執行個體正在寫的暫存檔
+// （存在的時間以微秒計）不會被誤刪。
+const staleTmpAge = time.Minute
+
+// cleanStalePrefsTmp 盡力刪除 dir 內崩潰殘留的 .prefs-*.tmp（檔齡超過 staleTmpAge）。
+func cleanStalePrefsTmp(dir string, now time.Time) {
+	matches, _ := filepath.Glob(filepath.Join(dir, ".prefs-*.tmp"))
+	for _, m := range matches {
+		st, err := os.Stat(m)
+		if err != nil || st.IsDir() || now.Sub(st.ModTime()) < staleTmpAge {
+			continue
+		}
+		os.Remove(m)
+	}
+}
+
+// prefsCloseTimeout 是 Close 等背景寫入的上限（docs/spec/006 第 7 節）。
+var prefsCloseTimeout = time.Second
+
+// prefsWriter 在背景 goroutine 寫偏好設定：Submit 合併待套用的補丁，不阻塞 UI 執行緒；
+// 寫入失敗只記一行，行程內狀態不受影響。
+type prefsWriter struct {
+	path string
+	logf func(string, ...any)
+	save prefsWriteFunc
+
+	mu      sync.Mutex
+	pending prefsPatch
+	closed  bool
+	wake    chan struct{}
+	done    chan struct{}
+}
+
+// newPrefsWriter 建立寫入者並盡力清理崩潰殘留的暫存檔。不寫任何東西，直到第一次 Submit。
+func newPrefsWriter(path string, logf func(string, ...any)) *prefsWriter {
+	if logf == nil {
+		logf = func(string, ...any) {}
+	}
+	cleanStalePrefsTmp(filepath.Dir(path), time.Now())
+	w := &prefsWriter{path: path, logf: logf, save: savePrefs, wake: make(chan struct{}, 1), done: make(chan struct{})}
+	go w.loop()
+	return w
+}
+
+// Submit 提交一個欄位補丁（同欄位後者覆蓋、不同欄位保留）。Close 之後的提交被忽略。
+func (w *prefsWriter) Submit(p prefsPatch) {
+	if p.empty() {
+		return
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.closed {
+		return
+	}
+	w.pending = w.pending.merge(p)
+	select { // 持鎖送：Close 在同一把鎖內關閉 wake，不會對已關閉的通道送值
+	case w.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (w *prefsWriter) loop() {
+	defer close(w.done)
+	for range w.wake {
+		w.flush()
+	}
+	w.flush() // Close 之後的最後一份
+}
+
+func (w *prefsWriter) flush() {
+	w.mu.Lock()
+	p := w.pending
+	w.pending = prefsPatch{}
+	w.mu.Unlock()
+	if p.empty() {
+		return
+	}
+	if err := w.save(w.path, p, w.logf); err != nil {
+		w.logf("寫入偏好設定失敗（%s）：%v", p, err)
+	}
+}
+
+// Close 寫完最後一份並結束背景 goroutine，最多等 prefsCloseTimeout（預設 1 秒）；逾時記一行並放棄等待
+// （卡住的寫入留在背景）。可重複呼叫。所有結束路徑都經同一個 quit()，由它呼叫 Close。
+func (w *prefsWriter) Close() {
+	w.mu.Lock()
+	if !w.closed {
+		w.closed = true
+		close(w.wake)
+	}
+	w.mu.Unlock()
+	t := time.NewTimer(prefsCloseTimeout)
+	defer t.Stop()
+	select {
+	case <-w.done:
+	case <-t.C:
+		w.logf("偏好設定尚未寫完，等候 %v 後放棄", prefsCloseTimeout)
+	}
+}
