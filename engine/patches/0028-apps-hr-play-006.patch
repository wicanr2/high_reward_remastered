+// ---- 測試 ----
+
+func TestSwitcherConstants(t *testing.T) {
+	if loadTimeout != 60*time.Second || applyWait != 2*time.Second || errCheckEvery != 60*time.Second || timeoutLimit != 2 || toastLife != 2*time.Second {
+		t.Errorf("常數與規格不符：%v %v %v %d %v", loadTimeout, applyWait, errCheckEvery, timeoutLimit, toastLife)
+	}
+}
+
+func TestSwitcherInitialState(t *testing.T) {
+	r := newRig(t, themeHD, themeHD, themeAI)
+	if r.sw.Current() != themeHD || r.sw.Display() != srcHD || r.sw.State() != stIdle || !r.sw.resident[themeHD] || r.sw.resident[themeAI] {
+		t.Errorf("以 hd 啟動：current ＝ %v、display ＝ %v、resident ＝ %v", r.sw.Current(), r.sw.Display(), r.sw.resident)
+	}
+	if got := r.sw.Usable(); !reflect.DeepEqual(got, []themeID{themeOriginal, themeHD, themeAI}) {
+		t.Errorf("Usable ＝ %v", got)
+	}
+	r = newRig(t, themeOriginal, themeHD)
+	if r.sw.Current() != themeOriginal || r.sw.Display() != srcOriginal || r.sw.resident[themeHD] {
+		t.Errorf("以 original 啟動：%v、%v、%v", r.sw.Current(), r.sw.Display(), r.sw.resident)
+	}
+	r = newRig(t, themeAI, themeHD) // 啟動 theme 不在清單內：退回 original
+	if r.sw.Current() != themeOriginal {
+		t.Errorf("啟動 theme 不在清單內應為 original：%v", r.sw.Current())
+	}
+}
+
+// 成功路徑（original → hd，未常駐）：預載、SetAssets 先於顯示來源變更、新畫面發佈後才換顯示來源、
+// 完成時才提交偏好補丁、HoldAdapt 恰好一取一放。
+func TestSwitcherSuccessPath(t *testing.T) {
+	r := newRig(t, themeOriginal, themeHD)
+	r.press()
+	if r.sw.State() != stLoading {
+		t.Fatalf("F2 之後應為 loading，實際 %v", r.sw.State())
+	}
+	r.wantHold(1, 0)
+	if len(r.commits) != 0 {
+		t.Fatal("不在按鍵當下提交偏好補丁")
+	}
+	r.settle(stApplying)
+	if r.sw.Current() != themeHD || r.sw.Display() != srcOriginal {
+		t.Fatalf("進入 applying：目前 theme 已更新為目標（%v），顯示來源仍是原版（%v）", r.sw.Current(), r.sw.Display())
+	}
+	if r.log.idx("view.SetAssets(hd)") < 0 {
+		t.Fatal("進入 applying 應呼叫 SetAssets(目標)")
+	}
+	r.tick() // 還沒有新畫面
+	if r.sw.State() != stApplying || r.log.idx("display=") >= 0 || len(r.commits) != 0 {
+		t.Fatalf("新畫面發佈之前不該完成：state ＝ %v、日誌 ＝ %v", r.sw.State(), r.log.all())
+	}
+	r.completeApply()
+	if r.sw.Display() != srcHD || !reflect.DeepEqual(r.commitStrings(), []string{"{theme=hd}"}) {
+		t.Errorf("display ＝ %v、commits ＝ %v", r.sw.Display(), r.commitStrings())
+	}
+	r.wantOrder("view.SetAssets(hd)", "display=hd", "log: theme ready: hd", "commit {theme=hd}", "unhold")
+	r.wantHold(1, 1)
+	r.wantCalls(themeHD, "Preload", "ErrorStats") // ErrorStats 只來自進入 applying 的基準讀取；成功路徑不 Release
+	if got := r.toast(langTW); got != "Theme：HD" {
+		t.Errorf("toast ＝ %q", got)
+	}
+	if got := r.toast(langEN); got != "Theme: HD" {
+		t.Errorf("載入完成的 toast 跟著語言：%q", got)
+	}
+	if !r.sw.resident[themeHD] {
+		t.Error("成功的 theme 應成為常駐")
+	}
+}
