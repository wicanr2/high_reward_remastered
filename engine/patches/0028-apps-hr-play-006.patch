+// extremeInfos 是極端輸入：路徑、診斷名、版本字串都拉到遠超過寬度預算，含缺字（不在子集內）、控制字元、
+// 只有空白、結尾空白。
+func extremeInfos() map[string]panelInfo {
+	mk := func(p string) panelInfo {
+		i := normalInfo()
+		i.SaveDir, i.ShotsDir, i.DataDir = p, p+"/screenshots", p
+		return i
+	}
+	out := map[string]panelInfo{
