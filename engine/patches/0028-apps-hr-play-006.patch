+//   - 結尾空白：前進量超過預算，但空白沒有墨跡，墨跡右緣不超過（只有 MeasureString 抓得到）。
+//   - 結尾外溢：前進量不超過預算，但最後一個字形（'f'）的墨跡超出前進量（只有 BoundString 抓得到）。
+//
+// 先確認原始輸入真的如此（控制組），再確認 fitLine 的輸出兩種量法都不超過。
+func TestFitLineEachMeasureHasItsOwnCase(t *testing.T) {
+	for _, l := range langOrder {
+		face := mustFace(t, l)
+
+		pad := "abc" + strings.Repeat(" ", 400) // 半形空白（每個語言的子集都有字形，沒有墨跡）
+		if advanceWidth(face, pad) <= hudW || inkRightEdge(face, pad) > hudW {
+			t.Fatalf("%s：結尾空白案例失效：前進量 %d、墨跡右緣 %d", l, advanceWidth(face, pad), inkRightEdge(face, pad))
+		}
+		got := fitLine(face, pad, hudW)
+		if advanceWidth(face, got) > hudW {
+			t.Errorf("%s：結尾空白案例：fitLine 輸出前進量 %d 超過 %d", l, advanceWidth(face, got), hudW)
+		}
+
+		ink := craftInkOnlyOverflow(t, face, "")
+		if advanceWidth(face, ink) > hudW || inkRightEdge(face, ink) <= hudW {
+			t.Fatalf("%s：結尾外溢案例失效：前進量 %d、墨跡右緣 %d", l, advanceWidth(face, ink), inkRightEdge(face, ink))
+		}
+		got = fitLine(face, ink, hudW)
+		if r := inkRightEdge(face, got); r > hudW {
+			t.Errorf("%s：結尾外溢案例：fitLine 輸出墨跡右緣 %d 超過 %d", l, r, hudW)
+		}
+		if got == ink {
+			t.Errorf("%s：結尾外溢案例：fitLine 沒有縮短墨跡超出預算的行", l)
+		}
+	}
