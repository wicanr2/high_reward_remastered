+// 計時器路徑：載入器永遠不回報，60 秒後計時器觸發、取消 ctx，載入器回 err != nil 且 timerFired 為真：
+// 逾時計數加一、toast 提示；連續第二次逾時才標為不可用；進入 loading 時 timerFired 清除。
+func TestSwitcherTimerTimeoutCountsConsecutive(t *testing.T) {
+	r := newRig(t, themeOriginal, themeHD)
+	l := r.loaders[themeHD]
+	l.mode, l.partial = loadBlockCtx, 3 // 取消時 ok 可大於 0
+	r.press()
+	<-l.started
+	r.clk.advance(59 * time.Second)
+	r.tick()
+	if r.sw.State() != stLoading || r.sw.timerFired {
+		t.Fatalf("59 秒不該逾時：%v、%v", r.sw.State(), r.sw.timerFired)
+	}
+	r.clk.advance(time.Second)
+	r.tick()
+	if r.sw.State() != stCancelling || !r.sw.timerFired {
+		t.Fatalf("60 秒計時器觸發：state ＝ %v、timerFired ＝ %v", r.sw.State(), r.sw.timerFired)
+	}
+	r.settle(stIdle)
+	if r.sw.timeouts[themeHD] != 1 || r.sw.rejected[themeHD] {
+		t.Fatalf("第一次逾時：計數 ＝ %d、rejected ＝ %v", r.sw.timeouts[themeHD], r.sw.rejected[themeHD])
+	}
+	r.wantCalls(themeHD, "Preload", "ErrorStats", "Release")
+	if got := r.toast(langTW); got != tr(langTW, "toast.theme.timeout", "HD") {
+		t.Errorf("逾時 toast ＝ %q", got)
+	}
+	if r.log.idx("逾時") < 0 {
+		t.Error("逾時應記一行")
+	}
+	if len(r.commits) != 0 || r.log.idx("view.SetAssets") >= 0 || r.sw.Current() != themeOriginal {
+		t.Error("逾時不改變狀態、不提交補丁")
+	}
+	r.wantHold(1, 1)
+	if got := r.sw.Usable(); !reflect.DeepEqual(got, []themeID{themeOriginal, themeHD}) {
+		t.Errorf("第一次逾時不標記，仍可再試：%v", got)
+	}
+
+	// 第二次：進入 loading 時 timerFired 清除
+	r.press()
+	if r.sw.State() != stLoading || r.sw.timerFired {
+		t.Fatalf("再次 F2：state ＝ %v、timerFired ＝ %v（進入 loading 應清除）", r.sw.State(), r.sw.timerFired)
+	}
+	<-l.started
+	r.clk.advance(loadTimeout)
+	r.tick()
+	r.settle(stIdle)
+	if r.sw.timeouts[themeHD] != 2 || !r.sw.rejected[themeHD] {
+		t.Fatalf("連續第二次逾時：計數 ＝ %d、rejected ＝ %v", r.sw.timeouts[themeHD], r.sw.rejected[themeHD])
+	}
+	if got := r.sw.Usable(); !reflect.DeepEqual(got, []themeID{themeOriginal}) {
+		t.Errorf("第二次逾時之後不可用：%v", got)
+	}
+	r.wantHold(2, 2)
+	r.clk.advance(3 * time.Second)
+	r.press()
+	if r.toast(langTW) != tr(langTW, "toast.theme.none") {
+		t.Errorf("F2 應提示沒有其他 theme：%q", r.toast(langTW))
+	}
+}
+
+// 中間一次成功則歸零（ai 先逾時一次，再成功）。
+func TestSwitcherSuccessResetsTimeoutCount(t *testing.T) {
+	r := newRig(t, themeOriginal, themeAI)
+	l := r.loaders[themeAI]
+	l.mode = loadBlockCtx
+	r.press()
+	<-l.started
+	r.clk.advance(loadTimeout)
+	r.tick()
+	r.settle(stIdle)
+	if r.sw.timeouts[themeAI] != 1 {
+		t.Fatalf("計數 ＝ %d", r.sw.timeouts[themeAI])
+	}
+	l.mode = loadImmediate
+	r.press()
+	r.settle(stApplying)
+	if r.sw.timeouts[themeAI] != 0 {
+		t.Errorf("成功應使逾時計數歸零，實際 %d", r.sw.timeouts[themeAI])
+	}
+	r.completeApply()
+	r.wantHold(2, 2)
+}
+
+// 「跑完全部後計時器才觸發」：載入器忽略 ctx 跑完（err ＝ nil、ok > 0）→ 接受這份完整的預載，沒有被丟棄，逾時計數歸零。
+func TestSwitcherCompletedPreloadAcceptedAfterTimerFired(t *testing.T) {
+	r := newRig(t, themeOriginal, themeHD)
+	l := r.loaders[themeHD]
+	l.mode, l.ok = loadWaitSignal, 5
+	r.press()
+	<-l.started
+	r.clk.advance(61 * time.Second)
+	r.tick()
+	if r.sw.State() != stCancelling || !r.sw.timerFired {
+		t.Fatalf("計時器應已觸發：%v、%v", r.sw.State(), r.sw.timerFired)
+	}
+	l.open() // 載入器跑完（它沒有理會 ctx）
+	r.settle(stApplying)
+	if r.sw.timeouts[themeHD] != 0 || r.sw.rejected[themeHD] || !r.sw.resident[themeHD] {
+		t.Errorf("完整的預載應被接受：計數 ＝ %d、rejected ＝ %v、resident ＝ %v", r.sw.timeouts[themeHD], r.sw.rejected[themeHD], r.sw.resident[themeHD])
+	}
+	if r.log.count("loader(hd).Release") != 0 {
+		t.Error("沒有被丟棄的完整預載，不該 Release")
+	}
+	if r.log.idx("view.SetAssets(hd)") < 0 {
+		t.Error("應進入 applying 並呼叫 SetAssets")
+	}
+	r.completeApply()
+	r.wantHold(1, 1)
+	if !reflect.DeepEqual(r.commitStrings(), []string{"{theme=hd}"}) {
+		t.Errorf("commits ＝ %v", r.commitStrings())
+	}
+}
