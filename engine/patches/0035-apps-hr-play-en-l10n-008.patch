+func TestGlyphPatchPresenceRejectsSpecialFile(t *testing.T) {
+	root := mkTables(t, "en")
+	dir := addGlyphPatch(t, root, "en")
+	name := filepath.Join(dir, "SOURCE.txt")
+	if err := os.Remove(name); err != nil {
+		t.Fatal(err)
+	}
+	if err := syscall.Mkfifo(name, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if glyphPatchPresent(dir, icEN) {
+		t.Fatal("FIFO 不得視為一般補丁檔案")
+	}
+}
