+func TestPrepareEnglishBuildAndVerifyFallback(t *testing.T) {
+	digest := strings.Repeat("c", 64)
+	for _, tc := range []struct {
+		name                string
+		digestErr, buildErr error
+		resultDigest        string
+	}{
+		{"無效補丁", errors.New("invalid glyph patch"), nil, digest},
+		{"presence 後路徑移除", errors.New("glyph patch path absent"), nil, digest},
+		{"缺預烘字組", nil, errors.New("SP#56: U+0041 U+0042: missing pair"), digest},
+		{"兩次摘要不符", nil, nil, strings.Repeat("d", 64)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			root := mkTables(t, "en")
+			addGlyphPatch(t, root, "en")
+			fb := &fakeBuilder{digest: digest, digestErr: tc.digestErr, buildErr: tc.buildErr, res: mkResult("/packs/en", tc.resultDigest, "table", 17, "en")}
+			in, _ := newInput(t, ingameChoice{Code: icEN}, fb, root)
+			out := prepareIngame(in)
+			if !out.Failed {
+				t.Fatal("錯誤不得啟用包")
+			}
+			if dir, dig := out.langOptions(); dir != "" || dig != "" {
+				t.Fatal("失敗傳出語言層")
+			}
+			e, sf := out.finish(hrrt.LangStatus{}, nil)
+			if e.Kind != effOriginal || sf != (startFail{icEN, reasonBuildFailed}) {
+				t.Fatalf("回退：%+v %+v", e, sf)
+			}
+		})
+	}
+	root := mkTables(t, "en")
+	addGlyphPatch(t, root, "en")
+	fb := &fakeBuilder{digest: digest, res: mkResult("/packs/en", digest, "table", 17, "en")}
+	in, _ := newInput(t, ingameChoice{Code: icEN}, fb, root)
+	out := prepareIngame(in)
+	e, sf := out.finish(hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}, nil)
+	if e.Kind != effOriginal || sf != (startFail{icEN, reasonVerifyFailed}) {
+		t.Fatalf("Open 驗證失敗回退：%+v %+v", e, sf)
+	}
+}
