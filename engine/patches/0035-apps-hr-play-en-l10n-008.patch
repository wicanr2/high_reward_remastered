+// ingameProbe 保留同一次來源選擇的實際路徑。補丁只取該表目錄，不能到較低優先來源補齊。
+type ingameProbe struct {
+	TableDir, PatchDir    string
+	HasTable, PatchInHand bool
+}
+
+func probeIngame(s l10n.TableSearch, c ingameCode) ingameProbe {
+	if !c.inCycle() {
+		return ingameProbe{}
+	}
+	root, ok := l10n.FindTableDirFor(s, string(c))
+	if !ok {
+		return ingameProbe{}
+	}
+	dir, ok := l10n.TableDirFor(root, string(c))
+	if !ok {
+		return ingameProbe{}
+	}
+	p := ingameProbe{TableDir: dir, HasTable: true}
+	if l2SupportedFor(c) {
+		p.PatchDir = filepath.Join(dir, "glyph-patch")
+		p.PatchInHand = glyphPatchPresent(p.PatchDir, c)
+	}
+	return p
+}
+
+// glyphPatchPresent 只探測五檔的一般檔案形態，不讀內容；完整驗證由建置器的 Load 執行。
+func glyphPatchPresent(dir string, c ingameCode) bool {
+	info, err := os.Lstat(dir)
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return false
+	}
+	// 先核對實際目錄項目名稱，避免大小寫不敏感的平台把錯誤拼字視為精確檔名。
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return false
+	}
+	names := make(map[string]bool, len(entries))
+	for _, entry := range entries {
+		names[entry.Name()] = true
+	}
+	for _, name := range []string{"glyphs-" + string(c) + ".bin", "charmap-" + string(c) + ".tsv", "reserved-codes.tsv", "OFL.txt", "SOURCE.txt"} {
+		if !names[name] {
+			return false
+		}
+		info, err := os.Lstat(filepath.Join(dir, name))
+		if err != nil || !info.Mode().IsRegular() {
+			return false
+		}
+	}
+	return true
+}
+
+// availabilityFunc 與啟動共用逐語言支援和同源補丁探測。game 只快取到下一次 F4。
+func availabilityFunc(s l10n.TableSearch) availFn {
+	return func(c ingameCode) availResult {
+		p := probeIngame(s, c)
+		return availFor(c, func(ingameCode) bool { return p.HasTable }, l2SupportedFor(c), p.PatchInHand)
+	}
+}
