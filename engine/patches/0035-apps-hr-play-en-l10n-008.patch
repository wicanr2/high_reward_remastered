+func TestPrepareIngameProductionPerCode(t *testing.T) {
+	for _, code := range ingameCycle {
+		for _, tables := range []bool{false, true} {
+			for _, patch := range []bool{false, true} {
+				root := mkTables(t)
+				if tables {
+					addTable(t, root, string(code))
+				}
+				if patch {
+					addGlyphPatch(t, root, string(code))
+				}
+				fb := &fakeBuilder{digest: strings.Repeat("a", 64), res: mkResult("/packs/p", strings.Repeat("a", 64), "table", 1, string(code))}
+				in, _ := newInput(t, ingameChoice{Code: code}, fb, root)
+				out := prepareIngame(in)
+				want := planIngame(in.Choice, tables, code == icEN, patch)
+				if out.Plan != want {
+					t.Fatalf("code=%s table=%v patch=%v: %+v want=%+v", code, tables, patch, out.Plan, want)
+				}
+				wantCalls := 0
+				if want.Kind == planTable {
+					wantCalls = 2
+				}
+				if fb.calls() != wantCalls {
+					t.Fatalf("%s calls=%d want=%d", code, fb.calls(), wantCalls)
+				}
+				if got := availabilityFunc(in.Search)(code); got != availFor(code, func(ingameCode) bool { return tables }, code == icEN, patch) {
+					t.Fatalf("%s：啟動和 F4 探測不同：%+v", code, got)
+				}
+			}
+		}
+	}
+}
+
+func TestPrepareEnglishConfigAndZeroAdoption(t *testing.T) {
+	for _, explicit := range []bool{false, true} {
+		for _, adopted := range []int{0, 17} {
+			root := mkTables(t, "en")
+			patch := addGlyphPatch(t, root, "en")
+			digest := strings.Repeat("b", 64)
+			fb := &fakeBuilder{digest: digest, res: mkResult("/packs/en", digest, "table", adopted, "en")}
+			in, _ := newInput(t, ingameChoice{icEN, explicit}, fb, root)
+			out := prepareIngame(in)
+			if out.Failed || len(fb.cfgs) != 2 || !reflect.DeepEqual(fb.cfgs[0], fb.cfgs[1]) {
+				t.Fatalf("建置設定不一致：%+v %+v", out, fb.cfgs)
+			}
+			cfg := fb.cfgs[0]
+			if cfg.Code != "en" || cfg.Mode != l10n.ModeTable || cfg.TableDir != filepath.Join(root, "en") || cfg.PatchDir != patch || cfg.Policy != (l10n.Policy{}) {
+				t.Fatalf("英文設定：%+v", cfg)
+			}
+			e, sf := out.finish(hrrt.LangStatus{LangDir: out.LangDir}, nil)
+			want := partial(icEN)
+			if adopted == 0 {
+				want = verifyUse(icEN)
+			}
+			status := ingameStatus(icEN, e, sf, explicit, availabilityFunc(in.Search))
+			toast := toastSame
+			if explicit {
+				toast = toastFlag
+			}
+			if status.F1 != want || status.Toast != toast {
+				t.Fatalf("英文零／正採用：%+v want=%+v toast=%d", status, want, toast)
+			}
+		}
+	}
+}
+
+func TestEnglishConfigUsesActualTableDirectory(t *testing.T) {
+	root := mkTables(t, "en")
+	addGlyphPatch(t, root, "en")
+	actual := filepath.Join(root, "EN")
+	if err := os.Rename(filepath.Join(root, "en"), actual); err != nil {
+		t.Fatal(err)
+	}
+	digest := strings.Repeat("e", 64)
+	fb := &fakeBuilder{digest: digest, res: mkResult("/packs/en", digest, "table", 17, "en")}
+	in, _ := newInput(t, ingameChoice{Code: icEN}, fb, root)
+	out := prepareIngame(in)
+	if out.Failed || fb.calls() != 2 {
+		t.Fatalf("大小寫不同的實際表目錄：%+v", out)
+	}
+	for _, cfg := range fb.cfgs {
+		if cfg.TableDir != actual || cfg.PatchDir != filepath.Join(actual, "glyph-patch") {
+			t.Fatalf("必須使用 FindTableDirFor 所选的實際路徑：%+v", cfg)
+		}
+	}
+}
