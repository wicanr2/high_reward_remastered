+func TestEnglishProbeDoesNotMixSources(t *testing.T) {
+	high, low := mkTables(t, "en"), mkTables(t, "en")
+	lowPatch := addGlyphPatch(t, low, "en")
+	search := l10n.TableSearch{Flag: high, Env: low}
+	p := probeIngame(search, icEN)
+	if !p.HasTable || p.TableDir != filepath.Join(high, "en") || p.PatchDir != filepath.Join(high, "en", "glyph-patch") || p.PatchInHand {
+		t.Fatalf("補丁不得取自低優先來源：%+v", p)
+	}
+	fb := &fakeBuilder{}
+	out := prepareIngame(ingameInput{Choice: ingameChoice{Code: icEN}, Search: search, Builder: fb})
+	if out.Plan != (ingamePlan{Kind: planNone, Reason: reasonNoPatch}) || fb.calls() != 0 {
+		t.Fatalf("缺同源補丁應零建置：%+v calls=%d", out, fb.calls())
+	}
+	if err := os.Remove(filepath.Join(high, "en", "SP.MES.tsv")); err != nil {
+		t.Fatal(err)
+	}
+	p = probeIngame(search, icEN)
+	if p.HasTable {
+		t.Fatalf("明示來源存在但沒有表時不得往下找：%+v", p)
+	}
+	search.Flag = ""
+	p = probeIngame(search, icEN)
+	if p.TableDir != filepath.Join(low, "en") || p.PatchDir != lowPatch || !p.PatchInHand {
+		t.Fatalf("沒有明示來源時才選一般候選：%+v", p)
+	}
+	search = l10n.TableSearch{Env: high, ExeDir: filepath.Dir(low)}
+	p = probeIngame(search, icEN)
+	if p.TableDir != filepath.Join(low, "en") || p.PatchDir != lowPatch || !p.PatchInHand {
+		t.Fatalf("一般高優先來源沒有表才改選完整低優先來源：%+v", p)
+	}
+}
