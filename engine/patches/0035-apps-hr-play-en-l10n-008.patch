+func TestGameEnglishPatchRecomputedAtF4(t *testing.T) {
+	root := mkTables(t, "en")
+	gr := newGameRig(t, themeOriginal, nil, withLang(langEN), withIngame(ingameRuntime{Avail: availabilityFunc(l10n.TableSearch{Flag: root})}))
+	gr.prime()
+	if got := gr.g.panelBase().Ingame; got != unusable(icEN, reasonNoPatch) {
+		t.Fatalf("初次缺補丁：%+v", got)
+	}
+	patch := addGlyphPatch(t, root, "en")
+	if got := gr.g.panelBase().Ingame; got != unusable(icEN, reasonNoPatch) {
+		t.Fatalf("F1 不該每幀探測：%+v", got)
+	}
+	for i := 0; i < 5; i++ {
+		gr.mustFrame(ebiten.KeyF4)
+	}
+	if gr.g.ing.E.Kind != effOriginal {
+		t.Fatal("F4 不得即時改遊戲內語言")
+	}
+	if got := gr.g.panelBase().Ingame; got != pending(icEN) {
+		t.Fatalf("F4 應提示下次啟動：%+v", got)
+	}
+	if got := gr.toastNow(); got != expectedToast(langEN, toastNext) {
+		t.Fatalf("toast=%q", got)
+	}
+	if err := os.Remove(filepath.Join(patch, "SOURCE.txt")); err != nil {
+		t.Fatal(err)
+	}
+	if got := gr.g.panelBase().Ingame; got != pending(icEN) {
+		t.Fatalf("F1 快取：%+v", got)
+	}
+	for i := 0; i < 5; i++ {
+		gr.mustFrame(ebiten.KeyF4)
+	}
+	if got := gr.g.panelBase().Ingame; got != unusable(icEN, reasonNoPatch) {
+		t.Fatalf("移除補丁後：%+v", got)
+	}
+}
+
+func TestGameEnglishZeroAdoptionPanelAndF4(t *testing.T) {
+	gr := newGameRig(t, themeOriginal, nil, withLang(langEN), withIngame(ingameRuntime{E: effective{effIdentityPack, icEN}}))
+	gr.prime()
+	if got := gr.f1Line(); got != expectedF1(langEN, verifyUse(icEN)) {
+		t.Fatalf("零採用須標驗證用：%q", got)
+	}
+	for i := 0; i < 5; i++ {
+		gr.mustFrame(ebiten.KeyF4)
+	}
+	if got := gr.toastNow(); got != expectedToast(langEN, toastSame) {
+		t.Fatalf("同一零採用英文包：%q", got)
+	}
+	if got := gr.f1Line(); got != expectedF1(langEN, verifyUse(icEN)) {
+		t.Fatalf("F4 後零採用：%q", got)
+	}
+}
