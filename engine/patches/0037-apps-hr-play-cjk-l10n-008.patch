+func TestCJKProbeUsesSameSourceAndCode(t *testing.T) {
+	for _, code := range []ingameCode{icCN, icJA} {
+		t.Run(string(code), func(t *testing.T) {
+			high, low := mkTables(t, string(code)), mkTables(t, string(code))
+			lowPatch := addGlyphPatch(t, low, string(code))
+			search := l10n.TableSearch{Flag: high, Env: low}
+			p := probeIngame(search, code)
+			if p.TableDir != filepath.Join(high, string(code)) || p.PatchDir != filepath.Join(p.TableDir, "glyph-patch") || !p.HasTable || p.PatchInHand {
+				t.Fatalf("不得混用較低優先來源：%+v", p)
+			}
+			fb := &fakeBuilder{}
+			out := prepareIngame(ingameInput{Choice: ingameChoice{Code: code}, Search: search, Builder: fb})
+			if out.Plan != (ingamePlan{Kind: planNone, Reason: reasonNoPatch}) || fb.calls() != 0 {
+				t.Fatalf("缺同源補丁應零建置：%+v calls=%d", out, fb.calls())
+			}
+			search.Flag = ""
+			search.Env = low
+			if p = probeIngame(search, code); p.PatchDir != lowPatch || !p.PatchInHand {
+				t.Fatalf("應選完整同源補丁：%+v", p)
+			}
+			// 五檔中的語言檔名必須符合該語言，不能拿英文檔名滿足 presence。
+			for _, ext := range []struct{ prefix, suffix string }{{"glyphs-", ".bin"}, {"charmap-", ".tsv"}} {
+				if err := os.Rename(filepath.Join(lowPatch, ext.prefix+string(code)+ext.suffix), filepath.Join(lowPatch, ext.prefix+"en"+ext.suffix)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if probeIngame(search, code).PatchInHand {
+				t.Fatal("不同代碼的五檔不得通過 presence")
+			}
+		})
+	}
+}
+
+func TestPrepareCJKConfigAndAdoption(t *testing.T) {
+	for _, code := range []ingameCode{icCN, icJA} {
+		for _, explicit := range []bool{false, true} {
+			for _, adopted := range []int{0, 17} {
+				root := mkTables(t, string(code))
+				addGlyphPatch(t, root, string(code))
+				actual := filepath.Join(root, strings.ToUpper(string(code)))
+				if err := os.Rename(filepath.Join(root, string(code)), actual); err != nil {
+					t.Fatal(err)
+				}
+				digest := strings.Repeat("a", 64)
+				fb := &fakeBuilder{digest: digest, res: mkResult("/packs/"+string(code), digest, "table", adopted, string(code))}
+				in, _ := newInput(t, ingameChoice{code, explicit}, fb, root)
+				out := prepareIngame(in)
+				if out.Failed || out.Plan.Kind != planTable || len(fb.cfgs) != 2 || !reflect.DeepEqual(fb.cfgs[0], fb.cfgs[1]) {
+					t.Fatalf("%s：兩次建包設定不一致：%+v %+v", code, out, fb.cfgs)
+				}
+				cfg := fb.cfgs[0]
+				if cfg.Code != string(code) || cfg.Mode != l10n.ModeTable || cfg.TableDir != actual || cfg.PatchDir != filepath.Join(actual, "glyph-patch") || cfg.Policy != (l10n.Policy{}) {
+					t.Fatalf("%s：實際同源設定不符：%+v", code, cfg)
+				}
+				e, sf := out.finish(hrrt.LangStatus{LangDir: out.LangDir}, nil)
+				want, toast := partial(code), toastSame
+				if adopted == 0 {
+					want = verifyUse(code)
+				}
+				if explicit {
+					toast = toastFlag
+				}
+				if got := ingameStatus(code, e, sf, explicit, availabilityFunc(in.Search)); got.F1 != want || got.Toast != toast {
+					t.Fatalf("%s：採用 %d 狀態不符：%+v", code, adopted, got)
+				}
+			}
+		}
+	}
+}
