+func TestPrepareCJKFailuresUseOriginal(t *testing.T) {
+	for _, code := range []ingameCode{icCN, icJA} {
+		for _, tc := range []struct {
+			name                string
+			digestErr, buildErr error
+			mismatch            bool
+		}{
+			{"invalid-patch", errors.New("invalid glyph patch"), nil, false},
+			{"removed-after-presence", errors.New("glyph patch absent"), nil, false},
+			{"missing-scalar", nil, errors.New("SP#56: U+2605: missing scalar"), false},
+			{"changed-digest", nil, nil, true},
+		} {
+			t.Run(string(code)+"/"+tc.name, func(t *testing.T) {
+				root := mkTables(t, string(code))
+				addGlyphPatch(t, root, string(code))
+				digest, resultDigest := strings.Repeat("b", 64), strings.Repeat("b", 64)
+				if tc.mismatch {
+					resultDigest = strings.Repeat("c", 64)
+				}
+				fb := &fakeBuilder{digest: digest, digestErr: tc.digestErr, buildErr: tc.buildErr, res: mkResult("/packs/p", resultDigest, "table", 17, string(code))}
+				in, _ := newInput(t, ingameChoice{Code: code}, fb, root)
+				out := prepareIngame(in)
+				dir, dig := out.langOptions()
+				e, sf := out.finish(hrrt.LangStatus{}, nil)
+				if !out.Failed || dir != "" || dig != "" || e.Kind != effOriginal || sf != (startFail{code, reasonBuildFailed}) {
+					t.Fatalf("失敗應回原版：%+v %q %q %+v %+v", out, dir, dig, e, sf)
+				}
+			})
+		}
+		root := mkTables(t, string(code))
+		addGlyphPatch(t, root, string(code))
+		digest := strings.Repeat("d", 64)
+		fb := &fakeBuilder{digest: digest, res: mkResult("/packs/p", digest, "table", 17, string(code))}
+		in, _ := newInput(t, ingameChoice{Code: code}, fb, root)
+		out := prepareIngame(in)
+		e, sf := out.finish(hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}, nil)
+		if e.Kind != effOriginal || sf != (startFail{code, reasonVerifyFailed}) {
+			t.Fatalf("%s：Session.Open 驗證失敗應回原版：%+v %+v", code, e, sf)
+		}
+	}
+}
+
+func TestCJKZeroAdoptionSelectionRelations(t *testing.T) {
+	for _, code := range []ingameCode{icCN, icJA} {
+		e := effective{effIdentityPack, code}
+		for _, selected := range ingameValues {
+			want := selected == code || selected == icTW || selected == icIdentity
+			if got := sameSelection(selected, e, func(ingameCode) availResult { t.Fatal("不應探測可用性"); return availResult{} }); got != want {
+				t.Fatalf("S=%s E=%s：same=%v want=%v", selected, code, got, want)
+			}
+		}
+	}
+}
+
+func TestGameCJKPatchAtF4AndZeroAdoption(t *testing.T) {
+	for _, code := range []ingameCode{icCN, icJA} {
+		root := mkTables(t, string(code))
+		language := lang(code)
+		gr := newGameRig(t, themeOriginal, nil, withLang(language), withIngame(ingameRuntime{Avail: availabilityFunc(l10n.TableSearch{Flag: root})}))
+		gr.prime()
+		if got := gr.g.panelBase().Ingame; got != unusable(code, reasonNoPatch) {
+			t.Fatalf("%s：初次缺補丁：%+v", code, got)
+		}
+		patch := addGlyphPatch(t, root, string(code))
+		if got := gr.g.panelBase().Ingame; got != unusable(code, reasonNoPatch) {
+			t.Fatal("F1 應沿用快取")
+		}
+		for i := 0; i < len(langOrder); i++ {
+			gr.mustFrame(ebiten.KeyF4)
+		}
+		if gr.g.ing.E.Kind != effOriginal || gr.g.panelBase().Ingame != pending(code) || gr.toastNow() != expectedToast(language, toastNext) {
+			t.Fatalf("%s：F4 只應提示下次啟動", code)
+		}
+		if err := os.Remove(filepath.Join(patch, "SOURCE.txt")); err != nil {
+			t.Fatal(err)
+		}
+		if gr.g.panelBase().Ingame != pending(code) {
+			t.Fatal("F4 之前應沿用快取")
+		}
+		for i := 0; i < len(langOrder); i++ {
+			gr.mustFrame(ebiten.KeyF4)
+		}
+		if gr.g.panelBase().Ingame != unusable(code, reasonNoPatch) {
+			t.Fatalf("%s：移除補丁未重探", code)
+		}
+		zero := newGameRig(t, themeOriginal, nil, withLang(language), withIngame(ingameRuntime{E: effective{effIdentityPack, code}}))
+		zero.prime()
+		for i := 0; i < len(langOrder); i++ {
+			zero.mustFrame(ebiten.KeyF4)
+		}
+		if zero.f1Line() != expectedF1(language, verifyUse(code)) || zero.toastNow() != expectedToast(language, toastSame) {
+			t.Fatalf("%s：零採用應為驗證用、F4 不變", code)
+		}
+	}
+}
