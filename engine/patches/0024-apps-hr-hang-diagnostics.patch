+func TestKnownRoutinesTable(t *testing.T) {
+	s := openDiag(t, Options{Interval: NativeInterval})
+	ida := map[uint32]uint32{ // 執行期 → IDA（docs/spec/005 第 11 節）
+		0x1C57_0022: 0x2B47_0022, 0x1FA2_0414: 0x2E92_0414, 0x1FA2_066A: 0x2E92_066A, 0x259F_0005: 0x348F_0005,
+		0x234A_000A: 0x323A_000A, 0x20C2_25A1: 0x2FB2_25A1, 0x24BD_0D3E: 0x33AD_0D3E, 0x2378_112A: 0x3268_112A,
+		0x2378_1155: 0x3268_1155, 0x2378_12D0: 0x3268_12D0, 0x2378_139D: 0x3268_139D, 0x1D11_000A: 0x2C01_000A,
+		0x1D29_000E: 0x2C19_000E, 0x1F69_000E: 0x2E59_000E, 0x1F69_00B5: 0x2E59_00B5, 0x1F69_0169: 0x2E59_0169,
+		0x1C35_01C5: 0x2B25_01C5,
+	}
+	if len(knownRoutines) != len(ida) {
+		t.Fatalf("註記表 %d 項，預期 %d", len(knownRoutines), len(ida))
+	}
+	prologue := []byte{0xC8, 0x00, 0x00, 0x00, 0x56, 0x57, 0x1E, 0x06}
