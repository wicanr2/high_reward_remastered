@@ -0,0 +1,17 @@
+package runtime
+
+import "testing"
+
+// 診斷功能（docs/spec/005）上線後的對照：NoDiag（應約等於 A，量出新增分支本身的成本）與前端實際的
+// Options（T2 開啟、DiagDir 設定）。基準提交（A）沒有這些欄位，所以放在獨立檔案。
+func BenchmarkRunStepsDiag(b *testing.B) {
+	front := func(b *testing.B) Options {
+		return Options{Interval: NativeInterval, HangSeconds: 30, DiagDir: b.TempDir()}
+	}
+	b.Run("cold-nodiag", func(b *testing.B) { benchSteps(b, Options{Interval: NativeInterval, NoDiag: true}, "", false, 200_000_000) })
+	b.Run("cold-frontend", func(b *testing.B) { benchSteps(b, front(b), "", false, 200_000_000) })
+	b.Run("battle-nodiag", func(b *testing.B) {
+		benchSteps(b, Options{Interval: NativeInterval, NoDiag: true}, benchState(b), true, 100_000_000)
+	})
+	b.Run("battle-frontend", func(b *testing.B) { benchSteps(b, front(b), benchState(b), true, 100_000_000) })
+}
