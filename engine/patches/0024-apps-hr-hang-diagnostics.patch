+// hangHarness 開一個 HangSeconds 較短的 Session，跑到標題輪詢點，回傳記錄 OnDiag 的容器。
+type hangHarness struct {
+	s    *Session
+	dirs []string
+	n    atomic.Int32
+}
+
+func newHang(t *testing.T, seconds float64) *hangHarness {
+	t.Helper()
+	h := &hangHarness{}
+	h.s = openDiag(t, Options{
+		DiagDir: filepath.Join(t.TempDir(), "crash"), HangSeconds: seconds,
+		OnDiag: func(dir, reason string) { h.dirs = append(h.dirs, dir); h.n.Add(1) },
+	})
+	st, polled := h.s.RunToPoll(200_000_000)
+	if (st != nil && st.Kind != StopSteps) || !polled {
+		t.Fatalf("沒走到標題輪詢點：%v %v", st, polled)
+	}
+	if h.n.Load() != 0 {
+		t.Fatal("冷啟動走到輪詢點的過程不該報 hang")
+	}
+	return h
+}
+
+// run 跑 gs 個遊戲秒當量的步數（以目前 interval 換算）。
+func (h *hangHarness) run(t *testing.T, gs float64) {
+	t.Helper()
+	steps := uint64(gs * TickHz * float64(h.s.interval))
+	if st := h.s.RunSteps(h.s.m.Steps + steps); st.Kind != StopSteps {
+		t.Fatalf("停機：%v", st.Msg)
+	}
+}
+
+func (h *hangHarness) patchHere(code ...byte) (cs, ip uint16) {
+	c := h.s.m.CPU
+	cs, ip = c.Seg[cpu.CS], c.IP
+	h.s.m.WriteBytes(cpu.Linear(cs, ip), code)
+	return
+}
+
+func (h *hangHarness) checkOne(t *testing.T, cs, ip uint16) string {
+	t.Helper()
+	if got := h.n.Load(); got != 1 {
+		t.Fatalf("OnDiag 呼叫 %d 次，預期 1", got)
+	}
+	b, err := os.ReadFile(filepath.Join(h.dirs[0], "info.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(b)
+	hasInfoSections(t, text, "== 迴圈取樣")
+	if !strings.HasSuffix(h.dirs[0], "-hang") {
+		t.Errorf("目錄名應以 -hang 結尾：%s", h.dirs[0])
+	}
+	return text[strings.Index(text, "== 迴圈取樣"):]
+}
