+// 停機與 hang 的診斷紀錄（docs/spec/005）。
+//
+// 這裡的紀錄都只由持有機器的迴圈寫入；它們只讀機器，不改機器狀態。
+// 診斷輸出含原版的位元組、畫面與狀態，是原版內容的衍生物，不要提交或散布。
+
+const (
+	diagMarker   = "高報酬戰將 診斷紀錄 v1"
+	callRingSize = 1024 // 主環：最近的原始呼叫事件
+	intRingSize  = 256
+	distinctSize = 256 // 第二結構：直接對映的「不同呼叫目標」
+	nameRingSize = 8
+	sampleSteps  = 4096
+	maxHangDumps = 3
+	manualMinGap = 5 * time.Second
+	keepDiagDirs = 6
+
+	videoLinear = machine.VideoSeg * 16 // 起點在這之上不分類
+	dgroupSeg   = 0x540F                // DGROUP；overlay 緩衝區與堆疊都在這之上
+	residentLo  = 0x0110                // 常駐映像的起點（IDA 1000）
+	idaDelta    = 0x0EF0                // IDA 段 ＝ 常駐碼的執行期段 ＋ 這個值（docs/re/007 第 8 節）
+	noOvr       = 0xFFFF
+)
+
+type callKind byte
+
+const (
+	ckNear    callKind = 'N' // E8
+	ckFar     callKind = 'F' // 9A
+	ckNearInd callKind = 'n' // FF /2
+	ckFarInd  callKind = 'f' // FF /3
+)
+
+func (k callKind) String() string {
+	switch k {
+	case ckNear:
+		return "call near"
+	case ckFar:
+		return "call far"
+	case ckNearInd:
+		return "call near 間接"
+	case ckFarInd:
+		return "call far 間接"
+	}
+	return "?"
+}
+
+// pushBytes 是這種呼叫在堆疊上放的位元組數。
+func (k callKind) pushBytes() uint16 {
+	if k == ckFar || k == ckFarInd {
+		return 4
+	}
+	return 2
+}
+
+// callEvent 是一次呼叫。fromOvr、toOvr 是記錄當下查到的 overlay 編號（overlay 之後會被換出，傾印時才查會標錯）。
+type callEvent struct {
+	step           uint64
+	kind           callKind
+	fromCS, fromIP uint16
+	toCS, toIP     uint16
+	sp             uint16 // 呼叫前的 SP
+	count          uint32
+	fromOvr, toOvr uint16
+}
+
+// intEvent 是一次遊戲碼發出的服務中斷。
+type intEvent struct {
+	step         uint64
+	n            uint8
+	ax           uint16
+	cs, ip       uint16 // INT 指令的起點（CPU.Op）
+	sp           uint16
+	count        uint32
+	hasRet       bool // CS ＝ SS（_int86x 的堆疊 stub）時記返回位址
+	retCS, retIP uint16
+	stubK        int // int 3Fh：入口序號；-1 ＝ stub 標頭重載；-2 ＝ 不是 int 3Fh
+	w            uint16
+}
+
+type distinctEntry struct {
+	toCS, toIP uint16
+	step       uint64
+	count      uint64
+	toOvr      uint16
+	used       bool
+}
+
+type nameEntry struct {
+	name string
+	step uint64
+}
+
+// sampleResult 是 T2 取樣的結果。
+type sampleResult struct {
+	hist  map[uint32]uint32
+	taken int // 實際取到的步數
+}
+
+// diagState 是 Session 的診斷狀態。
+type diagState struct {
+	calls   [callRingSize]callEvent
+	callN   uint64
+	noteN   uint64 // noteCall 被呼叫的次數（候選指令的頻率，量成本用）
+	ints    [intRingSize]intEvent
+	intN    uint64
+	distinc [distinctSize]distinctEntry
+
+	entryBits [1024]uint64
+	entryCnt  map[uint32]uint64
+
+	intCount    [256]uint64
+	names       [nameRingSize]nameEntry
+	nameN       uint64
+	lastSvcStep uint64
+	lastPoll    uint64 // 最後一次 int 33h AX＝3 的步數
+	svcSeen     bool
+
+	init      bool
+	lastAfter uint64
+	silentSec float64
+	maxSilent float64
+	evals     uint64
+	hangArmed bool
+	hangDumps int
+
+	sampleLeft   int
+	sampleActive bool
+	sampleHist   map[uint32]uint32
+
+	lastManual time.Time
+	diagReq    atomic.Bool
+	diagReason atomic.Value // string
+}
+
+// opClass 是指令起點位元組的分類：0 不理，clsCall ＝ E8、9A、FF，clsPrefix ＝ 前綴，clsAll 只在取樣期間（每步都進）。
+const (
+	clsCall   = 1
+	clsPrefix = 2
+	clsAll    = 3
+)
+
+var opClass [256]uint8
+
+func init() {
+	for _, b := range []byte{0xE8, 0x9A, 0xFF} {
+		opClass[b] = clsCall // 呼叫候選
+	}
+	for _, b := range []byte{0x26, 0x2E, 0x36, 0x3E, 0x64, 0x65, 0x66, 0xF0, 0xF1, 0xF2, 0xF3} {
+		opClass[b] = clsPrefix // 前綴：繪圖迴圈裡很常見，下一個位元組也是呼叫候選才進完整分類
+	}
+}
+
+// zeroClass、allClass 是 opClass 的另外兩張表：NoDiag 時永遠不分類，取樣期間每一步都進 noteCall 記直方圖。
+var zeroClass, allClass [256]uint8
+
+func init() {
+	for i := range allClass {
+		allClass[i] = clsAll
+	}
+}
+
+// classifyCall 判斷 code（指令起點起至少 16 個位元組）是不是呼叫。純函式。
+// 前綴集合與 internal/cpu/ops.go 一致；出現 66 不分類（這支 CPU 對 66 E8、66 9A、66 FF 回 CPU 錯誤）。
+func classifyCall(code []byte) (callKind, bool) {
+	i := 0
+loop:
+	for ; i < 15 && i < len(code); i++ {
+		switch code[i] {
+		case 0x26, 0x2E, 0x36, 0x3E, 0x64, 0x65, 0xF0, 0xF1, 0xF2, 0xF3:
+			continue
+		case 0x66:
+			return 0, false
+		default:
+			break loop
+		}
+	}
+	if i >= 15 || i >= len(code) {
+		return 0, false
+	}
+	switch code[i] {
+	case 0xE8:
+		return ckNear, true
+	case 0x9A:
+		return ckFar, true
+	case 0xFF:
+		if i+1 >= len(code) {
+			return 0, false
+		}
+		switch (code[i+1] >> 3) & 7 {
+		case 2:
+			return ckNearInd, true
+		case 3:
+			return ckFarInd, true
+		}
+	}
+	return 0, false
+}
+
+// knownRoutines 是註記表（docs/spec/005 第 11 節）：執行期位址 → 一行用途。
+// 註記是導覽名稱，不是證據；位址、位元組、推論等級以 docs/re/009 為準。
+var knownRoutines = map[uint32]string{
+	0x1C57_0022: "精靈貼圖入口",
+	0x1FA2_0414: "LZSS 直接解碼進 VRAM（平面順序）",
+	0x1FA2_066A: "LZSS 解碼進 VRAM（遮罩在列首，BSTAGE）",
+	0x259F_0005: "packed 4bpp 轉平面寫進 VRAM（GS、FACE、VS）",
+	0x234A_000A: "PXZ 戰場地圖",
+	0x20C2_25A1: "GMAP.PXS 串流讀取並解 LZSS 寫 VRAM",
+	0x24BD_0D3E: "從檔案 handle 讀並解 LZSS 到記憶體",
+	0x2378_112A: "24x24 遮罩精靈資料複製到程式碼段快取",
+	0x2378_1155: "從程式碼段快取貼 24x24 遮罩精靈",
+	0x2378_12D0: "24 列背景存到程式碼段",
+	0x2378_139D: "還原上一項的背景",
+	0x1D11_000A: "垂直線",
+	0x1D29_000E: "水平線",
+	0x1F69_000E: "把 VRAM 矩形存到記憶體",
+	0x1F69_00B5: "從保存區寫回 VRAM 的新位置",
+	0x1F69_0169: "從保存區寫回原位置",
+	0x1C35_01C5: "16 列字形寫入",
+}
+
+func entryFilterIdx(cs, ip uint16) (word int, bit uint64) {
+	i := (uint32(cs)*16 + uint32(ip)) & 0xFFFF
+	return int(i >> 6), 1 << (i & 63)
+}
+
+// initDiag 在 Open 的尾端呼叫：註記表的篩與計數、包裝 IntHook。
+func (s *Session) initDiag() {
+	d := &s.dg
+	d.entryCnt = map[uint32]uint64{}
+	for k := range knownRoutines {
+		w, b := entryFilterIdx(uint16(k>>16), uint16(k))
+		d.entryBits[w] |= b
+	}
+	d.hangArmed = true
+	s.cls = &opClass
+	if s.opt.NoDiag {
+		s.cls = &zeroClass
+	}
+	if s.opt.NoDiag {
+		return
+	}
+	orig := s.m.CPU.IntHook
+	s.m.CPU.IntHook = func(c *cpu.CPU, n uint8) bool {
+		s.noteInt(c, n)
+		if orig != nil {
+			return orig(c, n)
+		}
+		return false
+	}
+}
+
+// ovrIdxOfCS 回傳 CS 所在 overlay 的編號（沒有就 noOvr）。判定：(CS−1)×16＋0Eh 處的字組是某個 stub 的執行期段
+// （docs/re/007 第 8 節，強推論）。
+func (s *Session) ovrIdxOfCS(cs uint16) uint16 {
+	if cs < dgroupSeg || cs == s.stackSeg {
+		return noOvr
+	}
+	stub := s.m.Peek16(cpu.Linear(cs-1, 0x0E))
+	if o, ok := ovrByStub(stub); ok {
+		return o.Idx
+	}
+	return noOvr
+}
+
+// ovrByStub 在 ovrStubs（依 StubSeg 遞增）內二分搜尋。
+func ovrByStub(seg uint16) (ovrStub, bool) {
+	i := sort.Search(len(ovrStubs), func(i int) bool { return ovrStubs[i].StubSeg >= seg })
+	if i < len(ovrStubs) && ovrStubs[i].StubSeg == seg {
+		return ovrStubs[i], true
+	}
+	return ovrStub{}, false
+}
+
+func ovrByIdx(idx uint16) (ovrStub, bool) {
+	for _, o := range ovrStubs {
+		if o.Idx == idx {
+			return o, true
+		}
+	}
+	return ovrStub{}, false
+}
+
+// noteCall 在 Step 成功之後呼叫：a 是本道指令起點的線性位址（< 0xA0000）。
+func (s *Session) noteCall() {
+	m := s.m
+	s.dg.noteN++
+	cs, ip := m.CPU.Op()
+	if s.dg.sampleLeft > 0 { // 取樣期間每一步都進來（allClass）：先記直方圖
+		s.sampleOp(cs, ip)
+	}
+	a := cpu.Linear(cs, ip) & (machine.MemSize - 1)
+	if a > machine.MemSize-16 {
+		return
+	}
+	kind, ok := classifyCall(m.Mem[a : a+16])
+	if !ok {
+		return
+	}
+	c := m.CPU
+	d := &s.dg
+	toCS, toIP := c.Seg[cpu.CS], c.IP
+	sp := c.R[cpu.SP] + kind.pushBytes() // uint16：模 2^16
+	if n := d.callN; n > 0 {
+		last := &d.calls[(n-1)%callRingSize]
+		if last.kind == kind && last.fromCS == cs && last.fromIP == ip && last.toCS == toCS && last.toIP == toIP {
+			last.count++
+			last.step = m.Steps
+			return
+		}
+	}
+	e := &d.calls[d.callN%callRingSize]
+	*e = callEvent{step: m.Steps, kind: kind, fromCS: cs, fromIP: ip, toCS: toCS, toIP: toIP, sp: sp, count: 1, fromOvr: noOvr, toOvr: noOvr}
+	if cs >= dgroupSeg {
+		e.fromOvr = s.ovrIdxOfCS(cs)
+	}
+	if toCS >= dgroupSeg {
+		e.toOvr = s.ovrIdxOfCS(toCS)
+	}
+	d.callN++
+	// 第二結構：直接對映的最近不同目標
+	key := uint32(toCS)<<16 | uint32(toIP)
+	slot := &d.distinc[uint8((key*0x9E3779B1)>>24)]
+	if slot.used && slot.toCS == toCS && slot.toIP == toIP {
+		slot.count++
+		slot.step = m.Steps
+	} else {
+		*slot = distinctEntry{toCS: toCS, toIP: toIP, step: m.Steps, count: 1, toOvr: e.toOvr, used: true}
+	}
+	// 註記表入口的不修剪計數
+	if w, b := entryFilterIdx(toCS, toIP); d.entryBits[w]&b != 0 {
+		if _, ok := knownRoutines[key]; ok {
+			d.entryCnt[key]++
+		}
+	}
+}
+
+// noteInt 包在 CPU.IntHook 外：記錄遊戲碼發出的服務中斷（StubSeg 內的不算）。記錄在服務進入之前。
+func (s *Session) noteInt(c *cpu.CPU, n uint8) {
+	cs, ip := c.Op()
+	if cs == machine.StubSeg || cs == machine.EMSSeg { // dosgolem 內部的哨兵與 trampoline（EMS 的 CD F6 在 EMSSeg）
+		return
+	}
+	d := &s.dg
+	m := s.m
+	d.svcSeen = true
+	d.lastSvcStep = m.Steps
+	d.intCount[n]++
+	ax := c.R[cpu.AX]
+	if n == 0x33 && uint8(ax) == 3 {
+		d.lastPoll = m.Steps
+	}
+	sp := c.R[cpu.SP]
+	if k := d.intN; k > 0 {
+		last := &d.ints[(k-1)%intRingSize]
+		if last.n == n && last.ax == ax && last.cs == cs && last.ip == ip {
+			last.count++
+			last.step = m.Steps
+			return
+		}
+	}
+	e := &d.ints[d.intN%intRingSize]
+	*e = intEvent{step: m.Steps, n: n, ax: ax, cs: cs, ip: ip, sp: sp, count: 1, stubK: -2}
+	d.intN++
+	ss := c.Seg[cpu.SS]
+	if cs == ss {
+		e.hasRet = true
+		e.retIP = m.Peek16(cpu.Linear(ss, sp+2))
+		e.retCS = m.Peek16(cpu.Linear(ss, sp+4))
+	}
+	switch n {
+	case 0x3F:
+		if ip >= 0x20 && (ip-0x20)%5 == 0 {
+			e.stubK = int((ip - 0x20) / 5)
+			e.w = m.Peek16(cpu.Linear(cs, ip+2))
+		} else {
+			e.stubK = -1
+		}
+	case 0x21:
+		switch uint8(ax >> 8) {
+		case 0x3C, 0x3D, 0x41, 0x43, 0x4B:
+			if name := s.peekName(c.Seg[cpu.DS], c.R[cpu.DX]); name != "" {
+				s.noteName(name)
+			}
+		}
+	}
+}
+
+func (s *Session) peekName(seg, off uint16) string {
+	var b []byte
+	for i := uint16(0); i < 32; i++ {
+		ch := s.m.Peek8(cpu.Linear(seg, off+i))
+		if ch < 0x20 || ch > 0x7E {
+			break
+		}
+		b = append(b, ch)
+	}
+	return string(b)
+}
+
+// noteName 記「不同檔名的最後一次」：同名更新步數，否則換掉最舊的。
+func (s *Session) noteName(name string) {
+	d := &s.dg
+	oldest := 0
+	for i := range d.names {
+		if d.names[i].name == name {
+			d.names[i].step = s.m.Steps
+			return
+		}
+		if d.names[i].step < d.names[oldest].step {
+			oldest = i
+		}
+	}
+	d.names[oldest] = nameEntry{name: name, step: s.m.Steps}
+	d.nameN++
+}
+
+// sampleOp 在取樣期間每一步被呼叫：記進直方圖，取滿就把分類表切回 opClass。
+func (s *Session) sampleOp(cs, ip uint16) {
+	d := &s.dg
+	d.sampleHist[uint32(cs)<<16|uint32(ip)]++
+	d.sampleLeft--
+	if d.sampleLeft <= 0 {
+		s.cls = &opClass
+	}
+}
+
+// RequestDiag 要求在下一個批次邊界產生手動診斷（T3）。任何執行緒可呼叫。
+func (s *Session) RequestDiag(reason string) {
+	s.dg.diagReason.Store(reason)
+	s.dg.diagReq.Store(true)
+}
+
+func (s *Session) now() time.Time {
+	if s.opt.Now != nil {
+		return s.opt.Now()
+	}
+	return time.Now()
+}
+
+// diagAfterBatch 做 T2、T3 的批次邊界工作。force ＝ 迴圈即將返回（停機或跑滿）。
+func (s *Session) diagAfterBatch(force bool) {
+	d := &s.dg
+	m := s.m
+	if !d.init || m.Steps < d.lastAfter || m.Steps-d.lastAfter > 2*batchSteps {
+		// 第一次或步數不連續（載入狀態檔）：重置靜默累計，環與計數保留
+		d.init = true
+		d.silentSec, d.svcSeen = 0, false
+		d.lastSvcStep = m.Steps
+		d.hangArmed = true
+		d.lastAfter = m.Steps
+	} else {
+		delta := m.Steps - d.lastAfter
+		d.lastAfter = m.Steps
+		if d.svcSeen {
+			d.silentSec, d.svcSeen, d.hangArmed = 0, false, true
+		} else if s.interval > 0 {
+			d.silentSec += float64(delta) / (float64(s.interval) * TickHz)
+		}
+		d.evals++
+		if d.silentSec > d.maxSilent {
+			d.maxSilent = d.silentSec
+		}
+		if s.opt.HangSeconds > 0 && d.hangArmed && d.silentSec >= s.opt.HangSeconds &&
+			d.hangDumps < maxHangDumps && !d.sampleActive {
+			d.hangArmed = false
+			d.hangDumps++
+			d.sampleActive = true
+			d.sampleLeft = sampleSteps
+			d.sampleHist = map[uint32]uint32{}
+			s.cls = &allClass
+		}
+	}
+	if d.sampleActive && (d.sampleLeft <= 0 || force) {
+		res := &sampleResult{hist: d.sampleHist, taken: sampleSteps - d.sampleLeft}
+		d.sampleActive, d.sampleLeft, d.sampleHist = false, 0, nil
+		s.cls = &opClass
+		s.emitDiag("hang", "hang：服務中斷靜默超過 "+fmt.Sprintf("%.0f", s.opt.HangSeconds)+" 遊戲秒", res)
+	}
+	if d.diagReq.Swap(false) {
+		now := s.now()
+		if d.lastManual.IsZero() || now.Sub(d.lastManual) >= manualMinGap {
+			d.lastManual = now
+			reason, _ := d.diagReason.Load().(string)
+			if reason == "" {
+				reason = "manual"
+			}
+			s.emitDiag("manual", "手動："+reason, nil)
+		}
+	}
+}
+
+// emitDiag 寫一份 T2、T3 診斷並通知 OnDiag。失敗只記一行 Log，遊戲繼續。
+func (s *Session) emitDiag(suffix, reason string, smp *sampleResult) {
+	if s.opt.DiagDir == "" {
+		return
+	}
+	dir, err := s.writeDiagDir(suffix, reason, smp)
+	if err != nil {
+		s.logf("診斷寫檔失敗：%v", err)
+		return
+	}
+	s.logf("診斷已存到 %s", dir)
+	if s.opt.OnDiag != nil {
+		s.opt.OnDiag(dir, reason)
+	}
+}
+
+// diagDirRe 是保留清理認得的目錄名。
+var diagDirRe = regexp.MustCompile(`^\d{8}-\d{6}-(hang|manual)(-\d{2})?$`)
+
+func (s *Session) writeDiagDir(suffix, reason string, smp *sampleResult) (string, error) {
+	base := s.opt.DiagDir
+	if err := os.MkdirAll(base, 0o755); err != nil {
+		return "", err
+	}
+	stem := s.now().UTC().Format("20060102-150405") + "-" + suffix
+	dir := filepath.Join(base, stem)
+	for n := 1; ; n++ {
+		err := os.Mkdir(dir, 0o755)
+		if err == nil {
+			break
+		}
+		if !os.IsExist(err) || n >= 99 {
+			return "", err
+		}
+		dir = filepath.Join(base, fmt.Sprintf("%s-%02d", stem, n+1))
+	}
+	if err := os.WriteFile(filepath.Join(dir, "info.txt"), []byte(s.diagText(reason, smp)), 0o644); err != nil {
+		return dir, err
+	}
+	if png, err := s.ScreenPNG(); err == nil {
+		_ = os.WriteFile(filepath.Join(dir, "screen.png"), png, 0o644)
+	}
+	if err := state.Save(filepath.Join(dir, "state.state"), s.m, s.d); err != nil {
+		return dir, err
+	}
+	pruneDiagDirs(base, filepath.Base(dir), keepDiagDirs, s.logf)
+	return dir, nil
+}
+
+// pruneDiagDirs 只刪同時符合下列條件的目錄：名稱完整比對 diagDirRe、Lstat 是真目錄不是符號連結、
+// 內有 info.txt 且第一行是固定標記、不是 keepName。保留名稱排序最後的 keep 份（含 keepName）。
+func pruneDiagDirs(base, keepName string, keep int, logf func(string, ...any)) {
+	ents, err := os.ReadDir(base)
+	if err != nil {
+		return
+	}
+	var names []string
+	for _, e := range ents {
+		if diagDirRe.MatchString(e.Name()) {
+			names = append(names, e.Name())
+		}
+	}
+	sort.Strings(names)
+	if len(names) <= keep {
+		return
+	}
+	for _, name := range names[:len(names)-keep] {
+		if name == keepName {
+			continue
+		}
+		p := filepath.Join(base, name)
+		fi, err := os.Lstat(p)
+		if err != nil || !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 {
+			continue
+		}
+		head, err := os.ReadFile(filepath.Join(p, "info.txt"))
+		if err != nil || !strings.HasPrefix(string(head), diagMarker+"\n") {
+			continue
+		}
+		if err := os.RemoveAll(p); err != nil {
+			logf("診斷目錄清理失敗：%v", err)
+		}
+	}
+}
+
+// ---- 傾印 ----
+
+// addrText 把一個執行期位址寫成「XXXX:XXXX（類別、換算位址、註記）」。ovr 是記錄當下查到的 overlay 編號
+//（noOvr ＝ 沒有或沒查）；current 為真時對 CS 在傾印當下查 overlay。
+func (s *Session) addrText(cs, ip uint16, ovr uint16, current bool) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%04X:%04X", cs, ip)
+	switch {
+	case cs == machine.StubSeg || cs == machine.EMSSeg:
+		b.WriteString("（dosgolem 內部 stub）")
+	case cs == s.stackSeg:
+		b.WriteString("（堆疊內程式碼，_int86x 的 stub）")
+	default:
+		if o, ok := ovrByStub(cs); ok {
+			if ip >= 0x20 && (ip-0x20)%5 == 0 {
+				fmt.Fprintf(&b, "（ovr%d stub，入口 %d，IDA %04X:%04X）", o.Idx, (ip-0x20)/5, o.StubSeg+idaDelta, ip)
+			} else {
+				fmt.Fprintf(&b, "（ovr%d stub 標頭）", o.Idx)
+			}
+			break
+		}
+		if current && cs >= dgroupSeg {
+			ovr = s.ovrIdxOfCS(cs)
+		}
+		if ovr != noOvr {
+			if o, ok := ovrByIdx(ovr); ok {
+				stub := s.m.Peek16(cpu.Linear(o.StubSeg, 0x10))
+				cross := "stub+10h 交叉一致"
+				if current && stub != cs {
+					cross = fmt.Sprintf("stub+10h 交叉不一致（%04X）", stub)
+				} else if !current {
+					cross = "記錄當下查表"
+				}
+				fmt.Fprintf(&b, "（overlay ovr%d，IDA %04X:%04X，%s）", ovr, o.LoadSeg, ip, cross)
+			}
+			break
+		}
+		if cs >= residentLo && cs < dgroupSeg {
+			fmt.Fprintf(&b, "（常駐，IDA %04X:%04X）", cs+idaDelta, ip)
+		} else {
+			b.WriteString("（未分類）")
+		}
+	}
+	if note, ok := knownRoutines[uint32(cs)<<16|uint32(ip)]; ok {
+		fmt.Fprintf(&b, " [%s]", note)
+	}
+	return b.String()
+}
+
+func (s *Session) peekBytes(cs, ip uint16, n int) string {
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			b.WriteByte(' ')
+		}
+		fmt.Fprintf(&b, "%02X", s.m.Peek8(cpu.Linear(cs, ip+uint16(i))))
+	}
+	return b.String()
+}
+
+func (s *Session) silentSteps(last uint64) string {
+	d := s.m.Steps - last
+	if last == 0 || d > s.m.Steps {
+		return "（沒有記錄）"
+	}
+	iv := s.interval
+	if iv == 0 {
+		return fmt.Sprintf("%d 步", d)
+	}
+	return fmt.Sprintf("%d 步（約 %.1f 遊戲秒）", d, float64(d)/(float64(iv)*TickHz))
+}
+
+// diagText 組出 info.txt 的全文：標記行、沿用的欄位、診斷區段。
+func (s *Session) diagText(reason string, smp *sampleResult) string {
+	var b strings.Builder
+	b.WriteString(diagMarker + "\n")
+	b.WriteString(s.infoHeader(reason))
+	b.WriteString(s.diagSections(smp))
+	return b.String()
+}
+
+func (s *Session) diagSections(smp *sampleResult) string {
+	var b strings.Builder
+	m, c, d := s.m, s.m.CPU, &s.dg
+	r := c.R
+	fmt.Fprintf(&b, "\n== 暫存器 ==\nAX %04X  BX %04X  CX %04X  DX %04X  SI %04X  DI %04X  BP %04X  SP %04X\n",
+		r[cpu.AX], r[cpu.BX], r[cpu.CX], r[cpu.DX], r[cpu.SI], r[cpu.DI], r[cpu.BP], r[cpu.SP])
+	fmt.Fprintf(&b, "CS %04X  DS %04X  ES %04X  SS %04X  IP %04X  FLAGS %04X（IF＝%v）\n",
+		c.Seg[cpu.CS], c.Seg[cpu.DS], c.Seg[cpu.ES], c.Seg[cpu.SS], c.IP, c.Flags, c.Flags&cpu.IF != 0)
+
+	opCS, opIP := c.Op()
+	fmt.Fprintf(&b, "\n== 目前位置 ==\n本道指令（CPU.Op）：%s\n  位元組：%s\n", s.addrText(opCS, opIP, noOvr, true), s.peekBytes(opCS, opIP, 16))
+	if cs, ip := c.Seg[cpu.CS], c.IP; cs != opCS || ip != opIP {
+		fmt.Fprintf(&b, "Seg[CS]:IP（下一道）：%s\n", s.addrText(cs, ip, noOvr, true))
+	}
+
+	b.WriteString("\n== 呼叫鏈（沿 BP 鏈，強推論；near 框的 [BP+4] 不是 CS，標 ?）==\n")
+	bp := r[cpu.BP]
+	ss := c.Seg[cpu.SS]
+	prev := uint16(0)
+	for i := 0; i < 16; i++ {
+		if i > 0 && bp <= prev {
+			b.WriteString("  （BP 不遞增，停止）\n")
+			break
+		}
+		ip := m.Peek16(cpu.Linear(ss, bp+2))
+		cs := m.Peek16(cpu.Linear(ss, bp+4))
+		known := cs == machine.StubSeg || cs == s.stackSeg || (cs >= residentLo && cs < dgroupSeg) || (cs >= dgroupSeg && s.ovrIdxOfCS(cs) != noOvr)
+		if _, isStub := ovrByStub(cs); isStub {
+			known = true
+		}
+		if known {
+			fmt.Fprintf(&b, "  #%d BP %04X 返回 %s\n", i, bp, s.addrText(cs, ip, noOvr, true))
+		} else {
+			fmt.Fprintf(&b, "  #%d BP %04X 返回 %04X:%04X ?\n", i, bp, cs, ip)
+		}
+		prev = bp
+		next := m.Peek16(cpu.Linear(ss, bp))
+		if next <= bp {
+			b.WriteString("  （下一個 BP 不遞增，停止）\n")
+			break
+		}
+		bp = next
+	}
+
+	fmt.Fprintf(&b, "\n== 堆疊頂部（SS:SP＝%04X:%04X，32 個字組）==\n", ss, r[cpu.SP])
+	for i := 0; i < 32; i++ {
+		if i%8 == 0 {
+			fmt.Fprintf(&b, "  %04X:", r[cpu.SP]+uint16(i*2))
+		}
+		fmt.Fprintf(&b, " %04X", m.Peek16(cpu.Linear(ss, r[cpu.SP]+uint16(i*2))))
+		if i%8 == 7 {
+			b.WriteByte('\n')
+		}
+	}
+
+	n := d.callN
+	shown := uint64(callRingSize)
+	if n < shown {
+		shown = n
+	}
+	earliest := uint64(0)
+	if shown > 0 {
+		earliest = d.calls[(n-shown)%callRingSize].step
+	}
+	fmt.Fprintf(&b, "\n== 最近呼叫（主環容量 %d 筆原始事件，目前 %d 筆，最早一筆在步數 %d；連續相同者合併）==\n", callRingSize, shown, earliest)
+	if shown > 0 {
+		first := n - shown
+		if shown > 64 {
+			first = n - 64
+		}
+		for i := first; i < n; i++ {
+			e := d.calls[i%callRingSize]
+			fmt.Fprintf(&b, "  步 %d  %s  從 %s  到 %s  呼叫前 SP %04X  ×%d\n", e.step, e.kind,
+				s.addrText(e.fromCS, e.fromIP, e.fromOvr, false), s.stubEntryText(e.toCS, e.toIP, e.toOvr), e.sp, e.count)
+		}
+		last := d.calls[(n-1)%callRingSize]
+		fmt.Fprintf(&b, "最後一次呼叫的目標（可能已返回，不是「目前所在 routine」）：%s\n", s.stubEntryText(last.toCS, last.toIP, last.toOvr))
+	} else {
+		b.WriteString("  （沒有呼叫紀錄）\n")
+	}
+
+	b.WriteString("\n== 最近不同的呼叫目標（直接對映，雜湊衝突時新者覆蓋，近似；最後 16 筆）==\n")
+	var dist []distinctEntry
+	for _, e := range d.distinc {
+		if e.used {
+			dist = append(dist, e)
+		}
+	}
+	sort.Slice(dist, func(i, j int) bool { return dist[i].step > dist[j].step })
+	if len(dist) > 16 {
+		dist = dist[:16]
+	}
+	for _, e := range dist {
+		fmt.Fprintf(&b, "  步 %d  %s  累計 %d 次\n", e.step, s.stubEntryText(e.toCS, e.toIP, e.toOvr), e.count)
+	}
+
+	b.WriteString("\n== 服務中斷（遊戲碼發出；累計次數）==\n")
+	for i := 0; i < 256; i++ {
+		if d.intCount[i] > 0 {
+			fmt.Fprintf(&b, "  int %02Xh ×%d\n", i, d.intCount[i])
+		}
+	}
+	b.WriteString("最後 16 筆：\n")
+	ni := d.intN
+	from := uint64(0)
+	if ni > 16 {
+		from = ni - 16
+	}
+	for i := from; i < ni; i++ {
+		e := d.ints[i%intRingSize]
+		fmt.Fprintf(&b, "  步 %d  int %02Xh AX＝%04X  從 %s  ×%d", e.step, e.n, e.ax, s.addrText(e.cs, e.ip, noOvr, false), e.count)
+		if e.hasRet {
+			fmt.Fprintf(&b, "  返回位址 %s", s.addrText(e.retCS, e.retIP, noOvr, true))
+		}
+		switch {
+		case e.stubK >= 0:
+			if o, ok := ovrByStub(e.cs); ok {
+				fmt.Fprintf(&b, "  overlay ovr%d 入口 %d（overlay 內偏移 %04X）", o.Idx, e.stubK, e.w)
+			}
+		case e.stubK == -1:
+			b.WriteString("  stub 標頭重載")
+		}
+		b.WriteByte('\n')
+	}
+	b.WriteString("不同檔名的最後一次（DOS 開檔、建檔、刪檔、改屬性、執行）：\n")
+	var names []nameEntry
+	for _, e := range d.names {
+		if e.name != "" {
+			names = append(names, e)
+		}
+	}
+	sort.Slice(names, func(i, j int) bool { return names[i].step < names[j].step })
+	for _, e := range names {
+		fmt.Fprintf(&b, "  步 %d  %s\n", e.step, e.name)
+	}
+
+	fmt.Fprintf(&b, "\n== 時間 ==\n距最後一次服務中斷：%s\n距最後一次滑鼠輪詢：%s\n靜默累計 %.1f 遊戲秒當量，T2 評估 %d 次，最長靜默 %.1f 遊戲秒\nDOS.Blocked＝%v  DOS.KeyWaits＝%d\n",
+		s.silentSteps(d.lastSvcStep), s.silentSteps(d.lastPoll), d.silentSec, d.evals, d.maxSilent, s.d.Blocked, s.d.KeyWaits)
+
+	if smp != nil {
+		fmt.Fprintf(&b, "\n== 迴圈取樣（觸發後 %d 道指令，前 16 名）==\n", smp.taken)
+		if smp.taken < sampleSteps {
+			b.WriteString("  樣本不足（取樣期間停機或迴圈即將返回）\n")
+		}
+		type kv struct {
+			k uint32
+			v uint32
+		}
+		var hs []kv
+		for k, v := range smp.hist {
+			hs = append(hs, kv{k, v})
+		}
+		sort.Slice(hs, func(i, j int) bool {
+			if hs[i].v != hs[j].v {
+				return hs[i].v > hs[j].v
+			}
+			return hs[i].k < hs[j].k
+		})
+		if len(hs) > 16 {
+			hs = hs[:16]
+		}
+		for _, e := range hs {
+			cs, ip := uint16(e.k>>16), uint16(e.k)
+			fmt.Fprintf(&b, "  %5d 次  %s\n         位元組 %s\n", e.v, s.addrText(cs, ip, noOvr, true), s.peekBytes(cs, ip, 16))
+		}
+	}
+	return b.String()
+}
+
+// stubEntryText 是呼叫目標的文字：stub 段的入口加註 ovr 與入口序號，其餘照 addrText。
+func (s *Session) stubEntryText(cs, ip uint16, ovr uint16) string {
+	return s.addrText(cs, ip, ovr, false)
+}
