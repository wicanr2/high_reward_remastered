+	execAt(t, s, 0x9000, 0x0100, []byte{0xFF, 0x26, 0x00, 0x02}, 0x1000) // FF /4 jmp
+	if s.dg.callN != before {
+		t.Errorf("nop 與 jmp 不應記錄，callN %d → %d", before, s.dg.callN)
+	}
+}
