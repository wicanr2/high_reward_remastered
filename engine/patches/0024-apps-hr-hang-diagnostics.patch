+func TestT2JmpSelf(t *testing.T) {
+	h := newHang(t, 3)
+	cs, ip := h.patchHere(0xEB, 0xFE) // jmp $，IF ＝ 1
+	h.run(t, 3.6)
+	sec := h.checkOne(t, cs, ip)
+	n, addr := topSample(t, sec)
+	if n < 3500 || n > 4096 {
+		t.Errorf("取樣第一名的次數應接近 4096（少數是 tick 的 ISR 指令）：%d", n)
+	}
+	if !strings.HasPrefix(addr, hex4(cs)+":"+hex4(ip)) {
+		t.Errorf("取樣第一名應是 %04X:%04X，實際 %s", cs, ip, addr)
+	}
+	h.run(t, 6) // 再跑 60 秒當量的一半以上：同一個靜默期不重複
+	if got := h.n.Load(); got != 1 {
