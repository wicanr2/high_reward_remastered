+func TestIntRecordingFilenameAndStub(t *testing.T) {
+	s := openDiag(t, Options{Interval: NativeInterval})
+	// 遊戲碼（CS ≠ StubSeg）的 int 21h AH＝3Dh：記檔名
+	name := append([]byte("TEST.DAT"), 0)
+	s.m.WriteBytes(cpu.Linear(0x8000, 0x0300), name)
+	s.m.CPU.R[cpu.AX] = 0x3D00
+	s.m.CPU.R[cpu.DX] = 0x0300
+	execAtKeepRegs(t, s, 0x9000, 0x0100, []byte{0xCD, 0x21})
+	if s.dg.intCount[0x21] != 1 {
+		t.Fatalf("intCount[0x21] ＝ %d，預期 1", s.dg.intCount[0x21])
+	}
+	found := false
+	for _, e := range s.dg.names {
+		if e.name == "TEST.DAT" {
+			found = true
+		}
+	}
+	if !found {
+		t.Errorf("沒記到檔名 TEST.DAT：%+v", s.dg.names)
+	}
+	// StubSeg 內的中斷不記錄、不計數、不更新靜默
+	before := s.dg.intCount[0x21]
+	s.dg.svcSeen = false
+	s.m.CPU.R[cpu.AX] = 0x3000
+	execAtKeepRegs(t, s, machine.StubSeg, 0x0700, []byte{0xCD, 0x21})
+	if s.dg.intCount[0x21] != before || s.dg.svcSeen {
+		t.Error("StubSeg 內的中斷不該計入服務中斷")
+	}
+	// int 3Fh 的 stub 解碼：stub 252 的 stub 段 5206，入口 0 在偏移 0x20，其後 u16 ＝ 002C（overlays.json）。
+	// 只測記錄的解碼，不真的執行 overlay 管理員：寫一個 nop 到入口位置，再直接呼叫 noteInt。
+	stub := cpu.Linear(0x5206, 0)
+	if got := s.m.Peek8(stub); got != 0xCD || s.m.Peek8(stub+1) != 0x3F {
+		t.Fatalf("stub 5206 起點不是 CD 3F：%02X %02X", got, s.m.Peek8(stub+1))
+	}
+	wantW := s.m.Peek16(cpu.Linear(0x5206, 0x22))
+	execAtKeepRegs(t, s, 0x5206, 0x0020, []byte{0x90}) // 本道指令 ＝ 5206:0020（Op）
+	s.noteInt(s.m.CPU, 0x3F)
+	var e intEvent
+	for i := uint64(0); i < s.dg.intN; i++ {
+		if x := s.dg.ints[i%intRingSize]; x.n == 0x3F {
+			e = x
+		}
+	}
+	if e.n != 0x3F || e.stubK != 0 || e.w != wantW || wantW != 0x002C {
+		t.Errorf("int 3Fh 記錄：%+v（預期入口 0、u16 ＝ 002C，實際記憶體 %04X）", e, wantW)
+	}
+	// stub 標頭重載：偏移 0
+	execAtKeepRegs(t, s, 0x5206, 0x0000, []byte{0x90})
+	s.noteInt(s.m.CPU, 0x3F)
+	e = s.dg.ints[(s.dg.intN-1)%intRingSize]
+	if e.stubK != -1 {
+		t.Errorf("stub 標頭的 int 3Fh 應標 -1，實際 %+v", e)
+	}
+}
