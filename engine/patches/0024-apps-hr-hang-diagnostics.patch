+// topSample 回傳取樣區段第一名的次數與位址文字（格式：「%5d 次  XXXX:XXXX…」）。
+func topSample(t *testing.T, sec string) (int, string) {
+	t.Helper()
+	for _, line := range strings.Split(sec, "\n")[1:] {
+		f := strings.Fields(line)
+		if len(f) >= 3 && f[1] == "次" {
+			n := 0
+			for _, ch := range f[0] {
+				n = n*10 + int(ch-'0')
+			}
+			return n, f[2]
+		}
+	}
+	t.Fatalf("取樣區段沒有項目：%s", sec)
+	return 0, ""
+}
