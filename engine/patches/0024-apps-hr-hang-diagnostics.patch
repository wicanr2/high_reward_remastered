@@ -0,0 +1,31 @@
+package main
+
+import "testing"
+
+// docs/spec/005 第 8 節：Ctrl 按住或 F1 說明開著的那一幀，字元與特殊鍵都不送進遊戲。
+func TestSendKeysToGame(t *testing.T) {
+	cases := []struct{ help, ctrl, want bool }{
+		{false, false, true},
+		{true, false, false},
+		{false, true, false},
+		{true, true, false},
+	}
+	for _, c := range cases {
+		if got := sendKeysToGame(c.help, c.ctrl); got != c.want {
+			t.Errorf("sendKeysToGame(help＝%v, ctrl＝%v) ＝ %v，預期 %v", c.help, c.ctrl, got, c.want)
+		}
+	}
+}
+
+// OnDiag 在模擬 goroutine 寫、UI 執行緒讀：lastDiag 以 atomic 存取，F1 說明只顯示目錄名（ASCII）。
+func TestLastDiagName(t *testing.T) {
+	lastDiag.Store("")
+	if got := lastDiagName(); got != "(none)" {
+		t.Errorf("沒有診斷時應顯示 (none)，實際 %q", got)
+	}
+	dir := t.TempDir()
+	onDiag(dir, dir+"/crash/20261003-120000-manual", "手動：Ctrl+D")
+	if got := lastDiagName(); got != "20261003-120000-manual" {
+		t.Errorf("lastDiagName ＝ %q", got)
+	}
+}
