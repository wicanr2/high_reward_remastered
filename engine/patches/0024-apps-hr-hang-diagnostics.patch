+// execAtKeepRegs 同 execAt，但不動 AX、DX（呼叫端先設）。
+func execAtKeepRegs(t *testing.T, s *Session, seg, off uint16, code []byte) {
+	t.Helper()
+	m := s.m
+	c := m.CPU
+	m.WriteBytes(cpu.Linear(seg, off), code)
+	c.Seg[cpu.CS], c.IP = seg, off
+	c.Seg[cpu.SS], c.R[cpu.SP] = 0x2000, 0x1000
+	c.Seg[cpu.DS] = 0x8000
+	c.SetFlags(0)
+	if st := s.stepBatch(1); st != nil {
+		t.Fatalf("stepBatch 停機：%v", st.Msg)
+	}
+}
