+// execAt 在 seg:off 放 code，把 CPU 設在那裡（SS ＝ 0x2000、DS ＝ 0x8000、IF ＝ 0），經 stepBatch 執行一步。
+func execAt(t *testing.T, s *Session, seg, off uint16, code []byte, sp uint16) {
+	t.Helper()
+	m := s.m
+	c := m.CPU
+	m.WriteBytes(cpu.Linear(seg, off), code)
+	c.Seg[cpu.CS], c.IP = seg, off
+	c.Seg[cpu.SS], c.R[cpu.SP] = 0x2000, sp
+	c.Seg[cpu.DS] = 0x8000
+	c.SetFlags(0)
+	if st := s.stepBatch(1); st != nil {
+		t.Fatalf("stepBatch 停機：%v", st.Msg)
+	}
+}
