+func TestClassifyCall(t *testing.T) {
+	cases := []struct {
+		name  string
+		code  []byte
+		kind  callKind
+		ok    bool
+		exact bool // 不補零（測資料在指令中途結束）
+	}{
+		{"E8", []byte{0xE8, 0x10, 0x00}, ckNear, true, false},
+		{"9A", []byte{0x9A, 0x00, 0x03, 0x00, 0x91}, ckFar, true, false},
+		{"FF/2", []byte{0xFF, 0x16, 0x00, 0x02}, ckNearInd, true, false},
+		{"FF/3", []byte{0xFF, 0x1E, 0x00, 0x02}, ckFarInd, true, false},
+		{"FF/2 暫存器形式", []byte{0xFF, 0xD0}, ckNearInd, true, false},
+		{"FF/4 jmp", []byte{0xFF, 0x26, 0x00, 0x02}, 0, false, false},
+		{"FF/0 inc", []byte{0xFF, 0x06, 0x00, 0x02}, 0, false, false},
+		{"FF/6 push", []byte{0xFF, 0x36, 0x00, 0x02}, 0, false, false},
+		{"CS 前綴 FF/2", []byte{0x2E, 0xFF, 0x16, 0x00, 0x02}, ckNearInd, true, false},
+		{"多個前綴 FF/3", []byte{0xF3, 0x2E, 0x26, 0xF0, 0xFF, 0x1E, 0x00, 0x02}, ckFarInd, true, false},
+		{"F1 前綴 E8", []byte{0xF1, 0xE8, 0x00, 0x00}, ckNear, true, false},
+		{"64 前綴 E8", []byte{0x64, 0xE8, 0x00, 0x00}, ckNear, true, false},
+		{"66 開頭不分類（這支 CPU 會回 CPU 錯誤）", []byte{0x66, 0xE8, 0x00, 0x00, 0x00, 0x00}, 0, false, false},
+		{"66 在前綴後也不分類", []byte{0x2E, 0x66, 0x9A, 0, 0, 0, 0, 0, 0}, 0, false, false},
+		{"nop", []byte{0x90}, 0, false, false},
+		{"int", []byte{0xCD, 0x21}, 0, false, false},
+		{"ret", []byte{0xC3}, 0, false, false},
+		{"前綴後沒有位元組", []byte{0x26}, 0, false, true},
+		{"FF 後沒有 modrm", []byte{0xFF}, 0, false, true},
+	}
+	for _, c := range cases {
+		code := c.code
+		if !c.exact {
+			code = make([]byte, 16) // 後面補 0，不影響判斷
+			copy(code, c.code)
+		}
+		k, ok := classifyCall(code)
+		if ok != c.ok || (ok && k != c.kind) {
+			t.Errorf("%s：得 (%v,%v)，預期 (%v,%v)", c.name, k, ok, c.kind, c.ok)
+		}
+	}
+	// 15 個前綴之後放棄
+	long := bytes.Repeat([]byte{0x26}, 15)
+	long = append(long, 0xE8, 0, 0)
+	if _, ok := classifyCall(long); ok {
+		t.Error("15 個前綴之後應放棄")
+	}
+}
