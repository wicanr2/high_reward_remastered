+	names := []string{"20261001-000001-hang", "20261001-000002-hang", "20261001-000003-manual", "20261001-000004-hang", "20261001-000005-hang", "20261001-000006-manual"}
+	for _, n := range names {
+		mk(n, true)
+	}
+	mk("20261001-000000-hang", false)    // 缺標記
+	mk("20260930-235959", true)          // T1 現場（沒有後綴）：不納入清理
+	mk("random-dir", true)               // 名稱不符
+	outside := t.TempDir()
+	if err := os.WriteFile(filepath.Join(outside, "keep.txt"), []byte("x"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(base, "20261001-000000-manual")); err != nil { // 符號連結
+		t.Fatal(err)
+	}
+	mk("20261001-000007-hang", true) // 剛寫的一份
+	pruneDiagDirs(base, "20261001-000007-hang", 3, func(string, ...any) {})
+	exists := func(n string) bool { _, err := os.Lstat(filepath.Join(base, n)); return err == nil }
+	for _, gone := range []string{"20261001-000001-hang", "20261001-000002-hang", "20261001-000003-manual", "20261001-000004-hang"} {
+		if exists(gone) {
