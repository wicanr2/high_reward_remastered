+// overlay 判定：用戰鬥佈陣狀態檔（HR_BENCH_STATE）載入後，在 BP 鏈上找 overlay 框，
+// 兩個獨立算式（stub 位置字組、stub ＋10h）必須一致（docs/re/007 第 8 節在執行中的第一次驗證）。
+func TestOverlayClassificationOnState(t *testing.T) {
+	p := os.Getenv("HR_BENCH_STATE")
+	if p == "" {
+		t.Skip("沒有設 HR_BENCH_STATE")
+	}
+	if _, err := os.Stat(p); err != nil {
+		t.Skipf("狀態檔不存在：%v", err)
+	}
+	s := openDiag(t, Options{Interval: NativeInterval})
+	if err := state.Load(p, s.m, s.d); err != nil {
+		t.Fatal(err)
+	}
+	st, polled := s.RunToPoll(200_000_000)
+	if st != nil && st.Kind != StopSteps {
+		t.Fatalf("停機：%v", st.Msg)
+	}
+	if !polled {
+		t.Skip("沒有走到輪詢點")
+	}
+	c := s.m.CPU
+	bp, ss := c.R[cpu.BP], c.Seg[cpu.SS]
+	nOvr := 0
+	for i := 0; i < 16 && bp > 0; i++ {
+		ip := s.m.Peek16(cpu.Linear(ss, bp+2))
+		cs := s.m.Peek16(cpu.Linear(ss, bp+4))
+		if idx := s.ovrIdxOfCS(cs); idx != noOvr {
+			o, _ := ovrByIdx(idx)
+			if stub := s.m.Peek16(cpu.Linear(o.StubSeg, 0x10)); stub != cs {
+				t.Errorf("CS %04X：stub 位置字組判為 ovr%d，但 stub ＋10h ＝ %04X，兩法不一致", cs, idx, stub)
+			}
+			nOvr++
+			_ = ip
+		}
+		next := s.m.Peek16(cpu.Linear(ss, bp))
+		if next <= bp {
+			break
+		}
+		bp = next
+	}
+	if nOvr == 0 {
+		t.Skip("BP 鏈上沒有 overlay 框")
+	}
+}
