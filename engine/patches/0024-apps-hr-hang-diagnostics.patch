+	s.Input(MouseMoveEvent(312, 171))
+	s.RunSteps(s.m.Steps + 3_000_000)
+	s.Input(MouseButtonEvent(312, 171, 0, true))
+	s.RunSteps(s.m.Steps + 3_000_000)
+	s.Input(MouseButtonEvent(312, 171, 0, false))
+	for i := 0; i < 15 && s.dg.intCount[0x67] == 0; i++ {
+		s.RunSteps(s.m.Steps + 10_000_000)
+	}
+	if s.dg.intCount[0x67] == 0 {
+		t.Fatal("遊玩路徑上沒有用到 int 67h，這個測試沒有證明什麼")
+	}
+	t.Logf("int 67h ×%d，int F6h ×%d", s.dg.intCount[0x67], s.dg.intCount[0xF6])
+	if s.dg.intCount[0xF6] != 0 {
+		t.Errorf("int F6h（EMS trampoline）被計入：%d", s.dg.intCount[0xF6])
+	}
+}
+
+// 呼叫計數的獨立交叉檢查（docs/spec/005 第 10 節）：同一個狀態檔、同一個窗口，probe -call-args 的輸出
+// （docs/re/data/017-probe-call-args.txt）是垂直線 1D11:000A 與水平線 1D29:000E 各 10 次。
+// 進入計數以 call 的目標計，probe 以步前 CS:IP 等於入口計，視窗頭尾可能差 1，所以允許 ±1。
+func TestCallCountsMatchProbe(t *testing.T) {
+	p := os.Getenv("HR_SOAK_STATE")
+	if p == "" {
+		t.Skip("沒有設 HR_SOAK_STATE")
+	}
+	if _, err := os.Stat(p); err != nil {
+		t.Skipf("狀態檔不存在：%v", err)
+	}
+	s := openDiag(t, Options{Interval: NativeInterval})
+	if err := state.Load(p, s.m, s.d); err != nil {
+		t.Fatal(err)
+	}
+	if s.m.Steps != 1_500_000_000 {
+		t.Skipf("狀態檔的 Steps ＝ %d，不是 docs/re/009 的 1,500,000,000", s.m.Steps)
+	}
+	if st := s.RunSteps(1_503_000_000); st.Kind != StopSteps {
+		t.Fatalf("停機：%v", st.Msg)
+	}
+	for _, c := range []struct {
+		name string
+		key  uint32
+	}{{"1D11:000A 垂直線", 0x1D11_000A}, {"1D29:000E 水平線", 0x1D29_000E}} {
+		got := s.dg.entryCnt[c.key]
+		if got < 9 || got > 11 {
+			t.Errorf("%s：進入計數 %d，probe -call-args 是 10 次（±1）", c.name, got)
+		}
+		t.Logf("%s：進入計數 %d（probe：10）", c.name, got)
+	}
+}
diff --git a/apps/hr/runtime/overhead_test.go b/apps/hr/runtime/overhead_test.go
new file mode 100644
index 0000000..07d4062
--- /dev/null
+++ b/apps/hr/runtime/overhead_test.go
@@ -0,0 +1,109 @@
+package runtime
+
+import (
+	"os"
+	"sort"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/state"
+)
+
+// 診斷熱迴圈成本的成對量測（docs/spec/005 第 9 節）：同一個行程內，診斷開（前端的 Options）與 NoDiag 兩個 Session
+// 從同一個狀態出發，交錯各跑一塊固定步數，量使用者 CPU 時間，取 150 對的修剪平均（成對比值，去掉兩端各 20%）。
+// 跨執行檔的 A/B（tools/bench.sh）在負載高的主機上雜訊可達 2 倍，成對、交錯、同行程才擋得住 5% 的退化。
+// HR_BENCH_OVERHEAD=1 才執行；HR_BENCH_STATE 指定戰鬥佈陣前的狀態檔（缺檔就 skip 戰鬥場景）。
+
+type overheadScenario struct {
+	name  string
+	hd    bool
+	state string
+	click bool
+}
+
+func startSession(t *testing.T, sc overheadScenario, noDiag bool) *Session {
+	t.Helper()
+	opt := Options{Interval: NativeInterval, NoDiag: noDiag, HDHooks: sc.hd}
+	if !noDiag {
+		opt.HangSeconds, opt.DiagDir = 30, t.TempDir()
+	}
+	s := openDiag(t, opt)
+	if sc.state != "" {
+		if err := state.Load(sc.state, s.m, s.d); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if sc.click {
+		s.Input(MouseMoveEvent(16, 56))
+		s.RunSteps(s.m.Steps + 1_000_000)
+		s.Input(MouseButtonEvent(16, 56, 0, true))
+		s.RunSteps(s.m.Steps + 17_000_000)
+		s.Input(MouseButtonEvent(16, 56, 0, false))
+	}
+	return s
+}
+
+func TestDiagOverheadPaired(t *testing.T) {
+	if os.Getenv("HR_BENCH_OVERHEAD") == "" {
+		t.Skip("沒有設 HR_BENCH_OVERHEAD")
+	}
+	scs := []overheadScenario{{name: "cold"}, {name: "cold-hdhooks", hd: true}}
+	if p := os.Getenv("HR_BENCH_STATE"); p != "" {
+		if _, err := os.Stat(p); err == nil {
+			scs = append(scs, overheadScenario{name: "battle", state: p, click: true}, overheadScenario{name: "battle-hdhooks", hd: true, state: p, click: true})
+		}
+	}
+	const pairs, chunk = 150, 1_000_000
+	for _, sc := range scs {
+		on, off := startSession(t, sc, false), startSession(t, sc, true)
+		var ratios []float64
+		for i := 0; i < pairs; i++ {
+			a, b := on, off
+			if i%2 == 1 { // 交換先後，抵消順序效應
+				a, b = off, on
+			}
+			t0 := userNanos()
+			a.RunSteps(a.m.Steps + chunk)
+			t1 := userNanos()
+			b.RunSteps(b.m.Steps + chunk)
+			t2 := userNanos()
+			tOn, tOff := t1-t0, t2-t1
+			if i%2 == 1 {
+				tOn, tOff = t2-t1, t1-t0
+			}
+			if tOn > 0 && tOff > 0 {
+				ratios = append(ratios, tOn/tOff)
+			}
+		}
+		sort.Float64s(ratios)
+		// 每塊約 0.1 秒，相鄰兩塊吃到的主機負載相近；對 150 對取修剪平均（去掉兩端各 20%）與標準誤，
+		// 比單看一塊的時間比穩得多。
+		lo, hi := len(ratios)/5, len(ratios)-len(ratios)/5
+		trim := ratios[lo:hi]
+		var sum, sq float64
+		for _, r := range trim {
+			sum += r
+		}
+		mean := sum / float64(len(trim))
+		for _, r := range trim {
+			sq += (r - mean) * (r - mean)
+		}
+		se := (sq / float64(len(trim)-1) / float64(len(trim))) // 變異數的估計，開根號在下面
+		se = sqrtF(se)
+		t.Logf("%-15s 診斷開 ÷ NoDiag：修剪平均 %.3f ± %.3f（標準誤），中位數 %.3f，範圍 %.3f 至 %.3f（%d 對，每塊 %d 步）",
+			sc.name, mean, se, ratios[len(ratios)/2], ratios[0], ratios[len(ratios)-1], len(ratios), chunk)
+		if mean > 1.05 {
+			t.Errorf("%s：修剪平均 %.3f 超過閘門 1.05", sc.name, mean)
+		}
+	}
+}
+
+func sqrtF(x float64) float64 { // 牛頓法，免得為了一個平方根多 import math
+	if x <= 0 {
+		return 0
+	}
+	z := x
+	for i := 0; i < 40; i++ {
+		z = (z + x/z) / 2
+	}
+	return z
+}
