+func TestCallRingMergesOnlyConsecutive(t *testing.T) {
+	s := openDiag(t, Options{Interval: NativeInterval})
+	for i := 0; i < 10; i++ {
+		execAt(t, s, 0x9000, 0x0100, []byte{0xE8, 0x10, 0x00}, 0x1000)
+	}
+	if s.dg.callN != 1 || lastCall(s).count != 10 {
+		t.Fatalf("連續相同應合併：callN＝%d count＝%d", s.dg.callN, lastCall(s).count)
+	}
+	// 兩種交替：沒有任何兩筆相鄰且相同，不合併
+	base := s.dg.callN
+	for i := 0; i < 10; i++ {
+		execAt(t, s, 0x9000, 0x0200, []byte{0xE8, 0x20, 0x00}, 0x1000)
+		execAt(t, s, 0x9000, 0x0100, []byte{0xE8, 0x10, 0x00}, 0x1000)
+	}
+	if got := s.dg.callN - base; got != 20 {
+		t.Fatalf("交替的 20 次呼叫應記 20 筆，實際 %d", got)
+	}
+	// 第二結構保留不同目標（這裡 3 個：0113、0223，以及先前合併的那個 0113 算同一個）
+	n := 0
+	for _, e := range s.dg.distinc {
+		if e.used {
+			n++
+		}
+	}
+	if n < 2 {
+		t.Errorf("第二結構應保留至少 2 個不同目標，實際 %d", n)
+	}
+	// 填滿環之後最早的事件被覆蓋，callN 單調成長
+	for i := 0; i < 2*callRingSize; i++ {
+		execAt(t, s, 0x9000, uint16(0x100+i%2*0x100), []byte{0xE8, 0x10, 0x00}, 0x1000)
+	}
+	if s.dg.callN < callRingSize {
+		t.Errorf("callN 應超過容量，實際 %d", s.dg.callN)
+	}
+}
