dosgolem 為了觀測把檔案、滑鼠、記憶體服務的紀錄放在無上限切片，長跑到 10 億步左右
會被容器記憶體上限殺掉。每 200 萬道指令清一次（滑鼠沒有按住時），報告多一欄堆積用量。
-random-from 讓腳本先點完標題與讀檔，再開始隨機輸入。

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 apps/hr/cmd/hrsoak/main.go | 42 ++++++++++++++++++++++++++++++--------
 1 file changed, 34 insertions(+), 8 deletions(-)

diff --git a/apps/hr/cmd/hrsoak/main.go b/apps/hr/cmd/hrsoak/main.go
index 39a420c..d685a06 100644
--- a/apps/hr/cmd/hrsoak/main.go
+++ b/apps/hr/cmd/hrsoak/main.go
@@ -21,6 +21,7 @@ import (
 	"math/rand"
 	"os"
 	"path/filepath"
+	"runtime"
 	"sort"
 	"strings"
 	"time"
@@ -60,12 +61,13 @@ func main() {
 	reportEvery := flag.Uint64("report-every", 50_000_000, "每幾道指令輸出一行資源計數")
 	out := flag.String("out", "/out/soak", "輸出目錄（報告、檢查點、現場）")
 	seed := flag.Int64("seed", 1, "隨機輸入的種子")
-	inputMode := flag.String("input", "random", "輸入模式：none｜random｜script")
+	inputMode := flag.String("input", "random", "輸入模式：none｜random（腳本 -script 兩種模式都會處理）")
 	inputEvery := flag.Uint64("input-every", 3_000_000, "random 模式：每幾道指令一個輸入事件")
 	script := flag.String("script", "", "script 模式：每行 `步數 click X Y [r]`（r 為右鍵）或 `步數 key 名稱`")
 	startClick := flag.String("start-click", "35000000:312:211", "開機後先點的位置 `步數:X:Y`（預設點標題選單的新遊戲）；空字串不點")
 	ckEvery := flag.Uint64("checkpoint-every", 200_000_000, "每幾道指令存一份檢查點（0 ＝ 不存）")
 	loadState := flag.String("load-state", "", "從狀態檔接著跑")
+	randomFrom := flag.Uint64("random-from", 36_000_000, "random 模式：從第幾道指令開始送隨機輸入（要給腳本點完標題選單與讀檔的時間）")
 	flag.Parse()
 	if *exe == "" && *loadState == "" {
 		die(fmt.Errorf("缺 -exe"))
@@ -78,7 +80,7 @@ func main() {
 		die(err)
 	}
 	defer rep.Close()
-	fmt.Fprintln(rep, "steps\tcsip\thandles\tfreeSeg\tarena\temsH\temsPages\tpolls\tscreen\tdivErr\topensInPeriod\telapsed")
+	fmt.Fprintln(rep, "steps\tcsip\thandles\tfreeSeg\tarena\temsH\temsPages\tpolls\tscreen\tdivErr\topensInPeriod\theapMB\telapsed")
 
 	m := machine.New()
 	if *loadState == "" {
@@ -110,7 +112,7 @@ func main() {
 		}
 		clicks = append(clicks, c)
 	}
-	if *inputMode == "script" {
+	if *script != "" {
 		b, err := os.ReadFile(*script)
 		if err != nil {
 			die(err)
@@ -142,7 +144,7 @@ func main() {
 	}
 	sort.Slice(clicks, func(i, j int) bool { return clicks[i].step < clicks[j].step })
 	rng := rand.New(rand.NewSource(*seed))
-	nextInput := *inputEvery * 12 // 先給遊戲時間跑到標題選單與新遊戲
+	nextInput := *randomFrom
 	if d.Mouse.XScale == 0 {
 		d.Mouse.XScale = 0
 	}
@@ -157,6 +159,8 @@ func main() {
 	var runErr error
 	var stopWhy string
 	nextReport := m.Steps + *reportEvery
+	nextTrim := m.Steps + 2_000_000
+	totalPolls := 0
 	nextCk := m.Steps + *ckEvery
 	var ckPaths []string
 	ci := 0
@@ -227,20 +231,27 @@ func main() {
 			stopWhy = "divide-error"
 			break
 		}
+		if m.Steps >= nextTrim && held == nil {
+			nextTrim += 2_000_000
+			totalPolls += trim(m, d)
+			pollsAtPress = 0
+		}
 		if m.Steps >= nextReport {
 			nextReport += *reportEvery
 			s := d.Stats()
-			polls, _ := 0, 0
-			polls = len(d.Mouse.Polls)
+
+			polls := totalPolls + len(d.Mouse.Polls)
 			var o []string
 			for k, v := range opens {
 				o = append(o, fmt.Sprintf("%s=%d", k, v))
 			}
 			sort.Strings(o)
 			opens = map[string]int{}
-			fmt.Fprintf(rep, "%d\t%04X:%04X\t%d\t%04X\t%d\t%d\t%d\t%d\t%s\t%d\t%s\t%s\n",
+			var ms runtime.MemStats
+			runtime.ReadMemStats(&ms)
+			fmt.Fprintf(rep, "%d\t%04X:%04X\t%d\t%04X\t%d\t%d\t%d\t%d\t%s\t%d\t%s\t%d\t%s\n",
 				m.Steps, m.CPU.Seg[cpu.CS], m.CPU.IP, s.OpenHandles, s.FreeSeg, s.ArenaBlocks, s.EMSHandles, s.EMSPages,
-				polls, screenHash(m), len(m.CPU.DivErrors), strings.Join(o, ","), time.Since(started).Round(time.Second))
+				polls, screenHash(m), len(m.CPU.DivErrors), strings.Join(o, ","), ms.HeapAlloc>>20, time.Since(started).Round(time.Second))
 			rep.Sync()
 			for _, u := range d.UnimplementedReport() {
 				if !seenUnimpl[u] {
@@ -299,3 +310,18 @@ func main() {
 		os.Exit(1)
 	}
 }
+
+// trim 清掉診斷用的紀錄。dosgolem 為了觀測把每一次檔案操作、調色盤寫入、記憶體服務、
+// 滑鼠輪詢都記在無上限的切片裡，長跑會撐爆記憶體（實測：兩個隨機輸入的 30 億步長跑
+// 在 10 億步左右被容器記憶體上限殺掉，輸出為空）。回傳被清掉的滑鼠輪詢數。
+func trim(m *machine.Machine, d *dos.DOS) (polls int) {
+	polls = len(d.Mouse.Polls)
+	d.Mouse.Polls, d.Mouse.Sets, d.Mouse.Events, d.Mouse.PressReads = nil, nil, nil, nil
+	d.Opened, d.Missing, d.MissingAccess = nil, nil, nil
+	d.Reads, d.Allocs, d.EMSOps, d.XMSMoves = nil, nil, nil, nil
+	d.Wrote, d.VecSets, d.FileOps, d.PalOps = nil, nil, nil, nil
+	d.MemOps, d.ExecLog, d.Overlays, d.Resizes = nil, nil, nil, nil
+	d.CallTrace, d.MemTrace, d.KeyReads, d.Console = nil, nil, nil, nil
+	m.PortLog, m.SegLog, m.DSLoads, m.Speaker, m.OPL = nil, nil, nil, nil, nil
+	return polls
+}
