+++ b/apps/hr/play/paths.go
@@ -0,0 +1,69 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// findOriginal 找玩家自備的原版目錄（含 MAIN.EXE）。順序：-orig、環境變數 HR_ORIG、
+// 執行檔旁的 original、macOS app 的 Contents/Resources/original、目前目錄的 original。
+func findOriginal(flagVal string) (string, error) {
+	var tried []string
+	cands := []string{}
+	if flagVal != "" {
+		cands = append(cands, flagVal)
+	}
+	if v := os.Getenv("HR_ORIG"); v != "" {
+		cands = append(cands, v)
+	}
+	if exe, err := os.Executable(); err == nil {
+		dir := filepath.Dir(exe)
+		cands = append(cands, filepath.Join(dir, "original"), filepath.Join(dir, "..", "Resources", "original"))
+	}
+	cands = append(cands, "original")
+	for _, c := range cands {
+		tried = append(tried, c)
+		if st, err := os.Stat(filepath.Join(c, "MAIN.EXE")); err == nil && !st.IsDir() {
+			return c, nil
+		}
+		// 大小寫不分
+		if ents, err := os.ReadDir(c); err == nil {
+			for _, e := range ents {
+				if equalFold(e.Name(), "MAIN.EXE") {
+					return c, nil
+				}
+			}
+		}
+	}
+	return "", fmt.Errorf("找不到原版目錄（內含 MAIN.EXE）。已找過：%v\n請用 -orig <目錄> 指定，或把原版檔案放在執行檔旁的 original 目錄", tried)
+}
+
+func equalFold(a, b string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := 0; i < len(a); i++ {
+		x, y := a[i], b[i]
+		if 'a' <= x && x <= 'z' {
+			x -= 32
+		}
+		if 'a' <= y && y <= 'z' {
+			y -= 32
+		}
+		if x != y {
+			return false
+		}
+	}
+	return true
+}
+
+// dataDir 是使用者資料目錄下的 high_reward。存檔放 saves，現場放 crash，截圖放 screenshots。
+func dataDir() (string, error) {
+	base, err := os.UserConfigDir()
+	if err != nil {
+		base = os.TempDir()
+	}
+	d := filepath.Join(base, "high_reward")
+	return d, os.MkdirAll(d, 0o755)
+}
