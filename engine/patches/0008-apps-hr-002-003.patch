diff --git a/apps/hr/patch/patch.go b/apps/hr/patch/patch.go
new file mode 100644
index 0000000..08011f3
--- /dev/null
+++ b/apps/hr/patch/patch.go
@@ -0,0 +1,69 @@
+// Package patch 是《高報酬戰將》執行層的記憶體補丁（hr 專案的 `docs/spec/002-stack-size`）。
+//
+// 補丁只在記憶體內套用，不修改任何原版檔案。目前只有一個：把 Borland 啟動碼讀的
+// `_stklen` 從 0x1000 改成 0x8000，避免巢狀選單用完 4 KB 堆疊（`docs/re/011`）。
+package patch
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+const (
+	// MainEXESHA256 是補丁適用的 MAIN.EXE。
+	MainEXESHA256 = "08ed144e8f8d6e97d19f0759bce2420665998143f2f0f056ab7adc718e550e3e"
+
+	// StklenAddr 是 `_stklen` 在載入後的線性位址：DGROUP 540F:040C。
+	// 原版檔案位移 0x57DFC（標頭 0x4A00 bytes，載入基底線性 0x1100）。
+	// 啟動碼讀它的位置是 IDA 1000:0062（執行期 0110:0062）。
+	StklenAddr = 0x540F*16 + 0x40C
+
+	StklenOriginal = 0x1000
+	StklenPatched  = 0x8000
+)
+
+// Result 描述一次套用。
+type Result struct {
+	Applied bool
+	Addr    uint32
+	Old     uint16
+	New     uint16
+}
+
+func (r Result) String() string {
+	if !r.Applied {
+		return "堆疊補丁：未套用"
+	}
+	return fmt.Sprintf("堆疊補丁：位址 %05X，_stklen %04X → %04X", r.Addr, r.Old, r.New)
+}
+
+// ImageSHA256 回傳映像的 SHA-256（小寫十六進位）。
+func ImageSHA256(img []byte) string {
+	h := sha256.Sum256(img)
+	return hex.EncodeToString(h[:])
+}
+
+// ApplyStackPatch 在尚未執行任何指令的機器上改寫 `_stklen`。
+//
+//   - 映像雜湊不是 MainEXESHA256：不改，回 Applied ＝ false。
+//   - 該位址的原值不是 StklenOriginal：回錯誤，不降級、不靜默略過。
+//   - 機器已執行過指令（Steps ≠ 0）：回錯誤。狀態檔載入後的記憶體內，這個位址存的是
+//     啟動碼寫回的 SP 起點，不是設定值，不可再當設定值處理。
+func ApplyStackPatch(m *machine.Machine, imageSHA string, newStklen uint16) (Result, error) {
+	if imageSHA != MainEXESHA256 {
+		return Result{}, nil
+	}
+	if m.Steps != 0 {
+		return Result{}, fmt.Errorf("堆疊補丁只能在尚未執行任何指令時套用（Steps ＝ %d）", m.Steps)
+	}
+	old := m.Read16(StklenAddr)
+	if old != StklenOriginal {
+		return Result{}, fmt.Errorf("%05X 處的 _stklen 是 %04X，不是預期的 %04X；映像或載入位置與假設不同",
+			StklenAddr, old, StklenOriginal)
+	}
+	m.Write16(StklenAddr, newStklen)
+	return Result{Applied: true, Addr: StklenAddr, Old: old, New: newStklen}, nil
+}
diff --git a/apps/hr/patch/patch_test.go b/apps/hr/patch/patch_test.go
new file mode 100644
index 0000000..77108ed
--- /dev/null
+++ b/apps/hr/patch/patch_test.go
@@ -0,0 +1,113 @@
+package patch
+
+import (
+	"os"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// 原版素材不在本儲存庫：缺檔就 skip，不用替代檔（CLAUDE.md [HARD]）。
+func loadMain(t *testing.T) (*machine.Machine, string) {
+	t.Helper()
+	path := os.Getenv("HR_MAIN_EXE")
+	if path == "" {
+		path = "/orig/orig/MAIN.EXE"
+	}
+	img, err := os.ReadFile(path)
+	if err != nil {
+		t.Skipf("沒有原版 MAIN.EXE（%s）：%v", path, err)
+	}
+	m := machine.New()
+	if err := m.LoadEXE(img); err != nil {
+		t.Fatal(err)
+	}
+	return m, ImageSHA256(img)
+}
+
+func TestApplyChangesStartupStack(t *testing.T) {
+	m, sha := loadMain(t)
+	if sha != MainEXESHA256 {
+		t.Skipf("MAIN.EXE 的雜湊不是補丁適用的版本：%s", sha)
+	}
+	if got := m.Read16(StklenAddr); got != StklenOriginal {
+		t.Fatalf("載入後的 _stklen ＝ %04X，預期 %04X", got, StklenOriginal)
+	}
+	r, err := ApplyStackPatch(m, sha, StklenPatched)
+	if err != nil || !r.Applied || r.Old != StklenOriginal || r.New != StklenPatched {
+		t.Fatalf("套用結果 %+v，錯誤 %v", r, err)
+	}
+	if got := m.Read16(StklenAddr); got != StklenPatched {
+		t.Fatalf("套用後 _stklen ＝ %04X", got)
+	}
+	d := dos.New(m, "/orig/orig")
+	d.Install()
+	for i := 0; i < 200 && m.CPU.R[cpu.SP] != 0x8010; i++ {
+		if err := m.Step(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if sp := m.CPU.R[cpu.SP]; sp != StklenPatched+0x10 {
+		t.Fatalf("啟動後 SP ＝ %04X，預期 %04X", sp, StklenPatched+0x10)
+	}
+	if ss := m.CPU.Seg[cpu.SS]; ss != 0x54C0 {
+		t.Fatalf("啟動後 SS ＝ %04X，預期 54C0", ss)
+	}
+}
+
+func TestUnpatchedStartupSP(t *testing.T) {
+	m, sha := loadMain(t)
+	if sha != MainEXESHA256 {
+		t.Skipf("雜湊不符：%s", sha)
+	}
+	d := dos.New(m, "/orig/orig")
+	d.Install()
+	for i := 0; i < 200 && m.CPU.R[cpu.SP] != 0x1010; i++ {
+		if err := m.Step(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if sp := m.CPU.R[cpu.SP]; sp != StklenOriginal+0x10 {
+		t.Fatalf("未修補時啟動後 SP ＝ %04X，預期 %04X", sp, StklenOriginal+0x10)
+	}
+}
+
+func TestHashMismatchLeavesImageAlone(t *testing.T) {
+	m, _ := loadMain(t)
+	before := m.Read16(StklenAddr)
+	r, err := ApplyStackPatch(m, "0000", StklenPatched)
+	if err != nil || r.Applied {
+		t.Fatalf("雜湊不符時不應套用：%+v，%v", r, err)
+	}
+	if m.Read16(StklenAddr) != before {
+		t.Fatal("雜湊不符時記憶體被改了")
+	}
+}
+
+func TestUnexpectedOldValueIsAnError(t *testing.T) {
+	m, sha := loadMain(t)
+	if sha != MainEXESHA256 {
+		t.Skip("雜湊不符")
+	}
+	m.Write16(StklenAddr, 0x2000)
+	if _, err := ApplyStackPatch(m, sha, StklenPatched); err == nil {
+		t.Fatal("原值不是 0x1000 時應回錯誤")
+	}
+}
+
+func TestRefusesAfterExecution(t *testing.T) {
+	m, sha := loadMain(t)
+	if sha != MainEXESHA256 {
+		t.Skip("雜湊不符")
+	}
+	d := dos.New(m, "/orig/orig")
+	d.Install()
+	if err := m.Step(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ApplyStackPatch(m, sha, StklenPatched); err == nil {
+		t.Fatal("已執行過指令時應回錯誤")
+	}
+}
diff --git a/apps/hr/play/game.go b/apps/hr/play/game.go
new file mode 100644
index 0000000..a6d6e06
--- /dev/null
+++ b/apps/hr/play/game.go
@@ -0,0 +1,179 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"image"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	"github.com/hajimehoshi/ebiten/v2/ebitenutil"
+	"github.com/hajimehoshi/ebiten/v2/inpututil"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+const (
+	gameW, gameH = 640, 400 // 遊戲區；VRAM 的第 40 至 439 列
+	topBlank     = 40
+)
+
+type game struct {
+	s       *hrrt.Session
+	dataDir string
+	linear  bool
+
+	img    *ebiten.Image
+	rgba   []byte
+	lastSq uint64
+
+	mx, my  int
+	btn     [2]bool
+	help    bool
+	fullscr bool
+
+	stop    *hrrt.Stop
+	stopCh  chan *hrrt.Stop
+	started time.Time
+}
+
+func newGame(s *hrrt.Session, dataDir string, linear bool) *game {
+	g := &game{s: s, dataDir: dataDir, linear: linear, stopCh: make(chan *hrrt.Stop, 1), started: time.Now(), mx: -1}
+	g.img = ebiten.NewImage(640, 480)
+	g.rgba = make([]byte, 640*480*4)
+	go func() { g.stopCh <- s.Run(context.Background()) }()
+	return g
+}
+
+func (g *game) Update() error {
+	select {
+	case st := <-g.stopCh:
+		g.stop = st
+		if st != nil && st.Normal() {
+			return ebiten.Termination
+		}
+		if st != nil {
+			fmt.Fprintln(os.Stderr, "停機：", st.Msg)
+		}
+	default:
+	}
+	if ebiten.IsKeyPressed(ebiten.KeyControl) && inpututil.IsKeyJustPressed(ebiten.KeyQ) {
+		return ebiten.Termination
+	}
+	if inpututil.IsKeyJustPressed(ebiten.KeyF1) {
+		g.help = !g.help
+	}
+	if inpututil.IsKeyJustPressed(ebiten.KeyF11) || (ebiten.IsKeyPressed(ebiten.KeyAlt) && inpututil.IsKeyJustPressed(ebiten.KeyEnter)) {
+		g.fullscr = !g.fullscr
+		ebiten.SetFullscreen(g.fullscr)
+	}
+	if inpututil.IsKeyJustPressed(ebiten.KeyF12) {
+		g.screenshot()
+	}
+	if g.stop != nil {
+		return nil
+	}
+	// 滑鼠：Layout 回 640x400，所以 CursorPosition 就是遊戲區座標。
+	x, y := ebiten.CursorPosition()
+	x, y = clamp(x, 0, gameW-1), clamp(y, 0, gameH-1)
+	if x != g.mx || y != g.my {
+		g.mx, g.my = x, y
+		g.s.Input(hrrt.MouseMoveEvent(x, y))
+	}
+	for b, mb := range []ebiten.MouseButton{ebiten.MouseButtonLeft, ebiten.MouseButtonRight} {
+		if inpututil.IsMouseButtonJustPressed(mb) {
+			g.btn[b] = true
+			g.s.Input(hrrt.MouseButtonEvent(x, y, b, true))
+		}
+		if g.btn[b] && inpututil.IsMouseButtonJustReleased(mb) {
+			g.btn[b] = false
+			g.s.Input(hrrt.MouseButtonEvent(x, y, b, false))
+		}
+	}
+	if !g.help {
+		for _, ev := range keyEvents(ebiten.AppendInputChars(nil)) {
+			g.s.Input(ev)
+		}
+	}
+	return nil
+}
+
+func (g *game) Draw(screen *ebiten.Image) {
+	if f := g.s.Frame(); f != nil && f.Seq != g.lastSq {
+		g.lastSq = f.Seq
+		px := g.rgba
+		for i, j := 0, 0; i < len(f.RGB) && j < len(px); i, j = i+3, j+4 {
+			px[j], px[j+1], px[j+2], px[j+3] = f.RGB[i], f.RGB[i+1], f.RGB[i+2], 0xFF
+		}
+		g.img.WritePixels(px)
+	}
+	op := &ebiten.DrawImageOptions{}
+	if g.linear {
+		op.Filter = ebiten.FilterLinear
+	} else {
+		op.Filter = ebiten.FilterNearest
+	}
+	screen.DrawImage(g.img.SubImage(image.Rect(0, topBlank, 640, topBlank+gameH)).(*ebiten.Image), op)
+	if g.stop != nil && !g.stop.Normal() {
+		ebitenutil.DebugPrintAt(screen, "Stopped: "+stopKindName(g.stop.Kind)+" (details in the log). Close the window.", 4, 4)
+	}
+	if g.help {
+		st := g.s.Stats()
+		ebitenutil.DebugPrintAt(screen, fmt.Sprintf(
+			"F1 help   F11/Alt+Enter fullscreen   F12 screenshot   Ctrl+Q quit\n"+
+				"steps %d  ticks %d  sim %.0fs  interval %d  lowered %v\n"+
+				"stack min SP %04X top %04X  open files %d\n"+
+				"TPS %.1f  FPS %.1f",
+			st.Steps, st.Ticks, st.SimSeconds, st.Interval, st.Lowered, st.MinSP, st.StackTop, st.DOS.OpenHandles,
+			ebiten.ActualTPS(), ebiten.ActualFPS()), 4, 4)
+	}
+}
+
+func (g *game) Layout(w, h int) (int, int) { return gameW, gameH }
+
+func (g *game) screenshot() {
+	f := g.s.Frame()
+	if f == nil {
+		return
+	}
+	dir := filepath.Join(g.dataDir, "screenshots")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return
+	}
+	name := filepath.Join(dir, time.Now().Format("20060102-150405")+".png")
+	if err := writeFramePNG(name, f); err != nil {
+		fmt.Fprintln(os.Stderr, "截圖失敗：", err)
+		return
+	}
+	fmt.Println("截圖：", name)
+}
+
+func clamp(v, lo, hi int) int {
+	if v < lo {
+		return lo
+	}
+	if v > hi {
+		return hi
+	}
+	return v
+}
+
+func stopKindName(k hrrt.StopKind) string {
+	switch k {
+	case hrrt.StopStackOverflow:
+		return "stack overflow"
+	case hrrt.StopCPUError:
+		return "CPU error"
+	case hrrt.StopOutOfRange:
+		return "execution left memory"
+	case hrrt.StopHalted:
+		return "CPU halted"
+	case hrrt.StopDivide:
+		return "divide error"
+	case hrrt.StopExitOther:
+		return "program exit"
+	}
+	return "stopped"
+}
