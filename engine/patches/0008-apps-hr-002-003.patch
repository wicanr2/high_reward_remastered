@@ -0,0 +1,36 @@
+package runtime
+
+import (
+	"bytes"
+	"fmt"
+	"image"
+	"image/color"
+	"image/png"
+)
+
+// ScreenPNG 回傳目前畫面的調色盤 PNG，編碼與 `cmd/probe -dump-screen-png` 相同
+// （Machine.Planar 加 VGA.DACIndex，標準庫預設壓縮），所以雜湊可與 docs/re/008 的收據比對。
+// 只能在 Run、RunSteps 沒有執行時呼叫。
+func (s *Session) ScreenPNG() ([]byte, error) {
+	m := s.m
+	w, h, px := m.Planar()
+	if px == nil {
+		return nil, fmt.Errorf("現在不是平面模式（視訊模式 %02Xh），沒有畫面可存", m.VideoMode())
+	}
+	dac := m.Palette()
+	pal := make(color.Palette, 256)
+	for i := range dac {
+		pal[i] = color.RGBA{dac[i][0], dac[i][1], dac[i][2], 255}
+	}
+	img := image.NewPaletted(image.Rect(0, 0, w, h), pal)
+	for y := 0; y < h; y++ {
+		for x := 0; x < w; x++ {
+			img.Pix[y*img.Stride+x] = m.VGA.DACIndex(px[y*w+x])
+		}
+	}
+	var buf bytes.Buffer
+	if err := png.Encode(&buf, img); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
diff --git a/apps/hr/runtime/required.go b/apps/hr/runtime/required.go
new file mode 100644
index 0000000..7aabca4
--- /dev/null
+++ b/apps/hr/runtime/required.go
@@ -0,0 +1,94 @@
+package runtime
+
+import (
+	"bufio"
+	"crypto/sha256"
+	_ "embed"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+// requiredTSV 是必要檔案清單：檔名、大小、SHA-256。來自 docs/re/source-inventory.tsv 中
+// jsdos 版含有、且 MAIN.EXE 讀取的資料檔（排除存檔 GAMEFILE.*、其他程式與片頭片尾素材）。
+// 清單只含檔名、大小與雜湊，不含任何原版內容。
+//
+//go:embed required.tsv
+var requiredTSV string
+
+// RequiredFile 是清單中的一列。
+type RequiredFile struct {
+	Name   string
+	Size   int64
+	SHA256 string
+}
+
+// RequiredFiles 解析內嵌清單。
+func RequiredFiles() []RequiredFile {
+	var out []RequiredFile
+	sc := bufio.NewScanner(strings.NewReader(requiredTSV))
+	for sc.Scan() {
+		f := strings.Split(sc.Text(), "\t")
+		if len(f) < 3 {
+			continue
+		}
+		n, err := strconv.ParseInt(f[1], 10, 64)
+		if err != nil {
+			continue
+		}
+		out = append(out, RequiredFile{Name: f[0], Size: n, SHA256: f[2]})
+	}
+	return out
+}
+
+// CheckRequiredFiles 檢查必要檔案存在且大小相符；verify 為真時另驗 SHA-256。
+// DOS 檔名大小寫不分：目錄中以大小寫不分的方式找。有問題就列出全部並回錯誤。
+func CheckRequiredFiles(root string, verify bool) error {
+	ents, err := os.ReadDir(root)
+	if err != nil {
+		return fmt.Errorf("讀不到原版目錄 %s：%w", root, err)
+	}
+	byUpper := map[string]string{}
+	for _, e := range ents {
+		byUpper[strings.ToUpper(e.Name())] = e.Name()
+	}
+	var bad []string
+	for _, rf := range RequiredFiles() {
+		real, ok := byUpper[strings.ToUpper(rf.Name)]
+		if !ok {
+			bad = append(bad, rf.Name+"（缺檔）")
+			continue
+		}
+		p := filepath.Join(root, real)
+		st, err := os.Stat(p)
+		if err != nil || st.IsDir() {
+			bad = append(bad, rf.Name+"（不是檔案）")
+			continue
+		}
+		if st.Size() != rf.Size {
+			bad = append(bad, fmt.Sprintf("%s（大小 %d，應為 %d）", rf.Name, st.Size(), rf.Size))
+			continue
+		}
+		if verify {
+			f, err := os.Open(p)
+			if err != nil {
+				bad = append(bad, rf.Name+"（無法開啟）")
+				continue
+			}
+			h := sha256.New()
+			_, err = io.Copy(h, f)
+			f.Close()
+			if err != nil || hex.EncodeToString(h.Sum(nil)) != rf.SHA256 {
+				bad = append(bad, rf.Name+"（SHA-256 不符）")
+			}
+		}
+	}
+	if len(bad) > 0 {
+		return fmt.Errorf("原版目錄 %s 不完整，%d 個檔案有問題：\n  %s", root, len(bad), strings.Join(bad, "\n  "))
+	}
+	return nil
+}
