+// Package runtime 是《高報酬戰將》的執行層（hr 專案的 `docs/spec/003-runtime-and-frontend`）。
+//
+// Session 包住 machine.Machine 與 dos.DOS，不認識視窗。一個模擬迴圈（Run）擁有機器，
+// 其他執行緒只經 Input（輸入佇列）、Frame（最近一個快照）與 Stats 與它互動。
+// 無頭驗收用 RunSteps（同步、不計時），此時不可同時呼叫 Run。
+//
+// ⚠ 本專案不含任何原版檔案；root 由玩家自備，且只讀（寫入走暫存層 SaveDir）。
+package runtime
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/patch"
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+const (
+	// NativeInterval 表示不動 dosgolem 的預設計時器間隔（分頻 65536 時約 636,085 道指令）。
+	NativeInterval = ^uint64(0)
+	// DefaultInterval 是 play 模式的預設間隔（docs/spec/003 第 4 節）。
+	DefaultInterval = 300_000
+	// MinInterval 是自動降速的下限。
+	MinInterval = 150_000
+	// TickHz 是 PIT 通道 0 在分頻 65536 時的頻率。
+	TickHz float64 = 1193182.0 / 65536.0
+
+	trimEvery  = 2_000_000
+	batchSteps = 2048
+)
+
+// Options 是 Open 的選項。
+type Options struct {
+	// SaveDir 是可寫暫存層（dosgolem 的 d.Scratch）；空字串表示唯讀（寫入只記帳）。
+	SaveDir string
+	// Interval 是分頻 65536 時每個計時器中斷間隔幾道指令。0 ＝ DefaultInterval，
+	// NativeInterval ＝ 維持 dosgolem 預設。
+	Interval uint64
+	// NoStackPatch 關掉 docs/spec/002 的堆疊補丁（對照與診斷用）。
+	NoStackPatch bool
+	// HostClock 讓 DOS 日期與時間取主機時鐘（存檔列才有真的日期）；預設維持固定值（決定性）。
+	HostClock bool
+	// Verify 對必要檔案做完整 SHA-256 驗證（預設只驗存在與大小）。
+	Verify bool
+	// Log 收執行層的紀錄行；nil ＝ 丟棄。
+	Log func(format string, args ...any)
+	// NoPacing 讓 Run 不依牆鐘限速（測試用）。
+	NoPacing bool
+}
+
+// StopKind 是停機種類。
+type StopKind int
+
+const (
+	StopQuit      StopKind = iota + 1 // 結束碼 1：玩家結束遊戲
+	StopEnding                        // 結束碼 0：進入片尾（HR.BAT 會接著跑 END.EXE，第 1 版不跑）
+	StopExitOther                     // 其他結束碼
+	StopCPUError
+	StopOutOfRange
+	StopStackOverflow
+	StopHalted
+	StopDivide
+	StopSteps // RunSteps 跑滿
+)
+
+// Stop 是停機原因。RunSteps 跑滿步數時回 Kind ＝ StopSteps。
+type Stop struct {
+	Kind StopKind
+	Code int
+	Msg  string
+}
+
+func (s *Stop) Error() string { return s.Msg }
+
+// Normal 回報這是不是正常結束（玩家結束或進片尾）。
+func (s *Stop) Normal() bool { return s != nil && (s.Kind == StopQuit || s.Kind == StopEnding) }
+
+// Frame 是 Run 在滑鼠輪詢點產生的畫面快照，建立後不再修改。
+type Frame struct {
+	W, H  int
+	RGB   []uint8 // W*H*3
+	Steps uint64
+	Ticks uint64
+	Seq   uint64
+}
+
+// Stats 是 Run 定期更新的統計。
+type Stats struct {
+	Steps      uint64
+	Ticks      uint64
+	SimSeconds float64
+	DOS        dos.Stats
+	MinSP      uint16
+	StackTop   uint16
+	Interval   uint64 // 目前的間隔（分頻 65536 時每個 tick 幾道指令）
+	Lowered    bool   // 是否曾因跑不到 18.2 Hz 降低間隔
+}
+
+// EventKind 是輸入事件種類。
+type EventKind int
+
+const (
+	EvMouseMove EventKind = iota + 1
+	EvMouseButton
+	EvKey
+)
+
+// Event 是前端送來的輸入。座標是遊戲區座標（0..639、0..399）。
+type Event struct {
+	Kind EventKind
+	X, Y int
+	Btn  int  // 0 左、1 右
+	Down bool // 按下或放開
+	Key  dos.Key
+}
+
+// Session 是一次遊戲執行。
+type Session struct {
+	m    *machine.Machine
+	d    *dos.DOS
+	opt  Options
+	logf func(string, ...any)
+
+	imageSHA string
+	patchRes patch.Result
+
+	stackSeg uint16
+	stackTop uint16
+	minSP    uint16
+
+	mu     sync.Mutex
+	inbox  []Event
+	stats  Stats
+	frame  atomic.Pointer[Frame]
+	frmSeq uint64
+
+	// 以下欄位只由持有機器的迴圈（Run 或 RunSteps）使用。
+	held           [2]bool
+	relPending     [2]bool
+	pollsAt        [2]int
+	pos            [2]int
+	totalPolls     int
+	lastPolls      int
+	nextTrim       uint64
+	lastSnap       time.Time
+	lastSnapPollAt time.Time
+	interval       uint64
+	lowered        bool
+	lastDiv        int
+}
+
+// Open 驗證原版、載入 MAIN.EXE、套用補丁並安裝 DOS 服務。
+func Open(root string, opt Options) (*Session, error) {
+	s := &Session{opt: opt, logf: opt.Log, minSP: 0xFFFF}
+	if s.logf == nil {
+		s.logf = func(string, ...any) {}
+	}
+	img, err := os.ReadFile(filepath.Join(root, "MAIN.EXE"))
+	if err != nil {
+		return nil, fmt.Errorf("讀不到 MAIN.EXE：%w", err)
+	}
+	s.imageSHA = patch.ImageSHA256(img)
+	if s.imageSHA != patch.MainEXESHA256 {
+		return nil, fmt.Errorf("MAIN.EXE 的 SHA-256 是 %s，本程式只支援 %s", s.imageSHA, patch.MainEXESHA256)
+	}
+	if err := CheckRequiredFiles(root, opt.Verify); err != nil {
+		return nil, err
+	}
+	s.m = machine.New()
+	if err := s.m.LoadEXE(img); err != nil {
+		return nil, err
+	}
+	if !opt.NoStackPatch {
+		res, err := patch.ApplyStackPatch(s.m, s.imageSHA, patch.StklenPatched)
+		if err != nil {
+			return nil, err
+		}
+		s.patchRes = res
+		s.logf("%s", res)
+	}
+	s.d = dos.New(s.m, root)
+	s.d.Install()
+	if opt.SaveDir != "" {
+		if err := os.MkdirAll(opt.SaveDir, 0o755); err != nil {
+			return nil, err
+		}
+		s.d.Scratch = opt.SaveDir
+	}
+	if opt.HostClock {
+		now := time.Now()
+		s.d.Date = dos.Date{Year: uint16(now.Year()), Month: uint8(now.Month()), Day: uint8(now.Day()), Weekday: uint8(now.Weekday())}
+		s.d.Now = dos.Time{Hour: uint8(now.Hour()), Min: uint8(now.Minute()), Sec: uint8(now.Second())}
+	}
+	s.stackSeg = s.m.CPU.Seg[cpu.SS]
+	iv := opt.Interval
+	if iv == 0 {
+		iv = DefaultInterval
+	}
+	if iv != NativeInterval {
+		s.setInterval(iv)
+		s.logf("計時器間隔：每 %d 道指令一個 tick（分頻 65536）", iv)
+	} else {
+		s.interval = s.m.IRQ0Every
+	}
+	s.nextTrim = trimEvery
+	return s, nil
+}
+
+// setInterval 把分頻 65536 時的間隔設為 e。IRQ0Base 的標定分頻是 17,000
+// （machine.recalcIRQ0），所以要 IRQ0Base ＝ e × 17000 ÷ 65536 再 RecalcIRQ0。
+func (s *Session) setInterval(e uint64) {
+	s.interval = e
+	s.m.IRQ0Base = e * 17000 / 65536
+	s.m.RecalcIRQ0()
+}
+
+// PatchResult 回報啟動時的補丁結果。
+func (s *Session) PatchResult() patch.Result { return s.patchRes }
+
+// Input 把輸入事件放進佇列，由持有機器的迴圈在批次邊界取出。可由任何執行緒呼叫。
+func (s *Session) Input(ev Event) {
+	s.mu.Lock()
+	s.inbox = append(s.inbox, ev)
+	s.mu.Unlock()
+}
+
+// Frame 回傳最近一個快照；還沒有快照時回 nil。
+func (s *Session) Frame() *Frame { return s.frame.Load() }
+
+// Stats 回傳最近的統計。
+func (s *Session) Stats() Stats {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.stats
+}
+
+// Machine 與 DOS 讓無頭測試與診斷工具讀機器；只能在 Run、RunSteps 沒有執行時使用。
+func (s *Session) Machine() *machine.Machine { return s.m }
+func (s *Session) DOS() *dos.DOS             { return s.d }
+
+func (s *Session) drainInput() {
+	s.mu.Lock()
+	evs := s.inbox
+	s.inbox = nil
+	s.mu.Unlock()
+	for _, ev := range evs {
+		switch ev.Kind {
+		case EvMouseMove:
+			s.pos = [2]int{ev.X, ev.Y + 40}
+			s.d.MoveMouse(ev.X, ev.Y+40)
+		case EvMouseButton:
+			b := ev.Btn & 1
+			s.d.MoveMouse(ev.X, ev.Y+40)
+			s.pos = [2]int{ev.X, ev.Y + 40}
+			if ev.Down {
+				if !s.held[b] {
+					s.d.PressMouse(b)
+					s.held[b] = true
+					s.relPending[b] = false
+					s.pollsAt[b] = len(s.d.Mouse.Polls)
+				}
+			} else if s.held[b] {
+				s.relPending[b] = true
+			}
+		case EvKey:
+			if ev.Key.ASCII != 0 {
+				s.d.Stdin = append(s.d.Stdin, ev.Key.ASCII)
+			} else {
+				s.d.Stdin = append(s.d.Stdin, 0x00, ev.Key.Scan)
+			}
+		}
+	}
+	// 按住到遊戲輪詢 3 次才放開，避免遊戲來不及讀到短按。
+	for b := 0; b < 2; b++ {
+		if s.held[b] && s.relPending[b] && len(s.d.Mouse.Polls)-s.pollsAt[b] >= 3 {
+			s.d.ReleaseMouse(b)
+			s.held[b], s.relPending[b] = false, false
+		}
+	}
+}
+
+func (s *Session) idleForTrim() bool {
+	return !s.held[0] && !s.held[1] && len(s.d.Stdin) == 0
+}
+
+// stepBatch 執行至多 n 道指令，回傳停機原因（nil ＝ 還沒停）。
+func (s *Session) stepBatch(n int) *Stop {
+	m, d := s.m, s.d
+	for i := 0; i < n; i++ {
+		c := m.CPU
+		if s.stackTop == 0 && m.Steps > 200 {
+			s.stackTop = m.Read16(patch.StklenAddr)
+		}
+		if s.stackTop != 0 && c.Seg[cpu.SS] == s.stackSeg {
+			sp := c.R[cpu.SP]
+			if sp > s.stackTop {
+				return &Stop{Kind: StopStackOverflow, Msg: fmt.Sprintf("堆疊溢位：SS:SP ＝ %04X:%04X，堆疊頂端 %04X，本次最低 SP %04X", s.stackSeg, sp, s.stackTop, s.minSP)}
+			}
+			if sp < s.minSP {
+				s.minSP = sp
+			}
+		}
+		if a := cpu.Linear(c.Seg[cpu.CS], c.IP); a >= machine.VideoSeg*16 && a < machine.MemSize {
+			return &Stop{Kind: StopOutOfRange, Msg: fmt.Sprintf("跑出可用記憶體：CS:IP ＝ %04X:%04X", c.Seg[cpu.CS], c.IP)}
+		}
+		if err := m.Step(); err != nil {
+			return &Stop{Kind: StopCPUError, Msg: "CPU 錯誤：" + err.Error()}
+		}
+		if d.Exited {
+			switch d.ExitCode {
+			case 1:
+				return &Stop{Kind: StopQuit, Code: 1, Msg: "玩家結束遊戲（結束碼 1）"}
+			case 0:
+				return &Stop{Kind: StopEnding, Code: 0, Msg: "遊戲結束（結束碼 0，原版會接著播片尾）"}
+			default:
+				return &Stop{Kind: StopExitOther, Code: int(d.ExitCode), Msg: fmt.Sprintf("程式以結束碼 %d 結束", d.ExitCode)}
+			}
+		}
+		if m.CPU.Halted {
+			return &Stop{Kind: StopHalted, Msg: "CPU 停在 HLT"}
+		}
+		if n := len(m.CPU.DivErrors); n != s.lastDiv {
+			s.lastDiv = n
+			return &Stop{Kind: StopDivide, Msg: "除以零或除法溢位"}
+		}
+	}
+	return nil
+}
+
+// afterBatch 做批次邊界的事：快照、清診斷紀錄、更新統計。
+func (s *Session) afterBatch(force bool) {
+	m, d := s.m, s.d
+	polls := len(d.Mouse.Polls)
+	if polls != s.lastPolls {
+		s.lastPolls = polls
+		// 輪詢點：遊戲回到等輸入的迴圈，游標已畫完。快照上限約 120 Hz。
+		if time.Since(s.lastSnap) >= 8*time.Millisecond || force {
+			s.snapshot()
+		}
+		s.lastSnapPollAt = time.Now()
+	} else if time.Since(s.lastSnapPollAt) > 100*time.Millisecond && time.Since(s.lastSnap) >= 100*time.Millisecond {
+		s.snapshot() // 動畫或載入中，滑鼠沒有輪詢
+	}
+	if m.Steps >= s.nextTrim && s.idleForTrim() {
+		s.nextTrim = m.Steps + trimEvery
+		s.totalPolls += TrimDiagnostics(m, d)
+		s.lastPolls = 0
+	}
+	st := Stats{
+		Steps: m.Steps, Ticks: m.Ticks, SimSeconds: float64(m.Ticks) / TickHz,
+		DOS: d.Stats(), MinSP: s.minSP, StackTop: s.stackTop, Interval: s.interval, Lowered: s.lowered,
+	}
+	s.mu.Lock()
+	s.stats = st
+	s.mu.Unlock()
+}
+
+func (s *Session) snapshot() {
+	w, h, rgb := s.m.PlanarRGB()
+	if rgb == nil {
+		return
+	}
+	s.frmSeq++
+	s.lastSnap = time.Now()
+	s.frame.Store(&Frame{W: w, H: h, RGB: rgb, Steps: s.m.Steps, Ticks: s.m.Ticks, Seq: s.frmSeq})
+}
+
+// RunSteps 同步執行到絕對步數 total（不計時）。回傳的 Stop 在跑滿時 Kind ＝ StopSteps。
+func (s *Session) RunSteps(total uint64) *Stop {
+	for s.m.Steps < total {
+		s.drainInput()
+		n := batchSteps
+		if rest := total - s.m.Steps; rest < uint64(n) {
+			n = int(rest)
+		}
+		if st := s.stepBatch(n); st != nil {
+			s.afterBatch(true)
+			return st
+		}
+		s.afterBatch(false)
+	}
+	s.afterBatch(true)
+	return &Stop{Kind: StopSteps, Msg: fmt.Sprintf("跑滿 %d 道指令", total)}
+}
+
+// Run 依牆鐘計時執行，直到停機或 ctx 取消（取消時回 nil）。
+func (s *Session) Run(ctx context.Context) *Stop {
+	start := time.Now()
+	baseTicks := s.m.Ticks
+	lastCheck := start
+	var checkTicks uint64 = baseTicks
+	for {
+		if ctx.Err() != nil {
+			return nil
+		}
+		s.drainInput()
+		if !s.opt.NoPacing {
+			desired := uint64(time.Since(start).Seconds()*TickHz) + baseTicks
+			if s.m.Ticks >= desired {
+				time.Sleep(time.Millisecond)
+				s.drainInput()
+				s.afterBatch(false)
+				continue
+			}
+			// 落後太多（視窗被擋住、機器暫停）時不補跑，重設基準，避免突然快轉。
+			if desired-s.m.Ticks > 18 {
+				start = time.Now()
+				baseTicks = s.m.Ticks
+			}
+		}
+		if st := s.stepBatch(batchSteps); st != nil {
+			s.afterBatch(true)
+			return st
+		}
+		s.afterBatch(false)
+		if !s.opt.NoPacing && time.Since(lastCheck) >= 2*time.Second {
+			s.adapt(time.Since(lastCheck), s.m.Ticks-checkTicks)
+			lastCheck, checkTicks = time.Now(), s.m.Ticks
+		}
+	}
+}
+
+// adapt 每 2 秒檢查：實際 tick 數落後 5% 以上就把間隔降為 90%（下限 MinInterval），不再調回。
+func (s *Session) adapt(elapsed time.Duration, ticks uint64) {
+	want := elapsed.Seconds() * TickHz
+	if want <= 0 || float64(ticks) >= want*0.95 {
+		return
+	}
+	if s.interval == 0 || s.interval <= MinInterval {
+		return
+	}
+	next := s.interval * 9 / 10
+	if next < MinInterval {
+		next = MinInterval
+	}
+	s.logf("跑不到 %.1f Hz（2 秒內 %d 個 tick，應有 %.0f）：間隔 %d → %d", TickHz, ticks, want, s.interval, next)
+	s.setInterval(next)
+	s.lowered = true
+}
diff --git a/apps/hr/runtime/session_test.go b/apps/hr/runtime/session_test.go
new file mode 100644
index 0000000..892c89c
--- /dev/null
+++ b/apps/hr/runtime/session_test.go
@@ -0,0 +1,180 @@
+package runtime
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/internal/dos"
+)
+
+// 原版素材不在本儲存庫：缺檔就 skip，不用替代檔（CLAUDE.md [HARD]）。
+func origRoot(t *testing.T) string {
+	t.Helper()
+	root := os.Getenv("HR_ORIG")
+	if root == "" {
+		root = "/orig/orig"
+	}
+	if _, err := os.Stat(filepath.Join(root, "MAIN.EXE")); err != nil {
+		t.Skipf("沒有原版目錄（%s）：%v", root, err)
+	}
+	return root
+}
+
+func pngHash(t *testing.T, s *Session) string {
+	t.Helper()
+	b, err := s.ScreenPNG()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:])
+}
+
+func TestOpenRejectsWrongImage(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "MAIN.EXE"), []byte("MZ not the real thing"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	_, err := Open(dir, Options{})
+	if err == nil || !strings.Contains(err.Error(), "SHA-256") {
+		t.Fatalf("應拒絕並顯示實際雜湊，得到 %v", err)
+	}
+}
+
+func TestRequiredFilesListsMissing(t *testing.T) {
+	root := origRoot(t)
+	dir := t.TempDir()
+	// 只放一個檔案：其餘全缺。連結原版的 MAIN.EXE（大小與雜湊都對）。
+	if err := os.Symlink(filepath.Join(root, "MAIN.EXE"), filepath.Join(dir, "MAIN.EXE")); err != nil {
+		t.Fatal(err)
+	}
+	err := CheckRequiredFiles(dir, false)
+	if err == nil || !strings.Contains(err.Error(), "缺檔") || !strings.Contains(err.Error(), "CFONT.15") {
+		t.Fatalf("應列出缺檔，得到 %v", err)
+	}
+	if err := CheckRequiredFiles(root, false); err != nil {
+		t.Fatalf("原版目錄應通過檢查：%v", err)
+	}
+}
+
+func TestRequiredFilesDetectsSizeMismatch(t *testing.T) {
+	root := origRoot(t)
+	dir := t.TempDir()
+	ents, _ := os.ReadDir(root)
+	for _, e := range ents {
+		if e.IsDir() {
+			continue
+		}
+		if err := os.Symlink(filepath.Join(root, e.Name()), filepath.Join(dir, e.Name())); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// 換掉一個檔案：大小不同。
+	p := filepath.Join(dir, "ARROW.GRP")
+	os.Remove(p)
+	if err := os.WriteFile(p, []byte("short"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := CheckRequiredFiles(dir, false); err == nil || !strings.Contains(err.Error(), "ARROW.GRP") {
+		t.Fatalf("應偵測大小不符，得到 %v", err)
+	}
+}
+
+// 收據 A（docs/re/008）：probe 跑 30,000,000 道指令的畫面 PNG。不經輸入，所以兩邊只差執行層的包裝。
+// 補丁開或關都應得到同一張畫面（堆疊補丁不改變指令數與畫面）。
+func TestColdStartReceiptA(t *testing.T) {
+	root := origRoot(t)
+	const want = "112cd52c2060d430c533b98ef8228ecc86063fce53a3db781b6047c4a3a86a6e"
+	for _, noPatch := range []bool{true, false} {
+		s, err := Open(root, Options{Interval: NativeInterval, NoStackPatch: noPatch})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if st := s.RunSteps(30_000_000); st.Kind != StopSteps {
+			t.Fatalf("提前停機：%v", st)
+		}
+		if got := pngHash(t, s); got != want {
+			t.Errorf("NoStackPatch ＝ %v：畫面 PNG 雜湊 %s，預期 %s", noPatch, got, want)
+		}
+	}
+}
+
+func TestStackPatchAppliedAtStartup(t *testing.T) {
+	root := origRoot(t)
+	s, err := Open(root, Options{Interval: NativeInterval})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !s.PatchResult().Applied {
+		t.Fatal("預設應套用堆疊補丁")
+	}
+	s.RunSteps(1_000_000)
+	if top := s.Stats().StackTop; top != 0x8010 {
+		t.Fatalf("堆疊頂端 %04X，預期 8010", top)
+	}
+}
+
+// 輸入映射：遊戲區座標加 40 列後送入；按下到遊戲輪詢 3 次才放開。
+func TestMouseClickReachesGameAndHoldsForPolls(t *testing.T) {
+	root := origRoot(t)
+	s, err := Open(root, Options{Interval: NativeInterval})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.RunSteps(35_000_000)
+	pollsBefore := len(s.DOS().Mouse.Polls)
+	// 標題選單的新遊戲項目在 640x480 畫面座標 (312, 211)，也就是遊戲區座標 (312, 171)。
+	s.Input(Event{Kind: EvMouseButton, X: 312, Y: 171, Btn: 0, Down: true})
+	s.Input(Event{Kind: EvMouseButton, X: 312, Y: 171, Btn: 0, Down: false})
+	s.RunSteps(90_000_000)
+	if s.held[0] {
+		t.Fatalf("9000 萬道指令後遊戲已恢復輪詢，按鍵應已放開（輪詢 %d → %d）", pollsBefore, len(s.DOS().Mouse.Polls))
+	}
+	// 收據 B（docs/re/008）：新遊戲第一畫面。
+	const wantB = "853a695340271b1e2540702d6d5f1e78f3807e230c666a181e3985097879adaf"
+	if got := pngHash(t, s); got != wantB {
+		t.Fatalf("90M 步畫面 PNG 雜湊 %s，預期 %s", got, wantB)
+	}
+}
+
+// 按鍵走 d.Stdin：一般鍵送 ASCII，擴充鍵送 00 加掃描碼。
+func TestKeyEventsGoToStdin(t *testing.T) {
+	root := origRoot(t)
+	s, err := Open(root, Options{Interval: NativeInterval})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.Input(Event{Kind: EvKey, Key: dos.Key{Scan: 0x1C, ASCII: '\r'}})
+	s.Input(Event{Kind: EvKey, Key: dos.Key{Scan: 0x48}})
+	s.drainInput()
+	got := s.DOS().Stdin
+	want := []byte{'\r', 0x00, 0x48}
+	if string(got) != string(want) {
+		t.Fatalf("Stdin ＝ % X，預期 % X", got, want)
+	}
+}
+
+// Run 的取消路徑與快照：不計時地跑一小段，取到快照。
+func TestRunProducesFrameAndStopsOnCancel(t *testing.T) {
+	root := origRoot(t)
+	s, err := Open(root, Options{Interval: NativeInterval, NoPacing: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.RunSteps(36_000_000)
+	ctx, cancel := context.WithTimeout(context.Background(), 400*time.Millisecond)
+	defer cancel()
+	if st := s.Run(ctx); st != nil {
+		t.Fatalf("取消時應回 nil，得到 %v", st)
+	}
+	f := s.Frame()
+	if f == nil || f.W != 640 || f.H != 480 || len(f.RGB) != 640*480*3 {
+		t.Fatalf("快照不正確：%+v", f)
+	}
+}
