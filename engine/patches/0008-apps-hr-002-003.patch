@@ -0,0 +1,22 @@
+package runtime
+
+import (
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// TrimDiagnostics 清掉 dosgolem 為觀測而記下的無上限紀錄。長時間執行不清，約 10 億道指令
+// 就會用盡記憶體（docs/re/011）。回傳被清掉的滑鼠輪詢數。
+//
+// 呼叫端要在滑鼠按住、鍵盤佇列非空時避免呼叫：按住的釋放條件看輪詢數。
+func TrimDiagnostics(m *machine.Machine, d *dos.DOS) (polls int) {
+	polls = len(d.Mouse.Polls)
+	d.Mouse.Polls, d.Mouse.Sets, d.Mouse.Events, d.Mouse.PressReads = nil, nil, nil, nil
+	d.Opened, d.Missing, d.MissingAccess = nil, nil, nil
+	d.Reads, d.Allocs, d.EMSOps, d.XMSMoves = nil, nil, nil, nil
+	d.Wrote, d.VecSets, d.FileOps, d.PalOps = nil, nil, nil, nil
+	d.MemOps, d.ExecLog, d.Overlays, d.Resizes = nil, nil, nil, nil
+	d.CallTrace, d.MemTrace, d.KeyReads, d.Console = nil, nil, nil, nil
+	m.PortLog, m.SegLog, m.DSLoads, m.Speaker, m.OPL = nil, nil, nil, nil, nil
+	return polls
+}
