+package runtime
+
+import "github.com/wicanr2/dosgolem/internal/dos"
+
+// 輸入事件的建構函式，讓前端不必引用 internal 套件。
+
+// MouseMoveEvent 是滑鼠移動（遊戲區座標 0..639、0..399）。
+func MouseMoveEvent(x, y int) Event { return Event{Kind: EvMouseMove, X: x, Y: y} }
+
+// MouseButtonEvent 是滑鼠按下或放開（btn：0 左、1 右）。
+func MouseButtonEvent(x, y, btn int, down bool) Event {
+	return Event{Kind: EvMouseButton, X: x, Y: y, Btn: btn, Down: down}
+}
+
+// KeyEvent 是鍵盤事件。一般鍵 ascii 非 0；擴充鍵（方向鍵、功能鍵）ascii ＝ 0，只有掃描碼。
+func KeyEvent(scan, ascii uint8) Event {
+	return Event{Kind: EvKey, Key: dos.Key{Scan: scan, ASCII: ascii}}
+}
+
+// RuneKeyEvent 把可印出的 ASCII 字元轉成鍵盤事件；不是可送入的字元回 false。
+func RuneKeyEvent(r rune) (Event, bool) {
+	k, ok := dos.KeyForRune(r)
+	if !ok {
+		return Event{}, false
+	}
+	return Event{Kind: EvKey, Key: k}, true
+}
