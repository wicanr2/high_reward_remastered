diff --git a/apps/hr/cmd/hr-smoke/main.go b/apps/hr/cmd/hr-smoke/main.go
new file mode 100644
index 0000000..da51696
--- /dev/null
+++ b/apps/hr/cmd/hr-smoke/main.go
@@ -0,0 +1,62 @@
+// Command hr-smoke 不開視窗，用執行層（apps/hr/runtime）跑到指定步數並存畫面 PNG。
+// 打包驗收與無頭收據用：與 hr-play 走同一個 runtime.Open（映像驗證、必要檔案檢查、堆疊補丁），
+// 不依賴 ebiten 與顯示環境。⚠ 本專案不含任何原版檔案，-orig 由玩家自備。
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"flag"
+	"fmt"
+	"os"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+func main() {
+	orig := flag.String("orig", "original", "原版檔案目錄（內含 MAIN.EXE）")
+	steps := flag.Uint64("steps", 90_000_000, "執行到的絕對步數")
+	clicks := flag.String("click", "", "在這個步數按下並放開左鍵：`步數:X:Y`（X、Y 是 640x480 畫面座標）")
+	out := flag.String("png", "smoke.png", "輸出 PNG")
+	native := flag.Bool("native", true, "使用 dosgolem 預設計時器間隔（收據用）；false ＝ play 預設")
+	noPatch := flag.Bool("no-stack-patch", false, "關掉堆疊補丁")
+	flag.Parse()
+	opt := hrrt.Options{Interval: hrrt.NativeInterval, NoStackPatch: *noPatch, Log: func(f string, a ...any) { fmt.Fprintf(os.Stderr, f+"\n", a...) }}
+	if !*native {
+		opt.Interval = 0
+	}
+	s, err := hrrt.Open(*orig, opt)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	if *clicks != "" {
+		var at uint64
+		var x, y int
+		if _, err := fmt.Sscanf(*clicks, "%d:%d:%d", &at, &x, &y); err != nil {
+			fmt.Fprintln(os.Stderr, "-click 要寫成 步數:X:Y：", err)
+			os.Exit(2)
+		}
+		if st := s.RunSteps(at); st.Kind != hrrt.StopSteps {
+			fmt.Fprintln(os.Stderr, "提前停機：", st.Msg)
+			os.Exit(1)
+		}
+		s.Input(hrrt.MouseButtonEvent(x, y-40, 0, true))
+		s.Input(hrrt.MouseButtonEvent(x, y-40, 0, false))
+	}
+	if st := s.RunSteps(*steps); st.Kind != hrrt.StopSteps {
+		fmt.Fprintln(os.Stderr, "提前停機：", st.Msg)
+		os.Exit(1)
+	}
+	b, err := s.ScreenPNG()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	if err := os.WriteFile(*out, b, 0o644); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	h := sha256.Sum256(b)
+	fmt.Printf("步數 %d，畫面 PNG SHA-256 %s，%s\n", s.Machine().Steps, hex.EncodeToString(h[:]), *out)
+}
