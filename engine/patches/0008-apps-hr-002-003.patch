--- /dev/null
+++ b/apps/hr/play/keys.go
@@ -0,0 +1,63 @@
+package main
+
+import (
+	"github.com/hajimehoshi/ebiten/v2"
+	"github.com/hajimehoshi/ebiten/v2/inpututil"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// 前端保留鍵（docs/spec/003 第 7 節）：F1 說明、F11 或 Alt+Enter 全螢幕、F12 截圖、Ctrl+Q 結束。
+// 其餘按鍵送進遊戲。遊戲只用 int 21h 的讀鍵服務（docs/re/004）。
+
+type scanKey struct {
+	key   ebiten.Key
+	scan  uint8
+	ascii uint8
+}
+
+// 特殊鍵：ascii 為 0 的是擴充鍵（DOS 先回 00 再回掃描碼）。
+var specialKeys = []scanKey{
+	{ebiten.KeyEnter, 0x1C, '\r'},
+	{ebiten.KeyNumpadEnter, 0x1C, '\r'},
+	{ebiten.KeyEscape, 0x01, 0x1B},
+	{ebiten.KeyBackspace, 0x0E, 0x08},
+	{ebiten.KeyTab, 0x0F, '\t'},
+	{ebiten.KeyArrowUp, 0x48, 0},
+	{ebiten.KeyArrowDown, 0x50, 0},
+	{ebiten.KeyArrowLeft, 0x4B, 0},
+	{ebiten.KeyArrowRight, 0x4D, 0},
+	{ebiten.KeyHome, 0x47, 0},
+	{ebiten.KeyEnd, 0x4F, 0},
+	{ebiten.KeyPageUp, 0x49, 0},
+	{ebiten.KeyPageDown, 0x51, 0},
+	{ebiten.KeyInsert, 0x52, 0},
+	{ebiten.KeyDelete, 0x53, 0},
+	{ebiten.KeyF2, 0x3C, 0},
+	{ebiten.KeyF3, 0x3D, 0},
+	{ebiten.KeyF4, 0x3E, 0},
+	{ebiten.KeyF5, 0x3F, 0},
+	{ebiten.KeyF6, 0x40, 0},
+	{ebiten.KeyF7, 0x41, 0},
+	{ebiten.KeyF8, 0x42, 0},
+	{ebiten.KeyF9, 0x43, 0},
+	{ebiten.KeyF10, 0x44, 0},
+}
+
+// keyEvents 回傳這一幀要送進遊戲的鍵盤事件。可印出的字元走 ebiten 的文字輸入（含大小寫與
+// 鍵盤配置），特殊鍵走表（按下的那一幀送一次，按住 30 幀後每 3 幀重複一次）。
+func keyEvents(runes []rune) []hrrt.Event {
+	var out []hrrt.Event
+	for _, r := range runes {
+		if ev, ok := hrrt.RuneKeyEvent(r); ok {
+			out = append(out, ev)
+		}
+	}
+	for _, k := range specialKeys {
+		d := inpututil.KeyPressDuration(k.key)
+		if d == 1 || (d >= 30 && d%3 == 0) {
+			out = append(out, hrrt.KeyEvent(k.scan, k.ascii))
+		}
+	}
+	return out
+}
