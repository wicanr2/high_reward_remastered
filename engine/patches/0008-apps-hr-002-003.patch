+// Command hr-play 是《高報酬戰將》的桌面前端（hr 專案的 docs/spec/003-runtime-and-frontend）。
+//
+// 玩家自備原版檔案（內含 MAIN.EXE 的目錄）；本程式不含、不下載任何原版檔案。
+// 存檔寫在使用者資料目錄的 high_reward/saves（dosgolem 的暫存層），原版目錄不動。
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/hajimehoshi/ebiten/v2"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+var version = "dev"
+
+func main() {
+	orig := flag.String("orig", "", "原版檔案所在目錄（內含 MAIN.EXE）")
+	scale := flag.Int("scale", 2, "視窗倍率（遊戲區 640x400 的整數倍）")
+	linear := flag.Bool("linear", false, "放大時使用線性濾鏡（預設最近鄰）")
+	full := flag.Bool("fullscreen", false, "全螢幕啟動")
+	verify := flag.Bool("verify", false, "啟動時完整驗證必要檔案的 SHA-256")
+	interval := flag.Uint64("interval", 0, "計時器間隔（道指令／tick，分頻 65536）；0 ＝ 預設 300000")
+	noPatch := flag.Bool("no-stack-patch", false, "關掉堆疊補丁（診斷用）")
+	saves := flag.String("saves", "", "存檔目錄（預設在使用者資料目錄的 high_reward/saves）")
+	showVer := flag.Bool("version", false, "顯示版本")
+	flag.Parse()
+	if *showVer {
+		fmt.Println("hr-play", version)
+		return
+	}
+	root, err := findOriginal(*orig)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	dd, err := dataDir()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "建立資料目錄失敗：", err)
+		os.Exit(2)
+	}
+	saveDir := *saves
+	if saveDir == "" {
+		saveDir = filepath.Join(dd, "saves")
+	}
+	logf := func(format string, a ...any) { fmt.Fprintf(os.Stderr, format+"\n", a...) }
+	s, err := hrrt.Open(root, hrrt.Options{
+		SaveDir: saveDir, Interval: *interval, NoStackPatch: *noPatch, HostClock: true, Verify: *verify, Log: logf,
+	})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	if *scale < 1 {
+		*scale = 1
+	}
+	ebiten.SetWindowSize(gameW**scale, gameH**scale)
+	ebiten.SetWindowTitle("高報酬戰將 (hr-play " + version + ")")
+	ebiten.SetCursorMode(ebiten.CursorModeHidden)
+	ebiten.SetFullscreen(*full)
+	ebiten.SetTPS(60)
+	g := newGame(s, dd, *linear)
+	g.fullscr = *full
+	if err := ebiten.RunGame(g); err != nil && err != ebiten.Termination {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
