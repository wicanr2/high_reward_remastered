+package main
+
+import (
+	"image"
+	"image/color"
+	"image/png"
+	"os"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// writeFramePNG 把快照（遊戲區 640x400）存成 PNG。
+func writeFramePNG(path string, f *hrrt.Frame) error {
+	img := image.NewRGBA(image.Rect(0, 0, 640, 400))
+	for y := 0; y < 400; y++ {
+		for x := 0; x < 640; x++ {
+			i := ((y+40)*f.W + x) * 3
+			img.Set(x, y, color.RGBA{f.RGB[i], f.RGB[i+1], f.RGB[i+2], 255})
+		}
+	}
+	out, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	defer out.Close()
+	return png.Encode(out, img)
+}
