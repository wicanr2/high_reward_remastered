+package main
+
+import (
+	"fmt"
+	"image"
+	"image/color"
+	"image/png"
+	"os"
+	"path/filepath"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+)
+
+// dumpUnknown 把記錄模式收集的未識別戳記存成調色盤 PNG（索引 0 至 15 是顏色，索引 16 是透明），
+// 給美術處理當輸入（游標等執行期才產生、不在檔案內的圖）。pal 是參考調色盤（hd/palettes.tsv 的 MAIN）。
+// 輸出是原版美術的衍生物，只放 workplace/。
+func dumpUnknown(dir string, list []*hd.UnknownEntry, pal *[16][3]uint8) error {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	var p color.Palette
+	for i := 0; i < 16; i++ {
+		if pal != nil {
+			p = append(p, color.RGBA{pal[i][0], pal[i][1], pal[i][2], 255})
+		} else {
+			p = append(p, color.RGBA{uint8(i * 17), uint8(i * 17), uint8(i * 17), 255})
+		}
+	}
+	p = append(p, color.RGBA{0, 0, 0, 0})
+	for _, u := range list {
+		if len(u.E) != u.W*u.H {
+			continue
+		}
+		img := image.NewPaletted(image.Rect(0, 0, u.W, u.H), p)
+		copy(img.Pix, u.E)
+		name := filepath.Join(dir, fmt.Sprintf("%s_%s_%dx%d.png", u.Hash[:12], u.Kind, u.W, u.H))
+		f, err := os.Create(name)
+		if err != nil {
+			return err
+		}
+		if err := png.Encode(f, img); err != nil {
+			f.Close()
+			return err
+		}
+		f.Close()
+		fmt.Println("輸出", name)
+	}
+	return nil
+}
