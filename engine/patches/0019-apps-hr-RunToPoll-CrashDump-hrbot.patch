 }
 
 // stepBatch 執行至多 n 道指令，回傳停機原因（nil ＝ 還沒停）。
@@ -376,6 +391,10 @@ func (s *Session) stepBatch(n int) *Stop {
 				s.snapshot()
 			}
 			s.lastSnapPollAt = time.Now()
+			if s.pollStop {
+				s.pollHit = true
