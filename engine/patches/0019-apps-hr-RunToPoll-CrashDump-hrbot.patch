+		t.Fatalf("RunToPoll：stop=%v polled=%v", st, polled)
+	}
+	n := len(s.DOS().Mouse.Polls)
+	st, polled = s.RunToPoll(50_000_000)
+	if st != nil || !polled || len(s.DOS().Mouse.Polls) == n {
+		t.Fatalf("第二次 RunToPoll 應再停在下一次輪詢：polled=%v", polled)
+	}
+	s.Input(MouseMoveEvent(10, 10))
+	dir := t.TempDir()
+	if err := s.CrashDump(dir, "測試"); err != nil {
+		t.Fatal(err)
+	}
+	for _, f := range []string{"info.txt", "screen.png", "state.state"} {
+		if fi, err := os.Stat(filepath.Join(dir, f)); err != nil || fi.Size() == 0 {
+			t.Fatalf("%s 沒有寫出：%v", f, err)
+		}
+	}
+	b, _ := os.ReadFile(filepath.Join(dir, "info.txt"))
+	if !strings.Contains(string(b), "移動 (10,10)") || !strings.Contains(string(b), "原因 測試") {
+		t.Fatalf("info.txt 內容不對：\n%s", b)
+	}
+}
+
+// 鍵盤佇列非空（遊戲在不讀鍵盤的畫面不取走按鍵）不能擋住診斷紀錄的清除，否則 PortLog 等無上限成長。
+func TestIdleForTrimIgnoresPendingKeys(t *testing.T) {
+	root := origRoot(t)
+	s, err := Open(root, Options{Interval: NativeInterval})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.d.Stdin = append(s.d.Stdin, 0x7F)
+	if !s.idleForTrim() {
+		t.Fatal("鍵盤佇列非空時應可清診斷紀錄")
+	}
+	s.held[0] = true
+	if s.idleForTrim() {
+		t.Fatal("滑鼠按住時不可清診斷紀錄")
+	}
+	s.held[0] = false
+	// 長跑：佇列裡一直有鍵，PortLog 仍被定期清掉（每 2,000,000 道一次）
+	if st := s.RunSteps(40_000_000); st.Kind != StopSteps {
+		t.Fatal(st.Msg)
+	}
+	if n := len(s.m.PortLog); n > 3_000_000 {
+		t.Fatalf("PortLog 長到 %d 筆，沒有被清", n)
+	}
+}
