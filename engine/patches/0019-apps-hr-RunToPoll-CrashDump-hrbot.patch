--- /dev/null
+++ b/apps/hr/runtime/crash.go
@@ -0,0 +1,47 @@
+package runtime
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/state"
+)
+
+// CrashDump 把停機現場存進 dir（docs/spec/003 第 3.1 節）：info.txt（原因、步數、最低 SP、最近輸入）、
+// state.state（dosgolem 狀態檔，可用 hrhd 或探針載入重現）、screen.png（停機當下的畫面）。
+// 只能在 Run、RunSteps 沒有執行時呼叫。輸出含原版內容的衍生物，不要提交或散布。
+func (s *Session) CrashDump(dir, reason string) error {
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	var b strings.Builder
+	st := s.Stats()
+	fmt.Fprintf(&b, "時間 %s\n原因 %s\n步數 %d\ntick %d（遊戲時間 %.1f 分）\n計時器間隔 %d\n最低 SP %04X，堆疊頂端 %04X\n堆疊補丁 %v\n",
+		time.Now().Format(time.RFC3339), reason, s.m.Steps, s.m.Ticks, float64(s.m.Ticks)/TickHz/60, st.Interval, st.MinSP, st.StackTop, s.patchRes.String())
+	fmt.Fprintf(&b, "CS:IP %04X:%04X  SS:SP %04X:%04X\n", s.m.CPU.Seg[cpu.CS], s.m.CPU.IP, s.m.CPU.Seg[cpu.SS], s.m.CPU.R[cpu.SP])
+	s.mu.Lock()
+	recent := append([]Event(nil), s.recent...)
+	s.mu.Unlock()
+	fmt.Fprintf(&b, "最近 %d 筆輸入（舊到新）：\n", len(recent))
+	for _, ev := range recent {
+		switch ev.Kind {
+		case EvMouseMove:
+			fmt.Fprintf(&b, "  移動 (%d,%d)\n", ev.X, ev.Y)
+		case EvMouseButton:
+			fmt.Fprintf(&b, "  按鍵%d %v (%d,%d)\n", ev.Btn, ev.Down, ev.X, ev.Y)
+		case EvKey:
+			fmt.Fprintf(&b, "  鍵 ascii=%02X scan=%02X\n", ev.Key.ASCII, ev.Key.Scan)
+		}
+	}
+	if err := os.WriteFile(filepath.Join(dir, "info.txt"), []byte(b.String()), 0o644); err != nil {
+		return err
+	}
+	if png, err := s.ScreenPNG(); err == nil {
+		_ = os.WriteFile(filepath.Join(dir, "screen.png"), png, 0o644)
+	}
+	return state.Save(filepath.Join(dir, "state.state"), s.m, s.d)
+}
