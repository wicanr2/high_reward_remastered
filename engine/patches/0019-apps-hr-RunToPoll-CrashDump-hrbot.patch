+// Command hrbot 是《高報酬戰將》的遊玩機器人（hr 專案的 docs/re/016）：
+// 走執行層的真實輸入路徑（Session.Input：移動、按下、放開，與前端同一條），以人類節奏點擊，
+// 線上學習哪些位置有反應，把遊戲時間（計時器 tick ÷ 18.2065）跑到指定時數，偵測當機。
+//
+// 不是隨機長跑：每個動作之間有人類的移動與思考時間，遊戲遇到的畫面由機器人實際點出來；
+// 結束遊戲（結束碼 1）就像玩家重開一樣重新啟動並讀檔；全程不還原任何狀態，不改記憶體。
+// ⚠ 本專案不含任何原版檔案，-orig 由玩家自備；輸出的截圖與狀態檔是原版內容的衍生物，只放 workplace/。
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"hash/fnv"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"runtime"
+	"runtime/pprof"
+	"sort"
+	"strings"
+	"time"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/state"
+)
+
+var tickHz = 1193182.0 / 65536.0
+
+type act struct {
+	Kind byte // L 左鍵、R 右鍵、K 按鍵
+	X, Y int  // 遊戲區座標（0..639、0..399）
+	Key  string
+}
+
+func (a act) String() string {
+	if a.Kind == 'K' {
+		return "K:" + a.Key
+	}
+	return fmt.Sprintf("%c:%d,%d", a.Kind, a.X, a.Y)
+}
+
+var keyTable = map[string]dos.Key{
+	"Enter": {ASCII: 0x0D, Scan: 0x1C},
+	"Esc":   {ASCII: 0x1B, Scan: 0x01},
+	"Space": {ASCII: 0x20, Scan: 0x39},
+}
+var keyNames = []string{"Enter", "Esc", "Space"}
+
+type options struct {
+	orig, out          string
+	hours              float64
+	seed               int64
+	interval           uint64
+	noPatch            bool
+	thinkMin, thinkMax int
+	shotMinutes        float64
+	ckptMinutes        float64
+	freezeSeconds      float64
+	maxActions         int
+	heapProfile        string
+}
+
+type knowledge struct {
+	tried   map[string]map[act]int // sig -> 動作 -> 嘗試次數
+	changed map[string]map[act]int // sig -> 動作 -> 讓 sig 改變的次數
+	banned  map[string]map[act]bool
+	visits  map[string]int
+	hot     map[[2]int]int // 16 像素格 -> 在任何畫面讓 sig 改變的次數
+}
+
+type pendingAct struct {
+	sig string
+	a   act
+}
+
+type bot struct {
+	opt  options
+	rnd  *rand.Rand
+	s    *hrrt.Session
+	k    knowledge
+	out  string
+	log  *os.File
+	last *pendingAct
+
+	opens map[string]int // 檔案名稱 -> open 次數（畫面種類的代理：BSTAGE.MRG 表示進了戰鬥）
+
+	base      uint64 // 先前各次啟動累計的 tick
+	gameTicks uint64 // 累計遊戲 tick（base ＋ 目前 Session 的 Ticks）
+	restarts  int
+	quits     int
+	actionsN  int
+	minSP     uint16
+	sigsEver  map[string]bool
+	sameSig   int // 目前連續幾個動作 sig 沒變
+	maxSame   int
+	freezes   []string // 疑似凍結事件（遊戲超過 freeze-seconds 沒輪詢滑鼠）
+	crashInfo string
+	frozen    bool
+	ckpts     []string
+}
+
+func main() {
+	var o options
+	flag.StringVar(&o.orig, "orig", "/orig/orig", "原版檔案目錄（唯讀）")
+	flag.StringVar(&o.out, "out", "/out/bot", "輸出目錄")
+	flag.Float64Var(&o.hours, "game-hours", 2, "要玩的遊戲時間（小時，計時器 tick ÷ 18.2065）")
+	flag.Int64Var(&o.seed, "seed", 1, "亂數種子（同程式、同種子可重現）")
+	flag.Uint64Var(&o.interval, "interval", hrrt.DefaultInterval, "計時器間隔（道指令／tick，分頻 65536），預設同前端")
+	flag.BoolVar(&o.noPatch, "no-stack-patch", false, "關掉堆疊補丁（對照：看原版堆疊會不會在遊玩中溢位）")
+	flag.IntVar(&o.thinkMin, "think-min", 18, "每個動作之後的思考時間下限（tick，約 1 秒）")
+	flag.IntVar(&o.thinkMax, "think-max", 55, "思考時間上限（tick，約 3 秒）")
+	flag.Float64Var(&o.shotMinutes, "shot-minutes", 5, "每幾遊戲分鐘存一張截圖")
+	flag.Float64Var(&o.ckptMinutes, "ckpt-minutes", 5, "每幾遊戲分鐘存一個狀態檔（只留最近 3 個，供重現）")
+	flag.Float64Var(&o.freezeSeconds, "freeze-seconds", 60, "遊戲超過幾秒沒輪詢滑鼠就記為疑似凍結")
+	flag.IntVar(&o.maxActions, "max-actions", 0, "動作數上限（0 ＝ 不限，測試用）")
+	flag.StringVar(&o.heapProfile, "heap-profile", "", "結束時寫出 heap profile（診斷記憶體成長用）")
+	flag.Parse()
+	if err := run(o); err != nil {
+		fmt.Fprintln(os.Stderr, "hrbot:", err)
+		os.Exit(2)
+	}
+}
+
+func run(o options) error {
+	for _, d := range []string{"shots", "ckpt", "saves"} {
+		if err := os.MkdirAll(filepath.Join(o.out, d), 0o755); err != nil {
+			return err
+		}
+	}
+	lf, err := os.Create(filepath.Join(o.out, "actions.jsonl"))
+	if err != nil {
+		return err
+	}
+	defer lf.Close()
+	b := &bot{opt: o, rnd: rand.New(rand.NewSource(o.seed)), out: o.out, log: lf, opens: map[string]int{}, minSP: 0xFFFF, sigsEver: map[string]bool{}}
+	b.k = knowledge{tried: map[string]map[act]int{}, changed: map[string]map[act]int{}, banned: map[string]map[act]bool{}, visits: map[string]int{}, hot: map[[2]int]int{}}
+	timeline, err := os.Create(filepath.Join(o.out, "timeline.tsv"))
+	if err != nil {
+		return err
+	}
+	defer timeline.Close()
+	fmt.Fprintln(timeline, "game_min\tsteps\tactions\tminSP\tsigs\trestarts\tquits\tfreeze\topen_BSTAGE\topen_BC32\topen_FACE\topen_GAMEFILE\tmaxSameSig\twall_s")
+	target := uint64(o.hours * 3600 * tickHz)
+	nextShot := uint64(o.shotMinutes * 60 * tickHz)
+	nextCkpt := uint64(o.ckptMinutes * 60 * tickHz)
+	nextMinute := uint64(60 * tickHz)
+	wall0 := time.Now()
+	status := "completed"
+loop:
+	for b.gameTicks < target {
+		if o.maxActions > 0 && b.actionsN >= o.maxActions {
+			status = "max-actions"
+			break
+		}
+		if b.s == nil {
+			if st, err := b.startGame(); err != nil {
+				return err
+			} else if st != nil {
+				status = b.handleStop(st)
+				if status != "" {
+					break loop
+				}
+				continue
+			}
+		}
+		if st := b.step(); st != nil {
+			if s := b.handleStop(st); s != "" {
+				status = s
+				break
+			}
+			continue
+		}
+		if b.frozen {
+			status = "frozen"
+			break
+		}
+		for b.gameTicks >= nextMinute {
+			b.minuteReport(timeline, time.Since(wall0))
+			nextMinute += uint64(60 * tickHz)
+		}
+		if b.gameTicks >= nextShot {
+			b.shot(fmt.Sprintf("t%05d", b.gameTicks/uint64(tickHz)))
+			nextShot += uint64(o.shotMinutes * 60 * tickHz)
+		}
+		if b.gameTicks >= nextCkpt {
+			b.checkpoint()
+			nextCkpt += uint64(o.ckptMinutes * 60 * tickHz)
+		}
+	}
+	b.minuteReport(timeline, time.Since(wall0))
+	if o.heapProfile != "" {
+		if f, err := os.Create(o.heapProfile); err == nil {
+			runtime.GC()
+			_ = pprof.WriteHeapProfile(f)
+			f.Close()
+		}
+	}
+	b.summary(status, time.Since(wall0))
+	fmt.Printf("結束：%s，遊戲時間 %.2f 小時，動作 %d，重開 %d，結束遊戲 %d，不同畫面 %d，最低 SP %04X，疑似凍結 %d，耗時 %.0f 秒\n",
+		status, float64(b.gameTicks)/tickHz/3600, b.actionsN, b.restarts, b.quits, len(b.sigsEver), b.minSP, len(b.freezes), time.Since(wall0).Seconds())
+	if strings.HasPrefix(status, "crash") || status == "frozen" {
+		os.Exit(1)
+	}
+	return nil
+}
+
+// handleStop 處理停機：玩家結束或片尾就記下並重開（回傳空字串），其他是當機（存現場並回傳狀態）。
+func (b *bot) handleStop(st *hrrt.Stop) string {
+	if st.Normal() {
+		b.quits++
+		if b.last != nil {
+			if b.k.banned[b.last.sig] == nil {
+				b.k.banned[b.last.sig] = map[act]bool{}
+			}
+			b.k.banned[b.last.sig][b.last.a] = true
+		}
+		b.logEvent("quit", st.Msg)
+		b.endSession()
+		return ""
+	}
+	b.crash(st)
+	return "crash:" + stopName(st.Kind)
+}
+
+func stopName(k hrrt.StopKind) string {
+	switch k {
+	case hrrt.StopStackOverflow:
+		return "stack-overflow"
+	case hrrt.StopCPUError:
+		return "cpu-error"
+	case hrrt.StopOutOfRange:
+		return "out-of-range"
+	case hrrt.StopHalted:
+		return "halted"
+	case hrrt.StopDivide:
+		return "divide"
+	case hrrt.StopExitOther:
+		return "exit-other"
+	}
+	return fmt.Sprint(int(k))
+}
+
+// startGame 開一個新的 Session（等於玩家重新啟動程式），走到標題選單，讀檔或開新遊戲。
+func (b *bot) startGame() (*hrrt.Stop, error) {
+	s, err := hrrt.Open(b.opt.orig, hrrt.Options{SaveDir: filepath.Join(b.out, "saves"), Interval: b.opt.interval, NoStackPatch: b.opt.noPatch})
+	if err != nil {
+		return nil, err
+	}
+	b.s = s
+	b.restarts++
+	b.last = nil
+	polled, st := b.toPoll(240)
+	if st != nil {
+		return st, nil
+	}
+	if !polled {
+		return nil, fmt.Errorf("標題選單沒有出現")
+	}
+	if st := b.runTicks(60); st != nil { // 選單畫完
+		return st, nil
+	}
+	// 有存檔就讀最近存的槽，沒有就開新遊戲（標題選單座標：docs/re/008、012；640x480 座標的 y 減 40）
+	if slot := b.latestSave(); slot >= 0 {
+		if st := b.click(act{Kind: 'L', X: 312, Y: 228 - 40}); st != nil {
+			return st, nil
+		}
+		if st := b.runTicks(90); st != nil {
+			return st, nil
+		}
+		if st := b.click(act{Kind: 'L', X: 312, Y: 307 + 17*slot - 40}); st != nil {
+			return st, nil
+		}
+		b.logEvent("boot", fmt.Sprintf("讀存檔槽 %d", slot))
+	} else {
+		if st := b.click(act{Kind: 'L', X: 312, Y: 211 - 40}); st != nil {
+			return st, nil
+		}
+		b.logEvent("boot", "新遊戲")
+	}
+	return b.runTicks(120), nil
+}
+
+func (b *bot) latestSave() int {
+	best, bestT := -1, time.Time{}
+	for k := 0; k < 5; k++ {
+		p := filepath.Join(b.out, "saves", fmt.Sprintf("GAMEFILE.%03d", k))
+		if st, err := os.Stat(p); err == nil && st.ModTime().After(bestT) {
+			best, bestT = k, st.ModTime()
+		}
+	}
+	return best
+}
+
+func (b *bot) endSession() {
+	if b.s != nil {
+		b.base += b.s.Machine().Ticks
+	}
+	b.s = nil
+}
+
+// runTicks 讓遊戲跑 n 個計時器 tick 的時間。
+func (b *bot) runTicks(n int) *hrrt.Stop {
+	m := b.s.Machine()
+	st := b.s.RunSteps(m.Steps + uint64(n)*b.opt.interval)
+	b.account()
+	if st.Kind == hrrt.StopSteps {
+		return nil
+	}
+	return st
+}
+
+// toPoll 最多跑 maxTicks 個 tick，停在下一次滑鼠輪詢剛執行完（遊戲回到等輸入的迴圈）。
+func (b *bot) toPoll(maxTicks int) (bool, *hrrt.Stop) {
+	st, polled := b.s.RunToPoll(uint64(maxTicks) * b.opt.interval)
+	b.account()
+	if st != nil && st.Kind != hrrt.StopSteps {
+		return false, st
+	}
+	return polled, nil
+}
+
+// account 把這次 Session 的 tick 併進累計時間，更新最低 SP 與檔案開啟計數。
+func (b *bot) account() {
+	m := b.s.Machine()
+	b.gameTicks = b.base + m.Ticks
+	if sp := b.s.Stats().MinSP; sp < b.minSP {
+		b.minSP = sp
+	}
+	d := b.s.DOS()
+	for _, op := range d.FileOps {
+		if op.Op == "open" && !op.Failed {
+			b.opens[strings.ToUpper(op.Name)]++
+		}
+	}
+	d.FileOps = nil
+}
+
+func (b *bot) rtick(lo, hi int) int { return lo + b.rnd.Intn(hi-lo+1) }
+
+func (b *bot) click(a act) *hrrt.Stop {
+	btn := 0
+	if a.Kind == 'R' {
+		btn = 1
+	}
+	b.s.Input(hrrt.MouseMoveEvent(a.X, a.Y))
+	if st := b.runTicks(b.rtick(4, 12)); st != nil { // 人類移動滑鼠到目標
+		return st
+	}
+	b.s.Input(hrrt.MouseButtonEvent(a.X, a.Y, btn, true))
+	if st := b.runTicks(b.rtick(2, 4)); st != nil {
+		return st
+	}
+	b.s.Input(hrrt.MouseButtonEvent(a.X, a.Y, btn, false))
+	return b.runTicks(2)
+}
+
+func (b *bot) press(name string) *hrrt.Stop {
+	b.s.Input(hrrt.Event{Kind: hrrt.EvKey, Key: keyTable[name]})
+	return b.runTicks(2)
+}
+
+// chain 沿 BP 鏈走呼叫框，回傳由內到外的返回位址（overlay 區只留偏移）。與 hrexplore 的畫面身分同一個定義。
+func (b *bot) chain() string {
+	m := b.s.Machine()
+	c := m.CPU
+	bp := c.R[cpu.BP]
+	var out []string
+	for i := 0; i < 12; i++ {
+		lin := cpu.Linear(c.Seg[cpu.SS], bp)
+		ip, cs := m.Read16(lin+2), m.Read16(lin+4)
+		if cs >= 0x5400 {
+			out = append(out, fmt.Sprintf("ovr:%04X", ip))
+		} else {
+			out = append(out, fmt.Sprintf("%04X:%04X", cs, ip))
+		}
+		next := m.Read16(lin)
+		if next <= bp || next > 0xFFF0 {
+			break
+		}
+		bp = next
+	}
+	return strings.Join(out, "<") + fmt.Sprintf("@%04X", c.R[cpu.SP])
+}
+
+func (b *bot) screenHash() uint64 {
+	_, _, px := b.s.Machine().Planar()
+	h := fnv.New64a()
+	h.Write(px)
+	return h.Sum64()
+}
+
+// step 做一個遊戲動作：等到閒置輪詢點、認出畫面、學習上一個動作的結果、選動作、執行。
+func (b *bot) step() *hrrt.Stop {
+	freezeTicks := int(b.opt.freezeSeconds * tickHz)
+	polled, st := b.toPoll(freezeTicks)
+	if st != nil {
+		return st
+	}
+	if !polled {
+		return b.noPoll()
+	}
+	sig := b.chain()
+	b.learn(sig)
+	a := b.choose(sig)
+	b.last = &pendingAct{sig: sig, a: a}
+	b.recordTry(sig, a)
+	b.actionsN++
+	if len(b.log.Name()) > 0 {
+		j, _ := json.Marshal(map[string]any{"n": b.actionsN, "tick": b.gameTicks, "sig": sig, "act": a.String(), "sp": b.s.Stats().MinSP})
+		b.log.Write(append(j, '\n'))
+	}
+	var stop *hrrt.Stop
+	if a.Kind == 'K' {
+		stop = b.press(a.Key)
+	} else {
+		stop = b.click(a)
+	}
+	if stop != nil {
+		return stop
+	}
+	return b.runTicks(b.rtick(b.opt.thinkMin, b.opt.thinkMax)) // 思考時間
+}
+
+// noPoll 處理「超過 freeze-seconds 沒輪詢滑鼠」：記疑似凍結，每遊戲分鐘取一次畫面雜湊，
+// 輪詢恢復就繼續；10 分鐘沒恢復且畫面雜湊都沒變，判為凍結。
+func (b *bot) noPoll() *hrrt.Stop {
+	startTick := b.gameTicks
+	desc := fmt.Sprintf("遊戲時間 %.1f 分，動作 %d 之後沒有輪詢滑鼠，畫面 %s", float64(b.gameTicks)/tickHz/60, b.actionsN, b.chain())
+	b.shot(fmt.Sprintf("nopoll%04d", len(b.freezes)+1))
+	same := 0
+	h0 := b.screenHash()
+	for i := 0; i < 10; i++ {
+		polled, st := b.toPoll(int(60 * tickHz))
+		if st != nil {
+			return st
+		}
+		if polled {
+			b.freezes = append(b.freezes, fmt.Sprintf("%s；%.0f 秒後恢復", desc, float64(b.gameTicks-startTick)/tickHz))
+			b.logEvent("nopoll-recovered", b.freezes[len(b.freezes)-1])
+			return nil
+		}
+		if h := b.screenHash(); h == h0 {
+			same++
+		} else {
+			h0, same = h, 0
+		}
+	}
+	b.freezes = append(b.freezes, desc+"；10 分鐘沒有恢復")
+	if same >= 8 {
+		b.frozen = true
+		b.crashInfo = "凍結：10 遊戲分鐘沒有輪詢滑鼠且畫面不變（" + desc + "）"
+		b.dump("frozen")
+	}
+	return nil
+}
+
+func (b *bot) learn(sig string) {
+	b.sigsEver[sig] = true
+	b.k.visits[sig]++
+	if b.last == nil {
+		return
+	}
+	if sig != b.last.sig {
+		b.sameSig = 0
+		if b.k.changed[b.last.sig] == nil {
+			b.k.changed[b.last.sig] = map[act]int{}
+		}
+		b.k.changed[b.last.sig][b.last.a]++
+		if b.last.a.Kind != 'K' {
+			b.k.hot[[2]int{b.last.a.X / 16, b.last.a.Y / 16}]++
+		}
+	} else {
+		b.sameSig++
+		if b.sameSig > b.maxSame {
+			b.maxSame = b.sameSig
+		}
+	}
+}
+
+func (b *bot) recordTry(sig string, a act) {
+	if b.k.tried[sig] == nil {
+		b.k.tried[sig] = map[act]int{}
+	}
+	b.k.tried[sig][a]++
+}
+
+// choose 選下一個動作：偏好讓畫面改變過的動作，其次未試過的動作；有被禁止（會結束遊戲）的就避開。
+func (b *bot) choose(sig string) act {
+	tried, chg, ban := b.k.tried[sig], b.k.changed[sig], b.k.banned[sig]
+	ok := func(a act) bool { return !ban[a] }
+	r := b.rnd.Float64()
+	if b.sameSig > 25 { // 一直沒反應：改探索
+		r = 1
+	}
+	if len(chg) > 0 && r < 0.45 {
+		var cands []act
+		for a := range chg {
+			if ok(a) {
+				cands = append(cands, a)
+			}
+		}
+		if len(cands) > 0 {
+			sort.Slice(cands, func(i, j int) bool { return cands[i].String() < cands[j].String() })
+			return cands[b.rnd.Intn(len(cands))]
+		}
+	}
+	if r < 0.55 {
+		name := keyNames[b.rnd.Intn(len(keyNames))]
+		if a := (act{Kind: 'K', Key: name}); ok(a) {
+			return a
+		}
+	}
+	var a act
+	for i := 0; i < 16; i++ {
+		a = b.randomClick()
+		if ok(a) && tried[a] == 0 {
+			return a
+		}
+	}
+	for !ok(a) {
+		a = b.randomClick()
+	}
+	return a
+}
+
+func (b *bot) randomClick() act {
+	kind := byte('L')
+	if b.rnd.Intn(10) == 0 {
+		kind = 'R'
+	}
+	var x, y int
+	if len(b.k.hot) > 0 && b.rnd.Float64() < 0.5 {
+		cells := make([][2]int, 0, len(b.k.hot))
+		for c := range b.k.hot {
+			cells = append(cells, c)
+		}
+		sort.Slice(cells, func(i, j int) bool {
+			if cells[i][0] != cells[j][0] {
+				return cells[i][0] < cells[j][0]
+			}
+			return cells[i][1] < cells[j][1]
+		})
+		c := cells[b.rnd.Intn(len(cells))]
+		x, y = c[0]*16+b.rnd.Intn(16), c[1]*16+b.rnd.Intn(16)
+	} else {
+		x, y = b.rnd.Intn(640), b.rnd.Intn(400)
+	}
+	if x > 639 {
+		x = 639
+	}
+	if y > 399 {
+		y = 399
+	}
+	return act{Kind: kind, X: x, Y: y}
+}
+
+func (b *bot) logEvent(kind, msg string) {
+	j, _ := json.Marshal(map[string]any{"event": kind, "tick": b.gameTicks, "msg": msg, "n": b.actionsN})
+	b.log.Write(append(j, '\n'))
+}
+
+func (b *bot) shot(name string) {
+	if b.s == nil {
+		return
+	}
+	png, err := b.s.ScreenPNG()
+	if err != nil {
+		return
+	}
+	_ = os.WriteFile(filepath.Join(b.out, "shots", name+".png"), png, 0o644)
+}
+
+func (b *bot) checkpoint() {
+	if b.s == nil {
+		return
+	}
+	p := filepath.Join(b.out, "ckpt", fmt.Sprintf("t%05d.state", b.gameTicks/uint64(tickHz)))
+	if err := state.Save(p, b.s.Machine(), b.s.DOS()); err != nil {
+		return
+	}
+	b.ckpts = append(b.ckpts, p)
+	for len(b.ckpts) > 3 {
+		_ = os.Remove(b.ckpts[0])
+		b.ckpts = b.ckpts[1:]
+	}
+}
+
+// crash 存現場（狀態檔、截圖、停機原因、最近動作），之後結束這次測試。
+func (b *bot) crash(st *hrrt.Stop) {
+	b.crashInfo = fmt.Sprintf("%s：%s", stopName(st.Kind), st.Msg)
+	b.logEvent("crash", b.crashInfo)
+	b.dump("crash")
+}
+
+func (b *bot) dump(tag string) {
+	dir := filepath.Join(b.out, tag)
+	_ = os.MkdirAll(dir, 0o755)
+	if b.s != nil {
+		if err := b.s.CrashDump(dir, b.crashInfo); err != nil {
+			fmt.Fprintln(os.Stderr, "存現場失敗：", err)
+		}
+	}
+	_ = os.WriteFile(filepath.Join(dir, "bot-info.txt"), []byte(fmt.Sprintf("%s\n遊戲時間 %.2f 分，動作 %d，重開 %d，結束遊戲 %d\n最後動作 %v\n", b.crashInfo, float64(b.gameTicks)/tickHz/60, b.actionsN, b.restarts, b.quits, b.last)), 0o644)
+}
+
+func (b *bot) minuteReport(w *os.File, wall time.Duration) {
+	var steps uint64
+	if b.s != nil {
+		steps = b.s.Machine().Steps
+	}
+	fmt.Fprintf(w, "%.1f\t%d\t%d\t%04X\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%.0f\n", float64(b.gameTicks)/tickHz/60, steps, b.actionsN, b.minSP, len(b.sigsEver), b.restarts, b.quits, len(b.freezes),
+		b.opens["BSTAGE.MRG"], b.opens["BC32.MRG"], b.opens["FACE.MRG"], b.opens["GAMEFILE.000"]+b.opens["GAMEFILE.001"]+b.opens["GAMEFILE.002"]+b.opens["GAMEFILE.003"]+b.opens["GAMEFILE.004"], b.maxSame, wall.Seconds())
+}
+
+func (b *bot) summary(status string, wall time.Duration) {
+	opens := map[string]int{}
+	for k, v := range b.opens {
+		opens[k] = v
+	}
+	j, _ := json.MarshalIndent(map[string]any{
+		"status": status, "game_hours": float64(b.gameTicks) / tickHz / 3600, "actions": b.actionsN, "restarts": b.restarts, "quits": b.quits,
+		"unique_screens": len(b.sigsEver), "min_sp": fmt.Sprintf("%04X", b.minSP), "max_same_sig_streak": b.maxSame, "suspect_freezes": b.freezes,
+		"crash": b.crashInfo, "no_stack_patch": b.opt.noPatch, "seed": b.opt.seed, "interval": b.opt.interval, "wall_seconds": wall.Seconds(), "file_opens": opens,
+	}, "", "  ")
+	_ = os.WriteFile(filepath.Join(b.out, "summary.json"), j, 0o644)
+}
