 		}
 	}
 	return nil
@@ -501,3 +520,29 @@ func (s *Session) adapt(elapsed time.Duration, ticks uint64) {
 // SnapshotNow 立刻產生一個快照（批次邊界，不等滑鼠輪詢點）。只能在模擬迴圈沒有跑的時候呼叫
 // （RunSteps 回傳之後）；無頭驗收用，例如淡入淡出中遊戲不輪詢滑鼠的區段。
 func (s *Session) SnapshotNow() { s.snapshot() }
+
+// RunToPoll 執行到下一次滑鼠輪詢指令剛執行完（遊戲回到等輸入的迴圈）、或跑滿 max 道指令、或停機。
+// 回傳 (停機原因, 是否停在輪詢點)；沒有停機時第一個值是 nil。遊玩機器人用它取得「閒置畫面」的精確時刻
+// （與 hrexplore 的畫面身分同一個取樣點）。
+func (s *Session) RunToPoll(max uint64) (*Stop, bool) {
+	end := s.m.Steps + max
+	s.pollStop, s.pollHit = true, false
+	defer func() { s.pollStop, s.pollHit = false, false }()
+	for s.m.Steps < end {
+		s.drainInput()
+		n := batchSteps
+		if rest := end - s.m.Steps; rest < uint64(n) {
+			n = int(rest)
+		}
+		if st := s.stepBatch(n); st != nil {
+			s.afterBatch(true)
+			return st, false
+		}
+		s.afterBatch(false)
+		if s.pollHit {
+			return nil, true
+		}
+	}
+	s.afterBatch(true)
+	return nil, false
+}
