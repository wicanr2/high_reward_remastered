+// sendKey 把一個按鍵送進遊戲。MAIN.EXE 只用 int 21h 的 AH=08、0B、0700 讀鍵盤（docs/re/004），
+// dosgolem 的這幾個服務只讀 d.Stdin；PushKey 寫的是 BDA 緩衝，沒有人讀（審查發現，
+// 早期長跑的 12% 按鍵輸入因此全是空操作）。DOS 的讀鍵規則：一般鍵回 ASCII，
+// 擴充鍵（方向鍵等）先回 00 再回掃描碼。
+func sendKey(d *dos.DOS, path string, k dos.Key) {
+	if path == "bda" {
+		d.PushKey(k)
+		return
+	}
+	if k.ASCII != 0 {
+		d.Stdin = append(d.Stdin, k.ASCII)
+		return
+	}
+	d.Stdin = append(d.Stdin, 0x00, k.Scan)
