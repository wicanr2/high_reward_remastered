 	}
 	f := s.Frame()
-	if f == nil || f.W != 640 || f.H != 480 || len(f.RGB) != 640*480*3 {
+	if f == nil || f.W != 640 || f.H != 480 || len(f.Px) != 640*480 {
 		t.Fatalf("快照不正確：%+v", f)
 	}
 }
