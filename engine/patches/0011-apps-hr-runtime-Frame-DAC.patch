diff --git a/apps/hr/runtime/session.go b/apps/hr/runtime/session.go
index 0392e12..8031e38 100644
--- a/apps/hr/runtime/session.go
+++ b/apps/hr/runtime/session.go
@@ -82,15 +82,27 @@ func (s *Stop) Error() string { return s.Msg }
 // Normal 回報這是不是正常結束（玩家結束或進片尾）。
 func (s *Stop) Normal() bool { return s != nil && (s.Kind == StopQuit || s.Kind == StopEnding) }
 
-// Frame 是 Run 在滑鼠輪詢點產生的畫面快照，建立後不再修改。
+// Frame 是 Run 在滑鼠輪詢點產生的畫面快照，建立後不再修改（docs/spec/003 第 3 節、004 第 5.1 節）。
+// 只複製像素值與調色盤；轉成 RGB 由使用者在自己的執行緒做（RGBA），不佔模擬迴圈的時間。
 type Frame struct {
 	W, H  int
-	RGB   []uint8 // W*H*3
+	Px    []uint8       // W*H 個像素值，0 至 15（Machine.Planar）
+	Map   [16]uint8     // 像素值到 DAC 索引（EGA 屬性暫存器，VGA.DACIndex）
+	DAC   [256][3]uint8 // 8 位元 RGB
 	Steps uint64
 	Ticks uint64
 	Seq   uint64
 }
 
+// RGBA 把畫面轉成每像素 4 bytes 的 RGBA（alpha 255）寫進 dst（長度至少 W*H*4）。
+func (f *Frame) RGBA(dst []byte) {
+	for i, p := range f.Px {
+		c := f.DAC[f.Map[p&0x0F]]
+		j := i * 4
+		dst[j], dst[j+1], dst[j+2], dst[j+3] = c[0], c[1], c[2], 0xFF
+	}
+}
+
 // Stats 是 Run 定期更新的統計。
 type Stats struct {
 	Steps      uint64
@@ -139,6 +151,7 @@ type Session struct {
 	inbox  []Event
 	stats  Stats
 	frame  atomic.Pointer[Frame]
+	want   atomic.Bool
 	frmSeq uint64
 
 	// 以下欄位只由持有機器的迴圈（Run 或 RunSteps）使用。
@@ -334,7 +347,7 @@ func (s *Session) stepBatch(n int) *Stop {
 		//（批次邊界取樣時游標完整的比例只有 8% 至 9%，這裡是 158/159，docs/spec/004 第 5.1 節）。
 		if np := len(d.Mouse.Polls); np != s.lastPolls {
 			s.lastPolls = np
-			if time.Since(s.lastSnap) >= 8*time.Millisecond {
+			if s.want.Load() {
 				s.snapshot()
 			}
 			s.lastSnapPollAt = time.Now()
@@ -366,15 +379,24 @@ func (s *Session) afterBatch(force bool) {
 }
 
 func (s *Session) snapshot() {
-	w, h, rgb := s.m.PlanarRGB()
-	if rgb == nil {
+	w, h, px := s.m.Planar()
+	if px == nil {
 		return
 	}
+	f := &Frame{W: w, H: h, Px: px, DAC: s.m.Palette(), Steps: s.m.Steps, Ticks: s.m.Ticks}
+	for i := range f.Map {
+		f.Map[i] = s.m.VGA.DACIndex(uint8(i))
+	}
 	s.frmSeq++
+	f.Seq = s.frmSeq
 	s.lastSnap = time.Now()
-	s.frame.Store(&Frame{W: w, H: h, RGB: rgb, Steps: s.m.Steps, Ticks: s.m.Ticks, Seq: s.frmSeq})
+	s.want.Store(false)
+	s.frame.Store(f)
 }
 
+// RequestFrame 要求在下一次滑鼠輪詢指令剛執行完時產生新快照（拉取式：快照次數不超過前端的繪製率）。
+func (s *Session) RequestFrame() { s.want.Store(true) }
+
 // RunSteps 同步執行到絕對步數 total（不計時）。回傳的 Stop 在跑滿時 Kind ＝ StopSteps。
 func (s *Session) RunSteps(total uint64) *Stop {
 	for s.m.Steps < total {
