@@ -0,0 +1,117 @@
+package l10n
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+const l2GoldenPath = "data/builder-l2-golden.txt"
+
+func computeEnglishGolden(t *testing.T) []byte {
+	t.Helper()
+	var out strings.Builder
+	for _, v := range []struct {
+		name, text, status string
+		with               bool
+	}{{"zero", "", StatusKeep, false}, {"accepted", "ABCD", StatusAccepted, false}, {"candidate-excluded", "ABCD", StatusCandidate, false}, {"candidate-adopted", "ABCD", StatusCandidate, true}, {"reordered", "CDAB", StatusAccepted, false}} {
+		cfg := englishConfig(t, englishOriginalRow(t, v.text, v.status))
+		cfg.Policy.WithCandidates = v.with
+		res := mustBuild(t, cfg)
+		m := *res.Manifest
+		m.BuilderVersion, m.InputDigest = "", ""
+		raw, e := m.Marshal()
+		if e != nil {
+			t.Fatal(e)
+		}
+		fmt.Fprintf(&out, "[%s]\npatch=%s\nadopted=%d\nmanifest=%s\n", v.name, res.Manifest.PatchHash, res.Manifest.Adopted, sha256Hex(raw))
+		for _, name := range packNames {
+			fmt.Fprintf(&out, "%s=%s\n", name, sha256Hex(packFile(t, res.Dir, name)))
+		}
+	}
+	return []byte(out.String())
+}
+
+func TestEnglishGolden(t *testing.T) {
+	origDirOrSkip(t)
+	got := computeEnglishGolden(t)
+	if os.Getenv("HR_L10N_UPDATE_L2_GOLDEN") == "1" {
+		if e := os.WriteFile(l2GoldenPath, got, 0644); e != nil {
+			t.Fatal(e)
+		}
+		return
+	}
+	if d := goldenFirstDiff(got, builderL2Golden); d != "" {
+		t.Fatalf("L2 golden differs: %s; update then recompile", d)
+	}
+	if !bytes.Equal(computeEnglishGolden(t), got) {
+		t.Fatal("L2 golden is not reproducible")
+	}
+}
+
+func TestEnglishGoldenVersionStream(t *testing.T) {
+	l1, l2 := []byte("ab"), []byte("cd")
+	want := "hr-l10n-builder-version-v2\ncontract\t1\nx\nl1\t2\nab\nl2\t2\ncd\n"
+	if got := builderVersionOf("x", l1, l2); got != sha256Hex([]byte(want))[:8] {
+		t.Fatalf("version stream %s", got)
+	}
+	v := Version()
+	for _, got := range []string{builderVersionOf(builderContract+"x", builderGolden, builderL2Golden), builderVersionOf(builderContract, append(bytes.Clone(builderGolden), 'x'), builderL2Golden), builderVersionOf(builderContract, builderGolden, append(bytes.Clone(builderL2Golden), 'x'))} {
+		if got == v {
+			t.Fatal("version input omitted")
+		}
+	}
+	if builderVersionOf("x", []byte("a"), []byte("bcd")) == builderVersionOf("x", l1, l2) {
+		t.Fatal("ambiguous version boundaries")
+	}
+	if !regexp.MustCompile(`^[0-9a-f]{8}$`).MatchString(v) {
+		t.Fatal("version shape")
+	}
+}
+
+func TestEnglishGoldenFormat(t *testing.T) {
+	if len(builderL2Golden) == 0 || builderL2Golden[len(builderL2Golden)-1] != '\n' || bytes.ContainsRune(builderL2Golden, '\r') {
+		t.Fatal("L2 golden must be nonempty LF text")
+	}
+	ls := strings.Split(strings.TrimSuffix(string(builderL2Golden), "\n"), "\n")
+	hex64 := regexp.MustCompile(`^[0-9a-f]{64}$`)
+	i := 0
+	for _, v := range []struct {
+		name    string
+		adopted int
+	}{{"zero", 0}, {"accepted", 1}, {"candidate-excluded", 0}, {"candidate-adopted", 1}, {"reordered", 1}} {
+		if i+12 > len(ls) || ls[i] != "["+v.name+"]" {
+			t.Fatal("golden header or truncated variant")
+		}
+		i++
+		for _, key := range []string{"patch"} {
+			k, val, ok := strings.Cut(ls[i], "=")
+			if !ok || k != key || !hex64.MatchString(val) {
+				t.Fatal("golden patch identity")
+			}
+			i++
+		}
+		if ls[i] != fmt.Sprintf("adopted=%d", v.adopted) {
+			t.Fatal("golden adoption count")
+		}
+		i++
+		k, val, ok := strings.Cut(ls[i], "=")
+		if !ok || k != "manifest" || !hex64.MatchString(val) {
+			t.Fatal("golden manifest identity")
+		}
+		i++
+		for _, name := range packNames {
+			k, val, ok := strings.Cut(ls[i], "=")
+			if !ok || k != name || !hex64.MatchString(val) {
+				t.Fatal("golden output identity")
+			}
+			i++
+		}
+	}
+	if i != len(ls) {
+		t.Fatal("unexpected golden lines")
+	}
+}
