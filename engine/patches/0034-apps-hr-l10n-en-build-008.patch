--- /dev/null
+++ b/apps/hr/l10n/english.go
@@ -0,0 +1,77 @@
+package l10n
+
+import (
+	"encoding/binary"
+	"errors"
+	"unicode/utf8"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/budget"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/enpairs"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/glyphpatch"
+)
+
+func (t *Table) adoptEnglish(f *File, p Policy, patch *glyphpatch.Patch) (map[string][]byte, int, []string, error) {
+	if patch == nil || patch.Language() != codeEnglish {
+		return nil, 0, nil, errors.New("l10n: 英文採用需要已驗字模補丁")
+	}
+	return t.adopt(f, p, func(item Item, row Row) ([]byte, []byte, []string) {
+		if row.Text == "" {
+			return nil, nil, []string{"譯文為空（要保留原版請用 keep）"}
+		}
+		class := ""
+		if f.Kind == KindESP {
+			c, ok := ESPWindowClass(row.ID)
+			if !ok {
+				return nil, nil, []string{"esp-windows.tsv 沒有此項目，無法決定窗口類別"}
+			}
+			class = c
+		}
+		final, vs := enpairs.Prepare(enpairs.Input{ID: row.ID, File: f.Name, Class: class, Orig: item.Orig, Text: row.Text, Patch: patch})
+		if len(vs) != 0 {
+			return nil, nil, violationStrings(vs)
+		}
+		return englishComparisonKey(row.Text), final, nil
+	})
+}
+
+// englishComparisonKey is called only after Prepare has validated the source.
+// It does not require pre-wrap pairs to exist in the fixed patch. P/F/N token
+// boundaries exactly follow spec 008 section 3.2.1, independently of wrapping.
+func englishComparisonKey(text string) []byte {
+	key := make([]byte, 0)
+	var ordinary []rune
+	flush := func() {
+		for i := 0; i < len(ordinary); i += 2 {
+			right := rune(' ')
+			if i+1 < len(ordinary) {
+				right = ordinary[i+1]
+			}
+			key = append(key, 'P')
+			key = binary.BigEndian.AppendUint32(key, uint32(ordinary[i]))
+			key = binary.BigEndian.AppendUint32(key, uint32(right))
+		}
+		ordinary = ordinary[:0]
+	}
+	b := []byte(text)
+	for off := 0; off < len(b); {
+		switch b[off] {
+		case '%':
+			flush()
+			n, _, _ := budget.ConversionAt(b, off)
+			key = append(key, 'F')
+			key = binary.BigEndian.AppendUint32(key, uint32(n))
+			key = append(key, b[off:off+n]...)
+			off += n
+		case '\n':
+			flush()
+			key = append(key, 'N')
+			off++
+		default:
+			r, n := utf8.DecodeRune(b[off:])
+			ordinary = append(ordinary, r)
+			off += n
+		}
+	}
+	flush()
+	return key
+}
