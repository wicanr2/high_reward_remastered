new file mode 100644
index 0000000..1a85c4c
--- /dev/null
+++ b/apps/hr/l10n/english_patch_test.go
@@ -0,0 +1,131 @@
+package l10n
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/glyphpatch"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// Only synthetic text and bitmaps are used here. The OFL text is public;
+// reserved-codes.tsv is the independent trusted measurement fixture.
+func englishPatchDir(t *testing.T, language string, pairs ...[2]rune) string {
+	t.Helper()
+	read := func(name string) []byte {
+		b, e := os.ReadFile(filepath.Join("glyphpatch", "testdata", name))
+		if e != nil {
+			t.Fatal(e)
+		}
+		return b
+	}
+	files := map[string][]byte{"OFL.txt": read("OFL.txt"), "reserved-codes.tsv": read("reserved-codes.tsv")}
+	reserved := map[uint16]bool{}
+	for _, line := range strings.Split(string(files["reserved-codes.tsv"]), "\n")[1:] {
+		if line == "" {
+			continue
+		}
+		n, e := strconv.ParseUint(strings.Split(line, "\t")[0], 16, 16)
+		if e != nil {
+			t.Fatal(e)
+		}
+		reserved[uint16(n)] = true
+	}
+	set := map[[2]rune]bool{}
+	for _, p := range pairs {
+		set[p] = true
+	}
+	if len(set) == 0 {
+		set[[2]rune{'A', ' '}] = true
+	}
+	pairs = nil
+	for p := range set {
+		pairs = append(pairs, p)
+	}
+	sort.Slice(pairs, func(i, j int) bool {
+		return pairs[i][0] < pairs[j][0] || pairs[i][0] == pairs[j][0] && pairs[i][1] < pairs[j][1]
+	})
+	var codes []uint16
+	for lead := 0xe0; lead <= 0xf9; lead++ {
+		for trail := 0x40; trail <= 0xdf; trail++ {
+			if trail > 0x7e && trail < 0xa1 {
+				continue
+			}
+			c := uint16(lead<<8 | trail)
+			if !reserved[c] {
+				codes = append(codes, c)
+			}
+		}
+	}
+	var cmap strings.Builder
+	if language == "en" {
+		cmap.WriteString("left_cp\tright_cp\tcode_hex\n")
+	} else {
+		cmap.WriteString("unicode\tcode_hex\n")
+	}
+	for i, p := range pairs {
+		if language == "en" {
+			fmt.Fprintf(&cmap, "U+%04X\tU+%04X\t%04X\n", p[0], p[1], codes[i])
+		} else {
+			fmt.Fprintf(&cmap, "U+%04X\t%04X\n", p[0], codes[i])
+		}
+		var rec [32]byte
+		binary.BigEndian.PutUint16(rec[:2], codes[i])
+		var bits uint16
+		if p[0] != ' ' {
+			bits |= 0x8000
+		}
+		if language == "en" && p[1] != ' ' {
+			bits |= 0x0080
+		}
+		for r := 0; r < 15; r++ {
+			binary.BigEndian.PutUint16(rec[2+2*r:], bits)
+		}
+		files["glyphs-"+language+".bin"] = append(files["glyphs-"+language+".bin"], rec[:]...)
+	}
+	files["charmap-"+language+".tsv"] = []byte(cmap.String())
+	face := map[string]string{"en": "3\tTC", "ja": "0\tJP"}[language]
+	f := strings.Split(face, "\t")
+	source := map[string]string{
+		"format": "hr-l2-source-v1", "language": language, "units_sha256": strings.Repeat("a", 64), "unicode_version": "15.0.0",
+		"font_file": "NotoSansCJK-Regular.ttc", "font_sha256": "b76b0433203017ca80401b2ee0dd69350349871c4b19d504c34dbdd80541690a", "font_version": "Version 2.004;hotconv 1.0.118;makeotfexe 2.5.65603",
+		"face_index": f[0], "face_name": "Noto Sans CJK " + f[1], "pillow_version": "12.3.0", "fonttools_version": "4.66.1",
+		"pixel_size": "13", "cell": "15x15", "threshold": "128", "placement": "mask-center-floor", "unit_mode": "scalar15",
+		"container_image_id": "sha256:" + strings.Repeat("b", 64), "rasterizer_version": "synthetic-test-v1", "rasterizer_sha256": strings.Repeat("c", 64),
+	}
+	if language == "en" {
+		source["pixel_size"], source["placement"], source["unit_mode"] = "10", "pair2x7-baseline11", "pair2x7"
+		for k, v := range map[string]string{"source_canvas": "12x15", "source_anchor": "ls", "source_origin": "0,11", "source_clipping": "canvas-before-getbbox", "source_crop": "0,0,bbox-right,15", "shrink": "width-gt7:BILINEAR:7x15", "half_origin": "0,0;8,0", "blank_column": "7", "blank_scalar": "U+0020"} {
+			source[k] = v
+		}
+	}
+	for k, n := range map[string]string{"glyphs_sha256": "glyphs-" + language + ".bin", "charmap_sha256": "charmap-" + language + ".tsv", "reserved_sha256": "reserved-codes.tsv", "ofl_sha256": "OFL.txt"} {
+		source[k] = fmt.Sprintf("%x", sha256.Sum256(files[n]))
+	}
+	var keys []string
+	for k := range source {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var sb strings.Builder
+	for _, k := range keys {
+		fmt.Fprintf(&sb, "%s\t%s\n", k, source[k])
+	}
+	files["SOURCE.txt"] = []byte(sb.String())
+	dir := t.TempDir()
+	for n, b := range files {
+		if e := os.WriteFile(filepath.Join(dir, n), b, 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+	_, e := glyphpatch.Load(dir, language)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return dir
+}
