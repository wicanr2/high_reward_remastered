+
+func englishConfig(t *testing.T, rows ...Row) Config {
+	t.Helper()
+	return Config{OrigDir: origDirOrSkip(t), TableDir: englishTables(t, rows...), PackRoot: t.TempDir(), Code: "en", Mode: ModeTable,
+		PatchDir: englishPatchDir(t, "en", [2]rune{'A', 'B'}, [2]rune{'C', 'D'}, [2]rune{'E', 'F'})}
+}
+
+func englishTables(t *testing.T, rows ...Row) string {
+	t.Helper()
+	dir := t.TempDir()
+	by := map[string]*Table{}
+	for _, r := range rows {
+		name := dataFileOfID(r.ID)
+		if by[name] == nil {
+			by[name] = &Table{}
+		}
+		by[name].Rows = append(by[name].Rows, r)
+	}
+	for name, tbl := range by {
+		var b bytes.Buffer
+		if err := tbl.Save(&b); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, name+".tsv"), b.Bytes(), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+func englishOriginalRow(t *testing.T, text, status string) Row {
+	t.Helper()
+	orig := readOrig(t, "SP.MES")["SP.MES"]
+	f := mustParse(t, "SP.MES", orig)
+	item, ok := f.Lookup("SP.MES#56")
+	if !ok {
+		t.Fatal("missing source item")
+	}
+	r := Row{ID: item.ID, SrcSHA: SrcSHA(item.Orig), Text: text, Status: status, By: "synthetic", Batch: "l2-synthetic", Date: "2026-10-05"}
+	if status == StatusAccepted {
+		r.AccSHA = AccSHA(text)
+	}
+	return r
+}
+
