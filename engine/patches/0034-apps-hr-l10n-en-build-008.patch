new file mode 100644
index 0000000..bfad166
--- /dev/null
+++ b/apps/hr/cmd/hrl10n/english_build_test.go
@@ -0,0 +1,29 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestBuildEnglishPatchFlags(t *testing.T) {
+	for _, args := range [][]string{
+		{"-code", "en", "-mode", "table", "-orig", "missing", "-l10n", "missing"},
+		{"-code", "zh-TW", "-mode", "table", "-orig", "missing", "-l10n", "missing", "-glyph-patch", "p"},
+		{"-code", "zh-TW", "-mode", "identity", "-orig", "missing", "-glyph-patch", "p"},
+		{"-code", "en", "-mode", "identity", "-orig", "missing", "-glyph-patch", "p"},
+		{"-code", "ja", "-mode", "table", "-orig", "missing", "-l10n", "missing", "-glyph-patch", "p"},
+	} {
+		code, out, errOut := exec("", append([]string{"build"}, args...)...)
+		if code != 2 || out != "" || errOut == "" {
+			t.Fatalf("usage code=%d out=%q err=%s", code, out, errOut)
+		}
+	}
+	if code, _, e := exec("", "build", "-h"); code != 0 || !strings.Contains(e, "glyph-patch") {
+		t.Fatal("patch flag missing from help")
+	}
+	root := tableRoot(t, "en", nil)
+	code, out, e := exec("", "build", "-code", "en", "-mode", "table", "-orig", "missing", "-l10n", root, "-glyph-patch", "missing", "-out", t.TempDir())
+	if code != 1 || out != "" || !strings.Contains(e, "字模補丁") {
+		t.Fatalf("explicit missing patch is build failure: %d %q %s", code, out, e)
+	}
+}
