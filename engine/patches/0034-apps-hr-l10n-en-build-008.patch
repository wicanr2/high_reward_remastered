+
+func TestEnglishPrewrapGroupsAndPolicy(t *testing.T) {
+	w := newSynthWorld(t)
+	patch, err := glyphpatch.Load(englishPatchDir(t, "en", [2]rune{'A', 'A'}, [2]rune{'A', ' '}, [2]rune{'A', 'B'}, [2]rune{'C', 'D'}), "en")
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := w.parsed["UWASA.MES"]
+	// The pre-wrap space+A pair is intentionally absent. It disappears when
+	// the sole word boundary becomes a newline; only final pairs are required.
+	text := strings.Repeat("A", 14) + " " + strings.Repeat("A", 17)
+	rows := []Row{w.row("UWASA.MES#0", text, StatusAccepted), w.row("UWASA.MES#1", text, StatusAccepted)}
+	r, n, vs, e := (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch)
+	if e != nil || len(vs) != 0 || n != 2 || !bytes.Equal(r[rows[0].ID], r[rows[1].ID]) {
+		t.Fatalf("equal group n=%d vs=%v e=%v", n, vs, e)
+	}
+	// Explicit and inserted newlines produce identical final bytes, but the
+	// pre-wrap source keys differ and must not hide a group inconsistency.
+	rows[1].Text = strings.Repeat("A", 14) + "\n" + strings.Repeat("A", 17)
+	rows[1].AccSHA = AccSHA(rows[1].Text)
+	r, n, vs, e = (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch)
+	if e != nil || r != nil || n != 0 || len(vs) != 1 || !strings.Contains(vs[0], "同群組") {
+		t.Fatalf("prewrap group %v %v", vs, e)
+	}
+	for _, note := range []string{"group-exception", "context; group-exception", "context； group-exception"} {
+		rows[1].Note = note
+		if _, n, vs, e := (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch); e != nil || len(vs) != 0 || n != 2 {
+			t.Fatalf("exact exception %v %v", vs, e)
+		}
+	}
+	for _, note := range []string{"prefix group-exception", "group-exceptions", "xgroup-exception"} {
+		rows[1].Note = note
+		if _, _, vs, _ := (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch); len(vs) == 0 {
+			t.Fatal("inexact exception accepted")
+		}
+	}
+	rows[1].Status = StatusKeep
+	if _, n, vs, e := (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch); e != nil || len(vs) != 0 || n != 1 {
+		t.Fatalf("partial adoption %v %v", vs, e)
+	}
+	rows = []Row{w.row("UWASA.MES#0", "ABCD", StatusAccepted)}
+	rows[0].AccSHA = AccSHA("stale")
+	if _, n, vs, _ := (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch); n != 0 || len(vs) != 0 {
+		t.Fatal("stale accepted adopted")
+	}
+	if _, n, vs, _ := (&Table{Rows: rows}).adoptEnglish(f, Policy{WithCandidates: true}, patch); n != 1 || len(vs) != 0 {
+		t.Fatal("stale candidate not adopted")
+	}
+	rows[0].SrcSHA = SrcSHA([]byte("bad source"))
+	if _, _, vs, _ := (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch); len(vs) == 0 {
+		t.Fatal("source identity ignored")
+	}
+	rows = []Row{w.row("SHOPTAB#0.0", "ABCD", StatusAccepted)}
+	if _, _, vs, _ := (&Table{Rows: rows}).adoptEnglish(w.parsed["SHOPTAB.TBL"], Policy{AllowShoptab: true}, patch); len(vs) == 0 || !strings.Contains(vs[0], "unknown-window") {
+		t.Fatalf("shop window %v", vs)
+	}
+	rows = []Row{w.row("COUNTRY.MES#0", "ABCD", StatusCandidate)}
+	if _, _, vs, _ := (&Table{Rows: rows}).adoptEnglish(w.parsed["COUNTRY.MES"], Policy{}, patch); len(vs) == 0 || !strings.Contains(vs[0], "-allow-country-offsets") {
+		t.Fatal("non-keep country flag lost")
+	}
+	if _, n, vs, _ := (&Table{Rows: rows}).adoptEnglish(w.parsed["COUNTRY.MES"], Policy{AllowCountryOffsets: true}, patch); n != 0 || len(vs) != 0 {
+		t.Fatal("excluded candidate should keep original")
+	}
+	rows = []Row{w.row("UWASA.MES#0", "\u0301", StatusCandidate)}
+	if _, n, vs, _ := (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch); n != 0 || len(vs) != 0 {
+		t.Fatal("excluded candidate reached source preparation")
+	}
+}
+
+func TestEnglishGroupSameSourceDifferentWindows(t *testing.T) {
+	w := newSynthWorld(t)
+	orig := string(w.enc("山水火天地人"))
+	f := mustParse(t, "ESPMES.MRG", buildESP(125, map[int][]string{44: {string(w.enc("一二")), orig}, 121: {orig}}))
+	patch, e := glyphpatch.Load(englishPatchDir(t, "en", [2]rune{'A', 'A'}, [2]rune{'A', ' '}, [2]rune{' ', 'A'}), "en")
+	if e != nil {
+		t.Fatal(e)
+	}
+	text := strings.Repeat("A", 14) + " " + strings.Repeat("A", 17)
+	var rows []Row
+	for _, id := range []string{"ESPMES#44.1", "ESPMES#121.0"} {
+		item, ok := f.Lookup(id)
+		if !ok {
+			t.Fatal("synthetic item")
+		}
+		rows = append(rows, Row{ID: id, SrcSHA: SrcSHA(item.Orig), Text: text, Status: StatusAccepted, AccSHA: AccSHA(text)})
+	}
+	r, n, vs, e := (&Table{Rows: rows}).adoptEnglish(f, Policy{}, patch)
+	if e != nil || len(vs) != 0 || n != 2 {
+		t.Fatalf("window group %v %v", vs, e)
+	}
+	if bytes.ContainsRune(r[rows[0].ID], '\n') || !bytes.ContainsRune(r[rows[1].ID], '\n') || bytes.Equal(r[rows[0].ID], r[rows[1].ID]) {
+		t.Fatal("distinct window folds were not preserved")
+	}
+}
+
+func TestEnglishComparisonTokens(t *testing.T) {
+	pair := func(a, b rune) []byte {
+		v := []byte{'P'}
+		v = binary.BigEndian.AppendUint32(v, uint32(a))
+		return binary.BigEndian.AppendUint32(v, uint32(b))
+	}
+	want := append(pair('A', ' '), 'F')
+	want = binary.BigEndian.AppendUint32(want, 2)
+	want = append(want, []byte("%s")...)
+	want = append(want, 'N')
+	want = append(want, pair('B', ' ')...)
+	if !bytes.Equal(englishComparisonKey("A%s\nB"), want) {
+		t.Fatal("P/F/N canonical stream")
+	}
+	if !bytes.Equal(englishComparisonKey("A"), englishComparisonKey("A ")) {
+		t.Fatal("odd-segment pad equivalence")
+	}
+	if bytes.Equal(englishComparisonKey("AB CD"), englishComparisonKey("AB\nCD")) {
+		t.Fatal("explicit boundary lost")
+	}
+}
+
+func TestEnglishBuildIdentityFullPatchAndReuse(t *testing.T) {
+	cfg := englishConfig(t)
+	want, err := readOrigInputs(cfg.OrigDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := mustBuild(t, cfg)
+	if r.Manifest.Adopted != 0 || r.Manifest.PatchHash == "" {
+		t.Fatal("zero adoption metadata")
+	}
+	for _, name := range packNames {
+		if !bytes.Equal(packFile(t, r.Dir, name), want[name]) {
+			t.Fatalf("zero adoption changed %s", name)
+		}
+	}
+	d, e := ExpectedDigest(cfg)
+	if e != nil || d != r.Digest {
+		t.Fatalf("digest %v", e)
+	}
+	if next := mustBuild(t, cfg); !next.Reused || next.Dir != r.Dir {
+		t.Fatal("same-input reuse")
+	}
+	row := englishOriginalRow(t, "ABCD", StatusAccepted)
+	cfg.TableDir = englishTables(t, row)
+	r = mustBuild(t, cfg)
+	if r.Reused || r.Manifest.Adopted != 1 || r.Digest == d {
+		t.Fatal("positive adoption metadata")
+	}
+	patch, e := glyphpatch.Load(cfg.PatchDir, "en")
+	if e != nil {
+		t.Fatal(e)
+	}
+	a, _ := patch.Lookup([]rune{'A', 'B'})
+	b, _ := patch.Lookup([]rune{'C', 'D'})
+	f := mustParse(t, "SP.MES", packFile(t, r.Dir, "SP.MES"))
+	it, _ := f.Lookup(row.ID)
+	if !bytes.Equal(it.Orig, []byte{byte(a >> 8), byte(a), byte(b >> 8), byte(b)}) {
+		t.Fatal("typed final bytes not written")
+	}
+	// Independent index formula and all-grid comparison, including the EF
+	// bitmap which no adopted row uses: positive adoption applies full patch.
+	records, e := os.ReadFile(filepath.Join(cfg.PatchDir, "glyphs-en.bin"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	changed := map[int][]byte{}
+	for pos := 0; pos < len(records); pos += 32 {
+		code := binary.BigEndian.Uint16(records[pos:])
+		lead, trail := int(code>>8), int(code&255)
+		tail := trail - 0x40
+		if trail > 0x7e {
+			tail = trail - 0x62
+		}
+		index := (lead-0xa4)*157 + tail + 0x16d
+		changed[index] = records[pos+2 : pos+32]
+	}
+	cf := packFile(t, r.Dir, "CFONT.15")
+	for index := 0; index < 13867; index++ {
+		target := want["CFONT.15"][index*30 : (index+1)*30]
+		if glyph, ok := changed[index]; ok {
+			target = glyph
+		}
+		if !bytes.Equal(cf[index*30:(index+1)*30], target) {
+			t.Fatalf("CFONT grid %d", index)
+		}
+	}
+	if _, e := verify.Verify(r.Dir, verify.Options{OrigHashes: r.Manifest.OrigInputs, ExpectDigest: r.Digest}); e != nil {
+		t.Fatal(e)
+	}
+}
+
+func TestEnglishBuildSnapshotDigestAndFailureAtomicity(t *testing.T) {
+	row := englishOriginalRow(t, "ABCD", StatusAccepted)
+	cfg := englishConfig(t, row)
+	wantDigest, e := ExpectedDigest(cfg)
+	if e != nil {
+		t.Fatal(e)
+	}
+	sourcePath := filepath.Join(cfg.PatchDir, "SOURCE.txt")
+	source, e := os.ReadFile(sourcePath)
+	if e != nil {
+		t.Fatal(e)
+	}
+	reads := 0
+	cfg.hooks = &buildHooks{afterPatchRead: func() {
+		reads++
+		if e := os.WriteFile(sourcePath, []byte("broken after snapshot"), 0600); e != nil {
+			t.Fatal(e)
+		}
+	}}
+	r := mustBuild(t, cfg)
+	if reads != 1 || r.Digest != wantDigest || r.Manifest.Adopted != 1 {
+		t.Fatal("snapshot not reused for digest/render/manifest")
+	}
+	if _, e := ExpectedDigest(cfg); e == nil {
+		t.Fatal("next call ignored changed disk patch")
+	}
+	if e := os.WriteFile(sourcePath, source, 0600); e != nil {
+		t.Fatal(e)
+	}
+	cfg.hooks = nil
+	if !mustBuild(t, cfg).Reused {
+		t.Fatal("restored snapshot not reused")
+	}
+	oldManifest := r.ManifestSHA256
+	bad := row
+	bad.Text = "MISSING"
+	bad.AccSHA = AccSHA(bad.Text)
+	cfg.TableDir = englishTables(t, bad)
+	_, e = Build(cfg)
+	var ve *ViolationsError
+	if !errors.As(e, &ve) || !strings.Contains(e.Error(), "missing-pair") {
+		t.Fatalf("missing pairs %v", e)
+	}
+	if len(tmpEntries(t, cfg.PackRoot)) != 0 || len(finalPacks(t, cfg.PackRoot)) != 1 {
+		t.Fatal("failed build left temporary or new pack")
+	}
+	if sum, e := verify.ManifestSHA256(r.Dir); e != nil || sum != oldManifest {
+		t.Fatal("old pack modified")
+	}
+	bad.AccSHA = AccSHA("stale")
+	cfg.TableDir = englishTables(t, bad)
+	zero := mustBuild(t, cfg)
+	if zero.Manifest.Adopted != 0 {
+		t.Fatal("accepted downgrade not zero")
+	}
+	// Alter table, policy, patch metadata and builder version independently.
+	cfg.TableDir = englishTables(t, row)
+	baseline, e := ExpectedDigest(cfg)
+	if e != nil {
+		t.Fatal(e)
+	}
+	reordered := row
+	reordered.Text = "CDAB"
+	reordered.AccSHA = AccSHA(reordered.Text)
+	cfg.TableDir = englishTables(t, reordered)
+	if d, _ := ExpectedDigest(cfg); d == baseline {
+		t.Fatal("table absent from digest")
+	}
+	cfg.TableDir = englishTables(t, row)
+	cfg.Policy.WithCandidates = true
+	if d, _ := ExpectedDigest(cfg); d == baseline {
+		t.Fatal("policy absent from digest")
+	}
+	cfg.Policy = Policy{}
+	cfg.hooks = &buildHooks{version: "changed-version"}
+	if d, _ := ExpectedDigest(cfg); d == baseline {
+		t.Fatal("version absent from digest")
+	}
+	cfg.hooks = nil
+	source = bytes.Replace(source, []byte("synthetic-test-v1"), []byte("synthetic-test-v2"), 1)
+	if e := os.WriteFile(sourcePath, source, 0600); e != nil {
+		t.Fatal(e)
+	}
+	changed, e := ExpectedDigest(cfg)
+	if e != nil || changed == baseline {
+		t.Fatalf("patch metadata digest %v", e)
+	}
+	if next := mustBuild(t, cfg); next.Reused || next.Digest != changed {
+		t.Fatal("changed patch reused old pack")
+	}
+}
+
+// The local accepted pilot is optional input, never embedded or copied into
+// the repository. It is independent of the synthetic version golden.
+func TestEnglishLocalAcceptedPilot(t *testing.T) {
+	if os.Getenv("HR_EN_TABLE") == "" || os.Getenv("HR_EN_PATCH") == "" {
+		t.Skip("local English pilot not supplied")
+	}
+	cfg := Config{OrigDir: origDirOrSkip(t), TableDir: os.Getenv("HR_EN_TABLE"), PatchDir: os.Getenv("HR_EN_PATCH"), PackRoot: t.TempDir(), Code: "en", Mode: ModeTable}
+	inputs, e := readOrigInputs(cfg.OrigDir)
+	if e != nil {
+		t.Fatal(e)
+	}
+	tables, e := readTableFiles(cfg.TableDir)
+	if e != nil {
+		t.Fatal(e)
+	}
+	patch, e := glyphpatch.Load(cfg.PatchDir, "en")
+	if e != nil {
+		t.Fatal(e)
+	}
+	digest, e := ExpectedDigest(cfg)
+	if e != nil {
+		t.Fatal(e)
+	}
+	r := mustBuild(t, cfg)
+	if r.Manifest.Adopted != 17 || r.Digest != digest || r.Manifest.PatchHash != patch.Digest() {
+		t.Fatal("pilot count or snapshot identity")
+	}
+	if _, e := verify.Verify(r.Dir, verify.Options{OrigHashes: r.Manifest.OrigInputs, ExpectDigest: digest}); e != nil {
+		t.Fatal(e)
+	}
+	count := 0
+	for _, name := range dataFileNames {
+		original := mustParse(t, name, inputs[name])
+		result := mustParse(t, name, packFile(t, r.Dir, name))
+		var rows []Row
+		if tb, ok := tables[name]; ok {
+			tbl, e := LoadTable(bytes.NewReader(tb))
+			if e != nil {
+				t.Fatal(e)
+			}
+			rows = tbl.Rows
+		}
+		expected := map[string][]byte{}
+		for _, row := range rows {
+			if row.Status != StatusAccepted || row.AccSHA != AccSHA(row.Text) {
+				t.Fatal("pilot row is not accepted")
+			}
+			it, ok := original.Lookup(row.ID)
+			if !ok {
+				t.Fatal("pilot row absent")
+			}
+			class := ""
+			if original.Kind == KindESP {
+				class, _ = ESPWindowClass(row.ID)
+			}
+			b, vs := enpairs.Prepare(enpairs.Input{ID: row.ID, File: name, Class: class, Orig: it.Orig, Text: row.Text, Patch: patch})
+			if len(vs) != 0 {
+				t.Fatalf("pilot %s: %+v", row.ID, vs)
+			}
+			expected[row.ID] = b
+			count++
+		}
+		if len(original.Items) != len(result.Items) {
+			t.Fatal("pilot altered item count")
+		}
+		for _, it := range original.Items {
+			want := it.Orig
+			if b, ok := expected[it.ID]; ok {
+				want = b
+			}
+			got, ok := result.Lookup(it.ID)
+			if !ok || !bytes.Equal(got.Orig, want) {
+				t.Fatalf("pilot typed readback %s", it.ID)
+			}
+		}
+	}
+	if count != 17 {
+		t.Fatal("pilot table count")
+	}
+	records, e := os.ReadFile(filepath.Join(cfg.PatchDir, "glyphs-en.bin"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	changed := map[int][]byte{}
+	for pos := 0; pos < len(records); pos += 32 {
+		code := binary.BigEndian.Uint16(records[pos:])
+		lead, trail := int(code>>8), int(code&255)
+		tail := trail - 0x40
+		if trail > 0x7e {
+			tail = trail - 0x62
+		}
+		index := (lead-0xa4)*157 + tail + 0x16d
+		changed[index] = records[pos+2 : pos+32]
+	}
+	cf := packFile(t, r.Dir, "CFONT.15")
+	for index := 0; index < 13867; index++ {
+		want := inputs[cfontName][index*30 : (index+1)*30]
+		if glyph, ok := changed[index]; ok {
+			want = glyph
+		}
+		if !bytes.Equal(cf[index*30:(index+1)*30], want) {
+			t.Fatalf("pilot CFONT grid %d", index)
+		}
+	}
+	if !mustBuild(t, cfg).Reused {
+		t.Fatal("pilot same-input reuse")
+	}
+	t.Logf("adopted=%d patch=%s digest=%s manifest=%s CFONT=%s", count, patch.Digest(), r.Digest, r.ManifestSHA256, sha256Hex(cf))
+}
