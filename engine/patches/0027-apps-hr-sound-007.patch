+package main
+
+import "testing"
+
+func bp(v bool) *bool { return &v }
+
+// 優先序：旗標、環境變數、偏好設定、預設。-mute=false 能壓過環境變數與偏好設定；HR_MUTE=0 能壓過偏好設定的 sound:false。
+func TestResolveMute(t *testing.T) {
+	cases := []struct {
+		name      string
+		given     bool
+		flagVal   bool
+		env       string
+		pref      *bool
+		wantMuted bool
+	}{
+		{"全部沒給", false, false, "", nil, false},
+		{"偏好 sound:false", false, false, "", bp(false), true},
+		{"偏好 sound:true", false, false, "", bp(true), false},
+		{"環境 1", false, false, "1", nil, true},
+		{"環境 true（大小寫與空白）", false, false, " TRUE ", nil, true},
+		{"環境 0 壓過偏好 sound:false", false, false, "0", bp(false), false},
+		{"環境 false 壓過偏好 sound:false", false, false, "false", bp(false), false},
+		{"環境 1 壓過偏好 sound:true", false, false, "1", bp(true), true},
+		{"環境是亂值，回到偏好", false, false, "yes", bp(false), true},
+		{"旗標 -mute", true, true, "", bp(true), true},
+		{"旗標 -mute=false 壓過環境 1", true, false, "1", nil, false},
+		{"旗標 -mute=false 壓過偏好 sound:false", true, false, "", bp(false), false},
+		{"旗標 -mute 壓過環境 0", true, true, "0", nil, true},
+	}
+	for _, c := range cases {
+		if got := resolveMute(c.given, c.flagVal, c.env, c.pref); got != c.wantMuted {
+			t.Errorf("%s：resolveMute ＝ %v，應為 %v", c.name, got, c.wantMuted)
+		}
+	}
+}
