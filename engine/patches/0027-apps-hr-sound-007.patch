+func runSteps(t *testing.T, opt Options, n uint64) *Session {
+	t.Helper()
+	opt.Interval = NativeInterval
+	s, err := Open(origRoot(t), opt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.nextTrim = ^uint64(0) // 不清診斷紀錄：下面用 DOS 層的開檔記錄當獨立 oracle
+	if st := s.RunSteps(n); st.Kind != StopSteps {
+		t.Fatal(st.Msg)
+	}
+	return s
+}
+
+// 播放中不重載。三種 Sink：
+//   - 恆假（等同原版旗標 0 的行為，docs/re/010 第 4.2 節）：30M 步內反覆重載 MID（反對照，證明偵測有作用）；
+//   - 跟隨（像真的引擎）：只有開機的一次 MusicStart；
+//   - 恆真（卡住的驅動，docs/re/010 H3）：PlayMusic 在淡出後的等待迴圈出不來，連一次 MusicStart 都沒有（正對照）。
+func TestSoundPlayingSuppressesReload(t *testing.T) {
+	if testing.Short() {
+		t.Skip("-short")
+	}
+	neverS := runSteps(t, Options{Sound: &fakeSink{}}, 30_000_000)
+	never := neverS.Sound().Starts
+	followSink := &fakeSink{follow: true}
+	follow := runSteps(t, Options{Sound: followSink}, 30_000_000)
+	// 獨立 oracle：DOS 檔案層實際開過 SCOUT.MID 的次數，必須等於掛鉤看到的 MusicStart 次數
+	// （開檔由 192B:059B 的 fread 前置完成，與掛鉤的觀察點不同；docs/re/010 第 5 節 E0b 另有 1706 次的獨立收據）。
+	opens := func(s *Session) (n uint64) {
+		for _, name := range s.DOS().Opened {
+			if strings.EqualFold(filepath.Base(strings.ReplaceAll(name, `\`, "/")), "SCOUT.MID") {
+				n++
+			}
+		}
+		return
+	}
+	if got := opens(neverS); got != never {
+		t.Fatalf("DOS 層開過 SCOUT.MID %d 次，掛鉤看到 MusicStart %d 次，兩者應相等", got, never)
+	}
+	if got := opens(follow); got != 1 {
+		t.Fatalf("跟隨型 Sink：DOS 層開過 SCOUT.MID %d 次，應為 1", got)
+	}
+	stuckSink := &fakeSink{fixed: true}
+	stuck := runSteps(t, Options{Sound: stuckSink}, 30_000_000)
+	t.Logf("30M 步 MusicStart：恆假 %d 次，跟隨 %d 次，恆真 %d 次；恆真時 CS:IP ＝ %04X:%04X", never, follow.Sound().Starts, stuck.Sound().Starts,
+		stuck.Machine().CPU.Seg[cpu.CS], stuck.Machine().CPU.IP)
+	if never < 50 {
+		t.Fatalf("恆假（反對照）應反覆重載，只有 %d 次：偵測器沒有作用", never)
+	}
+	if got := follow.Sound().Starts; got != 1 {
+		t.Fatalf("跟隨型 Sink 應只有開機的一次，得到 %d", got)
+	}
+	if got := stuck.Sound().Starts; got != 0 {
+		t.Fatalf("恆真（卡住的驅動）時遊戲應卡在 PlayMusic 的等待迴圈，卻看到 %d 次 MusicStart", got)
+	}
+	if cs := stuck.Machine().CPU.Seg[cpu.CS]; cs != musicSeg && cs != soundSeg {
+		t.Fatalf("恆真時 CS ＝ %04X，應停在 PlayMusic（%04X）或聲音常式（%04X）", cs, musicSeg, soundSeg)
+	}
+	if len(followSink.fades) == 0 {
+		t.Fatal("開機的 PlayMusic 應先呼叫淡出")
+	}
+}
+
+// 曲子自然結束後遊戲自己重播同一首：跟隨型 Sink 在開機後讓 Playing 變假，
+// 遊戲要在有限步數內再次 MusicStart，資料仍是 SCOUT.MID。
+func TestSoundNaturalEndReplays(t *testing.T) {
+	if testing.Short() {
+		t.Skip("-short")
+	}
