+// 起音延遲：音符事件之後，輸出在 30 毫秒內就要有訊號（壞合成器若延遲發聲，例如多 100 毫秒，擋得下）。
+// 22 個原曲音色各測一次；慢起音的墊音以「超過最終峰值的 1%」判斷。
+func TestOnsetLatency(t *testing.T) {
+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	for _, prog := range []uint8{0, 13, 16, 34, 35, 48, 50, 51, 53, 55, 56, 58, 73, 83, 84, 86, 89, 91, 93, 94, 96, 112} {
+		t1 := (&tb{}).ev(0, 0xc0, prog).ev(48, 0x90, 60, 100).ev(48, 0x80, 60, 0).end(0) // tick 48 ＝ 0.5 秒起音
+		s, _ := ParseSMF(smf(1, 48, t0, t1))
+		f, _ := RenderSongRaw(s, nil)
+		on := secsF(0.5)
+		var peak float64
+		for _, v := range f[on:] {
+			if a := math.Abs(float64(v)); a > peak {
+				peak = a
+			}
+		}
+		if peak < 0.005 {
+			t.Errorf("音色 %d：沒有輸出", prog)
+			continue
+		}
+		first := -1
+		for i := on; i < len(f); i++ {
+			if math.Abs(float64(f[i])) > 0.01*peak {
+				first = i - on
+				break
+			}
+		}
+		if first < 0 || first > secsF(0.030) {
+			t.Errorf("音色 %d：起音後 %d 取樣（%.1f 毫秒）才有訊號，應在 30 毫秒內", prog, first, float64(first)*1000/SampleRate)
+		}
+		for i := 0; i < on; i++ {
+			if f[i] != 0 {
+				t.Fatalf("音色 %d：起音之前（取樣 %d）就有輸出", prog, i)
+			}
+		}
+	}
+}
