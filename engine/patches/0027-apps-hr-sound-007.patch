+// 其他音色號依 General MIDI 的家族（每 8 號一族）取預設。
+var familyPatches = [16]*patch{
+	&pPiano, &pXylo, &pOrgan, &pPluck, &pEBass, &pStrings, &pStrings, &pBrass,
+	&pReed, &pFlute, &pLead4, &pPadWarm, &pRain, &pPluck, &pBell, &pRain,
+}
+
+func patchFor(program uint8) *patch {
+	if p, ok := explicitPatches[program&0x7f]; ok {
+		return p
+	}
+	return familyPatches[(program&0x7f)>>3]
+}
diff --git a/apps/hr/sound/smf.go b/apps/hr/sound/smf.go
new file mode 100644
index 0000000..b983779
--- /dev/null
+++ b/apps/hr/sound/smf.go
@@ -0,0 +1,273 @@
+// Package sound 是高報酬戰將前端的音樂與音效引擎（docs/spec/007）。
+// 只依賴標準庫：標準 MIDI 檔解析、雙運算元 FM 合成、混音。不含任何原版位元組，
+// 原版的 MID 與 PCM 只在執行期由呼叫端交進來。
+package sound
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"sort"
+)
+
+// Kind 是引擎關心的事件種類，其餘 MIDI 事件在解析時略過（docs/re/018 第 1 節：原曲只有這些）。
+type Kind uint8
+
+const (
+	NoteOff Kind = iota + 1
+	NoteOn
+	Program
+	Volume // 控制器 7
+	Tempo
+	End // 軌結束
+)
+
+// Event 是已排序事件。A、B 的意義：NoteOn/NoteOff 為音高與力度；Program 的 A 為音色號；Volume 的 A 為值。
+type Event struct {
+	Tick  uint32
+	Kind  Kind
+	Ch    uint8
+	A, B  uint8
+	Tempo uint32 // Tempo：微秒每四分音符
+}
+
+// Song 是解析後的曲子。
+type Song struct {
+	Division uint16
+	Tracks   int
+	Events   []Event // 依 (Tick, 優先序) 穩定排序
+	EndTick  uint32  // 所有軌結束 tick 的最大值（沒有 End 事件時取最後一個事件）
+	Size     int     // 解析用掉的位元組數：MThd 加各 MTrk 區塊（含未知區塊）；其後的殘餘位元組不算
+}
+
+// 解析上限。原版緩衝最多 0x4E20 bytes，所以事件數不可能超過這個量級。
+const (
+	maxTracks = 64
+	maxEvents = 1 << 17
+)
+
+var (
+	ErrShort     = errors.New("sound: 資料太短，不是 MIDI 檔")
+	ErrNotSMF    = errors.New("sound: 沒有 MThd 簽章")
+	ErrFormat    = errors.New("sound: 不支援的 MIDI 格式（只支援格式 0 與 1，division 為每四分音符 ticks）")
+	ErrTruncated = errors.New("sound: MTrk 區塊或事件被截斷")
+	ErrNoTracks  = errors.New("sound: 沒有可解析的軌")
+	ErrTooMany   = errors.New("sound: 軌數或事件數超過上限")
+)
+
+func readVLQ(b []byte, p *int) (uint32, bool) {
+	var v uint32
+	for i := 0; i < 4; i++ {
+		if *p >= len(b) {
+			return 0, false
+		}
+		c := b[*p]
+		*p++
+		v = v<<7 | uint32(c&0x7f)
+		if c&0x80 == 0 {
+			return v, true
+		}
+	}
+	return 0, false
+}
+
+// ParseSMF 解析標準 MIDI 檔。b 可以在 MIDI 資料之後帶有任意多餘位元組（遊戲的 MID 緩衝在短檔之後會殘留前一首的尾巴），
+// 只讀 MThd 宣告的軌數。資料被截斷、軌數為 0、SMPTE division、格式 2 一律拒絕，不做部分接受。
+func ParseSMF(b []byte) (*Song, error) {
+	if len(b) < 14 {
+		return nil, ErrShort
+	}
+	if string(b[:4]) != "MThd" {
+		return nil, ErrNotSMF
+	}
+	hl := binary.BigEndian.Uint32(b[4:])
+	if hl < 6 || uint64(hl) > uint64(len(b)-8) {
+		return nil, ErrTruncated
+	}
+	format := binary.BigEndian.Uint16(b[8:])
+	ntrk := int(binary.BigEndian.Uint16(b[10:]))
+	div := binary.BigEndian.Uint16(b[12:])
+	if format > 1 || div == 0 || div&0x8000 != 0 {
+		return nil, ErrFormat
+	}
+	if ntrk == 0 {
+		return nil, ErrNoTracks
+	}
+	if ntrk > maxTracks {
+		return nil, ErrTooMany
+	}
+	s := &Song{Division: div}
+	p := 8 + int(hl)
+	type tagged struct {
+		Event
+		track int
+		prio  int
+	}
+	var all []tagged
+	for t := 0; t < ntrk; {
+		if p+8 > len(b) {
+			return nil, ErrTruncated
+		}
+		id := string(b[p : p+4])
+		ln := binary.BigEndian.Uint32(b[p+4:])
+		p += 8
+		if uint64(ln) > uint64(len(b)-p) {
+			return nil, ErrTruncated
+		}
+		body := b[p : p+int(ln)]
+		p += int(ln)
+		if id != "MTrk" {
+			continue // 未知區塊略過，不算軌
+		}
+		var tick uint32
+		var run byte
+		q := 0
+		sawEnd := false
+		for q < len(body) && !sawEnd {
+			dt, ok := readVLQ(body, &q)
+			if !ok || q >= len(body) {
+				return nil, ErrTruncated
+			}
+			tick += dt
+			st := body[q]
+			if st < 0x80 {
+				if run == 0 {
+					return nil, ErrTruncated
+				}
+				st = run
+			} else {
+				q++
+				if st < 0xf0 {
+					run = st
+				}
+			}
+			switch {
+			case st == 0xff:
+				if q >= len(body) {
+					return nil, ErrTruncated
+				}
+				mt := body[q]
+				q++
+				l, ok := readVLQ(body, &q)
+				if !ok || uint64(q)+uint64(l) > uint64(len(body)) {
+					return nil, ErrTruncated
+				}
+				d := body[q : q+int(l)]
+				q += int(l)
+				switch mt {
+				case 0x51:
+					if len(d) == 3 {
+						tp := uint32(d[0])<<16 | uint32(d[1])<<8 | uint32(d[2])
+						if tp != 0 {
+							all = append(all, tagged{Event{Tick: tick, Kind: Tempo, Tempo: tp}, t, 1})
+						}
+					}
+				case 0x2f:
+					all = append(all, tagged{Event{Tick: tick, Kind: End}, t, 3})
+					sawEnd = true
+				}
+			case st == 0xf0 || st == 0xf7:
+				l, ok := readVLQ(body, &q)
+				if !ok || uint64(q)+uint64(l) > uint64(len(body)) {
+					return nil, ErrTruncated
+				}
+				q += int(l)
+			default:
+				ch := st & 15
+				switch st >> 4 {
+				case 0x8, 0x9, 0xa, 0xb, 0xe:
+					if q+2 > len(body) {
+						return nil, ErrTruncated
+					}
+					a, bb := body[q], body[q+1]
+					q += 2
+					switch st >> 4 {
+					case 0x8:
+						all = append(all, tagged{Event{Tick: tick, Kind: NoteOff, Ch: ch, A: a & 0x7f, B: bb}, t, 0})
+					case 0x9:
+						if bb == 0 {
+							all = append(all, tagged{Event{Tick: tick, Kind: NoteOff, Ch: ch, A: a & 0x7f}, t, 0})
+						} else {
+							all = append(all, tagged{Event{Tick: tick, Kind: NoteOn, Ch: ch, A: a & 0x7f, B: bb & 0x7f}, t, 2})
+						}
+					case 0xb:
+						if a == 7 {
+							all = append(all, tagged{Event{Tick: tick, Kind: Volume, Ch: ch, A: bb & 0x7f}, t, 1})
+						}
+					}
+				case 0xc, 0xd:
+					if q+1 > len(body) {
+						return nil, ErrTruncated
+					}
+					if st>>4 == 0xc {
+						all = append(all, tagged{Event{Tick: tick, Kind: Program, Ch: ch, A: body[q] & 0x7f}, t, 1})
+					}
+					q++
+				default:
+					return nil, ErrTruncated // 0xf1 到 0xf6、0xf8 以上不該出現在檔內
+				}
+			}
+			if len(all) > maxEvents {
+				return nil, ErrTooMany
+			}
+		}
+		if !sawEnd && q < len(body) {
+			return nil, ErrTruncated
+		}
+		if tick > s.EndTick {
+			s.EndTick = tick
+		}
+		t++
+	}
+	if len(all) == 0 {
+		return nil, ErrNoTracks
+	}
+	sort.SliceStable(all, func(i, j int) bool {
+		if all[i].Tick != all[j].Tick {
+			return all[i].Tick < all[j].Tick
+		}
+		return all[i].prio < all[j].prio
+	})
+	s.Tracks = ntrk
+	s.Size = p
+	s.Events = make([]Event, len(all))
+	for i := range all {
+		s.Events[i] = all[i].Event
+	}
+	return s, nil
+}
+
+// sampleTimes 把每個事件的 tick 換成以 rate 取樣的位置，另回傳曲子結束的取樣位置。
+// 整數運算：累計 Σ(Δtick × 速度) 再乘 rate 除 (division × 1e6)，不隨長度漂移。
+func (s *Song) sampleTimes(rate int) (pos []uint64, end uint64) {
+	pos = make([]uint64, len(s.Events))
+	tempo := uint64(500000)
+	var num uint64 // 單位：微秒 × division
+	var last uint32
+	conv := func(n uint64) uint64 { return n * uint64(rate) / (uint64(s.Division) * 1000000) }
+	for i, e := range s.Events {
+		num += uint64(e.Tick-last) * tempo
+		last = e.Tick
+		pos[i] = conv(num)
+		if e.Kind == Tempo {
+			tempo = uint64(e.Tempo)
+		}
+	}
+	if s.EndTick > last {
+		num += uint64(s.EndTick-last) * tempo
+	}
+	return pos, conv(num)
+}
+
+// Duration 回傳以 rate 取樣的曲長（取樣數），依速度事件換算。
+func (s *Song) Duration(rate int) uint64 {
+	_, end := s.sampleTimes(rate)
+	return end
+}
+
+func (s *Song) String() string {
+	return fmt.Sprintf("SMF division=%d 軌=%d 事件=%d 結束 tick=%d", s.Division, s.Tracks, len(s.Events), s.EndTick)
+}
+
+// Seconds 回傳曲長（秒），依速度事件換算，不含釋放尾音。
+func (s *Song) Seconds() float64 { return float64(s.Duration(SampleRate)) / SampleRate }
diff --git a/apps/hr/sound/sound_test.go b/apps/hr/sound/sound_test.go
new file mode 100644
index 0000000..8b0a50a
--- /dev/null
+++ b/apps/hr/sound/sound_test.go
@@ -0,0 +1,301 @@
+package sound
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"math"
+	"testing"
+)
+
+// 測試用的 SMF 組裝器：全部是測試內自行組出的位元組，不引用任何原版檔案。
+
+func vlq(v uint32) []byte {
+	b := []byte{byte(v & 0x7f)}
+	for v >>= 7; v > 0; v >>= 7 {
+		b = append([]byte{byte(v&0x7f) | 0x80}, b...)
+	}
+	return b
+}
+
+type tb struct{ b []byte }
+
+func (t *tb) ev(dt uint32, data ...byte) *tb {
+	t.b = append(t.b, vlq(dt)...)
+	t.b = append(t.b, data...)
+	return t
+}
+func (t *tb) tempo(dt, us uint32) *tb {
+	return t.ev(dt, 0xff, 0x51, 3, byte(us>>16), byte(us>>8), byte(us))
+}
+func (t *tb) end(dt uint32) *tb { return t.ev(dt, 0xff, 0x2f, 0) }
+
+func smf(format, div uint16, tracks ...*tb) []byte {
+	var b bytes.Buffer
+	b.WriteString("MThd")
+	binary.Write(&b, binary.BigEndian, uint32(6))
+	binary.Write(&b, binary.BigEndian, format)
+	binary.Write(&b, binary.BigEndian, uint16(len(tracks)))
+	binary.Write(&b, binary.BigEndian, div)
+	for _, t := range tracks {
+		b.WriteString("MTrk")
+		binary.Write(&b, binary.BigEndian, uint32(len(t.b)))
+		b.Write(t.b)
+	}
+	return b.Bytes()
+}
+
+// oneNote 是 1 秒的曲子：速度 500000、division 48、第 0 通道音符 60 從 tick 0 到 48，曲末 tick 96。
+func oneNote(prog byte) []byte {
+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	t1 := (&tb{}).ev(0, 0xc0, prog).ev(0, 0x90, 60, 100).ev(48, 0x90, 60, 0).end(48)
+	return smf(1, 48, t0, t1)
+}
+
+func TestParseBasics(t *testing.T) {
+	s, err := ParseSMF(oneNote(0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Division != 48 || s.Tracks != 2 || s.EndTick != 96 {
+		t.Fatalf("division=%d tracks=%d end=%d", s.Division, s.Tracks, s.EndTick)
+	}
+	want := []Kind{Tempo, Program, NoteOn, NoteOff, End, End}
+	var got []Kind
+	for _, e := range s.Events {
+		got = append(got, e.Kind)
+	}
+	if len(got) != len(want) {
+		t.Fatalf("事件種類 %v，應為 %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("事件 %d：%v，應為 %v（全部 %v）", i, got[i], want[i], got)
+		}
+	}
+	if d := s.Duration(SampleRate); d != SampleRate {
+		t.Fatalf("曲長 %d 取樣，應為 %d", d, SampleRate)
+	}
+}
+
+func TestTempoChange(t *testing.T) {
+	t0 := (&tb{}).tempo(0, 500000).tempo(48, 1000000).end(48)
+	s, err := ParseSMF(smf(1, 48, t0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// 前 48 tick 為 0.5 秒，後 48 tick 為 1.0 秒
+	if d, want := s.Duration(SampleRate), uint64(SampleRate*3/2); d != want {
+		t.Fatalf("曲長 %d，應為 %d", d, want)
+	}
+}
+
+func TestSameTickOrdering(t *testing.T) {
+	// 同一 tick 的 note-off 必須先於 note-on、program 先於 note-on，與寫入順序無關
+	t1 := (&tb{}).ev(0, 0x90, 60, 100).ev(48, 0x90, 62, 100).ev(0, 0xc0, 5).ev(0, 0x80, 60, 0).end(48)
+	s, err := ParseSMF(smf(0, 48, t1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var at48 []Kind
+	for _, e := range s.Events {
+		if e.Tick == 48 {
+			at48 = append(at48, e.Kind)
+		}
+	}
+	if len(at48) != 3 || at48[0] != NoteOff || at48[1] != Program || at48[2] != NoteOn {
+		t.Fatalf("tick 48 的順序 %v，應為 [NoteOff Program NoteOn]", at48)
+	}
+}
+
+func TestRunningStatus(t *testing.T) {
+	// 0x90 60 100 | (省略狀態) 62 100 | (省略狀態) 64 0
+	t1 := (&tb{}).ev(0, 0x90, 60, 100).ev(10, 62, 100).ev(10, 64, 0).end(10)
+	s, err := ParseSMF(smf(0, 48, t1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var on, off int
+	for _, e := range s.Events {
+		switch e.Kind {
+		case NoteOn:
+			on++
+		case NoteOff:
+			off++
+		}
+	}
+	if on != 2 || off != 1 {
+		t.Fatalf("on=%d off=%d，應為 2 與 1", on, off)
+	}
+}
+
+func TestParseTrailingGarbageAndUnknownChunk(t *testing.T) {
+	// 遊戲的 MID 緩衝在短檔之後殘留前一首的位元組：必須只讀宣告的軌數
+	b := oneNote(0)
+	b = append(b, bytes.Repeat([]byte{0xAA, 'M', 'T', 'r', 'k', 0xFF}, 50)...)
+	if _, err := ParseSMF(b); err != nil {
+		t.Fatalf("尾端殘留應被忽略：%v", err)
+	}
+	// 軌之間的未知區塊略過
+	var x bytes.Buffer
+	good := oneNote(0)
+	x.Write(good[:14])
+	x.WriteString("XFIH")
+	binary.Write(&x, binary.BigEndian, uint32(3))
+	x.Write([]byte{1, 2, 3})
+	x.Write(good[14:])
+	if _, err := ParseSMF(x.Bytes()); err != nil {
+		t.Fatalf("未知區塊應被略過：%v", err)
+	}
+}
+
+// 負對照：下列輸入必須被拒絕，而不是部分接受。
+func TestParseRejects(t *testing.T) {
+	good := oneNote(0)
+	cases := map[string][]byte{
+		"空":          nil,
+		"太短":         good[:10],
+		"沒有 MThd":    append([]byte("RIFF"), good[4:]...),
+		"格式 2":       smf(2, 48, (&tb{}).end(0)),
+		"SMPTE":      smf(1, 0xE728, (&tb{}).end(0)),
+		"division 0": smf(1, 0, (&tb{}).end(0)),
+		"軌數 0":       smf(1, 48),
+		"MTrk 被截斷":   good[:len(good)-5],
+		"只有 MThd":    good[:14],
+		"事件截斷":       smf(0, 48, (&tb{}).ev(0, 0x90, 60)),
+		"首事件缺狀態":     smf(0, 48, (&tb{}).ev(0, 60, 100).end(0)),
+	}
+	for name, b := range cases {
+		if s, err := ParseSMF(b); err == nil {
+			t.Errorf("%s：應被拒絕，卻得到 %v", name, s)
+		}
+	}
+	// 宣告 3 軌但只有 2 軌的資料
+	b := append([]byte(nil), good...)
+	b[11] = 3
+	if _, err := ParseSMF(b); err == nil {
+		t.Errorf("宣告軌數多於實際，應被拒絕")
+	}
+}
+
+func sha(f []float32) [32]byte {
+	b := make([]byte, 4*len(f))
+	for i, v := range f {
+		binary.LittleEndian.PutUint32(b[4*i:], math.Float32bits(v))
+	}
+	return sha256.Sum256(b)
+}
+
+func stats(f []float32) (peak, rms float64, bad int) {
+	var sum float64
+	for _, v := range f {
+		if math.IsNaN(float64(v)) || math.IsInf(float64(v), 0) {
+			bad++
+			continue
+		}
+		if a := math.Abs(float64(v)); a > peak {
+			peak = a
+		}
+		sum += float64(v) * float64(v)
+	}
+	if len(f) > 0 {
+		rms = math.Sqrt(sum / float64(len(f)))
+	}
+	return
+}
+
+func TestRenderDeterministicAndSane(t *testing.T) {
+	s, _ := ParseSMF(oneNote(0))
+	a, b := RenderSong(s), RenderSong(s)
+	if sha(a) != sha(b) {
+		t.Fatal("同一首兩次轉檔不相同")
+	}
+	peak, rms, bad := stats(a)
+	if bad != 0 || peak <= 0.01 || peak > 1 || rms <= 0.001 {
+		t.Fatalf("peak=%.4f rms=%.5f 異常值 %d", peak, rms, bad)
+	}
+	if len(a) < SampleRate || len(a) > SampleRate+3*SampleRate {
+		t.Fatalf("長度 %d 取樣不合理", len(a))
+	}
+	// 曲末之後的尾音要唱完：最後一個取樣近乎靜音
+	if v := math.Abs(float64(a[len(a)-1])); v > 0.01 {
+		t.Fatalf("尾端仍有 %.4f", v)
+	}
+}
+
+func TestProgramsDiffer(t *testing.T) {
+	// 負對照：不同音色必須產生不同的波形（避免查表全部指向同一個音色）
+	seen := map[[32]byte]uint8{}
+	for _, p := range []uint8{0, 13, 16, 34, 35, 48, 50, 51, 53, 55, 56, 58, 73, 83, 84, 86, 89, 91, 93, 94, 96, 112} {
+		s, _ := ParseSMF(oneNote(p))
+		h := sha(RenderSong(s))
+		if q, dup := seen[h]; dup {
+			t.Errorf("音色 %d 與 %d 的輸出相同", p, q)
+		}
+		seen[h] = p
+	}
+	// 家族預設也要有輸出
+	for _, p := range []uint8{1, 8, 24, 40, 64, 80, 104, 120, 127} {
+		s, _ := ParseSMF(oneNote(p))
+		if pk, _, bad := stats(RenderSong(s)); pk < 0.01 || bad != 0 {
+			t.Errorf("音色 %d 無輸出或有異常值", p)
+		}
+	}
+}
+
+func TestDrums(t *testing.T) {
+	for _, note := range []byte{36, 38, 45, 46, 49, 42, 70} {
+		t1 := (&tb{}).ev(0, 0x99, note, 110).end(48)
+		s, err := ParseSMF(smf(0, 48, t1))
+		if err != nil {
+			t.Fatal(err)
+		}
+		pk, rms, bad := stats(RenderSong(s))
+		if pk < 0.01 || rms <= 0 || bad != 0 {
+			t.Errorf("鼓 %d：peak=%.4f rms=%.5f bad=%d", note, pk, rms, bad)
+		}
+	}
+}
+
+func TestPolyphonyLimit(t *testing.T) {
+	t1 := &tb{}
+	for i := 0; i < 40; i++ {
+		t1.ev(0, 0x90, byte(40+i), 100)
+	}
+	t1.end(96)
+	s, err := ParseSMF(smf(0, 48, t1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := NewRenderer(s)
+	buf := make([]float32, 2048)
+	r.Render(buf)
+	n := 0
+	for i := range r.voices {
+		if r.voices[i].active {
+			n++
+		}
+	}
+	if n != maxVoices {
+		t.Fatalf("40 個同時音符後 %d 個聲部在發聲，應為上限 %d", n, maxVoices)
+	}
+	for i := range buf {
+		buf[i] = softClip(buf[i])
+	}
+	if pk, _, bad := stats(buf); bad != 0 || pk > 1 {
+		t.Fatalf("peak=%.3f bad=%d", pk, bad)
+	}
+}
+
+func TestVolumeControllerScales(t *testing.T) {
+	mk := func(vol byte) []float32 {
+		t1 := (&tb{}).ev(0, 0xb0, 7, vol).ev(0, 0x90, 60, 100).ev(48, 0x90, 60, 0).end(48)
+		s, _ := ParseSMF(smf(0, 48, t1))
+		return RenderSong(s)
+	}
+	lo, _, _ := stats(mk(30))
+	hi, _, _ := stats(mk(127))
+	if !(hi > lo*2) {
+		t.Fatalf("控制器 7 沒有影響音量：30 → %.4f，127 → %.4f", lo, hi)
+	}
+}
