+// 曲中換音色必須生效（原曲有同軌換音色，MAP3_1 的 FM3 軌 13 次）：換音色之前的輸出與「沒有換音色」的版本逐位元相同，
+// 換音色之後不同。壞合成器若忽略曲中 program change，這個測試擋得下。
+func TestMidTrackProgramChangeTakesEffect(t *testing.T) {
+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	with := (&tb{}).ev(0, 0xc0, 0).ev(0, 0x90, 60, 100).ev(48, 0x80, 60, 0).ev(0, 0xc0, 56).ev(0, 0x90, 60, 100).ev(48, 0x80, 60, 0).end(0)
+	without := (&tb{}).ev(0, 0xc0, 0).ev(0, 0x90, 60, 100).ev(48, 0x80, 60, 0).ev(0, 0x90, 60, 100).ev(48, 0x80, 60, 0).end(0)
+	a, _ := ParseSMF(smf(1, 48, t0, with))
+	b, _ := ParseSMF(smf(1, 48, t0, without))
+	fa, _ := RenderSongRaw(a, nil)
+	fb, _ := RenderSongRaw(b, nil)
+	half := secsF(0.5)
+	for i := 0; i < half; i++ {
+		if fa[i] != fb[i] {
+			t.Fatalf("換音色之前的輸出應相同，取樣 %d 不同", i)
+		}
+	}
+	diff := 0
+	for i := half; i < secsF(1.0) && i < len(fa) && i < len(fb); i++ {
+		if fa[i] != fb[i] {
+			diff++
+		}
+	}
+	if diff < SampleRate/10 {
+		t.Fatalf("換音色之後輸出幾乎相同（%d 個不同取樣）：曲中 program change 沒有生效", diff)
+	}
+}
