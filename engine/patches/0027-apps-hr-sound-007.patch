+package main
+
+import "strings"
+
+// resolveMute 決定啟動時是否靜音（docs/spec/007 第 5.4 節）。優先序：命令列旗標、環境變數 HR_MUTE、
+// 偏好設定的 sound 欄位、預設（不靜音）。
+//   - flagGiven：命令列有明確給 -mute（含 -mute=false，由 flag.Visit 判斷），此時 flagVal 決定一切；
+//   - env：HR_MUTE 的值，"1"、"true" 靜音，"0"、"false" 明確不靜音（能壓過偏好設定的 sound:false），
+//     其他值（含空字串）視為沒設；
+//   - sound：偏好設定的 sound 欄位，nil ＝ 沒有這個欄位。
+func resolveMute(flagGiven, flagVal bool, env string, sound *bool) bool {
+	if flagGiven {
+		return flagVal
+	}
+	switch strings.ToLower(strings.TrimSpace(env)) {
+	case "1", "true":
+		return true
+	case "0", "false":
+		return false
+	}
+	if sound != nil {
+		return !*sound
+	}
+	return false
+}
