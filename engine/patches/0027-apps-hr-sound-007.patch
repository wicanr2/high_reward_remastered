+	}
+	if got := s.m.Read8(lin(stateSeg, curTrack)); got != 14 {
+		t.Skipf("狀態檔的目前曲號是 %d，不是 14", got)
+	}
+	sink.mu.Lock()
+	sink.log, sink.starts, sink.fades = nil, nil, nil
+	sink.playing = false // 載入的狀態沒有「正在播放」的曲子（開機時 Sink 回報的播放中是舊的）
+	sink.mu.Unlock()
+	s.RunSteps(s.m.Steps + 5_000_000)
+	sink.mu.Lock()
+	defer sink.mu.Unlock()
+	var order []string // 音效（點擊音）可能穿插，順序只看音樂事件
+	for _, e := range sink.log {
+		if e != "sfx" {
+			order = append(order, e)
+		}
+	}
+	if len(order) < 2 || order[0] != "fade" || order[1] != "start" {
+		t.Fatalf("PlayMusic 的音樂事件順序 %v，應以 [fade start] 開頭（全部事件 %v）", order, sink.log)
+	}
+	if !bytes.HasPrefix(sink.starts[0], want) {
+		t.Fatal("換曲後的 MusicStart 不是 NATIONAL.MID")
+	}
+	if n := len(sink.starts); n != 1 {
+		t.Fatalf("跟隨型 Sink 回報播放中之後不該再重載，得到 %d 次 MusicStart（事件 %v）", n, sink.log)
+	}
+	if got := s.m.Read8(lin(stateSeg, curTrack)); got != 14 {
+		t.Fatalf("PlayMusic 結束後目前曲號是 %d，應為 14", got)
+	}
+}
+
+// 診斷與機器人存下的狀態檔不帶聲音狀態：Sink 開啟時存的狀態，3E24:01BA 是 0；
+// 無 Sink 載入後，遊戲在有限步數內離開 PlayMusic 的等待迴圈（會呼叫 059B 重讀 MID），不卡住。
+func TestSoundStateFilesAreClean(t *testing.T) {
+	if testing.Short() {
+		t.Skip("-short")
+	}
+	sink := &fakeSink{follow: true}
+	s := runSteps(t, Options{Sound: sink}, 20_000_000) // 開機後 Sink 回報播放中的狀態
+	if sink.nStarts() != 1 {
+		t.Fatalf("前提不成立：開機後 MusicStart %d 次", sink.nStarts())
+	}
+	if got := s.m.Read16(lin(soundData, 0x01BA)); got != 0 {
+		t.Fatalf("Sink 開啟時 3E24:01BA ＝ %#x，應為 0（掛鉤不寫它）", got)
+	}
+	path := filepath.Join(t.TempDir(), "sound-on.state")
+	if err := state.Save(path, s.m, s.d); err != nil {
+		t.Fatal(err)
+	}
+	// 無 Sink 載入並繼續跑：第一次 PlayMusic（059B 讀檔）必須發生，而且之後遊戲仍在前進
+	bare, err := Open(origRoot(t), Options{Interval: NativeInterval})
+	if err != nil {
+		t.Fatal(err)
+	}
+	bare.nextTrim = ^uint64(0)
+	bare.RunSteps(1_000_000)
+	if err := state.Load(path, bare.m, bare.d); err != nil {
+		t.Fatal(err)
+	}
+	opened := len(bare.d.Opened)
+	bare.RunSteps(bare.m.Steps + 10_000_000)
+	if len(bare.d.Opened) == opened {
+		t.Fatal("無 Sink 載入後 10M 步沒有任何開檔：遊戲卡在 PlayMusic 的等待迴圈（狀態檔帶了聲音狀態？）")
+	}
+	if cs := bare.m.CPU.Seg[cpu.CS]; cs == soundSeg && bare.m.CPU.IP >= 0x0274 && bare.m.CPU.IP <= 0x02D1 {
+		t.Logf("提示：此刻 CS:IP 在 0274 內（%04X:%04X），但有開檔表示遊戲仍在前進", cs, bare.m.CPU.IP)
+	}
+}
+
+// 轉送給引擎並記下每次 MusicStart 當下的客體 tick 數。
+type spySink struct {
+	eng    *sound.Engine
+	ticks  func() uint64
+	startT []uint64
+	want   []byte // 非空時，檢查每次 MusicStart 的資料以它開頭
+	bad    int
+}
+
+func (p *spySink) MusicStart(mid []byte) {
+	p.startT = append(p.startT, p.ticks())
+	if len(p.want) > 0 && !bytes.HasPrefix(mid, p.want) {
+		p.bad++
+	}
+	p.eng.MusicStart(mid)
+}
+func (p *spySink) MusicStop()       { p.eng.MusicStop() }
+func (p *spySink) MusicFade(n int)  { p.eng.MusicFade(n) }
+func (p *spySink) SFX(id, s, e int) { p.eng.SFX(id, s, e) }
+func (p *spySink) Playing() bool    { return p.eng.Playing() }
+
+// Engine 加 Session 的整合：以模擬速率餵引擎取樣（每個遊戲秒餵 44100 個取樣框，等同牆鐘拉取者追上遊戲時鐘），
+// 開機的 SCOUT.MID（約 36.4 秒）播完後，遊戲必須自己重播，連續三次 MusicStart。
+//   - 第 1 至 2 次相隔只驗證「曲末後遊戲自行重播」：開機時引擎沒有目前曲，第一首立即出聲，Z1 的假淡出看不到。
+//   - 第 2 至 3 次相隔才驗證 Z1（曲末後、尾音還在唱時的淡出必須是空操作）：若引擎把曲末後的淡出當成真的，
+//     第二首要晚約 0.71 秒才出聲，它的 SongDone 與 Playing()==false 跟著晚，第三次 MusicStart 因此晚約 0.71 秒。
+//     容差 0.35 遊戲秒（每批 1M 步約 0.18 遊戲秒的量化加一個 tick 的重播延遲）小於 0.71，所以拿掉修正會失敗。
+//     突變驗證記在 docs/re/019。
+func TestSoundEngineSessionIntegration(t *testing.T) {
+	if testing.Short() {
+		t.Skip("-short")
+	}
+	root := origRoot(t)
+	want, err := os.ReadFile(filepath.Join(root, "SCOUT.MID"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	song, err := sound.ParseSMF(want)
+	if err != nil {
+		t.Fatal(err)
+	}
+	eng := sound.NewEngine()
+	eng.SetMute(true)
+	spy := &spySink{eng: eng, want: want}
+	s, err := Open(root, Options{Interval: DefaultInterval, Sound: spy})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.nextTrim = ^uint64(0)
+	spy.ticks = func() uint64 { return s.m.Ticks }
+	buf := make([]byte, 4*sound.SampleRate)
+	var fed float64
+	for float64(s.m.Ticks)/TickHz < 150 && len(spy.startT) < 3 {
+		s.RunSteps(s.m.Steps + 1_000_000)
+		now := float64(s.m.Ticks) / TickHz
+		for fed < now {
+			d := now - fed
+			if d > 1 {
+				d = 1
+			}
+			frames := int(d * sound.SampleRate)
+			if frames > 0 {
+				eng.Read(buf[:4*frames])
+			}
+			fed += d
+		}
+	}
+	if len(spy.startT) < 3 {
+		t.Fatalf("150 遊戲秒內只有 %d 次 MusicStart：曲末後遊戲沒有連續重播", len(spy.startT))
+	}
+	at := func(i int) float64 { return float64(spy.startT[i]) / TickHz }
+	dur := song.Seconds()
+	gap12, gap23 := at(1)-at(0), at(2)-at(1)
+	t.Logf("MusicStart 在遊戲秒 %.2f、%.2f、%.2f；相隔 %.2f 與 %.2f；SCOUT.MID 曲長 %.2f 秒", at(0), at(1), at(2), gap12, gap23, dur)
+	const tol = 0.35
+	for i, g := range []float64{gap12, gap23} {
+		if g < dur-tol || g > dur+tol {
+			t.Errorf("第 %d 至 %d 次 MusicStart 相隔 %.2f 遊戲秒，應在曲長 %.2f 的正負 %.2f 內", i+1, i+2, g, dur, tol)
+		}
+	}
+	// 每次 MusicStart 的資料都是 SCOUT.MID（Sink 收到的是 0x4E20 位元組的緩衝複本，前綴即檔案內容）
+	if spy.bad != 0 {
+		t.Errorf("%d 次 MusicStart 的資料不是以 SCOUT.MID 開頭", spy.bad)
+	}
+}
