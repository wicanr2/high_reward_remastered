+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	t1 := (&tb{}).ev(0, 0xc0, 89).ev(0, 0x90, 60, 100).ev(96, 0x80, 60, 0).end(0) // 音符到曲末才結束，墊音釋放約 0.6 秒
+	pad, err := ParseSMF(smf(1, 48, t0, t1))
