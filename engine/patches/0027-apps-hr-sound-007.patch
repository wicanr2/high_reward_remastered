+package sound
+
+import (
+	"math"
+	"testing"
+)
+
+// 這些測試的判準都來自 SMF 本身或獨立的公式，不依賴合成器的內部參數，
+// 目的是讓「固定振幅的正弦波播到曲末」這種壞合成器過不了（docs/spec/007 第 8 節）。
+
+func rms(f []float32) float64 {
+	var s float64
+	for _, v := range f {
+		s += float64(v) * float64(v)
+	}
+	if len(f) == 0 {
+		return 0
+	}
+	return math.Sqrt(s / float64(len(f)))
+}
+
+// 起音取樣位置對獨立公式：tick 依速度表換成秒再乘取樣率，容差 1 取樣。
+func TestEventTimingMatchesIndependentFormula(t *testing.T) {
+	// division 96；速度 400000 → tick 96 後改 700000 → tick 288 後改 250000
+	t0 := (&tb{}).tempo(0, 400000).tempo(96, 700000).tempo(192, 250000).end(300)
+	t1 := (&tb{}).
+		ev(0, 0x90, 60, 90).ev(30, 0x80, 60, 0).
+		ev(66, 0x90, 62, 90).ev(100, 0x80, 62, 0).  // tick 96 與 196
+		ev(100, 0x90, 64, 90).ev(150, 0x80, 64, 0). // tick 296 與 446（446 超過速度軌結束）
+		end(0)
+	s, err := ParseSMF(smf(1, 96, t0, t1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	type seg struct {
+		tick uint64
+		us   float64
+	}
+	tempos := []seg{{0, 400000}, {96, 700000}, {288, 250000}}
+	secAt := func(tick uint64) float64 {
+		var sec, last = 0.0, uint64(0)
+		cur := tempos[0].us
+		for _, tp := range tempos[1:] {
+			if tp.tick >= tick {
+				break
+			}
+			sec += float64(tp.tick-last) * cur / 96 / 1e6
+			last, cur = tp.tick, tp.us
+		}
+		return sec + float64(tick-last)*cur/96/1e6
+	}
+	var got []struct {
+		k      Kind
+		tick   uint32
+		sample uint64
+	}
+	_, r := RenderSongRaw(s, func(e *Event, sample uint64) {
+		if e.Kind == NoteOn || e.Kind == NoteOff {
+			got = append(got, struct {
+				k      Kind
+				tick   uint32
+				sample uint64
+			}{e.Kind, e.Tick, sample})
+		}
+	})
+	_ = r
+	if len(got) != 6 {
+		t.Fatalf("音符事件 %d 個，應為 6", len(got))
+	}
+	for _, g := range got {
+		want := math.Floor(secAt(uint64(g.tick)) * SampleRate)
+		if d := math.Abs(float64(g.sample) - want); d > 1 {
+			t.Errorf("tick %d（%v）：送出於取樣 %d，獨立公式 %.1f，差 %.1f", g.tick, g.k, g.sample, want, d)
+		}
+	}
+}
+
+// 有音與休止：音符時段的能量高，休止（超過最長釋放之後）幾乎為 0。固定正弦波過不了。
+func TestRestsAreSilentAndNotesAreAudible(t *testing.T) {
+	// 速度 500000、division 48：1 tick ＝ 約 10.4 ms。音符 tick 0 到 48（0.5 s），休止到 tick 192（2.0 s），音符 192 到 240。
+	t0 := (&tb{}).tempo(0, 500000).end(264)
+	for _, prog := range []uint8{0, 35, 56, 73} {
+		t1 := (&tb{}).ev(0, 0xc0, prog).ev(0, 0x90, 60, 100).ev(48, 0x80, 60, 0).ev(144, 0x90, 67, 100).ev(48, 0x80, 67, 0).end(24)
+		sp, err := ParseSMF(smf(1, 48, t0, t1))
+		if err != nil {
+			t.Fatal(err)
+		}
+		f, _ := RenderSongRaw(sp, nil)
+		win := func(a, b float64) []float32 { return f[secsF(a):secsF(b)] }
+		if r := rms(win(0.05, 0.45)); r < 0.01 {
+			t.Errorf("音色 %d：音符時段 RMS %.5f 太小", prog, r)
+		}
+		// 休止：0.5 s 後最長釋放約 1.2 s（鈴），從 1.8 s 到 2.0 s 要幾乎靜音
+		if r := rms(win(1.8, 1.99)); r > 0.002 {
+			t.Errorf("音色 %d：休止時段 RMS %.5f 太大（卡音或常數音）", prog, r)
+		}
+		if r := rms(win(2.05, 2.45)); r < 0.01 {
+			t.Errorf("音色 %d：第二個音 RMS %.5f 太小", prog, r)
+		}
+	}
+}
+
+func secsF(s float64) int { return int(math.Round(s * SampleRate)) }
+
+// 基頻：單音區段自相關，對 MIDI 音高。
+func TestPitchMatchesMIDINote(t *testing.T) {
+	estimate := func(f []float32) float64 {
+		// 自相關在 30 Hz 到 2 kHz 間找最大值（取第一個超過全域最大 0.9 倍的峰，避免倍頻）
+		minLag, maxLag := SampleRate/2000, SampleRate/30
+		var r0 float64
+		for _, v := range f {
+			r0 += float64(v) * float64(v)
+		}
+		best, bestLag := 0.0, 0
+		corr := make([]float64, maxLag+1)
+		for lag := minLag; lag <= maxLag; lag++ {
+			var s float64
+			for i := 0; i+lag < len(f); i++ {
+				s += float64(f[i]) * float64(f[i+lag])
+			}
+			corr[lag] = s / r0
+			if corr[lag] > best {
+				best, bestLag = corr[lag], lag
+			}
+		}
+		for lag := minLag + 1; lag < maxLag; lag++ {
+			if corr[lag] > 0.9*best && corr[lag] >= corr[lag-1] && corr[lag] >= corr[lag+1] {
+				bestLag = lag
+				break
+			}
+		}
+		return float64(SampleRate) / float64(bestLag)
+	}
+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	for _, prog := range []uint8{0, 35, 48, 56, 73, 89} {
+		for _, note := range []byte{40, 52, 60, 72, 84} {
+			t1 := (&tb{}).ev(0, 0xc0, prog).ev(0, 0x90, note, 100).ev(96, 0x80, note, 0).end(0)
+			s, _ := ParseSMF(smf(1, 48, t0, t1))
+			f, _ := RenderSongRaw(s, nil)
+			seg := f[secsF(0.6) : secsF(0.6)+4096] // 起音與包絡過了的穩定段
+			want := 440 * math.Pow(2, (float64(note)-69)/12)
+			got := estimate(seg)
+			if math.Abs(got-want)/want > 0.03 {
+				t.Errorf("音色 %d 音符 %d：基頻 %.1f Hz，應為 %.1f Hz", prog, note, got, want)
+			}
+		}
+	}
+}
+
+// 各通道單獨渲染再相加（不限幅）必須等於整首渲染：聲部之間互不干擾，複音沒有取代。
+func TestPerChannelSumEqualsFull(t *testing.T) {
+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	mk := func(chs ...int) *Song {
+		t1 := &tb{}
+		// 三個旋律通道（2、3、4）與打擊樂通道 10；事件交錯寫在同一軌，依通道過濾
+		type ev struct {
+			dt  uint32
+			ch  int
+			msg []byte
+		}
+		all := []ev{
+			{0, 1, []byte{0xc1, 0}}, {0, 2, []byte{0xc2, 35}}, {0, 3, []byte{0xc3, 56}},
+			{0, 1, []byte{0x91, 60, 100}}, {0, 2, []byte{0x92, 40, 100}}, {0, 3, []byte{0x93, 67, 90}}, {0, 9, []byte{0x99, 36, 110}},
+			{24, 9, []byte{0x99, 38, 100}}, {24, 1, []byte{0x81, 60, 0}}, {0, 2, []byte{0x82, 40, 0}}, {0, 3, []byte{0x83, 67, 0}},
+			{12, 1, []byte{0x91, 64, 100}}, {12, 9, []byte{0x99, 46, 90}}, {24, 1, []byte{0x81, 64, 0}},
+		}
+		keep := func(c int) bool {
+			for _, x := range chs {
+				if x == c {
+					return true
+				}
+			}
+			return false
+		}
+		var carry uint32
+		for _, e := range all {
+			if keep(e.ch) {
+				t1.ev(e.dt+carry, e.msg...)
+				carry = 0
+			} else {
+				carry += e.dt
+			}
+		}
+		t1.end(carry)
+		s, err := ParseSMF(smf(1, 48, t0, t1))
+		if err != nil {
+			t.Fatal(err)
+		}
+		return s
+	}
+	full, rf := RenderSongRaw(mk(1, 2, 3, 9), nil)
+	if rf.Steals != 0 {
+		t.Fatalf("不該有聲部被取代：%d", rf.Steals)
+	}
+	sum := make([]float32, len(full))
+	for _, c := range []int{1, 2, 3, 9} {
+		f, _ := RenderSongRaw(mk(c), nil)
+		if len(f) > len(sum) {
+			t.Fatalf("通道 %d 的渲染比整首長", c)
+		}
+		for i, v := range f {
+			sum[i] += v
+		}
+	}
+	var maxd float64
+	for i := range full {
+		if d := math.Abs(float64(full[i] - sum[i])); d > maxd {
+			maxd = d
+		}
+	}
+	if maxd > 1e-5 {
+		t.Fatalf("通道和與整首最大差 %.3g，應為 0（容差 1e-5）", maxd)
+	}
+	if rms(full) < 0.01 {
+		t.Fatal("整首近乎靜音")
+	}
+}
+
+// 打擊樂 36、38、45、46、49 各有起音瞬態：起音後 20 ms 的 RMS 遠高於起音前 20 ms。
+func TestDrumOnsets(t *testing.T) {
+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	for _, note := range []byte{36, 38, 45, 46, 49} {
+		t1 := (&tb{}).ev(48, 0x99, note, 110).end(48) // 0.5 s 起音
+		s, _ := ParseSMF(smf(1, 48, t0, t1))
+		f, _ := RenderSongRaw(s, nil)
+		on := secsF(0.5)
+		before, after := rms(f[on-secsF(0.02):on]), rms(f[on:on+secsF(0.02)])
+		if before != 0 || after < 0.003 {
+			t.Errorf("鼓 %d：起音前 RMS %.5f，起音後 %.5f", note, before, after)
+		}
+	}
+}
+
+// 一個通道最多同時 24 個聲部以外不應取代：兩個同時音符不產生 Steals。
+func TestNoStealsWithinPolyphony(t *testing.T) {
+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	t1 := (&tb{}).ev(0, 0x90, 60, 100).ev(0, 0x90, 64, 100).ev(48, 0x80, 60, 0).ev(0, 0x80, 64, 0).end(0)
+	s, _ := ParseSMF(smf(1, 48, t0, t1))
+	_, r := RenderSongRaw(s, nil)
+	if r.Steals != 0 {
+		t.Fatalf("Steals=%d", r.Steals)
+	}
+	// 負對照：上限降到不夠時 Steals 要大於 0（偵測有作用）
+	t2 := &tb{}
+	for i := 0; i < maxVoices+3; i++ {
+		t2.ev(0, 0x90, byte(40+i), 100)
+	}
+	t2.end(48)
+	s2, _ := ParseSMF(smf(1, 48, t0, t2))
+	_, r2 := RenderSongRaw(s2, nil)
+	if r2.Steals != 3 {
+		t.Fatalf("多 3 個音符時 Steals=%d，應為 3", r2.Steals)
+	}
+}
+
+// 力度 0 的 note-on 視為 note-off（running status 下原曲都這樣結束音符）；同通道同音高重疊時，
+// note-off 釋放最早的一個聲部。
+func TestNoteOffSemantics(t *testing.T) {
+	t0 := (&tb{}).tempo(0, 500000).end(96)
+	// 同音高重疊兩次，再各一個 note-off：兩個聲部都要被釋放
+	t1 := (&tb{}).ev(0, 0x90, 60, 100).ev(10, 0x90, 60, 100).ev(10, 0x90, 60, 0).ev(10, 0x90, 60, 0).end(0)
+	s, _ := ParseSMF(smf(1, 48, t0, t1))
+	r := NewRenderer(s)
+	buf := make([]float32, SampleRate/2)
+	r.Render(buf) // 0.5 s：4 個事件（tick 0、10、20、30）都已送出
+	var released, active int
+	for i := range r.voices {
+		if r.voices[i].active {
+			active++
+			if r.voices[i].released {
+				released++
+			}
+		}
+	}
+	if active != 2 || released != 2 {
+		t.Fatalf("active=%d released=%d，兩個重疊音符都應被釋放", active, released)
+	}
+}
