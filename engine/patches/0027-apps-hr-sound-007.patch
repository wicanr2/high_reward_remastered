+}
+
+// 換曲路徑（docs/spec/007 第 7 節）：用長跑取樣的狀態檔（遊戲停在標題後的畫面，目前曲號 14，
+// 無 Sink 時 PlayMusic(14) 被反覆呼叫）。載入後 PlayMusic 的順序必須是淡出、開始，
+// 開始的資料是 NATIONAL.MID；之後（跟隨型 Sink 回報播放中）不再重載。缺狀態檔 skip。
+func TestSoundPlayMusicPathFromState(t *testing.T) {
+	p := os.Getenv("HR_SOAK_STATE")
+	if p == "" {
+		t.Skip("沒有設 HR_SOAK_STATE")
+	}
