+// fakeSink 記錄遊戲對聲音常式的呼叫。
+//   - follow ＝ false：Playing() 恆回答 fixed（正對照用：恆假等於原版旗標 0 的行為；恆真等於卡住的驅動）。
+//   - follow ＝ true：像真的引擎，Start 後為真，Stop 或 Fade 後為假，外部可用 setPlaying 模擬曲子自然結束。
+type fakeSink struct {
+	mu      sync.Mutex
+	follow  bool
+	fixed   bool
+	playing bool
+	starts  [][]byte
+	stops   int
+	fades   []int
+	sfx     [][3]int
+	log     []string // 事件順序：start、stop、fade、sfx
+	discard bool     // 不保留資料與日誌（效能量測用，免得保留 20 KB 複本拖累 GC）
+	queries int
+}
+
+func (f *fakeSink) MusicStart(mid []byte) {
+	f.mu.Lock()
+	if !f.discard {
+		f.starts = append(f.starts, mid)
+		f.log = append(f.log, "start")
+	}
+	f.playing = true
+	f.mu.Unlock()
+}
+func (f *fakeSink) MusicStop() {
+	f.mu.Lock()
+	f.stops++
+	f.playing = false
+	f.log = append(f.log, "stop")
+	f.mu.Unlock()
+}
+func (f *fakeSink) MusicFade(n int) {
+	f.mu.Lock()
+	f.fades = append(f.fades, n)
+	f.log = append(f.log, "fade")
+	f.playing = false
+	f.mu.Unlock()
+}
+func (f *fakeSink) SFX(id, start, end int) {
+	f.mu.Lock()
+	f.sfx = append(f.sfx, [3]int{id, start, end})
+	f.log = append(f.log, "sfx")
+	f.mu.Unlock()
+}
+func (f *fakeSink) Playing() bool {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.queries++
+	if f.follow {
+		return f.playing
+	}
+	return f.fixed
+}
+func (f *fakeSink) setPlaying(v bool) { f.mu.Lock(); f.playing = v; f.mu.Unlock() }
+func (f *fakeSink) nStarts() int      { f.mu.Lock(); defer f.mu.Unlock(); return len(f.starts) }
+
+// 不需要原版：直接對一台空機器呼叫 post，驗證引數解碼。
+func TestSoundPostDecodesArguments(t *testing.T) {
+	m := machine.New()
+	sink := &fakeSink{}
+	h := &soundHooks{sink: sink}
+	const ss, sp = 0x5000, 0x1000
+	m.CPU.Seg[cpu.SS], m.CPU.R[cpu.SP] = ss, sp
+	// 進入點第一道指令 push bp 已執行：第一個引數在 SS:SP+6
+	arg := lin(ss, sp+6)
+
+	// 淡出：只取低位元組
+	m.Write16(arg, 0x0301)
+	h.post(m, sndFade)
+	if len(sink.fades) != 1 || sink.fades[0] != 1 {
+		t.Fatalf("fades=%v，應為 [1]（只取低位元組）", sink.fades)
+	}
+
+	// 停止：交給 Sink，並把目前曲號 2BCC:0223 清為 0FFh（有驅動時原版的行為）
+	m.Write8(lin(stateSeg, curTrack), 14)
+	h.post(m, sndStop)
+	if sink.stops != 1 {
+		t.Fatalf("stops=%d", sink.stops)
+	}
+	if got := m.Read8(lin(stateSeg, curTrack)); got != noTrack {
+		t.Fatalf("停止後目前曲號是 %#x，應為 0xFF", got)
+	}
+
+	// 音效：切片表在 3E24:0008
+	for i, v := range []uint16{0, 500, 1800, 2900, 5700, 7800, 8700, 11000, 14100, 16600, 18300} {
+		m.Write16(lin(soundData, dataSFXTab+uint16(2*i)), v)
+	}
+	for id, want := range map[uint16][2]int{0x32: {0, 500}, 0x33: {500, 1800}, 0x3B: {16600, 18300}} {
+		m.Write16(arg, id)
+		h.post(m, sndSFX)
+		got := sink.sfx[len(sink.sfx)-1]
+		if got != [3]int{int(id), want[0], want[1]} {
+			t.Fatalf("id %#x：得到 %v，應為 %v", id, got, want)
+		}
+	}
+	n := len(sink.sfx)
+	for _, bad := range []uint16{0, 0x31, 0x3C, 0xFFFF} { // 負對照：範圍外的編號
+		m.Write16(arg, bad)
+		h.post(m, sndSFX)
+	}
+	if len(sink.sfx) != n || h.Stats.BadSFX != 4 {
+		t.Fatalf("範圍外的編號不該送出：sfx=%d bad=%d", len(sink.sfx), h.Stats.BadSFX)
+	}
+	m.Write16(lin(soundData, dataSFXTab+2), 0) // 切片表壞掉（終點不大於起點）
+	m.Write16(arg, 0x32)
+	h.post(m, sndSFX)
+	if len(sink.sfx) != n || h.Stats.BadSFX != 5 {
+		t.Fatalf("終點不大於起點的切片不該送出：sfx=%d bad=%d", len(sink.sfx), h.Stats.BadSFX)
+	}
+
+	// 開始：從 3E24:01CE:01CC 讀 MidWindow bytes
+	mid := []byte("MThd\x00\x00\x00\x06\x00\x01\x00\x01\x00\x30MTrk\x00\x00\x00\x04\x00\xff\x2f\x00")
+	const mseg, moff = 0xD000, 0x5000
+	m.Write16(lin(soundData, dataMidSeg), mseg)
+	m.Write16(lin(soundData, dataMidOff), moff)
+	for i, b := range mid {
+		m.Write8(lin(mseg, moff)+uint32(i), b)
+	}
+	h.post(m, sndStart)
+	if len(sink.starts) != 1 || len(sink.starts[0]) != MidWindow || !bytes.HasPrefix(sink.starts[0], mid) {
+		t.Fatalf("MusicStart 的資料不對：%d 筆，長度 %d", len(sink.starts), len(sink.starts[0]))
+	}
+	// 交出的是複本：之後緩衝被覆寫不影響已交出的資料
+	m.Write8(lin(mseg, moff), 'X')
+	if sink.starts[0][0] != 'M' {
+		t.Fatal("MusicStart 交出的不是複本")
+	}
+	// 緩衝緊貼記憶體尾端時截短，不越界
+	m.Write16(lin(soundData, dataMidSeg), 0xFFF0)
+	m.Write16(lin(soundData, dataMidOff), 0x000F)
+	h.post(m, sndStart)
+	if got := len(sink.starts[1]); got != machine.MemSize-int(lin(0xFFF0, 0x000F)) {
+		t.Fatalf("尾端緩衝長度 %d", got)
+	}
+	if h.Stats.SkippedStarts != 0 {
+		t.Fatalf("D000:5000 與 FFF0:000F 都不與 VGA 視窗相交，SkippedStarts 應為 0，得到 %d", h.Stats.SkippedStarts)
+	}
+
+	// 與 VGA 視窗（A0000–AFFFF）相交的緩衝：略過這次 MusicStart 並計數，不用有 latch 副作用的讀取。
+	// 控制組：同一位址範圍若用 Peek8 讀會得到 0（視窗不在線性記憶體），所以不略過就會交出錯的資料。
+	for _, c := range []struct{ seg, off uint16 }{{0xA000, 0xF000}, {0xA000, 0x0000}, {0x9FFF, 0xFFF0}} {
+		before := len(sink.starts)
+		m.Write16(lin(soundData, dataMidSeg), c.seg)
+		m.Write16(lin(soundData, dataMidOff), c.off)
+		skipped := h.Stats.SkippedStarts
+		h.post(m, sndStart)
+		if len(sink.starts) != before || h.Stats.SkippedStarts != skipped+1 {
+			t.Fatalf("%04X:%04X 與 VGA 視窗相交：應略過並計數，starts %d→%d，SkippedStarts %d→%d",
+				c.seg, c.off, before, len(sink.starts), skipped, h.Stats.SkippedStarts)
+		}
+	}
+	// 緊貼視窗但不相交的緩衝仍然複製：9B1E:0000 起 0x4E20 bytes 剛好結束在 A0000（視窗之下），
+	// B000:0000 起從視窗上緣開始（視窗之上）。
+	for _, c := range []struct{ seg, off uint16 }{{0x9B1E, 0x0000}, {0xB000, 0x0000}} {
+		before := len(sink.starts)
+		m.Write16(lin(soundData, dataMidSeg), c.seg)
+		m.Write16(lin(soundData, dataMidOff), c.off)
+		h.post(m, sndStart)
+		if len(sink.starts) != before+1 || len(sink.starts[before]) != MidWindow {
+			t.Fatalf("%04X:%04X 與視窗不相交，應複製 %#x bytes", c.seg, c.off, MidWindow)
+		}
+	}
+}
