+++ b/apps/hr/sound/nullsink.go
@@ -0,0 +1,36 @@
+package sound
+
+import "math"
+
+// NullSink 是不出聲、確定性的 Sink（docs/spec/007 第 2 節與第 5.3 節）：「正在播放」的時鐘是遊戲自己的計時器
+// （Now 回傳客體的 tick 數，例如 machine.Ticks），不依賴音訊裝置與牆鐘。給機器人、長跑與測試用，
+// 讓它們走和玩家相同的遊戲路徑（不重複讀 MID、曲末後由遊戲重播）而指令軌跡可重現。
+// 只能由模擬執行緒使用。
+type NullSink struct {
+	Now func() uint64
+	// Log 非空時回報被忽略的 MID。
+	Log func(format string, args ...any)
+
+	endTick uint64
+	active  bool
+	Starts  uint64
+	SFXs    uint64
+}
+
+func (n *NullSink) MusicStart(mid []byte) {
+	song, err := ParseSMF(mid)
+	if err != nil {
+		if n.Log != nil {
+			n.Log("NullSink: MusicStart 忽略：%v", err)
+		}
+		return
+	}
+	n.Starts++
+	n.active = true
+	n.endTick = n.Now() + uint64(math.Ceil(song.Seconds()*TickHz))
+}
+
+func (n *NullSink) MusicStop()      { n.active = false }
+func (n *NullSink) MusicFade(int)   { n.active = false }
+func (n *NullSink) SFX(_, _, _ int) { n.SFXs++ }
+func (n *NullSink) Playing() bool   { return n.active && n.Now() < n.endTick }
