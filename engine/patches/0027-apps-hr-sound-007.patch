+		t.Fatal(err)
+	}
+	if pad.Seconds() < 0.99 || pad.Seconds() > 1.01 {
+		t.Fatalf("前提：曲長 %v", pad.Seconds())
+	}
+	e.MusicStart(smf(1, 48, t0, t1))
+	readFrames(e, SampleRate+SampleRate/50) // 越過曲末約 20 毫秒
+	if e.Playing() {
+		t.Fatal("曲末後 Playing 應為假")
+	}
+	if e.cur == nil || e.cur.Silent() {
+		t.Fatalf("前提：曲末後尾音應還在唱（cur＝%v）", e.cur != nil)
+	}
+	old := e.cur
+	e.MusicFade(1)
+	e.MusicStart(oneNote(48))
+	if !e.Playing() {
+		t.Fatal("新曲開始後應在播放")
+	}
+	readFrames(e, 100)
+	if e.fading || e.pending != nil {
+		t.Fatalf("曲末後的淡出應是空操作：fading＝%v pending＝%v", e.fading, e.pending != nil)
+	}
+	if e.cur == nil || e.cur == old {
+		t.Fatal("新曲應立刻成為目前曲（不是排在淡出之後）")
+	}
+	// 舊曲的尾音交給 tail 自然唱完，沒有被截斷：此刻 tail 裡仍有它
+	n := 0
+	for _, r := range e.tail {
+		if r == old {
+			n++
+		}
+	}
+	if n != 1 {
+		t.Fatalf("舊曲的尾音應在 tail 裡唱完，tail 中有 %d 份", n)
+	}
+}
+
+// 命令佇列滿（拉取者停滯）時丟掉的 MusicStart 不能讓狀態字永遠說「播放中」。
+func TestEngineDroppedStartDoesNotLeavePlayingState(t *testing.T) {
+	e := NewEngine()
+	var logs int
+	e.Log = func(string, ...any) { logs++ }
+	for i := 0; i < cmdQueue; i++ {
+		e.MusicStop() // 沒有拉取者：佇列被塞滿
+	}
+	e.MusicStart(oneNote(0))
+	if logs == 0 {
+		t.Fatal("佇列滿時應回報")
+	}
+	if e.Playing() {
+		t.Fatal("開始命令被丟棄後 Playing 不該是真")
+	}
+	// 拉取者恢復後引擎正常
+	readFrames(e, 1000)
+	e.MusicStart(oneNote(0))
+	if !e.Playing() {
+		t.Fatal("恢復後 MusicStart 應正常")
+	}
+}
+
+// SFX 不遞增世代（docs/spec/007 第 5.1 節）：播放中點一下音效，曲子到曲末仍要自然結束（Playing 變假）。
+// 若 SFX 改成遞增世代，自然結束的 CAS 會失敗，Playing() 永遠為真，遊戲不再重播這首曲子。
+func TestEngineSFXDoesNotBumpEpoch(t *testing.T) {
+	e := NewEngine()
+	e.SetPCM(bytes.Repeat([]byte{200, 60}, 2000))
+	e.MusicStart(oneNote(0)) // 1 秒
+	readFrames(e, SampleRate/4)
+	e.SFX(0x32, 0, 1000)
+	e.SFX(0x33, 0, 500)
+	if !e.Playing() {
+		t.Fatal("SFX 不該改變音樂的播放狀態")
+	}
+	readFrames(e, SampleRate) // 越過曲末
+	if e.Playing() {
+		t.Fatal("播放中呼叫過 SFX 之後，曲子到曲末仍應自然結束；Playing 仍為真代表 SFX 遞增了世代")
+	}
+}
+
+// 並行的命令洪流結束、讀取者停止後，狀態字與命令序列一致：再下的最後一個音樂命令決定 Playing()
+// （MusicStart 排進佇列算播放中；MusicStop、MusicFade 立即為假）。並行階段留下的世代或 CAS 殘留
+// 不得讓後續命令失效。
+func TestEngineConcurrentThenQuiescentStateMatchesLastCommand(t *testing.T) {
+	for _, last := range []string{"start", "stop", "fade"} {
+		e := NewEngine()
+		e.SetPCM(bytes.Repeat([]byte{200, 60}, 2000))
+		mid := oneNote(0)
+		var wg sync.WaitGroup
+		stop := make(chan struct{})
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			p := make([]byte, 4*512)
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+					e.Read(p)
+				}
+			}
+		}()
+		for i := 0; i < 200; i++ {
+			e.MusicStart(mid)
+			e.SFX(0x32, 0, 1000)
+			if i%5 == 0 {
+				e.MusicFade(1)
+			}
+		}
+		close(stop)
+		wg.Wait()
+		// 讀取者已停止，洪流結束時命令佇列可能還是滿的（負載高時讀取者被排程擠掉）；此時最後一個 MusicStart
+		// 會因佇列滿被丟棄而讓斷言偶發失敗。先 Read 一次清空佇列，再下最後一個命令。
+		readFrames(e, 1024)
+		switch last {
+		case "start":
+			e.MusicStart(mid)
+		case "stop":
+			e.MusicStop()
+		case "fade":
+			e.MusicStart(mid)
+			e.MusicFade(1)
+		}
+		if got, want := e.Playing(), last == "start"; got != want {
+			t.Errorf("最後命令 %s：Playing()=%v，應為 %v", last, got, want)
+		}
+	}
+}
