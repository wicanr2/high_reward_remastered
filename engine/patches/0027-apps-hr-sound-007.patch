+func readFrames(e *Engine, frames int) []byte {
+	p := make([]byte, 4*frames)
+	n, err := e.Read(p)
+	if err != nil || n != len(p) {
+		panic("Read")
+	}
+	return p
+}
+
+func energy(p []byte) (e float64, nonzero int) {
+	for i := 0; i+1 < len(p); i += 2 {
+		v := float64(int16(binary.LittleEndian.Uint16(p[i:])))
+		e += v * v
+		if v != 0 {
+			nonzero++
+		}
+	}
+	return
+}
+
+func en(p []byte) float64 { e, _ := energy(p); return e }
+
+func secs(s float64) int { return int(math.Round(s * SampleRate)) }
+
+func TestFadeSeconds(t *testing.T) {
+	// 每級 ceil(2n/3) 個 tick（INT 1Ch 處理常式每 tick 減 3），13 級
+	for n, want := range map[int]float64{0: 13 / TickHz, 1: 13 / TickHz, 2: 26 / TickHz, 3: 26 / TickHz, 4: 39 / TickHz} {
+		if got := FadeSeconds(n); math.Abs(got-want) > 1e-9 {
+			t.Errorf("FadeSeconds(%d)=%v，應為 %v", n, got, want)
+		}
+	}
+	if s := FadeSeconds(1); s < 0.70 || s > 0.73 {
+		t.Errorf("n=1 約 0.71 秒，得到 %v", s)
+	}
+}
