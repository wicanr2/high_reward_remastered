new file mode 100644
index 0000000..ca2de87
--- /dev/null
+++ b/apps/hr/sound/engine.go
@@ -0,0 +1,313 @@
+package sound
+
+import (
+	"math"
+	"sync/atomic"
+)
+
+// TickHz 是遊戲計時器（INT 1Ch）的名目頻率：PIT 通道 0 在預設分頻 65536 時 1193182 ÷ 65536 Hz
+// （dosgolem 的 internal/machine/pit.go 的 PITDefaultDivisor；與 runtime.TickHz 同值，各包各存一份以免互相依賴）。
+const TickHz = 18.2065
+
+// FadeSeconds 回傳 MusicFade(n) 的淡出長度（秒）。原版（有驅動、旗標為 1）的淡出是 13 級階梯，
+// 每級要等計時器 0Eh 歸零；INT 1Ch 處理常式每 tick 對每個非 0 計時器減 3（docs/re/018 第 4 節），
+// 所以每級 ceil(2n/3) 個 tick，總長 13 × ceil(2n/3) ÷ TickHz。n ＝ 1 時約 0.71 秒。
+// 等級：強推論（真機的 INT 1Ch 頻率沒有驗證）。
+func FadeSeconds(n int) float64 {
+	if n < 1 {
+		n = 1
+	}
+	return 13 * math.Ceil(2*float64(n)/3) / TickHz
+}
+
+const (
+	chunkFrames = 1024
+	sfxGain     = 0.5
+	pcmRate     = 8000
+	cmdQueue    = 64
+)
+
+type cmdKind uint8
+
+const (
+	cStart cmdKind = iota + 1
+	cStop
+	cFade
+	cSFX
+)
+
+type command struct {
+	kind  cmdKind
+	r     *Renderer
+	epoch uint64
+	n     int
+	pcm   []byte
+}
+
+// Engine 把音樂（SMF 合成）與音效（8 位元 PCM 切片）混成立體聲 16 位元小端串流。
+//
+// 執行緒模型：MusicStart、MusicStop、MusicFade、SFX、Playing 由模擬執行緒呼叫（同一時間一個呼叫者）；
+// Read 由唯一的拉取者呼叫（音訊裝置的回呼，或裝置不可用時的牆鐘拉取執行緒）。兩邊只透過一個有界命令佇列
+// 與一個原子狀態字溝通，沒有鎖；Read 不配置記憶體。
+//
+// 「正在播放」的時鐘是拉取者的取樣時鐘：自然結束發生在 Read 渲染到曲末時。所以拉取者必須以牆鐘速度持續呼叫
+// Read，即使裝置不可用或靜音（docs/spec/007 第 5 節）。
+type Engine struct {
+	cmds  chan command
+	state atomic.Uint64 // 世代 << 1 ｜ 播放中；模擬端每個命令遞增世代，音訊端只以 CAS 在世代不變時結束
+	epoch uint64        // 只有模擬端使用
+	mute  atomic.Bool
+	pcm   atomic.Pointer[[]byte]
+	// Log 非空時，被忽略的事件在這裡回報（解析失敗、音效編號不合、命令佇列滿）。呼叫端負責限速。
+	Log func(format string, args ...any)
+
+	// 以下只有 Read 的執行緒使用
+	cur       *Renderer
+	curEpoch  uint64
+	tail      [3]*Renderer
+	fading    bool
+	fadeLeft  uint64
+	fadeTotal uint64
+	pending   *Renderer
+	pendEpoch uint64
+	sfxData   []byte
+	sfxPos    float64
+	sfxOn     bool
+	tmp, mix  []float32
+}
+
+// NewEngine 建立引擎。
+func NewEngine() *Engine {
+	return &Engine{cmds: make(chan command, cmdQueue), tmp: make([]float32, chunkFrames), mix: make([]float32, chunkFrames)}
+}
+
+func (e *Engine) logf(format string, args ...any) {
+	if e.Log != nil {
+		e.Log(format, args...)
+	}
+}
+
+// SetPCM 交入 SOUND_E.PCM 的整個檔案位元組（8 位元無號、8000 Hz）。要在第一次 SFX 之前呼叫。
+func (e *Engine) SetPCM(b []byte) { e.pcm.Store(&b) }
+
+// SetMute 切換靜音：引擎照常推進，只是輸出填 0。
+func (e *Engine) SetMute(m bool) { e.mute.Store(m) }
+
+// Muted 回報是否靜音。
+func (e *Engine) Muted() bool { return e.mute.Load() }
+
+func (e *Engine) send(c command) {
+	select {
+	case e.cmds <- c:
+	default:
+		e.logf("聲音命令佇列已滿（拉取者停滯？），丟棄一個命令（種類 %d）", c.kind)
+		if c.kind == cStart {
+			// 開始命令被丟掉：不能讓狀態字一直說「播放中」（沒有人會把它結束，遊戲會永遠不重播）。
+			e.epoch++
+			e.state.Store(e.epoch << 1)
+		}
+	}
+}
+
+// MusicStart 開始播放 mid（遊戲 MID 緩衝的複本，後面可能帶有前一首的殘餘，依 SMF 結構取有效長度）。
+// 解析失敗時忽略並回報，狀態不變。淡出尚未結束時，新曲排到淡出結束後。
+func (e *Engine) MusicStart(mid []byte) {
+	song, err := ParseSMF(mid)
+	if err != nil {
+		e.logf("MusicStart 忽略：%v", err)
+		return
+	}
+	e.epoch++
+	e.state.Store(e.epoch<<1 | 1)
+	e.send(command{kind: cStart, r: NewRenderer(song), epoch: e.epoch})
+}
+
+// MusicStop 立即停止（不淡出），並取消排隊中的曲子。
+func (e *Engine) MusicStop() {
+	e.epoch++
+	e.state.Store(e.epoch << 1)
+	e.send(command{kind: cStop, epoch: e.epoch})
+}
+
+// MusicFade 開始淡出目前的曲子，長度 FadeSeconds(n) 秒。沒有曲子在播時沒有作用；已在淡出中則忽略；
+// 排隊中的曲子被丟棄。呼叫後 Playing() 立即為假（遊戲的 PlayMusic 迴圈不可阻塞）。
+func (e *Engine) MusicFade(n int) {
+	e.epoch++
+	e.state.Store(e.epoch << 1)
+	e.send(command{kind: cFade, n: n, epoch: e.epoch})
+}
+
+// SFX 播放 PCM 檔的 [start, end) 切片，取代尚未播完的舊音效。範圍不合時忽略並回報。
+func (e *Engine) SFX(id, start, end int) {
+	p := e.pcm.Load()
+	if p == nil || start < 0 || end <= start || end > len(*p) {
+		n := 0
+		if p != nil {
+			n = len(*p)
+		}
+		e.logf("SFX 忽略：id %#x 的切片 [%d,%d) 不在 PCM（%d bytes）內", id, start, end, n)
+		return
+	}
+	e.send(command{kind: cSFX, pcm: (*p)[start:end]})
+}
+
+// Playing 回報音樂是否「正在播放」：已排隊的新曲算播放中；淡出與停止立即算已停；曲子到達曲末算已停。
+func (e *Engine) Playing() bool { return e.state.Load()&1 == 1 }
+
+// --- 以下只在 Read 的執行緒 ---
+
+func (e *Engine) drain() {
+	for {
+		select {
+		case c := <-e.cmds:
+			e.apply(c)
+		default:
+			return
+		}
+	}
+}
+
+func (e *Engine) apply(c command) {
+	switch c.kind {
+	case cStart:
+		if e.fading {
+			e.pending, e.pendEpoch = c.r, c.epoch
+			return
+		}
+		e.retire(e.cur)
+		e.cur, e.curEpoch = c.r, c.epoch
+	case cStop:
+		e.retire(e.cur)
+		e.cur, e.pending, e.fading = nil, nil, false
+	case cFade:
+		e.pending = nil
+		if e.cur == nil || e.fading {
+			return
+		}
+		// 閒置：目前曲子已經自然結束（只剩尾音在唱）也算閒置。遊戲的重播節拍在曲末後下一個 tick 內
+		// 呼叫 PlayMusic，先走淡出；若這裡把尾音當成還在播而進入淡出，每次循環都會多等一段淡出才開始新曲，
+		// 而原版沒有這個空檔（docs/spec/007 第 4 節第 2 點）。尾音交給 retire 自然唱完。
+		if e.cur.SongDone() {
+			e.retire(e.cur)
+			e.cur = nil
+			return
+		}
+		e.fading = true
+		e.fadeTotal = uint64(FadeSeconds(c.n) * SampleRate)
+		e.fadeLeft = e.fadeTotal
+	case cSFX:
+		e.sfxData, e.sfxPos, e.sfxOn = c.pcm, 0, true
+	}
+}
+
+// retire 讓被取代或停止的曲子的尾音唱完。
+func (e *Engine) retire(r *Renderer) {
+	if r == nil {
+		return
+	}
+	r.ReleaseAll()
+	if r.Silent() {
+		return
+	}
+	copy(e.tail[:], e.tail[1:])
+	e.tail[len(e.tail)-1] = r
+}
+
+// Read 填滿 p（立體聲 16 位元小端，每個取樣框 4 bytes），永不回傳錯誤；p 的長度不是 4 的倍數時只填到整數個框。
+func (e *Engine) Read(p []byte) (int, error) {
+	frames := len(p) / 4
+	off := 0
+	for frames > 0 {
+		e.drain()
+		n := frames
+		if n > chunkFrames {
+			n = chunkFrames
+		}
+		mix := e.mix[:n]
+		for i := range mix {
+			mix[i] = 0
+		}
+		e.renderChunk(mix)
+		muted := e.mute.Load()
+		for i := 0; i < n; i++ {
+			var s int16
+			if !muted {
+				s = int16(softClip(mix[i]) * 32000)
+			}
+			p[off], p[off+1], p[off+2], p[off+3] = byte(s), byte(s>>8), byte(s), byte(s>>8)
+			off += 4
+		}
+		frames -= n
+	}
+	return off, nil
+}
+
+func (e *Engine) renderChunk(mix []float32) {
+	n := len(mix)
+	tmp := e.tmp[:n]
+	if e.cur != nil {
+		for i := range tmp {
+			tmp[i] = 0
+		}
+		e.cur.Render(tmp)
+		if e.fading {
+			for i := range tmp {
+				var g float32
+				if e.fadeLeft > 0 {
+					g = float32(e.fadeLeft) / float32(e.fadeTotal)
+					e.fadeLeft--
+				}
+				mix[i] += tmp[i] * g
+			}
+			if e.fadeLeft == 0 {
+				e.fading, e.cur = false, nil
+				if e.pending != nil {
+					e.cur, e.curEpoch = e.pending, e.pendEpoch
+					e.pending = nil
+				}
+			}
+		} else {
+			for i := range tmp {
+				mix[i] += tmp[i]
+			}
+			if e.cur.SongDone() {
+				// 世代沒變才結束；期間若模擬端又下了命令，狀態字的世代已不同，CAS 失敗，不誤清新曲的狀態
+				e.state.CompareAndSwap(e.curEpoch<<1|1, e.curEpoch<<1)
+				if e.cur.Silent() {
+					e.cur = nil
+				}
+			}
+		}
+	}
+	for k := range e.tail {
+		r := e.tail[k]
+		if r == nil {
+			continue
+		}
+		for i := range tmp {
+			tmp[i] = 0
+		}
+		r.Render(tmp)
+		for i := range tmp {
+			mix[i] += tmp[i]
+		}
+		if r.Silent() {
+			e.tail[k] = nil
+		}
+	}
+	if e.sfxOn {
+		d := e.sfxData
+		for i := 0; i < n; i++ {
+			ip := int(e.sfxPos)
+			if ip >= len(d)-1 {
+				e.sfxOn = false
+				break
+			}
+			fr := float32(e.sfxPos - float64(ip))
+			a := (float32(d[ip]) - 128) / 128
+			b := (float32(d[ip+1]) - 128) / 128
+			mix[i] += (a + (b-a)*fr) * sfxGain
+			e.sfxPos += pcmRate / float64(SampleRate)
+		}
+	}
+}
