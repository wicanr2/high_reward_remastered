@@ -0,0 +1,121 @@
+package runtime
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// 存檔 A/B（docs/re/019 第 7 節、docs/spec/007 第 8 節）：
+// 聲音掛鉤不得改變遊戲寫出的存檔。腳本與 TestSaveGoesToScratchAndLeavesOriginalAlone 相同
+// （讀取槽 0、開系統選單、存入槽 2），分別在「沒有 Sink」與「Playing() 恆假的 Sink」下跑一次。
+// 恆假的 Sink 讓遊戲走和無 Sink 相同的路徑（重複讀 MID），所以兩次的指令軌跡一致，存檔應逐位元相同。
+// 跟隨型 Sink 會讓遊戲少讀檔而改變 tick 數，那是合理的差異，不在這個測試比較。
+
+func saveScenario(t *testing.T, sink SoundSink) (g2, fname []byte, st SoundStats) {
+	t.Helper()
+	root := origRoot(t)
+	saves := t.TempDir()
+	opt := Options{Interval: NativeInterval, SaveDir: saves}
+	if sink != nil {
+		opt.Sound = sink
+	}
+	s, err := Open(root, opt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	click := func(at uint64, x, y int) { // x、y 是 640x480 畫面座標
+		if r := s.RunSteps(at); r.Kind != StopSteps {
+			t.Fatalf("提前停機：%v", r)
+		}
+		s.Input(Event{Kind: EvMouseButton, X: x, Y: y - 40, Btn: 0, Down: true})
+		s.Input(Event{Kind: EvMouseButton, X: x, Y: y - 40, Btn: 0, Down: false})
+	}
+	click(35_000_000, 312, 228)  // 標題：讀取遊戲檔案
+	click(90_000_000, 312, 307)  // 槽 0
+	click(205_000_000, 615, 64)  // 地圖：筆圖示，系統選單
+	click(215_000_000, 560, 130) // 檔案存入
+	click(225_000_000, 312, 341) // 槽 2
+	if r := s.RunSteps(246_000_000); r.Kind != StopSteps {
+		t.Fatalf("提前停機：%v", r)
+	}
+	read := func(name string) []byte {
+		ents, _ := os.ReadDir(saves)
+		for _, e := range ents {
+			if strings.EqualFold(e.Name(), name) {
+				b, err := os.ReadFile(filepath.Join(saves, e.Name()))
+				if err != nil {
+					t.Fatal(err)
+				}
+				return b
+			}
+		}
+		t.Fatalf("暫存層沒有 %s", name)
+		return nil
+	}
+	g2, fname = read("GAMEFILE.002"), read("FNAME.DAT")
+	if sink != nil {
+		st = s.Sound()
+	}
+	return
+}
+
+// diffBytes 回傳兩份資料不同的位移（最多 maxN 個）與長度是否相同。比較器本身由下面的自測驗證。
+func diffBytes(a, b []byte, maxN int) (offs []int, sameLen bool) {
+	sameLen = len(a) == len(b)
+	n := len(a)
+	if len(b) < n {
+		n = len(b)
+	}
+	for i := 0; i < n && len(offs) < maxN; i++ {
+		if a[i] != b[i] {
+			offs = append(offs, i)
+		}
+	}
+	return
+}
+
+// 比較器自測（偵測器要先證明會報警）：翻轉一個位元組必須被找到，長度不同必須被報告。
+func TestSaveDiffDetectorSelfTest(t *testing.T) {
+	a := bytes.Repeat([]byte{0x5A}, 1000)
+	b := append([]byte(nil), a...)
+	if offs, same := diffBytes(a, b, 8); len(offs) != 0 || !same {
+		t.Fatalf("相同資料不該報差異：%v %v", offs, same)
+	}
+	b[617] ^= 0x01
+	if offs, _ := diffBytes(a, b, 8); len(offs) != 1 || offs[0] != 617 {
+		t.Fatalf("翻轉一個位元組必須被找到：%v", offs)
+	}
+	if _, same := diffBytes(a, a[:999], 8); same {
+		t.Fatal("長度不同必須被報告")
+	}
+}
+
+func TestSoundDoesNotChangeSaves(t *testing.T) {
+	if testing.Short() {
+		t.Skip("-short")
+	}
+	gA, fA, _ := saveScenario(t, nil)
+	sink := &fakeSink{}
+	gB, fB, st := saveScenario(t, sink)
+	if st.Starts == 0 || st.Queries == 0 {
+		t.Fatalf("掛鉤開著卻沒有觀察到呼叫，測試沒有鑑別力：%+v", st)
+	}
+	if len(gA) == 0 || len(fA) == 0 {
+		t.Fatal("存檔是空的")
+	}
+	for _, c := range []struct {
+		name string
+		a, b []byte
+	}{{"GAMEFILE.002", gA, gB}, {"FNAME.DAT", fA, fB}} {
+		offs, same := diffBytes(c.a, c.b, 16)
+		if !same || len(offs) != 0 {
+			t.Errorf("%s 不同：長度 %d 對 %d，前幾個不同位移 %s", c.name, len(c.a), len(c.b), fmt.Sprint(offs))
+		}
+	}
+	t.Logf("存檔 A/B：GAMEFILE.002 %d bytes、FNAME.DAT %d bytes 逐位元相同；B 的 Starts=%d Stops=%d Fades=%d SFX=%d Queries=%d",
+		len(gA), len(fA), st.Starts, st.Stops, st.Fades, st.SFX, st.Queries)
+}
