+++ b/apps/hr/sound/synth.go
@@ -0,0 +1,555 @@
+package sound
+
+import "math"
+
+// 合成核心：雙運算元 FM 的旋律聲部，加上五種合成打擊樂。不使用隨機數與牆上時鐘，
+// 同一組建下相同輸入得到逐位元相同的輸出（打擊樂雜訊用固定種子的線性同餘產生器）。
+
+const (
+	// SampleRate 是引擎的輸出取樣率。
+	SampleRate = 44100
+	maxVoices  = 24
+	maxDrums   = 8
+	sineN      = 4096
+	// masterGain 在驗收之前固定為 0.30，不用離線轉檔的峰值反推（docs/spec/007 第 5.1 節）。
+	masterGain = 0.30
+)
+
+var sineTab [3][sineN + 1]float32
+
+func init() {
+	for i := 0; i <= sineN; i++ {
+		s := math.Sin(2 * math.Pi * float64(i) / sineN)
+		sineTab[0][i] = float32(s)
+		sineTab[1][i] = float32(math.Max(s, 0))
+		sineTab[2][i] = float32(math.Abs(s))
+	}
+}
+
+// wave 查表取波形。phase 的單位是圈（可以是任何實數）。
+func wave(w uint8, phase float32) float32 {
+	p := phase - float32(math.Floor(float64(phase)))
+	f := p * sineN
+	i := int(f)
+	if i >= sineN {
+		i = sineN - 1
+	}
+	fr := f - float32(i)
+	a := sineTab[w][i]
+	return a + (sineTab[w][i+1]-a)*fr
+}
+
+type envCoef struct{ aStep, dCoef, sl, sCoef, rCoef float32 }
+
+func makeEnvCoef(e envSpec, scale float32) envCoef {
+	a := e.A
+	if a < 0.0005 {
+		a = 0.0005
+	}
+	d := e.D * scale
+	if d < 0.002 {
+		d = 0.002
+	}
+	r := e.R
+	if r < 0.005 {
+		r = 0.005
+	}
+	c := envCoef{
+		aStep: float32(1 / (float64(a) * SampleRate)),
+		dCoef: float32(math.Exp(-3 / (float64(d) * SampleRate))),
+		sl:    e.S,
+		sCoef: 1,
+		rCoef: float32(math.Exp(-5 / (float64(r) * SampleRate))),
+	}
+	if e.SD > 0 {
+		c.sCoef = float32(math.Exp(-3 / (float64(e.SD*scale) * SampleRate)))
+	}
+	return c
+}
+
+const (
+	stAttack = iota
+	stDecay
+	stSustain
+	stRelease
+	stDone
+)
+
+const envFloor = 0.0003
+
+type envState struct {
+	stage uint8
+	lvl   float32
+}
+
+func (e *envState) step(c *envCoef) float32 {
+	switch e.stage {
+	case stAttack:
+		e.lvl += c.aStep
+		if e.lvl >= 1 {
+			e.lvl = 1
+			e.stage = stDecay
+		}
+	case stDecay:
+		if c.sl <= 0 {
+			e.lvl *= c.dCoef
+			if e.lvl < envFloor {
+				e.lvl, e.stage = 0, stDone
+			}
+		} else {
+			e.lvl = c.sl + (e.lvl-c.sl)*c.dCoef
+			if e.lvl-c.sl < 0.002 {
+				e.stage = stSustain
+			}
+		}
+	case stSustain:
+		e.lvl *= c.sCoef
+		if e.lvl < envFloor {
+			e.lvl, e.stage = 0, stDone
+		}
+	case stRelease:
+		e.lvl *= c.rCoef
+		if e.lvl < envFloor {
+			e.lvl, e.stage = 0, stDone
+		}
+	}
+	return e.lvl
+}
+
+func (e *envState) release() {
+	if e.stage != stRelease && e.stage != stDone {
+		e.stage = stRelease
+	}
+}
+
+type voice struct {
+	active      bool
+	ch, note    uint8
+	age         uint64
+	p           *patch
+	cPhase      float32
+	mPhase      float32
+	cInc, mInc  float32
+	idx         float32 // 調變指數（圈），Add 時為混入音量
+	fb          float32
+	fbPrev      float32
+	amp         float32
+	mEnv, cEnv  envState
+	mC, cC      envCoef
+	lfo, lfoInc float32
+	vibDelay    int
+	vibDepth    float32
+	released    bool
+	modW, carW  uint8
+	add         bool
+	vibratoOn   bool
+}
+
+func (v *voice) start(p *patch, note, vel uint8, age uint64) {
+	f := 440 * math.Pow(2, (float64(note)-69)/12)
+	scale := float32(1)
+	if p.KeyScale != 0 {
+		scale = float32(math.Pow(2, -float64(p.KeyScale)*(float64(note)-60)/12))
+	}
+	vf := float32(vel) / 127
+	*v = voice{
+		active: true, note: note, age: age, p: p,
+		cInc: float32(f * float64(p.CarMult) / SampleRate),
+		mInc: float32(f * float64(p.ModMult) / SampleRate),
+		fb:   p.Fb / (2 * math.Pi),
+		amp:  p.Gain * (0.35 + 0.65*vf),
+		mC:   makeEnvCoef(p.Mod, scale),
+		cC:   makeEnvCoef(p.Car, scale),
+		modW: p.ModWave, carW: p.CarWave, add: p.Add,
+	}
+	if v.mInc > 0.49 {
+		v.mInc = 0.49
+	}
+	if v.cInc > 0.49 {
+		v.cInc = 0.49
+	}
+	bright := 1 - p.VelBright + p.VelBright*vf
+	if p.Add {
+		v.idx = p.Index * bright
+	} else {
+		v.idx = p.Index / (2 * math.Pi) * bright
+	}
+	if p.Vib.Cents != 0 {
+		v.vibratoOn = true
+		v.lfoInc = p.Vib.Rate / SampleRate
+		v.vibDelay = int(p.Vib.Delay * SampleRate)
+		v.vibDepth = p.Vib.Cents * 0.0005776
+	}
+}
+
+func (v *voice) release() {
+	v.released = true
+	v.mEnv.release()
+	v.cEnv.release()
+}
+
+func (v *voice) next() float32 {
+	mul := float32(1)
+	if v.vibratoOn {
+		if v.vibDelay > 0 {
+			v.vibDelay--
+		} else {
+			v.lfo += v.lfoInc
+			if v.lfo >= 1 {
+				v.lfo--
+			}
+			mul = 1 + v.vibDepth*wave(0, v.lfo)
+		}
+	}
+	me := v.mEnv.step(&v.mC)
+	ce := v.cEnv.step(&v.cC)
+	mo := wave(v.modW, v.mPhase+v.fb*v.fbPrev) * me
+	v.fbPrev = mo
+	var out float32
+	if v.add {
+		out = wave(v.carW, v.cPhase)*ce + mo*v.idx
+	} else {
+		out = wave(v.carW, v.cPhase+mo*v.idx) * ce
+	}
+	v.mPhase += v.mInc * mul
+	if v.mPhase >= 1 {
+		v.mPhase--
+	}
+	v.cPhase += v.cInc * mul
+	if v.cPhase >= 1 {
+		v.cPhase--
+	}
+	if v.cEnv.stage == stDone {
+		v.active = false
+	}
+	return out * v.amp
+}
+
+// 打擊樂：全部由合成產生，參數見 drumKinds。
+type drumKind uint8
+
+const (
+	drKick drumKind = iota
+	drSnare
+	drTom
+	drHatClosed
+	drHatOpen
+	drCrash
+)
+
+type drumVoice struct {
+	active  bool
+	kind    drumKind
+	n       uint32 // 已產生的取樣數
+	phase   float32
+	f0, f1  float32 // 起始與結束頻率（Hz）
+	tf      float32 // 頻率衰減時間常數（取樣）
+	env     float32
+	envCoef float32
+	toneAmp float32
+	noiseA  float32
+	click   float32
+	hp      float32
+	lp      float32
+	amp     float32
+	age     uint64
+	maxN    uint32
+}
+
+func coefFor(tau float64) float32 { return float32(math.Exp(-1 / (tau * SampleRate))) }
+
+func (d *drumVoice) start(note, vel uint8, age uint64) {
+	vf := float32(vel) / 127
+	*d = drumVoice{active: true, age: age, env: 1, amp: 0.45 + 0.55*vf}
+	switch {
+	case note == 35 || note == 36:
+		d.kind = drKick
+		d.f0, d.f1, d.tf = 150, 48, 0.03*SampleRate
+		d.envCoef = coefFor(0.16)
+		d.toneAmp, d.noiseA, d.click = 1.0, 0, 0.35
+		d.maxN = SampleRate / 2
+	case note == 37 || note == 38 || note == 39 || note == 40:
+		d.kind = drSnare
+		d.f0, d.f1, d.tf = 220, 175, 0.02*SampleRate
+		d.envCoef = coefFor(0.07)
+		d.toneAmp, d.noiseA = 0.45, 0.85
+		d.hp = 0.35
+		d.maxN = SampleRate * 4 / 10
+	case note == 41 || note == 43 || note == 45 || note == 47 || note == 48 || note == 50:
+		d.kind = drTom
+		sc := float32(math.Pow(2, (float64(note)-45)/12))
+		d.f0, d.f1, d.tf = 170*sc, 95*sc, 0.05*SampleRate
+		d.envCoef = coefFor(0.20)
+		d.toneAmp = 1.0
+		d.maxN = SampleRate * 6 / 10
+	case note == 42 || note == 44:
+		d.kind = drHatClosed
+		d.envCoef = coefFor(0.03)
+		d.noiseA, d.hp = 0.6, 0.92
+		d.maxN = SampleRate / 5
+	case note == 46 || note == 51 || note == 53 || note == 59:
+		d.kind = drHatOpen
+		d.envCoef = coefFor(0.14)
+		d.noiseA, d.hp = 0.6, 0.90
+		d.maxN = SampleRate * 7 / 10
+	case note == 49 || note == 52 || note == 55 || note == 57:
+		d.kind = drCrash
+		d.envCoef = coefFor(0.55)
+		d.noiseA, d.hp = 0.7, 0.88
+		d.f0, d.f1, d.tf = 520, 520, 1
+		d.toneAmp = 0.12
+		d.maxN = SampleRate * 2
+	default:
+		d.kind = drHatClosed
+		d.envCoef = coefFor(0.04)
+		d.noiseA, d.hp = 0.5, 0.9
+		d.maxN = SampleRate / 4
+	}
+}
+
+func (d *drumVoice) next(rng *uint32) float32 {
+	var out float32
+	if d.toneAmp != 0 {
+		fr := d.f1 + (d.f0-d.f1)*float32(math.Exp(-float64(d.n)/float64(d.tf)))
+		d.phase += fr / SampleRate
+		if d.phase >= 1 {
+			d.phase--
+		}
+		out += wave(0, d.phase) * d.toneAmp
+	}
+	if d.noiseA != 0 || d.click != 0 {
+		*rng = *rng*1664525 + 1013904223
+		nz := float32(int32(*rng)) / 2147483648
+		if d.hp > 0 {
+			// 一階高通：減去低通
+			d.lp += (1 - d.hp) * (nz - d.lp)
+			nz -= d.lp
+		}
+		out += nz * d.noiseA
+		if d.click != 0 && d.n < 200 {
+			out += nz * d.click * (1 - float32(d.n)/200)
+		}
+	}
+	out *= d.env * d.amp
+	d.env *= d.envCoef
+	d.n++
+	if d.n >= d.maxN || d.env < envFloor {
+		d.active = false
+	}
+	return out
+}
+
+// Renderer 是一首曲子的播放狀態。Render 把這首曲子的單聲道輸出「加到」dst。
+type Renderer struct {
+	song   *Song
+	pos    []uint64
+	endPos uint64
+	next   int
+	cur    uint64
+	prog   [16]uint8
+	vol    [16]uint8
+	seq    uint64
+	rng    uint32
+	voices [maxVoices]voice
+	drums  [maxDrums]drumVoice
+
+	// Steals 是聲部不夠而取代發聲中聲部的次數（驗收：原曲為 0）。
+	Steals uint64
+	// OnEvent 非 nil 時，每個事件送出時以送出的取樣位置呼叫（測試與驗收用；正式播放不設）。
+	OnEvent func(e *Event, sample uint64)
+}
+
+// NewRenderer 以 SampleRate 準備播放 s。
+func NewRenderer(s *Song) *Renderer {
+	r := &Renderer{song: s, rng: 0x1234abcd}
+	r.pos, r.endPos = s.sampleTimes(SampleRate)
+	for i := range r.vol {
+		r.vol[i] = 100 // General MIDI 的預設音量
+	}
+	return r
+}
+
+// SongDone 是所有事件都已送出且已到曲末。尾音（釋放階段）可能仍在發聲，另見 Silent。
+func (r *Renderer) SongDone() bool { return r.next >= len(r.song.Events) && r.cur >= r.endPos }
+
+// Silent 是沒有任何聲部在發聲。
+func (r *Renderer) Silent() bool {
+	for i := range r.voices {
+		if r.voices[i].active {
+			return false
+		}
+	}
+	for i := range r.drums {
+		if r.drums[i].active {
+			return false
+		}
+	}
+	return true
+}
+
+// ReleaseAll 讓所有聲部進入釋放階段，並丟掉尚未送出的事件。
+func (r *Renderer) ReleaseAll() {
+	r.next = len(r.song.Events)
+	for i := range r.voices {
+		if r.voices[i].active {
+			r.voices[i].release()
+		}
+	}
+}
+
+func (r *Renderer) noteOn(ch, note, vel uint8) {
+	r.seq++
+	if ch == 9 {
+		slot := -1
+		var oldest uint64 = math.MaxUint64
+		for i := range r.drums {
+			if !r.drums[i].active {
+				slot = i
+				break
+			}
+			if r.drums[i].age < oldest {
+				oldest, slot = r.drums[i].age, i
+			}
+		}
+		r.drums[slot].start(note, vel, r.seq)
+		return
+	}
+	slot := -1
+	for i := range r.voices {
+		if !r.voices[i].active {
+			slot = i
+			break
+		}
+	}
+	if slot < 0 {
+		r.Steals++
+		// 先取最小聲的釋放中聲部，其次取最舊的
+		quiet := float32(2)
+		for i := range r.voices {
+			v := &r.voices[i]
+			if v.released && v.cEnv.lvl < quiet {
+				quiet, slot = v.cEnv.lvl, i
+			}
+		}
+		if slot < 0 {
+			var oldest uint64 = math.MaxUint64
+			for i := range r.voices {
+				if r.voices[i].age < oldest {
+					oldest, slot = r.voices[i].age, i
+				}
+			}
+		}
+	}
+	r.voices[slot].start(patchFor(r.prog[ch]), note, vel, r.seq)
+	r.voices[slot].ch = ch
+}
+
+func (r *Renderer) noteOff(ch, note uint8) {
+	if ch == 9 {
+		return // 打擊樂自己衰減
+	}
+	best := -1
+	var oldest uint64 = math.MaxUint64
+	for i := range r.voices {
+		v := &r.voices[i]
+		if v.active && !v.released && v.ch == ch && v.note == note && v.age < oldest {
+			oldest, best = v.age, i
+		}
+	}
+	if best >= 0 {
+		r.voices[best].release()
+	}
+}
+
+func (r *Renderer) dispatch(e *Event) {
+	switch e.Kind {
+	case NoteOn:
+		r.noteOn(e.Ch, e.A, e.B)
+	case NoteOff:
+		r.noteOff(e.Ch, e.A)
+	case Program:
+		r.prog[e.Ch&15] = e.A
+	case Volume:
+		r.vol[e.Ch&15] = e.A
+	}
+}
+
+var chanGain [128]float32
+
+func init() {
+	for i := range chanGain {
+		g := float32(i) / 127
+		chanGain[i] = g * g
+	}
+}
+
+// Render 把輸出加到 dst（單聲道，SampleRate）。
+func (r *Renderer) Render(dst []float32) {
+	evs := r.song.Events
+	for i := range dst {
+		for r.next < len(evs) && r.pos[r.next] <= r.cur {
+			if r.OnEvent != nil {
+				r.OnEvent(&evs[r.next], r.cur)
+			}
+			r.dispatch(&evs[r.next])
+			r.next++
+		}
+		var sum float32
+		for j := range r.voices {
+			v := &r.voices[j]
+			if v.active {
+				sum += v.next() * chanGain[r.vol[v.ch&15]]
+			}
+		}
+		for j := range r.drums {
+			d := &r.drums[j]
+			if d.active {
+				sum += d.next(&r.rng) * chanGain[r.vol[9]]
+			}
+		}
+		dst[i] += sum * masterGain
+		r.cur++
+	}
+}
+
+// softClip 是 tanh 的有理近似，輸入夾在 ±3，輸出落在 ±1。
+func softClip(x float32) float32 {
+	if x >= 3 {
+		return 1
+	}
+	if x <= -3 {
+		return -1
+	}
+	x2 := x * x
+	return x * (27 + x2) / (27 + 9*x2)
+}
+
+// RenderSongRaw 離線轉出整首曲子（含尾音，最多多 3 秒），單聲道 float32，SampleRate，不經限幅。
+// 同時回傳渲染器，供驗收讀 Steals。
+func RenderSongRaw(s *Song, hook func(*Event, uint64)) ([]float32, *Renderer) {
+	r := NewRenderer(s)
+	r.OnEvent = hook
+	total := int(r.endPos) + 3*SampleRate
+	out := make([]float32, 0, total)
+	buf := make([]float32, 1024)
+	for len(out) < total {
+		for i := range buf {
+			buf[i] = 0
+		}
+		r.Render(buf)
+		out = append(out, buf...)
+		if r.SongDone() && r.Silent() {
+			break
+		}
+	}
+	return out, r
+}
+
+// RenderSong 是 RenderSongRaw 加上限幅（與 Engine 輸出相同的路徑）。供驗證與 hrmusic 使用。
+func RenderSong(s *Song) []float32 {
+	out, _ := RenderSongRaw(s, nil)
+	for i := range out {
+		out[i] = softClip(out[i])
+	}
+	return out
+}
