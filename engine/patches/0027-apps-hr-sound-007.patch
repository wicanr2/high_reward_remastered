+// 原曲實際用到的 22 個音色（0 起算）。
+var explicitPatches = map[uint8]*patch{
+	0: &pPiano, 13: &pXylo, 16: &pOrgan, 34: &pEBass, 35: &pFBass,
+	48: &pStrings, 50: &pSynStr, 51: &pSynStr2, 53: &pVoice, 55: &pHit,
+	56: &pBrass, 58: &pTuba, 73: &pFlute, 83: &pLead4, 84: &pLead5,
+	86: &pLead7, 89: &pPadWarm, 91: &pPadChoir, 93: &pPadMetal, 94: &pPadHalo,
+	96: &pRain, 112: &pBell,
+}
