index 0000000..7be2cb8
--- /dev/null
+++ b/apps/hr/cmd/hrmusic/main.go
@@ -0,0 +1,415 @@
+// hrmusic 把原版的 MID 離線轉成 WAV 並做獨立驗收（docs/spec/007 第 8 節）。
+//
+//	hrmusic -dir <原版目錄> -out <WAV 輸出目錄> [-expect midisum.tsv] [-check]
+//
+// -expect 是 tools/music/midisum.go 的輸出（獨立於本套件解析器的第二份實作）：
+// 逐檔核對音符數與曲長。其餘判準都來自 SMF 本身（哪個時間窗內有音符在響），不依賴合成器的內部參數。
+// -check 時任何一項不合就以非零結束。
+// 輸出的 WAV 是原版音樂的衍生物，只能放在 gitignore 的位置，不得提交或進發行包。
+package main
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"flag"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/wicanr2/dosgolem/apps/hr/sound"
+)
+
+type expect struct {
+	notes int
+	secs  float64
+}
+
+func readExpect(path string) (map[string]expect, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	m := map[string]expect{}
+	sc := bufio.NewScanner(f)
+	sc.Scan() // 標題列
+	for sc.Scan() {
+		c := strings.Split(sc.Text(), "\t")
+		if len(c) < 6 {
+			continue
+		}
+		n, err1 := strconv.Atoi(c[3])
+		s, err2 := strconv.ParseFloat(c[5], 64)
+		if err1 != nil || err2 != nil {
+			continue // 0 byte 的檔
+		}
+		m[c[0]] = expect{n, s}
+	}
+	return m, sc.Err()
+}
+
+func writeWAV(path string, pcm []int16, rate int) error {
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	w := bufio.NewWriter(f)
+	n := uint32(len(pcm) * 2)
+	w.WriteString("RIFF")
+	binary.Write(w, binary.LittleEndian, 36+n)
+	w.WriteString("WAVEfmt ")
+	binary.Write(w, binary.LittleEndian, uint32(16))
+	binary.Write(w, binary.LittleEndian, uint16(1))
+	binary.Write(w, binary.LittleEndian, uint16(1))
+	binary.Write(w, binary.LittleEndian, uint32(rate))
+	binary.Write(w, binary.LittleEndian, uint32(rate*2))
+	binary.Write(w, binary.LittleEndian, uint16(2))
+	binary.Write(w, binary.LittleEndian, uint16(16))
+	w.WriteString("data")
+	binary.Write(w, binary.LittleEndian, n)
+	binary.Write(w, binary.LittleEndian, pcm)
+	return w.Flush()
+}
+
+const winSamples = sound.SampleRate / 20 // 50 ms
+
+// audibleHead：每個音符起音後這麼久之內必須聽得到。打擊類音色（木琴、鈴）本來就會在音符結束前衰減完，
+// 所以不要求整個音長都有聲音；持續音是否持續由 sound 套件的單元測試（休止與音符時段）負責。
+const audibleHead = sound.SampleRate * 300 / 1000
+
+func minU(a, b uint64) uint64 {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+// activity 由事件算出每個 50 ms 窗內的音符數，與合成器無關：
+//   - head：只算每個音符起音後 audibleHead 以內（打擊樂以起音後 150 ms 計）。該窗必須聽得到。
+//   - held：算音符的整個音長（note-on 到 note-off）。用來和能量做相關。
+//
+// 另回傳最後一個音符結束的取樣位置。
+func activity(s *sound.Song, n int) (head, held []int, lastEnd uint64) {
+	type key struct{ ch, note uint8 }
+	started := map[key][]uint64{}
+	dh := make([]int, n/winSamples+3)
+	dl := make([]int, n/winSamples+3)
+	addTo := func(diff []int, a, b uint64) {
+		if b <= a {
+			b = a + 1
+		}
+		i, j := int(a/winSamples), int((b-1)/winSamples)
+		if i >= len(diff)-1 {
+			return
+		}
+		if j >= len(diff)-1 {
+			j = len(diff) - 2
+		}
+		diff[i]++
+		diff[j+1]--
+	}
+	note := func(a, b uint64) {
+		addTo(dh, a, minU(b, a+audibleHead))
+		addTo(dl, a, b)
+		if b > lastEnd {
+			lastEnd = b
+		}
+	}
+	_, _ = sound.RenderSongRaw(s, func(e *sound.Event, at uint64) {
+		k := key{e.Ch, e.A}
+		switch e.Kind {
+		case sound.NoteOn:
+			if e.Ch == 9 {
+				note(at, at+sound.SampleRate*150/1000)
+				return
+			}
+			started[k] = append(started[k], at)
+		case sound.NoteOff:
+			if e.Ch == 9 {
+				return
+			}
+			if st := started[k]; len(st) > 0 {
+				note(st[0], at)
+				started[k] = st[1:]
+			}
+		}
+	})
+	for _, st := range started { // 沒有 note-off 的音符：到曲末
+		for _, a := range st {
+			note(a, uint64(n))
+		}
+	}
+	cum := func(d []int) []int {
+		out := make([]int, n/winSamples+1)
+		c := 0
+		for i := range out {
+			c += d[i]
+			out[i] = c
+		}
+		return out
+	}
+	return cum(dh), cum(dl), lastEnd
+}
+
+func main() {
+	dir := flag.String("dir", "", "原版目錄（唯讀）")
+	out := flag.String("out", "", "WAV 輸出目錄（空表示不寫）")
+	exp := flag.String("expect", "", "midisum.tsv")
+	check := flag.Bool("check", false, "有任何一項不合就非零結束")
+	only := flag.String("only", "", "只處理這些檔（逗號分隔，不含副檔名，例如 BATTLE1,SCOUT）")
+	flag.BoolVar(&pitchDebug, "pitch-debug", false, "印出基頻抽查不符的音符")
+	flag.Parse()
+	if *dir == "" {
+		fmt.Fprintln(os.Stderr, "需要 -dir")
+		os.Exit(2)
+	}
+	var want map[string]expect
+	if *exp != "" {
+		var err error
+		if want, err = readExpect(*exp); err != nil {
+			fmt.Fprintln(os.Stderr, "讀 -expect 失敗：", err)
+			os.Exit(2)
+		}
+	}
+	ents, err := os.ReadDir(*dir)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	var names []string
+	for _, e := range ents {
+		if strings.EqualFold(filepath.Ext(e.Name()), ".mid") {
+			names = append(names, e.Name())
+		}
+	}
+	sort.Strings(names)
+	if *only != "" {
+		keep := map[string]bool{}
+		for _, n := range strings.Split(*only, ",") {
+			keep[strings.ToUpper(strings.TrimSpace(n))] = true
+		}
+		var sel []string
+		for _, n := range names {
+			if keep[strings.ToUpper(strings.TrimSuffix(n, filepath.Ext(n)))] {
+				sel = append(sel, n)
+			}
+		}
+		names = sel
+	}
+	if *out != "" {
+		os.MkdirAll(*out, 0o755)
+	}
+	fmt.Println("name\tparsed_s\texpect_s\trendered_s\tnoteon\texpect_noteon\tpeak\trms\tnear_clip\tsteals\tcorr\tactive_ok%\tpitch_ok\tpitch_bad_ok\tengine_eq\twav_sha256_16")
+	bad := 0
+	for _, n := range names {
+		base := strings.ToUpper(strings.TrimSuffix(n, filepath.Ext(n)))
+		b, err := os.ReadFile(filepath.Join(*dir, n))
+		if err != nil {
+			fmt.Printf("%s\tERR\t%v\n", base, err)
+			bad++
+			continue
+		}
+		if len(b) == 0 {
+			fmt.Printf("%s\t0 byte，略過（遊戲讀 0 byte 後沿用上一首的緩衝）\n", base)
+			continue
+		}
+		s, err := sound.ParseSMF(b)
+		if err != nil {
+			fmt.Printf("%s\t解析失敗\t%v\n", base, err)
+			bad++
+			continue
+		}
+		var notes int
+		for _, e := range s.Events {
+			if e.Kind == sound.NoteOn {
+				notes++
+			}
+		}
+		parsed := float64(s.Duration(sound.SampleRate)) / sound.SampleRate
+		endSample := s.Duration(sound.SampleRate)
+		raw, rend := sound.RenderSongRaw(s, nil)
+		f := sound.RenderSong(s)
+		f2 := sound.RenderSong(s)
+		same := len(f) == len(f2)
+		for i := 0; same && i < len(f); i++ {
+			same = f[i] == f2[i]
+		}
+		hh := sha256.New()
+		pcm := make([]int16, len(f))
+		var peak, sum float64
+		nearClip := 0
+		for i, v := range f {
+			a := math.Abs(float64(v))
+			if a > peak {
+				peak = a
+			}
+			if a > 0.99 {
+				nearClip++
+			}
+			sum += float64(v) * float64(v)
+			pcm[i] = int16(v * 32000)
+		}
+		binary.Write(hh, binary.LittleEndian, pcm)
+		rms := math.Sqrt(sum / float64(len(f)))
+		// 50 ms 窗：RMS 與 SMF 算出的活動音符數
+		act, held, lastEnd := activity(s, len(raw))
+		nw := len(act)
+		wr := make([]float64, nw)
+		for w := 0; w < nw; w++ {
+			lo, hi := w*winSamples, (w+1)*winSamples
+			if hi > len(raw) {
+				hi = len(raw)
+			}
+			if lo >= hi {
+				continue
+			}
+			var e2 float64
+			for _, v := range raw[lo:hi] {
+				e2 += float64(v) * float64(v)
+			}
+			wr[w] = math.Sqrt(e2 / float64(hi-lo))
+		}
+		// 有音符在響的窗：RMS 要高於 0.001
+		var withNote, audible int
+		for w := 0; w < nw; w++ {
+			if act[w] > 0 && (w+1)*winSamples <= int(endSample) {
+				withNote++
+				if wr[w] > 0.001 {
+					audible++
+				}
+			}
+		}
+		activeOK := 100.0
+		if withNote > 0 {
+			activeOK = 100 * float64(audible) / float64(withNote)
+		}
+		// 皮爾森相關：活動音符數對窗 RMS（常數音的相關是 0 或未定義）
+		var ma, mr float64
+		for w := 0; w < nw; w++ {
+			ma += float64(held[w])
+			mr += wr[w]
+		}
+		ma /= float64(nw)
+		mr /= float64(nw)
+		var sxy, sxx, syy float64
+		for w := 0; w < nw; w++ {
+			dx, dy := float64(held[w])-ma, wr[w]-mr
+			sxy += dx * dy
+			sxx += dx * dx
+			syy += dy * dy
+		}
+		corr := 0.0
+		if sxx > 0 && syy > 0 {
+			corr = sxy / math.Sqrt(sxx*syy)
+		}
+		// 最後一個音符結束之後 2.5 秒的窗：必須靜音（卡音偵測）
+		var stuck int
+		for w := int(lastEnd)/winSamples + 1 + int(2.5*20); w < nw; w++ {
+			if wr[w] > 0.001 {
+				stuck++
+			}
+		}
+		// 真正會被前端使用的路徑（Engine.Read）必須與離線轉檔逐取樣一致
+		eng := sound.NewEngine()
+		eng.MusicStart(b)
+		nf := 3 * sound.SampleRate
+		if nf > len(pcm) {
+			nf = len(pcm)
+		}
+		buf := make([]byte, 4*nf)
+		eng.Read(buf)
+		eq := true
+		for i := 0; i < nf; i++ {
+			l := int16(binary.LittleEndian.Uint16(buf[4*i:]))
+			r := int16(binary.LittleEndian.Uint16(buf[4*i+2:]))
+			if l != pcm[i] || r != pcm[i] {
+				eq = false
+				break
+			}
+		}
+		e, haveExp := want[base]
+		expS, expN := "-", "-"
+		var problems []string
+		if haveExp {
+			expS, expN = fmt.Sprintf("%.3f", e.secs), strconv.Itoa(e.notes)
+			if math.Abs(parsed-e.secs) > 0.002+e.secs*0.001 {
+				problems = append(problems, fmt.Sprintf("曲長 %.3f 與獨立工具 %.3f 不符", parsed, e.secs))
+			}
+			if notes != e.notes {
+				problems = append(problems, fmt.Sprintf("音符數 %d 與獨立工具 %d 不符", notes, e.notes))
+			}
+		} else if *exp != "" {
+			problems = append(problems, "獨立工具沒有這個檔")
+		}
+		rendered := float64(len(f)) / sound.SampleRate
+		if uint64(len(f)) < endSample || rendered > parsed+2.5+0.03 {
+			problems = append(problems, fmt.Sprintf("轉檔長度 %.3f 不在 [曲長 %.3f, 曲長+2.5 秒]", rendered, parsed))
+		}
+		if rend.Steals != 0 {
+			problems = append(problems, fmt.Sprintf("有 %d 次聲部被取代", rend.Steals))
+		}
+		if nearClip != 0 {
+			problems = append(problems, fmt.Sprintf("%d 個取樣的絕對值超過 0.99", nearClip))
+		}
+		if peak < 0.05 || peak > 0.99 {
+			problems = append(problems, fmt.Sprintf("峰值 %.3f 不在 0.05 到 0.99", peak))
+		}
+		if rms < 0.005 {
+			problems = append(problems, fmt.Sprintf("RMS %.5f 近乎靜音", rms))
+		}
+		if activeOK < 95 {
+			problems = append(problems, fmt.Sprintf("有音符的時間窗只有 %.0f%% 聽得到", activeOK))
+		}
+		if corr < 0.2 {
+			problems = append(problems, fmt.Sprintf("活動音符數與能量的相關只有 %.2f", corr))
+		}
+		if stuck != 0 {
+			problems = append(problems, fmt.Sprintf("最後一個音符結束 2.5 秒後仍有 %d 個窗有聲音（卡音）", stuck))
+		}
+		if !same {
+			problems = append(problems, "兩次轉檔不相同")
+		}
+		if !eq {
+			problems = append(problems, "Engine.Read 與離線轉檔不一致")
+		}
+		// 基頻抽查：被驗收的渲染器要過，壞渲染器（固定 440 Hz、起訖準時）必須被擋下（偵測器的正對照）
+		pc, pok := pitchCheck(s, realRender, true)
+		_, pbad := pitchCheck(s, badRender, false)
+		pitchCol := "-"
+		if pc > 0 {
+			pitchCol = fmt.Sprintf("%d/%d", pok, pc)
+			if pok*10 < pc*9 {
+				problems = append(problems, fmt.Sprintf("基頻抽查只有 %d/%d 個音符的 MIDI 音高在 ±12 個半音內的調和累加最大值的 70%% 以上（要求至少 90%%）", pok, pc))
+			}
+			if pc >= 10 && pbad*10 > pc*6 {
+				problems = append(problems, fmt.Sprintf("偵測器自測失敗：壞渲染器（固定 440 Hz）有 %d/%d 通過基頻抽查", pbad, pc))
+			}
+		}
+		fmt.Printf("%s\t%.3f\t%s\t%.3f\t%d\t%s\t%.3f\t%.4f\t%d\t%d\t%.2f\t%.0f\t%s\t%d\t%v\t%s\n", base, parsed, expS, rendered, notes, expN, peak, rms, nearClip, rend.Steals, corr, activeOK, pitchCol, pbad, eq, hex.EncodeToString(hh.Sum(nil))[:16])
+		for _, p := range problems {
+			fmt.Printf("  問題：%s\n", p)
+			bad++
+		}
+		if *out != "" {
+			if err := writeWAV(filepath.Join(*out, base+".wav"), pcm, sound.SampleRate); err != nil {
+				fmt.Fprintln(os.Stderr, err)
+				bad++
+			}
+		}
+	}
+	if bad > 0 {
+		fmt.Printf("共 %d 項問題\n", bad)
+		if *check {
+			os.Exit(1)
+		}
+	} else {
+		fmt.Println("全部通過")
+	}
+}
diff --git a/apps/hr/cmd/hrmusic/pitch.go b/apps/hr/cmd/hrmusic/pitch.go
new file mode 100644
index 0000000..666e103
--- /dev/null
+++ b/apps/hr/cmd/hrmusic/pitch.go
@@ -0,0 +1,197 @@
+package main
+
+import (
+	"fmt"
+	"math"
+
+	"github.com/wicanr2/dosgolem/apps/hr/sound"
+)
+
+// 真檔的基頻抽查（docs/spec/007 第 8 節，審查 S5）：把每個旋律通道單獨渲染（各通道幾乎單音），
+// 對其中夠長、沒有重疊的音符，取起音後穩定的一段做自相關，估計基頻，對 MIDI 音高。
+// 判準只來自 SMF 的音高與時間，不依賴合成器參數；「每個音符播固定 440 Hz 正弦、起訖準時」的壞合成器
+// 通過其他所有門檻，但過不了這一項（-selftest 證明）。
+
+// pitchDebug 為真時，基頻抽查把不符的音符印出來（-pitch-debug）。
+var pitchDebug bool
+
+type noteSpan struct {
+	note       uint8
+	on, off    uint64 // 取樣位置
+	overlapped bool
+}
+
+// channelSong 回傳只含通道 ch（0 起算）事件與速度事件的曲子。
+func channelSong(s *sound.Song, ch uint8) *sound.Song {
+	c := *s
+	c.Events = nil
+	for _, e := range s.Events {
+		switch e.Kind {
+		case sound.Tempo, sound.End:
+			c.Events = append(c.Events, e)
+		default:
+			if e.Ch == ch {
+				c.Events = append(c.Events, e)
+			}
+		}
+	}
+	return &c
+}
+
+// spans 回傳通道內每個音符的起訖取樣位置（以渲染時送出事件的取樣位置為準）。
+func spans(cs *sound.Song) ([]noteSpan, []float32) {
+	var out []noteSpan
+	open := map[uint8][]int{}
+	raw, _ := sound.RenderSongRaw(cs, func(e *sound.Event, at uint64) {
+		switch e.Kind {
+		case sound.NoteOn:
+			open[e.A] = append(open[e.A], len(out))
+			out = append(out, noteSpan{note: e.A, on: at, off: math.MaxUint64})
+		case sound.NoteOff:
+			if q := open[e.A]; len(q) > 0 {
+				out[q[0]].off = at
+				open[e.A] = q[1:]
+			}
+		}
+	})
+	// 重疊：同一通道另一個音符在這個音符的時段內開始
+	for i := range out {
+		for j := range out {
+			if i != j && out[j].on > out[i].on && out[j].on < out[i].off {
+				out[i].overlapped = true
+			}
+		}
+	}
+	return out, raw
+}
+
+// salience 以調和累加估計「這個音高有多像基頻」：對 MIDI 音符 m 的頻率 f，
+// S(m) ＝ Σ_{h＝1..5} |X(h·f)| ÷ h，X 是漢寧窗後的 DFT 在該頻率的值（Goertzel）。
+// 倍頻與子倍頻的偏差靠 1/h 加權壓低：固定 440 Hz 的正弦在音高 57 或 81 的 S 只有音高 69 的一半。
+func salience(f []float32, note int) float64 {
+	freq := 440 * math.Pow(2, (float64(note)-69)/12)
+	var s float64
+	for h := 1; h <= 5; h++ {
+		hf := freq * float64(h)
+		if hf > sound.SampleRate/2.2 {
+			break
+		}
+		s += goertzel(f, hf) / float64(h)
+	}
+	return s
+}
+
+func goertzel(f []float32, freq float64) float64 {
+	n := len(f)
+	w := 2 * math.Pi * freq / sound.SampleRate
+	cw := 2 * math.Cos(w)
+	var s1, s2 float64
+	for i, v := range f {
+		hann := 0.5 - 0.5*math.Cos(2*math.Pi*float64(i)/float64(n-1))
+		s0 := float64(v)*hann + cw*s1 - s2
+		s2, s1 = s1, s0
+	}
+	re := s1 - s2*math.Cos(w)
+	im := s2 * math.Sin(w)
+	return math.Hypot(re, im)
+}
+
+// pitchRatio 回傳期望音高的調和累加相對於 ±12 個半音內最大值的比例（1 ＝ 期望音高就是最像基頻的音高）。
+func pitchRatio(f []float32, note uint8) float64 {
+	var best, exp float64
+	for m := int(note) - 12; m <= int(note)+12; m++ {
+		if m < 21 || m > 108 {
+			continue
+		}
+		v := salience(f, m)
+		if v > best {
+			best = v
+		}
+		if m == int(note) {
+			exp = v
+		}
+	}
+	if best == 0 {
+		return 0
+	}
+	return exp / best
+}
+
+const (
+	pitchMinNote  = sound.SampleRate * 200 / 1000 // 音符至少 200 毫秒才抽查
+	pitchSkip     = sound.SampleRate * 60 / 1000  // 跳過起音的 60 毫秒
+	pitchWin      = 4096
+	pitchPerTrack = 12  // 每個通道最多抽 12 個音符（均勻挑），自相關很貴
+	pitchMinRatio = 0.7 // 期望音高的調和累加至少是 ±12 個半音內最大值的 70%
+)
+
+// pitchCheck 對曲子的每個旋律通道（排除第 10 通道）抽查基頻。render 是被驗收的渲染器
+// （正式的是 sound.RenderSongRaw；自測用壞渲染器）。回傳抽查數與通過數。
+func pitchCheck(s *sound.Song, render func(*sound.Song, []noteSpan) []float32, debug bool) (checked, ok int) {
+	for ch := uint8(0); ch < 16; ch++ {
+		if ch == 9 {
+			continue
+		}
+		cs := channelSong(s, ch)
+		sp, _ := spans(cs)
+		var cands []noteSpan
+		for _, n := range sp {
+			if n.off != math.MaxUint64 && !n.overlapped && n.off-n.on >= pitchMinNote+pitchSkip+pitchWin/4 {
+				cands = append(cands, n)
+			}
+		}
+		if len(cands) == 0 {
+			continue
+		}
+		step := 1
+		if len(cands) > pitchPerTrack {
+			step = len(cands) / pitchPerTrack
+		}
+		out := render(cs, sp)
+		for i := 0; i < len(cands); i += step {
+			n := cands[i]
+			// 窗放在音符中段（慢起音的墊音要到中段才有足夠的能量），但不早於起音後 pitchSkip
+			a := int(n.on) + pitchSkip
+			if mid := int(n.on+n.off)/2 - pitchWin/2; mid > a {
+				a = mid
+			}
+			end := int(n.off)
+			if a+pitchWin > end {
+				continue // 穩定段不夠長
+			}
+			if a+pitchWin > len(out) {
+				continue
+			}
+			ratio := pitchRatio(out[a:a+pitchWin], n.note)
+			checked++
+			if ratio >= pitchMinRatio {
+				ok++
+			} else if debug && pitchDebug {
+				fmt.Printf("  音高不符 通道%d 音符%d 期望音高的調和累加只有最大值的 %.2f\n", ch+1, n.note, ratio)
+			}
+		}
+	}
+	return
+}
+
+// realRender 是被驗收的渲染器：把單一通道的曲子渲染。
+func realRender(cs *sound.Song, _ []noteSpan) []float32 {
+	out, _ := sound.RenderSongRaw(cs, nil)
+	return out
+}
+
+// badRender 是自測用的壞渲染器：每個音符在起訖之間播固定 440 Hz 的正弦（起訖準時、有休止、有音量）。
+func badRender(cs *sound.Song, sp []noteSpan) []float32 {
+	total := int(cs.Duration(sound.SampleRate)) + sound.SampleRate
+	out := make([]float32, total)
+	for _, n := range sp {
+		end := n.off
+		if end == math.MaxUint64 || end > uint64(total) {
+			end = uint64(total)
+		}
+		for i := n.on; i < end; i++ {
+			out[i] += 0.3 * float32(math.Sin(2*math.Pi*440*float64(i)/sound.SampleRate))
+		}
+	}
+	return out
+}
diff --git a/apps/hr/play/audio.go b/apps/hr/play/audio.go
new file mode 100644
index 0000000..90bacce
--- /dev/null
+++ b/apps/hr/play/audio.go
@@ -0,0 +1,227 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/sound"
+)
+
+// 音訊輸出（docs/spec/007 第 5.2、5.3 節）。
+//
+// 引擎的「正在播放」時鐘是拉取者的取樣時鐘，所以必須有一個以牆鐘速度持續呼叫 Engine.Read 的拉取者：
+// 裝置可用時是裝置的回呼，裝置不可用或中途失敗或停滯時是這裡的牆鐘拉取執行緒（讀了就丟）。
+// 靜音只讓 Engine 輸出填 0，拉取者照常拉。
+//
+// Engine.Read 不是並行安全的，所以所有拉取都經過 pullSource：它用互斥鎖串行化，並用「世代」讓被接手的舊拉取者
+// （例如阻塞在 snd_pcm_writei 之後才醒來的裝置執行緒）之後只拿到靜音，不再推進引擎。
+//
+// 不使用 ebiten/v2/audio：它的更新前掛鉤在裝置失敗時把錯誤當 Update 失敗回傳，RunGame 會結束，
+// 而 Docker、Xvfb、Wine 的驗收環境都沒有音訊裝置。
+
+const (
+	pumpPeriod = 20 * time.Millisecond
+	pumpFrames = sound.SampleRate * 20 / 1000 // 882
+)
+
+// stallAfter 是拉取者多久沒有成功拉取就視為停滯（裝置執行緒卡在阻塞的寫入、驅動被拔掉等）。測試可以調小。
+var stallAfter = 2 * time.Second
+
+// pullSource 把 Engine 包成可被多個拉取者競爭、但同一時間只有一個生效的來源。
+type pullSource struct {
+	mu   sync.Mutex
+	e    *sound.Engine
+	gen  int
+	t0   time.Time    // 單調時鐘的起點（time.Now() 帶單調讀數；Linux 的 CLOCK_MONOTONIC 在休眠期間不前進，喚醒後不會誤判停滯；Windows 與 macOS 的行為未驗）
+	last atomic.Int64 // 最近一次有效拉取，距 t0 的奈秒
+}
+
+func newPullSource(e *sound.Engine) *pullSource {
+	s := &pullSource{e: e, gen: 1, t0: time.Now()}
+	s.last.Store(int64(time.Since(s.t0)))
+	return s
+}
+
+// reader 回傳世代 gen 的拉取者。
+func (s *pullSource) reader(gen int) io.Reader { return pullReader{s, gen} }
+
+// takeover 讓之前所有世代的拉取者失效，回傳新世代。
+func (s *pullSource) takeover() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.gen++
+	s.last.Store(int64(time.Since(s.t0)))
+	return s.gen
+}
+
+func (s *pullSource) idle() time.Duration { return time.Since(s.t0) - time.Duration(s.last.Load()) }
+
+type pullReader struct {
+	s   *pullSource
+	gen int
+}
+
+func (r pullReader) Read(p []byte) (int, error) {
+	r.s.mu.Lock()
+	defer r.s.mu.Unlock()
+	if r.gen != r.s.gen {
+		// 已被接手：回靜音，不推進引擎
+		n := len(p) &^ 3
+		for i := range p[:n] {
+			p[i] = 0
+		}
+		return n, nil
+	}
+	n, err := r.s.e.Read(p)
+	r.s.last.Store(int64(time.Since(r.s.t0)))
+	return n, err
+}
+
+// backend 是平台的音訊裝置後端。stop 關閉裝置（可能阻塞，所以接手時在背景呼叫）；
+// died 在裝置執行中失敗時被關閉（之後由牆鐘拉取執行緒接手）。
+type backend struct {
+	stop func()
+	died <-chan struct{}
+	name string
+}
+
+type audioOut struct {
+	src  *pullSource
+	logf func(string, ...any)
+
+	be       *backend
+	stopOnce sync.Once
+	quit     chan struct{}
+	wg       sync.WaitGroup
+
+	mu      sync.Mutex
+	pumping bool
+	closed  bool
+}
+
+// openBackendFn 是測試可以替換的後端工廠。
+var openBackendFn = openBackend
+
+// openTimeout 是開啟裝置的逾時（ALSA 的 snd_pcm_open 本身沒有逾時，音效伺服器卡住時會一直阻塞，
+// 而 startAudio 在 RunGame 之前被呼叫）。逾時就改用牆鐘拉取執行緒；之後才開成功的裝置立刻關掉。測試可以調小。
+var openTimeout = 3 * time.Second
+
+type openResult struct {
+	be  *backend
+	err error
+}
+
+// startAudio 嘗試開啟裝置；開不了或逾時就立刻改用牆鐘拉取執行緒。回傳的物件永遠有效，close 關閉所有東西。
+func startAudio(e *sound.Engine, logf func(string, ...any)) *audioOut {
+	a := &audioOut{src: newPullSource(e), logf: logf, quit: make(chan struct{})}
+	ch := make(chan openResult, 1)
+	go func() {
+		be, err := openBackendFn(a.src.reader(1), logf)
+		ch <- openResult{be, err}
+	}()
+	var be *backend
+	var err error
+	select {
+	case r := <-ch:
+		be, err = r.be, r.err
+	case <-time.After(openTimeout):
+		err = fmt.Errorf("開啟音訊裝置逾時（%v）", openTimeout)
+		// 晚到的結果：世代 1 的拉取者之後只會拿到靜音（下面 takeover），裝置若終於開成功就關掉
+		go func() {
+			if r := <-ch; r.be != nil {
+				r.be.stop()
+			}
+		}()
+	}
+	if err != nil {
+		logf("音訊裝置不可用，靜音運行（遊戲照常；音樂的曲末與重播仍依牆鐘推進）：%v", err)
+		a.startPump(a.src.takeover())
+		return a
+	}
+	a.be = be
+	logf("音訊裝置：%s", be.name)
+	a.wg.Add(1)
+	go a.watch()
+	return a
+}
+
+// watch 監看裝置：中途失敗或拉取停滯就接手。接手順序固定：先讓舊世代失效（舊拉取者之後只拿到靜音，
+// 不會與新的並行推進引擎），再在背景關閉裝置（可能阻塞），最後啟動牆鐘拉取執行緒。
+func (a *audioOut) watch() {
+	defer a.wg.Done()
+	tk := time.NewTicker(stallAfter / 4)
+	defer tk.Stop()
+	for {
+		select {
+		case <-a.quit:
+			return
+		case <-a.be.died:
+			a.logf("音訊裝置中途失敗，改用牆鐘拉取（靜音）")
+			a.handover()
+			return
+		case <-tk.C:
+			if a.src.idle() > stallAfter {
+				a.logf("音訊裝置停滯超過 %v，改用牆鐘拉取（靜音）", stallAfter)
+				a.handover()
+				return
+			}
+		}
+	}
+}
+
+func (a *audioOut) handover() {
+	gen := a.src.takeover()
+	go a.stopBackend() // 關閉可能阻塞（停滯的裝置），不能等
+	a.startPump(gen)
+}
+
+func (a *audioOut) stopBackend() {
+	if a.be == nil {
+		return
+	}
+	a.stopOnce.Do(a.be.stop)
+}
+
+func (a *audioOut) startPump(gen int) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.pumping || a.closed {
+		return
+	}
+	a.pumping = true
+	r := a.src.reader(gen)
+	a.wg.Add(1)
+	go func() {
+		defer a.wg.Done()
+		buf := make([]byte, 4*pumpFrames)
+		tk := time.NewTicker(pumpPeriod)
+		defer tk.Stop()
+		for {
+			select {
+			case <-a.quit:
+				return
+			case <-tk.C:
+				r.Read(buf)
+			}
+		}
+	}()
+}
+
+func (a *audioOut) close() {
+	a.mu.Lock()
+	a.closed = true // 之後不再啟動拉取執行緒（避免與 wg.Wait 競爭）
+	a.mu.Unlock()
+	close(a.quit)
+	// 裝置可能已被接手（stopOnce 保證只關一次）；關閉可能阻塞（停滯的裝置），最多等 1 秒，程式要結束了
+	done := make(chan struct{})
+	go func() { a.stopBackend(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		a.logf("關閉音訊裝置逾時，略過")
+	}
+	a.wg.Wait()
+}
diff --git a/apps/hr/play/audio_linux.go b/apps/hr/play/audio_linux.go
new file mode 100644
index 0000000..834cdc3
--- /dev/null
+++ b/apps/hr/play/audio_linux.go
@@ -0,0 +1,124 @@
+//go:build linux
+
+package main
+
+import (
+	"fmt"
+	"io"
+	"sync"
+	"unsafe"
+
+	"github.com/ebitengine/purego"
+
+	"github.com/wicanr2/dosgolem/apps/hr/sound"
+)
+
+// Linux 後端：在執行期 dlopen("libasound.so.2")，不在連結期依賴 ALSA（docs/spec/007 第 5.3 節）。
+// 沒有 libasound、沒有裝置、寫入持續失敗，都回報給 startAudio，由它改用牆鐘拉取執行緒。
+
+const (
+	sndPcmStreamPlayback = 0
+	sndPcmFormatS16LE    = 2
+	sndPcmAccessRWInter  = 3
+	alsaLatencyUS        = 100_000
+	alsaChunkFrames      = 1024
+	maxWriteFailures     = 5
+)
+
+type alsa struct {
+	open       func(handle *uintptr, name string, stream int32, mode int32) int32
+	setParams  func(handle uintptr, format int32, access int32, channels uint32, rate uint32, softResample int32, latency uint32) int32
+	writei     func(handle uintptr, buf unsafe.Pointer, frames uint) int
+	recoverPCM func(handle uintptr, err int32, silent int32) int32
+	drop       func(handle uintptr) int32
+	closePCM   func(handle uintptr) int32
+	strerror   func(err int32) string
+}
+
+func loadALSA() (*alsa, error) {
+	lib, err := purego.Dlopen("libasound.so.2", purego.RTLD_NOW|purego.RTLD_GLOBAL)
+	if err != nil {
+		return nil, fmt.Errorf("載入 libasound.so.2 失敗：%w", err)
+	}
+	a := &alsa{}
+	purego.RegisterLibFunc(&a.open, lib, "snd_pcm_open")
+	purego.RegisterLibFunc(&a.setParams, lib, "snd_pcm_set_params")
+	purego.RegisterLibFunc(&a.writei, lib, "snd_pcm_writei")
+	purego.RegisterLibFunc(&a.recoverPCM, lib, "snd_pcm_recover")
+	purego.RegisterLibFunc(&a.drop, lib, "snd_pcm_drop")
+	purego.RegisterLibFunc(&a.closePCM, lib, "snd_pcm_close")
+	purego.RegisterLibFunc(&a.strerror, lib, "snd_strerror")
+	return a, nil
+}
+
+func openBackend(src io.Reader, logf func(string, ...any)) (be *backend, err error) {
+	// purego 在找不到符號時會 panic，這裡統一轉成錯誤
+	defer func() {
+		if r := recover(); r != nil {
+			be, err = nil, fmt.Errorf("ALSA 初始化失敗：%v", r)
+		}
+	}()
+	a, err := loadALSA()
+	if err != nil {
+		return nil, err
+	}
+	var h uintptr
+	if rc := a.open(&h, "default", sndPcmStreamPlayback, 0); rc < 0 {
+		return nil, fmt.Errorf("snd_pcm_open(default)：%s", a.strerror(rc))
+	}
+	if rc := a.setParams(h, sndPcmFormatS16LE, sndPcmAccessRWInter, 2, sound.SampleRate, 1, alsaLatencyUS); rc < 0 {
+		a.closePCM(h)
+		return nil, fmt.Errorf("snd_pcm_set_params：%s", a.strerror(rc))
+	}
+	quit := make(chan struct{})
+	died := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		defer close(died)
+		buf := make([]byte, 4*alsaChunkFrames)
+		fails := 0
+		for {
+			select {
+			case <-quit:
+				return
+			default:
+			}
+			src.Read(buf)
+			off := 0
+			for off < len(buf) {
+				select {
+				case <-quit:
+					return
+				default:
+				}
+				n := a.writei(h, unsafe.Pointer(&buf[off]), uint((len(buf)-off)/4))
+				if n < 0 {
+					// 欠載（EPIPE）或暫停：嘗試恢復；恢復不了就累計失敗
+					if rc := a.recoverPCM(h, int32(n), 1); rc < 0 {
+						fails++
+						if fails >= maxWriteFailures {
+							logf("ALSA 寫入持續失敗：%s", a.strerror(int32(n)))
+							return
+						}
+					}
+					continue
+				}
+				fails = 0
+				off += n * 4
+			}
+		}
+	}()
+	stop := func() {
+		select {
+		case <-quit:
+		default:
+			close(quit)
+		}
+		a.drop(h)
+		wg.Wait()
+		a.closePCM(h)
+	}
+	return &backend{stop: stop, died: died, name: "ALSA default（44100 Hz，立體聲，延遲 100 毫秒）"}, nil
+}
diff --git a/apps/hr/play/audio_other.go b/apps/hr/play/audio_other.go
new file mode 100644
index 0000000..99bdfc1
--- /dev/null
+++ b/apps/hr/play/audio_other.go
@@ -0,0 +1,76 @@
+//go:build !linux
+
+package main
+
+import (
+	"fmt"
+	"io"
+	"sync"
+	"time"
+
+	"github.com/ebitengine/oto/v3"
+
+	"github.com/wicanr2/dosgolem/apps/hr/sound"
+)
+
+// Windows 與 macOS 後端：oto v3（docs/spec/007 第 5.3 節）。NewContext 沒有同步回報裝置錯誤，
+// 要等 ready 通道再讀 Err()；執行中另有監看 goroutine，出錯就通知 startAudio 改用牆鐘拉取。
+
+const (
+	otoReadyTimeout = 3 * time.Second
+	otoWatchPeriod  = time.Second
+	otoBufferBytes  = sound.SampleRate * 4 / 10 // 100 毫秒：44100 × 2 聲道 × 2 位元組 ÷ 10
+)
+
+func openBackend(src io.Reader, logf func(string, ...any)) (*backend, error) {
+	ctx, ready, err := oto.NewContext(&oto.NewContextOptions{
+		SampleRate:   sound.SampleRate,
+		ChannelCount: 2,
+		Format:       oto.FormatSignedInt16LE,
+		BufferSize:   100 * time.Millisecond,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("oto.NewContext：%w", err)
+	}
+	select {
+	case <-ready:
+	case <-time.After(otoReadyTimeout):
+		return nil, fmt.Errorf("oto 在 %v 內沒有就緒", otoReadyTimeout)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("oto 裝置錯誤：%w", err)
+	}
+	p := ctx.NewPlayer(src)
+	p.SetBufferSize(otoBufferBytes) // 預設 0.5 秒預讀，音效會晚半秒；固定 100 毫秒（docs/spec/007 第 5.3 節）
+	p.Play()
+	quit := make(chan struct{})
+	died := make(chan struct{})
+	var once sync.Once
+	go func() {
+		tk := time.NewTicker(otoWatchPeriod)
+		defer tk.Stop()
+		for {
+			select {
+			case <-quit:
+				return
+			case <-tk.C:
+				if err := ctx.Err(); err != nil {
+					logf("oto 裝置錯誤：%v", err)
+					once.Do(func() { close(died) })
+					return
+				}
+			}
+		}
+	}()
+	stop := func() {
+		select {
+		case <-quit:
+		default:
+			close(quit)
+		}
+		// Close 在 oto v3.4.0 是空操作；先 Pause，接手後的 Player 不再消耗緩衝（否則會對世代 1 的 reader 拉靜音到行程結束）。
+		p.Pause()
+		p.Close()
+	}
+	return &backend{stop: stop, died: died, name: "oto（44100 Hz，立體聲，緩衝 100 毫秒）"}, nil
+}
diff --git a/apps/hr/play/audio_test.go b/apps/hr/play/audio_test.go
new file mode 100644
index 0000000..a25177d
--- /dev/null
+++ b/apps/hr/play/audio_test.go
@@ -0,0 +1,277 @@
+package main
+
+import (
+	"io"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/sound"
+)
+
+// 約 0.1 秒的 SMF（division 48、速度 500000、一個音符、結尾在 tick 10）。測試內組出，不是原曲。
+var tinySMF = []byte{
+	'M', 'T', 'h', 'd', 0, 0, 0, 6, 0, 1, 0, 1, 0, 0x30,
+	'M', 'T', 'r', 'k', 0, 0, 0, 19,
+	0x00, 0xFF, 0x51, 0x03, 0x07, 0xA1, 0x20,
+	0x00, 0x90, 0x3C, 0x64,
+	0x0A, 0x80, 0x3C, 0x00,
+	0x00, 0xFF, 0x2F, 0x00,
+}
+
+// docs/spec/007 第 5.2 節：不論音訊裝置是否可用（測試環境通常沒有），一定有拉取者以牆鐘速度拉引擎，
+// 曲子才會自然結束，遊戲才會重播。裝置可用時由裝置拉，不可用時由牆鐘拉取執行緒拉。
+func TestAudioAlwaysHasAPuller(t *testing.T) {
+	e := sound.NewEngine()
+	var mu sync.Mutex
+	var logs []string
+	logf := func(f string, a ...any) { mu.Lock(); logs = append(logs, f); mu.Unlock() }
+	a := startAudio(e, logf)
+	defer a.close()
+	e.SetMute(true) // 測試時不出聲
+	e.MusicStart(tinySMF)
+	if !e.Playing() {
+		t.Fatal("MusicStart 後應在播放")
+	}
+	deadline := time.Now().Add(3 * time.Second)
+	for e.Playing() && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if e.Playing() {
+		t.Fatalf("3 秒內曲子（約 0.1 秒）沒有自然結束：沒有拉取者在拉引擎。日誌 %v", logs)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(logs) == 0 {
+		t.Fatal("startAudio 應該至少記一行（用了哪個後端，或為何靜音）")
+	}
+	t.Logf("後端日誌：%v", logs)
+}
+
+// 5 秒的 SMF（同上，結尾在 tick 480）。音符在 tick 0 開始、tick 440 才結束（持續約 4.6 秒），
+// 所以 5 秒內任何一段都有聲音，讀取的先後不影響「有沒有聲音」的判斷。
+var longSMF = []byte{
+	'M', 'T', 'h', 'd', 0, 0, 0, 6, 0, 1, 0, 1, 0, 0x30,
+	'M', 'T', 'r', 'k', 0, 0, 0, 20,
+	0x00, 0xFF, 0x51, 0x03, 0x07, 0xA1, 0x20,
+	0x00, 0x90, 0x3C, 0x64,
+	0x83, 0x38, 0x80, 0x3C, 0x00,
+	0x28, 0xFF, 0x2F, 0x00,
+}
+
+func nonZero(b []byte) bool {
+	for _, v := range b {
+		if v != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// pullSource 的世代（docs/spec/007 第 5.2 節）：被接手的舊世代拉取者只拿到靜音，且不推進引擎。
+// 不靜音、曲子（5 秒）短於舊拉取者要讀的長度（6 秒）：世代檢查被拿掉時，舊拉取者會讀到非零取樣，
+// 並把曲子推進到結束（Playing 變假），兩項斷言都會失敗。
+func TestPullSourceOldGenerationGetsSilenceAndDoesNotAdvance(t *testing.T) {
+	e := sound.NewEngine()
+	src := newPullSource(e)
+	old := src.reader(1)
+	cur := src.reader(src.takeover())
+	e.MusicStart(longSMF)
+	// 對照：目前世代的拉取者讀得到聲音
+	probe := make([]byte, 4*sound.SampleRate/10) // 0.1 秒
+	if n, err := cur.Read(probe); err != nil || n != len(probe) || !nonZero(probe) {
+		t.Fatalf("目前世代的拉取者應讀到聲音：n=%d err=%v nonzero=%v", n, err, nonZero(probe))
+	}
+	buf := make([]byte, 4*sound.SampleRate*6) // 6 秒，長於曲長
+	if n, err := old.Read(buf); err != nil || n != len(buf) {
+		t.Fatalf("舊世代 Read ＝ %d、%v", n, err)
+	}
+	if nonZero(buf) {
+		t.Fatal("被接手的舊世代拉取者應只拿到靜音")
+	}
+	if !e.Playing() {
+		t.Fatal("舊世代拉取者不該把曲子推進到結束")
+	}
+}
+
+type fakeDevice struct {
+	stops atomic.Int32
+	died  chan struct{}
+	hold  chan struct{} // 關閉時，卡住的裝置執行緒才會醒來
+}
+
+func newFakeDevice() *fakeDevice {
+	return &fakeDevice{died: make(chan struct{}), hold: make(chan struct{})}
+}
+
+func (d *fakeDevice) factory(run func(src io.Reader, d *fakeDevice)) func(io.Reader, func(string, ...any)) (*backend, error) {
+	return func(src io.Reader, logf func(string, ...any)) (*backend, error) {
+		go run(src, d)
+		return &backend{stop: func() { d.stops.Add(1) }, died: d.died, name: "fake"}, nil
+	}
+}
+
+func waitNotPlaying(e *sound.Engine, d time.Duration) bool {
+	deadline := time.Now().Add(d)
+	for e.Playing() && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	return !e.Playing()
+}
+
+// 拉取者停滯（裝置執行緒卡住，不再呼叫 Read）：看門狗接手，曲子照樣自然結束；
+// 卡住的執行緒之後醒來，只拿到靜音，不會與牆鐘拉取者並行推進引擎。
+func TestAudioStalledBackendIsTakenOver(t *testing.T) {
+	old := stallAfter
+	stallAfter = 300 * time.Millisecond
+	defer func() { stallAfter = old }()
+	oldOpen := openBackendFn
+	defer func() { openBackendFn = oldOpen }()
+	dev := newFakeDevice()
+	readerCh := make(chan io.Reader, 1)
+	openBackendFn = dev.factory(func(src io.Reader, d *fakeDevice) {
+		readerCh <- src
+		buf := make([]byte, 4*pumpFrames)
+		for i := 0; i < 3; i++ { // 先正常拉幾次，然後卡住
+			src.Read(buf)
+			time.Sleep(10 * time.Millisecond)
+		}
+		<-d.hold
+	})
+	e := sound.NewEngine()
+	var mu sync.Mutex
+	var logs []string
+	a := startAudio(e, func(f string, args ...any) { mu.Lock(); logs = append(logs, f); mu.Unlock() })
+	e.MusicStart(tinySMF)
+	if !waitNotPlaying(e, 5*time.Second) {
+		t.Fatalf("裝置停滯後曲子應由牆鐘拉取者推進到自然結束")
+	}
+	// 卡住的舊拉取者醒來：只拿到靜音，且不推進引擎（不靜音，曲子 5 秒、舊拉取者讀 6 秒，
+	// 世代檢查被拿掉時這兩項斷言會失敗；決定性的單元測試見 TestPullSourceOldGenerationGetsSilenceAndDoesNotAdvance）
+	e.MusicStart(longSMF)
+	close(dev.hold)
+	time.Sleep(5 * time.Millisecond)
+	buf := make([]byte, 4*44100*6) // 6 秒的取樣框
+	oldReader := <-readerCh
+	n, err := oldReader.Read(buf)
+	if err != nil || n != len(buf) {
+		t.Fatalf("舊拉取者 Read ＝ %d、%v", n, err)
+	}
+	if nonZero(buf) {
+		t.Fatal("被接手的舊拉取者應只拿到靜音")
+	}
+	if !e.Playing() {
+		t.Fatal("舊拉取者不該把新曲（5 秒）推進到結束")
+	}
+	a.close()
+	if got := dev.stops.Load(); got != 1 {
+		t.Fatalf("裝置的 stop 應剛好被呼叫 1 次，實際 %d", got)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	found := false
+	for _, l := range logs {
+		if strings.Contains(l, "停滯") {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("應記一行停滯接手的日誌：%v", logs)
+	}
+}
+
+// 裝置中途失敗（died 被關閉）：先讓舊世代失效、背景關閉裝置，再由牆鐘拉取者接手；stop 剛好一次。
+func TestAudioDiedBackendHandover(t *testing.T) {
+	oldOpen := openBackendFn
+	defer func() { openBackendFn = oldOpen }()
+	dev := newFakeDevice()
+	openBackendFn = dev.factory(func(src io.Reader, d *fakeDevice) {
+		buf := make([]byte, 4*pumpFrames)
+		for i := 0; i < 2; i++ {
+			src.Read(buf)
+		}
+		close(d.died)
+		// 之後這個執行緒若還在拉，只會拿到靜音（世代已換）
+		for i := 0; i < 5; i++ {
+			src.Read(buf)
+			time.Sleep(5 * time.Millisecond)
+		}
+	})
+	e := sound.NewEngine()
+	a := startAudio(e, func(string, ...any) {})
+	e.SetMute(true)
+	e.MusicStart(tinySMF)
+	if !waitNotPlaying(e, 5*time.Second) {
+		t.Fatal("裝置失敗後曲子應由牆鐘拉取者推進到自然結束")
+	}
+	a.close()
+
+	if got := dev.stops.Load(); got != 1 {
+		t.Fatalf("stop 應剛好 1 次，實際 %d", got)
+	}
+}
+
+// 開啟裝置卡住（snd_pcm_open 無逾時）：startAudio 在 openTimeout 內返回，改用牆鐘拉取執行緒，曲子照樣自然結束；
+// 晚到才開成功的裝置會被關掉（stop 剛好一次）。
+func TestAudioOpenTimeoutFallsBackToPump(t *testing.T) {
+	oldT := openTimeout
+	openTimeout = 200 * time.Millisecond
+	defer func() { openTimeout = oldT }()
+	oldOpen := openBackendFn
+	defer func() { openBackendFn = oldOpen }()
+	dev := newFakeDevice()
+	release := make(chan struct{})
+	openBackendFn = func(src io.Reader, logf func(string, ...any)) (*backend, error) {
+		<-release // 卡住，直到測試放行
+		return &backend{stop: func() { dev.stops.Add(1) }, died: dev.died, name: "fake-late"}, nil
+	}
+	e := sound.NewEngine()
+	start := time.Now()
+	var mu sync.Mutex
+	var logs []string
+	a := startAudio(e, func(f string, args ...any) { mu.Lock(); logs = append(logs, f); mu.Unlock() })
+	if d := time.Since(start); d > 2*time.Second {
+		t.Fatalf("startAudio 應在逾時後返回，卻花了 %v", d)
+	}
+	e.MusicStart(tinySMF)
+	if !waitNotPlaying(e, 5*time.Second) {
+		t.Fatal("開啟逾時後曲子應由牆鐘拉取者推進到自然結束")
+	}
+	close(release) // 晚到的裝置開成功
+	deadline := time.Now().Add(2 * time.Second)
+	for dev.stops.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	a.close()
+	if got := dev.stops.Load(); got != 1 {
+		t.Fatalf("晚到的裝置應被關閉剛好 1 次，實際 %d", got)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	found := false
+	for _, l := range logs {
+		if strings.Contains(l, "靜音運行") {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("應記一行靜音運行的日誌：%v", logs)
+	}
+}
+
+// 看門狗用單調時鐘：idle() 不受牆鐘跳變影響。pullSource 只存單調偏移，這裡確認它隨拉取重設、隨時間增加。
+func TestPullSourceIdleUsesMonotonicOffset(t *testing.T) {
+	e := sound.NewEngine()
+	s := newPullSource(e)
+	time.Sleep(60 * time.Millisecond)
+	if d := s.idle(); d < 50*time.Millisecond || d > 2*time.Second {
+		t.Fatalf("idle ＝ %v，應約 60 毫秒", d)
+	}
+	buf := make([]byte, 4*pumpFrames)
+	s.reader(1).Read(buf)
+	if d := s.idle(); d > 30*time.Millisecond {
+		t.Fatalf("拉取後 idle 應重設，得到 %v", d)
+	}
+}
