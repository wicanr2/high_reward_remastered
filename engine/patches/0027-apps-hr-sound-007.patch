+	e.MusicStart(oneNote(0))
+	e.drain()
+	mix := make([]float32, chunkFrames)
+	for !e.cur.SongDone() {
+		for i := range mix {
+			mix[i] = 0
+		}
+		e.cur.Render(mix)
+	}
+	// 模擬端在此刻下了新的 MusicStart（命令還沒被音訊端取走）
+	e.epoch++
+	e.state.Store(e.epoch<<1 | 1)
+	for i := range mix {
+		mix[i] = 0
+	}
+	e.renderChunk(mix)
+	if !e.Playing() {
+		t.Fatal("舊曲的結束不該清掉較新世代的播放狀態")
+	}
+}
