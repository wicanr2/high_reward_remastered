+func addSound(a, c hrrt.SoundStats) hrrt.SoundStats {
+	a.Starts += c.Starts
+	a.Stops += c.Stops
+	a.Fades += c.Fades
+	a.SFX += c.SFX
+	a.Queries += c.Queries
+	a.BadSFX += c.BadSFX
+	if a.Disabled == "" {
+		a.Disabled = c.Disabled
+	}
+	return a
+}
+
+func soundSummary(on bool, prev hrrt.SoundStats, cur *hrrt.Session) map[string]any {
+	st := prev
+	if cur != nil {
+		st = addSound(st, cur.Sound())
+	}
+	return map[string]any{"enabled": on, "starts": st.Starts, "stops": st.Stops, "fades": st.Fades, "sfx": st.SFX, "queries": st.Queries, "bad_sfx": st.BadSFX, "disabled": st.Disabled}
+}
diff --git a/apps/hr/cmd/hrmusic/main.go b/apps/hr/cmd/hrmusic/main.go
