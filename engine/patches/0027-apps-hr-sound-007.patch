diff --git a/apps/hr/runtime/sound.go b/apps/hr/runtime/sound.go
new file mode 100644
index 0000000..8c9524d
--- /dev/null
+++ b/apps/hr/runtime/sound.go
@@ -0,0 +1,214 @@
+package runtime
+
+import (
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// 聲音掛鉤（docs/spec/007、docs/re/018）。遊戲的聲音旗標 3E24:01B8 維持 0（環境不注入 SOUND、
+// 不載入驅動），所以聲音常式進入後都是直接返回。本檔只在指令「剛執行完」時觀察：
+//   - 四個進入點（開始、停止、淡出、音效）的第一道指令 push bp 剛執行完：讀引數，交給 Sink；
+//   - 狀態讀取 192B:02C9（mov ax,[3E24:01BA]）剛執行完：把 AX 的 bit 0 改成 Sink.Playing()。
+//
+// 不取代函式本體，不寫入遊戲的狀態字：3E24:01BA 在遊戲記憶體裡永遠是 0，所以任何存下來的
+// 狀態檔都不帶聲音狀態，無 Sink 的工具重播這些狀態檔不會卡在 PlayMusic 的等待迴圈。
+
+// SoundSink 接收遊戲對聲音常式的呼叫（docs/spec/007 第 2 節）。實作要能被模擬執行緒呼叫，
+// 不得阻塞。apps/hr/sound 的 Engine 與 NullSink 實作這個介面。
+type SoundSink interface {
+	// MusicStart 收到遊戲 MID 緩衝的複本（固定 MidWindow bytes：檔案內容之後可能帶有前一首的殘餘，
+	// 接收端依 SMF 結構決定有效長度）。
+	MusicStart(mid []byte)
+	MusicStop()
+	MusicFade(n int)
+	SFX(id, start, end int)
+	Playing() bool
+}
+
+// MidWindow 是 MusicStart 交出的資料長度，等於遊戲 fread 讀 MID 的上限。
+const MidWindow = 0x4E20
+
+// VGA 視窗（internal/machine 的 vgaLo、vgaHi）：平面模式下讀它有 latch 副作用，不在線性記憶體裡。
+// MID 緩衝實測在 0xD5000（EMS 頁框區，EMS 映射是把頁資料複製進該位址，所以內容就是 Mem 本身），
+// 不與 VGA 視窗相交，區塊複製與 Read8 的值相同；與視窗相交時略過這次 MusicStart 並計數（SkippedStarts）。
+const (
+	vgaWindowLo = 0xA0000
+	vgaWindowHi = 0xB0000
+)
+
+const (
+	soundSeg  = 0x192B // IDA 281B
+	soundData = 0x3E24 // IDA 4D14
+	musicSeg  = 0x1043 // IDA 1F33（PlayMusic 與重播節拍）
+	stateSeg  = 0x2BCC // IDA 3ABC（目前曲號）
+
+	sndStart  = 0x0010
+	sndStop   = 0x0061
+	sndFade   = 0x00A0
+	sndSFX    = 0x011F
+	sndTick   = 0x0274 // 不掛，只做位元組檢查
+	sndStatus = 0x02C9 // mov ax,[3E24:01BA]：唯一讀狀態字的指令
+	sndLoad   = 0x059B // 不掛，只做位元組檢查
+	sndShort  = 0x0511 // 不掛，只做位元組檢查
+	musPlay   = 0x21F8 // PlayMusic，只做位元組檢查
+	musReplay = 0x223C // 重播節拍，只做位元組檢查
+
+	dataFlag   = 0x01B8 // 聲音旗標，維持 0
+	dataMidOff = 0x01CC // MID 緩衝遠指標（偏移）
+	dataMidSeg = 0x01CE // MID 緩衝遠指標（段）
+	dataSFXTab = 0x0008 // 11 個 word 的切片表
+	curTrack   = 0x0223 // 2BCC:0223 目前曲號，0FFh ＝ 無
+	noTrack    = 0xFF
+	sfxFirstID = 0x32
+	sfxLastID  = 0x3B
+)
+
+type soundSite struct {
+	seg, off uint16
+	name     string
+	pro      []byte
+}
+
+// soundSites 的位元組取自 dosgolem 冷啟動後的記憶體，與反組譯一致（docs/re/018 第 4 節）。
+// 開啟時逐點比對，任何一處不符就失敗：設計依賴的不只是被掛鉤的點，還有 PlayMusic、重播節拍與載入常式。
+var soundSites = []soundSite{
+	{soundSeg, sndStart, "start", []byte{0x55, 0x8B, 0xEC, 0x1E, 0xB8, 0x24, 0x3E, 0x8E, 0xD8, 0x83, 0x3E, 0xB8, 0x01, 0x00, 0x75, 0x05}},
+	{soundSeg, sndStop, "stop", []byte{0x55, 0x8B, 0xEC, 0x1E, 0xB8, 0x24, 0x3E, 0x8E, 0xD8, 0x83, 0x3E, 0xB8, 0x01, 0x00, 0x74, 0x2C}},
+	{soundSeg, sndFade, "fade", []byte{0x55, 0x8B, 0xEC, 0x1E, 0xB8, 0x24, 0x3E, 0x8E, 0xD8, 0x83, 0x3E, 0xB8, 0x01, 0x00, 0x75, 0x05}},
+	{soundSeg, sndSFX, "sfx", []byte{0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x04, 0x1E, 0xB8, 0x24, 0x3E, 0x8E, 0xD8, 0x83, 0x3E, 0xB8, 0x01}},
+	{soundSeg, sndTick, "tick", []byte{0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x02, 0x1E, 0xB8, 0x24, 0x3E, 0x8E, 0xD8, 0x83, 0x3E, 0xBC, 0x01}},
+	{soundSeg, sndStatus, "status", []byte{0xA1, 0xBA, 0x01, 0x25, 0x01, 0x00, 0x1F, 0xC9, 0xCB}},
+	{soundSeg, sndLoad, "load", []byte{0x55, 0x8B, 0xEC, 0x81, 0xEC, 0x22, 0x01, 0x1E, 0xB8, 0x24, 0x3E, 0x8E, 0xD8, 0x8D, 0x86, 0xDE}},
+	{soundSeg, sndShort, "short", []byte{0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x7E, 0x56, 0x57, 0x1E, 0xB8, 0x24, 0x3E, 0x8E, 0xD8, 0xBE, 0x1E}},
+	{musicSeg, musPlay, "playmusic", []byte{0x55, 0x8B, 0xEC, 0x1E, 0xB8, 0xCC, 0x2B, 0x8E, 0xD8, 0x6A, 0x01, 0x6A, 0x01, 0x9A, 0xA0, 0x00}},
+	{musicSeg, musReplay, "replay", []byte{0x55, 0x8B, 0xEC, 0x1E, 0xB8, 0xCC, 0x2B, 0x8E, 0xD8, 0x9A, 0x74, 0x02, 0x2B, 0x19, 0x0B, 0xC0}},
+}
+
+// SoundStats 是掛鉤的計數，只在迴圈停下之後讀。
+type SoundStats struct {
+	Starts, Stops, Fades, SFX, Queries uint64
+	BadSFX                             uint64 // 編號不在 0x32 到 0x3B，或切片表不合
+	MidAddr                            uint32 // 最近一次 MusicStart 複製的 MID 緩衝線性位址（診斷用）
+	SkippedStarts                      uint64 // MID 緩衝與 VGA 視窗相交而略過的 MusicStart 次數（診斷用；實測為 0）
+	Disabled                           string // 非空 ＝ 掛鉤因為這個原因停用
+}
+
+type soundHooks struct {
+	sink  SoundSink
+	logf  func(string, ...any)
+	Stats SoundStats
+	off   bool
+}
+
+func lin(seg, off uint16) uint32 { return uint32(seg)<<4 + uint32(off) }
+
+// newSoundHooks 逐點比對位元組，任何一處不符就回錯誤（失敗即關閉）。
+func newSoundHooks(m *machine.Machine, sink SoundSink, logf func(string, ...any)) (*soundHooks, error) {
+	for _, e := range soundSites {
+		for i, b := range e.pro {
+			if got := m.Peek8(lin(e.seg, e.off) + uint32(i)); got != b {
+				return nil, fmt.Errorf("聲音掛鉤 %s（%04X:%04X）的位元組不符：偏移 %d 是 %02X，應為 %02X（只支援 MAIN.EXE 的特定映像，docs/spec/007）",
+					e.name, e.seg, e.off, i, got, b)
+			}
+		}
+	}
+	return &soundHooks{sink: sink, logf: logf}, nil
+}
+
+func (h *soundHooks) disable(why string) {
+	h.off = true
+	h.Stats.Disabled = why
+	if h.logf != nil {
+		h.logf("聲音掛鉤停用：%s", why)
+	}
+}
+
+// post 在每道指令執行之後、且該指令的起點在 soundSeg 時呼叫（ip 是該指令的起點，用 Machine.Insn 取得）。
+// 用「剛執行完」而不是「即將執行」是因為 Step 開頭的 tick 可能先插入中斷處理，同一個位址會被看到兩次；
+// Insn 是 tick 之後才記下的起點，每次呼叫恰好看到一次。四個進入點的第一道指令都是 push bp（0x55，
+// 位元組檢查已保證），所以此刻 SP 比進入當下少 2：第一個引數在 SS:SP+6。
+func (h *soundHooks) post(m *machine.Machine, ip uint16) {
+	c := m.CPU
+	switch ip {
+	case sndStart, sndStop, sndFade, sndSFX, sndStatus:
+	default:
+		return
+	}
+	if h.off {
+		return
+	}
+	// 旗標不為 0 代表有人注入了驅動環境：函式本體會碰硬體，本掛鉤的前提不成立。
+	if m.Peek16(lin(soundData, dataFlag)) != 0 {
+		h.disable("聲音旗標 3E24:01B8 不為 0")
+		return
+	}
+	switch ip {
+	case sndStatus:
+		// 剛執行完 mov ax,[01BA]；接著是 and ax,1 與返回。把 bit 0 換成 Sink 的回答。
+		h.Stats.Queries++
+		ax := c.R[cpu.AX] &^ 1
+		if h.sink.Playing() {
+			ax |= 1
+		}
+		c.R[cpu.AX] = ax
+	case sndStart:
+		h.Stats.Starts++
+		off := m.Peek16(lin(soundData, dataMidOff))
+		seg := m.Peek16(lin(soundData, dataMidSeg))
+		a := lin(seg, off)
+		h.Stats.MidAddr = a
+		n := uint32(MidWindow)
+		if a >= machine.MemSize {
+			return
+		}
+		if a+n > machine.MemSize {
+			n = machine.MemSize - a
+		}
+		// 範圍與 VGA 視窗（A0000–AFFFF）相交時略過這次複製並計數：平面模式下讀視窗有 latch 副作用，
+		// 掛鉤的觀察不得改變客體狀態，Peek 對視窗只回 0（資料不對）。MID 緩衝實測在 0xD5000，不會走到這裡。
+		if !(a+n <= vgaWindowLo || a >= vgaWindowHi) {
+			h.Stats.SkippedStarts++
+			return
+		}
+		// 區塊複製。EMS 映射是把頁資料複製進頁框位址（internal/dos/ems.go），所以 Mem 就是客體看到的內容；
+		// 也不觸發讀取監看（成本差異見 docs/re/019 第 2 節的量測）。
+		buf := make([]byte, n)
+		copy(buf, m.Mem[a:a+n])
+		h.sink.MusicStart(buf)
+	case sndStop:
+		// 驅動存在（旗標不為 0）時，原版的停止常式會把目前曲號清為 0FFh（docs/re/010 第 2.1 節）；
+		// 旗標為 0 時那一行被跳過，這裡補上，讓節拍與 sub_286C1 的行為與有驅動時一致。
+		h.Stats.Stops++
+		m.Write8(lin(stateSeg, curTrack), noTrack)
+		h.sink.MusicStop()
+	case sndFade:
+		h.Stats.Fades++
+		arg := m.Peek16(lin(c.Seg[cpu.SS], c.R[cpu.SP]+6))
+		h.sink.MusicFade(int(arg & 0xFF))
+	case sndSFX:
+		h.Stats.SFX++
+		id := int(m.Peek16(lin(c.Seg[cpu.SS], c.R[cpu.SP]+6)))
+		if id < sfxFirstID || id > sfxLastID {
+			h.Stats.BadSFX++
+			return
+		}
+		i := uint16(id-sfxFirstID) * 2
+		start := int(m.Peek16(lin(soundData, dataSFXTab+i)))
+		end := int(m.Peek16(lin(soundData, dataSFXTab+i+2)))
+		if end <= start {
+			h.Stats.BadSFX++
+			return
+		}
+		h.sink.SFX(id, start, end)
+	}
+}
+
+// Sound 回傳聲音掛鉤的計數（沒開時為零值）。只在迴圈停下之後讀。
+func (s *Session) Sound() SoundStats {
+	if s.snd == nil {
+		return SoundStats{}
+	}
+	return s.snd.Stats
+}
