+		run386(t, c, []byte{tc.prefix, 0x8A, 0x07}) // mov al, [bx] 帶段覆寫
+		if c.reg8(0) != 0x5A {
+			t.Errorf("%s 前綴：AL=%02X，預期 5A（走覆寫的段，不是 DS）", tc.name, c.reg8(0))
+		}
+	}
+}
+
+// 0F 在 386 是雙位元組跳脫：只認 FS／GS 的 push／pop，其餘失敗即關閉；
+// 8086 與 80186 維持原行為（0F ＝ POP CS，語料驗證過）。
+func TestEscape0F(t *testing.T) {
+	c := stack386()
+	c.Bus.Write8(Addr(c.Seg[CS], 0), 0x0F)
+	c.Bus.Write8(Addr(c.Seg[CS], 1), 0x05)
+	if err := c.Step(); err == nil {
+		t.Error("0F 05 在 386 子集應該回傳錯誤")
+	}
+	for _, m := range []Model{Model8086, Model80186} {
+		c := stack386()
+		c.Model = m
+		c.write16(c.Seg[SS], c.R[SP]-2, 0x4321)
+		c.R[SP] -= 2
+		c.Bus.Write8(Addr(c.Seg[CS], 0), 0x0F)
+		if err := c.Step(); err != nil || c.Seg[CS] != 0x4321 {
+			t.Errorf("機型 %d：0F 應該是 POP CS（CS=%04X err=%v）", m, c.Seg[CS], err)
+		}
+	}
+}
+
+// 64、65 在 80186 以下不是前綴。
+func TestFSGSPrefixesOnlyOn386(t *testing.T) {
+	c := stack386()
+	c.Model = Model80186
+	c.Bus.Write8(Addr(c.Seg[CS], 0), 0x64)
+	if err := c.Step(); err == nil {
+		t.Error("80186 上 0x64 應該是未實作的 opcode")
+	}
+}
+
+func TestSixteenBitWriteKeepsHighHalves(t *testing.T) {
+	c := stack386()
+	for i := 0; i < 8; i++ {
+		c.Hi[i] = uint16(0x1000 + i)
+	}
+	c.R[AX], c.R[BX] = 0x1111, 0x2222
+	run386(t, c, []byte{0x8B, 0xC3}) // mov ax, bx（16 位元）
+	if c.R[AX] != 0x2222 || c.Hi[AX] != 0x1000 {
+		t.Errorf("16 位元 mov：AX=%04X 高半=%04X，高半應保留 1000", c.R[AX], c.Hi[AX])
+	}
+	run386(t, c, []byte{0x66, 0x8B, 0xC3}) // mov eax, ebx（32 位元）
+	if c.getEAX() != 0x10032222 {
+		t.Errorf("32 位元 mov：EAX=%08X，預期 10032222", c.getEAX())
+	}
+}
