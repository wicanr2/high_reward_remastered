diff --git a/internal/machine/state386_test.go b/internal/machine/state386_test.go
new file mode 100644
index 0000000..9152d2a
--- /dev/null
+++ b/internal/machine/state386_test.go
@@ -0,0 +1,121 @@
+package machine
+
+import (
+	"bytes"
+	"encoding/gob"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+// 386 real mode 的暫存器高半與 FS／GS 要跟著快照、狀態檔、回呼走
+// （hr `docs/spec/001-cpu-386-real-mode-forms` §5、§6.4）。漏掉不會報錯，
+// 還原後的機器看起來正常，只是高半變成 0。
+
+func set386State(m *Machine) {
+	m.CPU.Model = cpu.Model80386
+	for i := 0; i < 8; i++ {
+		m.CPU.R[i] = uint16(0x0100 + i)
+		m.CPU.Hi[i] = uint16(0xA000 + i)
+	}
+	m.CPU.Seg[cpu.FS], m.CPU.Seg[cpu.GS] = 0xFACE, 0xBEEF
+}
+
+func wipe386State(m *Machine) {
+	m.CPU.Hi = [8]uint16{}
+	m.CPU.Seg[cpu.FS], m.CPU.Seg[cpu.GS] = 0, 0
+}
+
+func check386State(t *testing.T, what string, m *Machine) {
+	t.Helper()
+	for i := 0; i < 8; i++ {
+		if m.CPU.Hi[i] != uint16(0xA000+i) {
+			t.Errorf("%s：暫存器 %d 高半 %04X，預期 %04X", what, i, m.CPU.Hi[i], 0xA000+i)
+		}
+	}
+	if m.CPU.Seg[cpu.FS] != 0xFACE || m.CPU.Seg[cpu.GS] != 0xBEEF {
+		t.Errorf("%s：FS=%04X GS=%04X，預期 FACE BEEF", what, m.CPU.Seg[cpu.FS], m.CPU.Seg[cpu.GS])
+	}
+}
+
+func TestSnapshotKeepsHiAndFSGS(t *testing.T) {
+	m := New()
+	set386State(m)
+	snap := m.Snapshot()
+	wipe386State(m)
+	m.Restore(snap)
+	check386State(t, "快照還原", m)
+}
+
+func TestStateFileKeepsHiAndFSGS(t *testing.T) {
+	m := New()
+	set386State(m)
+	var buf bytes.Buffer
+	if err := m.SaveState(&buf); err != nil {
+		t.Fatal(err)
+	}
+	m2 := New()
+	if err := m2.LoadState(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatal(err)
+	}
+	check386State(t, "狀態檔來回", m2)
+	if m2.CPU.R != m.CPU.R || m2.CPU.Seg != m.CPU.Seg {
+		t.Errorf("狀態檔來回後 R 或 Seg 不同：%v %v", m2.CPU.R, m2.CPU.Seg)
+	}
+}
+
+func TestCallbackKeepsHiAndFSGS(t *testing.T) {
+	m := New()
+	m.Write8(0x3000*16, 0xCB) // retf
+	set386State(m)
+	m.QueueCallback(QueuedCall{Seg: 0x3000, Off: 0})
+	if !m.startCallback() {
+		t.Fatal("回呼沒有送出去")
+	}
+	wipe386State(m) // 回呼常式裡把它們弄髒
+	if !m.FinishCallback() {
+		t.Fatal("回呼沒有收尾")
+	}
+	check386State(t, "回呼還原", m)
+}
+
+// v2 檔沒有新欄位：載入成功且新欄位為 0；版本不在 2 至 3 之間就拒絕。
+func TestStateFileVersions(t *testing.T) {
+	m := New()
+	set386State(m)
+	var buf bytes.Buffer
+	if err := m.SaveState(&buf); err != nil {
+		t.Fatal(err)
+	}
+	var s machineState
+	if err := gob.NewDecoder(bytes.NewReader(buf.Bytes())).Decode(&s); err != nil {
+		t.Fatal(err)
+	}
+	if s.Version != 3 {
+		t.Fatalf("寫出的版本是 %d，預期 3", s.Version)
+	}
+	encode := func(s machineState) *bytes.Reader {
+		var b bytes.Buffer
+		if err := gob.NewEncoder(&b).Encode(&s); err != nil {
+			t.Fatal(err)
+		}
+		return bytes.NewReader(b.Bytes())
+	}
+	v2 := s
+	v2.Version, v2.FS, v2.GS, v2.Hi = 2, 0, 0, [8]uint16{}
+	m2 := New()
+	set386State(m2)
+	if err := m2.LoadState(encode(v2)); err != nil {
+		t.Fatalf("v2 狀態檔應該可載入：%v", err)
+	}
+	if m2.CPU.Hi != [8]uint16{} || m2.CPU.Seg[cpu.FS] != 0 || m2.CPU.Seg[cpu.GS] != 0 {
+		t.Errorf("v2 檔沒有新欄位，載入後高半與 FS／GS 應為 0：%v %04X %04X", m2.CPU.Hi, m2.CPU.Seg[cpu.FS], m2.CPU.Seg[cpu.GS])
+	}
+	for _, v := range []int{1, 4} {
+		bad := s
+		bad.Version = v
+		if err := New().LoadState(encode(bad)); err == nil {
+			t.Errorf("版本 %d 應該被拒絕", v)
+		}
+	}
+}
