new file mode 100644
index 0000000..373ad4f
--- /dev/null
+++ b/internal/dos/state386_test.go
@@ -0,0 +1,77 @@
+package dos
+
+import (
+	"bytes"
+	"encoding/gob"
+	"testing"
+)
+
+// EXEC 暫停的父行程框要保存暫存器高半與 FS／GS（hr `docs/spec/001-cpu-386-real-mode-forms` §5）。
+func TestStateKeepsProcFrameHiAndFSGS(t *testing.T) {
+	d := newAt(t, t.TempDir())
+	frame := procFrame{
+		r:   [8]uint16{1, 2, 3, 4, 5, 6, 7, 8},
+		hi:  [8]uint16{0xA1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7, 0xA8},
+		seg: [6]uint16{0x1000, 0x2000, 0x3000, 0x4000, 0xFACE, 0xBEEF},
+		ip:  0x1234, fl: 0x0202, psp: 0x0100, freeSeg: 0x2000,
+	}
+	d.procStack = []procFrame{frame}
+	var buf bytes.Buffer
+	if err := d.SaveState(&buf); err != nil {
+		t.Fatal(err)
+	}
+	d2 := newAt(t, t.TempDir())
+	if err := d2.LoadState(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatal(err)
+	}
+	if len(d2.procStack) != 1 || d2.procStack[0] != frame {
+		t.Errorf("父行程框來回後不同：%+v，預期 %+v", d2.procStack, frame)
+	}
+}
+
+func TestStateFileVersions(t *testing.T) {
+	d := newAt(t, t.TempDir())
+	d.procStack = []procFrame{{
+		hi:  [8]uint16{9, 9, 9, 9, 9, 9, 9, 9},
+		seg: [6]uint16{1, 2, 3, 4, 5, 6},
+	}}
+	var buf bytes.Buffer
+	if err := d.SaveState(&buf); err != nil {
+		t.Fatal(err)
+	}
+	var s dosState
+	if err := gob.NewDecoder(bytes.NewReader(buf.Bytes())).Decode(&s); err != nil {
+		t.Fatal(err)
+	}
+	if s.Version != 3 {
+		t.Fatalf("寫出的版本是 %d，預期 3", s.Version)
+	}
+	encode := func(s dosState) *bytes.Reader {
+		var b bytes.Buffer
+		if err := gob.NewEncoder(&b).Encode(&s); err != nil {
+			t.Fatal(err)
+		}
+		return bytes.NewReader(b.Bytes())
+	}
+	v2 := s
+	v2.Version = 2
+	v2.Stack = append([]procState(nil), s.Stack...)
+	for i := range v2.Stack {
+		v2.Stack[i].FS, v2.Stack[i].GS, v2.Stack[i].Hi = 0, 0, [8]uint16{}
+	}
+	d2 := newAt(t, t.TempDir())
+	if err := d2.LoadState(encode(v2)); err != nil {
+		t.Fatalf("v2 狀態檔應該可載入：%v", err)
+	}
+	f := d2.procStack[0]
+	if f.hi != [8]uint16{} || f.seg[4] != 0 || f.seg[5] != 0 || f.seg[0] != 1 || f.seg[3] != 4 {
+		t.Errorf("v2 檔載入後：hi=%v seg=%v，預期新欄位為 0、ES..DS 保留", f.hi, f.seg)
+	}
+	for _, v := range []int{1, 4} {
+		bad := s
+		bad.Version = v
+		if err := newAt(t, t.TempDir()).LoadState(encode(bad)); err == nil {
+			t.Errorf("版本 %d 應該被拒絕", v)
+		}
+	}
+}
