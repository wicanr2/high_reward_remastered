+// 386 real mode 形式的單元測試（hr 專案 `docs/spec/001-cpu-386-real-mode-forms` §6.3）。
+//
+// 不含任何原版位元組。期望值由人工依 Intel 386 手冊與語料行為逐列寫出，
+// 不以實作輸出回填。語料（SingleStepTests/80386）驗收在 `sst386_test.go`。
+
+// stack386 造一顆 386，堆疊放在 2000:1000，與程式碼段不重疊。
+func stack386() *CPU {
+	c, _ := new386()
+	c.Seg[SS], c.R[SP] = 0x2000, 0x1000
+	// New 以 8086 的旗標遮罩重置（位元 12 至 15 恆為 1）；機型切到 386 之後要重設一次，
+	// 否則第一次 popfd 會把位元 15 清掉，與真實 386 的狀態不同。
+	c.SetFlags(0)
+	return c
+}
+
+// 標準的 CPU 型號偵測序列（386 與 486 以上靠 EFLAGS 的 AC 位元區分）。
+// AC 不可寫（386）時，最後的 XOR 結果為 0。
+func TestCPUDetectionSequence386(t *testing.T) {
+	c := stack386()
+	for _, ins := range [][]byte{
+		{0x66, 0x9C},                         // pushfd
+		{0x66, 0x58},                         // pop eax
+		{0x66, 0x8B, 0xC8},                   // mov ecx, eax
+		{0x66, 0x35, 0x00, 0x00, 0x04, 0x00}, // xor eax, 40000h
+		{0x66, 0x50},                         // push eax
+		{0x66, 0x9D},                         // popfd
+		{0x66, 0x9C},                         // pushfd
+		{0x66, 0x58},                         // pop eax
+		{0x66, 0x33, 0xC1},                   // xor eax, ecx
+	} {
+		run386(t, c, ins)
+	}
+	if got := c.getEAX(); got != 0 {
+		t.Errorf("偵測序列結果 EAX=%08X，386（AC 不可寫）預期 0", got)
+	}
+	if !c.Flag(ZF) {
+		t.Error("xor 結果為 0，ZF 應該設起來")
+	}
+	if c.R[SP] != 0x1000 {
+		t.Errorf("序列結束後 SP=%04X，預期回到 1000", c.R[SP])
+	}
+}
+
