+		}
+		if c.Flag(SF) != k.sf || c.Flag(ZF) != k.zf || c.Flag(PF) != k.pf {
+			t.Errorf("%s：SF=%v ZF=%v PF=%v，預期 %v %v %v", k.name, c.Flag(SF), c.Flag(ZF), c.Flag(PF), k.sf, k.zf, k.pf)
