+		run386(t, c, []byte{0x66, 0xC1, 0xE8, n})
+		if c.getEAX() != 0x12345678 || c.Flags != before {
+			t.Errorf("shr 移位數 %d：結果 %08X 旗標 %04X，預期不變（%04X）", n, c.getEAX(), c.Flags, before)
+		}
+	}
+}
