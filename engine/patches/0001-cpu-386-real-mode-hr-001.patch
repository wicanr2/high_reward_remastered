diff --git a/internal/cpu/sst386_test.go b/internal/cpu/sst386_test.go
new file mode 100644
index 0000000..4a1b44a
--- /dev/null
+++ b/internal/cpu/sst386_test.go
@@ -0,0 +1,289 @@
+package cpu
+
+// SingleStepTests/80386（real mode）驗收：`docs/spec/001-cpu-386-real-mode-forms`（hr 專案）。
+//
+// 每個測試是「一道指令加 HLT」。照語料 README 的用法：載入初始暫存器與記憶體，從 CS:IP 起跑
+// 一道指令（Step 一次），比對最終暫存器、被列出的記憶體位元組，並確認沒有寫到沒列出的位址。
+// 週期、匯流排狀態不比。
+//
+// 契約（規格 §6.1）：
+//   - Step 回傳錯誤、暫存器或記憶體不符、多寫、讀到沒列出的位址，一律算失敗。
+//   - 只排除兩類，逐檔計數、不靜默：excp（測試含 EXCP 子區塊，硬體產生了例外，本 CPU 不做例外）、
+//     revoked（HASH 在語料的 revocation_list.txt）。
+//   - 暫存器遮罩只用語料附的 RM32（檔案層級與單筆最終狀態，兩者都有時取交集），
+//     加上唯一一條明文規則：eflags 只比對位元 0 至 17。語料的 INIT／FINA eflags 位元 18 至 31 恆為 1，
+//     與指令和彈出值都無關（SMM dump 的假象，見規格 §4.7）。
+//   - 記憶體是平坦的稀疏位址空間，不做 A20 折返（語料假設 A20 開啟）。
+//   - DOSGOLEM_SST386_REQUIRE=1 時，缺語料目錄或缺檔算失敗；否則 skip（驗收一律用 REQUIRE=1）。
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// sst386Forms 是規格 §6.1 列出的語料檔。
+var sst386Forms = []string{
+	"668B", "669C", "669D",
+	"6650", "6651", "6652", "6653", "6654", "6655", "6656", "6657",
+	"6658", "6659", "665A", "665B", "665C", "665D", "665E", "665F",
+	"6633", "6635", "66C1.5", "6660", "6661",
+	"0FA0", "0FA1", "0FA8", "0FA9", "8C", "8E",
+}
+
+const sstEflagsMask = 0x0003FFFF
+
+func sst386Dir() string {
+	for _, d := range []string{
+		os.Getenv("DOSGOLEM_SST386"),
+		"testdata/80386/v1_ex_real_mode",
+		"/orig/testdata/80386/v1_ex_real_mode",
+	} {
+		if d == "" {
+			continue
+		}
+		if st, err := os.Stat(d); err == nil && st.IsDir() {
+			return d
+		}
+	}
+	return ""
+}
+
+type sstBus struct {
+	mem     map[uint32]uint8
+	init    map[uint32]uint8
+	written map[uint32]struct{}
+	badRead map[uint32]struct{}
+}
+
+func (b *sstBus) Read8(a uint32) uint8 {
+	v, ok := b.mem[a]
+	if !ok {
+		b.badRead[a] = struct{}{}
+	}
+	return v
+}
+func (b *sstBus) Write8(a uint32, v uint8) { b.mem[a] = v; b.written[a] = struct{}{} }
+func (b *sstBus) In8(uint16) uint8         { return 0xFF }
+func (b *sstBus) Out8(uint16, uint8)       {}
+
+var sstGP = [...]struct {
+	name string
+	idx  int
+}{{"eax", AX}, {"ebx", BX}, {"ecx", CX}, {"edx", DX}, {"esi", SI}, {"edi", DI}, {"ebp", BP}, {"esp", SP}}
+
+var sstSeg = [...]struct {
+	name string
+	idx  int
+}{{"cs", CS}, {"ds", DS}, {"es", ES}, {"fs", FS}, {"gs", GS}, {"ss", SS}}
+
+func sstLoad(c *CPU, regs map[string]uint32) {
+	for _, g := range sstGP {
+		v := regs[g.name]
+		c.R[g.idx], c.Hi[g.idx] = uint16(v), uint16(v>>16)
+	}
+	for _, s := range sstSeg {
+		c.Seg[s.idx] = uint16(regs[s.name])
+	}
+	c.IP = uint16(regs["eip"])
+	c.Flags = uint16(regs["eflags"])
+}
+
+func sstDump(c *CPU) map[string]uint32 {
+	m := map[string]uint32{}
+	for _, g := range sstGP {
+		m[g.name] = uint32(c.R[g.idx]) | uint32(c.Hi[g.idx])<<16
+	}
+	for _, s := range sstSeg {
+		m[s.name] = uint32(c.Seg[s.idx])
+	}
+	m["eip"] = uint32(c.IP)
+	m["eflags"] = uint32(c.Flags)
+	return m
+}
+
+type sstResult struct {
+	total, ran, excp, revoked, fail int
+	firstFails                      []string
+}
+
+// runMOOTest 回傳 (失敗訊息, 排除類別)。兩者皆空表示通過。
+func runMOOTest(mf *mooFile, rev map[string]bool, t *mooTest) (failMsg string, skipped string) {
+	if t.excp {
+		return "", "excp"
+	}
+	if rev[t.hash] {
+		return "", "revoked"
+	}
+	bus := &sstBus{mem: map[uint32]uint8{}, init: map[uint32]uint8{}, written: map[uint32]struct{}{}, badRead: map[uint32]struct{}{}}
+	for _, r := range t.init.ram {
+		bus.mem[r.addr] = r.val
+		bus.init[r.addr] = r.val
+	}
+	c := New(bus)
+	c.Model = Model80386
+	sstLoad(c, t.init.regs)
+	if err := c.Step(); err != nil {
+		return fmt.Sprintf("%s [% X]: Step 失敗：%v", t.name, t.bytes, err), ""
+	}
+	// 語料每個測試是「被測指令加一道 F4（HLT）」，FINA 的 eip 落在 HLT 之後（規格 §6.1）。
+	if op := bus.Read8(Linear(c.Seg[CS], c.IP)); op != 0xF4 {
+		return fmt.Sprintf("%s [% X]: 被測指令之後的位元組是 %02X，不是 HLT（F4）", t.name, t.bytes, op), ""
+	}
+	if err := c.Step(); err != nil || !c.Halted {
+		return fmt.Sprintf("%s [% X]: 執行 HLT 失敗（err=%v halted=%v）", t.name, t.bytes, err, c.Halted), ""
+	}
+	want := map[string]uint32{}
+	for k, v := range t.init.regs {
+		want[k] = v
+	}
+	for k, v := range t.final.regs {
+		want[k] = v
+	}
+	got := sstDump(c)
+	var diffs []string
+	check := func(name string) {
+		mask := uint32(0xFFFFFFFF)
+		if m, ok := mf.topMasks[name]; ok {
+			mask &= m
+		}
+		if m, ok := t.final.masks[name]; ok {
+			mask &= m
+		}
+		switch {
+		case name == "eflags":
+			mask &= sstEflagsMask
+		case name == "eip" || len(name) == 2 && strings.HasSuffix(name, "s"):
+			mask &= 0xFFFF
+		}
+		w, g := want[name], got[name]
+		if w&mask != g&mask {
+			diffs = append(diffs, fmt.Sprintf("%s 期望 %08X 實得 %08X（遮罩 %08X）", name, w&mask, g&mask, mask))
+		}
+	}
+	for _, g := range sstGP {
+		check(g.name)
+	}
+	for _, s := range sstSeg {
+		check(s.name)
+	}
+	check("eip")
+	check("eflags")
+	finalRAM := map[uint32]uint8{}
+	for _, r := range t.final.ram {
+		finalRAM[r.addr] = r.val
+		if g, ok := bus.mem[r.addr]; !ok || g != r.val {
+			diffs = append(diffs, fmt.Sprintf("記憶體 %06X 期望 %02X 實得 %02X", r.addr, r.val, g))
+		}
+	}
+	var extra []uint32
+	for a := range bus.written {
+		_, inInit := bus.init[a]
+		_, inFinal := finalRAM[a]
+		switch {
+		case !inInit && !inFinal: // 寫到 INIT 與 FINA 都沒列出的位址（含寫入 0）
+			extra = append(extra, a)
+		case inInit && !inFinal && bus.mem[a] != bus.init[a]: // 列在 INIT 但 FINA 說沒變，實際改了
+			extra = append(extra, a)
+		}
+	}
+	sort.Slice(extra, func(i, j int) bool { return extra[i] < extra[j] })
+	for _, a := range extra {
+		diffs = append(diffs, fmt.Sprintf("多寫了未列出的位址 %06X（%02X→%02X）", a, bus.init[a], bus.mem[a]))
+	}
+	var bad []uint32
+	for a := range bus.badRead {
+		if _, listed := bus.init[a]; !listed {
+			bad = append(bad, a)
+		}
+	}
+	sort.Slice(bad, func(i, j int) bool { return bad[i] < bad[j] })
+	if len(bad) > 0 {
+		diffs = append(diffs, fmt.Sprintf("讀了未列出的位址 %06X 等 %d 處", bad[0], len(bad)))
+	}
+	if len(diffs) > 0 {
+		return fmt.Sprintf("%s [% X]: %s", t.name, t.bytes, strings.Join(diffs, "；")), ""
+	}
+	return "", ""
+}
+
+func TestSST386(t *testing.T) {
+	require := os.Getenv("DOSGOLEM_SST386_REQUIRE") == "1"
+	dir := sst386Dir()
+	if dir == "" {
+		if require {
+			t.Fatal("沒有 SingleStepTests/80386 語料目錄（DOSGOLEM_SST386_REQUIRE=1）")
+		}
+		t.Skip("沒有 SingleStepTests/80386 語料（hr 專案 tools/fetch_sst386.sh；或設 DOSGOLEM_SST386）")
+	}
+	rev, revOK := readRevocation(dir)
+	if require && !revOK {
+		t.Fatal("缺語料的 revocation_list.txt（DOSGOLEM_SST386_REQUIRE=1）")
+	}
+	only := os.Getenv("DOSGOLEM_SST386_ONLY")
+	if require && only != "" {
+		t.Fatal("DOSGOLEM_SST386_REQUIRE=1 時不接受 DOSGOLEM_SST386_ONLY 篩選")
+	}
+	var sum sstResult
+	for _, name := range sst386Forms {
+		if only != "" && !strings.Contains(","+only+",", ","+name+",") {
+			continue
+		}
+		name := name
+		t.Run(name, func(t *testing.T) {
+			path := mooPath(dir, name)
+			if _, err := os.Stat(path); err != nil {
+				if require {
+					t.Fatalf("缺語料檔 %s（DOSGOLEM_SST386_REQUIRE=1）", path)
+				}
+				t.Skipf("缺語料檔 %s", path)
+			}
+			mf, err := readMOO(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mf.cpuID != "386E" || !mf.hasMeta || mf.cpuMode != 0 {
+				t.Fatalf("%s：語料不是 386EX real mode（CPU ID %q，META %v，cpu_mode %d）", name, mf.cpuID, mf.hasMeta, mf.cpuMode)
+			}
+			if len(mf.tests) == 0 {
+				t.Fatalf("%s：語料內沒有測試", name)
+			}
+			res := sstResult{total: len(mf.tests)}
+			for i := range mf.tests {
+				fm, sk := runMOOTest(mf, rev, &mf.tests[i])
+				switch {
+				case sk == "excp":
+					res.excp++
+				case sk == "revoked":
+					res.revoked++
+				case fm != "":
+					res.ran++
+					res.fail++
+					if len(res.firstFails) < 5 {
+						res.firstFails = append(res.firstFails, fm)
+					}
+				default:
+					res.ran++
+				}
+			}
+			t.Logf("RECEIPT %-7s 總數 %4d 執行 %4d 失敗 %3d 排除 excp=%d revoked=%d", name, res.total, res.ran, res.fail, res.excp, res.revoked)
+			sum.total += res.total
+			sum.ran += res.ran
+			sum.fail += res.fail
+			sum.excp += res.excp
+			sum.revoked += res.revoked
+			for _, m := range res.firstFails {
+				t.Error(m)
+			}
+			if res.fail > 0 {
+				t.Errorf("%s：%d 個測試失敗", name, res.fail)
+			}
+			if res.ran*10 < res.total*9 {
+				t.Errorf("%s：有效測試 %d 少於總數 %d 的 90%%，排除過多", name, res.ran, res.total)
+			}
+		})
+	}
+	t.Logf("RECEIPT 合計 總數 %d 執行 %d 失敗 %d 排除 excp=%d revoked=%d", sum.total, sum.ran, sum.fail, sum.excp, sum.revoked)
+}
