diff --git a/internal/cpu/moo_test.go b/internal/cpu/moo_test.go
new file mode 100644
index 0000000..1597315
--- /dev/null
+++ b/internal/cpu/moo_test.go
@@ -0,0 +1,226 @@
+package cpu
+
+// SingleStepTests/80386 的 MOO 格式讀檔器（只給測試用）。
+//
+// 格式說明：https://github.com/dbalsom/moo `doc/moo_format_v1.md`（MOO 1.1）。
+// 語料是真實 386EX 產生的 real mode 單步測試，授權是語料自己的，不隨本儲存庫散布：
+// 用 hr 專案的 `tools/fetch_sst386.sh` 抓到 `testdata/80386/v1_ex_real_mode/`，
+// 或以 DOSGOLEM_SST386 指到該目錄。缺檔時測試 skip，不用替代品。
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// readRevocation 讀語料的 revocation_list.txt：每行一個測試 HASH（十六進位），`#` 開頭是註解。
+// 檔案在 v1_ex_real_mode 的上一層。缺檔回傳空集合與 false（REQUIRE 模式視為失敗）。
+func readRevocation(dir string) (map[string]bool, bool) {
+	out := map[string]bool{}
+	b, err := os.ReadFile(filepath.Join(filepath.Dir(dir), "revocation_list.txt"))
+	if err != nil {
+		return out, false
+	}
+	for _, ln := range strings.Split(string(b), "\n") {
+		ln = strings.ToLower(strings.TrimSpace(ln))
+		if ln == "" || strings.HasPrefix(ln, "#") {
+			continue
+		}
+		out[ln] = true
+	}
+	return out, true
+}
+
+// RG32／RM32 的暫存器順序（bit 0 起）。
+var mooRegNames = [...]string{
+	"cr0", "cr3", "eax", "ebx", "ecx", "edx", "esi", "edi", "ebp", "esp",
+	"cs", "ds", "es", "fs", "gs", "ss", "eip", "eflags", "dr6", "dr7",
+}
+
+type mooRAM struct {
+	addr uint32
+	val  uint8
+}
+
+type mooState struct {
+	regs  map[string]uint32 // RG32：初始狀態是全部，最終狀態只有被改動的
+	masks map[string]uint32 // RM32：最終狀態的遮罩（1 ＝ 要比對）；沒有的暫存器全比
+	ram   []mooRAM
+}
+
+type mooTest struct {
+	idx   uint32
+	name  string
+	bytes []byte
+	init  mooState
+	final mooState
+	excp  bool   // 有 EXCP 子區塊：硬體產生了例外
+	hash  string // HASH 子區塊（SHA-1，十六進位小寫），對照語料的 revocation_list.txt
+}
+
+type mooFile struct {
+	cpuID     string
+	topMasks  map[string]uint32 // 檔案層級的 RM32，套用到每一個測試
+	tests     []mooTest
+	testCount uint32
+	hasMeta   bool
+	cpuMode   uint8 // META 的 cpu_mode：real mode ＝ 0
+}
+
+func mooPath(dir, name string) string { return filepath.Join(dir, name+".MOO.gz") }
+
+func readMOO(path string) (*mooFile, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	zr, err := gzip.NewReader(f)
+	if err != nil {
+		return nil, err
+	}
+	data, err := io.ReadAll(zr)
+	if err != nil {
+		return nil, err
+	}
+	return parseMOO(data)
+}
+
+type mooChunk struct {
+	typ  string
+	data []byte
+}
+
+// mooChunks 把一段位元組切成同層的 chunk 清單。
+func mooChunks(b []byte) ([]mooChunk, error) {
+	var out []mooChunk
+	for len(b) > 0 {
+		if len(b) < 8 {
+			return nil, fmt.Errorf("moo: chunk 標頭不完整（剩 %d bytes）", len(b))
+		}
+		n := binary.LittleEndian.Uint32(b[4:8])
+		if uint64(n) > uint64(len(b)-8) {
+			return nil, fmt.Errorf("moo: chunk %q 長度 %d 超出剩餘 %d", b[:4], n, len(b)-8)
+		}
+		out = append(out, mooChunk{typ: string(b[:4]), data: b[8 : 8+n]})
+		b = b[8+n:]
+	}
+	return out, nil
+}
+
+func parseRG32(b []byte) (map[string]uint32, error) {
+	if len(b) < 4 {
+		return nil, fmt.Errorf("moo: RG32/RM32 太短")
+	}
+	mask := binary.LittleEndian.Uint32(b)
+	b = b[4:]
+	out := map[string]uint32{}
+	for i, name := range mooRegNames {
+		if mask>>uint(i)&1 == 0 {
+			continue
+		}
+		if len(b) < 4 {
+			return nil, fmt.Errorf("moo: RG32/RM32 缺 %s", name)
+		}
+		out[name] = binary.LittleEndian.Uint32(b)
+		b = b[4:]
+	}
+	return out, nil
+}
+
+func parseState(b []byte) (mooState, error) {
+	st := mooState{regs: map[string]uint32{}}
+	cs, err := mooChunks(b)
+	if err != nil {
+		return st, err
+	}
+	for _, c := range cs {
+		switch c.typ {
+		case "RG32":
+			if st.regs, err = parseRG32(c.data); err != nil {
+				return st, err
+			}
+		case "RM32":
+			if st.masks, err = parseRG32(c.data); err != nil {
+				return st, err
+			}
+		case "RAM ":
+			n := binary.LittleEndian.Uint32(c.data)
+			d := c.data[4:]
+			if uint64(len(d)) < uint64(n)*5 {
+				return st, fmt.Errorf("moo: RAM 項目不足")
+			}
+			for i := uint32(0); i < n; i++ {
+				st.ram = append(st.ram, mooRAM{binary.LittleEndian.Uint32(d[i*5:]), d[i*5+4]})
+			}
+		}
+	}
+	return st, nil
+}
+
+func parseMOO(data []byte) (*mooFile, error) {
+	top, err := mooChunks(data)
+	if err != nil {
+		return nil, err
+	}
+	mf := &mooFile{}
+	for _, c := range top {
+		switch c.typ {
+		case "MOO ":
+			if len(c.data) < 12 {
+				return nil, fmt.Errorf("moo: 檔頭太短")
+			}
+			mf.testCount = binary.LittleEndian.Uint32(c.data[4:8])
+			mf.cpuID = string(c.data[8:12])
+		case "META":
+			// major(1) minor(1) cpu_type(1) opcode(4) mnemonic(8) test_ct(4) file_seed(8) cpu_mode(1)
+			if len(c.data) > 27 {
+				mf.hasMeta = true
+				mf.cpuMode = c.data[27]
+			}
+		case "RM32":
+			if mf.topMasks, err = parseRG32(c.data); err != nil {
+				return nil, err
+			}
+		case "TEST":
+			t := mooTest{idx: binary.LittleEndian.Uint32(c.data)}
+			subs, err := mooChunks(c.data[4:])
+			if err != nil {
+				return nil, err
+			}
+			for _, s := range subs {
+				switch s.typ {
+				case "NAME":
+					n := binary.LittleEndian.Uint32(s.data)
+					t.name = string(s.data[4 : 4+n])
+				case "BYTS":
+					n := binary.LittleEndian.Uint32(s.data)
+					t.bytes = bytes.Clone(s.data[4 : 4+n])
+				case "INIT":
+					if t.init, err = parseState(s.data); err != nil {
+						return nil, err
+					}
+				case "FINA":
+					if t.final, err = parseState(s.data); err != nil {
+						return nil, err
+					}
+				case "EXCP":
+					t.excp = true
+				case "HASH":
+					t.hash = hex.EncodeToString(s.data)
+				}
+			}
+			mf.tests = append(mf.tests, t)
+		}
+	}
+	if mf.testCount != 0 && int(mf.testCount) != len(mf.tests) {
+		return nil, fmt.Errorf("moo: 標頭宣告 %d 個測試，實際 %d", mf.testCount, len(mf.tests))
+	}
+	return mf, nil
+}
diff --git a/internal/cpu/ops.go b/internal/cpu/ops.go
index f149a77..f4e9865 100644
--- a/internal/cpu/ops.go
+++ b/internal/cpu/ops.go
@@ -36,6 +36,15 @@ func (c *CPU) Step() error {
 			c.segOverride = DS
 			c.charge(cycPrefix)
 			continue
+		case 0x64, 0x65:
+			// FS／GS 段覆寫只在 80386 存在（hr `docs/spec/001-cpu-386-real-mode-forms` §4.2）。
+			// 更低的機型落進 execute：8086 把它們當條件跳躍的別名（語料行為），
+			// 80186 報「未實作」。
+			if c.Model >= Model80386 {
+				c.segOverride = FS + int(op-0x64)
+				c.charge(cycPrefix)
+				continue
+			}
 		case 0x66:
 			// operand-size 前綴只在 80386 存在（`docs/spec/012`）。
 			// 80186 及以下落進 execute：8086 把它當 76h 的別名
@@ -77,6 +86,10 @@ func (c *CPU) execute(op uint8) error {
 	case op == 0x0E:
 		c.push(c.Seg[CS])
 	case op == 0x0F:
+		if c.Model >= Model80386 {
+			// 386 的 0F 是雙位元組 opcode 的跳脫位元組（hr `docs/spec/001` §4.3）。
+			return c.execute0F()
+		}
 		// **8086 的 0F 是 POP CS**，不是雙位元組前綴。
 		c.Seg[CS] = c.pop()
 	case op == 0x16:
@@ -160,6 +173,14 @@ func (c *CPU) execute(op uint8) error {
 		c.R[m.reg] = c.get16(m.rm)
 	case op == 0x8C: // MOV r/m16, Sreg
 		m := c.decodeModRM()
+		if c.Model >= Model80386 {
+			// 386：reg 4、5 是 FS、GS；6、7 是 #UD，本 CPU 不做例外，失敗即關閉。
+			if m.reg > GS {
+				return c.errf(op, "8C /%d：386 的 #UD，未實作", m.reg)
+			}
+			c.set16(m.rm, c.Seg[m.reg])
+			break
+		}
 		c.set16(m.rm, c.Seg[m.reg&3])
 	case op == 0x8D: // LEA r16, m
 		m := c.decodeModRM()
@@ -169,6 +190,13 @@ func (c *CPU) execute(op uint8) error {
 	case op == 0x8E: // MOV Sreg, r/m16
 		c.charge(cycFar)
 		m := c.decodeModRM()
+		if c.Model >= Model80386 {
+			if m.reg > GS {
+				return c.errf(op, "8E /%d：386 的 #UD，未實作", m.reg)
+			}
+			c.Seg[m.reg] = c.get16(m.rm)
+			break
+		}
 		c.Seg[m.reg&3] = c.get16(m.rm)
 	case op == 0x8F: // POP r/m16
 		m := c.decodeModRM()
diff --git a/internal/cpu/ops386.go b/internal/cpu/ops386.go
index 4801d19..d7219e3 100644
--- a/internal/cpu/ops386.go
+++ b/internal/cpu/ops386.go
@@ -2,91 +2,210 @@ package cpu
 
 import "fmt"
 
-// 80386 最小子集（`docs/spec/012`）：0x66 operand-size 前綴。
+// 80386 real mode 的一小套形式。
 //
-// **指令清單是掃出來的，不是照手冊列的**——只有 DOSJP.COM 實際用到的
-// 六道（CWDE／SHL EAX,imm8／MOV EAX,m16／MOV m16,EAX／MOV [m16],imm32，
-// 加上段前綴的組合）。其他 opcode 帶 0x66 一樣報「未實作」——
-// 靜靜放行才會讓錯誤看不見。
+// 範圍、語意與驗收：hr 專案 `docs/spec/001-cpu-386-real-mode-forms`（READY），
+// 以 SingleStepTests/80386 的 v1_ex_real_mode（真實 386EX）逐檔驗收。
+// 最早的 EAX 子集（DOSJP.COM 的六道指令）見 `docs/spec/012`，行為保留。
 //
-// EAX 的表示：`R[AX]` 是低半、`EAXHi` 是高半。**16 位元寫 AX 不清高半**
-// （386 的行為）。
+// **指令清單是掃出來的，不是照手冊列的**：只有規格 §3.1 的形式。
+// 其他 opcode 帶 0x66 一樣報「未實作」——靜靜放行才會讓錯誤看不見。
+//
+// 暫存器：`R[i]` 是低半、`Hi[i]` 是高半。**16 位元寫入不清高半**（386 的行為）。
+
+func (c *CPU) getR32(i int) uint32 { return uint32(c.R[i]) | uint32(c.Hi[i])<<16 }
+
+func (c *CPU) setR32(i int, v uint32) {
+	c.R[i] = uint16(v)
+	c.Hi[i] = uint16(v >> 16)
+}
+
+func (c *CPU) getEAX() uint32  { return c.getR32(AX) }
+func (c *CPU) setEAX(v uint32) { c.setR32(AX, v) }
+func (c *CPU) fetch32() uint32 { lo := uint32(c.fetch16()); return lo | uint32(c.fetch16())<<16 }
+func (c *CPU) read32(seg, off uint16) uint32 {
+	return uint32(c.read16(seg, off)) | uint32(c.read16(seg, off+2))<<16
+}
+
+func (c *CPU) write32(seg, off uint16, v uint32) {
+	c.write16(seg, off, uint16(v))
+	c.write16(seg, off+2, uint16(v>>16))
+}
+
+func (c *CPU) get32(o operand) uint32 {
+	if o.isReg {
+		return c.getR32(o.reg)
+	}
+	return c.read32(o.seg, o.off)
+}
+
+func (c *CPU) set32(o operand, v uint32) {
+	if o.isReg {
+		c.setR32(o.reg, v)
+		return
+	}
+	c.write32(o.seg, o.off, v)
+}
+
+// push32／pop32：堆疊每格 4 bytes，SP 以 16 位元計算（real mode 的 16 位元堆疊）。
+// 只動 SP 的低半，ESP 的高半不變。
+func (c *CPU) push32(v uint32) {
+	c.charge(cycStack)
+	c.R[SP] -= 4
+	c.write32(c.Seg[SS], c.R[SP], v)
+}
+
+func (c *CPU) pop32() uint32 {
+	c.charge(cycStack)
+	v := c.read32(c.Seg[SS], c.R[SP])
+	c.R[SP] += 4
+	return v
+}
 
-func (c *CPU) getEAX() uint32 { return uint32(c.R[AX]) | uint32(c.EAXHi)<<16 }
+// logic32Flags 設邏輯運算（xor）的旗標：CF＝OF＝0，SF、ZF、PF 依結果。
+// AF 未定義，這裡清成 0，語料用 RM32 遮罩處理。
+func (c *CPU) logic32Flags(res uint32) {
+	c.setFlag(CF, false)
+	c.setFlag(OF, false)
+	c.setFlag(AF, false)
