+func TestShift32Flags(t *testing.T) {
+	type tc struct {
+		name       string
+		modrm      byte // E8 ＝ shr eax；E0 ＝ shl eax
+		v          uint32
+		n          byte
+		want       uint32
+		cf, of     bool
+		checkOF    bool // 只有移位數遮罩後為 1 時 OF 有定義
+		sf, zf, pf bool
+	}
+	cases := []tc{
+		{"shr 1：高位是 1", 0xE8, 0x80000001, 1, 0x40000000, true, true, true, false, false, true},
+		{"shr 1：低位是 0", 0xE8, 0x00000002, 1, 0x00000001, false, false, true, false, false, false},
+		{"shr 1：結果為 0", 0xE8, 0x00000001, 1, 0, true, false, true, false, true, true},
+		{"shr 31", 0xE8, 0x80000000, 31, 0x00000001, false, false, false, false, false, false},
+		{"shr 31：CF 為 bit30", 0xE8, 0xFFFFFFFF, 31, 0x00000001, true, false, false, false, false, false},
+		{"shr 33 遮成 1", 0xE8, 0x80000000, 33, 0x40000000, false, true, true, false, false, true},
+		{"shr 4：全 1", 0xE8, 0xFFFFFFFF, 4, 0x0FFFFFFF, true, false, false, false, false, true},
+		{"shr 5：值為 0", 0xE8, 0, 5, 0, false, false, false, false, true, true},
+		{"shl 1：進位出去", 0xE0, 0x80000000, 1, 0, true, true, true, false, true, true},
+		{"shl 1：符號改變", 0xE0, 0x40000000, 1, 0x80000000, false, true, true, true, false, true},
+		{"shl 1：CF 與符號相同", 0xE0, 0xC0000000, 1, 0x80000000, true, false, true, true, false, true},
+		{"shl 31", 0xE0, 0x00000001, 31, 0x80000000, false, false, false, true, false, true},
