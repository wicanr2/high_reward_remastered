diff --git a/apps/hr/hd/compose_draw.go b/apps/hr/hd/compose_draw.go
new file mode 100644
index 0000000..4ede32b
--- /dev/null
+++ b/apps/hr/hd/compose_draw.go
@@ -0,0 +1,279 @@
+package hd
+
+import (
+	"encoding/binary"
+	"math/bits"
+	"runtime"
+	"sync"
+	"time"
+)
+
+// band 是一段來源像素列 [y0, y1)。各 band 寫入的輸出像素互不重疊，可以平行處理；
+// 每個 band 內仍依序號由大到小處理戳記，所以結果與單執行緒相同。
+type band struct{ y0, y1 int }
+
+type bandScratch struct {
+	f4   []uint64
+	pass int
+}
+
+func (c *Composer) bands(pxH int) []band {
+	n := c.Workers
+	if n <= 0 {
+		n = runtime.GOMAXPROCS(0)
+		if n > 8 {
+			n = 8
+		}
+	}
+	if n > pxH {
+		n = pxH
+	}
+	if n < 1 {
+		n = 1
+	}
+	out := make([]band, 0, n)
+	for i := 0; i < n; i++ {
+		out = append(out, band{pxH * i / n, pxH * (i + 1) / n})
+	}
+	return out
+}
+
+func parallel(bs []band, fn func(i int, b band)) {
+	if len(bs) == 1 {
+		fn(0, bs[0])
+		return
+	}
+	var wg sync.WaitGroup
+	for i, b := range bs {
+		wg.Add(1)
+		go func(i int, b band) {
+			defer wg.Done()
+			fn(i, b)
+		}(i, b)
+	}
+	wg.Wait()
+}
+
+type stampJob struct {
+	v  Mask
+	as *Asset
+	ft *fadeTab
+	ok bool // 有通過驗證的像素
+}
+
+// Compose 把 px（pxW×pxH，值 0 至 15）依 mp 與 dac 轉成 RGBA 並整數倍放大，寫進 dst
+// （長度至少 pxW*S*pxH*S*4），再疊上 stamps（依序號遞增）。基底層與繪製依來源像素列分成
+// 幾個 band 平行處理（Workers）。
+func (c *Composer) Compose(dst []byte, px []uint8, pxW, pxH int, mp [16]uint8, dac *[256][3]uint8, stamps []*Stamp) {
+	S := c.S
+	ow, oh := pxW*S, pxH*S
+	var base [16][3]uint8
+	for p := range base {
+		base[p] = dac[mp[p]]
+	}
+	var pal32 [16]uint32
+	for p := range base {
+		pal32[p] = uint32(base[p][0]) | uint32(base[p][1])<<8 | uint32(base[p][2])<<16 | 0xFF<<24
+	}
+	if cap(c.accA) < ow*oh {
+		c.accA = make([]uint8, ow*oh)
+	}
+	c.accA = c.accA[:ow*oh]
+	bs := c.bands(pxH)
+	t0 := time.Now()
+	parallel(bs, func(_ int, b band) {
+		// 基底層與 accA 清零
+		clear(c.accA[b.y0*S*ow : b.y1*S*ow])
+		for y := b.y0; y < b.y1; y++ {
+			row := dst[(y*S)*ow*4 : (y*S+1)*ow*4]
+			o := 0
+			for _, p := range px[y*pxW : y*pxW+pxW] {
+				v := pal32[p&15]
+				for u := 0; u < S; u++ {
+					binary.LittleEndian.PutUint32(row[o:], v)
+					o += 4
+				}
+			}
+			for v := 1; v < S; v++ {
+				copy(dst[(y*S+v)*ow*4:(y*S+v+1)*ow*4], row)
+			}
+		}
+	})
+	c.Stats = ComposeStats{TBase: time.Since(t0)}
+	if len(stamps) == 0 {
+		return
+	}
+	t1 := time.Now()
+	vs := c.vf.Run(stamps, px, pxW, pxH)
+	c.Stats.Stamps = len(stamps)
+	c.Stats.Fast, c.Stats.Slow, c.Stats.Empty = c.vf.Fast, c.vf.Slow, c.vf.Empty
+	c.Stats.TVerify = time.Since(t1)
+
+	t2 := time.Now()
+	jobs := make([]stampJob, len(stamps))
+	tabs := map[*[16][3]uint8]*fadeTab{}
+	for i, s := range stamps {
+		jobs[i].v = vs[i]
+		if vs[i].Count() == 0 {
+			continue
+		}
+		jobs[i].ok = true
+		if c.A != nil {
+			jobs[i].as = c.A.Get(s.Hash)
+		}
+		if as := jobs[i].as; as != nil {
+			c.Stats.WithHD++
+			ft := tabs[as.Pal]
+			if ft == nil {
+				t := makeFade(as.Pal, &base)
+				ft = &t
+				tabs[as.Pal] = ft
+			}
+			jobs[i].ft = ft
+		}
+	}
+	if len(c.scratch) < len(bs) {
+		c.scratch = make([]bandScratch, len(bs))
+	}
+	parallel(bs, func(bi int, b band) {
+		sc := &c.scratch[bi]
+		sc.pass = 0
+		for i := len(stamps) - 1; i >= 0; i-- {
+			s, j := stamps[i], jobs[i]
+			if !j.ok || s.Y >= b.y1 || s.Y+s.H <= b.y0 {
+				continue
+			}
+			c.drawStamp(dst, px, pxW, &base, s, j.v, j.as, j.ft, b, sc)
+		}
+	})
+	for i := range bs {
+		c.Stats.Pass += c.scratch[i].pass
+	}
+	c.Stats.TDraw = time.Since(t2)
+}
+
+func (c *Composer) drawStamp(dst []byte, px []uint8, pxW int, base *[16][3]uint8, s *Stamp, v Mask, as *Asset, ft *fadeTab, b band, sc *bandScratch) {
+	S := c.S
+	ow := pxW * S
+	w, st := s.W, v.Stride
+	jlo, jhi := 0, s.H
+	if s.Y < b.y0 {
+		jlo = b.y0 - s.Y
+	}
+	if s.Y+s.H > b.y1 {
+		jhi = b.y1 - s.Y
+	}
+	if as == nil {
+		// 沒有 HD：通過驗證的像素遮蔽序號較小的 HD（顯示基底層）
+		for j := jlo; j < jhi; j++ {
+			for k := 0; k < st; k++ {
+				word := v.Bits[j*st+k]
+				for word != 0 {
+					i := k*64 + bits.TrailingZeros64(word)
+					word &= word - 1
+					sc.pass++
+					for dv := 0; dv < S; dv++ {
+						o := ((s.Y+j)*S+dv)*ow + (s.X+i)*S
+						for du := 0; du < S; du++ {
+							c.accA[o+du] = 255
+						}
+					}
+				}
+			}
+		}
+		return
+	}
+	img := as.Img
+	stride := img.Stride
+	pix := img.Pix
+	// 羽化候選：V 的四鄰擴張（只留透明像素），只算這個 band 的列
+	need := st * (jhi - jlo)
+	if cap(sc.f4) < need {
+		sc.f4 = make([]uint64, need)
+	}
+	f4 := sc.f4[:need]
+	for j := jlo; j < jhi; j++ {
+		for k := 0; k < st; k++ {
+			x := v.Bits[j*st+k]
+			d := x<<1 | x>>1
+			if k > 0 {
+				d |= v.Bits[j*st+k-1] >> 63
+			}
+			if k+1 < st {
+				d |= v.Bits[j*st+k+1] << 63
+			}
+			if j > 0 {
+				d |= v.Bits[(j-1)*st+k]
+			}
+			if j+1 < s.H {
+				d |= v.Bits[(j+1)*st+k]
+			}
+			f4[(j-jlo)*st+k] = d &^ x
+		}
+	}
+	for j := jlo; j < jhi; j++ {
+		for k := 0; k < st; k++ {
+			word := v.Bits[j*st+k] | f4[(j-jlo)*st+k]
+			for word != 0 {
+				i := k*64 + bits.TrailingZeros64(word)
+				word &= word - 1
+				if i >= w {
+					break
+				}
+				var idx byte
+				if v.Get(i, j) {
+					idx = s.E[j*w+i]
+					sc.pass++
+				} else {
+					// 羽化區：必須是透明像素，且取四鄰中通過驗證的不透明像素的索引（左、右、上、下）
+					if s.E[j*w+i] != Transparent {
+						continue
+					}
+					x, y := s.X+i, s.Y+j
+					if x < 0 || y < 0 || x >= pxW || y >= len(px)/pxW {
+						continue
+					}
+					switch {
+					case v.Get(i-1, j):
+						idx = s.E[j*w+i-1]
+					case v.Get(i+1, j):
+						idx = s.E[j*w+i+1]
+					case v.Get(i, j-1):
+						idx = s.E[(j-1)*w+i]
+					case v.Get(i, j+1):
+						idx = s.E[(j+1)*w+i]
+					default:
+						continue
+					}
+				}
+				for dv := 0; dv < S; dv++ {
+					po := (S*j+dv)*stride + S*i*4
+					oy := (s.Y+j)*S + dv
+					for du := 0; du < S; du++ {
+						a := pix[po+du*4+3]
+						if a == 0 {
+							continue
+						}
+						ox := (s.X+i)*S + du
+						p := oy*ow + ox
+						t := c.accA[p]
+						if t == 255 {
+							continue
+						}
+						col := [3]uint8{pix[po+du*4], pix[po+du*4+1], pix[po+du*4+2]}
+						if !ft.ident {
+							col[0], col[1], col[2] = ft.lut[idx&15][0][col[0]], ft.lut[idx&15][1][col[1]], ft.lut[idx&15][2][col[2]]
+						}
+						if a == 255 && t == 0 { // 最常見：不透明且沒有前景
+							d := dst[p*4 : p*4+3]
+							d[0], d[1], d[2] = col[0], col[1], col[2]
+							c.accA[p] = 255
+							continue
+						}
+						c.blend(dst, p, col, a, base[px[((s.Y+j)*pxW)+s.X+i]&15])
+					}
+				}
+			}
+		}
+	}
+}
