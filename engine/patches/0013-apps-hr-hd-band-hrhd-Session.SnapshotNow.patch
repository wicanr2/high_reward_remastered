+// 平行的 band 數不影響結果：Workers ＝ 1 與 3、8 逐位元相同。
+func TestComposeWorkersEqual(t *testing.T) {
+	r := rand.New(rand.NewSource(11))
+	mp, dac := identityMap()
+	const W, H, S = 50, 37, 2
+	pal := testPalette()
+	for round := 0; round < 40; round++ {
+		px := make([]uint8, W*H)
+		cache := map[string]*Asset{}
+		var stamps []*Stamp
+		for k := 0; k < 1+r.Intn(8); k++ {
+			w, h := 3+r.Intn(20), 3+r.Intn(20)
+			s := &Stamp{Kind: KindSprite, X: r.Intn(W-w+6) - 3, Y: r.Intn(H-h+6) - 3, W: w, H: h, Hash: fmt.Sprint("h", k), E: make([]byte, w*h), Seq: uint64(k + 1)}
+			for i := range s.E {
+				if r.Intn(5) == 0 {
+					s.E[i] = Transparent
+				} else {
+					s.E[i] = byte(r.Intn(4))
+				}
+			}
+			for j := 0; j < h; j++ {
+				for i := 0; i < w; i++ {
+					x, y := s.X+i, s.Y+j
+					if x >= 0 && y >= 0 && x < W && y < H && s.E[j*w+i] != Transparent && r.Intn(9) != 0 {
+						px[y*W+x] = s.E[j*w+i]
+					}
+				}
+			}
+			stamps = append(stamps, s)
+			if r.Intn(4) != 0 {
+				as := solidAsset(w, h, S, uint8(r.Intn(256)), uint8(r.Intn(256)), uint8(r.Intn(256)), 255, pal)
+				for i := 3; i < len(as.Img.Pix); i += 4 {
+					if r.Intn(4) == 0 {
+						as.Img.Pix[i] = uint8(r.Intn(256))
+					}
+				}
+				cache[s.Hash] = as
+			}
+		}
+		a := &Assets{S: S, cache: cache}
+		var ref []byte
+		for _, wk := range []int{1, 3, 8} {
+			c := NewComposer(a, S)
+			c.Workers = wk
+			out := make([]byte, W*S*H*S*4)
+			c.Compose(out, px, W, H, mp, &dac, stamps)
+			if ref == nil {
+				ref = out
+			} else if string(ref) != string(out) {
+				t.Fatalf("round %d：Workers=%d 與 Workers=1 的結果不同", round, wk)
+			}
+		}
+	}
+}
