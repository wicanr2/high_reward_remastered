+package main
+
+import (
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// fadeScan 從目前狀態起每 slice 步要求一個快照並合成，檢查淡入淡出的不變量（docs/spec/004 第 5.4、7 節）：
+//   - 顯示色全黑（DAC 全 0）時，合成結果必須全黑（HD 像素不得漏光）；
+//   - 回報看到幾個不同的 DAC 狀態、HD 疊層參與的畫面數。
+func fadeScan(s *hrrt.Session, assets *hd.Assets, until uint64, slice uint64, tick func(steps uint64)) {
+	cmp := hd.NewComposer(assets, 2)
+	var dst []byte
+	var last uint64
+	seen := map[[16][3]uint8]int{}
+	frames, black, leak, withHD := 0, 0, 0, 0
+	for s.Machine().Steps < until {
+		tick(s.Machine().Steps)
+		if st := s.RunSteps(s.Machine().Steps + slice); st.Kind != hrrt.StopSteps {
+			fmt.Println("提前停機：", st.Msg)
+			break
+		}
+		s.SnapshotNow()
+		f := s.Frame()
+		if f == nil || f.Seq == last {
+			continue
+		}
+		last = f.Seq
+		frames++
+		var pal [16][3]uint8
+		allBlack := true
+		for i := range pal {
+			pal[i] = f.DAC[f.Map[i]]
+			if pal[i] != [3]uint8{} {
+				allBlack = false
+			}
+		}
+		seen[pal]++
+		ow, oh := cmp.OutSize(f.W, f.H)
+		if len(dst) != ow*oh*4 {
+			dst = make([]byte, ow*oh*4)
+		}
+		cmp.Compose(dst, f.Px, f.W, f.H, f.Map, &f.DAC, f.Stamps)
+		if cmp.Stats.WithHD > 0 {
+			withHD++
+		}
+		if allBlack {
+			black++
+			for i := 0; i < len(dst); i += 4 {
+				if dst[i] != 0 || dst[i+1] != 0 || dst[i+2] != 0 {
+					leak++
+					break
+				}
+			}
+		}
+	}
+	fmt.Printf("淡入淡出掃描：快照 %d 張，不同的顯示調色盤 %d 種，全黑 %d 張（漏光 %d 張），HD 參與 %d 張\n", frames, len(seen), black, leak, withHD)
+	if leak > 0 {
+		fmt.Println("失敗：DAC 全 0 時 HD 疊層漏光")
+	}
+}
