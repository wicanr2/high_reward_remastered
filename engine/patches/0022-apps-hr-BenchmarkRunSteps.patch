+package runtime
+
+import (
+	"os"
+	"syscall"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/state"
+)
+
+// 熱迴圈速度的 A/B 量測（docs/spec/005 第 9 節，由 tools/bench.sh 交錯執行）。
+// 回報牆鐘（ns/op）與使用者 CPU 時間（user-ns/op）：主機負載高時牆鐘會被其他行程淹沒，
+// 閘門看使用者 CPU 時間。
+
+func userNanos() float64 {
+	var ru syscall.Rusage
+	_ = syscall.Getrusage(syscall.RUSAGE_SELF, &ru)
+	return float64(ru.Utime.Nano())
+}
+
+func benchSteps(b *testing.B, opt Options, state0 string, steps uint64) {
+	root := origRoot(b)
+	opt.NoPacing = true
+	var user float64
+	for i := 0; i < b.N; i++ {
+		b.StopTimer()
+		s, err := Open(root, opt)
+		if err != nil {
+			b.Fatal(err)
+		}
+		if state0 != "" {
+			if err := state.Load(state0, s.m, s.d); err != nil {
+				b.Fatal(err)
+			}
+		}
+		target := s.m.Steps + steps
+		b.StartTimer()
+		u0 := userNanos()
+		s.RunSteps(target)
+		user += userNanos() - u0
+		b.StopTimer()
+	}
+	b.ReportMetric(user/float64(b.N), "user-ns/op")
+}
+
+func BenchmarkRunSteps(b *testing.B) {
+	b.Run("cold", func(b *testing.B) { benchSteps(b, Options{Interval: NativeInterval}, "", 200_000_000) })
+	b.Run("cold-hdhooks", func(b *testing.B) { benchSteps(b, Options{Interval: NativeInterval, HDHooks: true}, "", 200_000_000) })
+	b.Run("battle-state", func(b *testing.B) {
+		p := os.Getenv("HR_BENCH_STATE")
+		if p == "" {
+			b.Skip("沒有設 HR_BENCH_STATE（戰鬥佈陣狀態檔）")
+		}
+		if _, err := os.Stat(p); err != nil {
+			b.Skipf("狀態檔不存在：%v", err)
+		}
+		benchSteps(b, Options{Interval: NativeInterval}, p, 100_000_000)
+	})
+}
