+		{"規則 2：(zh-TW, 明示) 無表 ＝ 建置 identity", ingameChoice{icTW, true}, false, false, false, planIdentity, reasonNoTable},
+		{"規則 3：(zh-TW, 非明示) 無表 ＝ 不建置", ingameChoice{icTW, false}, false, false, false, planNone, reasonNoTable},
+		{"規則 2：(zh-TW, 明示) 有表 ＝ 建置 table", ingameChoice{icTW, true}, true, false, false, planTable, reasonNone},
+		{"規則 3：(zh-TW, 非明示) 有表 ＝ 建置 table", ingameChoice{icTW, false}, true, false, false, planTable, reasonNone},
+		{"規則 2：identity 一律建 identity（有表也不理會）", ingameChoice{icIdentity, true}, true, false, false, planIdentity, reasonNone},
+		{"規則 2：identity，沒有表", ingameChoice{icIdentity, true}, false, false, false, planIdentity, reasonNone},
+		{"規則 4：L2 之前一律不建置（有表）", ingameChoice{icJA, true}, true, false, false, planNone, reasonUnsupported},
+		{"規則 4：沒有表先於 L2 尚未存在", ingameChoice{icJA, false}, false, false, false, planNone, reasonNoTable},
+		{"規則 4：L2 之後補丁缺", ingameChoice{icKO, false}, true, true, false, planNone, reasonNoPatch},
+		{"規則 4：L2 之後有表有補丁", ingameChoice{icCN, false}, true, true, true, planTable, reasonNone},
+		{"規則 4：L2 之後沒有表", ingameChoice{icEN, false}, false, true, true, planNone, reasonNoTable},
+	}
+	for _, c := range cases {
+		got := planIngame(c.c, c.hasTable, c.l2, c.patch)
+		if got.Kind != c.kind || got.Reason != c.reason {
