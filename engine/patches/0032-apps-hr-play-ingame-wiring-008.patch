+package main
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/hajimehoshi/ebiten/v2"
+)
+
+// docs/spec/008 第 3.8 節：F1「遊戲內文字」一行與 F4 提示經 game 的完整路徑（假 Session 與假環境，不需要 GPU 與原版）。
+
+func withIngame(rt ingameRuntime) rigOpt {
+	return func(gr *gameRig, c *gameConfig) { c.Ingame = &rt }
+}
+
+func withLang(l lang) rigOpt { return func(gr *gameRig, c *gameConfig) { c.Lang = l } }
+
+// toastNow 是此刻 toast 行的文字（用目前語言的字面）。
+func (gr *gameRig) toastNow() string {
+	gr.t.Helper()
+	ht := newHudText(gr.g.fonts, gr.g.lang)
+	s, ok := ht.toast(gr.sw.Toast(), gr.clk.Now())
+	if !ok {
+		gr.t.Fatal("沒有 toast")
+	}
+	return s
+}
+
+// f1Line 是 F1 面板「遊戲內文字」一行（經 panelText 與其快取，與畫面上畫出來的同一份）。
+func (gr *gameRig) f1Line() string {
+	gr.t.Helper()
+	ht := newHudText(gr.g.fonts, gr.g.lang)
+	return gr.g.panelText(ht, gr.clk.Now())[rowStatus+2]
+}
+
+func expectedToast(l lang, k toastKey) string {
+	return ingameToastText(tFor(l), langNames[l], k)
+}
+
+func expectedF1(l lang, v f1Value) string {
+	return tr(l, "status.game", ingameF1Text(tFor(l), v))
+}
+
+// 預設啟動（沒有語言包、沒有譯文表）：F1 是原版；F4 循環中 zh-TW 與原版視為相同，其他語言沒有語言包。
+func TestGameIngameDefaultF4Cycle(t *testing.T) {
+	gr := newGameRig(t, themeOriginal, nil)
+	gr.prime()
+	if got, want := gr.f1Line(), expectedF1(langTW, origF1); got != want {
+		t.Errorf("啟動時 F1：%q，應為 %q", got, want)
+	}
+	want := []struct {
+		l  lang
+		f1 f1Value
+		tk toastKey
+	}{
+		{langCN, unusable(icCN, reasonNoTable), toastNoPack},
+		{langKO, unusable(icKO, reasonNoTable), toastNoPack},
+		{langEN, unusable(icEN, reasonNoTable), toastNoPack},
+		{langJA, unusable(icJA, reasonNoTable), toastNoPack},
+		{langTW, origF1, toastSame},
+	}
+	for i, w := range want {
+		gr.mustFrame(ebiten.KeyF4)
+		if gr.g.lang != w.l {
+			t.Fatalf("F4 第 %d 次：語言 %s", i+1, gr.g.lang)
+		}
+		if got, wantT := gr.toastNow(), expectedToast(w.l, w.tk); got != wantT {
+			t.Errorf("F4 第 %d 次 toast：%q，應為 %q", i+1, got, wantT)
+		}
+		if got, wantF := gr.f1Line(), expectedF1(w.l, w.f1); got != wantF {
+			t.Errorf("F4 第 %d 次 F1：%q，應為 %q", i+1, got, wantF)
+		}
+	}
+}
+
+// 覆蓋旗標生效時 F4 只改介面語言：選擇 S 固定，toast 一律是「旗標指定」，F1 值不變。
+func TestGameIngameOverrideF4OnlyChangesInterfaceLanguage(t *testing.T) {
+	for _, c := range []struct {
+		name string
+		code ingameCode
+		e    effective
+		sf   startFail
+		f1   f1Value
+	}{
+		{"-ingame-lang none", icNone, eOrig, noFail, origF1},
+		{"-ingame-lang identity，建置成功", icIdentity, eIdID, noFail, verifyUse(icIdentity)},
+		{"-ingame-lang identity，建置失敗", icIdentity, eOrig, startFail{icIdentity, reasonBuildFailed}, unusable(icIdentity, reasonBuildFailed)},
+		{"-ingame-lang ja（L2 之前不建置）", icJA, eOrig, noFail, unusable(icJA, reasonNoTable)},
+		{"-ingame-lang zh-TW，沒有表（identity 包）", icTW, eIdTW, noFail, verifyUse(icTW)},
+	} {
+		finds := 0
+		gr := newGameRig(t, themeOriginal, nil, withIngame(ingameRuntime{
+			E: c.e, StartFail: c.sf, Override: true, Fixed: c.code, FindTable: func(ingameCode) bool { finds++; return false },
+		}))
+		gr.prime()
+		for i := 0; i < 6; i++ { // 一圈加一次：不論 F4 走到哪個語言
+			gr.mustFrame(ebiten.KeyF4)
+			l := gr.g.lang
+			if gr.g.ingameSel() != c.code {
+				t.Fatalf("%s：F4 第 %d 次後 S ＝ %s，覆蓋時不隨 F4 改變，應為 %s", c.name, i+1, gr.g.ingameSel(), c.code)
+			}
+			if got, want := gr.toastNow(), expectedToast(l, toastFlag); got != want {
+				t.Errorf("%s：F4 第 %d 次 toast：%q，應為旗標指定 %q", c.name, i+1, got, want)
+			}
+			if got, want := gr.f1Line(), expectedF1(l, c.f1); got != want {
+				t.Errorf("%s：F4 第 %d 次 F1：%q，應為 %q", c.name, i+1, got, want)
+			}
+		}
+		if c.code == icNone || c.code == icIdentity {
+			if finds != 0 {
+				t.Errorf("%s：none 與 identity 的 avail 未定義，不該查譯文表（查了 %d 次）", c.name, finds)
+			}
+		}
+	}
+}
+
+// 啟動失敗（(ja, build-failed)）：F4 離開 C_start 後狀態依 avail 判定，繞回 C_start 又是無法使用（列 13、15、16）。
+func TestGameIngameStartFailThenF4LeaveAndReturn(t *testing.T) {
+	for _, reason := range []reasonKey{reasonBuildFailed, reasonVerifyFailed} {
+		gr := newGameRig(t, themeOriginal, nil, withLang(langJA), withIngame(ingameRuntime{StartFail: startFail{icJA, reason}, Fixed: icJA}))
+		gr.prime()
+		if got, want := gr.f1Line(), expectedF1(langJA, unusable(icJA, reason)); got != want {
+			t.Errorf("%s 啟動時 F1：%q，應為 %q", reason, got, want)
+		}
+		steps := []struct {
+			l  lang
+			f1 f1Value
+			tk toastKey
+		}{
+			{langTW, origF1, toastSame}, // 離開 C_start：zh-TW 沒有表，視為與原版相同
+			{langCN, unusable(icCN, reasonNoTable), toastNoPack},
+			{langKO, unusable(icKO, reasonNoTable), toastNoPack},
+			{langEN, unusable(icEN, reasonNoTable), toastNoPack},
+			{langJA, unusable(icJA, reason), toastUnusable}, // 繞回 C_start
+		}
+		for i, s := range steps {
+			gr.mustFrame(ebiten.KeyF4)
+			if got, want := gr.toastNow(), expectedToast(s.l, s.tk); got != want {
+				t.Errorf("%s F4 第 %d 次 toast：%q，應為 %q", reason, i+1, got, want)
+			}
+			if got, want := gr.f1Line(), expectedF1(s.l, s.f1); got != want {
+				t.Errorf("%s F4 第 %d 次 F1：%q，應為 %q", reason, i+1, got, want)
+			}
+		}
+	}
+}
+
+// avail 在 F4 每次按下時重新計算（列 20）：按下之間放入譯文表，F1 沿用上次的結果、不在每幀掃檔案系統；
+// 下一次按下才改變。
+func TestGameIngameAvailRecomputedOnEachF4(t *testing.T) {
+	have, finds := false, 0
+	gr := newGameRig(t, themeOriginal, nil, withIngame(ingameRuntime{FindTable: func(c ingameCode) bool { finds++; return have && c == icTW }}))
+	gr.prime()
+	if got, want := gr.f1Line(), expectedF1(langTW, origF1); got != want {
+		t.Fatalf("啟動：%q，應為 %q", got, want)
+	}
+	// F4 一圈回到 zh-TW 之前，譯文表才放入
+	for i := 0; i < 4; i++ {
+		gr.mustFrame(ebiten.KeyF4)
+	}
+	have = true
+	before := finds
+	gr.mustFrame(ebiten.KeyF4) // 回到 zh-TW：此時重新計算
+	if gr.g.lang != langTW {
+		t.Fatalf("應回到 zh-TW：%s", gr.g.lang)
+	}
+	if finds == before {
+		t.Error("F4 按下時應重新查譯文表")
+	}
+	if got, want := gr.toastNow(), expectedToast(langTW, toastNext); got != want {
+		t.Errorf("toast：%q，應為 %q", got, want)
+	}
+	if got, want := gr.f1Line(), expectedF1(langTW, pending(icTW)); got != want {
+		t.Errorf("F1：%q，應為 %q", got, want)
+	}
+	// F1 開著的期間每幀組面板：不再查檔案系統
+	after := finds
+	for i := 0; i < 200; i++ {
+		gr.g.panelBase()
+	}
+	if finds != after {
+		t.Errorf("組面板不該查譯文表（每幀掃檔案系統）：%d 次", finds-after)
+	}
+	// 之後譯文表又被移走：F1 沿用上次，下一次按下才反映
+	have = false
+	if got := gr.g.panelBase().Ingame; got != pending(icTW) {
+		t.Errorf("兩次 F4 之間 F1 值沿用上次的結果（不重新查）：%+v，應為 %+v", got, pending(icTW))
+	}
+	for i := 0; i < 5; i++ { // 一圈：回到 zh-TW
+		gr.mustFrame(ebiten.KeyF4)
+	}
+	if gr.g.lang != langTW {
+		t.Fatalf("應回到 zh-TW：%s", gr.g.lang)
+	}
+	if got := gr.g.panelBase().Ingame; got != origF1 {
+		t.Errorf("再繞回 zh-TW（表已移走，重新計算）：%+v，應為 %+v", got, origF1)
+	}
+	if got, want := gr.f1Line(), expectedF1(langTW, origF1); got != want {
+		t.Errorf("再繞回 zh-TW 的 F1：%q，應為 %q", got, want)
+	}
+}
+
+// 生效的語言包：F1 標示（部分翻譯）或（原版文字，驗證用）；F4 選到沒有表的語言時顯示無法使用。
+func TestGameIngameEffectivePackOnPanel(t *testing.T) {
+	gr := newGameRig(t, themeOriginal, nil, withIngame(ingameRuntime{E: eTable, FindTable: func(c ingameCode) bool { return c == icTW }}))
+	gr.prime()
+	if got, want := gr.f1Line(), expectedF1(langTW, partial(icTW)); got != want {
+		t.Errorf("zh-TW 表包：%q，應為 %q", got, want)
+	}
+	gr.mustFrame(ebiten.KeyF4) // zh-CN：沒有表
+	if got, want := gr.f1Line(), expectedF1(langCN, unusable(icCN, reasonNoTable)); got != want {
+		t.Errorf("F4 到沒有表的語言：%q，應為 %q", got, want)
+	}
+	if got, want := gr.toastNow(), expectedToast(langCN, toastNoPack); got != want {
+		t.Errorf("toast：%q，應為 %q", got, want)
+	}
+	gr2 := newGameRig(t, themeOriginal, nil, withIngame(ingameRuntime{E: eZeroTbl, FindTable: func(c ingameCode) bool { return c == icTW }}))
+	if got, want := gr2.f1Line(), expectedF1(langTW, verifyUse(icTW)); got != want {
+		t.Errorf("採用列數 0 的 table 包：%q，應為 %q", got, want)
+	}
+}
+
+// 沒有字型（退回 ASCII 的 F1）：F4 的提示用英文與語言代碼，只含 ASCII。
+func TestGameIngameToastASCIIFallback(t *testing.T) {
+	old := loadFontBytes
+	t.Cleanup(func() { loadFontBytes = old })
+	loadFontBytes = func(lang) ([]byte, error) { return nil, errors.New("壞字型") }
+	gr := newGameRig(t, themeOriginal, nil)
+	gr.prime()
+	gr.mustFrame(ebiten.KeyF4)
+	if !newHudText(gr.g.fonts, gr.g.lang).ascii() {
+		t.Fatal("字型載入失敗時應退回 ASCII")
+	}
+	if got, want := gr.toastNow(), "zh-CN  In-game text: no language pack yet"; got != want {
+		t.Errorf("退回版 toast：%q，應為 %q", got, want)
+	}
+	const wantF1 = "In-game text: Simplified Chinese selected, unavailable: no translation table"
+	if got := gr.f1Line(); got != wantF1 {
+		t.Errorf("退回版 F1：%q，應為 %q", got, wantF1)
+	}
+}
diff --git a/apps/hr/play/ingame_start.go b/apps/hr/play/ingame_start.go
new file mode 100644
index 0000000..0b00764
--- /dev/null
+++ b/apps/hr/play/ingame_start.go
@@ -0,0 +1,214 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// 遊戲內語言的啟動接線（docs/spec/008 第 3.2 節「啟動順序與可見性」）：在 hrrt.Open 之前、沒有視窗時同步執行，
+//
+//	prepareIngame  C → hasTable → planIngame → 建置（l10n.ExpectedDigest、l10n.Build）→ LangDir 與 LangDigest
+//	（hrrt.Open）
+//	finish         Session.LangStatus() → 生效 E 與啟動失敗 startFail（交給 ingameStatus）
+//
+// 建置錯誤不阻擋遊戲：記一行，遊戲內文字維持原版，F1 顯示 (4) 無法使用。輸出一律寫日誌（ingameLogf），
+// 日誌行的前綴是 "ingame:"，只放代碼、原因鍵、路徑、計數與雜湊，不含原版或譯文。
+
+// ingameBuilder 是前端對語言包建置器的依賴（l10n 套件的兩個函式）。正式實作是 l10nBuilder；
+// 測試用假建置器，不需要原版。
+type ingameBuilder interface {
+	ExpectedDigest(cfg l10n.Config) (string, error)
+	Build(cfg l10n.Config) (*l10n.Result, error)
+}
+
+type l10nBuilder struct{}
+
+func (l10nBuilder) ExpectedDigest(cfg l10n.Config) (string, error) { return l10n.ExpectedDigest(cfg) }
+func (l10nBuilder) Build(cfg l10n.Config) (*l10n.Result, error)    { return l10n.Build(cfg) }
+
+var _ ingameBuilder = l10nBuilder{}
+
+// ingameInput 是 prepareIngame 的輸入。
+type ingameInput struct {
+	Choice   ingameChoice
+	Search   l10n.TableSearch // 譯文表的尋找來源（tableSearchFor）
+	OrigDir  string           // 原版目錄
+	PackRoot string           // 語言包根：<資料目錄>/l10n-packs
+	Builder  ingameBuilder
+	Logf     func(string, ...any)
+	// L2 與 PatchInHand 是 planIngame 的第三、第四個參數；正式路徑傳 l2Supported 與 patchInHand（L2 之前恆為假），
+	// 測試傳真值模擬 L2 之後（用假建置器，不經真的 Build）。
+	L2, PatchInHand bool
+}
+
+// ingameBuild 是 prepareIngame 的結果。
+type ingameBuild struct {
+	Choice     ingameChoice
+	Plan       ingamePlan
+	LangDir    string    // 建置成功：語言層目錄（<包根>/files）；否則空
+	LangDigest string    // 建置成功：先算好的預期輸入摘要；LangDir 非空時必非空
+	Pack       effective // 建置成功：由 manifest 判出的種類（還沒經過 Session.Open 的驗證）
+	Failed     bool      // 要建置而失敗（build-failed）
+}
+
+// langOptions 是要傳給 hrrt.Options 的 LangDir 與 LangDigest。只在語言包啟用（建置成功）時才非空；
+// LangDir 非空時 LangDigest 必非空（否則 Open 回錯）；SkipLangDigest 不由前端設定。
+func (b ingameBuild) langOptions() (langDir, langDigest string) {
+	if b.LangDir == "" || b.LangDigest == "" {
+		return "", ""
+	}
+	return b.LangDir, b.LangDigest
+}
+
+// prepareIngame 依 planIngame 的決定建置語言包。沒有譯文表而且非明示（預設玩家路徑）時不呼叫任何建置，
+// 啟動成本只有幾次目錄探測。
+//
+// 要建置時：組 l10n.Config（原版目錄、輸出根 l10n-packs、table 模式的譯文表目錄 ＝ 找到的 l10n 根接 <代碼>/、
+// 預設政策：三個旗標全關，這些旗標前端不提供），先 ExpectedDigest 算好預期摘要，再 Build，建置完成後比對
+// Result.Digest 與先算好的摘要，不等（建置期間譯文表被改動）記 build-failed。
+func prepareIngame(in ingameInput) ingameBuild {
+	logf := in.Logf
+	if logf == nil {
+		logf = func(string, ...any) {}
+	}
+	c := in.Choice
+	out := ingameBuild{Choice: c}
+	tableRoot, hasTable := "", false
+	if c.Code.inCycle() {
+		tableRoot, hasTable = l10n.FindTableDirFor(in.Search, string(c.Code))
+	}
+	out.Plan = planIngame(c, hasTable, in.L2, in.PatchInHand)
+	logf("ingame: C=%s explicit=%v table=%v plan=%s reason=%s（%s）", c.Code, c.Explicit, hasTable, out.Plan.Kind.token(), reasonText(out.Plan.Reason), out.Plan.Kind)
+	if out.Plan.Kind == planNone {
+		return out
+	}
+
+	cfg := l10n.Config{OrigDir: in.OrigDir, PackRoot: in.PackRoot, Code: string(c.Code), Mode: l10n.ModeIdentity}
+	if out.Plan.Kind == planTable {
+		cfg.Mode = l10n.ModeTable
+		dir, ok := l10n.TableDirFor(tableRoot, string(c.Code))
+		if !ok {
+			return out.fail(logf, "找不到 %s 的譯文表目錄（%s）", c.Code, tableRoot)
+		}
+		cfg.TableDir = dir
+	}
+	digest, err := in.Builder.ExpectedDigest(cfg)
+	if err != nil {
+		return out.fail(logf, "預期輸入摘要失敗：%v", err)
+	}
+	if digest == "" {
+		return out.fail(logf, "預期輸入摘要為空")
+	}
+	res, err := in.Builder.Build(cfg)
+	if err != nil {
+		var ve *l10n.ViolationsError
+		if errors.As(err, &ve) {
+			for _, item := range ve.Items {
+				logf("ingame: violation %s", item)
+			}
+			return out.fail(logf, "譯文表有 %d 項違規", len(ve.Items))
+		}
+		return out.fail(logf, "建置失敗：%v", err)
+	}
+	if res == nil || res.Manifest == nil {
+		return out.fail(logf, "建置器沒有回傳語言包與 manifest")
+	}
+	if res.Digest != digest {
+		return out.fail(logf, "建置期間輸入改變：先算的摘要 %s，建置結果 %s", shortHash(digest), shortHash(res.Digest))
+	}
+	out.LangDir, out.LangDigest = res.FilesDir(), digest
+	out.Pack = effectiveFromManifest(res.Manifest.Policy.Mode, res.Manifest.Adopted, ingameCode(res.Manifest.Code))
+	logf("ingame: pack-ready dir=%s reused=%v mode=%s code=%s adopted=%d manifest-sha256=%s digest=%s",
+		res.Dir, res.Reused, res.Manifest.Policy.Mode, res.Manifest.Code, res.Manifest.Adopted, shortHash(res.ManifestSHA256), shortHash(digest))
+	return out
+}
+
+// reasonText 是日誌用的原因鍵：沒有原因時印 -。
+func reasonText(r reasonKey) string {
+	if r == reasonNone {
+		return "-"
+	}
+	return string(r)
+}
+
+// fail 記一行並標記建置失敗（build-failed）。
+func (b ingameBuild) fail(logf func(string, ...any), format string, a ...any) ingameBuild {
+	logf("ingame: build-failed %s", fmt.Sprintf(format, a...))
+	b.Failed = true
+	return b
+}
+
+func shortHash(s string) string {
+	if len(s) > 12 {
+		return s[:12]
+	}
+	return s
+}
+
+// finish 在 hrrt.Open 之後由 Session.LangStatus() 決定生效 E 與啟動失敗 startFail：
+//   - 建置失敗：E ＝ 原版，startFail ＝ (C_start, build-failed)；
+//   - 沒有傳 LangDir（不建置）：E ＝ 原版，沒有失敗；
+//   - 傳了 LangDir 而 Reason 非空（或生效的 LangDir 為空）：Open 驗證失敗，以空語言層開啟，
+//     E ＝ 原版，startFail ＝ (C_start, verify-failed)；
+//   - 通過：E ＝ 建置時由 manifest 判出的種類。
+func (b ingameBuild) finish(st hrrt.LangStatus, logf func(string, ...any)) (effective, startFail) {
+	if logf == nil {
+		logf = func(string, ...any) {}
+	}
+	switch {
+	case b.Failed:
+		return effective{}, startFail{Start: b.Choice.Code, Reason: reasonBuildFailed}
+	case b.LangDir == "":
+		return effective{}, startFail{}
+	case st.Reason != "" || st.LangDir == "":
+		logf("ingame: verify-failed LangStatus.Reason=%q LangStatus.LangDir=%q（語言包沒有啟用，遊戲內文字維持原版）", st.Reason, st.LangDir)
+		return effective{}, startFail{Start: b.Choice.Code, Reason: reasonVerifyFailed}
+	}
+	logf("ingame: pack-active LangDir=%s", st.LangDir)
+	return b.Pack, startFail{}
+}
+
+// tableSearchFor 組出譯文表的尋找來源（docs/spec/008 第 3.2 節），順序與 themeDirCandidates 一致：
+// 旗標 -l10n、環境變數 HR_L10N、.AppImage 所在目錄、執行檔旁、macOS 的 Contents/Resources、目前目錄、資料目錄。
+// 空字串的來源（沒給旗標、沒設環境變數、不是 AppImage、取不到執行檔路徑）略過。
+func tableSearchFor(flagVal, envVal, appImage, exe, cwd, dataDir string) l10n.TableSearch {
+	s := l10n.TableSearch{Flag: flagVal, Env: envVal, Cwd: cwd, DataDir: dataDir}
+	if appImage != "" {
+		s.AppImageDir = filepath.Dir(appImage)
+	}
+	if exe != "" {
+		s.ExeDir = filepath.Dir(exe)
+		s.MacResources = filepath.Join(s.ExeDir, "..", "Resources")
+	}
+	return s
+}
+
+// findTableFunc 是 ingameRuntime.FindTable：每次呼叫都重新探測（F4 按下時譯文表可能剛放入）。
+func findTableFunc(s l10n.TableSearch) func(ingameCode) bool {
+	return func(c ingameCode) bool {
+		_, ok := l10n.FindTableDirFor(s, string(c))
+		return ok
+	}
+}
+
+// ingameLogf 把日誌寫到 logf（標準錯誤）並追加到資料目錄的 play.log（Windows 以 -H=windowsgui 建置，
+// 標準錯誤看不到，docs/spec/008 第 3.2 節）。play.log 的行格式沿用既有的「時間、標籤、內容」，標籤是 lang。
+func ingameLogf(dataDir string, logf func(string, ...any)) func(string, ...any) {
+	return func(format string, a ...any) {
+		msg := fmt.Sprintf(format, a...)
+		logf("%s", msg)
+		f, err := os.OpenFile(filepath.Join(dataDir, "play.log"), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+		if err != nil {
+			return
+		}
+		defer f.Close()
+		fmt.Fprintf(f, "%s\tlang\t%s\n", time.Now().Format(time.RFC3339), strings.ReplaceAll(msg, "\n", " "))
+	}
+}
diff --git a/apps/hr/play/ingame_start_test.go b/apps/hr/play/ingame_start_test.go
new file mode 100644
index 0000000..d7a8bae
--- /dev/null
+++ b/apps/hr/play/ingame_start_test.go
@@ -0,0 +1,581 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// docs/spec/008 第 3.2 節「啟動順序與可見性」與第 8 節：啟動建置接線（prepareIngame、finish、langOptions）與
+// resolveStartup → planIngame → 建置 → Session.LangStatus → ingameStatus 的串接。建置器與 LangStatus 用假的，不需要原版。
+
+// fakeBuilder 是 ingameBuilder 的假實作：記錄呼叫順序與設定，回傳預先設定的結果。
+type fakeBuilder struct {
+	digest    string
+	digestErr error
+	res       *l10n.Result
+	buildErr  error
+
+	order []string // "digest"、"build" 的呼叫順序
+	cfgs  []l10n.Config
+}
+
+func (f *fakeBuilder) ExpectedDigest(cfg l10n.Config) (string, error) {
+	f.order = append(f.order, "digest")
+	f.cfgs = append(f.cfgs, cfg)
+	return f.digest, f.digestErr
+}
+
+func (f *fakeBuilder) Build(cfg l10n.Config) (*l10n.Result, error) {
+	f.order = append(f.order, "build")
+	f.cfgs = append(f.cfgs, cfg)
+	return f.res, f.buildErr
+}
+
+func (f *fakeBuilder) calls() int { return len(f.order) }
+
+// mkResult 是假建置器回傳的結果：manifest 只填判種類需要的欄位。
+func mkResult(dir, digest, mode string, adopted int, code string) *l10n.Result {
+	return &l10n.Result{
+		Dir: dir, Digest: digest, ManifestSHA256: strings.Repeat("ab", 32),
+		Manifest: &verify.Manifest{Code: code, Policy: verify.Policy{Mode: mode}, Adopted: adopted, InputDigest: digest},
+	}
+}
+
+// mkTables 在暫存目錄建出 l10n 根，每個代碼一個含一個譯文表檔的子目錄；codes 為空時回傳一個空的 l10n 根。
+func mkTables(t *testing.T, codes ...string) string {
+	t.Helper()
+	root := filepath.Join(t.TempDir(), "l10n")
+	if err := os.MkdirAll(root, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range codes {
+		addTable(t, root, c)
+	}
+	return root
+}
+
+// addTable 在 l10n 根下放入某語言的譯文表（一個譯文表檔）。
+func addTable(t *testing.T, root, code string) {
+	t.Helper()
+	d := filepath.Join(root, code)
+	if err := os.MkdirAll(d, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(d, "SP.MES.tsv"), []byte("id\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func newInput(t *testing.T, c ingameChoice, b ingameBuilder, tableRoot string) (ingameInput, *lineLog) {
+	t.Helper()
+	log := &lineLog{}
+	return ingameInput{
+		Choice: c, Search: l10n.TableSearch{Flag: tableRoot}, OrigDir: "/orig", PackRoot: "/packs", Builder: b, Logf: log.logf,
+	}, log
+}
+
+// 預設路徑（沒有譯文表而且非明示）不呼叫任何建置；啟動成本與現況相同。控制組：明示或有表時一定呼叫。
+func TestPrepareIngameDefaultPathNeverCallsBuilder(t *testing.T) {
+	for _, l2 := range []bool{false, true} {
+		for _, code := range ingameCycle {
+			fb := &fakeBuilder{}
+			in, _ := newInput(t, ingameChoice{code, false}, fb, mkTables(t))
+			in.L2, in.PatchInHand = l2, l2
+			out := prepareIngame(in)
+			if fb.calls() != 0 {
+				t.Errorf("(%s, 非明示)、沒有譯文表、l2 ＝ %v：呼叫了建置器 %v", code, l2, fb.order)
+			}
+			if out.Plan.Kind != planNone || out.Failed || out.LangDir != "" || out.LangDigest != "" {
+				t.Errorf("(%s, 非明示)、沒有譯文表：%+v", code, out)
+			}
+		}
+	}
+	// 沒有任何來源（零值的搜尋）
+	fb := &fakeBuilder{}
+	prepareIngame(ingameInput{Choice: ingameChoice{icTW, false}, Builder: fb})
+	if fb.calls() != 0 {
+		t.Errorf("零值搜尋：呼叫了建置器 %v", fb.order)
+	}
+	// none 即使有表也不建置
+	fb = &fakeBuilder{}
+	in, _ := newInput(t, ingameChoice{icNone, true}, fb, mkTables(t, "zh-TW"))
+	prepareIngame(in)
+	if fb.calls() != 0 {
+		t.Errorf("none：呼叫了建置器 %v", fb.order)
+	}
+	// 空的 <代碼>/ 目錄不算有表
+	root := filepath.Join(t.TempDir(), "l10n")
+	if err := os.MkdirAll(filepath.Join(root, "zh-TW"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	fb = &fakeBuilder{}
+	in, _ = newInput(t, ingameChoice{icTW, false}, fb, root)
+	prepareIngame(in)
+	if fb.calls() != 0 {
+		t.Errorf("空的 zh-TW 目錄：呼叫了建置器 %v", fb.order)
+	}
+
+	// 控制組：偵測器不是恆零
+	for name, c := range map[string]struct {
+		c      ingameChoice
+		tables []string
+	}{
+		"(zh-TW, 明示)，沒有表": {ingameChoice{icTW, true}, nil},
+		"(zh-TW, 非明示)，有表": {ingameChoice{icTW, false}, []string{"zh-TW"}},
+		"(identity, 明示)":  {ingameChoice{icIdentity, true}, nil},
+		"(zh-TW, 明示)，有表":  {ingameChoice{icTW, true}, []string{"zh-TW"}},
+	} {
+		fb := &fakeBuilder{digest: strings.Repeat("d", 64), res: mkResult("/packs/p", strings.Repeat("d", 64), "identity", 0, string(c.c.Code))}
+		in, _ := newInput(t, c.c, fb, mkTables(t, c.tables...))
+		prepareIngame(in)
+		if fb.calls() != 2 {
+			t.Errorf("控制組 %s：建置器呼叫 %v，應為 digest、build", name, fb.order)
+		}
+	}
+}
