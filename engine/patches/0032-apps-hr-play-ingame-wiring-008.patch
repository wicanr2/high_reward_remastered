+// ---- 串接：resolveStartup → planIngame → 建置（假建置器）→ finish（假 LangStatus）→ ingameStatus ----
+
+type chainCase struct {
+	name string
+	f    startupFlags
+	env  startupEnv
+	p    prefs
+	// 環境
+	tables    []string // 有譯文表的語言
+	late      []string // 啟動之後才放入譯文表的語言（avail 在 F4 時重新計算，列 20）
+	l2, patch bool
+	// 假建置器與假 LangStatus
+	mode    string
+	adopted int
+	buildOK bool
+	status  *hrrt.LangStatus // nil ＝ 驗證通過（LangDir 為包的 files）
+	// 評估的選擇：空 ＝ 啟動時的選擇；非空 ＝ F4 之後的選擇（非覆蓋時）
+	sel ingameCode
+	// 預期
+	plan  planKind
+	calls int
+	f1    f1Value
+	toast toastKey
+}
+
+func runChain(t *testing.T, c chainCase) {
+	t.Helper()
+	d := strings.Repeat("9", 64)
+	plan := resolveStartup(c.f, c.env, c.p, []themeID{themeOriginal})
+	root := mkTables(t, c.tables...)
+	fb := &fakeBuilder{digest: d}
+	if c.buildOK {
+		fb.res = mkResult("/packs/p", d, c.mode, c.adopted, string(plan.Ingame.Code))
+	} else {
+		fb.buildErr = errors.New("建置失敗")
+	}
+	in, _ := newInput(t, plan.Ingame, fb, root)
+	in.L2, in.PatchInHand = c.l2, c.patch
+	b := prepareIngame(in)
+	if b.Plan.Kind != c.plan || fb.calls() != c.calls {
+		t.Errorf("%s：計畫 %v、建置器呼叫 %d 次，應為 %v、%d 次", c.name, b.Plan.Kind, fb.calls(), c.plan, c.calls)
+	}
+	st := hrrt.LangStatus{LangDir: b.LangDir}
+	if c.status != nil {
+		st = *c.status
+	}
+	e, sf := b.finish(st, nil)
+	for _, code := range c.late {
+		addTable(t, root, code)
+	}
+	s := ingameCode(plan.Lang)
+	if plan.Override {
+		s = plan.Ingame.Code
+	}
+	if c.sel != "" && !plan.Override {
+		s = c.sel
+	}
+	find := findTableFunc(l10n.TableSearch{Flag: root})
+	out := ingameStatus(s, e, sf, plan.Override, func(x ingameCode) availResult { return availFor(x, find, c.l2, c.patch) })
+	if out.F1 != c.f1 || out.Toast != c.toast {
+		t.Errorf("%s：S ＝ %s、E ＝ %+v、startFail ＝ %+v → F1 ＝ %+v、toast ＝ %d，應為 %+v、%d", c.name, s, e, sf, out.F1, out.Toast, c.f1, c.toast)
+	}
+}
