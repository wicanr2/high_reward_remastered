+// 五種語言的最長組合在 fitLine 下不被截斷（沿用 panel_test.go 的兩種獨立量法）：F4 提示（語言名稱接五種字句）
+// 與 F1「遊戲內文字」行（五個語言譯名、identity、五個原因、五個字句模板的全部組合）。
+// 字元不在字型子集內時 fitLine 會換成 ?，這個測試也因此守住「新字串已進字元表並重產字型」。
+func TestIngameLongestTextsAreNotTruncated(t *testing.T) {
+	for _, l := range langOrder {
+		face := mustFace(t, l)
+		ht := hudText{l: l, face: face}
+		check := func(what, raw string) {
+			t.Helper()
+			if got := fitLine(face, raw, hudW); got != raw {
+				t.Errorf("%s %s：被截斷或換字：%q → %q", l, what, raw, got)
+			}
+			if w := advanceWidth(face, raw); w > hudW {
+				t.Errorf("%s %s：前進量 %d > %d", l, what, w, hudW)
+			}
+			if w := inkRightEdge(face, raw); w > hudW {
+				t.Errorf("%s %s：墨跡右緣 %d > %d", l, what, w, hudW)
+			}
+		}
+		for _, k := range toastKeys {
+			raw := ingameToastText(ht.t, langNames[l], k)
+			check(fmt.Sprintf("toast %d", k), raw)
+			tt := &toaster{}
+			now := time.Date(2026, 10, 4, 12, 0, 0, 0, time.UTC)
+			tt.ShowRaw(now, raw)
+			if s, ok := ht.toast(tt, now); !ok || s != raw {
+				t.Errorf("%s toast %d 經 hudText.toast：%q %v", l, k, s, ok)
+			}
+		}
+		codes := append(append([]ingameCode{}, ingameCycle...), icIdentity)
+		var vals []f1Value
+		vals = append(vals, origF1)
+		for _, c := range codes {
+			vals = append(vals, partial(c), verifyUse(c), pending(c))
+			for _, r := range reasonKeys {
+				vals = append(vals, unusable(c, r))
+			}
+		}
+		for _, v := range vals {
+			raw := tr(l, "status.game", ingameF1Text(ht.t, v))
+			check(fmt.Sprintf("F1 %+v", v), raw)
+			info := normalInfo()
+			info.Ingame = v
+			if got := panelLines(l, face, info)[rowStatus+2]; got != raw {
+				t.Errorf("%s 面板第 %d 行：%q，應為 %q", l, rowStatus+2, got, raw)
+			}
+		}
+		// ASCII 退回版：只含 ASCII，且是英文
+		for _, v := range vals {
+			info := normalInfo()
+			info.Ingame = v
+			line := panelLinesASCII(l, info)[rowStatus+2]
+			for _, r := range line {
+				if r < 0x20 || r > 0x7E {
+					t.Errorf("ASCII 退回版第 %d 行含非 ASCII：%q", rowStatus+2, line)
+					break
+				}
+			}
+		}
+	}
+}
