+		{"通過驗證", built, hrrt.LangStatus{LangDir: "/p/files"}, pack, noFail},
+		{"驗證失敗：Reason 非空", built, hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}, eOrig, startFail{icIdentity, reasonVerifyFailed}},
+		{"驗證失敗：Reason 非空而 LangDir 仍有值", built, hrrt.LangStatus{LangDir: "/p/files", Reason: hrrt.LangReasonVerifyFailed}, eOrig, startFail{icIdentity, reasonVerifyFailed}},
