+// 列舉常數與字串表、語言循環一致。
+func TestIngameCodesMatchLangs(t *testing.T) {
+	if len(ingameCycle) != len(langOrder) {
+		t.Fatalf("F4 循環 %d 種，langOrder %d 種", len(ingameCycle), len(langOrder))
+	}
+	for i, l := range langOrder {
+		if ingameCycle[i] != ingameCode(l) {
+			t.Errorf("第 %d 個：%s，應為 %s", i, ingameCycle[i], l)
+		}
+		if !ingameCode(l).inCycle() {
+			t.Errorf("%s 應在 F4 循環內", l)
+		}
+	}
+	for _, c := range []ingameCode{icNone, icIdentity, "", "zh-tw"} {
+		if c.inCycle() {
+			t.Errorf("%q 不該在 F4 循環內", c)
+		}
+	}
+	for _, s := range []string{"zh-TW", "zh-CN", "ko", "en", "ja", "none", "identity"} {
+		if c, ok := parseIngameCode(s); !ok || string(c) != s {
+			t.Errorf("parseIngameCode(%q) 應成功", s)
+		}
+	}
+	for _, s := range []string{"", "zh", "ZH-TW", "zh-tw", "fr", "None", " ja", "ja "} {
+		if _, ok := parseIngameCode(s); ok {
+			t.Errorf("parseIngameCode(%q) 應失敗", s)
+		}
+	}
+	if manifestModeIdentity != string(l10n.ModeIdentity) {
+		t.Errorf("manifestModeIdentity %q ≠ l10n.ModeIdentity %q", manifestModeIdentity, l10n.ModeIdentity)
+	}
+	if len(reasonKeys) != 5 {
+		t.Errorf("原因列舉應有五個：%v", reasonKeys)
+	}
+}
