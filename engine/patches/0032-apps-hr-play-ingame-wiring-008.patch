+		{"預期摘要為空", &fakeBuilder{digest: "", res: good()}, 0, []string{"build-failed", "摘要為空"}},
+		{"建置出錯", &fakeBuilder{digest: d, buildErr: errors.New("資料目錄不可寫"), res: good()}, 1, []string{"build-failed", "資料目錄不可寫"}},
