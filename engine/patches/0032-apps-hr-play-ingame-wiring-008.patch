+package main
+
+import (
+	"testing"
+)
+
+// docs/spec/008 第 3.2 節與第 8 節「啟用規則」那一列的 resolveStartup 層：遊戲內語言 C ＝ (代碼, 明示) 與 override。
+
+func ingStartup(flag string, flagGiven bool, env string, p prefs, f startupFlags) startupPlan {
+	f.IngameLang, f.IngameLangGiven = flag, flagGiven
+	return resolveStartup(f, startupEnv{IngameLang: env}, p, []themeID{themeOriginal})
+}
+
+func TestResolveStartupIngameChoice(t *testing.T) {
+	cases := []struct {
+		name     string
+		flag     string
+		given    bool
+		env      string
+		p        prefs
+		f        startupFlags // 其餘旗標（例如 -lang）
+		code     ingameCode
+		explicit bool
+		logSub   string // 日誌必須含有；空 ＝ 不該有任何日誌
+	}{
+		{name: "全部沒給：取 lang（預設 zh-TW），非明示", code: icTW},
+		{name: "偏好設定的 lang：非明示", p: prefs{Lang: "ko"}, code: icKO},
+		{name: "-lang：非明示", f: startupFlags{Lang: "ja", LangGiven: true}, p: prefs{Lang: "ko"}, code: icJA},
+		{name: "-ingame-lang ja：明示", flag: "ja", given: true, code: icJA, explicit: true},
+		{name: "-ingame-lang none", flag: "none", given: true, code: icNone, explicit: true},
+		{name: "-ingame-lang identity", flag: "identity", given: true, code: icIdentity, explicit: true},
+		{name: "-ingame-lang zh-TW：明示（與 lang 的 zh-TW 不同）", flag: "zh-TW", given: true, code: icTW, explicit: true},
+		{name: "HR_INGAME_LANG＝en：明示", env: "en", code: icEN, explicit: true},
+		{name: "旗標勝過環境變數與 lang", flag: "ko", given: true, env: "ja", f: startupFlags{Lang: "en", LangGiven: true}, code: icKO, explicit: true},
+		{name: "環境變數勝過 lang 與偏好設定", env: "zh-CN", p: prefs{Lang: "ko"}, f: startupFlags{Lang: "en", LangGiven: true}, code: icCN, explicit: true},
+		{name: "-ingame-lang 不認得且沒有環境變數：用 lang，非明示，override 為否", flag: "fr", given: true, p: prefs{Lang: "ko"}, code: icKO, logSub: "-ingame-lang"},
+		{name: "-ingame-lang 不認得加 HR_INGAME_LANG＝ja：(ja, 明示)，override 為是", flag: "fr", given: true, env: "ja", code: icJA, explicit: true, logSub: "-ingame-lang"},
+		{name: "HR_INGAME_LANG 不認得：往下找 lang", env: "xx", f: startupFlags{Lang: "en", LangGiven: true}, code: icEN, logSub: "HR_INGAME_LANG"},
+		{name: "兩個都不認得：lang", flag: "a", given: true, env: "b", code: icTW, logSub: "HR_INGAME_LANG"},
+		{name: "-ingame-lang 空字串視為沒給（不記日誌）：取環境變數", flag: "", given: true, env: "ko", code: icKO, explicit: true},
+		{name: "-ingame-lang 空字串且沒有環境變數：取 lang", flag: "", given: true, code: icTW},
+		{name: "HR_INGAME_LANG 空字串視為沒給：取 lang", env: "", code: icTW},
+		{name: "沒給旗標（given 為假）時旗標值不生效", flag: "ja", given: false, code: icTW},
+		{name: "大小寫與空白必須完全相符", flag: "ZH-TW", given: true, env: " ja", code: icTW, logSub: "-ingame-lang"},
+	}
+	for _, c := range cases {
+		plan := ingStartup(c.flag, c.given, c.env, c.p, c.f)
+		if plan.Ingame != (ingameChoice{c.code, c.explicit}) || plan.Override != c.explicit {
+			t.Errorf("%s：C ＝ %+v、override ＝ %v，應為 (%s, 明示 %v)", c.name, plan.Ingame, plan.Override, c.code, c.explicit)
+		}
+		if c.logSub == "" {
+			for _, l := range plan.Logs {
+				t.Errorf("%s：不該有日誌：%q", c.name, l)
+			}
+		} else if !hasLog(plan, c.logSub) {
+			t.Errorf("%s：日誌應含 %q：%v", c.name, c.logSub, plan.Logs)
+		}
+	}
+}
+
+// 對所有旗標與環境組合斷言 C 的明示欄等於 override；非明示時 C 的代碼就是介面語言 lang；明示時代碼來自旗標或環境變數。
+func TestResolveStartupIngameExplicitEqualsOverride(t *testing.T) {
+	vals := []string{"", "zh-TW", "zh-CN", "ko", "en", "ja", "none", "identity", "fr", "ZH-TW", "zh", " "}
+	langs := []struct {
+		f startupFlags
+		p prefs
+	}{
+		{}, {f: startupFlags{Lang: "en", LangGiven: true}}, {p: prefs{Lang: "ja"}}, {f: startupFlags{Lang: "xx", LangGiven: true}, p: prefs{Lang: "ko"}},
+	}
+	n := 0
+	for _, fv := range vals {
+		for _, fg := range []bool{false, true} {
+			for _, ev := range vals {
+				for _, l := range langs {
+					n++
+					plan := ingStartup(fv, fg, ev, l.p, l.f)
+					if plan.Ingame.Explicit != plan.Override {
+						t.Errorf("旗標 %q（給 %v）、環境 %q：C 的明示 %v ≠ override %v", fv, fg, ev, plan.Ingame.Explicit, plan.Override)
+					}
+					fromFlag, flagOK := parseIngameCode(fv)
+					fromEnv, envOK := parseIngameCode(ev)
+					flagOK = flagOK && fg && fv != ""
+					envOK = envOK && ev != ""
+					switch {
+					case flagOK:
+						if plan.Ingame != (ingameChoice{fromFlag, true}) {
+							t.Errorf("旗標 %q、環境 %q：C ＝ %+v，應取旗標", fv, ev, plan.Ingame)
+						}
+					case envOK:
+						if plan.Ingame != (ingameChoice{fromEnv, true}) {
+							t.Errorf("旗標 %q、環境 %q：C ＝ %+v，應取環境變數", fv, ev, plan.Ingame)
+						}
+					default:
+						if plan.Ingame != (ingameChoice{ingameCode(plan.Lang), false}) || plan.Override {
+							t.Errorf("旗標 %q、環境 %q：C ＝ %+v、override %v，應取 lang %s 且非明示", fv, ev, plan.Ingame, plan.Override, plan.Lang)
+						}
+					}
+					// 前置條件：none 與 identity 蘊含明示
+					if (plan.Ingame.Code == icNone || plan.Ingame.Code == icIdentity) && !plan.Ingame.Explicit {
+						t.Errorf("none 或 identity 必須是明示：%+v", plan.Ingame)
+					}
+				}
+			}
+		}
+	}
+	if n != len(vals)*2*len(vals)*len(langs) {
+		t.Fatalf("組合數 %d", n)
+	}
+}
+
+// 遊戲內語言不是設定值：不影響 theme、lang、聲音的優先序與輸出。
+func TestResolveStartupIngameDoesNotAffectOtherSettings(t *testing.T) {
+	base := resolveStartup(startupFlags{Lang: "en", LangGiven: true, Mute: true, MuteGiven: true}, startupEnv{Mute: "0"}, prefs{Theme: "original"}, []themeID{themeOriginal, themeHD})
+	got := resolveStartup(startupFlags{Lang: "en", LangGiven: true, Mute: true, MuteGiven: true, IngameLang: "identity", IngameLangGiven: true},
+		startupEnv{Mute: "0", IngameLang: "ja"}, prefs{Theme: "original"}, []themeID{themeOriginal, themeHD})
+	if got.Theme != base.Theme || got.Lang != base.Lang || got.Muted != base.Muted || got.HDHooks != base.HDHooks || len(got.Logs) != len(base.Logs) {
+		t.Errorf("遊戲內語言旗標改了其他設定：%+v、%+v", got, base)
+	}
+	if got.Lang != langEN {
+		t.Errorf("-ingame-lang 不該改介面語言：%s", got.Lang)
+	}
+	// 介面語言不認得時 C 的代碼取退回的 lang（zh-TW），不是原始字串
+	p := resolveStartup(startupFlags{Lang: "xx", LangGiven: true}, startupEnv{}, prefs{}, nil)
+	if p.Ingame != (ingameChoice{icTW, false}) {
+		t.Errorf("lang 不認得退回 zh-TW：%+v", p.Ingame)
+	}
+}
