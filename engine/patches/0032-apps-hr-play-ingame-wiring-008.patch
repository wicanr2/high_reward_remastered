+func tFor(l lang) tfunc { return func(k string, a ...any) string { return tr(l, k, a...) } }
+
+// 規格第 3.8 節的字句模板（zh-TW 與 en 逐字）；identity 顯示字面；原因顯示譯名，不顯示原始鍵。
+func TestIngameF1TextTemplates(t *testing.T) {
+	tw := tFor(langTW)
+	cases := []struct {
+		v    f1Value
+		want string
+	}{
+		{origF1, "原版（繁體中文）"},
+		{partial(icTW), "語言包 繁體中文（部分翻譯）"},
+		{verifyUse(icTW), "語言包 繁體中文（原版文字，驗證用）"},
+		{verifyUse(icIdentity), "語言包 identity（原版文字，驗證用）"},
+		{pending(icKO), "已選 韓文，下次啟動生效"},
+		{unusable(icTW, reasonBuildFailed), "已選 繁體中文，無法使用：建置失敗"},
+		{unusable(icIdentity, reasonBuildFailed), "已選 identity，無法使用：建置失敗"},
+		{unusable(icKO, reasonNoTable), "已選 韓文，無法使用：沒有譯文表"},
+		{unusable(icJA, reasonUnsupported), "已選 日文，無法使用：尚未支援此語言"},
+	}
+	for _, c := range cases {
+		if got := ingameF1Text(tw, c.v); got != c.want {
+			t.Errorf("%+v：%q，應為 %q", c.v, got, c.want)
+		}
+	}
+	en := tFor(langEN)
+	if got := ingameF1Text(en, unusable(icKO, reasonNoTable)); got != "Korean selected, unavailable: no translation table" {
+		t.Errorf("英文：%q", got)
+	}
+	if got := ingameF1Text(en, origF1); got != "Original (Traditional Chinese)" {
+		t.Errorf("英文 (1)：%q", got)
+	}
+}
