+// ---- 性質測試：前置條件域內窮舉，函式有定義 ----
+
+func TestIngameStatusProperty(t *testing.T) {
+	effs := []effective{eOrig, eIdTW, eIdID, eZeroTbl, eTable, eOther(icCN), eOther(icKO), eOther(icEN), eOther(icJA)}
+	fails := []startFail{noFail}
+	for _, c := range ingameValues {
+		for _, r := range []reasonKey{reasonBuildFailed, reasonVerifyFailed} {
+			fails = append(fails, startFail{c, r})
+		}
+	}
+	avs := []*availResult{okAvail(), noAvail(reasonNoTable), noAvail(reasonUnsupported), noAvail(reasonNoPatch)}
+	inDomain := func(s ingameCode, e effective, sf startFail, ov bool) bool {
+		if sf.active() && e.Kind != effOriginal {
+			return false // 啟動失敗時 E 必為原版
+		}
+		switch s {
+		case icNone: // none 蘊含 override、E ＝ 原版、startFail 為空
+			return ov && e.Kind == effOriginal && !sf.active()
+		case icIdentity: // identity 蘊含 override，且 E 是 identity 包，或 E ＝ 原版且 startFail ＝ (identity, ·)
+			return ov && (e.Kind == effIdentityPack || (e.Kind == effOriginal && sf.active() && sf.Start == icIdentity))
+		}
+		return true
+	}
+	valid := map[reasonKey]bool{reasonNoTable: true, reasonBuildFailed: true, reasonVerifyFailed: true, reasonNoPatch: true, reasonUnsupported: true}
+	count := 0
+	for _, s := range ingameValues {
+		for _, e := range effs {
+			for _, sf := range fails {
+				for _, ov := range []bool{false, true} {
+					if !inDomain(s, e, sf, ov) {
+						continue
+					}
+					cands := avs
+					if !s.inCycle() {
+						cands = []*availResult{nil}
+					}
+					for _, av := range cands {
+						count++
+						func() {
+							defer func() {
+								if p := recover(); p != nil {
+									t.Errorf("S ＝ %s、E ＝ %+v、startFail ＝ %+v、override ＝ %v、avail ＝ %v：panic：%v", s, e, sf, ov, av, p)
+								}
+							}()
+							o := ingameStatus(s, e, sf, ov, strictAvail(s, av, nil))
+							if o.F1.Class < f1Orig || o.F1.Class > f1Unusable {
+								t.Errorf("F1 值不屬四類：%+v", o.F1)
+							}
+							known := false
+							for _, k := range toastKeys {
+								known = known || o.Toast == k
+							}
+							if !known {
+								t.Errorf("toast 不屬五種：%d", o.Toast)
+							}
+							if (o.Toast == toastFlag) != ov {
+								t.Errorf("toast 與 override 不一致：%d、%v", o.Toast, ov)
+							}
+							switch o.F1.Class {
+							case f1Unusable:
+								if !valid[o.F1.Reason] {
+									t.Errorf("(4) 的原因鍵 %q 不在列舉內", o.F1.Reason)
+								}
+							case f1Pack:
+								if e.Kind == effOriginal {
+									t.Errorf("E ＝ 原版卻顯示 (2)：%+v", o.F1)
+								}
+							case f1Pending:
+								if av == nil || !av.OK {
+									t.Errorf("avail 不為真卻顯示 (3)：%+v", o.F1)
+								}
+							}
+						}()
+					}
+				}
+			}
+		}
+	}
+	if count < 500 {
+		t.Fatalf("域內只窮舉了 %d 組，太少", count)
+	}
+	t.Logf("前置條件域內窮舉 %d 組", count)
+}
