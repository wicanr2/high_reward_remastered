+type truthRow struct {
+	n        int
+	s        ingameCode
+	e        effective
+	sf       startFail
+	override bool
+	avail    *availResult // nil ＝ 不定義（S 為 none 或 identity）
+	f1       f1Value
+	toast    toastKey
+}
+
+func unusable(c ingameCode, r reasonKey) f1Value {
+	return f1Value{Class: f1Unusable, Code: c, Reason: r}
+}
+func pending(c ingameCode) f1Value   { return f1Value{Class: f1Pending, Code: c} }
+func partial(c ingameCode) f1Value   { return f1Value{Class: f1Pack, Code: c} }
+func verifyUse(c ingameCode) f1Value { return f1Value{Class: f1Pack, Code: c, Verify: true} }
+
+var origF1 = f1Value{Class: f1Orig}
+
+var noFail = startFail{}
+
+func truthTable() []truthRow {
+	return []truthRow{
+		{1, icTW, eOrig, noFail, false, noAvail(reasonNoTable), origF1, toastSame},
+		{2, icTW, eOrig, noFail, false, noAvail(reasonNoTable), origF1, toastSame},
+		{3, icKO, eOrig, noFail, false, noAvail(reasonNoTable), unusable(icKO, reasonNoTable), toastNoPack},
+		{4, icJA, eOrig, noFail, false, noAvail(reasonUnsupported), unusable(icJA, reasonUnsupported), toastNoPack},
+		{5, icJA, eOrig, noFail, false, okAvail(), pending(icJA), toastNext},
+		{6, icTW, eTable, noFail, false, okAvail(), partial(icTW), toastSame},
+		{7, icKO, eTable, noFail, false, noAvail(reasonNoTable), unusable(icKO, reasonNoTable), toastNoPack},
+		{8, icTW, eTable, noFail, true, okAvail(), partial(icTW), toastFlag},
+		{9, icTW, eIdTW, noFail, true, noAvail(reasonNoTable), verifyUse(icTW), toastFlag},
+		{10, icIdentity, eIdID, noFail, true, nil, verifyUse(icIdentity), toastFlag},
+		{11, icNone, eOrig, noFail, true, nil, origF1, toastFlag},
+		{12, icJA, eOrig, noFail, true, noAvail(reasonUnsupported), unusable(icJA, reasonUnsupported), toastFlag},
+		{13, icJA, eOrig, startFail{icJA, reasonBuildFailed}, false, okAvail(), unusable(icJA, reasonBuildFailed), toastUnusable},
+		{14, icJA, eOrig, startFail{icJA, reasonVerifyFailed}, false, okAvail(), unusable(icJA, reasonVerifyFailed), toastUnusable},
+		{15, icKO, eOrig, startFail{icJA, reasonBuildFailed}, false, noAvail(reasonNoTable), unusable(icKO, reasonNoTable), toastNoPack},
+		{16, icJA, eOrig, startFail{icJA, reasonBuildFailed}, false, okAvail(), unusable(icJA, reasonBuildFailed), toastUnusable},
+		{17, icIdentity, eOrig, startFail{icIdentity, reasonBuildFailed}, true, nil, unusable(icIdentity, reasonBuildFailed), toastFlag},
+		{18, icJA, eOrig, noFail, true, noAvail(reasonNoTable), unusable(icJA, reasonNoTable), toastFlag},
+		{19, icTW, eOrig, startFail{icTW, reasonBuildFailed}, false, okAvail(), unusable(icTW, reasonBuildFailed), toastUnusable},
+		{20, icTW, eOrig, noFail, false, okAvail(), pending(icTW), toastNext},
+		{21, icTW, eZeroTbl, noFail, true, okAvail(), verifyUse(icTW), toastFlag},
+		{22, icTW, eOrig, startFail{icTW, reasonBuildFailed}, true, okAvail(), unusable(icTW, reasonBuildFailed), toastFlag},
+		{23, icTW, eZeroTbl, noFail, false, okAvail(), verifyUse(icTW), toastSame},
+	}
+}
