+// LangDir 非空時 LangDigest 必須非空；沒有建置或失敗時兩者都空（以 resolveStartup 的 C 到 hrrt.Options 的兩個欄位斷言，
+// docs/spec/008 第 8 節 manifest 那一列）。
+func TestLangOptionsInvariant(t *testing.T) {
+	d := strings.Repeat("a", 64)
+	for _, flags := range []startupFlags{
+		{}, {IngameLang: "identity", IngameLangGiven: true}, {IngameLang: "zh-TW", IngameLangGiven: true},
+		{IngameLang: "none", IngameLangGiven: true}, {IngameLang: "ja", IngameLangGiven: true}, {Lang: "ko", LangGiven: true},
+	} {
+		for _, tables := range [][]string{nil, {"zh-TW"}} {
+			for _, fail := range []bool{false, true} {
+				plan := resolveStartup(flags, startupEnv{}, prefs{}, []themeID{themeOriginal})
+				fb := &fakeBuilder{digest: d, res: mkResult("/packs/p", d, "identity", 0, string(plan.Ingame.Code))}
+				if fail {
+					fb.buildErr = errors.New("失敗")
+				}
+				in, _ := newInput(t, plan.Ingame, fb, mkTables(t, tables...))
+				out := prepareIngame(in)
+				dir, dig := out.langOptions()
+				if dir != "" && dig == "" {
+					t.Errorf("%+v 表 %v 失敗 %v：LangDir 非空而 LangDigest 為空", flags, tables, fail)
+				}
+				if dir != "" && dig != d {
+					t.Errorf("%+v 表 %v：LangDigest 應是先算的摘要：%q", flags, tables, dig)
+				}
+				if (dir == "") != (dig == "") {
+					t.Errorf("%+v 表 %v 失敗 %v：兩欄要同時有或同時沒有：%q、%q", flags, tables, fail, dir, dig)
+				}
+				if fail && dir != "" {
+					t.Errorf("建置失敗卻傳了 LangDir：%q", dir)
+				}
+				if fb.calls() == 0 && dir != "" {
+					t.Errorf("沒有呼叫建置器卻傳了 LangDir：%q", dir)
+				}
+			}
+		}
+	}
+	// 即使建置器回了結果，只要先算的摘要是空的就不傳 LangDir
+	if dir, dig := (ingameBuild{LangDir: "/x/files"}).langOptions(); dir != "" || dig != "" {
+		t.Errorf("LangDigest 為空時不得傳 LangDir：%q、%q", dir, dig)
+	}
+	// 明示 identity 的預設路徑會傳 LangDir 與非空的 LangDigest
+	plan := resolveStartup(startupFlags{IngameLang: "identity", IngameLangGiven: true}, startupEnv{}, prefs{}, nil)
+	fb := &fakeBuilder{digest: d, res: mkResult("/packs/identity-x", d, "identity", 0, "identity")}
+	in, _ := newInput(t, plan.Ingame, fb, mkTables(t))
+	if dir, dig := prepareIngame(in).langOptions(); dir != "/packs/identity-x/files" || dig != d {
+		t.Errorf("identity：langOptions ＝ %q、%q", dir, dig)
+	}
+}
