+// 由 manifest 判出的種類：模式 identity、採用列數 0 的 table 包視同 identity；採用列數 > 0 的 zh-TW 是表包；其他語言是語言包。
+func TestEffectiveFromManifest(t *testing.T) {
+	cases := []struct {
+		mode    string
+		adopted int
+		code    ingameCode
+		kind    effKind
+	}{
+		{"identity", 0, icTW, effIdentityPack},
+		{"identity", 0, icIdentity, effIdentityPack},
+		{"identity", 3, icTW, effIdentityPack},
+		{"table", 0, icTW, effIdentityPack},
+		{"table", 1, icTW, effTablePack},
+		{"table", 99, icTW, effTablePack},
+		{"table", 5, icJA, effOtherPack},
+		{"table", 0, icJA, effIdentityPack},
+	}
+	for _, c := range cases {
+		got := effectiveFromManifest(c.mode, c.adopted, c.code)
+		if got.Kind != c.kind || got.Code != c.code {
+			t.Errorf("(%s, %d, %s) ＝ %+v，應為種類 %d", c.mode, c.adopted, c.code, got, c.kind)
+		}
+	}
+}
