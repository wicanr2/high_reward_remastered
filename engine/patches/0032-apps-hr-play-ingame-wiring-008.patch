diff --git a/apps/hr/play/ingame.go b/apps/hr/play/ingame.go
new file mode 100644
index 0000000..9af3444
--- /dev/null
+++ b/apps/hr/play/ingame.go
@@ -0,0 +1,401 @@
+package main
+
+// 遊戲內文字語言的決策（docs/spec/008 第 3.2、3.8 節）。本檔只有型別與純函式，不碰 ebiten、檔案與建置器，
+// 所以真值表與啟用規則可以在單元測試裡逐項斷言。
+//
+//	resolveStartup  →  C ＝ (代碼, 明示)                     startup.go
+//	planIngame      →  不建置｜建置 table｜建置 identity      本檔（規則 1 至 4）
+//	（建置與 Session.Open，ingame_start.go）→ E、startFail
+//	ingameStatus    →  F1 值（四類）與 F4 的 toast 鍵（五種）  本檔（第 3.8 節四步判定）
+
+// ingameCode 是遊戲內語言的選擇值：F4 循環的五種語言，加上只能由覆蓋旗標指定的 none 與 identity。
+type ingameCode string
+
+const (
+	icTW       ingameCode = "zh-TW"
+	icCN       ingameCode = "zh-CN"
+	icKO       ingameCode = "ko"
+	icEN       ingameCode = "en"
+	icJA       ingameCode = "ja"
+	icNone     ingameCode = "none"     // 原版（不建置）
+	icIdentity ingameCode = "identity" // 驗證用：建置 identity 包，全部 keep
+)
+
+// ingameCycle 是 F4 循環的五種語言（與 langOrder 相同順序）。none 與 identity 不在其中。
+var ingameCycle = []ingameCode{icTW, icCN, icKO, icEN, icJA}
+
+// ingameValues 是旗標與環境變數認得的全部值。
+var ingameValues = []ingameCode{icTW, icCN, icKO, icEN, icJA, icNone, icIdentity}
+
+func parseIngameCode(s string) (ingameCode, bool) {
+	for _, c := range ingameValues {
+		if string(c) == s {
+			return c, true
+		}
+	}
+	return "", false
+}
+
+// inCycle 回傳 c 是否為 F4 循環的五種語言之一（只有這五種定義 avail）。
+func (c ingameCode) inCycle() bool {
+	for _, x := range ingameCycle {
+		if x == c {
+			return true
+		}
+	}
+	return false
+}
+
+// ingameChoice 是遊戲內語言選擇 C ＝ (代碼, 明示)。值來自 -ingame-lang 或 HR_INGAME_LANG 時明示為真，
+// 來自介面語言設定 lang 時為假。「明示」與 ingameStatus 的 override 是同一個謂詞。
+// 前置條件：none 與 identity 蘊含明示為真（它們只能由覆蓋旗標指定）。
+type ingameChoice struct {
+	Code     ingameCode
+	Explicit bool
+}
+
+// reasonKey 是「無法使用」的原因鍵。顯示時一律查字串表的譯名，不顯示原始鍵。
+type reasonKey string
+
+const (
+	reasonNone         reasonKey = ""
+	reasonNoTable      reasonKey = "no-table"             // 沒有該語言的譯文表
+	reasonBuildFailed  reasonKey = "build-failed"         // 建置錯誤、序號用盡、資料目錄不可寫
+	reasonVerifyFailed reasonKey = "verify-failed"        // manifest 驗證失敗、LangDir 不存在
+	reasonNoPatch      reasonKey = "no-patch"             // 字模補丁不在手
+	reasonUnsupported  reasonKey = "unsupported-language" // L2 尚未實作
+)
+
+// reasonKeys 是原因列舉的全部五個值（顯示用的字串表鍵是 "ingame.reason."＋鍵）。
+var reasonKeys = []reasonKey{reasonNoTable, reasonBuildFailed, reasonVerifyFailed, reasonNoPatch, reasonUnsupported}
+
+// l2Supported 與 patchInHand：L2（字模補丁與自訂碼）尚未實作，所以其他語言一律不建置（規則 4），
+// 補丁恆不在手。L2 實作後 l2Supported 改為 true，patchInHand 改為「補丁檔存在」。
+const (
+	l2Supported = false
+	patchInHand = false
+)
+
+// unavailReason 是 avail(X) 為假時的原因鍵，依序判定、先中先停（docs/spec/008 第 3.8 節）：
+// 沒有該語言的譯文表 → no-table；L2 尚未實作 → unsupported-language；補丁不在手 → no-patch。
+// planIngame 規則 4 與 availFor 共用這一處定義。
+func unavailReason(hasTable, l2, patch bool) reasonKey {
+	switch {
+	case !hasTable:
+		return reasonNoTable
+	case !l2:
+		return reasonUnsupported
+	case !patch:
+		return reasonNoPatch
+	}
+	return reasonNone
+}
+
+// ---- planIngame：啟用規則（docs/spec/008 第 3.2 節） ----
+
+type planKind int
+
+const (
+	planNone     planKind = iota // 不建置：原版
+	planTable                    // 建置 table 包（套用譯文表）
+	planIdentity                 // 建置 identity 包（全部 keep）
+)
+
+func (k planKind) String() string {
+	switch k {
+	case planNone:
+		return "不建置"
+	case planTable:
+		return "建置 table"
+	case planIdentity:
+		return "建置 identity"
+	}
+	return "?"
+}
+
+// token 是日誌用的 ASCII 記號（play.log 的機器可讀欄位）。
+func (k planKind) token() string {
+	switch k {
+	case planNone:
+		return "none"
+	case planTable:
+		return "table"
+	case planIdentity:
+		return "identity"
+	}
+	return "?"
+}
+
+// ingamePlan 是 planIngame 的輸出：要做什麼，加上不建置或退回 identity 的原因鍵（沒有原因時為空）。
+type ingamePlan struct {
+	Kind   planKind
+	Reason reasonKey
+}
+
+// planIngame 實作啟用規則 1 至 4（一處定義，F1、旗標、測試都引用）：
+//
+//  1. C ＝ none：原版，不建置。
+//  2. C ＝ (zh-TW, 明示)：建置並啟用 zh-TW 語言包，有譯文表就套表（table），沒有就是 identity 包（原因 no-table）。
+//     C ＝ (identity, ·)：一律建 identity 包，不理會任何譯文表。
+//  3. C ＝ (zh-TW, 非明示)（來自介面語言設定）：有譯文表才建置（table），否則原版（零成本退路，原因 no-table）。
+//  4. 其他 C：L2 之前一律不建置；L2 之後有該語言的譯文表且補丁在手才建置（table）。不建置時原因依
+//     no-table、unsupported-language、no-patch 的順序（unavailReason）。
+//
+// hasTable 是 C 的代碼在 FindTableDirFor 找到譯文表；none 與 identity 不看它。
+func planIngame(c ingameChoice, hasTable, l2, patch bool) ingamePlan {
+	switch {
+	case c.Code == icNone:
+		return ingamePlan{Kind: planNone}
+	case c.Code == icIdentity:
+		return ingamePlan{Kind: planIdentity}
+	case c.Code == icTW && c.Explicit:
+		if hasTable {
+			return ingamePlan{Kind: planTable}
+		}
+		return ingamePlan{Kind: planIdentity, Reason: reasonNoTable}
+	case c.Code == icTW:
+		if hasTable {
+			return ingamePlan{Kind: planTable}
+		}
+		return ingamePlan{Kind: planNone, Reason: reasonNoTable}
+	}
+	if r := unavailReason(hasTable, l2, patch); r != reasonNone {
+		return ingamePlan{Kind: planNone, Reason: r}
+	}
+	return ingamePlan{Kind: planTable}
+}
+
+// ---- 可用性 avail(X) ----
+
+// availResult 是 avail(X) 的值 ＝ (布林, 原因鍵)。
+type availResult struct {
+	OK     bool
+	Reason reasonKey // OK 為假時才有意義
+}
+
+// availFn 是 avail(X)。只對 F4 循環的五種語言定義；none 與 identity 只能由覆蓋旗標指定、不經 F4，
+// 它們的值是「未定義」，實作讀取即 panic（讓「第 2 步誤讀 avail(none)」之類的突變可被偵測）。
+type availFn func(x ingameCode) availResult
+
+// availFor 計算 avail(X)（docs/spec/008 第 3.8 節）：zh-TW 的 avail ＝ 譯文表存在（原因 no-table）；
+// 其他語言 ＝ 譯文表存在，且 L2 已實作，且補丁在手（原因依 unavailReason 的順序）。
+// 不要求建置成功（建置要下次啟動才知道）。findTable 是「某代碼的譯文表存在」，F4 每次按下時重新計算
+// （譯文表可能在執行期間才放入，真值表第 20 列），所以呼叫端不快取跨次按下的結果。
+func availFor(x ingameCode, findTable func(ingameCode) bool, l2, patch bool) availResult {
+	if !x.inCycle() {
+		panic("avail(" + string(x) + ") 未定義：只有 F4 循環的五種語言定義 avail")
+	}
+	has := findTable != nil && findTable(x)
+	if x == icTW {
+		if has {
+			return availResult{OK: true}
+		}
+		return availResult{Reason: reasonNoTable}
+	}
+	if r := unavailReason(has, l2, patch); r != reasonNone {
+		return availResult{Reason: r}
+	}
+	return availResult{OK: true}
+}
+
+// ---- 生效狀態 E 與啟動失敗 ----
+
+// effKind 是生效 E 的種類：原版，或通過 manifest 驗證的語言包（identity 種類、zh-TW 表包、其他語言包）。
+type effKind int
+
+const (
+	effOriginal     effKind = iota // 原版（沒有語言包，或建置、驗證失敗而退回）
+	effIdentityPack                // identity 種類的包：manifest 模式為 identity，或採用列數為 0
+	effTablePack                   // zh-TW 表包：採用列數大於 0
+	effOtherPack                   // 其他語言包（L2 之後；帶語言代碼）
+)
+
+// effective 是生效 E。Code 是語言包 manifest 的代碼（原版時為空）：identity 種類的包是 zh-TW 或 identity。
+type effective struct {
+	Kind effKind
+	Code ingameCode
+}
+
+// manifestModeIdentity 是 manifest 政策模式的 identity 值（等於 string(l10n.ModeIdentity)，測試斷言兩者相同）。
+const manifestModeIdentity = "identity"
+
+// effectiveFromManifest 由 manifest 的政策模式、採用列數與代碼判出通過驗證的語言包的種類（docs/spec/008 第 3.8 節）：
+// identity 種類（模式為 identity，或採用列數為 0：譯文表存在但全是 candidate 或 keep，等同 identity 包）、
+// zh-TW 表包（採用列數大於 0）、其他語言包。
+func effectiveFromManifest(mode string, adopted int, code ingameCode) effective {
+	switch {
+	case mode == manifestModeIdentity || adopted == 0:
+		return effective{Kind: effIdentityPack, Code: code}
+	case code == icTW:
+		return effective{Kind: effTablePack, Code: code}
+	}
+	return effective{Kind: effOtherPack, Code: code}
+}
+
+// startFail ＝ (C_start, 原因鍵)：啟動時要建置或載入語言包而失敗。Reason 為空表示沒有失敗。
+// 原因鍵只有 build-failed 與 verify-failed。
+type startFail struct {
+	Start  ingameCode
+	Reason reasonKey
+}
+
+func (f startFail) active() bool { return f.Reason != reasonNone }
+
+// ---- ingameStatus：F1 值與 toast 鍵（docs/spec/008 第 3.8 節） ----
+
+// f1Class 是 F1「遊戲內文字」行的四類值。零值是 (1)，所以沒有填這個欄位的 panelInfo 顯示原版。
+type f1Class int
+
+const (
+	f1Orig     f1Class = iota // (1) 原版（繁體中文）
+	f1Pack                    // (2) 語言包 <代碼>（部分翻譯）或（原版文字，驗證用）
+	f1Pending                 // (3) 已選 <S>，下次啟動生效
+	f1Unusable                // (4) 已選 <S>，無法使用：<原因>
+)
+
+// f1Value 是 F1 值。字串由 ingameF1Text 用字串表組出（五個字句模板）。
+type f1Value struct {
+	Class  f1Class
+	Code   ingameCode // (2) 語言包的代碼；(3)、(4) 選擇 S
+	Verify bool       // (2)：identity 種類的包，標「驗證用」，不標「部分翻譯」
+	Reason reasonKey  // (4)
+}
+
+// toastKey 是 F4 提示的五種字句。
+type toastKey int
+
+const (
+	toastFlag     toastKey = iota // 由旗標指定，不隨 F4 改變
+	toastUnusable                 // 無法使用（維持原版）
+	toastNext                     // 下次啟動生效
+	toastNoPack                   // 尚無語言包
+	toastSame                     // 不變
+)
+
+var toastKeys = []toastKey{toastFlag, toastUnusable, toastNext, toastNoPack, toastSame}
+
+// i18nKey 是這個字句在字串表的鍵。
+func (k toastKey) i18nKey() string {
+	switch k {
+	case toastFlag:
+		return "toast.ingame.flag"
+	case toastUnusable:
+		return "toast.ingame.unusable"
+	case toastNext:
+		return "toast.ingame.next"
+	case toastNoPack:
+		return "toast.ingame.nopack"
+	}
+	return "toast.ingame.same"
+}
+
+// ingameOut 是 ingameStatus 的輸出。
+type ingameOut struct {
+	F1    f1Value
+	Toast toastKey
+}
+
+// sameSelection 是「選擇 S 與生效 E 視為相同」的關係（docs/spec/008 第 3.8 節「相同關係」），其餘情形為不同：
+//
+//	S ＝ none        且 E ＝ 原版
+//	S ＝ identity    且 E 為 identity 種類的包
+//	S ＝ zh-TW       且 E 為 identity 種類的包或 zh-TW 表包
+//	S ＝ zh-TW       且 E ＝ 原版且 avail(zh-TW) 為假（沒有譯文表：原版與 zh-TW 視為相同）
+//	S ＝ 其他語言 X  且 E ＝ X 的語言包
+//
+// 只有「S ＝ zh-TW 且 E ＝ 原版」這一格讀 avail，而且只讀 avail(zh-TW)。
+func sameSelection(s ingameCode, e effective, avail availFn) bool {
+	switch s {
+	case icNone:
+		return e.Kind == effOriginal
+	case icIdentity:
+		return e.Kind == effIdentityPack
+	case icTW:
+		switch e.Kind {
+		case effIdentityPack, effTablePack:
+			return true
+		case effOriginal:
+			return !avail(icTW).OK
+		}
+		return false
+	}
+	return e.Kind == effOtherPack && e.Code == s
+}
+
+// ingameStatus 決定 F1「遊戲內文字」的值與 F4 的提示（docs/spec/008 第 3.8 節）。輸入：
+//
+//	s         選擇 S：覆蓋旗標生效時是覆蓋值，否則是介面語言 lang 的目前值（F4 會改它）
+//	e         生效 E：原版，或通過 manifest 驗證的語言包
+//	sf        啟動失敗 ＝ (C_start, 原因鍵)，沒有則 Reason 為空
+//	override  覆蓋旗標是否生效（與 C 的明示是同一個謂詞）
+//	avail     avail(S)；只對 F4 循環的五種語言定義，none 與 identity 讀取即 panic
+//
+// 前置條件（測試在這個域內斷言函式全定義）：S ＝ none 蘊含 override 為真、E ＝ 原版且 sf 為空；
+// S ＝ identity 蘊含 override 為真，且 E 是 identity 包，或 E ＝ 原版且 sf ＝ (identity, ·)。
+//
+// 依序判定，先中先停：
+//  1. sf 非空且 S ＝ C_start（選擇沒有被 F4 改走）→ F1 (4) 已選 S，無法使用：sf 的原因；toast「無法使用」；
+//  2. S 與 E 不同：avail(S) 為真 → F1 (3)，toast「下次啟動生效」；為假 → F1 (4) avail 的原因，toast「尚無語言包」；
+//  3. E 為語言包 → F1 (2)：identity 種類標「驗證用」，其餘標「部分翻譯」；toast「不變」；
+//  4. 其餘 → F1 (1) 原版；toast「不變」。
+//
+// override 為真時 toast 一律是「由旗標指定」（先於上列各步），F1 值仍依上列各步判定。
+func ingameStatus(s ingameCode, e effective, sf startFail, override bool, avail availFn) ingameOut {
+	var out ingameOut
+	switch {
+	case sf.active() && s == sf.Start:
+		out = ingameOut{F1: f1Value{Class: f1Unusable, Code: s, Reason: sf.Reason}, Toast: toastUnusable}
+	case !sameSelection(s, e, avail):
+		if a := avail(s); a.OK {
+			out = ingameOut{F1: f1Value{Class: f1Pending, Code: s}, Toast: toastNext}
+		} else {
+			out = ingameOut{F1: f1Value{Class: f1Unusable, Code: s, Reason: a.Reason}, Toast: toastNoPack}
+		}
+	case e.Kind != effOriginal:
+		out = ingameOut{F1: f1Value{Class: f1Pack, Code: e.Code, Verify: e.Kind == effIdentityPack}, Toast: toastSame}
+	default:
+		out = ingameOut{F1: f1Value{Class: f1Orig}, Toast: toastSame}
+	}
+	if override {
+		out.Toast = toastFlag
+	}
+	return out
+}
+
+// ---- 顯示文字（字串表） ----
+
+// tfunc 是字串表查詢（含格式化）：正常用介面語言，退回版用英文且只含 ASCII。
+type tfunc = func(key string, args ...any) string
+
+// ingameCodeName 是代碼的顯示名稱：五種語言查字串表的譯名（介面語言的字面，英文介面下 ko 顯示 Korean），
+// identity 與 none 顯示字面（ASCII）。
+func ingameCodeName(t tfunc, c ingameCode) string {
+	if c.inCycle() {
+		return t("ingame.lang." + string(c))
+	}
+	return string(c)
+}
+
+// ingameReasonName 是原因鍵的顯示譯名（字串表），不顯示原始鍵。
+func ingameReasonName(t tfunc, r reasonKey) string { return t("ingame.reason." + string(r)) }
+
+// ingameF1Text 是 F1「遊戲內文字」行冒號後的文字：四類值的五個字句模板。
+func ingameF1Text(t tfunc, v f1Value) string {
+	switch v.Class {
+	case f1Pack:
+		if v.Verify {
+			return t("game.text.verify", ingameCodeName(t, v.Code))
+		}
+		return t("game.text.partial", ingameCodeName(t, v.Code))
+	case f1Pending:
+		return t("game.text.pending", ingameCodeName(t, v.Code))
+	case f1Unusable:
+		return t("game.text.unusable", ingameCodeName(t, v.Code), ingameReasonName(t, v.Reason))
+	}
+	return t("game.text.orig")
+}
+
+// ingameToastText 是 F4 的提示：語言自己的名稱（uiName，沿用 docs/spec/006 第 5 節）接上 ingameStatus 選出的字句，單行。
+func ingameToastText(t tfunc, uiName string, k toastKey) string {
+	return t("toast.lang", uiName, t(k.i18nKey()))
+}
