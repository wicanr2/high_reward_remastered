+		{"譯文表違規", &fakeBuilder{digest: d, buildErr: violations}, 1, []string{"ingame: violation SP.MES: SP#3: whitelist", "ingame: violation ESPMES.MRG: ESPMES#121.0: line-width", "2 項違規"}},
+		{"包在 %w 包裝內的違規", &fakeBuilder{digest: d, buildErr: fmt.Errorf("包裝：%w", violations)}, 1, []string{"ingame: violation SP.MES: SP#3: whitelist"}},
+		{"建置結果的摘要與先算的不同（建置期間譯文表被改動）", &fakeBuilder{digest: d, res: mkResult("/packs/p", strings.Repeat("0", 64), "table", 3, "zh-TW")}, 1, []string{"build-failed", "建置期間輸入改變"}},
+		{"建置器回 nil", &fakeBuilder{digest: d, res: nil}, 1, []string{"build-failed", "沒有回傳"}},
+		{"建置器回沒有 manifest 的結果", &fakeBuilder{digest: d, res: &l10n.Result{Dir: "/p", Digest: d}}, 1, []string{"build-failed", "沒有回傳"}},
