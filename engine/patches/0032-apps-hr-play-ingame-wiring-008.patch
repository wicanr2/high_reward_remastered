+func TestIngameTextsUseTranslatedNamesNotRawKeys(t *testing.T) {
+	for _, l := range langOrder {
+		tf := tFor(l)
+		for _, r := range reasonKeys {
+			name := ingameReasonName(tf, r)
+			if name == "" || name == "ingame.reason."+string(r) {
+				t.Errorf("%s：原因 %s 沒有譯名：%q", l, r, name)
+			}
+			for _, c := range append(append([]ingameCode{}, ingameCycle...), icIdentity) {
+				s := ingameF1Text(tf, unusable(c, r))
+				if strings.Contains(s, string(r)) {
+					t.Errorf("%s：F1 顯示了原始鍵 %q：%q", l, r, s)
+				}
+				if !strings.Contains(s, name) {
+					t.Errorf("%s：F1 缺原因譯名 %q：%q", l, name, s)
+				}
+			}
+		}
+		for _, c := range ingameCycle {
+			name := ingameCodeName(tf, c)
+			if name == "" || name == "ingame.lang."+string(c) {
+				t.Errorf("%s：語言 %s 沒有譯名：%q", l, c, name)
+			}
+		}
+		if got := ingameCodeName(tf, icIdentity); got != "identity" {
+			t.Errorf("%s：identity 應顯示字面：%q", l, got)
+		}
+		// 五個語言譯名在同一個介面語言下互不相同
+		seen := map[string]ingameCode{}
+		for _, c := range ingameCycle {
+			n := ingameCodeName(tf, c)
+			if o, dup := seen[n]; dup {
+				t.Errorf("%s：%s 與 %s 的譯名相同：%q", l, c, o, n)
+			}
+			seen[n] = c
+		}
+		// 五個 F1 字句模板（含驗證用）與五種 toast 字句在這個語言互不相同
+		forms := map[string]string{}
+		for name, v := range map[string]f1Value{"原版": origF1, "部分翻譯": partial(icTW), "驗證用": verifyUse(icTW), "下次啟動": pending(icTW), "無法使用": unusable(icTW, reasonNoTable)} {
+			s := ingameF1Text(tf, v)
+			if o, dup := forms[s]; dup {
+				t.Errorf("%s：F1 字句 %s 與 %s 相同：%q", l, name, o, s)
+			}
+			forms[s] = name
+		}
+		tseen := map[string]toastKey{}
+		for _, k := range toastKeys {
+			s := tf(k.i18nKey())
+			if s == "" || s == k.i18nKey() {
+				t.Errorf("%s：toast 字句 %d 缺字串", l, k)
+			}
+			if o, dup := tseen[s]; dup {
+				t.Errorf("%s：toast 字句 %d 與 %d 相同", l, k, o)
+			}
+			tseen[s] = k
+		}
+	}
+}
