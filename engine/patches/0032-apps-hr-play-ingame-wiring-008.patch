+		{name: "列 11：-ingame-lang none", f: ov("none"), plan: planNone, calls: 0, f1: origF1, toast: toastFlag},
+		{name: "列 12：-ingame-lang ja，L2 之前有 l10n/ja/（不建置）", f: ov("ja"), tables: []string{"ja"}, plan: planNone, calls: 0, f1: unusable(icJA, reasonUnsupported), toast: toastFlag},
+		{name: "列 13：-lang ja，L2 之後有表有補丁，建置失敗", f: lang("ja"), tables: []string{"ja"}, l2: true, patch: true, buildOK: false, plan: planTable, calls: 2, f1: unusable(icJA, reasonBuildFailed), toast: toastUnusable},
+		{name: "列 14：同 13，驗證失敗", f: lang("ja"), tables: []string{"ja"}, l2: true, patch: true, mode: "table", adopted: 4, buildOK: true, status: failedVerify, plan: planTable, calls: 2, f1: unusable(icJA, reasonVerifyFailed), toast: toastUnusable},
+		{name: "列 15：13 之後 F4 選 ko，沒有表", f: lang("ja"), tables: []string{"ja"}, l2: true, patch: true, buildOK: false, sel: icKO, plan: planTable, calls: 2, f1: unusable(icKO, reasonNoTable), toast: toastNoPack},
+		{name: "列 16：15 之後 F4 繞回 ja", f: lang("ja"), tables: []string{"ja"}, l2: true, patch: true, buildOK: false, sel: icJA, plan: planTable, calls: 2, f1: unusable(icJA, reasonBuildFailed), toast: toastUnusable},
+		{name: "列 17：-ingame-lang identity，建置失敗", f: ov("identity"), buildOK: false, plan: planIdentity, calls: 2, f1: unusable(icIdentity, reasonBuildFailed), toast: toastFlag},
+		{name: "列 18：-ingame-lang ja，沒有 l10n/ja/", f: ov("ja"), plan: planNone, calls: 0, f1: unusable(icJA, reasonNoTable), toast: toastFlag},
+		{name: "列 19：-lang zh-TW，有表，建置失敗", f: lang("zh-TW"), tables: []string{"zh-TW"}, buildOK: false, plan: planTable, calls: 2, f1: unusable(icTW, reasonBuildFailed), toast: toastUnusable},
+		{name: "列 20：預設啟動沒有表，F4 繞回 zh-TW 之後才放入 l10n/zh-TW/", late: []string{"zh-TW"}, plan: planNone, calls: 0, f1: pending(icTW), toast: toastNext},
+		{name: "列 21：-ingame-lang zh-TW，全是 candidate（table 模式採用列數 0）", f: ov("zh-TW"), tables: []string{"zh-TW"}, mode: "table", adopted: 0, buildOK: true, plan: planTable, calls: 2, f1: verifyUse(icTW), toast: toastFlag},
+		{name: "列 22：-ingame-lang zh-TW，有表，建置失敗", f: ov("zh-TW"), tables: []string{"zh-TW"}, buildOK: false, plan: planTable, calls: 2, f1: unusable(icTW, reasonBuildFailed), toast: toastFlag},
+		{name: "列 23：-lang zh-TW，全是 candidate（預設路徑上最容易出現驗證用）", f: lang("zh-TW"), tables: []string{"zh-TW"}, mode: "table", adopted: 0, buildOK: true, plan: planTable, calls: 2, f1: verifyUse(icTW), toast: toastSame},
+		// 不認得的旗標代碼當作沒給：往下找環境變數與 lang
+		{name: "不認得的旗標，沒有環境變數：用 lang（非明示），沒有表 ＝ 原版", f: ov("fr"), plan: planNone, calls: 0, f1: origF1, toast: toastSame},
+		{name: "不認得的旗標加 HR_INGAME_LANG＝ja：(ja, 明示)", f: ov("fr"), env: startupEnv{IngameLang: "ja"}, tables: []string{"ja"}, plan: planNone, calls: 0, f1: unusable(icJA, reasonUnsupported), toast: toastFlag},
+		{name: "HR_INGAME_LANG＝identity", env: startupEnv{IngameLang: "identity"}, mode: "identity", buildOK: true, plan: planIdentity, calls: 2, f1: verifyUse(icIdentity), toast: toastFlag},
+		{name: "-ingame-lang none 勝過 HR_INGAME_LANG 與 lang", f: startupFlags{IngameLang: "none", IngameLangGiven: true, Lang: "zh-TW", LangGiven: true}, env: startupEnv{IngameLang: "identity"}, tables: []string{"zh-TW"}, plan: planNone, calls: 0, f1: origF1, toast: toastFlag},
+		// 啟動失敗後 F4 離開 C_start 再繞回：zh-TW 沒有表視為與原版相同
+		{name: "列 19 之後 F4 到 ko", f: lang("zh-TW"), tables: []string{"zh-TW"}, buildOK: false, sel: icKO, plan: planTable, calls: 2, f1: unusable(icKO, reasonNoTable), toast: toastNoPack},
+	}
+	for _, c := range cases {
+		runChain(t, c)
+	}
+}
+
+// 列 20 的 avail 重新計算：F4 按下之間放入譯文表，avail 的結果在下一次按下時才改變（game 的快取在 F4 清空）。
+func TestFindTableFuncRecomputesEachCall(t *testing.T) {
+	base := t.TempDir()
+	find := findTableFunc(l10n.TableSearch{Flag: base})
+	if find(icTW) {
+		t.Fatal("一開始沒有譯文表")
+	}
+	if err := os.MkdirAll(filepath.Join(base, "zh-TW"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if find(icTW) {
+		t.Error("空的 zh-TW 目錄不算有表")
+	}
+	if err := os.WriteFile(filepath.Join(base, "zh-TW", "COUNTRY.MES.tsv"), []byte("id\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if !find(icTW) {
+		t.Error("放入譯文表之後，同一個函式再次呼叫應找到（不快取）")
+	}
+	if find(icKO) {
+		t.Error("per-code：沒有 ko 的譯文表")
+	}
+}
+
+// ---- 譯文表的尋找來源 ----
+
+func TestTableSearchFor(t *testing.T) {
+	s := tableSearchFor("/f", "/e", "/apps/Game.AppImage", "/opt/hr/bin/hr-play", "/cwd", "/data")
+	want := l10n.TableSearch{
+		Flag: "/f", Env: "/e", AppImageDir: "/apps", ExeDir: "/opt/hr/bin", MacResources: "/opt/hr/Resources", Cwd: "/cwd", DataDir: "/data",
+	}
+	if s != want {
+		t.Errorf("tableSearchFor ＝ %+v，應為 %+v", s, want)
+	}
+	// 空來源略過（不是 AppImage、取不到執行檔路徑）
+	s = tableSearchFor("", "", "", "", "/cwd", "/data")
+	if s != (l10n.TableSearch{Cwd: "/cwd", DataDir: "/data"}) {
+		t.Errorf("空來源：%+v", s)
+	}
+	// 與 themeDirCandidates 的來源順序一致：旗標、環境變數、AppImage 旁、執行檔旁、macOS Resources、目前目錄，之後才是資料目錄
+	cands := themeDirCandidates("/f", "/e", "/apps/Game.AppImage", "/opt/hr/bin/hr-play", "l10n")
+	if len(cands) != 6 || cands[0] != "/f" || cands[1] != "/e" || cands[2] != filepath.Join("/apps", "l10n") ||
+		cands[3] != filepath.Join("/opt/hr/bin", "l10n") || cands[4] != filepath.Join("/opt/hr/bin", "..", "Resources", "l10n") || cands[5] != "l10n" {
+		t.Fatalf("themeDirCandidates ＝ %v", cands)
+	}
+	// 各來源的 l10n 目錄由 FindTableDirFor 依同一順序探測：擺在每個位置各一個，第一個含 zh-TW 譯文表的勝出
+	base := t.TempDir()
+	mk := func(rel string) string {
+		d := filepath.Join(base, rel, "l10n", "zh-TW")
+		if err := os.MkdirAll(d, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(d, "SP.MES.tsv"), []byte("id\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		return filepath.Join(base, rel, "l10n")
+	}
+	app, exe, cwd, data := mk("app"), mk("exe/bin"), mk("cwd"), mk("data")
+	search := tableSearchFor("", "", filepath.Join(base, "app", "G.AppImage"), filepath.Join(base, "exe", "bin", "hr-play"), filepath.Join(base, "cwd"), filepath.Join(base, "data"))
+	if got, ok := l10n.FindTableDirFor(search, "zh-TW"); !ok || got != app {
+		t.Errorf("AppImage 旁應先於執行檔旁：%q %v", got, ok)
+	}
+	search.AppImageDir = ""
+	if got, ok := l10n.FindTableDirFor(search, "zh-TW"); !ok || got != exe {
+		t.Errorf("執行檔旁：%q %v", got, ok)
+	}
+	search.ExeDir, search.MacResources = "", ""
+	if got, ok := l10n.FindTableDirFor(search, "zh-TW"); !ok || got != cwd {
+		t.Errorf("目前目錄：%q %v", got, ok)
+	}
+	search.Cwd = ""
+	if got, ok := l10n.FindTableDirFor(search, "zh-TW"); !ok || got != data {
+		t.Errorf("資料目錄：%q %v", got, ok)
+	}
+	// 旗標指向沒有該代碼譯文表的 l10n 時視為沒有，不往下找（使用者明示的來源不被取代）
+	empty := filepath.Join(t.TempDir(), "x")
+	if err := os.MkdirAll(empty, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	search.Flag = empty
+	if got, ok := l10n.FindTableDirFor(search, "zh-TW"); ok {
+		t.Errorf("明示的旗標沒有 zh-TW 時不該往下找：%q", got)
+	}
+}
+
+// ---- 日誌 ----
+
+func TestIngameLogfWritesStderrAndPlayLog(t *testing.T) {
+	dir := t.TempDir()
+	log := &lineLog{}
+	f := ingameLogf(dir, log.logf)
+	f("ingame: plan=%s\n含換行", "none")
+	if !log.has("ingame: plan=none") {
+		t.Errorf("logf 沒收到：%v", log.all())
+	}
+	b := readStr(t, filepath.Join(dir, "play.log"))
+	if !strings.Contains(b, "\tlang\tingame: plan=none 含換行\n") || strings.Count(b, "\n") != 1 {
+		t.Errorf("play.log ＝ %q", b)
+	}
+	// 資料目錄不可寫時不 panic，logf 照常
+	log2 := &lineLog{}
+	ingameLogf(filepath.Join(dir, "no", "such"), log2.logf)("x")
+	if !log2.has("x") {
+		t.Error("play.log 寫不進去時 logf 仍應收到")
+	}
+}
