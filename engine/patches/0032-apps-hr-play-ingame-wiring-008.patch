+package main
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n"
+)
+
+// docs/spec/008 第 3.2、3.8 節與第 8 節「啟用規則」那一列：planIngame、availFor、ingameStatus 的單元測試。
+// 全是純函式，不需要 ebiten、檔案與原版。
+
+// ---- 測試用的 E 與 avail ----
+
+var (
+	eOrig    = effective{}
+	eTable   = effectiveFromManifest("table", 5, icTW)          // zh-TW 表包（採用列數 > 0）
+	eZeroTbl = effectiveFromManifest("table", 0, icTW)          // table 模式、採用列數 0（視同 identity 包）
+	eIdTW    = effectiveFromManifest("identity", 0, icTW)       // zh-TW 的 identity 包（沒有譯文表）
+	eIdID    = effectiveFromManifest("identity", 0, icIdentity) // -ingame-lang identity 的包
+	eOther   = func(c ingameCode) effective { return effectiveFromManifest("table", 7, c) }
+)
+
+func okAvail() *availResult { return &availResult{OK: true} }
+func noAvail(r reasonKey) *availResult {
+	return &availResult{Reason: r}
+}
+
+// strictAvail 回傳只對 s 定義的 avail(X)：none 與 identity 讀取即 panic（avail 為 nil 表示「不定義」，
+// 任何讀取都 panic）；讀 X ≠ S 也 panic（ingameStatus 只讀 avail(S)）。reads 記錄讀取次數。
+func strictAvail(s ingameCode, v *availResult, reads *int) availFn {
+	return func(x ingameCode) availResult {
+		if reads != nil {
+			*reads++
+		}
+		if !x.inCycle() {
+			panic(fmt.Sprintf("讀了未定義的 avail(%s)", x))
+		}
+		if x != s {
+			panic(fmt.Sprintf("S ＝ %s，卻讀了 avail(%s)", s, x))
+		}
+		if v == nil {
+			panic(fmt.Sprintf("讀了 avail(%s)，但這一列把它標為不定義", x))
+		}
+		return *v
+	}
+}
+
+// ---- planIngame ----
+
+// 規則 1 至 4 的預期（照規格文字另寫一份，與 planIngame 的結構不同）。
+func planOracle(code ingameCode, explicit, hasTable, l2, patch bool) ingamePlan {
+	switch code {
+	case icNone:
+		return ingamePlan{planNone, reasonNone}
+	case icIdentity:
+		return ingamePlan{planIdentity, reasonNone}
+	case icTW:
+		if explicit {
+			if hasTable {
+				return ingamePlan{planTable, reasonNone}
+			}
+			return ingamePlan{planIdentity, reasonNoTable}
+		}
+		if hasTable {
+			return ingamePlan{planTable, reasonNone}
+		}
+		return ingamePlan{planNone, reasonNoTable}
+	}
+	switch { // 規則 4：no-table、unsupported-language、no-patch 的順序
+	case !hasTable:
+		return ingamePlan{planNone, reasonNoTable}
+	case !l2:
+		return ingamePlan{planNone, reasonUnsupported}
+	case !patch:
+		return ingamePlan{planNone, reasonNoPatch}
+	}
+	return ingamePlan{planTable, reasonNone}
+}
