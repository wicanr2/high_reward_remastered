diff --git a/apps/hr/play/ui.go b/apps/hr/play/ui.go
new file mode 100644
index 0000000..5eee870
--- /dev/null
+++ b/apps/hr/play/ui.go
@@ -0,0 +1,333 @@
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"image"
+	"image/png"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+const uiAISHA256 = "b2fda4d30990170c0b98807a1605b7ea2a5669a9be825602df805bea8408f6bf"
+
+type uiSize struct{ w, h int }
+
+var uiSizes = [...]uiSize{{128, 56}, {168, 48}, {168, 32}, {144, 168}, {272, 72}}
+
+// uiSkin 在建構時預建色場，之後只讀；paint 與 background 可並行使用。
+// fields 為空時仍做原色遮蔽，避免缺素材讓較早 HD 戳記穿透板面。
+type uiSkin struct {
+	fields map[uiSize][][3]uint8
+}
+
+func loadUISkins(ts *themeSet, logf func(string, ...any)) map[*hd.Assets]*uiSkin {
+	out := make(map[*hd.Assets]*uiSkin)
+	if ts == nil {
+		return out
+	}
+	if a := ts.Assets[themeHD]; a != nil {
+		out[a] = newHDUISkin()
+	}
+	if a := ts.Assets[themeAI]; a != nil {
+		s, err := loadAIUISkin(filepath.Join(a.Dir, "ui-panel-ai-v1.png"))
+		if err != nil {
+			if logf != nil {
+				logf("AI 板面回退原版：%v", err)
+			}
+			s = &uiSkin{}
+		}
+		out[a] = s
+	}
+	return out
+}
+
+func newHDUISkin() *uiSkin {
+	s := &uiSkin{fields: make(map[uiSize][][3]uint8, len(uiSizes))}
+	for _, sz := range uiSizes {
+		field := make([][3]uint8, sz.w*sz.h)
+		for y := 1; y < sz.h-1; y++ {
+			for x := 2; x < sz.w-2; x++ {
+				// 沿已接受 v1 的金屬亮邊、深色底；底色沒有交錯抖色。
+				c := [3]uint8{27, uint8(32 + (5*(y-1)+(sz.h-3)/2)/(sz.h-3)), 22}
+				d := min(x-2, sz.w-3-x, y-1, sz.h-2-y)
+				if d == 0 {
+					c = [3]uint8{228, 184, 81}
+				} else if d == 2 {
+					c = [3]uint8{105, 75, 32}
+				}
+				field[y*sz.w+x] = c
+			}
+		}
+		s.fields[sz] = field
+	}
+	return s
+}
+
+func loadAIUISkin(path string) (*uiSkin, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, fmt.Errorf("板面圖不存在或無法讀取：%w", err)
+	}
+	defer f.Close()
+	b, err := io.ReadAll(io.LimitReader(f, (16<<20)+1))
+	if err != nil || len(b) > 16<<20 {
+		return nil, fmt.Errorf("板面圖資料長度或讀取不符")
+	}
+	if fmt.Sprintf("%x", sha256.Sum256(b)) != uiAISHA256 {
+		return nil, fmt.Errorf("板面圖 SHA-256 不符")
+	}
+	im, err := png.Decode(bytes.NewReader(b))
+	if err != nil {
+		return nil, fmt.Errorf("板面 PNG 解碼失敗：%w", err)
+	}
+	// 雜湊綁定圖中的主板面。透明邊距有低 alpha 雜點，不能用整圖 bbox。
+	r := uiAIContentRect(im)
+	if r.Empty() {
+		return nil, fmt.Errorf("板面圖沒有完整不透明色場")
+	}
+	s := &uiSkin{fields: make(map[uiSize][][3]uint8, len(uiSizes))}
+	for _, sz := range uiSizes {
+		field := make([][3]uint8, sz.w*sz.h)
+		for y := 1; y < sz.h-1; y++ {
+			for x := 2; x < sz.w-2; x++ {
+				sx := float64(r.Min.X) + float64(x-2)*float64(r.Dx()-1)/float64(sz.w-5)
+				sy := float64(r.Min.Y) + float64(y-1)*float64(r.Dy()-1)/float64(sz.h-3)
+				field[y*sz.w+x] = uiBilinear(im, sx, sy)
+			}
+		}
+		s.fields[sz] = field
+	}
+	return s, nil
+}
+
+func uiAIContentRect(im image.Image) image.Rectangle {
+	b := im.Bounds()
+	top, bottom := b.Max.Y, b.Min.Y
+	for y := b.Min.Y; y < b.Max.Y; y++ {
+		n := 0
+		for x := b.Min.X; x < b.Max.X; x++ {
+			_, _, _, a := im.At(x, y).RGBA()
+			if a >= 128*257 {
+				n++
+			}
+		}
+		if n >= b.Dx()/2 {
+			top, bottom = min(top, y), max(bottom, y+1)
+		}
+	}
+	if top >= bottom {
+		return image.Rectangle{}
+	}
+	left, right := b.Max.X, b.Min.X
+	for x := b.Min.X; x < b.Max.X; x++ {
+		_, _, _, a := im.At(x, (top+bottom)/2).RGBA()
+		if a >= 128*257 {
+			left, right = min(left, x), max(right, x+1)
+		}
+	}
+	return image.Rect(left, top, right, bottom)
+}
+
+func uiBilinear(im image.Image, x, y float64) [3]uint8 {
+	x0, y0 := int(x), int(y)
+	x1, y1 := min(x0+1, im.Bounds().Max.X-1), min(y0+1, im.Bounds().Max.Y-1)
+	tx, ty := x-float64(x0), y-float64(y0)
+	pts := [4]image.Point{{x0, y0}, {x1, y0}, {x0, y1}, {x1, y1}}
+	weights := [4]float64{(1 - tx) * (1 - ty), tx * (1 - ty), (1 - tx) * ty, tx * ty}
+	var sums [3]float64
+	for i, p := range pts {
+		r, g, b, a := im.At(p.X, p.Y).RGBA()
+		if a != 0 {
+			for ch, v := range [3]uint32{r, g, b} {
+				sums[ch] += float64(v) * 255 / float64(a) * weights[i]
+			}
+		}
+	}
+	return [3]uint8{uint8(math.Round(sums[0])), uint8(math.Round(sums[1])), uint8(math.Round(sums[2]))}
+}
+
+func uiValidFrame(f *hrrt.Frame) bool {
+	if f == nil || f.UI == nil || f.W != 640 || f.H != 480 || len(f.Px) != 640*480 {
+		return false
+	}
+	n := f.W * f.H
+	return len(f.UI.Panels) <= 64 && len(f.UI.Owner) == n && len(f.UI.Glyph) == n && len(f.UI.Raw) == n && len(f.UI.WriteStep) == n
+}
+
+func uiValidPanel(p *hrrt.UIPanel) bool {
+	if p.ID == 0 || p.X < 0 || p.X%8 != 0 || p.Y < 40 || p.W > 640-p.X || p.H > 440-p.Y {
+		return false
+	}
+	for _, sz := range uiSizes {
+		if p.W == sz.w && p.H == sz.h {
+			return len(p.Expected) == p.W*p.H
+		}
+	}
+	return false
+}
+
+func (s *uiSkin) nativeColor(f *hrrt.Frame, p *hrrt.UIPanel, x, y int) ([3]uint8, bool) {
+	if s == nil || !uiValidPanel(p) || x < p.X+2 || x >= p.X+p.W-2 || y < p.Y+1 || y >= p.Y+p.H-1 {
+		return [3]uint8{}, false
+	}
+	field := s.fields[uiSize{p.W, p.H}]
+	if len(field) != p.W*p.H {
+		return [3]uint8{}, false
+	}
+	c := field[(y-p.Y)*p.W+x-p.X]
+	white := f.DAC[f.Map[15]]
+	for ch := range c {
+		c[ch] = uint8((uint16(c[ch])*uint16(white[ch]) + 127) / 255)
+	}
+	return c, true
+}
+
+func uiRawColor(f *hrrt.Frame, i int) [3]uint8 { return f.DAC[f.Map[f.Px[i]&15]] }
+
+// fallbackCursor 只接受 010 的完整、可見、原色相符游標戳記。
+func uiFallbackCursor(f *hrrt.Frame) *hd.Stamp {
+	if f.CursorManaged {
+		return nil
+	}
+	for _, st := range f.Stamps {
+		if st == nil || st.Site != hd.CursorSite || st.W != 40 || st.H != 32 || len(st.E) != 40*32 {
+			continue
+		}
+		n, matches := 0, true
+		for y := 0; y < st.H && matches; y++ {
+			for x := 0; x < st.W; x++ {
+				px, py := st.X+x, st.Y+y
+				v := st.E[y*st.W+x]
+				if v == hd.Transparent || px < 0 || px >= f.W || py < 40 || py >= 440 {
+					continue
+				}
+				n++
+				if v > 15 || f.Px[py*f.W+px] != v {
+					matches = false
+					break
+				}
+			}
+		}
+		if matches && n > 0 {
+			return st
+		}
+	}
+	return nil
+}
+
+func uiCursorPixel(st *hd.Stamp, x, y int) bool {
+	return st != nil && x >= st.X && y >= st.Y && x < st.X+st.W && y < st.Y+st.H && st.E[(y-st.Y)*st.W+x-st.X] != hd.Transparent
+}
+
+func (s *uiSkin) background(f *hrrt.Frame, x, y int, before uint8) ([3]uint8, bool) {
+	if s == nil || !uiValidFrame(f) || x < 0 || x >= f.W || y < 40 || y >= 440 {
+		return [3]uint8{}, false
+	}
+	cursor := uiFallbackCursor(f)
+	if (!f.CursorManaged && cursor == nil) || uiCursorPixel(cursor, x, y) {
+		return [3]uint8{}, false
+	}
+	i := y*f.W + x
+	if f.UI.Raw[i] || f.UI.Owner[i] == 0 {
+		return [3]uint8{}, false
+	}
+	for j := range f.UI.Panels {
+		p := &f.UI.Panels[j]
+		if p.ID == f.UI.Owner[i] && uiValidPanel(p) && x >= p.X && x < p.X+p.W && y >= p.Y && y < p.Y+p.H && p.Expected[(y-p.Y)*p.W+x-p.X] == before {
+			return s.nativeColor(f, p, x, y)
+		}
+	}
+	return [3]uint8{}, false
+}
+
+// 每次 paint 使用自己的 Verifier；uiSkin 不保存可變驗證緩衝區。
+func uiLaterArt(f *hrrt.Frame) []uint64 {
+	var stamps []*hd.Stamp
+	for _, st := range f.Stamps {
+		if st != nil && st.Site != hd.CursorSite && st.W > 0 && st.W <= 640 && st.H > 0 && st.H <= 480 && len(st.E) == st.W*st.H {
+			stamps = append(stamps, st)
+		}
+	}
+	if len(stamps) == 0 {
+		return nil
+	}
+	var verifier hd.Verifier
+	masks := verifier.Run(stamps, f.Px, f.W, f.H)
+	later := make([]uint64, len(f.Px))
+	for j, st := range stamps {
+		for y := max(0, st.Y); y < min(f.H, st.Y+st.H); y++ {
+			for x := max(0, st.X); x < min(f.W, st.X+st.W); x++ {
+				if masks[j].Get(x-st.X, y-st.Y) {
+					i := y*f.W + x
+					later[i] = max(later[i], st.DrawStep)
+				}
+			}
+		}
+	}
+	return later
+}
+
+func (s *uiSkin) paint(dst []byte, f *hrrt.Frame, scale int) {
+	if s == nil || !uiValidFrame(f) || scale < 1 || scale > 8 || len(dst) != f.W*scale*f.H*scale*4 {
+		return
+	}
+	cursor := uiFallbackCursor(f)
+	forceRaw := !f.CursorManaged && cursor == nil
+	panels := make(map[uint64]*hrrt.UIPanel, len(f.UI.Panels))
+	for j := range f.UI.Panels {
+		p := &f.UI.Panels[j]
+		if uiValidPanel(p) {
+			panels[p.ID] = p
+		}
+	}
+	var later []uint64
+	for _, raw := range f.UI.Raw {
+		if raw {
+			later = uiLaterArt(f)
+			break
+		}
+	}
+	for y := 40; y < 440; y++ {
+		for x := 0; x < f.W; x++ {
+			if uiCursorPixel(cursor, x, y) {
+				continue
+			}
+			i := y*f.W + x
+			var color [3]uint8
+			if f.UI.Raw[i] {
+				if later != nil && later[i] > f.UI.WriteStep[i] {
+					continue
+				}
+				color = uiRawColor(f, i)
+			} else {
+				p := panels[f.UI.Owner[i]]
+				if p == nil || x < p.X+2 || x >= p.X+p.W-2 || y < p.Y+1 || y >= p.Y+p.H-1 {
+					if f.UI.Owner[i] == 0 {
+						continue
+					}
+					// 失效／淘汰識別仍有 ownership 時，也不能讓舊 HD 穿透。
+					color = uiRawColor(f, i)
+				} else if forceRaw || f.UI.Glyph[i] || p.Expected[(y-p.Y)*p.W+x-p.X] != f.Px[i] {
+					color = uiRawColor(f, i)
+				} else if c, ok := s.nativeColor(f, p, x, y); ok {
+					color = c
+				} else {
+					color = uiRawColor(f, i)
+				}
+			}
+			for dy := 0; dy < scale; dy++ {
+				for dx := 0; dx < scale; dx++ {
+					j := ((y*scale+dy)*(f.W*scale) + x*scale + dx) * 4
+					dst[j], dst[j+1], dst[j+2], dst[j+3] = color[0], color[1], color[2], 255
+				}
+			}
+		}
+	}
+}
