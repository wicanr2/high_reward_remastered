diff --git a/apps/hr/runtime/ui.go b/apps/hr/runtime/ui.go
new file mode 100644
index 0000000..ef12303
--- /dev/null
+++ b/apps/hr/runtime/ui.go
@@ -0,0 +1,531 @@
+package runtime
+
+// 規格 011：只觀察繪圖原語，metadata 不寫回 DOS 記憶體或 VGA。
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+const (
+	uiW               = 640
+	uiH               = 480
+	uiMaxPanels       = 64
+	uiMaxBackups      = 64
+	uiMaxBackupPixels = 1048576
+	uiMaxPending      = 16
+	uiPendingSteps    = 2000000
+	uiPlateSHA        = "c512580a5cad8400638e57e137b2f56aa4d7b6328832e95915be3211c8b75b3b"
+)
+
+type uiRect struct{ x, y, w, h int }
+
+func (r uiRect) valid() bool {
+	return r.x >= 0 && r.y >= 40 && r.w > 0 && r.h > 0 && r.x+r.w <= uiW && r.y+r.h <= 440
+}
+func (r uiRect) contains(x, y int) bool { return x >= r.x && x < r.x+r.w && y >= r.y && y < r.y+r.h }
+func (r uiRect) intersects(q uiRect) bool {
+	return r.x < q.x+q.w && r.x+r.w > q.x && r.y < q.y+q.h && r.y+r.h > q.y
+}
+func (r uiRect) each(fn func(int, int)) {
+	for y := max(40, r.y); y < min(440, r.y+r.h); y++ {
+		for x := max(0, r.x); x < min(uiW, r.x+r.w); x++ {
+			fn(y*uiW+x, (y-r.y)*r.w+x-r.x)
+		}
+	}
+}
+
+type uiKind uint8
+
+const (
+	uiPlate uiKind = iota + 1
+	uiGlyph
+	uiSave
+	uiRestore
+	uiCursorPaint
+	uiCursorRestore
+)
+
+type uiPending struct {
+	kind           uiKind
+	r              uiRect
+	ss, sp, cs, ip uint16
+	entry          uint64
+	ptr            uint32
+	mask           []byte
+	touched        map[uint32]uint64
+	failed         bool
+	backup         *uiBackup
+}
+type uiBackup struct {
+	ptr        uint32
+	r          uiRect
+	digest     [32]byte
+	owner      []uint64
+	glyph, raw []bool
+	step       []uint64
+}
+type uiObserver struct {
+	m            *machine.Machine
+	display      *displayObserver
+	canvas       UIFrame
+	nextID       uint64
+	pending      []*uiPending
+	backups      []*uiBackup
+	backupPixels int
+	badLayout    bool
+}
+
+func newUIObserver(m *machine.Machine, d *displayObserver) *uiObserver {
+	o := &uiObserver{m: m, display: d}
+	o.reset(machine.ModeChange{Step: m.Steps})
+	m.ObserveVideoWrites(o.write)
+	m.ObserveModeChanges(o.reset)
+	if d != nil {
+		d.uiEnabled = true
+	}
+	return o
+}
+func (o *uiObserver) reset(_ machine.ModeChange) {
+	o.canvas = UIFrame{Owner: make([]uint64, uiW*uiH), Glyph: make([]bool, uiW*uiH), Raw: make([]bool, uiW*uiH), WriteStep: make([]uint64, uiW*uiH)}
+	o.pending = nil
+	o.backups = nil
+	o.backupPixels = 0
+}
+
+// CRTC offset 可以改列距而不設定模式；固定 80-byte 座標的 metadata
+// 不得跨過這種不連續點，也不能在回到 80 時恢復舊 buffer 身分。
+func (o *uiObserver) supportedLayout() bool {
+	if o.m.VideoMode() == 0x12 && o.m.VGA.Pitch(uiW) == 80 {
+		o.badLayout = false
+		return true
+	}
+	if !o.badLayout {
+		o.reset(machine.ModeChange{})
+		o.badLayout = true
+		if o.display != nil {
+			o.display.unknownGlyph()
+		}
+	}
+	return false
+}
+func (o *uiObserver) invalidate(i int, step uint64) {
+	o.canvas.Owner[i] = 0
+	o.canvas.Glyph[i] = false
+	o.canvas.Raw[i] = true
+	o.canvas.WriteStep[i] = step
+}
+func (o *uiObserver) discard(p *uiPending) {
+	for off, step := range p.touched {
+		x, y := int(off%80)*8, int(off/80)
+		for b := 0; b < 8; b++ {
+			if y >= 40 && y < 440 {
+				o.invalidate(y*uiW+x+b, step)
+			}
+		}
+	}
+	if p.kind == uiGlyph && o.display != nil {
+		o.display.unknownGlyph()
+	}
+}
+func (o *uiObserver) stop() {
+	for _, p := range o.pending {
+		o.discard(p)
+	}
+	o.pending = nil
+}
+
+// writerMatched 依 009／034 的原始函式邊界與 writer 位址辨識。
+// 不能以「有某個呼叫在執行」豁免未知的巢狀寫入。
+func writerMatched(p *uiPending, w machine.VideoWrite) bool {
+	switch p.kind {
+	case uiPlate:
+		return w.CS == 0x1d84 && w.IP >= 0x000a && w.IP < 0x1cf6
+	case uiGlyph:
+		return w.CS == 0x1c35 && (w.IP == 0x1e8 || w.IP == 0x1f0 || w.IP == 0x1f9)
+	case uiRestore, uiCursorRestore:
+		return w.CS == 0x1f69 && (w.IP == 0x1bb || w.IP == 0x1d0 || w.IP == 0x1e5 || w.IP == 0x1fa)
+	case uiCursorPaint:
+		return w.CS == 0x1c57 && (w.IP == 0x2b1 || w.IP == 0x2e5 || w.IP == 0x317 || w.IP == 0x349 || w.IP == 0x37b)
+	}
+	return false
+}
+func (o *uiObserver) write(w machine.VideoWrite) {
+	if !o.supportedLayout() || w.Offset >= 80*480 {
+		return
+	}
+	x, y := int(w.Offset%80)*8, int(w.Offset/80)
+	if y < 40 || y >= 440 {
+		return
+	}
+	q := uiRect{x, y, 8, 1}
+	var match *uiPending
+	for i := len(o.pending) - 1; i >= 0; i-- {
+		p := o.pending[i]
+		if !p.r.intersects(q) {
+			continue
+		}
+		if p.touched == nil {
+			p.touched = map[uint32]uint64{}
+		}
+		p.touched[w.Offset] = w.Step
+		if match == nil && !p.failed && writerMatched(p, w) {
+			match = p
+		}
+	}
+	if match != nil {
+		return
+	}
+	for b := 0; b < 8; b++ {
+		o.invalidate(y*uiW+x+b, w.Step)
+	}
+	for _, p := range o.pending {
+		if p.r.intersects(q) {
+			p.failed = true
+		}
+	}
+}
+
+func uiKnownSize(w, h int) bool {
+	return (w == 128 && h == 56) || (w == 168 && (h == 48 || h == 32)) || (w == 144 && h == 168) || (w == 272 && h == 72)
+}
+func (o *uiObserver) pre() {
+	m := o.m
+	c := m.CPU
+	cs, ip := c.Seg[cpu.CS], c.IP
+	if !(cs == 0x1d84 && ip == 0xa || cs == 0x1c35 && ip == 0x1c5 || cs == 0x1f69 && (ip == 0xe || ip == 0x169) || cs == 0x1c57 && ip == 0x22) {
+		return
+	}
+	if !o.supportedLayout() {
+		return
+	}
+	ss, sp := c.Seg[cpu.SS], c.R[cpu.SP]
+	arg := func(i uint16) uint16 { return m.Read16(cpu.Linear(ss, sp+4+i*2)) }
+	p := &uiPending{ss: ss, sp: sp + 4, cs: m.Read16(cpu.Linear(ss, sp+2)), ip: m.Read16(cpu.Linear(ss, sp)), entry: m.Steps}
+	switch {
+	case cs == 0x1d84:
+		p.kind = uiPlate
+		p.r = uiRect{int(int16(arg(0))), int(int16(arg(1))) + 40, (int(arg(2)) + 2) * 8, (int(arg(3)) + 1) * 8}
+		ptr := cpu.Linear(arg(5), arg(4))
+		if !p.r.valid() || p.r.x%8 != 0 || !uiKnownSize(p.r.w, p.r.h) || ptr+128 > machine.VideoSeg*16 || fmt.Sprintf("%x", sha256.Sum256(m.Mem[ptr:ptr+128])) != uiPlateSHA {
+			return
+		}
+	case cs == 0x1c35:
+		p.kind = uiGlyph
+		p.r = uiRect{int(arg(0)%80) * 8, int(arg(0)/80) + 40, 24, 16}
+		ptr := cpu.Linear(arg(2), arg(1))
+		if arg(4) != 0 || !p.r.valid() || ptr+48 > machine.VideoSeg*16 {
+			if o.display != nil {
+				o.display.unknownGlyph()
+			}
+			return
+		}
+		p.mask = append([]byte(nil), m.Mem[ptr:ptr+48]...)
+	case cs == 0x1f69 && ip == 0xe:
+		p.kind = uiSave
+		p.r = uiRect{int(arg(0)) * 8, int(arg(1)) + 40, int(arg(2)) * 8, int(arg(3))}
+		p.ptr = cpu.Linear(arg(5), arg(4))
+		// 保存不寫 VGA；游標保存不占一般備份池，也不猜圖形。
+		if p.ptr == cursorData+0x1d && p.cs == 0x19fb && p.ip == 0x7c4 && arg(2) == 5 && arg(3) == 32 {
+			return
+		}
+		if !p.r.valid() || p.ptr+8+uint32(p.r.w/8*p.r.h*4) > machine.VideoSeg*16 {
+			return
+		}
+		p.backup = o.captureBackup(p.ptr, p.r)
+	case cs == 0x1f69:
+		p.kind = uiRestore
+		p.ptr = cpu.Linear(arg(1), arg(0))
+		r, _, hash, ok := o.saved(p.ptr)
+		if !ok {
+			return
+		}
+		p.r = r
+		if p.ptr == cursorData+0x1d && p.cs == 0x19fb && (p.ip == 0x7a7 || p.ip == 0xa8) && o.knownCursor() && r.w == 40 && r.h == 32 {
+			p.kind = uiCursorRestore
+		} else {
+			if !r.valid() {
+				return
+			}
+			for i := len(o.backups) - 1; i >= 0; i-- {
+				b := o.backups[i]
+				if b.ptr == p.ptr && b.r == r && b.digest == hash {
+					p.backup = b
+					break
+				}
+			}
+			if p.backup == nil {
+				return
+			}
+		}
+	case cs == 0x1c57:
+		p.kind = uiCursorPaint
+		p.r = uiRect{int(int16(arg(1))), int(int16(arg(2))) + 40, 40, 32}
+		if uint32(p.cs)<<16|uint32(p.ip) != hd.CursorSite || arg(0) != 0 || cpu.Linear(arg(4), arg(3)) != cursorData+0x1bd1 || !o.knownCursor() {
+			return
+		}
+		if p.r.x < 0 || p.r.x >= 640 || p.r.y < 40 || p.r.y >= 440 {
+			return
+		}
+	}
+	if len(o.pending) >= uiMaxPending {
+		o.stop()
+		if p.kind == uiGlyph && o.display != nil {
+			o.display.unknownGlyph()
+		}
+		return
+	}
+	o.pending = append(o.pending, p)
+}
+func (o *uiObserver) knownCursor() bool {
+	if len(o.m.Mem) < cursorData+0x1bd1+805 {
+		return false
+	}
+	_, a := cursorSprite(o.m.Mem[cursorData+0x2a9:])
+	_, b := cursorSprite(o.m.Mem[cursorData+0x1bd1:])
+	return a && b
+}
+
+func (o *uiObserver) saved(ptr uint32) (uiRect, []byte, [32]byte, bool) {
+	var zero [32]byte
+	if ptr+8 > machine.VideoSeg*16 {
+		return uiRect{}, nil, zero, false
+	}
+	b := o.m.Mem[ptr : ptr+8]
+	r := uiRect{int(binary.LittleEndian.Uint16(b)) * 8, int(binary.LittleEndian.Uint16(b[2:])) + 40, int(binary.LittleEndian.Uint16(b[4:])) * 8, int(binary.LittleEndian.Uint16(b[6:]))}
+	if r.x < 0 || r.x >= 640 || r.y < 40 || r.y >= 440 || r.w <= 0 || r.w > 640 || r.h <= 0 || r.h > 400 {
+		return uiRect{}, nil, zero, false
+	}
+	n := 8 + r.w/8*r.h*4
+	if uint64(ptr)+uint64(n) > machine.VideoSeg*16 {
+		return uiRect{}, nil, zero, false
+	}
+	b = o.m.Mem[ptr : ptr+uint32(n)]
+	return r, b, sha256.Sum256(b), true
+}
+func savedPixel(b []byte, r uiRect, x, y int) uint8 {
+	v := uint8(0)
+	w := r.w / 8
+	for plane := 0; plane < 4; plane++ {
+		v |= ((b[8+y*w*4+plane*w+x/8] >> uint(7-x%8)) & 1) << uint(plane)
+	}
+	return v
+}
+func (o *uiObserver) bufferMatches(r uiRect, b []byte) bool {
+	w, h, px := o.m.Planar()
+	if w != uiW || h != uiH {
+		return false
+	}
+	ok := true
+	r.each(func(i, j int) {
+		if px[i] != savedPixel(b, r, j%r.w, j/r.w) {
+			ok = false
+		}
+	})
+	return ok
+}
+func (o *uiObserver) captureBackup(ptr uint32, r uiRect) *uiBackup {
+	b := &uiBackup{ptr: ptr, r: r, owner: make([]uint64, r.w*r.h), glyph: make([]bool, r.w*r.h), raw: make([]bool, r.w*r.h), step: make([]uint64, r.w*r.h)}
+	r.each(func(i, j int) {
+		b.owner[j] = o.canvas.Owner[i]
+		b.glyph[j] = o.canvas.Glyph[i]
+		b.raw[j] = o.canvas.Raw[i]
+		b.step[j] = o.canvas.WriteStep[i]
+	})
+	return b
+}
+func (o *uiObserver) remember(b *uiBackup) {
+	kept := o.backups[:0]
+	for _, old := range o.backups {
+		if old.ptr == b.ptr {
+			o.backupPixels -= len(old.owner)
+		} else {
+			kept = append(kept, old)
+		}
+	}
+	o.backups = append(kept, b)
+	o.backupPixels += len(b.owner)
+	for len(o.backups) > uiMaxBackups || o.backupPixels > uiMaxBackupPixels {
+		o.backupPixels -= len(o.backups[0].owner)
+		o.backups = o.backups[1:]
+	}
+}
+func (o *uiObserver) panelAlive(id uint64) bool {
+	for _, p := range o.canvas.Panels {
+		if p.ID == id {
+			return true
+		}
+	}
+	return false
+}
+func (o *uiObserver) commit(p *uiPending) {
+	if p.failed {
+		o.discard(p)
+		return
+	}
+	m := o.m
+	switch p.kind {
+	case uiPlate:
+		w, h, px := m.Planar()
+		if w != uiW || h != uiH {
+			o.discard(p)
+			return
+		}
+		o.nextID++
+		panel := UIPanel{ID: o.nextID, DrawStep: m.Steps, X: p.r.x, Y: p.r.y, W: p.r.w, H: p.r.h, Expected: make([]byte, p.r.w*p.r.h)}
+		p.r.each(func(i, j int) {
+			panel.Expected[j] = px[i]
+			x, y := j%p.r.w, j/p.r.w
+			if x >= 2 && x < p.r.w-2 && y >= 1 && y < p.r.h-1 {
+				o.canvas.Owner[i] = panel.ID
+				o.canvas.Glyph[i] = false
+				o.canvas.Raw[i] = false
+				o.canvas.WriteStep[i] = m.Steps
+			}
+		})
+		o.canvas.Panels = append(o.canvas.Panels, panel)
+		if len(o.canvas.Panels) > uiMaxPanels {
+			old := o.canvas.Panels[0].ID
+			o.canvas.Panels = o.canvas.Panels[1:]
+			for i, id := range o.canvas.Owner {
+				if id == old {
+					o.invalidate(i, m.Steps)
+				}
+			}
+		}
+	case uiGlyph:
+		p.r.each(func(i, j int) {
+			if p.mask[(j/p.r.w)*3+(j%p.r.w)/8]&(128>>uint(j%8)) != 0 {
+				o.canvas.Glyph[i] = true
+				o.canvas.WriteStep[i] = m.Steps
+			}
+		})
+		if o.display != nil {
+			o.display.noteGlyph(p.r, p.mask)
+		}
+	case uiSave:
+		r, b, hash, ok := o.saved(p.ptr)
+		if ok && r == p.r && o.bufferMatches(r, b) {
+			p.backup.digest = hash
+			o.remember(p.backup)
+		}
+	case uiRestore:
+		r, b, hash, ok := o.saved(p.ptr)
+		if !ok || r != p.r || hash != p.backup.digest || !o.bufferMatches(r, b) {
+			o.discard(p)
+			return
+		}
+		r.each(func(i, j int) {
+			id := p.backup.owner[j]
+			if id != 0 && !o.panelAlive(id) {
+				o.invalidate(i, m.Steps)
+				return
+			}
+			o.canvas.Owner[i] = id
+			o.canvas.Glyph[i] = p.backup.glyph[j]
+			o.canvas.Raw[i] = p.backup.raw[j]
+			o.canvas.WriteStep[i] = p.backup.step[j]
+			if id != 0 {
+				o.canvas.WriteStep[i] = m.Steps
+			}
+		})
+	case uiCursorPaint, uiCursorRestore:
+		// 格式／指標／返回呼叫點已在 entry 核對，保留下方 metadata。
+	}
+}
+func (o *uiObserver) post() {
+	if !o.supportedLayout() {
+		return
+	}
+	c := o.m.CPU
+	kept := o.pending[:0]
+	for _, p := range o.pending {
+		atReturn := c.Seg[cpu.CS] == p.cs && c.IP == p.ip
+		if o.m.Steps-p.entry > uiPendingSteps {
+			o.discard(p)
+			continue
+		}
+		if atReturn {
+			if c.Seg[cpu.SS] == p.ss && c.R[cpu.SP] == p.sp {
+				o.commit(p)
+			} else {
+				o.discard(p)
+			}
+			continue
+		}
+		kept = append(kept, p)
+	}
+	o.pending = kept
+}
+func (o *uiObserver) snapshot(f *Frame) {
+	if !o.supportedLayout() || f.W != uiW || f.H != uiH {
+		return
+	}
+	u := &UIFrame{Owner: append([]uint64(nil), o.canvas.Owner...), Glyph: append([]bool(nil), o.canvas.Glyph...), Raw: append([]bool(nil), o.canvas.Raw...), WriteStep: append([]uint64(nil), o.canvas.WriteStep...)}
+	for _, p := range o.canvas.Panels {
+		p.Expected = append([]byte(nil), p.Expected...)
+		u.Panels = append(u.Panels, p)
+	}
+	for _, p := range o.pending {
+		// 010 已逐像素驗證游標畫完或隱藏時，已知游標原語即使尚未 retf，
+		// 也不取消下方板面；其他未完成或失敗原語仍保守回退。
+		if f.CursorManaged && !f.CursorPending && !p.failed && (p.kind == uiCursorPaint || p.kind == uiCursorRestore) {
+			continue
+		}
+		for off, step := range p.touched {
+			x, y := int(off%80)*8, int(off/80)
+			if y < 40 || y >= 440 {
+				continue
+			}
+			for b := 0; b < 8; b++ {
+				i := y*uiW + x + b
+				u.Owner[i] = 0
+				u.Glyph[i] = false
+				u.Raw[i] = true
+				u.WriteStep[i] = step
+			}
+		}
+	}
+	f.UI = u
+	o.protectRawCursor(f)
+}
+func (o *uiObserver) protectRawCursor(f *Frame) {
+	if f.CursorManaged && !f.CursorPending {
+		return
+	}
+	mem := o.m.Mem
+	if len(mem) < cursorData+0x1bd1+805 {
+		return
+	}
+	d := mem[cursorData:]
+	u16 := func(n int) int { return int(binary.LittleEndian.Uint16(d[n:])) }
+	if u16(0x19) == 0 && u16(0x1b) == 0 {
+		return
+	}
+	r := uiRect{u16(0x1d) * 8, u16(0x1f) + 40, 40, 32}
+	shape, ok := cursorSprite(d[0x1bd1:])
+	if !ok || u16(0x21) != 5 || u16(0x23) != 32 || r.x >= 640 || r.y >= 440 {
+		// 遮罩無法核對時，不猜游標形狀。
+		for i, id := range f.UI.Owner {
+			if id != 0 {
+				f.UI.Owner[i] = 0
+				f.UI.Glyph[i] = false
+				f.UI.Raw[i] = true
+				f.UI.WriteStep[i] = f.Steps
+			}
+		}
+		return
+	}
+	r.each(func(i, j int) {
+		if shape.Idx[j] != hd.Transparent && f.Px[i] == shape.Idx[j] {
+			f.UI.Owner[i] = 0
+			f.UI.Glyph[i] = false
+			f.UI.Raw[i] = true
+			f.UI.WriteStep[i] = f.Steps
+		}
+	})
+}
