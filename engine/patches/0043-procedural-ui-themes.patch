+package runtime
+
+// UIPanel 是規格 011 的不可變板面；Expected 在原語返回後擷取。
+type UIPanel struct {
+	ID, DrawStep uint64
+	X, Y, W, H   int
+	Expected     []uint8
+}
+
+// UIFrame 是同一 VGA 快照的呈現歸屬；各畫布長度皆為 W*H。
+// Owner 的 0 表示沒有可主題化板面。Glyph 保留下方 Owner 供譯文擦除。
+// Raw 標示保守原色回退，WriteStep 為該像素最近繪製或還原的 Machine.Steps。
+type UIFrame struct {
+	Panels    []UIPanel
+	Owner     []uint64
+	Glyph     []bool
+	Raw       []bool
+	WriteStep []uint64
+}
