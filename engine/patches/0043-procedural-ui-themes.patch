@@ -0,0 +1,26 @@
+package hd
+
+import (
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+func TestOverlayFinishRecordsMachineDrawStep(t *testing.T) {
+	m := machine.New()
+	m.Steps = 12345
+	o := NewOverlay(nil)
+	st := &Stamp{Kind: KindSprite, X: 8, Y: 40, W: 8, H: 1, E: make([]byte, 8)}
+	o.finish(m, &pending{st: st, kind: KindSprite})
+	got := o.Snapshot()
+	if len(got) != 1 || got[0].DrawStep != m.Steps || got[0].Seq != 1 || got[0].X != 8 || got[0].Y != 40 {
+		t.Fatalf("completion metadata: %+v", got)
+	}
+	m.Steps = 20000
+	replacement := &Stamp{Kind: KindSprite, X: 8, Y: 40, W: 8, H: 1, E: make([]byte, 8)}
+	o.finish(m, &pending{st: replacement, kind: KindSprite})
+	got = o.Snapshot()
+	if len(got) != 1 || got[0].DrawStep != 20000 || got[0].Seq != 2 || st.DrawStep != 12345 {
+		t.Fatalf("replacement changed sequence or immutable old stamp: %+v", got)
+	}
+}
