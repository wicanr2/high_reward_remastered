+	}
+	o.pending = nil
+	m.Write16(base+10, 0x1bd2)
+	o.pre()
+	if len(o.pending) != 0 {
+		t.Fatal("nearby pointer incorrectly exempted")
+	}
+	f.Steps = 20
+	o.snapshot(f)
+	if !f.UI.Raw[i] || f.UI.Owner[i] != 0 || f.UI.WriteStep[i] != 20 {
+		t.Fatal("raw cursor not protected")
+	}
+	f.CursorManaged = true
+	o.snapshot(f)
+	if f.UI.Owner[i] == 0 {
+		t.Fatal("managed cursor removed underlying panel")
+	}
+}
+
+func TestUINormalPathDoesNotChangeOriginal(t *testing.T) {
+	root := origRoot(t)
+	var all [2]*Session
+	for j := range all {
+		s, err := Open(root, Options{UIHooks: j == 1, SmoothCursor: true, NoPacing: true})
+		if err != nil {
+			t.Fatal(err)
+		}
+		all[j] = s
+		if st := s.RunSteps(30000000); st.Kind != StopSteps {
+			t.Fatal(st)
+		}
+		s.Input(MouseMoveEvent(312, 171))
+		s.Input(MouseButtonEvent(312, 171, 0, true))
+		s.Input(MouseButtonEvent(312, 171, 0, false))
+		if st := s.RunSteps(90000000); st.Kind != StopSteps {
+			t.Fatal(st)
+		}
+		for k := 0; k < 2; k++ {
+			s.Input(MouseMoveEvent(300, 140))
+			s.Input(MouseButtonEvent(300, 140, 0, true))
+			s.Input(MouseButtonEvent(300, 140, 0, false))
+			if st := s.RunSteps(s.m.Steps + 8000000); st.Kind != StopSteps {
+				t.Fatal(st)
+			}
+		}
+		s.SnapshotNow()
+	}
+	a, b := all[0], all[1]
+	ca, cb := *a.m.CPU, *b.m.CPU
+	ca.Bus, cb.Bus, ca.IntHook, cb.IntHook = nil, nil, nil, nil
+	if !bytes.Equal(a.m.Mem, b.m.Mem) || !bytes.Equal(a.Frame().Px, b.Frame().Px) || a.m.Steps != b.m.Steps || a.m.Ticks != b.m.Ticks || !reflect.DeepEqual(ca, cb) || !reflect.DeepEqual(a.d.Stats(), b.d.Stats()) || a.Frame().DAC != b.Frame().DAC || a.Frame().Map != b.Frame().Map {
+		t.Fatal("UI observer changed original machine")
+	}
+	if a.Frame().UI != nil || b.Frame().UI == nil || len(b.Frame().UI.Panels) < 4 || len(b.ui.backups) == 0 {
+		t.Fatalf("normal plate/save path not reached: panels=%d backups=%d", len(b.Frame().UI.Panels), len(b.ui.backups))
+	}
+	t.Logf("normal path steps=%d panels=%d backups=%d", b.m.Steps, len(b.Frame().UI.Panels), len(b.ui.backups))
+}
