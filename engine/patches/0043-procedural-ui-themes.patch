@@ -0,0 +1,50 @@
+package main
+
+import (
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+func TestUIFrameAndSkinPublishTogether(t *testing.T) {
+	a, b := emptyAssets(t), emptyAssets(t)
+	first, second := newHDUISkin(), newHDUISkin()
+	f := newFakeFrame(640, 480, 1)
+	src := &fakeSource{f: f}
+	v := newHDView(src, a, 2, withUISkins(map[*hd.Assets]*uiSkin{a: first, b: second}))
+	t.Cleanup(v.close)
+	until := time.Now().Add(2 * time.Second)
+	for !v.Ready() && time.Now().Before(until) {
+		time.Sleep(time.Millisecond)
+	}
+	var retainedFrame *hrrt.Frame
+	var retainedSkin *uiSkin
+	pub, ok := v.uploadThemed(0, func(_ []byte, frame *hrrt.Frame, skin *uiSkin) { retainedFrame, retainedSkin = frame, skin })
+	if !ok || retainedFrame != f || retainedSkin != first {
+		t.Fatal("first publication lost frame/style identity")
+	}
+	hook := newBlockHook()
+	hook.install(b)
+	t.Cleanup(hook.open)
+	v.SetAssets(b)
+	if !recvWithin(hook.in, time.Second) {
+		t.Fatal("new composition did not reach hold point")
+	}
+	if _, ok := v.uploadThemed(pub, func(_ []byte, _ *hrrt.Frame, _ *uiSkin) { t.Fatal("published incomplete replacement") }); ok {
+		t.Fatal("old ready survived generation change")
+	}
+	if retainedFrame != f || retainedSkin != first {
+		t.Fatal("retained GPU identity changed before upload")
+	}
+	hook.open()
+	until = time.Now().Add(2 * time.Second)
+	for !v.Ready() && time.Now().Before(until) {
+		time.Sleep(time.Millisecond)
+	}
+	_, ok = v.uploadThemed(pub, func(_ []byte, frame *hrrt.Frame, skin *uiSkin) { retainedFrame, retainedSkin = frame, skin })
+	if !ok || retainedFrame != f || retainedSkin != second {
+		t.Fatal("new RGBA/frame/style did not switch atomically")
+	}
+}
diff --git a/apps/hr/play/ui_test.go b/apps/hr/play/ui_test.go
