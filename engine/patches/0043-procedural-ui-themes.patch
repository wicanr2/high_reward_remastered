+++ b/apps/hr/play/ui_test.go
@@ -0,0 +1,259 @@
+package main
+
+import (
+	"bytes"
+	"fmt"
+	"image"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+func uiTestFrame(sz uiSize) *hrrt.Frame {
+	n := 640 * 480
+	f := &hrrt.Frame{W: 640, H: 480, Px: make([]uint8, n), CursorManaged: true}
+	for i := range f.Map {
+		f.Map[i] = uint8(i)
+		f.DAC[i] = [3]uint8{uint8(10 + i*10), uint8(20 + i*9), uint8(30 + i*8)}
+	}
+	f.DAC[15] = [3]uint8{255, 255, 255}
+	p := hrrt.UIPanel{ID: 1, DrawStep: 90, X: 8, Y: 40, W: sz.w, H: sz.h, Expected: make([]uint8, sz.w*sz.h)}
+	f.UI = &hrrt.UIFrame{Panels: []hrrt.UIPanel{p}, Owner: make([]uint64, n), Glyph: make([]bool, n), Raw: make([]bool, n), WriteStep: make([]uint64, n)}
+	for i := range f.Px {
+		f.Px[i] = 1
+	}
+	for y := 0; y < sz.h; y++ {
+		for x := 0; x < sz.w; x++ {
+			p.Expected[y*sz.w+x] = 1
+			if x >= 2 && x < sz.w-2 && y >= 1 && y < sz.h-1 {
+				i := (p.Y+y)*640 + p.X + x
+				f.UI.Owner[i], f.UI.WriteStep[i] = p.ID, p.DrawStep
+			}
+		}
+	}
+	return f
+}
+
+func uiTestRGBA(f *hrrt.Frame, scale int) []byte {
+	b := make([]byte, f.W*scale*f.H*scale*4)
+	for i := 0; i < len(b); i += 4 {
+		copy(b[i:], []byte{200, 10, 20, 255}) // 模擬已合成的較早 HD 層。
+	}
+	return b
+}
+
+func uiTestPixel(b []byte, x, y, scale int) [3]uint8 {
+	i := ((y*scale)*(640*scale) + x*scale) * 4
+	return [3]uint8{b[i], b[i+1], b[i+2]}
+}
+
+func TestUIRendererFiveSizesAndSameValueGlyph(t *testing.T) {
+	s := newHDUISkin()
+	for _, sz := range uiSizes {
+		t.Run(fmt.Sprintf("%dx%d", sz.w, sz.h), func(t *testing.T) {
+			f := uiTestFrame(sz)
+			x, y := 28, 55
+			f.UI.Glyph[y*640+x] = true // 與板面同色的原字，不可靠差異猜字。
+			raw := append([]byte(nil), f.Px...)
+			expected := append([]byte(nil), f.UI.Panels[0].Expected...)
+			b := uiTestRGBA(f, 2)
+			s.paint(b, f, 2)
+			if got := uiTestPixel(b, x, y, 2); got != f.DAC[1] {
+				t.Fatalf("same-value glyph overwritten: %v", got)
+			}
+			if got := uiTestPixel(b, 8, 40, 2); got != [3]uint8{200, 10, 20} {
+				t.Fatalf("transparent corner changed: %v", got)
+			}
+			x++
+			c, ok := s.background(f, x, y, 1)
+			if !ok || uiTestPixel(b, x, y, 2) != c || c == f.DAC[1] {
+				t.Fatal("theme and translated erase use different native colors")
+			}
+			if _, ok := s.background(f, x-1, y, 1); !ok {
+				t.Fatal("glyph protection blocked controlled translated erase")
+			}
+			if _, ok := s.background(f, x, y, 2); ok {
+				t.Fatal("mismatched Before accepted")
+			}
+			if !bytes.Equal(raw, f.Px) || !bytes.Equal(expected, f.UI.Panels[0].Expected) {
+				t.Fatal("renderer changed immutable original indices")
+			}
+		})
+	}
+}
+
+func TestUIRendererUnknownWriteAndLaterVerifiedArt(t *testing.T) {
+	s := newHDUISkin()
+	for _, tc := range []struct {
+		name        string
+		draw        uint64
+		badNeighbor bool
+		keep        bool
+	}{
+		{"newer verified", 101, false, true},
+		{"same step", 100, false, false},
+		{"older art", 99, false, false},
+		{"newer invalid art", 101, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := uiTestFrame(uiSize{128, 56})
+			x, y := 40, 60
+			for dy := 0; dy < 8; dy++ {
+				for dx := 0; dx < 8; dx++ {
+					i := (y+dy)*640 + x + dx
+					f.UI.Owner[i], f.UI.Glyph[i], f.UI.Raw[i], f.UI.WriteStep[i] = 0, false, true, 100
+				}
+			}
+			e := bytes.Repeat([]byte{1}, 64)
+			f.Stamps = []*hd.Stamp{{Kind: hd.KindSprite, X: x, Y: y, W: 8, H: 8, E: e, Seq: 1, DrawStep: tc.draw}}
+			if tc.badNeighbor {
+				f.Px[(y+3)*640+x+3] = 2 // 004 的鄰域／單色弱證據負對照。
+			}
+			b := uiTestRGBA(f, 1)
+			s.paint(b, f, 1)
+			want := f.DAC[1]
+			if tc.keep {
+				want = [3]uint8{200, 10, 20}
+			}
+			if got := uiTestPixel(b, x+4, y+3, 1); got != want {
+				t.Fatalf("write/DrawStep/004 priority: %v want %v", got, want)
+			}
+			if _, ok := s.background(f, x+4, y+3, 1); ok {
+				t.Fatal("unknown write retained theme ownership")
+			}
+		})
+	}
+}
+
+func TestUIRendererMissingAssetStillOccludesOldHD(t *testing.T) {
+	ai := &hd.Assets{Dir: t.TempDir()}
+	var logs []string
+	skins := loadUISkins(&themeSet{Assets: map[themeID]*hd.Assets{themeAI: ai}}, func(format string, args ...any) { logs = append(logs, fmt.Sprintf(format, args...)) })
+	s := skins[ai]
+	if s == nil || len(logs) != 1 {
+		t.Fatalf("missing AI skin/log: %v %v", s, logs)
+	}
+	f := uiTestFrame(uiSize{128, 56})
+	b := uiTestRGBA(f, 1)
+	s.paint(b, f, 1)
+	if uiTestPixel(b, 28, 55, 1) != f.DAC[1] {
+		t.Fatal("missing style exposed stale HD through original panel")
+	}
+	if _, ok := s.background(f, 28, 55, 1); ok {
+		t.Fatal("missing style supplied guessed translated background")
+	}
+	if err := os.WriteFile(filepath.Join(ai.Dir, "ui-panel-ai-v1.png"), []byte("untrusted PNG"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	logs = nil
+	skins = loadUISkins(&themeSet{Assets: map[themeID]*hd.Assets{themeAI: ai}}, func(format string, args ...any) { logs = append(logs, fmt.Sprintf(format, args...)) })
+	if skins[ai] == nil || len(logs) != 1 || !strings.Contains(logs[0], "SHA-256") {
+		t.Fatal("untrusted AI bytes did not produce one original fallback")
+	}
+}
+
+func TestUIRendererCursorFallbackAndUnknownShape(t *testing.T) {
+	s := newHDUISkin()
+	f := uiTestFrame(uiSize{128, 56})
+	f.CursorManaged = false
+	e := bytes.Repeat([]byte{hd.Transparent}, 40*32)
+	e[0] = 1
+	f.Stamps = []*hd.Stamp{{Site: hd.CursorSite, X: 24, Y: 50, W: 40, H: 32, E: e}}
+	f.UI.Glyph[50*640+24], f.UI.Raw[50*640+24] = true, true
+	b := uiTestRGBA(f, 1)
+	s.paint(b, f, 1)
+	if uiTestPixel(b, 24, 50, 1) != [3]uint8{200, 10, 20} {
+		t.Fatal("glyph/raw theme step erased composited fallback cursor")
+	}
+	if _, ok := s.background(f, 24, 50, 1); ok {
+		t.Fatal("translated erase accepted fallback cursor pixel")
+	}
+	f.Stamps = nil
+	b = uiTestRGBA(f, 1)
+	s.paint(b, f, 1)
+	if uiTestPixel(b, 28, 55, 1) != f.DAC[1] {
+		t.Fatal("unknown cursor shape must conservatively use original panel")
+	}
+}
+
+func TestUIRendererFadeAndMalformedInput(t *testing.T) {
+	s := newHDUISkin()
+	f := uiTestFrame(uiSize{128, 56})
+	full, _ := s.background(f, 28, 55, 1)
+	f.DAC[15] = [3]uint8{128, 64, 0}
+	faded, ok := s.background(f, 28, 55, 1)
+	if !ok || faded[0] != uint8((uint16(full[0])*128+127)/255) || faded[1] != uint8((uint16(full[1])*64+127)/255) || faded[2] != 0 {
+		t.Fatalf("white-index fade: %v -> %v", full, faded)
+	}
+	for _, edit := range []func(*hrrt.Frame){
+		func(f *hrrt.Frame) { f.UI.Panels[0].W = 127 },
+		func(f *hrrt.Frame) { f.UI.Panels[0].Expected = nil },
+		func(f *hrrt.Frame) { f.UI.Panels[0].X = 9 },
+		func(f *hrrt.Frame) { f.UI.Panels = nil },
+	} {
+		f = uiTestFrame(uiSize{128, 56})
+		edit(f)
+		b := uiTestRGBA(f, 1)
+		s.paint(b, f, 1)
+		if got := uiTestPixel(b, 28, 55, 1); got != f.DAC[1] {
+			t.Fatalf("invalid or evicted panel did not preserve original occlusion: %v", got)
+		}
+		if _, ok := s.background(f, 28, 55, 1); ok {
+			t.Fatal("invalid metadata supplied theme background")
+		}
+	}
+	f = uiTestFrame(uiSize{128, 56})
+	f.UI.Owner = f.UI.Owner[:1]
+	b := uiTestRGBA(f, 1)
+	before := append([]byte(nil), b...)
+	s.paint(b, f, 1)
+	if !bytes.Equal(before, b) {
+		t.Fatal("incomplete canvas used unknown ownership")
+	}
+}
+
+func TestUIRendererConcurrentPaintAndBackground(t *testing.T) {
+	s := newHDUISkin()
+	f := uiTestFrame(uiSize{272, 72})
+	var wg sync.WaitGroup
+	for n := 0; n < 4; n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			b := uiTestRGBA(f, 1)
+			for i := 0; i < 4; i++ {
+				s.paint(b, f, 1)
+				if _, ok := s.background(f, 28, 55, 1); !ok {
+					t.Error("immutable cache unavailable")
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
+
+func TestUIRendererAcceptedAIImage(t *testing.T) {
+	path := filepath.Join("..", "..", "..", "..", "..", "hd-ai", "ui-panel-ai-v1.png")
+	if _, err := os.Stat(path); os.IsNotExist(err) {
+		t.Skip("accepted AI panel absent")
+	}
+	s, err := loadAIUISkin(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, sz := range uiSizes {
+		f := uiTestFrame(sz)
+		c, ok := s.background(f, 8+sz.w/2, 40+sz.h/2, 1)
+		if !ok || c == [3]uint8{} || len(s.fields[sz]) != sz.w*sz.h {
+			t.Fatalf("accepted AI field %v: %v %v", sz, c, ok)
+		}
+	}
+	if got := uiAIContentRect(image.NewRGBA(image.Rect(0, 0, 8, 8))); !got.Empty() {
+		t.Fatal("transparent input guessed a panel")
+	}
+}
