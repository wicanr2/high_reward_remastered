+			if f.UI != nil || len(o.canvas.Panels) != 0 || len(o.pending) != 0 || len(o.backups) != 0 || o.backupPixels != 0 {
+				t.Fatal("unsupported stride published or retained UI metadata")
+			}
+			_, _, pxAfter := m.Planar()
+			cpuAfter := *m.CPU
+			cpuBefore.Bus, cpuAfter.Bus, cpuBefore.IntHook, cpuAfter.IntHook = nil, nil, nil, nil
+			if !bytes.Equal(before, m.Mem) || !bytes.Equal(pxBefore, pxAfter) || !reflect.DeepEqual(cpuBefore, cpuAfter) || m.VGA.Pitch(640) != 160 || len(m.ModeChanges) != modeEvents {
+				t.Fatal("stride fallback changed original machine")
+			}
+			m.VGA.Out(0x3d4, 0x13)
