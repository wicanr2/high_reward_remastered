+package runtime
+
+import (
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+func TestDisplaySameValueGlyphPublishesWrittenMask(t *testing.T) {
+	m, _ := uiFixture()
+	m.CPU.Seg[cpu.CS], m.CPU.IP = 0x1234, 0x5678
+	m.CPU.Seg[cpu.SS], m.CPU.R[cpu.SP] = 0x100, 0x200
+	s := DisplayStamp{X: 264, Y: 188, W: 16, H: 16, Text: "text", Before: make([]byte, 256), Written: make([]byte, 256)}
+	d := &displayObserver{uiEnabled: true, pending: []displayPending{{stamp: s, ss: 0x100, sp: 0x200, cs: 0x1234, ip: 0x5678}}}
+	mask := make([]byte, 48)
+	mask[0] = 0x80
+	d.noteGlyph(uiRect{264, 188, 24, 16}, mask)
+	d.post(m)
+	if len(d.stamps) != 1 || d.stamps[0].Written[0] != 1 || d.stamps[0].Before[0] != d.stamps[0].Expected[0] {
+		t.Fatal("same-color original glyph lost controlled erase metadata")
+	}
+	old := d.stamps[0]
+	s.Written = make([]byte, 256)
+	s.Written[1] = 1
+	d.pending = []displayPending{{stamp: s, ss: 0x100, sp: 0x200, cs: 0x1234, ip: 0x5678}}
+	d.post(m)
+	if old.Written[1] != 0 || d.stamps[0].Written[0] != 1 || d.stamps[0].Written[1] != 1 {
+		t.Fatal("identical redraw mutated old frame or lost original write mask")
+	}
+}
