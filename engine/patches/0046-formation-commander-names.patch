 		// 只有候選指令（呼叫與前綴；取樣期間全部）才在執行後用 CPU.Op() 取得本道指令並分類。
 		b0 := m.Mem[a&(machine.MemSize-1)]
+		s.fixFormationCommanderName()
 		if ov != nil {
 			ov.Pre(m)
 		}
