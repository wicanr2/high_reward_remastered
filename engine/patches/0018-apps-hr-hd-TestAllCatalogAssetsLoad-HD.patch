 		}
 	}
 }
+
+// 清冊中每個有 HD 路徑的項目都能載入：PNG 存在、尺寸等於清冊尺寸乘倍率、參考調色盤存在。
+// 清冊目錄用 HR_HD（預設 /orig/hd-stage，容器內 workplace 的掛載點）；沒有就 skip（HD 素材不在本儲存庫）。
+func TestAllCatalogAssetsLoad(t *testing.T) {
+	dir := os.Getenv("HR_HD")
+	if dir == "" {
+		dir = "/orig/hd-stage"
+	}
+	if _, err := os.Stat(filepath.Join(dir, "catalog.tsv")); err != nil {
+		t.Skipf("沒有清冊：%v", err)
+	}
+	a, err := LoadAssets(dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	withHD, missing := 0, 0
+	for h, e := range a.cat {
+		if e.HD == "" {
+			missing++
+			continue
+		}
+		withHD++
+		if a.Get(h) == nil {
+			t.Errorf("%s（%s）載入失敗", e.ID, e.HD)
+		}
+	}
+	for _, msg := range a.Errors {
+		t.Log(msg)
+	}
+	t.Logf("清冊 %d 列，有 HD 路徑 %d，尚無 HD %d", len(a.cat), withHD, missing)
+	if withHD == 0 {
+		t.Fatal("清冊沒有任何 HD 路徑")
+	}
+}
