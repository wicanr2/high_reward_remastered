Xvfb 端對端驗證（tools/play.sh gui-diag）時發現同一份診斷在 stderr 出現兩行。

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 apps/hr/play/game.go | 1 -
 1 file changed, 1 deletion(-)

diff --git a/apps/hr/play/game.go b/apps/hr/play/game.go
index 8e7b92c..9511c09 100644
--- a/apps/hr/play/game.go
+++ b/apps/hr/play/game.go
@@ -244,7 +244,6 @@ var lastDiag atomic.Value
 // onDiag 是 Options.OnDiag：在持有機器的 goroutine 內呼叫，不得阻塞，不得呼叫會進入模擬迴圈的 Session 方法。
 func onDiag(dataDir, dir, reason string) {
 	lastDiag.Store(filepath.Base(dir))
-	fmt.Fprintf(os.Stderr, "診斷已存到 %s（%s）\n", dir, reason)
 	if f, err := os.OpenFile(filepath.Join(dataDir, "play.log"), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644); err == nil {
 		fmt.Fprintf(f, "%s\tdiag\t%s\t%s\n", time.Now().Format(time.RFC3339), dir, reason)
 		f.Close()
