@@ -0,0 +1,125 @@
+package hd
+
+import "sort"
+
+// Kind 是戳記的來源（docs/spec/004 第 3.2 節）。
+type Kind uint8
+
+const (
+	KindSprite  Kind = iota + 1 // 2B47:0022 記憶體內精靈
+	KindCache24                 // 3268:1155 24x24 遮罩精靈快取
+	KindStream                  // 2E92:066A 壓縮串流（遮罩在列首）
+	KindPacked4                 // 348F:0005 已解壓 packed 4bpp
+	KindMap                     // 2FB2:25A1 GMAP，整張矩形
+)
+
+func (k Kind) String() string {
+	switch k {
+	case KindSprite:
+		return "sprite"
+	case KindCache24:
+		return "cache24"
+	case KindStream:
+		return "stream"
+	case KindPacked4:
+		return "packed4"
+	case KindMap:
+		return "map"
+	}
+	return "?"
+}
+
+// Stamp 記錄「遊戲在 Px 的 (X, Y) 畫過這張圖」。建立後不再修改，快照可以放心共用。
+// X、Y 是 Machine.Planar 輸出的座標（Y 已含遊戲區的 40 列偏移）。
+type Stamp struct {
+	Kind Kind
+	X, Y int
+	W, H int
+	Hash string
+	Site uint32 // 呼叫點：返回位址 seg<<16 | off
+	E    []byte // 期望像素，逐列每像素一個位元組，Transparent 為透明；長度 W*H
+	Seq  uint64
+}
+
+type stampKey struct {
+	x, y, w, h int
+	hash       string
+}
+
+// QueueMax 是戳記佇列的上限（docs/spec/004 第 4.2 節）。
+const QueueMax = 1024
+
+// Queue 是戳記佇列。只由持有機器的 goroutine 使用；Snapshot 回傳的切片可以交給其他執行緒讀。
+//
+// 規則（第 4.2 節）只有三條：去重（同 x、y、w、h、雜湊的新戳記取代舊的）、
+// singleton（同一個 singleton 呼叫點只留最新一個）、LRU（超過上限移除序號最小的）。
+// 沒有任何依事件的移除規則（第 2 節）。
+type Queue struct {
+	max        int
+	seq        uint64
+	list       []*Stamp // 依序號遞增
+	byKey      map[stampKey]*Stamp
+	singletons map[uint32]bool
+	bySite     map[uint32]*Stamp
+	Dropped    uint64 // 被 LRU 丟掉的戳記數
+	Replaced   uint64 // 被去重或 singleton 取代的戳記數
+}
+
+// NewQueue 建立佇列。singletons 是 singleton 呼叫點的集合；max ≤ 0 取 QueueMax。
+func NewQueue(max int, singletons ...uint32) *Queue {
+	if max <= 0 {
+		max = QueueMax
+	}
+	q := &Queue{max: max, byKey: map[stampKey]*Stamp{}, singletons: map[uint32]bool{}, bySite: map[uint32]*Stamp{}}
+	for _, s := range singletons {
+		q.singletons[s] = true
+	}
+	return q
+}
+
+func (q *Queue) remove(s *Stamp) {
+	i := sort.Search(len(q.list), func(i int) bool { return q.list[i].Seq >= s.Seq })
+	if i < len(q.list) && q.list[i] == s {
+		q.list = append(q.list[:i], q.list[i+1:]...)
+	}
+	delete(q.byKey, stampKey{s.X, s.Y, s.W, s.H, s.Hash})
+	if q.bySite[s.Site] == s {
+		delete(q.bySite, s.Site)
+	}
+}
+
+// Add 加入一個有效的戳記（待定的戳記在返回鉤子觸發後才加入），指派序號。
+// 回傳 LRU 丟掉的戳記（沒有就是 nil），供呼叫者寫紀錄。
+func (q *Queue) Add(s *Stamp) (evicted *Stamp) {
+	if old := q.byKey[stampKey{s.X, s.Y, s.W, s.H, s.Hash}]; old != nil {
+		q.remove(old)
+		q.Replaced++
+	}
+	if q.singletons[s.Site] {
+		if old := q.bySite[s.Site]; old != nil {
+			q.remove(old)
+			q.Replaced++
+		}
+		q.bySite[s.Site] = s
+	}
+	q.seq++
+	s.Seq = q.seq
+	q.list = append(q.list, s)
+	q.byKey[stampKey{s.X, s.Y, s.W, s.H, s.Hash}] = s
+	if len(q.list) > q.max {
+		evicted = q.list[0]
+		q.remove(evicted)
+		q.Dropped++
+	}
+	return evicted
+}
+
+// Len 回傳目前的戳記數。
+func (q *Queue) Len() int { return len(q.list) }
+
+// Snapshot 回傳依序號遞增的戳記複本（戳記本身不可變，共用指標）。
+func (q *Queue) Snapshot() []*Stamp {
+	out := make([]*Stamp, len(q.list))
+	copy(out, q.list)
+	return out
+}
