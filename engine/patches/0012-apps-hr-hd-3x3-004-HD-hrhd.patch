+// findHD 找 HD 素材目錄（內含 catalog.tsv）。順序：-hd、環境變數 HR_HD、AppImage 檔案旁、
+// 執行檔旁的 hd、macOS app 的 Contents/Resources/hd、目前目錄的 hd。找不到回空字串（不啟用 HD，不是錯誤）。
+func findHD(flagVal string) string {
+	var cands []string
+	if flagVal != "" {
+		cands = append(cands, flagVal)
+	}
+	if v := os.Getenv("HR_HD"); v != "" {
+		cands = append(cands, v)
+	}
+	if ai := os.Getenv("APPIMAGE"); ai != "" {
+		cands = append(cands, filepath.Join(filepath.Dir(ai), "hd"))
