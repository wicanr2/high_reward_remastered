+package runtime
+
+import (
+	"testing"
+	"time"
+)
+
+// docs/spec/004 第 7 節「快照限速」：Draw 以 144 Hz 呼叫時間隔 ≥ 16 ms；不超過 60 Hz 時每次都呼叫。
+func TestFrameLimiter(t *testing.T) {
+	t0 := time.Unix(1000, 0)
+	var l FrameLimiter
+	var allowed []time.Time
+	for i := 0; i < 1440; i++ { // 10 秒、144 Hz
+		now := t0.Add(time.Duration(i) * time.Second / 144)
+		if l.Allow(now) {
+			allowed = append(allowed, now)
+		}
+	}
+	if len(allowed) < 400 || len(allowed) > 625 { // 嚴格 ≥ 16 ms：144 Hz 的格距 6.9 ms，每 3 格放行一次，約 48 Hz
+		t.Fatalf("10 秒內放行 %d 次，預期 400 至 625", len(allowed))
+	}
+	for i := 1; i < len(allowed); i++ {
+		if d := allowed[i].Sub(allowed[i-1]); d < 16*time.Millisecond {
+			t.Fatalf("間隔 %v 小於 16 ms", d)
+		}
+	}
+	var l2 FrameLimiter
+	for i := 0; i < 600; i++ { // 60 Hz：每次都放行
+		now := t0.Add(time.Duration(i) * time.Second / 60)
+		if !l2.Allow(now) {
+			t.Fatalf("60 Hz 的第 %d 次被擋", i)
+		}
+	}
+	var l3 FrameLimiter
+	for i := 0; i < 300; i++ { // 30 Hz：每次都放行
+		if !l3.Allow(t0.Add(time.Duration(i) * time.Second / 30)) {
+			t.Fatalf("30 Hz 的第 %d 次被擋", i)
+		}
+	}
+}
