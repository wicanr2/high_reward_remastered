diff --git a/apps/hr/play/hdview.go b/apps/hr/play/hdview.go
new file mode 100644
index 0000000..158ca08
--- /dev/null
+++ b/apps/hr/play/hdview.go
@@ -0,0 +1,93 @@
+package main
+
+import (
+	"image"
+	"image/png"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// hdView 在背景 goroutine 把執行層的快照合成成 HD 畫面（docs/spec/004 第 5 節），
+// 繪製執行緒只上傳最近一張完成的畫面，不等合成。
+type hdView struct {
+	s   *hrrt.Session
+	cmp *hd.Composer
+	S   int
+
+	mu       sync.Mutex
+	ready    []byte // 最近一張合成完成的 RGBA：(640*S) x (480*S)
+	readySeq uint64
+	work     []byte
+	stop     chan struct{}
+	wg       sync.WaitGroup
+}
+
+func newHDView(s *hrrt.Session, assets *hd.Assets, scale int) *hdView {
+	n := 640 * scale * 480 * scale * 4
+	v := &hdView{s: s, cmp: hd.NewComposer(assets, scale), S: scale, ready: make([]byte, n), work: make([]byte, n), stop: make(chan struct{})}
+	v.wg.Add(1)
+	go v.run()
+	return v
+}
+
+func (v *hdView) close() {
+	close(v.stop)
+	v.wg.Wait()
+}
+
+func (v *hdView) run() {
+	defer v.wg.Done()
+	tk := time.NewTicker(2 * time.Millisecond)
+	defer tk.Stop()
+	var last uint64
+	for {
+		select {
+		case <-v.stop:
+			return
+		case <-tk.C:
+		}
+		f := v.s.Frame()
+		if f == nil || f.Seq == last {
+			continue
+		}
+		last = f.Seq
+		v.cmp.Compose(v.work, f.Px, f.W, f.H, f.Map, &f.DAC, f.Stamps)
+		v.mu.Lock()
+		v.ready, v.work = v.work, v.ready
+		v.readySeq = f.Seq
+		v.mu.Unlock()
+	}
+}
+
+// upload 在有新畫面時呼叫 fn（持鎖，fn 必須在回傳前用完緩衝區），回傳是否有新畫面。
+func (v *hdView) upload(lastSeq uint64, fn func(rgba []byte)) (uint64, bool) {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if v.readySeq == 0 || v.readySeq == lastSeq {
+		return lastSeq, false
+	}
+	fn(v.ready)
+	return v.readySeq, true
+}
+
+// writePNG 把最近一張合成畫面的遊戲區（第 40 至 439 列）存成 PNG（HD 解析度）。
+func (v *hdView) writePNG(path string) error {
+	w, h := 640*v.S, 400*v.S
+	img := image.NewRGBA(image.Rect(0, 0, w, h))
+	v.mu.Lock()
+	for y := 0; y < h; y++ {
+		src := ((y+40*v.S)*640*v.S)*4
+		copy(img.Pix[y*img.Stride:y*img.Stride+w*4], v.ready[src:src+w*4])
+	}
+	v.mu.Unlock()
+	out, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	defer out.Close()
+	return png.Encode(out, img)
+}
