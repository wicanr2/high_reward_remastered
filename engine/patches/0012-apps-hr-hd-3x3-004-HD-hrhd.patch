new file mode 100644
index 0000000..a741d7a
--- /dev/null
+++ b/apps/hr/hd/verify.go
@@ -0,0 +1,248 @@
+package hd
+
+import "math/bits"
+
+// Mask 是戳記座標下的點陣：每列 Stride 個 uint64，第 i 個像素是第 i>>6 個字的第 i&63 位。
+type Mask struct {
+	W, H, Stride int
+	Bits         []uint64
+}
+
+// Get 回傳 (i, j) 是否為 1；範圍外為 false。
+func (m Mask) Get(i, j int) bool {
+	if i < 0 || j < 0 || i >= m.W || j >= m.H {
+		return false
+	}
+	return m.Bits[j*m.Stride+i>>6]>>(uint(i)&63)&1 != 0
+}
+
+// Count 回傳 1 的個數。
+func (m Mask) Count() int {
+	n := 0
+	for _, w := range m.Bits {
+		n += popcount(w)
+	}
+	return n
+}
+
+func popcount(x uint64) int { return bits.OnesCount64(x) }
+
+// Verifier 做 docs/spec/004 第 5.3 節第 1 至 2 步：每個戳記求通過驗證的像素 V。
+// 內部緩衝區重複使用，Run 回傳的 Mask 到下一次 Run 之前有效。不可同時由多個執行緒使用。
+type Verifier struct {
+	scr    []uint64 // 解釋點陣 X：整個 Px 的位元列
+	scrStr int
+	vbits  []uint64
+	o, m   []uint64
+	b, dh  []uint64
+	xl     []uint64
+	out    []Mask
+	// 統計（驗收用）
+	Fast, Slow, Empty int
+}
+
+// Run 對依序號遞增排列的 stamps 求每個戳記的 V（回傳切片與 stamps 同序）。
+// 規則：像素本身相符，且戳記內 3x3 鄰域中每個不透明像素也相符，或被「序號更大的戳記」解釋
+// （該位置被序號更大的戳記相符）。由序號最大的戳記往小處理並維護解釋點陣。
+// 範圍外（Px 之外）的像素視為不存在（第 1 節：落在範圍外的丟棄）。
+func (v *Verifier) Run(stamps []*Stamp, px []uint8, pxW, pxH int) []Mask {
+	v.Fast, v.Slow, v.Empty = 0, 0, 0
+	v.scrStr = (pxW + 63) >> 6
+	need := v.scrStr * pxH
+	if cap(v.scr) < need {
+		v.scr = make([]uint64, need)
+	}
+	v.scr = v.scr[:need]
+	for i := range v.scr {
+		v.scr[i] = 0
+	}
+	// V 的總容量
+	total := 0
+	for _, s := range stamps {
+		total += ((s.W + 63) >> 6) * s.H
+	}
+	if cap(v.vbits) < total {
+		v.vbits = make([]uint64, total)
+	}
+	v.vbits = v.vbits[:total]
+	for i := range v.vbits {
+		v.vbits[i] = 0
+	}
+	if cap(v.out) < len(stamps) {
+		v.out = make([]Mask, len(stamps))
+	}
+	v.out = v.out[:len(stamps)]
+	// 配置各戳記的 V 區段（依序號遞增排列）
+	off := 0
+	for i, s := range stamps {
+		st := (s.W + 63) >> 6
+		v.out[i] = Mask{W: s.W, H: s.H, Stride: st, Bits: v.vbits[off : off+st*s.H : off+st*s.H]}
+		off += st * s.H
+	}
+	for i := len(stamps) - 1; i >= 0; i-- {
+		v.one(stamps[i], px, pxW, pxH, v.out[i])
+	}
+	return v.out
+}
+
+func grow(b []uint64, n int) []uint64 {
+	if cap(b) < n {
+		return make([]uint64, n)
+	}
+	b = b[:n]
+	for i := range b {
+		b[i] = 0
+	}
+	return b
+}
+
+func (v *Verifier) one(s *Stamp, px []uint8, pxW, pxH int, vm Mask) {
+	w, h, st := s.W, s.H, vm.Stride
+	v.o = grow(v.o, st*h)
+	v.m = grow(v.m, st*h)
+	O, M := v.o, v.m
+	nO, nM := 0, 0
+	for j := 0; j < h; j++ {
+		y := s.Y + j
+		if y < 0 || y >= pxH {
+			continue
+		}
+		er := s.E[j*w : j*w+w]
+		pr := px[y*pxW : y*pxW+pxW]
+		orow := O[j*st : j*st+st]
+		mrow := M[j*st : j*st+st]
+		lo, hi := 0, w
+		if s.X < 0 {
+			lo = -s.X
+		}
+		if s.X+hi > pxW {
+			hi = pxW - s.X
+		}
+		for i := lo; i < hi; i++ {
+			e := er[i]
+			if e == Transparent {
+				continue
+			}
+			bit := uint64(1) << (uint(i) & 63)
+			orow[i>>6] |= bit
+			nO++
+			if pr[s.X+i] == e {
+				mrow[i>>6] |= bit
+				nM++
+			}
+		}
+	}
+	switch {
+	case nM == 0:
+		v.Empty++
+		return
+	case nM == nO:
+		v.Fast++
+		copy(vm.Bits, M)
+	default:
+		v.Slow++
+		v.neighborhood(s, vm, O, M)
+	}
+	v.orScreen(s, M, st)
+}
+
+// neighborhood 做第 2 步：B ＝ O 且非 M 且非 X，擴張 3x3，V ＝ M 且非 D。
+func (v *Verifier) neighborhood(s *Stamp, vm Mask, O, M []uint64) {
+	w, h, st := s.W, s.H, vm.Stride
+	v.b = grow(v.b, st*h)
+	v.dh = grow(v.dh, st*h)
+	v.xl = grow(v.xl, st)
+	B, Dh := v.b, v.dh
+	for j := 0; j < h; j++ {
+		y := s.Y + j
+		orow := O[j*st : j*st+st]
+		mrow := M[j*st : j*st+st]
+		brow := B[j*st : j*st+st]
+		for k := range v.xl {
+			v.xl[k] = 0
+		}
+		if y >= 0 && y < len(v.scr)/v.scrStr {
+			v.extract(v.xl, y, s.X, w)
+		}
+		for k := 0; k < st; k++ {
+			brow[k] = orow[k] &^ mrow[k] &^ v.xl[k]
+		}
+	}
+	// 水平擴張
+	for j := 0; j < h; j++ {
+		brow := B[j*st : j*st+st]
+		drow := Dh[j*st : j*st+st]
+		for k := 0; k < st; k++ {
+			x := brow[k]
+			d := x | x<<1 | x>>1
+			if k > 0 {
+				d |= brow[k-1] >> 63
+			}
+			if k+1 < st {
+				d |= brow[k+1] << 63
+			}
+			drow[k] = d
+		}
+	}
+	// 垂直擴張並求 V
+	for j := 0; j < h; j++ {
+		for k := 0; k < st; k++ {
+			d := Dh[j*st+k]
+			if j > 0 {
+				d |= Dh[(j-1)*st+k]
+			}
+			if j+1 < h {
+				d |= Dh[(j+1)*st+k]
+			}
+			vm.Bits[j*st+k] = M[j*st+k] &^ d
+		}
+	}
+}
+
+func (v *Verifier) wordAt(row, idx int) uint64 {
+	if idx < 0 || idx >= v.scrStr {
+		return 0
+	}
+	return v.scr[row*v.scrStr+idx]
+}
+
+// extract 把解釋點陣第 row 列從 x0 起的 n 個位元讀進 dst（尾端超出 n 的位元清 0）。
+func (v *Verifier) extract(dst []uint64, row, x0, n int) {
+	for k := range dst {
+		bit := x0 + 64*k
+		w0, sh := bit>>6, uint(bit&63)
+		x := v.wordAt(row, w0) >> sh
+		if sh > 0 {
+			x |= v.wordAt(row, w0+1) << (64 - sh)
+		}
+		dst[k] = x
+	}
+	if r := n & 63; r != 0 {
+		dst[len(dst)-1] &= (uint64(1) << uint(r)) - 1
+	}
+}
+
+// orScreen 把戳記座標下的 M 併進解釋點陣。
+func (v *Verifier) orScreen(s *Stamp, M []uint64, st int) {
+	rows := len(v.scr) / v.scrStr
+	for j := 0; j < s.H; j++ {
+		y := s.Y + j
+		if y < 0 || y >= rows {
+			continue
+		}
+		for k := 0; k < st; k++ {
+			x := M[j*st+k]
+			if x == 0 {
+				continue
+			}
+			bit := s.X + 64*k
+			w0, sh := bit>>6, uint(bit&63)
+			if w0 >= 0 && w0 < v.scrStr {
+				v.scr[y*v.scrStr+w0] |= x << sh
+			}
+			if sh > 0 && w0+1 >= 0 && w0+1 < v.scrStr {
+				v.scr[y*v.scrStr+w0+1] |= x >> (64 - sh)
+			}
+		}
+	}
+}
diff --git a/apps/hr/hd/verify_test.go b/apps/hr/hd/verify_test.go
new file mode 100644
index 0000000..700eb2c
--- /dev/null
+++ b/apps/hr/hd/verify_test.go
@@ -0,0 +1,226 @@
+package hd
+
+import (
+	"math/rand"
+	"testing"
+)
+
+// naiveVerify 是 docs/spec/004 第 5.3 節第 2 步的逐像素定義：
+// 像素本身相符，且戳記內 3x3 鄰域中每個不透明像素也相符，或該位置被序號更大的戳記相符。
+func naiveVerify(stamps []*Stamp, px []uint8, pxW, pxH int) [][]bool {
+	match := func(s *Stamp, i, j int) (opaque, ok bool) {
+		if i < 0 || j < 0 || i >= s.W || j >= s.H {
+			return false, false
+		}
+		x, y := s.X+i, s.Y+j
+		if x < 0 || y < 0 || x >= pxW || y >= pxH {
+			return false, false
+		}
+		e := s.E[j*s.W+i]
+		if e == Transparent {
+			return false, false
+		}
+		return true, px[y*pxW+x] == e
+	}
+	res := make([][]bool, len(stamps))
+	for k, s := range stamps {
+		res[k] = make([]bool, s.W*s.H)
+		explained := func(x, y int) bool {
+			for t := k + 1; t < len(stamps); t++ {
+				u := stamps[t]
+				if op, ok := match(u, x-u.X, y-u.Y); op && ok {
+					return true
+				}
+			}
+			return false
+		}
+		for j := 0; j < s.H; j++ {
+			for i := 0; i < s.W; i++ {
+				if op, ok := match(s, i, j); !op || !ok {
+					continue
+				}
+				pass := true
+				for dj := -1; dj <= 1 && pass; dj++ {
+					for di := -1; di <= 1; di++ {
+						op, ok := match(s, i+di, j+dj)
+						// 範圍外（Px 之外）的像素視為不存在
+						if i+di < 0 || j+dj < 0 || i+di >= s.W || j+dj >= s.H {
+							continue
+						}
+						if x, y := s.X+i+di, s.Y+j+dj; x < 0 || y < 0 || x >= pxW || y >= pxH {
+							continue
+						}
+						if op && !ok && !explained(s.X+i+di, s.Y+j+dj) {
+							pass = false
+							break
+						}
+					}
+				}
+				res[k][j*s.W+i] = pass
+			}
+		}
+	}
+	return res
+}
+
+func randStamp(r *rand.Rand, pxW, pxH int) *Stamp {
+	w := 1 + r.Intn(150)
+	h := 1 + r.Intn(40)
+	s := &Stamp{W: w, H: h, X: r.Intn(pxW+60) - 30, Y: r.Intn(pxH+20) - 10, E: make([]byte, w*h)}
+	for i := range s.E {
+		if r.Intn(5) == 0 {
+			s.E[i] = Transparent
+		} else {
+			s.E[i] = byte(r.Intn(3))
+		}
+	}
+	return s
+}
+
+// 與逐像素定義逐位元對拍（含 Px 邊界外、跨 64 位元字界、負座標）。
+func TestVerifyMatchesNaive(t *testing.T) {
+	r := rand.New(rand.NewSource(7))
+	var vf Verifier
+	const pxW, pxH = 200, 60
+	for round := 0; round < 400; round++ {
+		px := make([]uint8, pxW*pxH)
+		mode := round % 4
+		for i := range px {
+			px[i] = byte(r.Intn(3))
+		}
+		n := 1 + r.Intn(8)
+		var stamps []*Stamp
+		for k := 0; k < n; k++ {
+			s := randStamp(r, pxW, pxH)
+			stamps = append(stamps, s)
+		}
+		// 讓戳記大半相符：把期望像素寫進 px（各種覆蓋順序），再擾動
+		for _, s := range stamps {
+			for j := 0; j < s.H; j++ {
+				for i := 0; i < s.W; i++ {
+					x, y := s.X+i, s.Y+j
+					if x < 0 || y < 0 || x >= pxW || y >= pxH || s.E[j*s.W+i] == Transparent {
+						continue
+					}
+					if mode == 3 && r.Intn(4) == 0 {
+						continue
+					}
+					px[y*pxW+x] = s.E[j*s.W+i]
+				}
+			}
+		}
+		if mode == 1 { // 隨機打洞
+			for i := 0; i < len(px)/20; i++ {
+				px[r.Intn(len(px))] = 9
+			}
+		}
+		for i, s := range stamps {
+			s.Seq = uint64(i + 1)
+		}
+		got := vf.Run(stamps, px, pxW, pxH)
+		want := naiveVerify(stamps, px, pxW, pxH)
+		for k, s := range stamps {
+			for j := 0; j < s.H; j++ {
+				for i := 0; i < s.W; i++ {
+					if got[k].Get(i, j) != want[k][j*s.W+i] {
+						t.Fatalf("round %d mode %d stamp %d (%d,%d) %dx%d：(%d,%d) 位元列 %v 逐像素 %v", round, mode, k, s.X, s.Y, s.W, s.H, i, j, got[k].Get(i, j), want[k][j*s.W+i])
+					}
+				}
+			}
+		}
+	}
+	if vf.Fast+vf.Slow+vf.Empty == 0 {
+		t.Fatal("沒有處理任何戳記")
+	}
+}
+
+// 全相符走快速路徑，全不符為空，部分相符走 3x3。
+func TestVerifyPaths(t *testing.T) {
+	const pxW, pxH = 64, 16
+	px := make([]uint8, pxW*pxH)
+	s := &Stamp{W: 8, H: 4, X: 3, Y: 2, E: make([]byte, 32), Seq: 1}
+	for i := range s.E {
+		s.E[i] = 5
+	}
+	var vf Verifier
+	for j := 0; j < 4; j++ {
+		for i := 0; i < 8; i++ {
+			px[(2+j)*pxW+3+i] = 5
+		}
+	}
+	m := vf.Run([]*Stamp{s}, px, pxW, pxH)
+	if vf.Fast != 1 || m[0].Count() != 32 {
+		t.Fatalf("全相符：Fast=%d count=%d", vf.Fast, m[0].Count())
+	}
+	for i := range px {
+		px[i] = 0
+	}
+	m = vf.Run([]*Stamp{s}, px, pxW, pxH)
+	if vf.Empty != 1 || m[0].Count() != 0 {
+		t.Fatalf("全不符：Empty=%d count=%d", vf.Empty, m[0].Count())
+	}
+	// 一個孤立的相符像素（鄰居都不符）：3x3 否決
+	px[(2+1)*pxW+3+1] = 5
+	m = vf.Run([]*Stamp{s}, px, pxW, pxH)
+	if vf.Slow != 1 || m[0].Count() != 0 {
+		t.Fatalf("孤立相符：Slow=%d count=%d", vf.Slow, m[0].Count())
+	}
+	// 大面積相符、一個角落被蓋：除了角落旁的像素之外都通過
+	for j := 0; j < 4; j++ {
+		for i := 0; i < 8; i++ {
+			px[(2+j)*pxW+3+i] = 5
+		}
+	}
+	px[(2+3)*pxW+3+7] = 9 // 右下角
+	m = vf.Run([]*Stamp{s}, px, pxW, pxH)
+	// 角落本身與其 3 個鄰居（左、上、左上）失去驗證
+	if got := m[0].Count(); got != 32-4 {
+		t.Fatalf("角落被蓋：通過 %d，預期 28", got)
+	}
+	// 蓋住角落的是序號更大且相符的另一個戳記：解釋規則讓鄰居不被否決
+	over := &Stamp{W: 1, H: 1, X: 3 + 7, Y: 2 + 3, E: []byte{9}, Seq: 2}
+	m = vf.Run([]*Stamp{s, over}, px, pxW, pxH)
+	if got := m[0].Count(); got != 31 {
+		t.Fatalf("被後序戳記解釋：通過 %d，預期 31（角落本身不相符）", got)
+	}
+}
+
+func TestQueue(t *testing.T) {
+	const cur = uint32(0x19FB08A2)
+	q := NewQueue(3, cur)
+	mk := func(x int, hash string, site uint32) *Stamp {
+		return &Stamp{X: x, Y: 0, W: 1, H: 1, Hash: hash, Site: site, E: []byte{1}}
+	}
+	q.Add(mk(0, "a", 1))
+	q.Add(mk(0, "a", 1)) // 去重
+	if q.Len() != 1 || q.Replaced != 1 {
+		t.Fatalf("去重：len=%d replaced=%d", q.Len(), q.Replaced)
+	}
+	s1 := mk(5, "c1", cur)
+	q.Add(s1)
+	s2 := mk(9, "c2", cur) // 同呼叫點、不同雜湊與位置：取代
+	q.Add(s2)
+	snap := q.Snapshot()
+	if q.Len() != 2 || snap[1] != s2 {
+		t.Fatalf("singleton：len=%d", q.Len())
+	}
+	q.Add(mk(1, "b", 2))
+	ev := q.Add(mk(2, "d", 3)) // 超過上限 3：丟序號最小的
+	if ev == nil || ev.Hash != "a" || q.Len() != 3 || q.Dropped != 1 {
+		t.Fatalf("LRU：evicted=%v len=%d dropped=%d", ev, q.Len(), q.Dropped)
+	}
+	snap = q.Snapshot()
+	for i := 1; i < len(snap); i++ {
+		if snap[i].Seq <= snap[i-1].Seq {
+			t.Fatal("序號沒有遞增")
+		}
+	}
+	// 被 LRU 丟掉後，singleton 追蹤要跟著清
+	q2 := NewQueue(1, cur)
+	q2.Add(mk(0, "x", cur))
+	q2.Add(mk(1, "y", 7))
+	q2.Add(mk(2, "z", cur))
+	if q2.Len() != 1 {
+		t.Fatalf("len=%d", q2.Len())
+	}
+}
