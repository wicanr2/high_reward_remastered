+package hd
+
+import "math/bits"
+
+// ComposeStats 是最近一次 Compose 的統計（驗收與紀錄用）。
+type ComposeStats struct {
+	Stamps int // 參與合成的戳記數
+	WithHD int // 其中有 HD 圖的
+	Pass   int // 通過驗證的像素總數
+	Fast   int // 快速路徑（全相符）的戳記數
+	Slow   int // 做了 3x3 的戳記數
+	Empty  int // 全不符的戳記數
+}
+
+// Composer 做 docs/spec/004 第 5 節的合成：基底層放大，再把有效戳記通過驗證的像素換成 HD。
+// 內部緩衝區重複使用，不可同時由多個執行緒使用。
+type Composer struct {
+	S     int
+	A     *Assets
+	Stats ComposeStats
+
+	vf   Verifier
+	accA []uint8
+	f4   []uint64
+}
+
+// NewComposer 建立合成器；a 可為 nil（只做基底層放大，戳記照樣遮蔽但沒有 HD 可畫）。
+func NewComposer(a *Assets, s int) *Composer {
+	if s < 1 {
+		s = 1
+	}
+	return &Composer{S: s, A: a}
+}
+
+// OutSize 回傳輸出的寬高。
+func (c *Composer) OutSize(pxW, pxH int) (int, int) { return pxW * c.S, pxH * c.S }
+
+// fadeTab 是 5.4 的縮放係數。
+type fadeTab struct {
+	k     [16][3]float32
+	ident bool
+}
+
+// makeFade 依第 5.4 節：R 是參考調色盤，N 是目前的顯示色（DAC[Map[i]]）。
+// R[i][c] ≥ 16 的通道用 N÷R；否則用整體比例 g[c]（該通道的 ΣR 為 0 時取三通道合計的比，合計也為 0 才取 1）。
+func makeFade(R, N *[16][3]uint8) fadeTab {
+	var ft fadeTab
+	ident := true
+	var sumR, sumN [3]int
+	var totR, totN int
+	for i := 0; i < 16; i++ {
+		for ch := 0; ch < 3; ch++ {
+			sumR[ch] += int(R[i][ch])
+			sumN[ch] += int(N[i][ch])
+			if R[i][ch] != N[i][ch] {
+				ident = false
+			}
+		}
+	}
+	if ident {
+		for i := range ft.k {
+			ft.k[i] = [3]float32{1, 1, 1}
+		}
+		ft.ident = true
+		return ft
+	}
+	for ch := 0; ch < 3; ch++ {
+		totR += sumR[ch]
+		totN += sumN[ch]
+	}
+	var g [3]float32
+	for ch := 0; ch < 3; ch++ {
+		switch {
+		case sumR[ch] > 0:
+			g[ch] = float32(sumN[ch]) / float32(sumR[ch])
+		case totR > 0:
+			g[ch] = float32(totN) / float32(totR)
+		default:
+			g[ch] = 1
+		}
+	}
+	for i := 0; i < 16; i++ {
+		for ch := 0; ch < 3; ch++ {
+			if R[i][ch] >= 16 {
+				ft.k[i][ch] = float32(N[i][ch]) / float32(R[i][ch])
+			} else {
+				ft.k[i][ch] = g[ch]
+			}
+		}
+	}
+	return ft
+}
+
+func (ft *fadeTab) scale(idx byte, v uint8, ch int) uint8 {
+	if ft.ident {
+		return v
+	}
+	x := float32(v)*ft.k[idx&15][ch] + 0.5
+	switch {
+	case x <= 0:
+		return 0
+	case x >= 255:
+		return 255
+	}
+	return uint8(x)
+}
+
+// Compose 把 px（pxW×pxH，值 0 至 15）依 mp 與 dac 轉成 RGBA 並整數倍放大，寫進 dst
+// （長度至少 pxW*S*pxH*S*4），再疊上 stamps（依序號遞增）。
+func (c *Composer) Compose(dst []byte, px []uint8, pxW, pxH int, mp [16]uint8, dac *[256][3]uint8, stamps []*Stamp) {
+	S := c.S
+	ow, oh := pxW*S, pxH*S
+	var base [16][3]uint8
+	for p := range base {
+		base[p] = dac[mp[p]]
+	}
+	// 基底層
+	for y := 0; y < pxH; y++ {
+		row := dst[(y*S)*ow*4 : (y*S+1)*ow*4]
+		for x := 0; x < pxW; x++ {
+			col := base[px[y*pxW+x]&15]
+			for u := 0; u < S; u++ {
+				o := (x*S + u) * 4
+				row[o], row[o+1], row[o+2], row[o+3] = col[0], col[1], col[2], 0xFF
+			}
+		}
+		for v := 1; v < S; v++ {
+			copy(dst[(y*S+v)*ow*4:(y*S+v+1)*ow*4], row)
+		}
+	}
+	c.Stats = ComposeStats{}
+	if len(stamps) == 0 {
+		return
+	}
+	vs := c.vf.Run(stamps, px, pxW, pxH)
+	c.Stats.Stamps = len(stamps)
+	c.Stats.Fast, c.Stats.Slow, c.Stats.Empty = c.vf.Fast, c.vf.Slow, c.vf.Empty
+	if cap(c.accA) < ow*oh {
+		c.accA = make([]uint8, ow*oh)
+	}
+	c.accA = c.accA[:ow*oh]
+	for i := range c.accA {
+		c.accA[i] = 0
+	}
+	tabs := map[*[16][3]uint8]*fadeTab{}
+	for i := len(stamps) - 1; i >= 0; i-- {
+		s, v := stamps[i], vs[i]
+		if v.Count() == 0 {
+			continue
+		}
+		var as *Asset
+		if c.A != nil {
+			as = c.A.Get(s.Hash)
+		}
+		if as != nil {
+			c.Stats.WithHD++
+		}
+		var ft *fadeTab
+		if as != nil {
+			ft = tabs[as.Pal]
+			if ft == nil {
+				t := makeFade(as.Pal, &base)
+				ft = &t
+				tabs[as.Pal] = ft
+			}
+		}
+		c.drawStamp(dst, px, pxW, pxH, &base, s, v, as, ft)
+	}
+}
+
+func (c *Composer) drawStamp(dst []byte, px []uint8, pxW, pxH int, base *[16][3]uint8, s *Stamp, v Mask, as *Asset, ft *fadeTab) {
+	S := c.S
+	ow := pxW * S
+	w, h, st := s.W, s.H, v.Stride
+	if as == nil {
+		// 沒有 HD：通過驗證的像素遮蔽序號較小的 HD（顯示基底層）
+		for j := 0; j < h; j++ {
+			for k := 0; k < st; k++ {
+				word := v.Bits[j*st+k]
+				for word != 0 {
+					i := k*64 + bits.TrailingZeros64(word)
+					word &= word - 1
+					c.Stats.Pass++
+					for dv := 0; dv < S; dv++ {
+						o := ((s.Y+j)*S+dv)*ow + (s.X+i)*S
+						for du := 0; du < S; du++ {
+							c.accA[o+du] = 255
+						}
+					}
+				}
+			}
+		}
+		return
+	}
+	img := as.Img
+	stride := img.Stride
+	pix := img.Pix
+	// 羽化候選：V 的四鄰擴張（只留透明像素）
+	need := st * h
+	if cap(c.f4) < need {
+		c.f4 = make([]uint64, need)
+	}
+	f4 := c.f4[:need]
+	for j := 0; j < h; j++ {
+		for k := 0; k < st; k++ {
+			x := v.Bits[j*st+k]
+			d := x<<1 | x>>1
+			if k > 0 {
+				d |= v.Bits[j*st+k-1] >> 63
+			}
+			if k+1 < st {
+				d |= v.Bits[j*st+k+1] << 63
+			}
+			if j > 0 {
+				d |= v.Bits[(j-1)*st+k]
+			}
+			if j+1 < h {
+				d |= v.Bits[(j+1)*st+k]
+			}
+			f4[j*st+k] = d &^ x
+		}
+	}
+	for j := 0; j < h; j++ {
+		for k := 0; k < st; k++ {
+			word := v.Bits[j*st+k] | f4[j*st+k]
+			for word != 0 {
+				i := k*64 + bits.TrailingZeros64(word)
+				word &= word - 1
+				if i >= w {
+					break
+				}
+				var idx byte
+				if v.Get(i, j) {
+					idx = s.E[j*w+i]
+					c.Stats.Pass++
+				} else {
+					// 羽化區：必須是透明像素，且取四鄰中通過驗證的不透明像素的索引（左、右、上、下）
+					if s.E[j*w+i] != Transparent {
+						continue
+					}
+					x, y := s.X+i, s.Y+j
+					if x < 0 || y < 0 || x >= pxW || y >= pxH {
+						continue
+					}
+					switch {
+					case v.Get(i-1, j):
+						idx = s.E[j*w+i-1]
+					case v.Get(i+1, j):
+						idx = s.E[j*w+i+1]
+					case v.Get(i, j-1):
+						idx = s.E[(j-1)*w+i]
+					case v.Get(i, j+1):
+						idx = s.E[(j+1)*w+i]
+					default:
+						continue
+					}
+				}
+				for dv := 0; dv < S; dv++ {
+					po := (S*j+dv)*stride + S*i*4
+					oy := (s.Y+j)*S + dv
+					for du := 0; du < S; du++ {
+						a := pix[po+du*4+3]
+						if a == 0 {
+							continue
+						}
+						ox := (s.X+i)*S + du
+						col := [3]uint8{pix[po+du*4], pix[po+du*4+1], pix[po+du*4+2]}
+						if !ft.ident {
+							for ch := 0; ch < 3; ch++ {
+								col[ch] = ft.scale(idx, col[ch], ch)
+							}
+						}
+						c.blend(dst, oy*ow+ox, col, a, base[px[((s.Y+j)*pxW)+s.X+i]&15])
+					}
+				}
+			}
+		}
+	}
+}
+
+// blend 做由前往後的 over 混合（第 5.3 第 5 步）：dst 在這裡是「已累積的前景 ＋ 基底 × 剩餘穿透率」，
+// 加入一層 (col, a) 後 dst += T × a × (col − base)，T 是剩餘穿透率，accA 累積不透明度。
+func (c *Composer) blend(dst []byte, p int, col [3]uint8, a uint8, base [3]uint8) {
+	t := 255 - int(c.accA[p])
+	if t == 0 {
+		return
+	}
+	f := int(a) * t
+	d := dst[p*4 : p*4+3]
+	for ch := 0; ch < 3; ch++ {
+		num := (int(col[ch]) - int(base[ch])) * f
+		var delta int
+		if num >= 0 {
+			delta = (num + 32512) / 65025
+		} else {
+			delta = -((-num + 32512) / 65025)
+		}
+		v := int(d[ch]) + delta
+		if v < 0 {
+			v = 0
+		} else if v > 255 {
+			v = 255
+		}
+		d[ch] = uint8(v)
+	}
+	c.accA[p] = uint8(int(c.accA[p]) + (f+127)/255)
+}
