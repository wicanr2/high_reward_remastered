+package hd
+
+import (
+	"fmt"
+	"image"
+	"image/png"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func testPalette() *[16][3]uint8 {
+	var p [16][3]uint8
+	for i := range p {
+		p[i] = [3]uint8{uint8(i*16 + 16), uint8(255 - i*16), uint8(i * 8)}
+	}
+	return &p
+}
+
+func identityMap() (mp [16]uint8, dac [256][3]uint8) {
+	p := testPalette()
+	for i := 0; i < 16; i++ {
+		mp[i] = uint8(i)
+		dac[i] = p[i]
+	}
+	return
+}
+
+func solidAsset(w, h, S int, r, g, b, a uint8, pal *[16][3]uint8) *Asset {
+	im := image.NewNRGBA(image.Rect(0, 0, w*S, h*S))
+	for i := 0; i < len(im.Pix); i += 4 {
+		im.Pix[i], im.Pix[i+1], im.Pix[i+2], im.Pix[i+3] = r, g, b, a
+	}
+	return &Asset{Img: im, Pal: pal}
+}
+
+func TestComposeBase(t *testing.T) {
+	mp, dac := identityMap()
+	px := []uint8{0, 1, 2, 3, 4, 5}
+	c := NewComposer(nil, 2)
+	dst := make([]byte, 3*2*2*2*4)
+	c.Compose(dst, px, 3, 2, mp, &dac, nil)
+	for y := 0; y < 4; y++ {
+		for x := 0; x < 6; x++ {
+			p := px[(y/2)*3+x/2]
+			o := (y*6 + x) * 4
+			if dst[o] != dac[p][0] || dst[o+1] != dac[p][1] || dst[o+2] != dac[p][2] || dst[o+3] != 255 {
+				t.Fatalf("(%d,%d) 基底色錯誤", x, y)
+			}
+		}
+	}
+}
+
+// 沒有 HD 的戳記遮蔽序號較小的 HD；有 HD 的戳記在通過驗證的像素畫 HD；不符的像素維持基底層。
+func TestComposeStamps(t *testing.T) {
+	mp, dac := identityMap()
+	const W, H, S = 8, 4, 2
+	px := make([]uint8, W*H)
+	for i := range px {
+		px[i] = 1
+	}
+	pal := testPalette()
+	lo := &Stamp{Kind: KindSprite, X: 0, Y: 0, W: 4, H: 4, Hash: "lo", E: filled(16, 1), Seq: 1}
+	hi := &Stamp{Kind: KindSprite, X: 2, Y: 0, W: 4, H: 4, Hash: "hi", E: filled(16, 1), Seq: 2} // 與 lo 重疊 x=2..3，hi 沒有 HD
+	a := &Assets{S: S, cache: map[string]*Asset{"lo": solidAsset(4, 4, S, 200, 10, 10, 255, pal), "hi": nil}}
+	c := NewComposer(a, S)
+	dst := make([]byte, W*S*H*S*4)
+	c.Compose(dst, px, W, H, mp, &dac, []*Stamp{lo, hi})
+	at := func(x, y int) [3]uint8 { o := (y*W*S + x) * 4; return [3]uint8{dst[o], dst[o+1], dst[o+2]} }
+	// lo 獨有的 x=0..1（HD 座標 0..3）畫 HD；與 hi 重疊的 x=2..3（HD 座標 4..7）被 hi 遮蔽成基底層
+	if at(0, 0) != [3]uint8{200, 10, 10} || at(3, 3) != [3]uint8{200, 10, 10} {
+		t.Fatalf("lo 獨有區沒畫 HD：%v %v", at(0, 0), at(3, 3))
+	}
+	if at(4, 0) != dac[1] || at(7, 7) != dac[1] {
+		t.Fatalf("重疊區沒有被無 HD 的 hi 遮蔽：%v %v", at(4, 0), at(7, 7))
+	}
+	// 蓋住（不相符）：lo 的一部分被 VRAM 改成別的顏色，且 3x3 鄰域否決
+	px[0], px[1], px[W], px[W+1] = 9, 9, 9, 9
+	c.Compose(dst, px, W, H, mp, &dac, []*Stamp{lo})
+	if at(0, 0) == [3]uint8{200, 10, 10} {
+		t.Fatal("不相符的像素不應畫 HD")
+	}
+}
+
+func filled(n int, v byte) []byte {
+	b := make([]byte, n)
+	for i := range b {
+		b[i] = v
+	}
+	return b
+}
+
+// 由大到小的前往後混合與「序號由小到大逐一覆蓋」逐像素等價（容許取整誤差，第 5.3 第 5 步）。
+func TestComposeFrontToBackEqualsPainter(t *testing.T) {
+	r := rand.New(rand.NewSource(3))
+	mp, dac := identityMap()
+	const W, H, S = 40, 30, 2
+	pal := testPalette()
+	worst := 0
+	for round := 0; round < 150; round++ {
+		px := make([]uint8, W*H)
+		var stamps []*Stamp
+		cache := map[string]*Asset{}
+		n := 1 + r.Intn(7)
+		for k := 0; k < n; k++ {
+			w, h := 4+r.Intn(14), 4+r.Intn(10)
+			s := &Stamp{Kind: KindSprite, X: r.Intn(W-w+4) - 2, Y: r.Intn(H-h+4) - 2, W: w, H: h, Hash: fmt.Sprint("h", k), E: make([]byte, w*h), Seq: uint64(k + 1)}
+			for i := range s.E {
+				if r.Intn(6) == 0 {
+					s.E[i] = Transparent
+				} else {
+					s.E[i] = byte(r.Intn(4))
+				}
+			}
+			stamps = append(stamps, s)
+			if r.Intn(3) != 0 { // 三分之一沒有 HD
+				as := solidAsset(w, h, S, uint8(r.Intn(256)), uint8(r.Intn(256)), uint8(r.Intn(256)), 255, pal)
+				for i := 3; i < len(as.Img.Pix); i += 4 { // 羽化區與部分透明
+					if r.Intn(5) == 0 {
+						as.Img.Pix[i] = uint8(r.Intn(256))
+					}
+				}
+				cache[s.Hash] = as
+			} else {
+				cache[s.Hash] = nil
+			}
+		}
+		for _, s := range stamps { // 畫進 px，使多數相符
+			for j := 0; j < s.H; j++ {
+				for i := 0; i < s.W; i++ {
+					x, y := s.X+i, s.Y+j
+					if x >= 0 && y >= 0 && x < W && y < H && s.E[j*s.W+i] != Transparent && r.Intn(8) != 0 {
+						px[y*W+x] = s.E[j*s.W+i]
+					}
+				}
+			}
+		}
+		a := &Assets{S: S, cache: cache}
+		c := NewComposer(a, S)
+		got := make([]byte, W*S*H*S*4)
+		c.Compose(got, px, W, H, mp, &dac, stamps)
+		want := painter(a, px, W, H, S, mp, &dac, stamps)
+		for i := range got {
+			d := int(got[i]) - int(want[i])
+			if d < 0 {
+				d = -d
+			}
+			if d > worst {
+				worst = d
+			}
+			if d > 2 {
+				t.Fatalf("round %d：位元組 %d 前往後 %d、逐一覆蓋 %d", round, i, got[i], want[i])
+			}
+		}
+	}
+	t.Logf("最大差 %d", worst)
+}
+
+// painter 是序號由小到大逐一覆蓋的參考實作（用 Verifier 求 V，與 Compose 同一個 V）。
+func painter(a *Assets, px []uint8, W, H, S int, mp [16]uint8, dac *[256][3]uint8, stamps []*Stamp) []byte {
+	var base [16][3]uint8
+	for p := range base {
+		base[p] = dac[mp[p]]
+	}
+	out := make([]float64, W*S*H*S*3)
+	for y := 0; y < H*S; y++ {
+		for x := 0; x < W*S; x++ {
+			c := base[px[(y/S)*W+x/S]&15]
+			for ch := 0; ch < 3; ch++ {
+				out[(y*W*S+x)*3+ch] = float64(c[ch])
+			}
+		}
+	}
+	var vf Verifier
+	vs := vf.Run(stamps, px, W, H)
+	for k, s := range stamps {
+		v := vs[k]
+		as := a.cache[s.Hash]
+		for j := 0; j < s.H; j++ {
+			for i := 0; i < s.W; i++ {
+				var inV bool = v.Get(i, j)
+				var idxPix = -1
+				if inV {
+					idxPix = int(s.E[j*s.W+i])
+				} else if s.E[j*s.W+i] == Transparent {
+					x, y := s.X+i, s.Y+j
+					if x < 0 || y < 0 || x >= W || y >= H || as == nil {
+						continue
+					}
+					for _, d := range [][2]int{{-1, 0}, {1, 0}, {0, -1}, {0, 1}} {
+						if v.Get(i+d[0], j+d[1]) {
+							idxPix = int(s.E[(j+d[1])*s.W+i+d[0]])
+							break
+						}
+					}
+				}
+				if idxPix < 0 {
+					continue
+				}
+				for dv := 0; dv < S; dv++ {
+					for du := 0; du < S; du++ {
+						o := (((s.Y+j)*S+dv)*W*S + (s.X+i)*S + du) * 3
+						if as == nil {
+							b := base[px[(s.Y+j)*W+s.X+i]&15]
+							for ch := 0; ch < 3; ch++ {
+								out[o+ch] = float64(b[ch])
+							}
+							continue
+						}
+						p := as.Img.Pix[(S*j+dv)*as.Img.Stride+(S*i+du)*4:]
+						al := float64(p[3]) / 255
+						for ch := 0; ch < 3; ch++ {
+							out[o+ch] = out[o+ch]*(1-al) + float64(p[ch])*al
+						}
+					}
+				}
+			}
+		}
+	}
+	res := make([]byte, W*S*H*S*4)
+	for i := 0; i < W*S*H*S; i++ {
+		for ch := 0; ch < 3; ch++ {
+			res[i*4+ch] = uint8(out[i*3+ch] + 0.5)
+		}
+		res[i*4+3] = 255
+	}
+	return res
+}
+
+func TestFade(t *testing.T) {
+	R := testPalette()
+	// 等於參考：恆等
+	ft := makeFade(R, R)
+	if !ft.ident {
+		t.Fatal("DAC 等於參考時應為恆等")
+	}
+	// DAC 全 0：任何顏色輸出皆 0
+	var zero [16][3]uint8
+	ft = makeFade(R, &zero)
+	for i := 0; i < 16; i++ {
+		for ch := 0; ch < 3; ch++ {
+			for _, v := range []uint8{0, 1, 77, 128, 255} {
+				if o := ft.scale(byte(i), v, ch); o != 0 {
+					t.Fatalf("DAC 全 0：索引 %d 通道 %d 值 %d 輸出 %d", i, ch, v, o)
+				}
+			}
+		}
+	}
+	// R 有全 0 的通道：g 改取三通道合計的比，DAC 全 0 時仍輸出 0
+	R2 := *R
+	for i := range R2 {
+		R2[i][2] = 0
+	}
+	ft = makeFade(&R2, &zero)
+	for i := 0; i < 16; i++ {
+		if o := ft.scale(byte(i), 200, 2); o != 0 {
+			t.Fatalf("藍色通道全 0 的參考調色盤、DAC 全 0：輸出 %d", o)
+		}
+	}
+	// 一半亮度：R≥16 的通道乘 N/R，R<16 的通道乘整體比例
+	var half [16][3]uint8
+	for i := range half {
+		for ch := 0; ch < 3; ch++ {
+			half[i][ch] = R[i][ch] / 2
+		}
+	}
+	ft = makeFade(R, &half)
+	if o := ft.scale(15, 200, 1); o < 95 || o > 105 { // R[15][1] = 15 → 小於 16，用 g≈0.5
+		t.Fatalf("g 縮放：%d", o)
+	}
+	if o := ft.scale(2, 200, 0); o < 95 || o > 105 { // R[2][0] = 48，N/R = 24/48
+		t.Fatalf("N/R 縮放：%d", o)
+	}
+}
+
+func TestLoadAssets(t *testing.T) {
+	dir := t.TempDir()
+	hash := strings.Repeat("a", 64)
+	hash2 := strings.Repeat("b", 64)
+	os.MkdirAll(filepath.Join(dir, "x2", "MRG"), 0o755)
+	os.WriteFile(filepath.Join(dir, "catalog.tsv"), []byte("hash\tid\tw\th\tkind\tpal\thd\tsingleton\n"+
+		hash+"\tA:0\t4\t2\tsprite\tMAIN\tMRG/a.png\t\n"+
+		hash2+"\tA:1\t4\t2\tsprite\tMAIN\tMRG/b.png\t\n"), 0o644)
+	os.WriteFile(filepath.Join(dir, "palettes.tsv"), []byte("name\tpalette16\nMAIN\t000000 000001 000002 000003 000004 000005 000006 000007 000008 000009 00000A 00000B 00000C 00000D 00000E FFFFFF\n"), 0o644)
+	write := func(name string, w, h int) {
+		f, _ := os.Create(filepath.Join(dir, "x2", name))
+		png.Encode(f, image.NewNRGBA(image.Rect(0, 0, w, h)))
+		f.Close()
+	}
+	write("MRG/a.png", 8, 4)
+	write("MRG/b.png", 7, 4) // 尺寸不符
+	a, err := LoadAssets(dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a.Lookup(hash) == nil || a.Lookup(strings.Repeat("c", 64)) != nil {
+		t.Fatal("Lookup 結果不對")
+	}
+	if as := a.Get(hash); as == nil || as.Img.Bounds().Dx() != 8 || as.Pal[15] != [3]uint8{255, 255, 255} {
+		t.Fatalf("Get a：%+v", as)
+	}
+	if a.Get(hash2) != nil || len(a.Errors) != 1 || !strings.Contains(a.Errors[0], "清冊要求 8x4") {
+		t.Fatalf("尺寸不符應拒絕並記錄：%v", a.Errors)
+	}
+	if a.Get(hash2) != nil || len(a.Errors) != 1 {
+		t.Fatal("同一個雜湊的失敗只記一次")
+	}
+	if a.Get(strings.Repeat("c", 64)) != nil {
+		t.Fatal("不在清冊的雜湊不該有 HD")
+	}
+	// 清冊缺檔
+	if _, err := LoadAssets(filepath.Join(dir, "nope"), 2); err == nil {
+		t.Fatal("缺清冊應回錯誤")
+	}
+}
