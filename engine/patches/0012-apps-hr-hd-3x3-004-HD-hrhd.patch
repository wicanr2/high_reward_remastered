@@ -0,0 +1,97 @@
+package runtime
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+)
+
+// 冷啟動到新遊戲（docs/re/008 的收據路徑）：90,000,000 步，35,000,000 步時點「新遊戲」。
+func coldNewGame(t *testing.T, opt Options) *Session {
+	t.Helper()
+	opt.Interval = NativeInterval
+	s, err := Open(origRoot(t), opt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st := s.RunSteps(35_000_000); st.Kind != StopSteps {
+		t.Fatal(st.Msg)
+	}
+	s.Input(MouseButtonEvent(312, 211-40, 0, true))
+	s.Input(MouseButtonEvent(312, 211-40, 0, false))
+	if st := s.RunSteps(90_000_000); st.Kind != StopSteps {
+		t.Fatal(st.Msg)
+	}
+	return s
+}
+
+// docs/spec/004 第 7 節「不改變遊戲」：掛鉤開與關，同一輸入下畫面與 CPU 狀態逐位元相同。
+func TestHDHooksDoNotChangeTheGame(t *testing.T) {
+	if testing.Short() {
+		t.Skip("-short")
+	}
+	off := coldNewGame(t, Options{})
+	on := coldNewGame(t, Options{HDHooks: true})
+	if on.Overlay() == nil || off.Overlay() != nil {
+		t.Fatal("Overlay() 與 HDHooks 不一致")
+	}
+	if a, b := pngHash(t, off), pngHash(t, on); a != b {
+		t.Fatalf("畫面不同：關 %s，開 %s", a, b)
+	}
+	a, b := off.Machine(), on.Machine()
+	if a.Steps != b.Steps || a.CPU.IP != b.CPU.IP || a.CPU.Seg != b.CPU.Seg || a.CPU.R != b.CPU.R || !bytes.Equal(a.Mem, b.Mem) {
+		t.Fatal("CPU 狀態不同")
+	}
+	if on.Overlay().Stats.Created == 0 {
+		t.Fatal("掛鉤開著卻沒有建立任何戳記")
+	}
+}
+
+// 識別率與返回時相符比例：清冊用 HR_HD（含 catalog.tsv 與 palettes.tsv 的目錄）；沒有就 skip。
+func TestHDHooksColdStartIdentification(t *testing.T) {
+	if testing.Short() {
+		t.Skip("-short")
+	}
+	dir := os.Getenv("HR_HD")
+	if dir == "" {
+		dir = "/orig/hd-stage" // 容器內 workplace 的掛載點（tools/dosgolem.sh）
+	}
+	if _, err := os.Stat(filepath.Join(dir, "catalog.tsv")); err != nil {
+		t.Skipf("沒有清冊：%v", err)
+	}
+	a, err := hd.LoadAssets(dir, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := coldNewGame(t, Options{HDHooks: true, HDAssets: a, HDRecord: true, HDCheck: 2})
+	ov := s.Overlay()
+	st := ov.Stats
+	if st.DecodeErr != 0 || st.Interrupt != 0 {
+		t.Fatalf("解碼失敗 %d、返回對不上 %d", st.DecodeErr, st.Interrupt)
+	}
+	for _, u := range ov.UnknownList() {
+		if u.Site != hd.CursorSite {
+			t.Errorf("未識別且不是游標：%s %s %dx%d 呼叫點 %04X:%04X", u.Hash[:12], u.Kind, u.W, u.H, u.Site>>16, u.Site&0xFFFF)
+		}
+	}
+	cur := 0
+	for _, sp := range ov.Snapshot() {
+		if sp.Site == hd.CursorSite {
+			cur++
+		}
+	}
+	if cur != 1 {
+		t.Errorf("佇列中的游標戳記 %d 個，預期 1", cur)
+	}
+	for _, m := range ov.MatchList() {
+		if m.Samples > 0 && m.MinRatio < 0.99 {
+			t.Errorf("雜湊 %s 返回時只有 %.3f 與 VRAM 相符", m.Hash[:12], m.MinRatio)
+		}
+	}
+	if st.Identified == 0 {
+		t.Error("沒有任何識別")
+	}
+}
diff --git a/apps/hr/runtime/ratelimit.go b/apps/hr/runtime/ratelimit.go
new file mode 100644
index 0000000..a9ba316
--- /dev/null
+++ b/apps/hr/runtime/ratelimit.go
@@ -0,0 +1,26 @@
+package runtime
+
+import "time"
+
+// FrameLimiter 限制前端呼叫 RequestFrame 的頻率（docs/spec/004 第 5.1 節：至多 60 Hz）。
+// 前端的繪製率可能高於 60 Hz（關閉垂直同步、高更新率螢幕），每次繪製都要求快照會讓模擬 goroutine
+// 白白轉換畫面。不可同時由多個執行緒使用；時鐘由呼叫者傳入，測試用假時鐘。
+type FrameLimiter struct {
+	Min  time.Duration // 兩次要求的最短間隔；0 ＝ 16 ms
+	last time.Time
+	n    uint64
+}
+
+// Allow 回傳這一刻是否可以呼叫 RequestFrame；回傳 true 時記下這一刻。
+func (l *FrameLimiter) Allow(now time.Time) bool {
+	min := l.Min
+	if min <= 0 {
+		min = 16 * time.Millisecond
+	}
+	if l.n > 0 && now.Sub(l.last) < min {
+		return false
+	}
+	l.last = now
+	l.n++
+	return true
+}
