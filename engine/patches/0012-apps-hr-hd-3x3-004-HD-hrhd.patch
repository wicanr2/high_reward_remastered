diff --git a/apps/hr/cmd/hrhd/main.go b/apps/hr/cmd/hrhd/main.go
new file mode 100644
index 0000000..84e4cc5
--- /dev/null
+++ b/apps/hr/cmd/hrhd/main.go
@@ -0,0 +1,173 @@
+// Command hrhd 是 HD 疊層（hr 專案的 docs/spec/004）的無頭驗收工具：
+// 跑執行層（含進入點掛鉤），回報識別率、返回時與 VRAM 的相符比例、戳記佇列與合成時間，並可輸出合成後的 PNG。
+// 不開視窗。⚠ 本專案不含任何原版檔案，-orig 由玩家自備；輸出 PNG 是原版美術的衍生物，只放 workplace/。
+package main
+
+import (
+	"flag"
+	"fmt"
+	"image"
+	"image/png"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+	"github.com/wicanr2/dosgolem/internal/state"
+)
+
+type clickList []string
+
+func (c *clickList) String() string     { return strings.Join(*c, ",") }
+func (c *clickList) Set(v string) error { *c = append(*c, v); return nil }
+
+func main() {
+	orig := flag.String("orig", "original", "原版檔案目錄（內含 MAIN.EXE）")
+	hdDir := flag.String("hd", "", "HD 目錄（含 catalog.tsv、palettes.tsv、x2/）；空 ＝ 不載入清冊（不統計識別率）")
+	stateFile := flag.String("state", "", "先載入的狀態檔（dosgolem 狀態，例如 explore 輸出的節點）")
+	steps := flag.Uint64("steps", 90_000_000, "從目前步數起再跑幾步（冷啟動時就是絕對步數）")
+	check := flag.Int("check", 3, "每個雜湊的前 N 次出現量一次返回時的相符比例（0 ＝ 不量）")
+	record := flag.Bool("record", true, "收集未識別的雜湊")
+	out := flag.String("png", "", "輸出合成後的 PNG（HD 解析度）")
+	nohd := flag.Bool("nohd", false, "不載入 HD 圖（只放大基底層；戳記照樣遮蔽）")
+	native := flag.Bool("native", true, "使用 dosgolem 預設計時器間隔；false ＝ play 預設")
+	hooks := flag.Bool("hooks", true, "開啟掛鉤")
+	var clicks clickList
+	flag.Var(&clicks, "click", "在『相對步數』按下並放開左鍵：`步數:X:Y`（X、Y 是 640x480 畫面座標），可重複")
+	flag.Parse()
+
+	var assets *hd.Assets
+	if *hdDir != "" {
+		var err error
+		if assets, err = hd.LoadAssets(*hdDir, 2); err != nil {
+			fmt.Fprintln(os.Stderr, "載入清冊失敗：", err)
+			os.Exit(2)
+		}
+	}
+	opt := hrrt.Options{Interval: hrrt.NativeInterval, HDHooks: *hooks, HDAssets: assets, HDCheck: *check, HDRecord: *record,
+		Log: func(f string, a ...any) { fmt.Fprintf(os.Stderr, f+"\n", a...) }}
+	if !*native {
+		opt.Interval = 0
+	}
+	s, err := hrrt.Open(*orig, opt)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	if *stateFile != "" {
+		if err := state.Load(*stateFile, s.Machine(), s.DOS()); err != nil {
+			fmt.Fprintln(os.Stderr, "載入狀態失敗：", err)
+			os.Exit(2)
+		}
+	}
+	start := s.Machine().Steps
+	target := start + *steps
+	type ck struct {
+		at   uint64
+		x, y int
+	}
+	var cks []ck
+	for _, c := range clicks {
+		var at uint64
+		var x, y int
+		if _, err := fmt.Sscanf(c, "%d:%d:%d", &at, &x, &y); err != nil {
+			fmt.Fprintln(os.Stderr, "-click 要寫成 步數:X:Y：", err)
+			os.Exit(2)
+		}
+		cks = append(cks, ck{start + at, x, y})
+	}
+	t0 := time.Now()
+	for _, c := range cks {
+		if st := s.RunSteps(c.at); st.Kind != hrrt.StopSteps {
+			fmt.Fprintln(os.Stderr, "提前停機：", st.Msg)
+			os.Exit(1)
+		}
+		s.Input(hrrt.MouseButtonEvent(c.x, c.y-40, 0, true))
+		s.Input(hrrt.MouseButtonEvent(c.x, c.y-40, 0, false))
+	}
+	if st := s.RunSteps(target); st.Kind != hrrt.StopSteps {
+		fmt.Fprintln(os.Stderr, "提前停機：", st.Msg)
+		os.Exit(1)
+	}
+	el := time.Since(t0)
+	// 取一個快照（輪詢點）
+	var seq uint64
+	if f := s.Frame(); f != nil {
+		seq = f.Seq
+	}
+	s.RequestFrame()
+	for i := 0; i < 100; i++ {
+		if f := s.Frame(); f != nil && f.Seq != seq {
+			break
+		}
+		s.RunSteps(s.Machine().Steps + 50_000)
+	}
+	f := s.Frame()
+	fmt.Printf("步數 %d（本次 %d），耗時 %.1fs（%.1f M步/s）\n", s.Machine().Steps, s.Machine().Steps-start, el.Seconds(), float64(s.Machine().Steps-start)/1e6/el.Seconds())
+	ov := s.Overlay()
+	if ov == nil {
+		return
+	}
+	st := ov.Stats
+	fmt.Printf("進入：%v，建立 %d，解碼失敗 %d，略過 %d，返回對不上 %d，已識別 %d，未識別 %d，佇列 %d（取代 %d，LRU 丟 %d）\n",
+		st.Entered, st.Created, st.DecodeErr, st.Skipped, st.Interrupt, st.Identified, st.Unknown, ov.Q.Len(), ov.Q.Replaced, ov.Q.Dropped)
+	if *check > 0 {
+		fmt.Println("# 返回時相符比例（hash12 id 大小 次數 取樣 首次 最低）")
+		for _, m := range ov.MatchList() {
+			id := ""
+			if e := assets.Lookup(m.Hash); e != nil {
+				id = e.ID
+			}
+			ratio := 0.0
+			if m.Opaque > 0 {
+				ratio = float64(m.Matched) / float64(m.Opaque)
+			}
+			fmt.Printf("%s\t%s\tn=%d\tsamples=%d\tfirst=%.3f\tmin=%.3f\tavg=%.3f\n", m.Hash[:12], id, m.N, m.Samples, m.FirstRatio, m.MinRatio, ratio)
+		}
+	}
+	if *record {
+		fmt.Println("# 未識別（hash12 種類 大小 次數 呼叫點 第一次位置）")
+		for _, u := range ov.UnknownList() {
+			fmt.Printf("%s\t%s\t%dx%d\tn=%d\t%04X:%04X\t(%d,%d)\n", u.Hash[:12], u.Kind, u.W, u.H, u.Count, u.Site>>16, u.Site&0xFFFF, u.X, u.Y)
+		}
+	}
+	if assets != nil && len(assets.Errors) > 0 {
+		fmt.Println("# 清冊錯誤：")
+		for _, e := range assets.Errors {
+			fmt.Println(e)
+		}
+	}
+	if f == nil {
+		fmt.Println("沒有快照")
+		return
+	}
+	var ca *hd.Assets
+	if !*nohd {
+		ca = assets
+	}
+	cmp := hd.NewComposer(ca, 2)
+	ow, oh := cmp.OutSize(f.W, f.H)
+	dst := make([]byte, ow*oh*4)
+	cmp.Compose(dst, f.Px, f.W, f.H, f.Map, &f.DAC, f.Stamps) // 暖機：PNG 解碼只算一次
+	t1 := time.Now()
+	const rounds = 20
+	for i := 0; i < rounds; i++ {
+		cmp.Compose(dst, f.Px, f.W, f.H, f.Map, &f.DAC, f.Stamps)
+	}
+	fmt.Printf("快照：戳記 %d，合成 %.2f ms/幀（含基底；暖機後 %d 輪平均）；統計 %+v\n", len(f.Stamps), float64(time.Since(t1).Microseconds())/1000/rounds, rounds, cmp.Stats)
+	if *out != "" {
+		img := &image.RGBA{Pix: dst, Stride: ow * 4, Rect: image.Rect(0, 0, ow, oh)}
+		fh, err := os.Create(*out)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		defer fh.Close()
+		if err := png.Encode(fh, img); err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		fmt.Println("輸出", *out)
+	}
+}
diff --git a/apps/hr/hd/assets.go b/apps/hr/hd/assets.go
new file mode 100644
index 0000000..2e35fff
--- /dev/null
+++ b/apps/hr/hd/assets.go
@@ -0,0 +1,207 @@
+package hd
+
+import (
+	"bufio"
+	"fmt"
+	"image"
+	"image/draw"
+	"image/png"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+// CatalogEntry 是清冊 hd/catalog.tsv 的一列（docs/spec/004 第 3.3 節）。
+type CatalogEntry struct {
+	Hash string
+	ID   string
+	W, H int
+	Kind string
+	Pal  string // 參考調色盤名稱（hd/palettes.tsv）
+	HD   string // HD PNG 相對於 x<S>/ 的路徑，空 ＝ 尚無
+}
+
+// Asset 是一張載入後的 HD 圖。Img 是非預乘 RGBA，尺寸是 S × S 倍的原版尺寸。
+type Asset struct {
+	Entry *CatalogEntry
+	Img   *image.NRGBA
+	Pal   *[16][3]uint8 // 參考調色盤（DAC 色值，8 位元）
+}
+
+// Assets 管理清冊、調色盤表與延遲載入的 HD 圖。Get 可由前端執行緒呼叫，內部上鎖。
+type Assets struct {
+	Dir string
+	S   int
+
+	cat  map[string]*CatalogEntry
+	pals map[string]*[16][3]uint8
+
+	mu     sync.Mutex
+	cache  map[string]*Asset // nil 值表示載入失敗或沒有 HD，不重試
+	Errors []string          // 載入失敗與不一致的紀錄（每筆只記一次）
+}
+
+// LoadAssets 讀 dir/catalog.tsv、dir/palettes.tsv；HD 圖在 dir/x<S>/。清冊缺檔回錯誤。
+func LoadAssets(dir string, s int) (*Assets, error) {
+	a := &Assets{Dir: dir, S: s, cat: map[string]*CatalogEntry{}, pals: map[string]*[16][3]uint8{}, cache: map[string]*Asset{}}
+	if err := a.loadCatalog(filepath.Join(dir, "catalog.tsv")); err != nil {
+		return nil, err
+	}
+	if err := a.loadPalettes(filepath.Join(dir, "palettes.tsv")); err != nil {
+		return nil, err
+	}
+	return a, nil
+}
+
+func readTSV(path string) (header []string, rows [][]string, err error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer f.Close()
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 1<<20), 1<<20)
+	for sc.Scan() {
+		line := strings.TrimRight(sc.Text(), "\r\n")
+		if line == "" {
+			continue
+		}
+		cols := strings.Split(line, "\t")
+		if header == nil {
+			header = cols
+			continue
+		}
+		rows = append(rows, cols)
+	}
+	return header, rows, sc.Err()
+}
+
+func colIndex(header []string, names ...string) (map[string]int, error) {
+	m := map[string]int{}
+	for i, h := range header {
+		m[h] = i
+	}
+	for _, n := range names {
+		if _, ok := m[n]; !ok {
+			return nil, fmt.Errorf("缺欄位 %q", n)
+		}
+	}
+	return m, nil
+}
+
+func (a *Assets) loadCatalog(path string) error {
+	hdr, rows, err := readTSV(path)
+	if err != nil {
+		return err
+	}
+	ix, err := colIndex(hdr, "hash", "id", "w", "h", "kind", "pal", "hd")
+	if err != nil {
+		return fmt.Errorf("%s：%w", path, err)
+	}
+	for n, r := range rows {
+		if len(r) < len(hdr) {
+			r = append(r, make([]string, len(hdr)-len(r))...)
+		}
+		w, e1 := strconv.Atoi(r[ix["w"]])
+		h, e2 := strconv.Atoi(r[ix["h"]])
+		if e1 != nil || e2 != nil || len(r[ix["hash"]]) != 64 {
+			return fmt.Errorf("%s 第 %d 列格式錯誤", path, n+2)
+		}
+		a.cat[r[ix["hash"]]] = &CatalogEntry{Hash: r[ix["hash"]], ID: r[ix["id"]], W: w, H: h, Kind: r[ix["kind"]], Pal: r[ix["pal"]], HD: r[ix["hd"]]}
+	}
+	return nil
+}
+
+func (a *Assets) loadPalettes(path string) error {
+	hdr, rows, err := readTSV(path)
+	if err != nil {
+		return err
+	}
+	ix, err := colIndex(hdr, "name", "palette16")
+	if err != nil {
+		return fmt.Errorf("%s：%w", path, err)
+	}
+	for n, r := range rows {
+		if len(r) <= ix["palette16"] {
+			return fmt.Errorf("%s 第 %d 列欄位不足", path, n+2)
+		}
+		f := strings.Fields(r[ix["palette16"]])
+		if len(f) != 16 {
+			return fmt.Errorf("%s 第 %d 列不是 16 個顏色", path, n+2)
+		}
+		var p [16][3]uint8
+		for i, c := range f {
+			v, err := strconv.ParseUint(c, 16, 32)
+			if err != nil || len(c) != 6 {
+				return fmt.Errorf("%s 第 %d 列的顏色 %q 格式錯誤", path, n+2, c)
+			}
+			p[i] = [3]uint8{uint8(v >> 16), uint8(v >> 8), uint8(v)}
+		}
+		pp := p
+		a.pals[r[ix["name"]]] = &pp
+	}
+	return nil
+}
+
+// Lookup 回傳雜湊在清冊中的列（不論有沒有 HD 圖）；識別率統計用。
+func (a *Assets) Lookup(hash string) *CatalogEntry {
+	if a == nil {
+		return nil
+	}
+	return a.cat[hash]
+}
+
+// Palette 回傳參考調色盤；沒有就回 nil。
+func (a *Assets) Palette(name string) *[16][3]uint8 { return a.pals[name] }
+
+// Get 回傳雜湊對應的 HD 圖；清冊沒有、尚無 HD、PNG 缺檔、尺寸不符、調色盤缺漏時回 nil
+// （顯示原版像素的放大，不報錯；原因記在 Errors，每個雜湊一次）。
+func (a *Assets) Get(hash string) *Asset {
+	if a == nil {
+		return nil
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if as, ok := a.cache[hash]; ok {
+		return as
+	}
+	var as *Asset
+	if e := a.cat[hash]; e != nil && e.HD != "" {
+		as = a.load(e)
+	}
+	a.cache[hash] = as
+	return as
+}
+
+func (a *Assets) fail(format string, args ...any) *Asset {
+	a.Errors = append(a.Errors, fmt.Sprintf(format, args...))
+	return nil
+}
+
+func (a *Assets) load(e *CatalogEntry) *Asset {
+	pal := a.pals[e.Pal]
+	if pal == nil {
+		return a.fail("%s：參考調色盤 %q 不在 palettes.tsv", e.ID, e.Pal)
+	}
+	f, err := os.Open(filepath.Join(a.Dir, "x"+strconv.Itoa(a.S), filepath.FromSlash(e.HD)))
+	if err != nil {
+		return a.fail("%s：%v", e.ID, err)
+	}
+	defer f.Close()
+	im, err := png.Decode(f)
+	if err != nil {
+		return a.fail("%s：PNG 解碼失敗：%v", e.ID, err)
+	}
+	b := im.Bounds()
+	if b.Dx() != e.W*a.S || b.Dy() != e.H*a.S {
+		return a.fail("%s：PNG 是 %dx%d，清冊要求 %dx%d（%d 倍）", e.ID, b.Dx(), b.Dy(), e.W*a.S, e.H*a.S, a.S)
+	}
+	n, ok := im.(*image.NRGBA)
+	if !ok || b.Min != (image.Point{}) {
+		n = image.NewNRGBA(image.Rect(0, 0, b.Dx(), b.Dy()))
+		draw.Draw(n, n.Bounds(), im, b.Min, draw.Src)
+	}
+	return &Asset{Entry: e, Img: n, Pal: pal}
+}
diff --git a/apps/hr/hd/capture.go b/apps/hr/hd/capture.go
new file mode 100644
index 0000000..91c4302
--- /dev/null
+++ b/apps/hr/hd/capture.go
@@ -0,0 +1,425 @@
+package hd
+
+import (
+	"fmt"
+	"sort"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// Site 是一個掛鉤進入點（執行期位址，綁定 MAIN.EXE 的 SHA-256；IDA 位址 ＝ 執行期 ＋ 0x0EF0 段）。
+type Site struct {
+	Name     string
+	Seg, Off uint16
+	Kind     Kind
+}
+
+// MainSites 是 docs/spec/004 第 4.1 節的進入點表。
+var MainSites = []Site{
+	{"2B47:0022", 0x1C57, 0x0022, KindSprite},
+	{"3268:1155", 0x2378, 0x1155, KindCache24},
+	{"2E92:066A", 0x1FA2, 0x066A, KindStream},
+	{"348F:0005", 0x259F, 0x0005, KindPacked4},
+	{"2FB2:25A1", 0x20C2, 0x25A1, KindMap},
+}
+
+// CursorSite 是游標戳記的呼叫點（返回位址 19FB:08A2，IDA 28EB:08A2），唯一的 singleton。
+const CursorSite = uint32(0x19FB)<<16 | 0x08A2
+
+// 24x24 快取：程式碼段 2378，槽 n 在 cs:[0Eh + n × 168h]，共 6 槽，每槽 24 列 × 15 bytes。
+const (
+	cache24Seg   = 0x2378
+	cache24Base  = 0x0E
+	cache24Slot  = 0x168
+	cache24Slots = 6
+	gameRowShift = 40 // 遊戲區在 Px 的列偏移
+	streamWindow = 0x40000
+)
+
+// Stats 是掛鉤的統計。
+type Stats struct {
+	Entered    map[Kind]uint64
+	Created    uint64
+	DecodeErr  uint64 // 解碼失敗（資料不足、長度不符）
+	Skipped    uint64 // 旗標非 0、x 非 8 的倍數、槽號超出
+	Interrupt  uint64 // 返回鉤子對不上（SP 不符）或待定逾期而丟棄
+	Identified uint64 // 雜湊在清冊內
+	Unknown    uint64 // 雜湊不在清冊內
+}
+
+// UnknownEntry 是記錄模式下未識別的雜湊。
+type UnknownEntry struct {
+	Hash  string
+	Kind  Kind
+	W, H  int
+	Count uint64
+	Site  uint32
+	X, Y  int // 第一次出現的位置
+}
+
+type pending struct {
+	st           *Stamp // map 種類在返回時才建
+	kind         Kind
+	retIP, retCS uint16
+	sp           uint16 // 返回後預期的 SP（進入時 SP ＋ 4）
+	ss           uint16
+	entry        uint64
+}
+
+// Overlay 是掛鉤與戳記佇列。只由持有機器的 goroutine 呼叫（Pre、Post）。
+type Overlay struct {
+	Q     *Queue
+	A     *Assets // 用於識別（Lookup）；可為 nil
+	Stats Stats
+	// Check 大於 0 時，每個雜湊的前 Check 次出現在返回時用 Machine.Planar 量一次相符比例（開發與驗收用，很慢）。
+	Check int
+	// Record 為 true 時收集未識別的雜湊。
+	Record  bool
+	unknown map[string]*UnknownEntry
+	match   map[string]*MatchStat
+	Logf    func(string, ...any)
+
+	bits  [1024]uint64
+	sites map[uint16][]Site
+	pend  []pending
+}
+
+// MatchStat 是 Check 模式的量測：該雜湊在返回時與 VRAM 的相符情形。
+type MatchStat struct {
+	Hash       string
+	N          int
+	Opaque     int
+	Matched    int
+	Samples    int
+	FirstRatio float64
+	MinRatio   float64
+}
+
+// NewOverlay 建立掛鉤。a 可為 nil。
+func NewOverlay(a *Assets) *Overlay {
+	o := &Overlay{Q: NewQueue(0, CursorSite), A: a, sites: map[uint16][]Site{}, unknown: map[string]*UnknownEntry{}, match: map[string]*MatchStat{}}
+	o.Stats.Entered = map[Kind]uint64{}
+	for _, s := range MainSites {
+		o.bits[s.Off>>6] |= 1 << (s.Off & 63)
+		o.sites[s.Off] = append(o.sites[s.Off], s)
+	}
+	return o
+}
+
+func (o *Overlay) logf(format string, args ...any) {
+	if o.Logf != nil {
+		o.Logf(format, args...)
+	}
+}
+
+// Pending 回傳待定戳記數（呼叫者用它決定要不要呼叫 Post）。
+func (o *Overlay) Pending() int { return len(o.pend) }
+
+// Pre 在每一道指令執行之前呼叫：偵測進入點。只讀記憶體與暫存器。
+func (o *Overlay) Pre(m *machine.Machine) {
+	ip := m.CPU.IP
+	if o.bits[ip>>6]&(1<<(ip&63)) == 0 {
+		return
+	}
+	cs := m.CPU.Seg[cpu.CS]
+	for _, s := range o.sites[ip] {
+		if s.Seg == cs {
+			o.enter(m, s)
+			return
+		}
+	}
+}
+
+// Post 在每一道指令執行之後呼叫（只在 Pending() > 0 時需要）：偵測返回。
+func (o *Overlay) Post(m *machine.Machine) {
+	c := m.CPU
+	cs, ip, ss, sp := c.Seg[cpu.CS], c.IP, c.Seg[cpu.SS], c.R[cpu.SP]
+	for i := 0; i < len(o.pend); i++ {
+		p := &o.pend[i]
+		if cs != p.retCS || ip != p.retIP {
+			if m.Steps-p.entry > pendingTimeout {
+				o.Stats.Interrupt++
+				o.pend = append(o.pend[:i], o.pend[i+1:]...)
+				i--
+			}
+			continue
+		}
+		if ss == p.ss && sp == p.sp {
+			o.finish(m, p)
+		} else {
+			o.Stats.Interrupt++
+		}
+		o.pend = append(o.pend[:i], o.pend[i+1:]...)
+		i--
+	}
+}
+
+// pendingTimeout：待定逾期的指令數。串流解碼最慢的呼叫也遠小於此（BSTAGE 約數十萬道）。
+const pendingTimeout = 400_000_000
+
+func (o *Overlay) arg(m *machine.Machine, ss, sp uint16, n uint16) uint16 {
+	return m.Read16(cpu.Linear(ss, sp+4+n))
+}
+
+func (o *Overlay) enter(m *machine.Machine, s Site) {
+	o.Stats.Entered[s.Kind]++
+	c := m.CPU
+	ss, sp := c.Seg[cpu.SS], c.R[cpu.SP]
+	p := pending{kind: s.Kind, retIP: m.Read16(cpu.Linear(ss, sp)), retCS: m.Read16(cpu.Linear(ss, sp+2)), sp: sp + 4, ss: ss, entry: m.Steps}
+	site := uint32(p.retCS)<<16 | uint32(p.retIP)
+	var sp5 Sprite
+	var err error
+	x, y := 0, 0
+	switch s.Kind {
+	case KindSprite:
+		if flag := o.arg(m, ss, sp, 0); flag != 0 {
+			o.Stats.Skipped++
+			return
+		}
+		x, y = int(int16(o.arg(m, ss, sp, 2))), int(int16(o.arg(m, ss, sp, 4)))+gameRowShift
+		lin := uint32(o.arg(m, ss, sp, 8))<<4 + uint32(o.arg(m, ss, sp, 6))
+		sp5, err = decodeAt(m, lin, func(b []byte) (Sprite, error) { return DecodePlanarSprite(b) }, 5)
+	case KindCache24:
+		slot := int(o.arg(m, ss, sp, 0))
+		if slot >= cache24Slots {
+			o.Stats.Skipped++
+			return
+		}
+		x, y = int(int16(o.arg(m, ss, sp, 2))), int(int16(o.arg(m, ss, sp, 4)))+gameRowShift
+		lin := cpu.Linear(cache24Seg, uint16(cache24Base+slot*cache24Slot))
+		if lin+360 > uint32(len(m.Mem)) {
+			err = fmt.Errorf("快取超出記憶體")
+			break
+		}
+		buf := make([]byte, 5+360)
+		copy(buf, []byte{24, 0, 24, 0, 1})
+		copy(buf[5:], m.Mem[lin:lin+360])
+		sp5, err = DecodePlanarSprite(buf)
+	case KindStream:
+		lin := uint32(o.arg(m, ss, sp, 2))<<4 + uint32(o.arg(m, ss, sp, 0))
+		off := int(o.arg(m, ss, sp, 4))
+		x, y = (off%80)*8, off/80+gameRowShift
+		sp5, err = decodeStream(m, lin)
+	case KindPacked4:
+		lin := uint32(o.arg(m, ss, sp, 2))<<4 + uint32(o.arg(m, ss, sp, 0))
+		off := int(o.arg(m, ss, sp, 4))
+		x, y = (off%80)*8, off/80+gameRowShift
+		sp5, err = decodePacked4(m, lin)
+	case KindMap:
+		// 返回時讀 VRAM 整張矩形（第 4.1 節）
+		o.pend = append(o.pend, p)
+		return
+	}
+	if err != nil {
+		o.Stats.DecodeErr++
+		o.logf("掛鉤 %s 解碼失敗：%v", s.Name, err)
+		return
+	}
+	if x%8 != 0 {
+		o.Stats.Skipped++
+		return
+	}
+	p.st = &Stamp{Kind: s.Kind, X: x, Y: y, W: sp5.W, H: sp5.H, Hash: Hash(sp5.W, sp5.H, sp5.Idx), Site: site, E: sp5.Idx}
+	o.pend = append(o.pend, p)
+}
+
+func memLimit(m *machine.Machine) uint32 {
+	lim := uint32(machine.VideoSeg) * 16
+	if n := uint32(len(m.Mem)); n < lim {
+		lim = n
+	}
+	return lim
+}
+
+// decodeAt 讀 lin 起的標頭（hdr bytes）求長度後解碼（目前只給記憶體內精靈用）。
+func decodeAt(m *machine.Machine, lin uint32, dec func([]byte) (Sprite, error), hdr int) (Sprite, error) {
+	lim := memLimit(m)
+	if lin+uint32(hdr) > lim {
+		return Sprite{}, fmt.Errorf("精靈位址 %05X 超出記憶體", lin)
+	}
+	h := m.Mem[lin : lin+uint32(hdr)]
+	w, ht, flag := int(h[0])|int(h[1])<<8, int(h[2])|int(h[3])<<8, h[4]
+	if w == 0 || ht == 0 || w > 640 || ht > 480 || w%8 != 0 {
+		return Sprite{}, fmt.Errorf("不合理的精靈尺寸 %dx%d", w, ht)
+	}
+	n := uint32(RawSpriteSize(w, ht, flag))
+	if lin+n > lim {
+		return Sprite{}, fmt.Errorf("精靈 %dx%d 超出記憶體", w, ht)
+	}
+	return dec(m.Mem[lin : lin+n])
+}
+
+func decodeStream(m *machine.Machine, lin uint32) (Sprite, error) {
+	lim := memLimit(m)
+	if lin >= lim {
+		return Sprite{}, fmt.Errorf("串流位址 %05X 超出記憶體", lin)
+	}
+	end := lin + streamWindow
+	if end > lim {
+		end = lim
+	}
+	out, _, err := LZSSDecode(m.Mem[lin:end])
+	if err != nil {
+		return Sprite{}, err
+	}
+	return DecodeUnpacked(out)
+}
+
+func decodePacked4(m *machine.Machine, lin uint32) (Sprite, error) {
+	lim := memLimit(m)
+	if lin+5 > lim {
+		return Sprite{}, fmt.Errorf("資料位址 %05X 超出記憶體", lin)
+	}
+	h := m.Mem[lin : lin+5]
+	w, ht := int(h[0])|int(h[1])<<8, int(h[2])|int(h[3])<<8
+	if h[4] != 0x80 || w == 0 || ht == 0 || w > 640 || ht > 480 || w%2 != 0 {
+		return Sprite{}, fmt.Errorf("不是 packed4 資料：%dx%d 旗標 %02X", w, ht, h[4])
+	}
+	n := uint32(5 + w*ht/2)
+	if lin+n > lim {
+		return Sprite{}, fmt.Errorf("packed4 %dx%d 超出記憶體", w, ht)
+	}
+	return DecodeUnpacked(m.Mem[lin : lin+n])
+}
+
+// finish 在返回鉤子觸發時把待定戳記轉為有效。
+func (o *Overlay) finish(m *machine.Machine, p *pending) {
+	st := p.st
+	if p.kind == KindMap {
+		_, _, px := m.Planar()
+		const W, H = 640, 400
+		if px == nil || len(px) < 640*(gameRowShift+H) {
+			o.Stats.DecodeErr++
+			return
+		}
+		e := make([]byte, W*H)
+		copy(e, px[gameRowShift*640:(gameRowShift+H)*640])
+		st = &Stamp{Kind: KindMap, X: 0, Y: gameRowShift, W: W, H: H, Hash: Hash(W, H, e), Site: uint32(p.retCS)<<16 | uint32(p.retIP), E: e}
+	}
+	if st == nil {
+		return
+	}
+	o.Stats.Created++
+	if ev := o.Q.Add(st); ev != nil {
+		o.logf("戳記佇列已滿，丟棄最舊的 %s %dx%d@%d,%d", ev.Hash[:12], ev.W, ev.H, ev.X, ev.Y)
+	}
+	if o.A != nil {
+		if o.A.Lookup(st.Hash) != nil {
+			o.Stats.Identified++
+		} else {
+			o.Stats.Unknown++
+			if o.Record {
+				u := o.unknown[st.Hash]
+				if u == nil {
+					u = &UnknownEntry{Hash: st.Hash, Kind: st.Kind, W: st.W, H: st.H, Site: st.Site, X: st.X, Y: st.Y}
+					o.unknown[st.Hash] = u
+				}
+				u.Count++
+			}
+		}
+	}
+	if o.Check > 0 {
+		o.checkMatch(m, st)
+	}
+}
+
+func (o *Overlay) checkMatch(m *machine.Machine, st *Stamp) {
+	ms := o.match[st.Hash]
+	if ms == nil {
+		ms = &MatchStat{Hash: st.Hash, MinRatio: 2}
+		o.match[st.Hash] = ms
+	}
+	ms.N++
+	if ms.Samples >= o.Check {
+		return
+	}
+	w, _, px := m.Planar()
+	if px == nil {
+		return
+	}
+	op, ma := 0, 0
+	for j := 0; j < st.H; j++ {
+		y := st.Y + j
+		if y < 0 || y >= 480 {
+			continue
+		}
+		for i := 0; i < st.W; i++ {
+			x := st.X + i
+			e := st.E[j*st.W+i]
+			if e == Transparent || x < 0 || x >= w {
+				continue
+			}
+			op++
+			if px[y*w+x] == e {
+				ma++
+			}
+		}
+	}
+	ms.Samples++
+	ms.Opaque, ms.Matched = ms.Opaque+op, ms.Matched+ma
+	r := 1.0
+	if op > 0 {
+		r = float64(ma) / float64(op)
+	}
+	if r < 0.9 && o.Logf != nil {
+		// 診斷：位置可能算錯，在 ±80 像素、±64 列內找最相符的位移
+		bx, by, best := 0, 0, 0
+		for dy := -64; dy <= 64; dy++ {
+			for dx := -80; dx <= 80; dx += 8 {
+				n := 0
+				for j := 0; j < st.H; j += 2 {
+					y := st.Y + dy + j
+					if y < 0 || y >= 480 {
+						continue
+					}
+					for i := 0; i < st.W; i += 2 {
+						x := st.X + dx + i
+						e := st.E[j*st.W+i]
+						if e != Transparent && x >= 0 && x < w && px[y*w+x] == e {
+							n++
+						}
+					}
+				}
+				if n > best {
+					best, bx, by = n, dx, dy
+				}
+			}
+		}
+		o.logf("相符比例偏低 %s %s %dx%d@(%d,%d) 比例 %.3f，最佳位移 (%+d,%+d)（取樣相符 %d）", st.Kind, st.Hash[:12], st.W, st.H, st.X, st.Y, r, bx, by, best)
+	}
+	if ms.Samples == 1 {
+		ms.FirstRatio = r
+	}
+	if r < ms.MinRatio {
+		ms.MinRatio = r
+	}
+}
+
+// UnknownList 回傳記錄模式收集的未識別雜湊（依出現次數遞減）。
+func (o *Overlay) UnknownList() []*UnknownEntry {
+	l := make([]*UnknownEntry, 0, len(o.unknown))
+	for _, u := range o.unknown {
+		l = append(l, u)
+	}
+	sort.Slice(l, func(i, j int) bool {
+		if l[i].Count != l[j].Count {
+			return l[i].Count > l[j].Count
+		}
+		return l[i].Hash < l[j].Hash
+	})
+	return l
+}
+
+// MatchList 回傳 Check 模式的量測（依雜湊排序）。
+func (o *Overlay) MatchList() []*MatchStat {
+	l := make([]*MatchStat, 0, len(o.match))
+	for _, s := range o.match {
+		l = append(l, s)
+	}
+	sort.Slice(l, func(i, j int) bool { return l[i].Hash < l[j].Hash })
+	return l
+}
+
+// Snapshot 回傳目前有效戳記的複本（序號遞增）。
+func (o *Overlay) Snapshot() []*Stamp { return o.Q.Snapshot() }
