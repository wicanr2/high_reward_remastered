+// 正常原版新遊戲與設定輸入，不依賴研究 state，不寫原版記憶體。
+func TestCursorHighSpeedNormalPathRetryAndMachineParity(t *testing.T) {
+	root := origRoot(t)
+	var sessions [2]*Session
+	for i := range sessions {
+		s, err := Open(root, Options{SmoothCursor: i == 1, NoPacing: true})
+		if err != nil {
+			t.Fatal(err)
+		}
+		sessions[i] = s
+		run := func(n uint64) {
+			if st := s.RunSteps(s.m.Steps + n); st.Kind != StopSteps {
+				t.Fatal(st)
+			}
+		}
+		click := func(x, y, button int) {
+			s.Input(MouseButtonEvent(x, y, button, true))
+			for n := 0; n < 5; n++ {
+				// 轉場載入可暫時沒有輪詢；沿正常執行前進，不把批次上限當停機。
+				if st, _ := s.RunToPoll(2000000); st != nil {
+					t.Fatalf("click stopped: %v", st)
+				}
+			}
+			s.Input(MouseButtonEvent(x, y, button, false))
+			run(5000000)
+		}
+		run(30000000)
+		click(312, 171, 0)
+		for n := 0; n < 16; n++ {
+			click(310, 160, 0)
+		}
+		for _, p := range [][3]int{{615, 24, 0}, {560, 124, 0}, {350, 275, 0}, {330, 275, 0}, {350, 340, 0}, {330, 275, 0}, {450, 200, 1}} {
+			click(p[0], p[1], p[2])
+		}
+	}
+	a, b := sessions[0], sessions[1]
+	for n := 0; n < 1000; n++ {
+		for _, s := range sessions {
+			s.RequestFrame()
+			if st, ok := s.RunToPoll(2000000); st != nil || !ok {
+				t.Fatalf("sampling did not reach poll: %v %v", st, ok)
+			}
+		}
+		f := b.Frame()
+		if !f.CursorPending {
+			continue
+		}
+		raw := append([]byte(nil), f.Px...)
+		start := b.m.Steps
+		for _, s := range sessions {
+			if st := s.RunSteps(start + 100000); st.Kind != StopSteps {
+				t.Fatal(st)
+			}
+		}
+		if b.Frame().Seq <= f.Seq || b.Frame().Cursor == nil || b.Frame().CursorPending || b.cursorRetry {
+			t.Fatal("pending cursor did not recover without a new request")
+		}
+		if !bytes.Equal(raw, f.Px) || !f.CursorPending {
+			t.Fatal("retry mutated published frame")
+		}
+		if !reflect.DeepEqual(a.m.Snapshot(), b.m.Snapshot()) || !reflect.DeepEqual(a.d.Stats(), b.d.Stats()) {
+			t.Fatal("cursor retry changed original machine or DOS state")
+		}
+		t.Logf("normal high-speed path recovered from pending at step %d; A/B identical at %d", start, b.m.Steps)
+		return
+	}
+	t.Fatal("normal high-speed path never exercised pending cursor")
+}
