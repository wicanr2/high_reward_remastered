+// 保存已清除原版游標的完整呈現幀。pending 只引用它，不形成快照歷史鏈。
+// 隱藏幀同樣取代前幀；未知格式及回退不能恢復舊的可見游標。
+func (s *Session) retainCursorPresentation(f *Frame) {
+	f.CursorPrevious = nil
+	if f.CursorPending {
+		f.CursorPrevious = s.cursorComplete
+	} else if f.CursorManaged {
+		s.cursorComplete = f.Presentation()
+	} else {
+		s.cursorComplete = nil
+	}
+}
+
 const cursorData = 0x3e500
 
+// 010 高速增補：原版繪圖返回點，IDA 28EB:08A2，執行期 19FB:08A2。
+// 只補取已要求但取到重畫中的畫面，仍由 prepareCursor 驗證完整像素。
+func (s *Session) retryCursorAtDraw() {
+	if !s.opt.SmoothCursor || !s.cursorRetry {
+		return
+	}
+	c := s.m.CPU
+	if uint32(c.Seg[cpu.CS])<<16|uint32(c.IP) != hd.CursorSite {
+		return
+	}
+	a := cpu.Linear(c.Seg[cpu.CS], c.IP)
+	if s.m.Mem[a] != 0x83 || s.m.Mem[a+1] != 0xc4 || s.m.Mem[a+2] != 0x0a {
+		return
+	}
+	s.snapshot()
+	s.cursorRetry = false // 即使補取仍 pending，也等下一個前端要求再試。
+}
