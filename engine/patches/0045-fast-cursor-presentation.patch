+func TestCursorPendingRetainsCompletePresentation(t *testing.T) {
+	s := &Session{}
+	f, mem := cursorFixture()
+	f.Seq, f.Steps, f.Ticks = 2, 100, 4
+	f.Map[1], f.DAC[7] = 7, [3]uint8{100, 110, 120}
+	f.UI = &UIFrame{}
+	f.Stamps = []*hd.Stamp{{Site: hd.CursorSite}, {Site: 1}}
+	f.CursorManaged, f.CursorPending, _ = prepareCursor(f, mem, [4]int{0, 639, 40, 439})
+	s.retainCursorPresentation(f)
+	previous := s.cursorComplete
+	if previous == nil || previous == f || previous.Px[140*640+96] != 6 || len(previous.Stamps) != 1 {
+		t.Fatal("retained original cursor pixels or stamp instead of cleaned presentation")
+	}
+	if f.Px[140*640+96] != 1 || len(f.Stamps) != 2 || f.CursorPrevious != nil {
+		t.Fatal("retention changed original complete snapshot")
+	}
+	now := time.Now()
+	for seq := uint64(3); seq < 20; seq++ {
+		p := &Frame{Seq: seq, Px: []byte{9}, CursorManaged: true, CursorPending: true, CursorDeadline: now.Add(time.Second)}
+		s.retainCursorPresentation(p)
+		got := p.presentationAt(now)
+		if got != previous || got.CursorPrevious != nil || got.Seq != 2 || got.Cursor != f.Cursor || got.UI != f.UI || got.Map != f.Map || got.DAC != f.DAC || got.Steps != f.Steps || got.Ticks != f.Ticks {
+			t.Fatal("pending frame lost complete metadata or formed history chain")
+		}
+		fallback := p.presentationAt(now.Add(time.Second))
+		if fallback.Seq != seq || fallback.Px[0] != 9 || fallback.CursorManaged || fallback.Cursor != nil || fallback.CursorPrevious != nil {
+			t.Fatal("same pending snapshot did not expire to raw presentation")
+		}
+		if p.CursorPrevious != previous || !p.CursorPending || p.Px[0] != 9 {
+			t.Fatal("presentation mutated published pending snapshot")
+		}
+	}
+	// 完整隱藏幀必須取代舊的可見前幀。
+	hidden := &Frame{Seq: 20, CursorManaged: true}
+	s.retainCursorPresentation(hidden)
+	p := &Frame{Seq: 21, CursorManaged: true, CursorPending: true, CursorDeadline: now.Add(time.Second)}
+	s.retainCursorPresentation(p)
+	if got := p.presentationAt(now); got == nil || got.Seq != 20 || got.Cursor != nil {
+		t.Fatal("hidden complete frame resurrected old visible cursor")
+	}
+	// 未知格式、停用及已到期回退均為 unmanaged，不能留下可恢復的前幀。
+	s.retainCursorPresentation(&Frame{Seq: 22})
+	s.retainCursorPresentation(p)
+	if s.cursorComplete != nil || p.CursorPrevious != nil || p.presentationAt(now) != nil {
+		t.Fatal("unmanaged fallback retained old complete frame")
+	}
+}
