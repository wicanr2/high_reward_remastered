+func TestCursorRetryCancellationAndReturnSignature(t *testing.T) {
+	for _, name := range []string{"valid", "hidden", "unsupported", "expired", "unrequested"} {
+		t.Run(name, func(t *testing.T) {
+			s := cursorRetryFixture()
+			s.RequestFrame()
+			s.SnapshotNow()
+			if !s.cursorRetry {
+				t.Fatal("fixture did not arm")
+			}
+			s.RequestFrame()
+			switch name {
+			case "valid":
+				for _, off := range []int{0x2a9, 0x1bd1} {
+					s.m.Mem[cursorData+off+5] = 0 // 色 0 的不透明游標與黑色 VRAM 一致。
+				}
+			case "hidden":
+				binary.LittleEndian.PutUint16(s.m.Mem[cursorData+0x19:], 0)
+				binary.LittleEndian.PutUint16(s.m.Mem[cursorData+0x1b:], 0)
+			case "unsupported":
+				s.m.Mem[cursorData+0x2a9] = 39
+			case "expired":
+				s.cursorWaitAt = time.Now().Add(-time.Second)
+			case "unrequested":
+				s.want.Store(false)
+			}
+			s.SnapshotNow()
+			if s.cursorRetry {
+				t.Fatal("later snapshot did not cancel stale retry")
+			}
+			if name == "valid" && s.Frame().Cursor == nil {
+				t.Fatal("fixture did not validate")
+			}
+		})
+	}
+	for _, name := range []string{"segment", "offset", "bytes", "disabled"} {
+		t.Run(name, func(t *testing.T) {
+			s := cursorRetryFixture()
+			s.RequestFrame()
+			s.SnapshotNow()
+			seq := s.Frame().Seq
+			switch name {
+			case "segment":
+				s.m.CPU.Seg[cpu.CS]++
+			case "offset":
+				s.m.CPU.IP++
+			case "bytes":
+				s.m.Mem[cpu.Linear(0x19fb, 0x8a2)] = 0x90
+			case "disabled":
+				s.opt.SmoothCursor = false
+			}
+			s.retryCursorAtDraw()
+			if s.Frame().Seq != seq {
+				t.Fatal("unverified return point caused a snapshot")
+			}
+		})
+	}
+}
