+func TestCursorRetryOnceAndPreservesDeadline(t *testing.T) {
+	s := cursorRetryFixture()
+	s.RequestFrame()
+	s.SnapshotNow()
+	f := s.Frame()
+	if !f.CursorPending || !s.cursorRetry {
+		t.Fatal("requested pending frame did not arm retry")
+	}
+	before := s.m.Snapshot()
+	s.retryCursorAtDraw()
+	if s.Frame().Seq != f.Seq+1 || !s.Frame().CursorPending || s.cursorRetry {
+		t.Fatal("failed retry must consume exactly one opportunity")
+	}
+	if s.Frame().CursorDeadline != f.CursorDeadline || !reflect.DeepEqual(before, s.m.Snapshot()) {
+		t.Fatal("retry reset deadline or changed machine")
+	}
+	seq := s.Frame().Seq
+	s.retryCursorAtDraw()
+	if s.Frame().Seq != seq {
+		t.Fatal("retried without a new front-end request")
+	}
+	s.SnapshotNow() // 100ms 自動回退也走相同的非 requested 快照。
+	if s.cursorRetry || s.Frame().CursorDeadline != f.CursorDeadline {
+		t.Fatal("unrequested snapshot rearmed retry or reset deadline")
+	}
+	s.RequestFrame()
+	s.SnapshotNow()
+	if !s.cursorRetry || s.Frame().CursorDeadline != f.CursorDeadline {
+		t.Fatal("new request must arm once without extending deadline")
+	}
+}
