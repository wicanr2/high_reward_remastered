+func cursorRetryFixture() *Session {
+	_, mem := cursorFixture()
+	m := machine.New()
+	m.Mem = mem
+	m.SetVideoMode(0x12) // 黑色底圖與色 1 游標不符，模擬重畫中。
+	m.CPU.Seg[cpu.CS], m.CPU.IP = 0x19fb, 0x8a2
+	copy(m.Mem[cpu.Linear(0x19fb, 0x8a2):], []byte{0x83, 0xc4, 0x0a})
+	return &Session{m: m, d: dos.New(m, ""), opt: Options{SmoothCursor: true}}
+}
