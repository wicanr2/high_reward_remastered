+func TestCursorConsumersRecoverSkippedCompleteFrame(t *testing.T) {
+	complete := newFakeFrame(vramW, vramH, 2)
+	complete.CursorManaged = true
+	complete.Cursor = &hrrt.Cursor{Pixels: []uint8{1}}
+	complete.UI = &hrrt.UIFrame{}
+	complete.Map[1], complete.DAC[7] = 7, [3]uint8{90, 100, 110}
+	complete = complete.Presentation()
+	pending := newFakeFrame(vramW, vramH, 3)
+	pending.CursorManaged, pending.CursorPending = true, true
+	pending.CursorDeadline = time.Now().Add(time.Hour)
+	pending.CursorPrevious = complete
+
+	// 合成器完全沒讀到 Seq 2，來源直接跳到 pending Seq 3。
+	src := &fakeSource{f: newFakeFrame(vramW, vramH, 1)}
+	v := newHDView(src, emptyAssets(t), 1)
+	defer v.close()
+	waitFrame := func(seq uint64) *hrrt.Frame {
+		t.Helper()
+		end := time.Now().Add(2 * time.Second)
+		for time.Now().Before(end) {
+			var f *hrrt.Frame
+			v.uploadDisplay(0, func(rgba []byte, got *hrrt.Frame) {
+				if got.Seq == seq {
+					f = got
+					if seq == 2 && (rgba[0] != 90 || rgba[1] != 100 || rgba[2] != 110) {
+						t.Error("composed pixels used pending palette instead of complete frame")
+					}
+				}
+			})
+			if f != nil {
+				return f
+			}
+			time.Sleep(time.Millisecond)
+		}
+		t.Fatalf("frame %d never published", seq)
+		return nil
+	}
+	waitFrame(1)
+	src.set(pending)
+	if got := waitFrame(2); got != complete || got.Cursor != complete.Cursor || got.UI != complete.UI {
+		t.Fatal("HD publication lost paired complete cursor or UI")
+	}
+	pub := v.Pub()
+	time.Sleep(25 * time.Millisecond)
+	if v.Pub() != pub {
+		t.Fatal("same presentation repeatedly composed")
+	}
+	// 固定同一個已到期 pending，不能因前幀的 Seq 去重而擋住 raw。
+	expired := *pending
+	expired.CursorDeadline = time.Now().Add(-time.Second)
+	src.set(&expired)
+	if got := waitFrame(3); got.CursorManaged || got.CursorPrevious != nil {
+		t.Fatal("HD retained complete cursor beyond deadline")
+	}
+
+	gr := newGameRig(t, themeOriginal, []themeID{themeHD})
+	g := gr.g
+	g.ensureImages()
+	screen := ebiten.NewImage(logicalW, logicalH)
+	g.drawGame(screen)
+	gr.ss.frame = pending
+	g.drawGame(screen)
+	if g.drawnFrame != complete || g.lastSq != 2 {
+		t.Fatal("original frontend did not recover skipped complete frame")
+	}
+	g.drawGame(screen)
+	if g.drawnFrame != complete {
+		t.Fatal("original frontend replaced unchanged presentation")
+	}
+	gr.ss.frame = &expired
+	g.drawGame(screen)
+	if g.lastSq != 3 || g.drawnFrame.CursorManaged || g.drawnFrame.CursorPrevious != nil {
+		t.Fatal("original frontend did not expire fixed pending snapshot")
+	}
+}
