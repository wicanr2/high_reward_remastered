@@ -0,0 +1,51 @@
+package l10n
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func computeL2Golden(t *testing.T) []byte {
+	t.Helper()
+	var out strings.Builder
+	out.Write(computeEnglishGolden(t))
+	for _, code := range []string{codeSimplified, codeJapanese} {
+		for _, v := range []struct {
+			name, text, status string
+			with               bool
+		}{
+			{"zero", "", StatusKeep, false}, {"accepted", "αβ", StatusAccepted, false},
+			{"candidate-excluded", "αβ", StatusCandidate, false}, {"candidate-adopted", "αβ", StatusCandidate, true}, {"reordered", "βα", StatusAccepted, false},
+		} {
+			cfg := scalarConfig(t, code, englishOriginalRow(t, v.text, v.status))
+			cfg.Policy.WithCandidates = v.with
+			res := mustBuild(t, cfg)
+			m := *res.Manifest
+			m.BuilderVersion, m.InputDigest = "", ""
+			raw, e := m.Marshal()
+			if e != nil {
+				t.Fatal(e)
+			}
+			fmt.Fprintf(&out, "[%s-%s]\npatch=%s\nadopted=%d\nmanifest=%s\n", code, v.name, res.Manifest.PatchHash, res.Manifest.Adopted, sha256Hex(raw))
+			for _, name := range packNames {
+				fmt.Fprintf(&out, "%s=%s\n", name, sha256Hex(packFile(t, res.Dir, name)))
+			}
+		}
+	}
+	return []byte(out.String())
+}
+
+func TestScalarContractAndEnglishGoldenUnchanged(t *testing.T) {
+	if builderContract != "hr-l10n-l2-scalar-v1" {
+		t.Fatal("scalar contract identity")
+	}
+	origDirOrSkip(t)
+	if h := sha256Hex(computeEnglishGolden(t)); h != "508566847f68024a5a5693368772ac9de6c59eb8378ac6277d04b5561c439b5f" {
+		t.Fatal("English output bytes or fixture changed", h)
+	}
+	if Version() == "7ba662d3" {
+		t.Fatal("scalar integration reused English builder version")
+	}
+	t.Logf("version=%s L1=%s L2=%s", Version(), sha256Hex(builderGolden), sha256Hex(builderL2Golden))
+}
