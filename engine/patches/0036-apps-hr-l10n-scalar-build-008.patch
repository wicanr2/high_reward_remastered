+	"github.com/wicanr2/dosgolem/apps/hr/l10n/glyphpatch"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+)
+
+func scalarPatchDir(t *testing.T, code string, rs ...rune) string {
+	t.Helper()
+	units := make([][2]rune, len(rs))
+	for i, r := range rs {
+		units[i] = [2]rune{r, 0}
+	}
+	return englishPatchDir(t, code, units...)
+}
+func loadScalar(t *testing.T, code string, rs ...rune) *glyphpatch.Patch {
+	t.Helper()
+	p, e := glyphpatch.Load(scalarPatchDir(t, code, rs...), code)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return p
+}
+func scalarConfig(t *testing.T, code string, rows ...Row) Config {
+	t.Helper()
+	return Config{OrigDir: origDirOrSkip(t), TableDir: englishTables(t, rows...), PackRoot: t.TempDir(), Code: code, Mode: ModeTable, PatchDir: scalarPatchDir(t, code, 'α', 'β', 'γ')}
+}
+func TestScalarConfigScope(t *testing.T) {
+	for _, code := range []string{codeSimplified, codeJapanese} {
+		cfg := Config{Code: code, Mode: ModeTable, TableDir: t.TempDir()}
+		if cfg.Validate() == nil {
+			t.Fatal("missing explicit patch accepted")
+		}
+		cfg.PatchDir = scalarPatchDir(t, code, 'α')
+		if e := cfg.Validate(); e != nil {
+			t.Fatal(e)
+		}
+		if _, e := ExpectedDigest(cfg); e != nil {
+			t.Fatal(e)
+		}
+		cfg.Mode = ModeIdentity
+		if cfg.Validate() == nil {
+			t.Fatal("scalar identity accepted")
+		}
+	}
+	if (Config{Code: "ko", Mode: ModeTable, TableDir: "table", PatchDir: "patch"}).Validate() == nil {
+		t.Fatal("Korean enabled")
+	}
+}
+
+func TestScalarSourceAndEncoding(t *testing.T) {
+	p := loadScalar(t, "ja", 'α', 'β', 'γ', '.', 0x3000)
+	base := budget.Input{ID: "synthetic", File: "SP.MES", Orig: []byte("%03d%s")}
+	source := "A9/:α\nβ%03d%sγ"
+	saved := bytes.Clone(base.Orig)
+	key, final, vs := prepareScalar(base, source, "ja", p)
+	if len(vs) != 0 || !bytes.Equal(key, final) || !bytes.Equal(base.Orig, saved) {
+		t.Fatalf("valid source %v", vs)
+	}
+	a, _ := p.Lookup([]rune{'α'})
+	beta, _ := p.Lookup([]rune{'β'})
+	gamma, _ := p.Lookup([]rune{'γ'})
+	want := append([]byte("A9/:"), byte(a>>8), byte(a), 10, byte(beta>>8), byte(beta))
+	want = append(want, []byte("%03d%s")...)
+	want = append(want, byte(gamma>>8), byte(gamma))
+	if !bytes.Equal(key, want) {
+		t.Fatal("whitelist/format/scalar encoding")
+	}
+	plain := budget.Input{ID: "synthetic", File: "SP.MES", Orig: []byte("AA")}
+	key, final, vs = prepareScalar(plain, "\u3000.", "ja", p)
+	sp, _ := p.Lookup([]rune{0x3000})
+	dot, _ := p.Lookup([]rune{'.'})
+	if len(vs) != 0 || !bytes.Equal(key, []byte{byte(sp >> 8), byte(sp), byte(dot >> 8), byte(dot)}) || !bytes.Equal(final, key) {
+		t.Fatal("fullwidth space or ASCII punctuation not patched")
+	}
+	for _, tc := range []struct{ text, rule string }{
+		{"", "length"}, {"α β", "space"}, {"\xff", "source"}, {"\x00", "source"}, {"\t", "source"},
+		{"\r", "source"}, {"\u200d", "source"}, {"\ue000", "source"}, {"\u0378", "source"}, {"\u0301", "source"},
+		{"\u2028", "source"}, {"\u00a0", "source"}, {"δ", "missing-scalar"}, {"%.d", "placeholder"}, {"%%", "placeholder"},
+		{strings.Repeat("\n", 512), "length"}, {strings.Repeat("𐀀", 512), "length"}, {strings.Repeat("α", 256), "length"},
+	} {
+		t.Run(tc.rule+":"+strings.ReplaceAll(tc.text[:min(8, len(tc.text))], "\n", "N"), func(t *testing.T) {
+			k, out, msg := prepareScalar(plain, tc.text, "ja", p)
+			if k != nil || out != nil || len(msg) == 0 || !strings.Contains(msg[0], tc.rule) {
+				t.Fatalf("expected %s: %v", tc.rule, msg)
+			}
+		})
+	}
+	boundary := strings.Repeat("\n", 511)
+	key, final, vs = prepareScalar(budget.Input{ID: "edge", File: "SP.MES", Orig: []byte(boundary)}, boundary, "ja", p)
+	if len(vs) != 0 || len(key) != 511 || !bytes.Equal(final, key) {
+		t.Fatalf("511 scalar boundary %v", vs)
+	}
+	english, e := glyphpatch.Load(englishPatchDir(t, "en", [2]rune{'α', ' '}), "en")
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, other := range []*glyphpatch.Patch{nil, loadScalar(t, "zh-CN", 'α'), loadScalar(t, "ko", 'α'), english} {
+		if k, out, vs := prepareScalar(plain, "α", "ja", other); k != nil || out != nil || len(vs) == 0 {
+			t.Fatal("wrong or nil patch accepted")
+		}
+	}
+	if _, _, vs := prepareScalar(plain, "α", "ko", loadScalar(t, "ko", 'α')); len(vs) == 0 {
+		t.Fatal("Korean preparation opened")
+	}
+	for _, tc := range []struct{ orig, text, rule string }{
+		{"%03d", "%04d", "placeholder"}, {"%s", "α%s\n", "1676"}, {"%u", "%u", "placeholder"},
+		{"%ld", "%ld", ""}, {"%.0d", "%.0d", ""},
+	} {
+		_, _, vs := prepareScalar(budget.Input{ID: "format", File: "SP.MES", Orig: []byte(tc.orig)}, tc.text, "ja", p)
+		if tc.rule == "" && len(vs) != 0 {
+			t.Fatalf("valid format %v", vs)
+		}
+		if tc.rule != "" && (len(vs) == 0 || !strings.Contains(strings.Join(vs, " "), tc.rule)) {
+			t.Fatalf("format %s: %v", tc.rule, vs)
+		}
+	}
+}
+func TestScalarPunctuationAndWrapping(t *testing.T) {
+	p := loadScalar(t, "ja", 'α', '…', '+')
+	in := budget.Input{ID: "synthetic", File: "UWASA.MES", Orig: []byte("AA")}
+	for _, tc := range []struct {
+		mark  string
+		first int
+	}{{"…", 9}, {"+", 15}} {
+		text := strings.Repeat("α", 8) + tc.mark + strings.Repeat("α", 11)
+		key, out, vs := prepareScalar(in, text, "ja", p)
+		if len(vs) != 0 || len(key) != 40 || bytes.IndexByte(out, 10) != tc.first*2 {
+			t.Fatalf("punctuation %s: first=%d vs=%v", tc.mark, bytes.IndexByte(out, 10), vs)
+		}
+	}
+	text := strings.Repeat("α", 15) + "\n" + strings.Repeat("α", 5)
+	key, out, vs := prepareScalar(in, text, "ja", p)
+	if len(vs) != 0 || !bytes.Equal(key, out) {
+		t.Fatal("explicit newline altered")
+	}
+	// White-listed single-byte colon remains a non-punctuation unit.
+	_, out, vs = prepareScalar(in, strings.Repeat("α", 8)+":"+strings.Repeat("α", 11), "ja", p)
+	if len(vs) != 0 || bytes.IndexByte(out, 10) == 17 {
+		t.Fatal("colon used as preferred break")
+	}
+}
+func TestScalarGroupsAndPolicy(t *testing.T) {
+	w := newSynthWorld(t)
+	p := loadScalar(t, "ja", 'α', 'β')
+	f := w.parsed["UWASA.MES"]
+	text := strings.Repeat("α", 20)
+	rows := []Row{w.row("UWASA.MES#0", text, StatusAccepted), w.row("UWASA.MES#1", strings.Repeat("α", 15)+"\n"+strings.Repeat("α", 5), StatusAccepted)}
+	if _, _, vs, e := (&Table{Rows: rows}).adoptScalar(f, Policy{}, "ja", p); e != nil || len(vs) != 1 || !strings.Contains(vs[0], "同群組") {
+		t.Fatalf("pre-wrap key %v %v", vs, e)
+	}
+	rows[1].Note = "context； group-exception"
+	if _, n, vs, e := (&Table{Rows: rows}).adoptScalar(f, Policy{}, "ja", p); e != nil || len(vs) != 0 || n != 2 {
+		t.Fatalf("exception %v %v", vs, e)
+	}
+	rows[1].Note = "context group-exception"
+	if _, _, vs, _ := (&Table{Rows: rows}).adoptScalar(f, Policy{}, "ja", p); len(vs) == 0 {
+		t.Fatal("inexact exception")
+	}
+	rows[1].Status = StatusKeep
+	if _, n, vs, _ := (&Table{Rows: rows}).adoptScalar(f, Policy{}, "ja", p); len(vs) != 0 || n != 1 {
+		t.Fatal("partial keep")
+	}
+	row := w.row("UWASA.MES#0", "δ", StatusAccepted)
+	row.AccSHA = AccSHA("stale")
+	if _, n, vs, _ := (&Table{Rows: []Row{row}}).adoptScalar(f, Policy{}, "ja", p); n != 0 || len(vs) != 0 {
+		t.Fatal("accepted downgrade")
+	}
+	if _, _, vs, _ := (&Table{Rows: []Row{row}}).adoptScalar(f, Policy{WithCandidates: true}, "ja", p); len(vs) == 0 || !strings.Contains(vs[0], "missing-scalar") {
+		t.Fatal("candidate not prepared")
+	}
+	row.SrcSHA = SrcSHA([]byte("bad"))
+	if _, _, vs, _ := (&Table{Rows: []Row{row}}).adoptScalar(f, Policy{}, "ja", p); len(vs) == 0 {
+		t.Fatal("excluded source identity")
+	}
+	for _, tc := range []struct {
+		id     string
+		policy Policy
+		rule   string
+	}{
+		{"SHOPTAB#0.0", Policy{AllowShoptab: true}, "unknown-window"},
+		{"COUNTRY.MES#0", Policy{}, "allow-country-offsets"},
+	} {
+		file := w.parsed[dataFileOfID(tc.id)]
+		if _, _, vs, _ := (&Table{Rows: []Row{w.row(tc.id, "α", StatusCandidate)}}).adoptScalar(file, tc.policy, "ja", p); tc.policy.AllowShoptab {
+			// Excluded candidate never reaches Prepare; adopt the row explicitly.
+			if len(vs) != 0 {
+				t.Fatal(vs)
+			}
+			if _, _, vs, _ = (&Table{Rows: []Row{w.row(tc.id, "α", StatusAccepted)}}).adoptScalar(file, tc.policy, "ja", p); len(vs) == 0 || !strings.Contains(vs[0], tc.rule) {
+				t.Fatal("shop unknown window")
+			}
+		} else if len(vs) == 0 || !strings.Contains(vs[0], tc.rule) {
+			t.Fatal("country gate")
+		}
+	}
+	orig := string(w.enc("山水火天地人"))
+	esp := mustParse(t, "ESPMES.MRG", buildESP(125, map[int][]string{44: {string(w.enc("一二")), orig}, 121: {orig}}))
+	rows = nil
+	for _, id := range []string{"ESPMES#44.1", "ESPMES#121.0"} {
+		it, _ := esp.Lookup(id)
+		rows = append(rows, Row{ID: id, SrcSHA: SrcSHA(it.Orig), Text: text, Status: StatusAccepted, AccSHA: AccSHA(text)})
+	}
+	repl, n, vs, e := (&Table{Rows: rows}).adoptScalar(esp, Policy{}, "ja", p)
+	if e != nil || len(vs) != 0 || n != 2 || bytes.ContainsRune(repl[rows[0].ID], 10) || !bytes.ContainsRune(repl[rows[1].ID], 10) {
+		t.Fatalf("different windows %v %v", vs, e)
+	}
+}
