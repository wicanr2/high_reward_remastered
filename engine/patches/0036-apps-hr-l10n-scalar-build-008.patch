@@ -0,0 +1,65 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestBuildScalarPatchFlags(t *testing.T) {
+	for _, lang := range []string{"zh-CN", "ja"} {
+		for _, args := range [][]string{
+			{"-code", lang, "-mode", "table", "-orig", "absent", "-l10n", "absent"},
+			{"-code", lang, "-mode", "identity", "-orig", "absent", "-glyph-patch", "absent"},
+		} {
+			code, out, e := exec("", append([]string{"build"}, args...)...)
+			if code != 2 || out != "" || e == "" {
+				t.Fatalf("usage %d %s", code, e)
+			}
+		}
+		root := tableRoot(t, lang, nil)
+		code, out, e := exec("", "build", "-code", lang, "-mode", "table", "-orig", "absent", "-l10n", root, "-glyph-patch", "absent", "-out", t.TempDir())
+		if code != 1 || out != "" || !strings.Contains(e, "字模補丁") {
+			t.Fatalf("missing patch should reach build: %d %s", code, e)
+		}
+	}
+	code, _, help := exec("", "build", "-h")
+	if code != 0 || !strings.Contains(help, "zh-CN") || !strings.Contains(help, "ja") || !strings.Contains(help, "glyph-patch") {
+		t.Fatal("scalar help")
+	}
+	code, _, _ = exec("", "build", "-code", "ko", "-mode", "table", "-orig", "absent", "-l10n", "absent", "-glyph-patch", "absent")
+	if code != 2 {
+		t.Fatal("Korean CLI enabled")
+	}
+}
+func TestBuildScalarLocalCLI(t *testing.T) {
+	root, patches, orig := os.Getenv("HR_SCALAR_TABLES"), os.Getenv("HR_SCALAR_PATCHES"), os.Getenv("HR_ORIG")
+	if root == "" || patches == "" || orig == "" {
+		t.Skip("local scalar CLI inputs not supplied")
+	}
+	for _, tc := range []struct{ code, patch string }{{"zh-CN", "sc-pilot-bake1"}, {"ja", "ja-pilot-bake1"}} {
+		t.Run(tc.code, func(t *testing.T) {
+			args := []string{"build", "-code", tc.code, "-mode", "table", "-orig", orig, "-l10n", root, "-glyph-patch", filepath.Join(patches, tc.patch), "-out", t.TempDir()}
+			code, out, e := exec("", args...)
+			if code != 0 || !strings.Contains(out, "reused=false") || !strings.Contains(e, "採用 17 列") {
+				t.Fatalf("build %d %s", code, e)
+			}
+			t.Log(out + e)
+			var dir string
+			for _, line := range strings.Split(out, "\n") {
+				if strings.HasPrefix(line, "dir=") {
+					dir = strings.TrimPrefix(line, "dir=")
+				}
+			}
+			code, _, e = exec("", "verify", "-orig", orig, dir)
+			if code != 0 {
+				t.Fatalf("verify %d %s", code, e)
+			}
+			code, reused, e := exec("", args...)
+			if code != 0 || !strings.Contains(reused, "reused=true") {
+				t.Fatalf("reuse %d %s", code, e)
+			}
+		})
+	}
+}
