+func assertScalarCFONT(t *testing.T, cfg Config, res *Result, orig []byte) {
+	t.Helper()
+	records, e := os.ReadFile(filepath.Join(cfg.PatchDir, "glyphs-"+cfg.Code+".bin"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	changed := map[int][]byte{}
+	for pos := 0; pos < len(records); pos += 32 {
+		code := binary.BigEndian.Uint16(records[pos:])
+		lead, trail := int(code>>8), int(code&255)
+		tail := trail - 0x40
+		if trail > 0x7e {
+			tail = trail - 0x62
+		}
+		index := (lead-0xa4)*157 + tail + 0x16d
+		changed[index] = records[pos+2 : pos+32]
+	}
+	cf := packFile(t, res.Dir, cfontName)
+	for index := 0; index < 13867; index++ {
+		want := orig[index*30 : (index+1)*30]
+		if bitmap, ok := changed[index]; ok && res.Manifest.Adopted > 0 {
+			want = bitmap
+		}
+		if !bytes.Equal(cf[index*30:(index+1)*30], want) {
+			t.Fatalf("independent CFONT grid %d", index)
+		}
+	}
+}
+func TestScalarBuildSnapshotIdentityAndAtomicity(t *testing.T) {
+	for _, code := range []string{"zh-CN", "ja"} {
+		t.Run(code, func(t *testing.T) {
+			cfg := scalarConfig(t, code)
+			orig, e := readOrigInputs(cfg.OrigDir)
+			if e != nil {
+				t.Fatal(e)
+			}
+			zero := mustBuild(t, cfg)
+			if zero.Manifest.Adopted != 0 || zero.Manifest.PatchHash == "" {
+				t.Fatal("zero metadata")
+			}
+			for _, name := range packNames {
+				if !bytes.Equal(packFile(t, zero.Dir, name), orig[name]) {
+					t.Fatal("zero changed", name)
+				}
+			}
+			row := englishOriginalRow(t, "αβ", StatusAccepted)
+			cfg.TableDir = englishTables(t, row)
+			digest, e := ExpectedDigest(cfg)
+			if e != nil {
+				t.Fatal(e)
+			}
+			sourcePath := filepath.Join(cfg.PatchDir, "SOURCE.txt")
+			source, e := os.ReadFile(sourcePath)
+			if e != nil {
+				t.Fatal(e)
+			}
+			calls := 0
+			cfg.hooks = &buildHooks{afterPatchRead: func() {
+				calls++
+				if e := os.WriteFile(sourcePath, []byte("broken"), 0600); e != nil {
+					t.Fatal(e)
+				}
+			}}
+			res := mustBuild(t, cfg)
+			if calls != 1 || res.Digest != digest || res.Manifest.Adopted != 1 {
+				t.Fatal("snapshot")
+			}
+			if _, e := ExpectedDigest(cfg); e == nil {
+				t.Fatal("changed disk patch ignored")
+			}
+			if e := os.WriteFile(sourcePath, source, 0600); e != nil {
+				t.Fatal(e)
+			}
+			cfg.hooks = nil
+			assertScalarCFONT(t, cfg, res, orig[cfontName])
+			p, e := glyphpatch.Load(cfg.PatchDir, code)
+			if e != nil {
+				t.Fatal(e)
+			}
+			a, _ := p.Lookup([]rune{'α'})
+			beta, _ := p.Lookup([]rune{'β'})
+			file := mustParse(t, "SP.MES", packFile(t, res.Dir, "SP.MES"))
+			it, _ := file.Lookup(row.ID)
+			if !bytes.Equal(it.Orig, []byte{byte(a >> 8), byte(a), byte(beta >> 8), byte(beta)}) {
+				t.Fatal("typed positive readback")
+			}
+			if _, e := verify.Verify(res.Dir, verify.Options{OrigHashes: res.Manifest.OrigInputs, ExpectDigest: digest}); e != nil {
+				t.Fatal(e)
+			}
+			if next := mustBuild(t, cfg); !next.Reused || next.Dir != res.Dir {
+				t.Fatal("reuse")
+			}
+			row.Text = "δ"
+			row.AccSHA = AccSHA(row.Text)
+			cfg.TableDir = englishTables(t, row)
+			_, e = Build(cfg)
+			var ve *ViolationsError
+			if !errors.As(e, &ve) || !strings.Contains(e.Error(), "missing-scalar") || len(tmpEntries(t, cfg.PackRoot)) != 0 || len(finalPacks(t, cfg.PackRoot)) != 2 {
+				t.Fatalf("atomic failure %v", e)
+			}
+			if hash, e := verify.ManifestSHA256(res.Dir); e != nil || hash != res.ManifestSHA256 {
+				t.Fatal("old pack changed")
+			}
+			row.AccSHA = AccSHA("stale")
+			cfg.TableDir = englishTables(t, row)
+			stale := mustBuild(t, cfg)
+			if stale.Manifest.Adopted != 0 {
+				t.Fatal("stale accepted adopted")
+			}
+			assertScalarCFONT(t, cfg, stale, orig[cfontName])
+			cfg.TableDir = englishTables(t, englishOriginalRow(t, "αβ", StatusAccepted))
+			cfg.Policy.WithCandidates = true
+			if d, _ := ExpectedDigest(cfg); d == digest {
+				t.Fatal("policy omitted")
+			}
+			cfg.Policy = Policy{}
+			cfg.hooks = &buildHooks{version: "changed"}
+			if d, _ := ExpectedDigest(cfg); d == digest {
+				t.Fatal("version omitted")
+			}
+			cfg.hooks = nil
+			source = bytes.Replace(source, []byte("synthetic-test-v1"), []byte("synthetic-test-v2"), 1)
+			if e := os.WriteFile(sourcePath, source, 0600); e != nil {
+				t.Fatal(e)
+			}
+			changed, e := ExpectedDigest(cfg)
+			if e != nil || changed == digest {
+				t.Fatal("patch omitted")
+			}
+			if next := mustBuild(t, cfg); next.Reused || next.Digest != changed {
+				t.Fatal("changed patch reused")
+			}
+			cfg.PatchDir = scalarPatchDir(t, "ko", 'α')
+			if _, e := Build(cfg); e == nil {
+				t.Fatal("wrong language patch built")
+			}
+		})
+	}
+}
