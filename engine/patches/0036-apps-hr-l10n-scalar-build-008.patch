+// Local tables and Noto bitmaps are opt-in read-only inputs; never embedded.
+func TestScalarLocalAcceptedPilots(t *testing.T) {
+	root, patchRoot := os.Getenv("HR_SCALAR_TABLES"), os.Getenv("HR_SCALAR_PATCHES")
+	if root == "" || patchRoot == "" {
+		t.Skip("local CJK pilots not supplied")
+	}
+	for _, tc := range []struct {
+		code, patch string
+		lens        []int
+	}{{"zh-CN", "sc-pilot-bake1", []int{60, 60}}, {"ja", "ja-pilot-bake1", []int{68, 68}}} {
+		t.Run(tc.code, func(t *testing.T) {
+			cfg := Config{OrigDir: origDirOrSkip(t), TableDir: filepath.Join(root, tc.code), PatchDir: filepath.Join(patchRoot, tc.patch), PackRoot: t.TempDir(), Code: tc.code, Mode: ModeTable}
+			orig, e := readOrigInputs(cfg.OrigDir)
+			if e != nil {
+				t.Fatal(e)
+			}
+			tables, e := readTableFiles(cfg.TableDir)
+			if e != nil {
+				t.Fatal(e)
+			}
+			patch, e := glyphpatch.Load(cfg.PatchDir, tc.code)
+			if e != nil {
+				t.Fatal(e)
+			}
+			digest, e := ExpectedDigest(cfg)
+			if e != nil {
+				t.Fatal(e)
+			}
+			res := mustBuild(t, cfg)
+			if res.Manifest.Adopted != 17 || res.Digest != digest || res.Manifest.PatchHash != patch.Digest() {
+				t.Fatal("pilot identity")
+			}
+			if _, e := verify.Verify(res.Dir, verify.Options{OrigHashes: res.Manifest.OrigInputs, ExpectDigest: digest}); e != nil {
+				t.Fatal(e)
+			}
+			count := 0
+			for _, name := range dataFileNames {
+				original := mustParse(t, name, orig[name])
+				result := mustParse(t, name, packFile(t, res.Dir, name))
+				expected := map[string][]byte{}
+				if raw, ok := tables[name]; ok {
+					tbl, e := LoadTable(bytes.NewReader(raw))
+					if e != nil {
+						t.Fatal(e)
+					}
+					for _, row := range tbl.Rows {
+						if row.Status != StatusAccepted || row.AccSHA != AccSHA(row.Text) {
+							t.Fatal("not accepted")
+						}
+						item, ok := original.Lookup(row.ID)
+						if !ok || row.SrcSHA != SrcSHA(item.Orig) {
+							t.Fatal("source mismatch")
+						}
+						var encoded []byte
+						punct := map[uint16]bool{}
+						for _, r := range row.Text {
+							switch {
+							case r == '\n':
+								encoded = append(encoded, 10)
+							case singleByteOK(r):
+								encoded = append(encoded, byte(r))
+							default:
+								c, ok := patch.Lookup([]rune{r})
+								if !ok {
+									t.Fatal("missing scalar")
+								}
+								encoded = append(encoded, byte(c>>8), byte(c))
+								punct[c] = unicode.IsPunct(r)
+							}
+						}
+						class := ""
+						if original.Kind == KindESP {
+							class, _ = ESPWindowClass(row.ID)
+						}
+						want, vs := budget.WrapAndCheck(budget.Input{ID: row.ID, File: name, Class: class, Orig: item.Orig, Trans: encoded, BreakAfter: func(a, b byte) bool { return punct[uint16(a)<<8|uint16(b)] }})
+						if len(vs) != 0 {
+							t.Fatal(vs)
+						}
+						expected[row.ID] = want
+						count++
+					}
+				}
+				if len(original.Items) != len(result.Items) {
+					t.Fatal("item count changed")
+				}
+				for _, item := range original.Items {
+					want := item.Orig
+					if b, ok := expected[item.ID]; ok {
+						want = b
+					}
+					got, ok := result.Lookup(item.ID)
+					if !ok || !bytes.Equal(got.Orig, want) {
+						t.Fatal("typed readback", item.ID)
+					}
+					if item.ID == "SP.MES#56" {
+						lines := bytes.Split(got.Orig, []byte{10})
+						if len(lines) != len(tc.lens) {
+							t.Fatal("SP lines")
+						}
+						for i, line := range lines {
+							if len(line) != tc.lens[i] {
+								t.Fatal("SP width")
+							}
+						}
+					}
+				}
+			}
+			if count != 17 {
+				t.Fatal("pilot count")
+			}
+			assertScalarCFONT(t, cfg, res, orig[cfontName])
+			if !mustBuild(t, cfg).Reused {
+				t.Fatal("pilot reuse")
+			}
+			t.Logf("adopted=%d patch=%s digest=%s manifest=%s CFONT=%s", count, patch.Digest(), digest, res.ManifestSHA256, sha256Hex(packFile(t, res.Dir, cfontName)))
+		})
+	}
+}
