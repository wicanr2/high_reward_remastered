diff --git a/apps/hr/l10n/scalar.go b/apps/hr/l10n/scalar.go
new file mode 100644
index 0000000..efe93f1
--- /dev/null
+++ b/apps/hr/l10n/scalar.go
@@ -0,0 +1,108 @@
+package l10n
+
+import (
+	"errors"
+	"fmt"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/budget"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/glyphpatch"
+)
+
+// scalarCode is the READY scope, not the set of languages Load can validate.
+func scalarCode(code string) bool { return code == codeSimplified || code == codeJapanese }
+
+func (t *Table) adoptScalar(f *File, policy Policy, code string, patch *glyphpatch.Patch) (map[string][]byte, int, []string, error) {
+	if !scalarCode(code) || patch == nil || patch.Language() != code {
+		return nil, 0, nil, errors.New("l10n: 標量採用需要相同語言的已驗字模補丁")
+	}
+	return t.adopt(f, policy, func(item Item, row Row) ([]byte, []byte, []string) {
+		class := ""
+		if f.Kind == KindESP {
+			var ok bool
+			class, ok = ESPWindowClass(row.ID)
+			if !ok {
+				return nil, nil, []string{"line-width: unknown-window"}
+			}
+		}
+		return prepareScalar(budget.Input{ID: row.ID, File: f.Name, Class: class, Orig: item.Orig}, row.Text, code, patch)
+	})
+}
+
+// prepareScalar owns only a local map of the scalars in this item. It never
+// decodes a custom code through Big5 or changes the immutable patch.
+func prepareScalar(in budget.Input, text, code string, patch *glyphpatch.Patch) (key, final []byte, messages []string) {
+	fail := func(rule, detail string) ([]byte, []byte, []string) { return nil, nil, []string{rule + ": " + detail} }
+	if !scalarCode(code) || patch == nil || patch.Language() != code {
+		return fail("patch", "language-mismatch")
+	}
+	if text == "" {
+		return fail("length", "empty")
+	}
+	if len(text) > 2044 {
+		return fail(budget.RuleLength, fmt.Sprintf("source-bytes=%d limit=2044", len(text)))
+	}
+	if !utf8.ValidString(text) {
+		return fail("source", "invalid-utf8")
+	}
+	if n := utf8.RuneCountInString(text); n > 511 {
+		return fail(budget.RuleLength, fmt.Sprintf("source-scalars=%d limit=511", n))
+	}
+	if _, vs := budget.Limits(in); len(vs) > 0 {
+		return nil, nil, violationStrings(vs)
+	}
+	cs := &Charmap{toBig: map[rune]uint16{}, fromBig: map[uint16]rune{}}
+	for off := 0; off < len(text); {
+		r, n := utf8.DecodeRuneInString(text[off:])
+		if r == '%' {
+			// Keep the L1 grammar and its Encode behavior. The shared budget parser
+			// later checks exact supported specifications against the typed original.
+			count := PercentSpecLen(text[off:])
+			if count == 0 {
+				return fail(budget.RulePlaceholder, fmt.Sprintf("malformed offset=%d", off))
+			}
+			off += count
+			continue
+		}
+		off += n
+		if r == '\n' {
+			continue
+		}
+		if r == ' ' {
+			return fail(budget.RuleSpace, "U+0020")
+		}
+		if !(unicode.IsLetter(r) || unicode.IsNumber(r) || unicode.IsPunct(r) || unicode.IsSymbol(r) || unicode.Is(unicode.Zs, r)) ||
+			unicode.IsSpace(r) && r != 0x3000 {
+			return fail("source", fmt.Sprintf("unsupported U+%04X", r))
+		}
+		if singleByteOK(r) {
+			continue
+		}
+		if _, ok := cs.toBig[r]; ok {
+			continue
+		}
+		encoded, ok := patch.Lookup([]rune{r})
+		if !ok {
+			return fail("missing-scalar", fmt.Sprintf("U+%04X", r))
+		}
+		cs.toBig[r], cs.fromBig[encoded] = encoded, r
+	}
+	encoded, _, err := cs.Encode(text)
+	if err != nil {
+		return fail("encode", err.Error())
+	}
+	if len(encoded) > 511 {
+		return fail(budget.RuleLength, fmt.Sprintf("raw=%d limit=511", len(encoded)))
+	}
+	in.Trans = encoded
+	in.BreakAfter = func(lead, trail byte) bool {
+		r, ok := cs.fromBig[uint16(lead)<<8|uint16(trail)]
+		return ok && unicode.IsPunct(r)
+	}
+	wrapped, vs := budget.WrapAndCheck(in)
+	if len(vs) > 0 {
+		return nil, nil, violationStrings(vs)
+	}
+	return encoded, wrapped, nil
+}
