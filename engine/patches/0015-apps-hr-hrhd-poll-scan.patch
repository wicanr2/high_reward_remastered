+package main
+
+import (
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// pollScan 取 n 個拉取式快照（RequestFrame，輪詢點產生），統計最新的游標戳記是否整個不透明區都與 VRAM 相符
+// （docs/spec/004 第 7 節「快照完整」：輪詢路徑應大於 95%）。
+func pollScan(s *hrrt.Session, n int) {
+	var vf hd.Verifier
+	full, total, noCursor := 0, 0, 0
+	var hist [4]int // 游標相符：0、(0,50%)、[50%,100%)、100%
+	for i := 0; i < n; i++ {
+		var seq uint64
+		if f := s.Frame(); f != nil {
+			seq = f.Seq
+		}
+		s.RequestFrame()
+		for k := 0; k < 400; k++ {
+			if f := s.Frame(); f != nil && f.Seq != seq {
+				break
+			}
+			if st := s.RunSteps(s.Machine().Steps + 20_000); st.Kind != hrrt.StopSteps {
+				fmt.Println("提前停機：", st.Msg)
+				return
+			}
+		}
+		f := s.Frame()
+		if f == nil || f.Seq == seq {
+			continue
+		}
+		idx := -1
+		for j := len(f.Stamps) - 1; j >= 0; j-- {
+			if f.Stamps[j].Site == hd.CursorSite {
+				idx = j
+				break
+			}
+		}
+		if idx < 0 {
+			noCursor++
+			continue
+		}
+		masks := vf.Run(f.Stamps, f.Px, f.W, f.H)
+		opaque := 0
+		for _, e := range f.Stamps[idx].E {
+			if e != hd.Transparent {
+				opaque++
+			}
+		}
+		st := f.Stamps[idx]
+		raw := 0
+		for j := 0; j < st.H; j++ {
+			for i := 0; i < st.W; i++ {
+				e := st.E[j*st.W+i]
+				if e != hd.Transparent && st.X+i < f.W && st.Y+j < f.H && f.Px[(st.Y+j)*f.W+st.X+i] == e {
+					raw++
+				}
+			}
+		}
+		switch {
+		case raw == opaque:
+			hist[3]++
+		case raw*2 >= opaque:
+			hist[2]++
+		case raw > 0:
+			hist[1]++
+		default:
+			hist[0]++
+		}
+		total++
+		if masks[idx].Count() == opaque {
+			full++
+		}
+		// 讓下一個快照落在不同的位置：多跑一段不固定長度的指令
+		s.RunSteps(s.Machine().Steps + 37_001 + uint64(i%7)*911)
+	}
+	fmt.Printf("游標原始相符分布：0%% %d，(0,50%%) %d，[50%%,100%%) %d，100%% %d\n", hist[0], hist[1], hist[2], hist[3])
+	fmt.Printf("快照完整：%d 個快照中游標矩形完整 %d 個（%.1f%%），沒有游標戳記 %d 個\n", total, full, 100*float64(full)/float64(max(total, 1)), noCursor)
+}
