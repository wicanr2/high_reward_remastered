---
 apps/hr/hd/verify.go      |  6 +++++-
 apps/hr/hd/verify_test.go | 38 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/apps/hr/hd/verify.go b/apps/hr/hd/verify.go
index 849ee30..73a4cc8 100644
--- a/apps/hr/hd/verify.go
+++ b/apps/hr/hd/verify.go
@@ -149,7 +149,7 @@ func (v *Verifier) one(s *Stamp, px []uint8, pxW, pxH int, vm Mask) {
 	default:
 		v.Slow++
 		v.neighborhood(s, vm, O, M)
-		if !v.KeepFlat {
+		if !v.KeepFlat && s.W*s.H <= FlatMaxArea {
 			v.FlatDropped += v.dropFlat(s, vm)
 		}
 	}
@@ -313,3 +313,7 @@ func (v *Verifier) dropFlat(s *Stamp, vm Mask) int {
 	}
 	return dropped
 }
+
+// FlatMaxArea 是第 2b 步處理的戳記面積上限（像素）。背景類的大戳記（`GMAP`、`BSTAGE`）不做：
+// 洪水填充的成本高（審查實測驗證階段多 4 至 7 ms），移除的又多是 4 個像素以下的碎點，視覺上沒有好處。
+const FlatMaxArea = 16384
diff --git a/apps/hr/hd/verify_test.go b/apps/hr/hd/verify_test.go
index 8e69859..6651a61 100644
--- a/apps/hr/hd/verify_test.go
+++ b/apps/hr/hd/verify_test.go
@@ -405,3 +405,41 @@ func TestVerifyFlatDropsGhost(t *testing.T) {
 		t.Fatal("FlatDropped 應大於 0")
 	}
 }
+
+// 面積超過 FlatMaxArea 的戳記不做第 2b 步（單色連通區保留）。
+func TestVerifyFlatSkipsLargeStamps(t *testing.T) {
+	const pxW, pxH = 400, 200
+	px := make([]uint8, pxW*pxH)
+	s := &Stamp{W: 200, H: 100, X: 0, Y: 0, E: make([]byte, 200*100), Seq: 1}
+	if s.W*s.H <= FlatMaxArea {
+		t.Fatal("測試戳記要大於 FlatMaxArea")
+	}
+	for i := range s.E {
+		s.E[i] = 3
+	}
+	// 左半相符、右半被別的東西蓋住：留下單色的相符區
+	for j := 0; j < 100; j++ {
+		for i := 0; i < 100; i++ {
+			px[j*pxW+i] = 3
+		}
+	}
+	var vf Verifier
+	m := vf.Run([]*Stamp{s}, px, pxW, pxH)
+	if vf.FlatDropped != 0 || m[0].Count() == 0 {
+		t.Fatalf("大戳記不該做第 2b 步：移除 %d，通過 %d", vf.FlatDropped, m[0].Count())
+	}
+	// 同樣的內容縮小到上限內就會被移除
+	small := &Stamp{W: 100, H: 100, X: 0, Y: 0, E: make([]byte, 100*100), Seq: 1}
+	for i := range small.E {
+		small.E[i] = 3
+	}
+	for j := 0; j < 100; j++ {
+		for i := 50; i < 100; i++ {
+			px[j*pxW+i] = 0
+		}
+	}
+	m = vf.Run([]*Stamp{small}, px, pxW, pxH)
+	if vf.FlatDropped == 0 || m[0].Count() != 0 {
+		t.Fatalf("小戳記的單色區應被移除：移除 %d，通過 %d", vf.FlatDropped, m[0].Count())
+	}
+}
