+
+func newLangFixture(t *testing.T) *langFixture {
+	t.Helper()
+	base := t.TempDir()
+	f := &langFixture{
+		base:    base,
+		root:    filepath.Join(base, "root"),
+		lang:    filepath.Join(base, "l10n-packs", "zh", "files"),
+		scratch: filepath.Join(base, "scratch"),
+	}
+	for _, dir := range []string{f.root, f.lang, f.scratch} {
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// manifest.json 放在 files/ 之外，searchFor 與目錄列舉看不到它。
+	if err := os.WriteFile(filepath.Join(base, "l10n-packs", "zh", "manifest.json"), []byte("{}"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return f
+}
+
+func (f *langFixture) dir(layer string) string {
+	switch layer {
+	case "root":
+		return f.root
+	case "lang":
+		return f.lang
+	case "scratch":
+		return f.scratch
+	}
+	panic("沒有這一層：" + layer)
+}
+
+func (f *langFixture) put(t *testing.T, layer, name, body string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(f.dir(layer), name), []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func (f *langFixture) exists(layer, name string) bool {
+	_, err := os.Stat(filepath.Join(f.dir(layer), name))
+	return err == nil
+}
+
+// dos 造服務層：原版目錄一定有；語言層與暫存層依參數。
+func (f *langFixture) dos(t *testing.T, lang, scratch bool) (*machine.Machine, *DOS) {
+	t.Helper()
+	m := machine.New()
+	d := New(m, f.root)
+	if lang {
+		d.LangDir = f.lang
+	}
+	if scratch {
+		d.Scratch = f.scratch
+	}
+	d.Install()
+	d.freeSeg = 0x2000
+	return m, d
+}
+
+// langOpen 以 AH=3Dh 開檔（mode ＝ AL：0 唯讀、1 唯寫、2 讀寫）。
+func langOpen(m *machine.Machine, d *DOS, name string, mode uint16) (ax uint16, cf bool) {
+	c := m.CPU
+	putName(m, c, name)
+	int21(m, d, 0x3D00|mode)
+	return c.R[cpu.AX], c.Flags&cpu.CF != 0
+}
+
+func closeFile(m *machine.Machine, d *DOS, h uint16) {
+	m.CPU.R[cpu.BX] = h
+	int21(m, d, 0x3E00)
+}
+
+// readFile 開檔讀出內容再關檔；開不起來回 ok ＝ false。
+func readFile(m *machine.Machine, d *DOS, name string) (body string, ok bool) {
+	h, cf := langOpen(m, d, name, 0)
+	if cf {
+		return "", false
+	}
+	c := m.CPU
+	c.Seg[cpu.DS], c.R[cpu.DX], c.R[cpu.BX], c.R[cpu.CX] = 0x1000, 0x0300, h, 64
+	int21(m, d, 0x3F00)
+	n := int(c.R[cpu.AX])
+	buf := make([]byte, n)
+	for i := range buf {
+		buf[i] = m.Read8(cpu.Addr(0x1000, 0x0300) + uint32(i))
+	}
+	closeFile(m, d, h)
+	return string(buf), true
+}
