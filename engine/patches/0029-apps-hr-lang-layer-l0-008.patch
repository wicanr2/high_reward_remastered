+			var b bytes.Buffer
+			if err := saved.SaveState(&b); err != nil {
+				t.Fatal(err)
+			}
+			cur := langDOS(t, c.curDir, c.curMan)
+			pre := cur.PreflightState(bytes.NewReader(b.Bytes()))
+			err := cur.LoadState(bytes.NewReader(b.Bytes()))
+			if (err != nil) != c.wantErr || (pre != nil) != c.wantErr {
+				t.Fatalf("LoadState 錯誤 ＝ %v，PreflightState 錯誤 ＝ %v，預期有錯 ＝ %v", err, pre, c.wantErr)
+			}
+			for _, want := range c.wantMentions {
+				if !strings.Contains(err.Error(), want) || !strings.Contains(pre.Error(), want) {
+					t.Errorf("錯誤訊息沒有點名 %q：\n%v\n%v", want, err, pre)
