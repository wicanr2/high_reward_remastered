+// ---- resolve 的順序 ----
+
+func TestResolveOrderScratchLangRoot(t *testing.T) {
+	cases := []struct {
+		name               string
+		root, lang, scr    bool
+		wantLayer          Layer
+		wantBody, wantFrom string
+	}{
+		{"只有原版", true, false, false, LayerRoot, "root", "root"},
+		{"原版與語言層：語言層蓋過原版", true, true, false, LayerLang, "lang", "lang"},
+		{"只有語言層", false, true, false, LayerLang, "lang", "lang"},
+		{"三層都有：暫存層蓋過語言層", true, true, true, LayerScratch, "scratch", "scratch"},
+		{"原版與暫存層", true, false, true, LayerScratch, "scratch", "scratch"},
+		{"語言層與暫存層", false, true, true, LayerScratch, "scratch", "scratch"},
+		{"都沒有", false, false, false, LayerNone, "", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			f := newLangFixture(t)
+			for layer, on := range map[string]bool{"root": c.root, "lang": c.lang, "scratch": c.scr} {
+				if on {
+					f.put(t, layer, "X.DAT", layer)
+				}
+			}
+			_, d := f.dos(t, true, true)
+			p, layer := d.resolve("X.DAT")
+			if layer != c.wantLayer {
+				t.Fatalf("層別 %q，預期 %q（路徑 %q）", layer, c.wantLayer, p)
+			}
+			if c.wantFrom == "" {
+				if p != "" {
+					t.Fatalf("找不到時路徑應為空，得到 %q", p)
+				}
+				return
+			}
+			if filepath.Dir(p) != f.dir(c.wantFrom) {
+				t.Errorf("路徑 %q 不在 %s 層的目錄 %q", p, c.wantFrom, f.dir(c.wantFrom))
+			}
+			if b, _ := os.ReadFile(p); string(b) != c.wantBody {
+				t.Errorf("內容 %q，預期 %q", b, c.wantBody)
+			}
+		})
+	}
+}
