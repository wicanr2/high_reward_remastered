diff --git a/apps/hr/runtime/lang.go b/apps/hr/runtime/lang.go
new file mode 100644
index 0000000..fd87429
--- /dev/null
+++ b/apps/hr/runtime/lang.go
@@ -0,0 +1,96 @@
+package runtime
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// 語言層（hr `docs/spec/008` 第 3.1 節，L0）。
+
+// normDir 把目錄正規化成 `filepath.Abs` 加 `filepath.Clean`。
+func normDir(p string) (string, error) {
+	abs, err := filepath.Abs(p)
+	if err != nil {
+		return "", err
+	}
+	return filepath.Clean(abs), nil
+}
+
+// langDataFiles 是診斷「語言層」區段列命中層的檔案：七個資料檔與字模（`docs/spec/008` 第 1 節）。
+var langDataFiles = []string{
+	"COUNTRY.MES", "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES", "ESPMES.MRG", "SHOPTAB.TBL", "CFONT.15",
+}
+
+// bindLang 在 `dos.Install` 之前把 Options.LangDir 綁到 DOS 的語言層，之後執行中不變。
+//
+// L0 的暫時做法：**不驗證 manifest 的內容**，只讀 `<LangDir>/../manifest.json` 的原始位元組算 SHA-256
+// 當 `LangManifest`（缺檔回錯）。L1 換成 `apps/hr/l10n/verify` 的 manifest 驗證，驗證失敗時以空 LangDir 開啟，
+// 並經 `Session.LangStatus()` 回報原因。
+//
+// `LangDir` 正規化成 `filepath.Abs` 加 `filepath.Clean`。指向不存在的目錄（或不是目錄）時，
+// 生效值清為空字串（LangManifest 一併清空，不去讀它的 manifest），記一行，不回錯：
+// 狀態檔記錄的是生效值，所以這個 Session 與沒有語言包的 Session 載入同一個狀態檔。
+// 與 `cmd/probe`、`apps/hr/cmd/hrsoak` 各自實作同一組規則（它們是通用工具，不能 import 本套件的驗證碼），
+// 測試以同一個目錄斷言三者算出相同值。
+//
+// 層重疊防呆：正規化之後的 `LangDir` 等於原版目錄（root）或暫存層（saveDir，空字串不比）就回錯。
+// 整個原版目錄變成語言層時，寫入模式開檔一律被拒，與原版目錄「寫入只記帳」的行為不同；
+// 暫存層與語言層同一目錄則存檔會寫進語言層。設定錯誤的保險，正式路徑（`l10n-packs/<名稱>/files`）不會遇到。
+func (s *Session) bindLang(dir, root, saveDir string) error {
+	if dir == "" {
+		return nil
+	}
+	abs, err := normDir(dir)
+	if err != nil {
+		return fmt.Errorf("語言層目錄 %q：%w", dir, err)
+	}
+	if st, err := os.Stat(abs); err != nil || !st.IsDir() {
+		s.logf("語言層目錄不存在或不是目錄，遊戲內文字維持原版：%s", abs)
+		return nil
+	}
+	for _, other := range []struct{ name, path string }{{"原版目錄", root}, {"暫存層（SaveDir）", saveDir}} {
+		if other.path == "" {
+			continue
+		}
+		o, err := normDir(other.path)
+		if err != nil {
+			return fmt.Errorf("%s %q：%w", other.name, other.path, err)
+		}
+		if o == abs {
+			return fmt.Errorf("語言層目錄與%s是同一個目錄（%s）", other.name, abs)
+		}
+	}
+	raw, err := os.ReadFile(filepath.Join(abs, "..", "manifest.json"))
+	if err != nil {
+		return fmt.Errorf("語言包缺 manifest.json（%s 的上一層）：%w", abs, err)
+	}
+	sum := sha256.Sum256(raw)
+	s.d.LangDir, s.d.LangManifest = abs, hex.EncodeToString(sum[:])
+	return nil
+}
+
+// langSection 是診斷 info.txt 的「語言層」區段（`docs/spec/005` 第 5 節）：三項是 LangDir 的值、
+// 語言包 manifest 的 SHA-256、各資料檔與 CFONT.15 的命中層（取自 `DOS.OpenedLayers`，首次與最近一次）。
+// 沒有語言包時三項皆空。三個 trigger（T1 CrashDump、T2、T3）都經 diagSections，所以都有這一區段。
+func (s *Session) langSection() string {
+	var b strings.Builder
+	d := s.d
+	b.WriteString("\n== 語言層 ==\n")
+	if d.LangDir == "" {
+		b.WriteString("LangDir：\nmanifest SHA-256：\n開檔命中層：\n")
+		return b.String()
+	}
+	fmt.Fprintf(&b, "LangDir：%s\nmanifest SHA-256：%s\n開檔命中層：\n", d.LangDir, d.LangManifest)
+	for _, name := range langDataFiles {
+		if e, ok := d.OpenedLayers[name]; ok {
+			fmt.Fprintf(&b, "  %s  首次 %s  最近 %s\n", name, e.First, e.Last)
+		} else {
+			fmt.Fprintf(&b, "  %s  未開啟\n", name)
+		}
+	}
+	return b.String()
+}
diff --git a/apps/hr/runtime/lang_test.go b/apps/hr/runtime/lang_test.go
new file mode 100644
index 0000000..d90316d
--- /dev/null
+++ b/apps/hr/runtime/lang_test.go
@@ -0,0 +1,433 @@
+package runtime
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/machine"
+	"github.com/wicanr2/dosgolem/internal/state"
+)
+
+// 語言層（docs/spec/008 第 3.1 節，L0）在執行層的部分：LangDir 綁定、診斷「語言層」區段、開檔層報告。
+// 需要原版的測試缺檔就 skip（origRoot）。原版檔案只在測試執行時複製進 t.TempDir() 的臨時語言包，不進儲存庫。
+
+// helloSHA 是 manifest 內容 "hello" 的 SHA-256。probe、hrsoak、Session 三處的測試用同一個固定值，
+// 斷言三處對同一個目錄算出相同的 LangManifest。
+const helloSHA = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
+
+// makePack 造語言包目錄：<pack>/manifest.json（內容 "hello"，在 files/ 之外）與 <pack>/files/。
+// names 是要放進 files/ 的原版檔名，內容取自原版目錄 root（root 為空則放合成內容）。
+func makePack(t *testing.T, root string, names ...string) (filesDir string) {
+	t.Helper()
+	pack := t.TempDir()
+	filesDir = filepath.Join(pack, "files")
+	if err := os.MkdirAll(filesDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(pack, "manifest.json"), []byte("hello"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	for _, n := range names {
+		body := []byte("synthetic " + n)
+		if root != "" {
+			b, err := os.ReadFile(filepath.Join(root, n))
+			if err != nil {
+				t.Fatal(err)
+			}
+			body = b
+		}
+		if err := os.WriteFile(filepath.Join(filesDir, n), body, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return filesDir
+}
+
+func bindSession() (*Session, *[]string) {
+	var logs []string
+	s := &Session{d: dos.New(machine.New(), "."), logf: func(f string, a ...any) { logs = append(logs, f) }}
+	return s, &logs
+}
+
+// bindLang：空值不動；不存在或不是目錄時生效值清為空（不回錯、記一行）；正規化；manifest 雜湊；缺 manifest 回錯。
+func TestBindLang(t *testing.T) {
+	t.Run("空字串", func(t *testing.T) {
+		s, logs := bindSession()
+		if err := s.bindLang("", "/r", "/s"); err != nil || s.d.LangDir != "" || s.d.LangManifest != "" || len(*logs) != 0 {
+			t.Errorf("err ＝ %v LangDir ＝ %q 記錄 %v", err, s.d.LangDir, *logs)
+		}
+	})
+	t.Run("目錄不存在：生效值清為空，不回錯，記一行", func(t *testing.T) {
+		s, logs := bindSession()
+		if err := s.bindLang(filepath.Join(t.TempDir(), "nope", "files"), "", ""); err != nil {
+			t.Fatalf("不存在的目錄不該回錯：%v", err)
+		}
+		if s.d.LangDir != "" || s.d.LangManifest != "" || len(*logs) != 1 {
+			t.Errorf("LangDir ＝ %q LangManifest ＝ %q 記錄 %v", s.d.LangDir, s.d.LangManifest, *logs)
+		}
+	})
+	t.Run("不是目錄", func(t *testing.T) {
+		s, _ := bindSession()
+		f := filepath.Join(t.TempDir(), "afile")
+		if err := os.WriteFile(f, []byte("x"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		if err := s.bindLang(f, "", ""); err != nil || s.d.LangDir != "" {
+			t.Errorf("err ＝ %v LangDir ＝ %q", err, s.d.LangDir)
+		}
+	})
+	t.Run("正規化與 manifest 雜湊", func(t *testing.T) {
+		files := makePack(t, "", "SP.MES")
+		s, _ := bindSession()
+		messy := files + string(filepath.Separator) + ".." + string(filepath.Separator) + "files" + string(filepath.Separator)
+		if err := s.bindLang(messy, t.TempDir(), t.TempDir()); err != nil {
+			t.Fatal(err)
+		}
+		if s.d.LangDir != filepath.Clean(files) {
+			t.Errorf("LangDir ＝ %q，預期 %q", s.d.LangDir, filepath.Clean(files))
+		}
+		if s.d.LangManifest != helloSHA {
+			t.Errorf("LangManifest ＝ %s，預期 %s", s.d.LangManifest, helloSHA)
+		}
+		raw := sha256.Sum256([]byte("hello"))
+		if hex.EncodeToString(raw[:]) != helloSHA {
+			t.Fatal("測試常數 helloSHA 與 sha256(\"hello\") 不符")
+		}
+	})
+	t.Run("相對路徑轉成絕對路徑", func(t *testing.T) {
+		files := makePack(t, "")
+		t.Chdir(filepath.Dir(files))
+		s, _ := bindSession()
+		if err := s.bindLang("files", "", ""); err != nil {
+			t.Fatal(err)
+		}
+		if s.d.LangDir != filepath.Clean(files) || s.d.LangManifest != helloSHA {
+			t.Errorf("LangDir ＝ %q LangManifest ＝ %q", s.d.LangDir, s.d.LangManifest)
+		}
+	})
+	t.Run("缺 manifest 回錯", func(t *testing.T) {
+		files := makePack(t, "")
+		if err := os.Remove(filepath.Join(filepath.Dir(files), "manifest.json")); err != nil {
+			t.Fatal(err)
+		}
+		s, _ := bindSession()
+		err := s.bindLang(files, "", "")
+		if err == nil || !strings.Contains(err.Error(), "manifest.json") {
+			t.Fatalf("缺 manifest 應回錯並點名檔名：%v", err)
+		}
+		if s.d.LangDir != "" {
+			t.Errorf("回錯時不該綁定：LangDir ＝ %q", s.d.LangDir)
+		}
+	})
+}
+
+// 層重疊防呆：LangDir 與原版目錄或暫存層（SaveDir）正規化後相同就回錯（不論路徑怎麼拼），不綁定。
+func TestBindLangRefusesOverlappingLayers(t *testing.T) {
+	files := makePack(t, "")
+	unclean := files + string(filepath.Separator) + "." + string(filepath.Separator) + ".." + string(filepath.Separator) + "files"
+	other := t.TempDir()
+	cases := []struct {
+		name        string
+		root, saves string
+		wantErr     string
+	}{
+		{"與原版目錄相同", files, other, "原版目錄"},
+		{"與原版目錄相同（拼法不同）", unclean, other, "原版目錄"},
+		{"與暫存層相同", other, files, "暫存層"},
+		{"與暫存層相同（拼法不同）", other, unclean, "暫存層"},
+		{"沒有重疊", other, "", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			s, _ := bindSession()
+			err := s.bindLang(files, c.root, c.saves)
+			if c.wantErr == "" {
+				if err != nil || s.d.LangDir != filepath.Clean(files) {
+					t.Fatalf("不該回錯：err ＝ %v LangDir ＝ %q", err, s.d.LangDir)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), c.wantErr) || !strings.Contains(err.Error(), "同一個目錄") {
+				t.Fatalf("應回錯並點名 %s：%v", c.wantErr, err)
+			}
+			if s.d.LangDir != "" || s.d.LangManifest != "" {
+				t.Errorf("回錯時不該綁定：LangDir ＝ %q", s.d.LangDir)
+			}
+		})
+	}
+}
+
+// Open 層：LangDir 等於原版目錄或 SaveDir 時拒絕開啟（需原版）。
+func TestOpenRefusesLangDirEqualToRootOrSaveDir(t *testing.T) {
+	root := origRoot(t)
+	if _, err := Open(root, Options{LangDir: root}); err == nil || !strings.Contains(err.Error(), "同一個目錄") {
+		t.Errorf("LangDir 等於原版目錄應拒絕：%v", err)
+	}
+	files := makePack(t, "", "SP.MES")
+	if _, err := Open(root, Options{LangDir: files, SaveDir: files}); err == nil || !strings.Contains(err.Error(), "同一個目錄") {
+		t.Errorf("LangDir 等於 SaveDir 應拒絕：%v", err)
+	}
+}
+
+// 診斷的「語言層」區段（docs/spec/005 第 5 節）：沒有語言包時三項皆空；有時列出三項與各資料檔的命中層。
+func TestLangSection(t *testing.T) {
+	s, _ := bindSession()
+	if got, want := s.langSection(), "\n== 語言層 ==\nLangDir：\nmanifest SHA-256：\n開檔命中層：\n"; got != want {
+		t.Errorf("沒有語言包：\n%q\n預期 %q", got, want)
+	}
+	// 沒有語言包時，即使開過檔也不列命中層（三項皆空）。
+	s.d.OpenedLayers = map[string]dos.OpenedLayer{"CFONT.15": {First: "root", Last: "root"}}
+	if got := s.langSection(); strings.Contains(got, "CFONT.15") {
+		t.Errorf("沒有語言包時不該列命中層：%q", got)
+	}
+	s.d.LangDir, s.d.LangManifest = "/p/zh/files", helloSHA
+	s.d.OpenedLayers = map[string]dos.OpenedLayer{
+		"CFONT.15":    {First: "lang", Last: "lang"},
+		"ESPMES.MRG":  {First: "lang", Last: "scratch"},
+		"SHOPTAB.TBL": {First: "root", Last: "root"},
+	}
+	got := s.langSection()
+	for _, want := range []string{
+		"== 語言層 ==\nLangDir：/p/zh/files\n", "manifest SHA-256：" + helloSHA + "\n", "開檔命中層：\n",
+		"  CFONT.15  首次 lang  最近 lang\n", "  ESPMES.MRG  首次 lang  最近 scratch\n", "  SHOPTAB.TBL  首次 root  最近 root\n",
+		"  SP.MES  未開啟\n", "  COUNTRY.MES  未開啟\n",
+	} {
+		if !strings.Contains(got, want) {
+			t.Errorf("語言層區段缺 %q：\n%s", want, got)
+		}
+	}
+}
+
+// OpenedLayers 不被 TrimDiagnostics 清（Opened 會被清）：ESPMES.MRG 每兩遊戲小時開上百次，環或清除會洗掉只開一次的 CFONT.15。
+func TestTrimKeepsOpenedLayers(t *testing.T) {
+	m := machine.New()
+	d := dos.New(m, ".")
+	d.Opened = []string{"CFONT.15"}
+	d.OpenedLayers = map[string]dos.OpenedLayer{"CFONT.15": {First: "lang", Last: "lang"}}
+	TrimDiagnostics(m, d)
+	if len(d.Opened) != 0 {
+		t.Fatal("測試前置：Opened 應被清掉")
+	}
+	if got := d.OpenedLayers["CFONT.15"]; got.First != "lang" || got.Last != "lang" {
+		t.Errorf("OpenedLayers 被清了：%v", d.OpenedLayers)
+	}
+}
+
+func TestOpenLangDirMissingManifestFails(t *testing.T) {
+	root := origRoot(t)
+	files := makePack(t, "", "SP.MES")
+	if err := os.Remove(filepath.Join(filepath.Dir(files), "manifest.json")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Open(root, Options{LangDir: files}); err == nil || !strings.Contains(err.Error(), "manifest.json") {
+		t.Fatalf("缺 manifest 應拒絕啟動：%v", err)
+	}
+}
+
+func TestOpenNonexistentLangDirClearsToEmpty(t *testing.T) {
+	root := origRoot(t)
+	var logs []string
+	s, err := Open(root, Options{LangDir: filepath.Join(t.TempDir(), "nope", "files"), Log: func(f string, a ...any) { logs = append(logs, f) }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.DOS().LangDir != "" || s.DOS().LangManifest != "" {
+		t.Errorf("生效值應清為空：LangDir ＝ %q LangManifest ＝ %q", s.DOS().LangDir, s.DOS().LangManifest)
+	}
+	found := false
+	for _, l := range logs {
+		found = found || strings.Contains(l, "語言層目錄")
+	}
+	if !found {
+		t.Errorf("應記一行：%v", logs)
+	}
+}
+
+// openWithClick 照收據 B（docs/re/008）：冷啟動，第 3500 萬道指令點新遊戲，跑到 9000 萬道指令。
+func openWithClick(t *testing.T, root string, opt Options) *Session {
+	t.Helper()
+	opt.Interval = NativeInterval
+	s, err := Open(root, opt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.RunSteps(35_000_000)
+	s.Input(Event{Kind: EvMouseButton, X: 312, Y: 171, Btn: 0, Down: true})
+	s.Input(Event{Kind: EvMouseButton, X: 312, Y: 171, Btn: 0, Down: false})
+	if st := s.RunSteps(90_000_000); st.Kind != StopSteps {
+		t.Fatalf("提前停機：%v", st)
+	}
+	return s
+}
+
+// 開檔層報告（需原版，冷啟動）：七個資料檔與 CFONT.15 的臨時語言包（內容與原版相同）放進 LangDir，
+// 冷啟動走到新遊戲第一畫面，開過的資料檔必須從語言層開啟。負對照：語言包少放 ESPMES.MRG，它必須落回原版。
+// 90M 步內遊戲只開 CFONT.15 與 ESPMES.MRG；其餘資料檔的逐檔開檔層由 dos 套件的單元測試涵蓋。
+func TestColdStartOpensDataFilesFromLangLayer(t *testing.T) {
+	root := origRoot(t)
+	files := makePack(t, root, langDataFiles...)
+	s := openWithClick(t, root, Options{LangDir: files, NoPacing: true})
+	d := s.DOS()
+	if d.LangDir != filepath.Clean(files) || d.LangManifest != helloSHA {
+		t.Fatalf("LangDir ＝ %q LangManifest ＝ %q", d.LangDir, d.LangManifest)
+	}
+	opened := 0
+	for _, n := range langDataFiles {
+		e, ok := d.OpenedLayers[n]
+		if !ok {
+			continue
+		}
+		opened++
+		if e.First != "lang" || e.Last != "lang" {
+			t.Errorf("%s 的命中層 ＝ %+v，預期 lang", n, e)
+		}
+	}
+	for _, must := range []string{"CFONT.15", "ESPMES.MRG"} {
+		if _, ok := d.OpenedLayers[must]; !ok {
+			t.Errorf("冷啟動 9000 萬步內應開過 %s：%v", must, d.OpenedLayers)
+		}
+	}
+	t.Logf("90M 步內開過的資料檔 %d 個", opened)
+	// 臨時語言包的內容與原版相同，畫面必須與收據 B 相同（identity 包不改變遊戲）。
+	const wantB = "853a695340271b1e2540702d6d5f1e78f3807e230c666a181e3985097879adaf"
+	if got := pngHash(t, s); got != wantB {
+		t.Errorf("identity 語言包的畫面 PNG 雜湊 %s，預期收據 B %s", got, wantB)
+	}
+
+	// 負對照：少放 ESPMES.MRG。
+	var rest []string
+	for _, n := range langDataFiles {
+		if n != "ESPMES.MRG" {
+			rest = append(rest, n)
+		}
+	}
+	s2 := openWithClick(t, root, Options{LangDir: makePack(t, root, rest...), NoPacing: true})
+	if e := s2.DOS().OpenedLayers["ESPMES.MRG"]; e.First != "root" || e.Last != "root" {
+		t.Errorf("語言包沒有 ESPMES.MRG，應落回原版：%+v", e)
+	}
+	if e := s2.DOS().OpenedLayers["CFONT.15"]; e.First != "lang" {
+		t.Errorf("CFONT.15 仍應來自語言層：%+v", e)
+	}
+}
+
+// 診斷（T1、T2、T3）的「語言層」區段：有語言包時帶三項與命中層。
+func TestDiagLangSectionWithPack(t *testing.T) {
+	root := origRoot(t)
+	files := makePack(t, root, "CFONT.15")
+	check := func(t *testing.T, text string) {
+		t.Helper()
+		hasInfoSections(t, text)
+		for _, want := range []string{
+			"LangDir：" + filepath.Clean(files) + "\n", "manifest SHA-256：" + helloSHA + "\n",
+			"  CFONT.15  首次 lang  最近 lang\n", "  ESPMES.MRG  未開啟\n",
+		} {
+			if !strings.Contains(text, want) {
+				t.Errorf("info.txt 的語言層區段缺 %q", want)
+			}
+		}
+	}
+	t.Run("T1", func(t *testing.T) {
+		s := openDiag(t, Options{Interval: NativeInterval, LangDir: files})
+		s.RunSteps(5_000_000)
+		dir := filepath.Join(t.TempDir(), "crash")
+		if err := s.CrashDump(dir, "測試"); err != nil {
+			t.Fatal(err)
+		}
+		b, err := os.ReadFile(filepath.Join(dir, "info.txt"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		check(t, string(b))
+	})
+	t.Run("T2", func(t *testing.T) {
+		h := newHangWith(t, Options{HangSeconds: 3, LangDir: files})
+		cs, ip := h.patchHere(0xEB, 0xFE)
+		h.run(t, 3.6)
+		h.checkOne(t, cs, ip)
+		b, err := os.ReadFile(filepath.Join(h.dirs[0], "info.txt"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		check(t, string(b))
+	})
+	t.Run("T3", func(t *testing.T) {
+		var dirs []string
+		s := openDiag(t, Options{LangDir: files, DiagDir: filepath.Join(t.TempDir(), "crash"), OnDiag: func(dir, reason string) { dirs = append(dirs, dir) }})
+		s.RunSteps(2_000_000)
+		before := s.m.Steps
+		s.RequestDiag("按鍵")
+		s.RunSteps(before + 10_000)
+		if len(dirs) != 1 {
+			t.Fatalf("手動診斷：%v", dirs)
+		}
+		b, err := os.ReadFile(filepath.Join(dirs[0], "info.txt"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		check(t, string(b))
+	})
+}
+
+// 語言包 Session 存下的狀態檔（診斷現場的 state.state）只能在同一語言層載入：不同的 Session 在任何狀態變更之前被拒。
+func TestSessionStateFileBindsToLangLayer(t *testing.T) {
+	root := origRoot(t)
+	files := makePack(t, root, "CFONT.15")
+	s := openDiag(t, Options{Interval: NativeInterval, LangDir: files})
+	s.RunSteps(3_000_000)
+	dir := filepath.Join(t.TempDir(), "crash")
+	if err := s.CrashDump(dir, "狀態檔綁定"); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "state.state")
+
+	plain := openDiag(t, Options{Interval: NativeInterval})
+	before := plain.m.Steps
+	err := state.Load(path, plain.m, plain.d)
+	if err == nil || !strings.Contains(err.Error(), filepath.Clean(files)) {
+		t.Fatalf("沒有語言包的 Session 應拒絕載入並點名 LangDir：%v", err)
+	}
+	if plain.m.Steps != before {
+		t.Error("拒絕之後機器被改動")
+	}
+	same := openDiag(t, Options{Interval: NativeInterval, LangDir: files})
+	if err := state.Load(path, same.m, same.d); err != nil {
+		t.Fatalf("同一語言層的 Session 應載得進：%v", err)
+	}
+	if same.m.Steps != s.m.Steps {
+		t.Errorf("載入後步數 %d，預期 %d", same.m.Steps, s.m.Steps)
+	}
+	// 另一份 manifest（同一個 files 目錄，雜湊不同）也拒絕。
+	if err := os.WriteFile(filepath.Join(filepath.Dir(files), "manifest.json"), []byte("changed"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	other := openDiag(t, Options{Interval: NativeInterval, LangDir: files})
+	if err := state.Load(path, other.m, other.d); err == nil {
+		t.Error("manifest 雜湊不同的 Session 應拒絕載入")
+	}
+}
+
+// 沒有語言包的診斷狀態檔，在沒有語言包的 Session 載入照舊（與現況相同）。
+func TestSessionStateFileWithoutLangLoadsAsBefore(t *testing.T) {
+	root := origRoot(t)
+	s := openDiag(t, Options{Interval: NativeInterval})
+	s.RunSteps(3_000_000)
+	dir := filepath.Join(t.TempDir(), "crash")
+	if err := s.CrashDump(dir, "無語言包"); err != nil {
+		t.Fatal(err)
+	}
+	s2, err := Open(root, Options{Interval: NativeInterval, NoPacing: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := state.Load(filepath.Join(dir, "state.state"), s2.m, s2.d); err != nil {
+		t.Fatal(err)
+	}
+	if s2.m.Steps != s.m.Steps {
+		t.Errorf("載入後步數 %d，預期 %d", s2.m.Steps, s.m.Steps)
+	}
+}
