+	}
+	if got := d.OpenedLayers["X.MES"]; got != (OpenedLayer{First: "lang", Last: "scratch"}) {
+		t.Errorf("OpenedLayers[X.MES] ＝ %+v，預期首次 lang、最近 scratch", got)
