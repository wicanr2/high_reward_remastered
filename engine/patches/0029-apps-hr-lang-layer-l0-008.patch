diff --git a/cmd/probe/langdir.go b/cmd/probe/langdir.go
new file mode 100644
index 0000000..afb8659
--- /dev/null
+++ b/cmd/probe/langdir.go
@@ -0,0 +1,82 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/wicanr2/dosgolem/internal/dos"
+)
+
+// normDir 把目錄正規化成 `filepath.Abs` 加 `filepath.Clean`。
+func normDir(p string) (string, error) {
+	abs, err := filepath.Abs(p)
+	if err != nil {
+		return "", err
+	}
+	return filepath.Clean(abs), nil
+}
+
+// bindLangDir 解析 -lang-dir（hr `docs/spec/008` §3.1，L0），回傳要設給 `DOS.LangDir`、`DOS.LangManifest` 的生效值。
+//
+// 規則與 `apps/hr/runtime` 的 `Session.bindLang`、`apps/hr/cmd/hrsoak` 各自實作同一組（通用工具不能 import 語言包建置碼）：
+//   - `LangDir` 正規化成 `filepath.Abs` 加 `filepath.Clean`；
+//   - 讀 `<LangDir>/../manifest.json` 的原始位元組，取 SHA-256（小寫十六進位）；檔案不存在就回錯，拒絕啟動。
+//
+// 與 `Session.bindLang` 不同的一點：`-lang-dir` 指向不存在的目錄（或不是目錄）時**回錯，不退成原版**。
+// `Session.Open` 清為空字串是為了前端不能因語言包消失而擋遊戲（`docs/spec/008` §3.1）；這個工具產生的是
+// A/B 與樣張收據，路徑打錯卻以原版跑完、退出碼 0，收據會看起來像語言包的結果。
+//
+// 另外拒絕 `LangDir` 與原版目錄（root）或暫存層（scratch，空字串不比）相同：整個原版目錄變成語言層，
+// 寫入模式開檔一律被拒，與原版目錄「寫入只記帳」的行為不同；暫存層與語言層同一目錄則寫入會落到語言層。
+// 這是設定錯誤的保險，正式路徑（`l10n-packs/<名稱>/files`）不會遇到。
+//
+// **不驗證 manifest 的內容**：這個工具不驗證語言包，載入的目錄由 `hrl10n verify` 先驗證（`docs/spec/008` 第 3.2 節）；
+// 不讀雜湊的話，這個工具存下的狀態檔記錄空雜湊，在 runtime Session 載入時被拒。
+func bindLangDir(dir, root, scratch string) (langDir, manifest string, err error) {
+	abs, err := normDir(dir)
+	if err != nil {
+		return "", "", fmt.Errorf("-lang-dir %q：%w", dir, err)
+	}
+	if st, err := os.Stat(abs); err != nil || !st.IsDir() {
+		return "", "", fmt.Errorf("-lang-dir 不存在或不是目錄，拒絕啟動（不退成原版）：%s", abs)
+	}
+	for _, other := range []struct{ name, path string }{{"-root", root}, {"-scratch", scratch}} {
+		if other.path == "" {
+			continue
+		}
+		o, err := normDir(other.path)
+		if err != nil {
+			return "", "", fmt.Errorf("%s %q：%w", other.name, other.path, err)
+		}
+		if o == abs {
+			return "", "", fmt.Errorf("-lang-dir 與 %s 是同一個目錄（%s），拒絕啟動", other.name, abs)
+		}
+	}
+	raw, err := os.ReadFile(filepath.Join(abs, "..", "manifest.json"))
+	if err != nil {
+		return "", "", fmt.Errorf("-lang-dir 的上一層缺 manifest.json，拒絕啟動：%w", err)
+	}
+	sum := sha256.Sum256(raw)
+	return abs, hex.EncodeToString(sum[:]), nil
+}
+
+// reportLangLayers 印語言層的生效值與各檔命中層（`DOS.OpenedLayers`，首次與最近一次）。只在給了 -lang-dir 時呼叫。
+func reportLangLayers(d *dos.DOS) {
+	fmt.Printf("\n語言層：LangDir＝%q  manifest SHA-256＝%s\n", d.LangDir, d.LangManifest)
+	names := make([]string, 0, len(d.OpenedLayers))
+	for n := range d.OpenedLayers {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	var b strings.Builder
+	for _, n := range names {
+		e := d.OpenedLayers[n]
+		fmt.Fprintf(&b, "  %s 首次 %s 最近 %s\n", n, e.First, e.Last)
+	}
+	fmt.Printf("開檔命中層（%d 個檔名）：\n%s", len(names), b.String())
+}
diff --git a/cmd/probe/langdir_test.go b/cmd/probe/langdir_test.go
new file mode 100644
index 0000000..678d193
--- /dev/null
+++ b/cmd/probe/langdir_test.go
@@ -0,0 +1,112 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// helloSHA 是 manifest 內容 "hello" 的 SHA-256。apps/hr/runtime、apps/hr/cmd/hrsoak 的測試用同一個固定值，
+// 斷言三處（probe、hrsoak、Session）對同一個目錄算出相同的 LangManifest 與正規化的 LangDir。
+const helloSHA = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
+
+func makePack(t *testing.T) (filesDir string) {
+	t.Helper()
+	pack := t.TempDir()
+	filesDir = filepath.Join(pack, "files")
+	if err := os.MkdirAll(filesDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(pack, "manifest.json"), []byte("hello"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return filesDir
+}
+
+func TestBindLangDir(t *testing.T) {
+	files := makePack(t)
+	root, scratch := t.TempDir(), t.TempDir()
+	messy := files + string(filepath.Separator) + ".." + string(filepath.Separator) + "files" + string(filepath.Separator)
+	dir, sum, err := bindLangDir(messy, root, scratch)
+	if err != nil {
+		t.Fatalf("err ＝ %v", err)
+	}
+	if dir != filepath.Clean(files) || sum != helloSHA {
+		t.Errorf("LangDir ＝ %q LangManifest ＝ %q，預期 %q 與 %s", dir, sum, filepath.Clean(files), helloSHA)
+	}
+
+	// 相對路徑轉成絕對路徑。
+	t.Chdir(filepath.Dir(files))
+	dir, sum, err = bindLangDir("files", root, "")
+	if err != nil || dir != filepath.Clean(files) || sum != helloSHA {
+		t.Errorf("相對路徑：LangDir ＝ %q LangManifest ＝ %q err ＝ %v", dir, sum, err)
+	}
+}
+
+// -lang-dir 不存在或不是目錄：回錯、拒絕啟動，不退成原版（這個工具產生的是收據）。
+func TestBindLangDirRefusesMissingOrNonDirectory(t *testing.T) {
+	root := t.TempDir()
+	missing := filepath.Join(t.TempDir(), "nope", "files")
+	if dir, sum, err := bindLangDir(missing, root, ""); err == nil || dir != "" || sum != "" || !strings.Contains(err.Error(), "拒絕啟動") {
+		t.Errorf("不存在的目錄：LangDir ＝ %q LangManifest ＝ %q err ＝ %v", dir, sum, err)
+	}
+	f := filepath.Join(t.TempDir(), "afile")
+	if err := os.WriteFile(f, []byte("x"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := bindLangDir(f, root, ""); err == nil {
+		t.Error("不是目錄也應回錯")
+	}
+}
+
+// 缺 manifest.json：拒絕啟動（回錯），不驗證內容。
+func TestBindLangDirRefusesMissingManifest(t *testing.T) {
+	files := makePack(t)
+	root := t.TempDir()
+	if err := os.Remove(filepath.Join(filepath.Dir(files), "manifest.json")); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := bindLangDir(files, root, ""); err == nil || !strings.Contains(err.Error(), "manifest.json") {
+		t.Fatalf("缺 manifest 應回錯並點名檔名：%v", err)
+	}
+	// 內容不是 JSON 也不驗證：只取雜湊。
+	if err := os.WriteFile(filepath.Join(filepath.Dir(files), "manifest.json"), []byte("hello"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, sum, err := bindLangDir(files, root, ""); err != nil || sum != helloSHA {
+		t.Fatalf("不驗證 manifest 內容：sum ＝ %q err ＝ %v", sum, err)
+	}
+}
+
+// 層重疊防呆：LangDir 與原版目錄或暫存層正規化後相同就拒絕（不論路徑怎麼拼）。
+func TestBindLangDirRefusesOverlappingLayers(t *testing.T) {
+	files := makePack(t)
+	unclean := files + string(filepath.Separator) + "." + string(filepath.Separator) + ".." + string(filepath.Separator) + "files"
+	other := t.TempDir()
+	cases := []struct {
+		name          string
+		root, scratch string
+		wantErr       string
+	}{
+		{"與 root 相同", files, other, "-root"},
+		{"與 root 相同（拼法不同）", unclean, other, "-root"},
+		{"與 scratch 相同", other, files, "-scratch"},
+		{"與 scratch 相同（拼法不同）", other, unclean, "-scratch"},
+		{"沒有重疊", other, "", ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			_, _, err := bindLangDir(files, c.root, c.scratch)
+			if c.wantErr == "" {
+				if err != nil {
+					t.Fatalf("不該回錯：%v", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), c.wantErr) || !strings.Contains(err.Error(), "同一個目錄") {
+				t.Fatalf("應拒絕並點名 %s：%v", c.wantErr, err)
+			}
+		})
+	}
+}
