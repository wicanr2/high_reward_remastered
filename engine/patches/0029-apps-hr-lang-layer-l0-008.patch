+	want := []string{"open:x.mes", "layer:X.MES=lang", "open:X.MES", "layer:X.MES=scratch", "open:Y.MES", "layer:Y.MES=root"}
+	if strings.Join(seq, " ") != strings.Join(want, " ") {
