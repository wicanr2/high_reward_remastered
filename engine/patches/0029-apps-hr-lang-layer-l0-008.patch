+}
+
+// 舊的狀態檔（沒有 LangDir、LangManifest 兩個欄位）視為空：沒有語言包的 Session 載得進，有語言包的拒絕。
+func TestOldStateFileWithoutLangFieldsIsTreatedAsEmpty(t *testing.T) {
+	type oldDOSState struct { // 舊檔版面：欄位名與型別同 dosState，缺這兩個欄位；gob 以欄位名配對
+		Magic   string
+		Version int
+		Drive   uint8
+		Dir     string
+		Root    string
+	}
+	raw := encodeState(t, oldDOSState{Magic: dosStateMagic, Version: dosStateVersion, Drive: 3, Dir: "OLD", Root: "/old/root"})
+	empty := langDOS(t, "", "")
+	if err := empty.LoadState(bytes.NewReader(raw)); err != nil {
+		t.Fatalf("沒有語言包的 Session 應載得進舊檔：%v", err)
+	}
+	if empty.Drive != 3 || empty.Dir != "OLD" {
+		t.Errorf("舊檔內容沒套用：Drive ＝ %d Dir ＝ %q", empty.Drive, empty.Dir)
+	}
+	withLang := langDOS(t, "/p/zh/files", "h1")
+	if err := withLang.LoadState(bytes.NewReader(raw)); err == nil {
+		t.Error("有語言包的 Session 不該載入舊檔（舊檔視為沒有語言包）")
+	}
+}
+
+// 語言層比對失敗：在關閉 handle、改欄位之前拒絕，DOS 的狀態摘要與開著的檔都不變。
+func TestLangMismatchRejectsBeforeAnyChange(t *testing.T) {
+	saved := langDOS(t, "/p/zh/files", "h1")
+	saved.Drive, saved.Dir = 3, "SAVED"
+	saved.Mouse.X = 77
+	var b bytes.Buffer
+	if err := saved.SaveState(&b); err != nil {
+		t.Fatal(err)
+	}
+
+	cur := langDOS(t, "/p/ja/files", "h2")
+	f := newLangFixture(t)
+	f.put(t, "root", "KEEP.DAT", "keep-me")
+	cur.Root = f.root
+	m := cur.M
+	if body, ok := readFile(m, cur, "KEEP.DAT"); !ok || body != "keep-me" {
+		t.Fatal("測試前置：讀不到 KEEP.DAT")
+	}
+	h, cf := langOpen(m, cur, "KEEP.DAT", 0) // 開著一個 handle
+	if cf {
+		t.Fatal("測試前置：開不起來")
+	}
+	before := dosDigestOf(t, cur)
+	handlesBefore := len(cur.handles)
+
+	if err := cur.PreflightState(bytes.NewReader(b.Bytes())); err == nil {
+		t.Fatal("PreflightState 應拒絕")
+	}
+	if got := dosDigestOf(t, cur); got != before {
+		t.Error("PreflightState 改動了 DOS 狀態")
+	}
+	if err := cur.LoadState(bytes.NewReader(b.Bytes())); err == nil {
+		t.Fatal("LoadState 應拒絕")
+	}
+	if got := dosDigestOf(t, cur); got != before {
+		t.Error("拒絕載入之後 DOS 狀態摘要變了")
+	}
+	if cur.Drive == 3 || cur.Dir == "SAVED" || cur.Mouse.X == 77 {
+		t.Errorf("拒絕之後欄位被改動：Drive ＝ %d Dir ＝ %q Mouse.X ＝ %d", cur.Drive, cur.Dir, cur.Mouse.X)
+	}
+	if len(cur.handles) != handlesBefore || cur.handles[h] == nil || cur.handles[h].f == nil {
+		t.Fatal("拒絕之後 handle 被關掉或被清掉")
+	}
+	if _, err := cur.handles[h].f.Stat(); err != nil {
+		t.Errorf("拒絕之後 handle 已關閉：%v", err)
+	}
+}
+
+// PreflightState 對壞資料也回錯，不動任何東西。
+func TestPreflightStateRejectsGarbage(t *testing.T) {
+	d := langDOS(t, "", "")
+	if err := d.PreflightState(bytes.NewReader([]byte("not a gob"))); err == nil {
+		t.Error("壞資料應回錯")
+	}
+	wrongMagic := encodeState(t, dosState{Magic: "NOPE", Version: dosStateVersion})
+	if err := d.PreflightState(bytes.NewReader(wrongMagic)); err == nil {
+		t.Error("魔術字不符應回錯")
+	}
+}
+
+// StateDigest：LangDir、LangManifest 為空時摘要用的 JSON 不含這兩個欄位（舊摘要逐位元不變）；非空時不同。
+func TestStateDigestOmitsEmptyLangFields(t *testing.T) {
+	plain := langDOS(t, "", "")
+	var b bytes.Buffer
+	if err := plain.SaveState(&b); err != nil {
+		t.Fatal(err)
+	}
+	var s dosState
+	if err := gob.NewDecoder(bytes.NewReader(b.Bytes())).Decode(&s); err != nil {
+		t.Fatal(err)
+	}
+	js, err := json.Marshal(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(js), "LangDir") || strings.Contains(string(js), "LangManifest") {
+		t.Errorf("空語言層的摘要 JSON 不該含新欄位：%s", js)
+	}
+	// 摘要要因新欄位而不同：兩個 DOS 用同一個 Root、同樣的狀態，只有 LangDir 與 LangManifest 不同。
+	// （各用自己的 t.TempDir() 時 Root 本來就不同，摘要必然不同，與有沒有語言層無關，斷言會恆真。）
+	root := t.TempDir()
+	base := langDOSAt(t, root, "", "")
+	if dosDigestOf(t, langDOSAt(t, root, "", "")) != dosDigestOf(t, base) {
+		t.Fatal("控制組：同一個 Root、同樣設定的兩個 DOS，狀態摘要應相同，否則下面的差異不能歸因於語言層欄位")
+	}
+	for _, c := range []struct{ name, dir, manifest string }{
+		{"LangDir 與 LangManifest 都有", "/p/zh/files", "h1"},
+		{"只有 LangDir", "/p/zh/files", ""},
+		{"只有 LangManifest", "", "h1"},
+	} {
+		if dosDigestOf(t, langDOSAt(t, root, c.dir, c.manifest)) == dosDigestOf(t, base) {
+			t.Errorf("%s：同一個 Root，只有語言層欄位不同，DOS 狀態摘要必須不同", c.name)
+		}
+	}
+	s.LangDir = "/x"
+	js2, _ := json.Marshal(s)
+	if !strings.Contains(string(js2), `"LangDir":"/x"`) {
+		t.Errorf("非空的 LangDir 應進摘要：%s", js2)
+	}
+}
