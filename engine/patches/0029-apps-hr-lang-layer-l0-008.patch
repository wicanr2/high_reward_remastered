+// ---- 改名、刪除、建檔：維持與原版目錄的檔相同的語意 ----
+
+func renameVia(m *machine.Machine, d *DOS, oldName, newName string) (ax uint16, cf bool) {
+	c := m.CPU
+	putName(m, c, oldName)
+	c.Seg[cpu.ES], c.R[cpu.DI] = 0x1000, 0x0200
+	m.WriteBytes(cpu.Addr(0x1000, 0x0200), append([]byte(newName), 0))
+	int21(m, d, 0x5600)
+	return c.R[cpu.AX], c.Flags&cpu.CF != 0
+}
