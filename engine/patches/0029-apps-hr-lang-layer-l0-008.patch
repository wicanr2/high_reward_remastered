+package state
+
+import (
+	"bytes"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+// 語言層（hr `docs/spec/008` §3.1，L0）：state.Load 先預檢再套用。不需要原版。
+
+func bootLang(t *testing.T, langDir, manifest string) (*machine.Machine, *dos.DOS) {
+	t.Helper()
+	m := machine.New()
+	if err := m.LoadCOM(tinyCOM); err != nil {
+		t.Fatal(err)
+	}
+	d := dos.New(m, ".")
+	d.LangDir, d.LangManifest = langDir, manifest
+	d.Install()
+	return m, d
+}
+
+func runSteps(t *testing.T, m *machine.Machine, n int) {
+	t.Helper()
+	for i := 0; i < n && !m.CPU.Halted; i++ {
+		if err := m.Step(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func machineDigest(t *testing.T, m *machine.Machine) [32]byte {
+	t.Helper()
+	var b bytes.Buffer
+	if err := m.SaveState(&b); err != nil {
+		t.Fatal(err)
+	}
+	sum, err := machine.StateDigest(&b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sum
+}
+
+func dosDigest(t *testing.T, d *dos.DOS) [32]byte {
+	t.Helper()
+	var b bytes.Buffer
+	if err := d.SaveState(&b); err != nil {
+		t.Fatal(err)
+	}
+	sum, err := dos.StateDigest(&b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return sum
+}
+
+// 語言層相同的 Session 載得進；不同的明確拒絕、錯誤訊息點名兩組值，而且**機器記憶體與 DOS 狀態摘要都不變**
+// （機器段在檔案裡先於 DOS 段，不預檢的話機器段早已被覆寫）。
+func TestLoadChecksLangLayerBeforeAnyChange(t *testing.T) {
+	m, d := bootLang(t, "/p/zh/files", "h1")
+	runSteps(t, m, 5000)
+	path := filepath.Join(t.TempDir(), "s.gz")
+	if err := Save(path, m, d); err != nil {
+		t.Fatal(err)
+	}
+	savedMachine := machineDigest(t, m)
+
+	cases := []struct {
+		name         string
+		dir, man     string
+		wantErr      bool
+		wantMentions []string
+	}{
+		{"相同的語言包", "/p/zh/files", "h1", false, nil},
+		{"LangDir 不同", "/p/ja/files", "h1", true, []string{"/p/zh/files", "/p/ja/files"}},
+		{"manifest 不同", "/p/zh/files", "h2", true, []string{"h1", "h2"}},
+		{"目前沒有語言包", "", "", true, []string{"/p/zh/files", "h1"}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			m2, d2 := bootLang(t, c.dir, c.man)
+			runSteps(t, m2, 100) // 與存檔時的狀態不同，才看得出有沒有被覆寫
+			mBefore, dBefore := machineDigest(t, m2), dosDigest(t, d2)
+			if mBefore == savedMachine {
+				t.Fatal("測試前置：m2 與存檔的機器狀態應不同")
+			}
+			err := Load(path, m2, d2)
+			if (err != nil) != c.wantErr {
+				t.Fatalf("Load 錯誤 ＝ %v，預期有錯 ＝ %v", err, c.wantErr)
+			}
+			if c.wantErr {
+				for _, want := range c.wantMentions {
+					if !strings.Contains(err.Error(), want) {
+						t.Errorf("錯誤訊息沒有點名 %q：%v", want, err)
+					}
+				}
+				if got := machineDigest(t, m2); got != mBefore {
+					t.Error("拒絕載入之後機器狀態摘要變了（機器段在預檢之前被套用）")
+				}
+				if got := dosDigest(t, d2); got != dBefore {
+					t.Error("拒絕載入之後 DOS 狀態摘要變了")
+				}
+				return
+			}
+			if got := machineDigest(t, m2); got != savedMachine {
+				t.Error("相同語言層的載入應還原成存檔時的機器狀態")
+			}
+		})
+	}
+}
+
+// 沒有語言包的存檔與 Session（與現況相同）照舊載得進。
+func TestLoadWithoutLangStillWorks(t *testing.T) {
+	m, d := bootLang(t, "", "")
+	runSteps(t, m, 5000)
+	path := filepath.Join(t.TempDir(), "s.gz")
+	if err := Save(path, m, d); err != nil {
+		t.Fatal(err)
+	}
+	m2, d2 := bootLang(t, "", "")
+	if err := Load(path, m2, d2); err != nil {
+		t.Fatal(err)
+	}
+	if machineDigest(t, m2) != machineDigest(t, m) {
+		t.Error("載入後機器狀態與存檔時不同")
+	}
+}
