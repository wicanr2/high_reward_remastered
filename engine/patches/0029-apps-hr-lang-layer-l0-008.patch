+// 刪除、createNew、fileAttr、extendedOpen、create 對語言層的檔與對原版目錄的檔結果相同
+// （遊戲不走這些路徑；語意記為已知差異，不拒絕）。
+func TestUnlinkCreateFamilyBehavesLikeRootFile(t *testing.T) {
+	scenario := func(layer string) []string {
+		f := newLangFixture(t)
+		f.put(t, layer, "X.MES", "body")
+		m, d := f.dos(t, true, true)
+		c := m.CPU
+		var out []string
+		rec := func(label string) {
+			out = append(out, fmt.Sprintf("%s CF=%v AX=%04X CX=%04X", label, c.Flags&cpu.CF != 0, c.R[cpu.AX], c.R[cpu.CX]))
+		}
+		// fileAttr 取屬性
+		putName(m, c, "X.MES")
+		c.R[cpu.CX] = 0
+		int21(m, d, 0x4300)
+		rec("attr")
+		putName(m, c, "NOPE.MES")
+		int21(m, d, 0x4300)
+		rec("attr-missing")
+		// createNew：檔案已存在就失敗
+		putName(m, c, "X.MES")
+		c.R[cpu.CX] = 0
+		int21(m, d, 0x5B00)
+		rec("createnew")
+		// extendedOpen：有就開
+		putName(m, c, "X.MES")
+		c.R[cpu.SI], c.R[cpu.BX], c.R[cpu.DX], c.R[cpu.CX] = c.R[cpu.DX], 0, 0x0001, 0
+		int21(m, d, 0x6C00)
+		rec("xopen")
+		if c.Flags&cpu.CF == 0 { // 成功時 AX 是 handle
+			closeFile(m, d, c.R[cpu.AX])
+		}
+		// unlink：只動暫存層，兩層的檔都還在
+		putName(m, c, "X.MES")
+		int21(m, d, 0x4100)
+		rec("unlink")
+		out = append(out, fmt.Sprintf("unlink-keeps-file=%v", f.exists(layer, "X.MES")))
+		// create：在暫存層建同名空檔，原層的檔不動，之後解析到暫存層
+		putName(m, c, "X.MES")
+		c.R[cpu.CX] = 0
+		int21(m, d, 0x3C00)
+		rec("create")
+		closeFile(m, d, c.R[cpu.AX])
+		b, _ := os.ReadFile(filepath.Join(f.scratch, "X.MES"))
+		out = append(out, fmt.Sprintf("scratch-len=%d", len(b)))
+		orig, _ := os.ReadFile(filepath.Join(f.dir(layer), "X.MES"))
+		out = append(out, "orig-body="+string(orig))
+		_, l := d.resolve("X.MES")
+		out = append(out, "layer-after-create="+string(l))
+		return out
+	}
+	root, lang := scenario("root"), scenario("lang")
+	if strings.Join(root, "\n") != strings.Join(lang, "\n") {
+		t.Errorf("語言層的檔與原版目錄的檔語意不同：\n--- root\n%s\n--- lang\n%s", strings.Join(root, "\n"), strings.Join(lang, "\n"))
+	}
+	for _, line := range []string{"attr CF=false AX=", "attr-missing CF=true AX=0002", "createnew CF=true AX=0050", "xopen CF=false", "unlink CF=false", "unlink-keeps-file=true", "scratch-len=0", "orig-body=body", "layer-after-create=scratch"} {
+		if !strings.Contains(strings.Join(lang, "\n"), line) {
+			t.Errorf("結果缺 %q：\n%s", line, strings.Join(lang, "\n"))
+		}
+	}
+}
