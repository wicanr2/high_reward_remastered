+package main
+
+import (
+	"image"
+	"image/color"
+	"image/draw"
+	"image/png"
+	"os"
+	"strings"
+	"sync"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	"golang.org/x/image/font"
+	"golang.org/x/image/font/opentype"
+	"golang.org/x/image/math/fixed"
+)
+
+type displayFaceEntry struct {
+	face font.Face
+	code string
+}
+
+var displayFaceCache sync.Map // UI goroutine owns font.Face after construction.
+
+func (g *game) displayFace() (font.Face, string) {
+	s, ok := g.s.(interface{ DisplayFont() (string, string) })
+	if !ok {
+		return nil, ""
+	}
+	path, code := s.DisplayFont()
+	if path == "" {
+		return nil, ""
+	}
+	if cached, ok := displayFaceCache.Load(path); ok {
+		entry := cached.(displayFaceEntry)
+		return entry.face, entry.code
+	}
+	entry := displayFaceEntry{code: code}
+	b, err := os.ReadFile(path)
+	if err == nil {
+		var f *opentype.Font
+		f, err = opentype.Parse(b)
+		if err == nil {
+			entry.face, err = opentype.NewFace(f, &opentype.FaceOptions{Size: 13, DPI: 72, Hinting: font.HintingNone})
+		}
+	}
+	if err != nil {
+		g.logf("顯示字型載入失敗 %s：%v", code, err)
+	}
+	displayFaceCache.Store(path, entry)
+	return entry.face, code
+}
+
+// drawDisplayText 只在遊戲畫面後合成，不觸及 DOS 字串與識別。
+// 各矩形使用固定行距，超寬單行縮小至矩形內；原版停在同一行時譯文亦停在同一行。
+func (g *game) drawDisplayText(screen *ebiten.Image) {
+	f := g.drawnFrame
+	if f == nil || len(f.Display) == 0 {
+		return
+	}
+	face, code := g.displayFace()
+	if face == nil {
+		return
+	}
+	for _, st := range f.Display {
+		if st.W < 1 || st.H < 1 {
+			continue
+		}
+		im := image.NewRGBA(image.Rect(0, 0, st.W, st.H))
+		// Erase only pixels written by the original text call. Leave unrelated art transparent.
+		for y := 0; y < st.H; y++ {
+			for x := 0; x < st.W; x++ {
+				i := y*st.W + x
+				if st.Before[i] == st.Expected[i] {
+					continue
+				}
+				c := f.DAC[f.Map[st.Before[i]&15]]
+				im.SetRGBA(x, y, color.RGBA{c[0], c[1], c[2], 255})
+			}
+		}
+		fg := f.DAC[f.Map[st.Color&15]]
+		lines := strings.Split(st.Text, "\n")
+		if st.H < 32 {
+			lines = []string{strings.Join(lines, " ")}
+		}
+		lineHeight := 16
+		if len(lines)*lineHeight > st.H {
+			lineHeight = st.H / len(lines)
+			if lineHeight < 1 {
+				lineHeight = 1
+			}
+		}
+		for line, value := range lines {
+			width := 0
+			for _, r := range value {
+				if code == "en" || r < 128 {
+					width += 8
+				} else {
+					width += 16
+				}
+			}
+			if width < 1 {
+				continue
+			}
+			ink := image.NewRGBA(image.Rect(0, 0, width, 16))
+			d := font.Drawer{Dst: ink, Src: image.NewUniform(color.RGBA{fg[0], fg[1], fg[2], 255}), Face: face}
+			x := 0
+			for _, r := range value {
+				d.Dot = fixed.P(x, 13)
+				d.DrawString(string(r))
+				if code == "en" || r < 128 {
+					x += 8
+				} else {
+					x += 16
+				}
+			}
+			if width <= st.W && lineHeight == 16 {
+				draw.Draw(im, image.Rect(0, line*lineHeight, width, line*lineHeight+16), ink, image.Point{}, draw.Over)
+			} else {
+				// Fit both axes without dropping any translated line.
+				fittedWidth := width
+				if fittedWidth > st.W {
+					fittedWidth = st.W
+				}
+				for y := 0; y < lineHeight && line*lineHeight+y < st.H; y++ {
+					for x := 0; x < fittedWidth; x++ {
+						c := ink.RGBAAt(x*width/fittedWidth, y*16/lineHeight)
+						if c.A != 0 {
+							im.SetRGBA(x, line*lineHeight+y, c)
+						}
+					}
+				}
+			}
+		}
+		texture := ebiten.NewImageFromImage(im)
+		op := &ebiten.DrawImageOptions{}
+		op.GeoM.Scale(2, 2)
+		op.GeoM.Translate(float64(st.X*2), float64((st.Y-40)*2))
+		screen.DrawImage(texture, op)
+		texture.Deallocate()
+	}
+}
+
+func writeDisplayScreenshot(path string, screen *ebiten.Image) error {
+	bounds := screen.Bounds()
+	rgba := image.NewRGBA(bounds)
+	screen.ReadPixels(rgba.Pix)
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	return png.Encode(f, rgba)
+}
