diff --git a/apps/hr/runtime/display.go b/apps/hr/runtime/display.go
new file mode 100644
index 0000000..b13f1bc
--- /dev/null
+++ b/apps/hr/runtime/display.go
@@ -0,0 +1,398 @@
+package runtime
+
+// 顯示專用翻譯。只觀察繪製呼叫與 VGA 像素，不寫入 DOS 記憶體或存檔。
+import (
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/machine"
+	"golang.org/x/text/encoding/traditionalchinese"
+)
+
+// DisplayStamp 是原版完成繪字後的顯示區。Expected/Before 為區內原色索引。
+// 快照只攜帶仍然與原版像素相符的 stamp，避免舊譯文留在新畫面。
+type DisplayStamp struct {
+	X, Y, W, H       int
+	Text             string
+	Color            uint8
+	Before, Expected []uint8
+}
+
+type displayPattern struct {
+	source, target string
+	re             *regexp.Regexp
+}
+type displayPending struct {
+	stamp          DisplayStamp
+	ss, sp, cs, ip uint16
+	step           uint64
+}
+type displayObserver struct {
+	exact                map[string]string
+	patterns             []displayPattern
+	pending              []displayPending
+	stamps               []DisplayStamp
+	fontPath, code       string
+	mainCount, shopCount int
+}
+
+func decodeDisplay(raw []byte) string {
+	b, _ := traditionalchinese.Big5.NewDecoder().Bytes(raw)
+	return strings.TrimSpace(string(b))
+}
+
+func unescapeDisplay(s string) (string, error) {
+	var out strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] != '\\' {
+			out.WriteByte(s[i])
+			continue
+		}
+		i++
+		if i == len(s) {
+			return "", fmt.Errorf("trailing TSV escape")
+		}
+		switch s[i] {
+		case 'n':
+			out.WriteByte('\n')
+		case 't':
+			out.WriteByte('\t')
+		case '\\':
+			out.WriteByte('\\')
+		default:
+			return "", fmt.Errorf("unknown TSV escape")
+		}
+	}
+	return out.String(), nil
+}
+
+var displaySpecifier = regexp.MustCompile(`%[-+ #0]*[0-9]*(?:\.[0-9]+)?(?:l)?[sducxX]`)
+
+func (o *displayObserver) add(raw []byte, target string) {
+	source := decodeDisplay(raw)
+	if source == "" || target == "" {
+		return
+	}
+	target = strings.TrimSpace(target)
+	if !strings.Contains(source, "%") {
+		if _, exists := o.exact[source]; !exists {
+			o.exact[source] = target
+		}
+		return
+	}
+	srcSpecs := displaySpecifier.FindAllString(source, -1)
+	dstSpecs := displaySpecifier.FindAllString(target, -1)
+	if len(srcSpecs) == 0 {
+		// Literal percentages are display text, not a reason to drop a catalog row.
+		source = strings.ReplaceAll(source, "%%", "%")
+		target = strings.ReplaceAll(target, "%%", "%")
+		if _, exists := o.exact[source]; !exists {
+			o.exact[source] = target
+		}
+		return
+	}
+	if len(srcSpecs) != len(dstSpecs) {
+		return
+	}
+	for i := range srcSpecs {
+		if srcSpecs[i] != dstSpecs[i] {
+			return
+		}
+	}
+	idx := displaySpecifier.FindAllStringIndex(source, -1)
+	var p strings.Builder
+	p.WriteString("(?s)^")
+	previous := 0
+	for _, pair := range idx {
+		p.WriteString(regexp.QuoteMeta(source[previous:pair[0]]))
+		p.WriteString("(.*?)")
+		previous = pair[1]
+	}
+	p.WriteString(regexp.QuoteMeta(source[previous:]))
+	p.WriteString("$")
+	o.patterns = append(o.patterns, displayPattern{source, target, regexp.MustCompile(p.String())})
+}
+
+// LoadDisplayTranslations 綁定 MAIN 原版雜湊、各列來源摘要及 SHOP 固定欄。
+// keep/unresolved 列沒有替換；未知原文保持原版。
+func loadDisplayTranslations(root, dir, code string, image []byte) (*displayObserver, error) {
+	if dir == "" || code == "" || code == "zh-TW" {
+		return nil, nil
+	}
+	o := &displayObserver{exact: map[string]string{}, code: code, fontPath: filepath.Join(dir, "display-font.otf")}
+	if _, err := os.Stat(o.fontPath); err != nil {
+		return nil, fmt.Errorf("display font: %w", err)
+	}
+	shop, err := os.ReadFile(filepath.Join(root, "SHOPTAB.TBL"))
+	if err != nil {
+		return nil, err
+	}
+	for _, name := range []string{"MAIN.EXE.tsv", "SHOPTAB.TBL.tsv"} {
+		data, err := os.ReadFile(filepath.Join(dir, name))
+		if err != nil {
+			return nil, err
+		}
+		if len(data) > 8<<20 || !utf8.Valid(data) {
+			return nil, fmt.Errorf("invalid display table %s", name)
+		}
+		lines := strings.Split(strings.TrimSuffix(string(data), "\n"), "\n")
+		head := strings.Split(lines[0], "\t")
+		cols := map[string]int{}
+		for i, key := range head {
+			cols[key] = i
+		}
+		for _, key := range []string{"id", "text", "status"} {
+			if _, ok := cols[key]; !ok {
+				return nil, fmt.Errorf("display table missing %s", key)
+			}
+		}
+		hashColumn, hashWidth := "raw_sha256", 64
+		if _, ok := cols[hashColumn]; !ok {
+			hashColumn, hashWidth = "src_sha256", 16
+		}
+		if _, ok := cols[hashColumn]; !ok {
+			return nil, fmt.Errorf("display table missing source hash")
+		}
+		seen := map[string]bool{}
+		for n, line := range lines[1:] {
+			f := strings.Split(line, "\t")
+			if len(f) != len(head) {
+				return nil, fmt.Errorf("%s:%d columns", name, n+2)
+			}
+			id := f[cols["id"]]
+			if seen[id] {
+				return nil, fmt.Errorf("duplicate display ID %s", id)
+			}
+			seen[id] = true
+			if f[cols["status"]] != "accepted" {
+				continue
+			}
+			target, err := unescapeDisplay(f[cols["text"]])
+			if err != nil {
+				return nil, err
+			}
+			if name == "SHOPTAB.TBL.tsv" {
+				col, ok := cols["acc_sha"]
+				if !ok || fmt.Sprintf("%x", sha256.Sum256([]byte(target)))[:16] != f[col] {
+					continue
+				}
+			}
+			var raw []byte
+			if name == "MAIN.EXE.tsv" {
+				var seg, off uint32
+				if _, err := fmt.Sscanf(id, "MAIN@IDA:%x:%x", &seg, &off); err != nil {
+					return nil, fmt.Errorf("invalid MAIN ID %s", id)
+				}
+				start := int(seg*16+off) - 0x10000 + 18944
+				if start < 0 || start >= len(image) {
+					return nil, fmt.Errorf("MAIN offset %s", id)
+				}
+				for size := 1; size <= 512 && start+size <= len(image); size++ {
+					b := image[start : start+size]
+					if fmt.Sprintf("%x", sha256.Sum256(b))[:hashWidth] == f[cols[hashColumn]] {
+						raw = b
+						break
+					}
+				}
+				if raw == nil {
+					return nil, fmt.Errorf("MAIN source mismatch %s", id)
+				}
+				o.mainCount++
+			} else {
+				// Canonical IDs are SHOPTAB#row.field.
+				parts := strings.Split(strings.TrimPrefix(id, "SHOPTAB#"), ".")
+				if len(parts) != 2 {
+					return nil, fmt.Errorf("SHOP ID %s", id)
+				}
+				row, e1 := strconv.Atoi(parts[0])
+				field, e2 := strconv.Atoi(parts[1])
+				start := row*200 + field*25
+				if e1 != nil || e2 != nil || row < 0 || row >= 99 || field < 0 || field >= 8 || start+20 > len(shop) {
+					return nil, fmt.Errorf("SHOP ID %s", id)
+				}
+				raw = shop[start : start+20]
+				if fmt.Sprintf("%x", sha256.Sum256(raw))[:hashWidth] != f[cols[hashColumn]] {
+					return nil, fmt.Errorf("SHOP source mismatch %s", id)
+				}
+				o.shopCount++
+			}
+			o.add(raw, target)
+		}
+	}
+	return o, nil
+}
+
+func (o *displayObserver) translate(raw []byte) string {
+	source := decodeDisplay(raw)
+	if t, ok := o.exact[source]; ok {
+		return t
+	}
+	for _, p := range o.patterns {
+		captures := p.re.FindStringSubmatch(source)
+		if captures == nil {
+			continue
+		}
+		indices := displaySpecifier.FindAllStringIndex(p.target, -1)
+		var out strings.Builder
+		previous := 0
+		for i, index := range indices {
+			out.WriteString(p.target[previous:index[0]])
+			value := captures[i+1]
+			if t, ok := o.exact[strings.TrimSpace(value)]; ok {
+				value = t
+			}
+			out.WriteString(value)
+			previous = index[1]
+		}
+		out.WriteString(p.target[previous:])
+		return out.String()
+	}
+	return ""
+}
+
+func displayCString(m *machine.Machine, addr uint32, line bool) []byte {
+	var b []byte
+	for i := uint32(0); i < 512 && addr+i < uint32(len(m.Mem)); i++ {
+		c := m.Mem[addr+i]
+		if c == 0 || (line && c == 10) {
+			break
+		}
+		b = append(b, c)
+	}
+	return b
+}
+
+func displayCrop(px []uint8, width int, s DisplayStamp) []uint8 {
+	out := make([]uint8, s.W*s.H)
+	for y := 0; y < s.H; y++ {
+		copy(out[y*s.W:], px[(s.Y+y)*width+s.X:(s.Y+y)*width+s.X+s.W])
+	}
+	return out
+}
+
+func (o *displayObserver) pre(m *machine.Machine) {
+	c := m.CPU
+	if c.Seg[cpu.CS] != 0x16EC || (c.IP != 0x15E7 && c.IP != 0x1676 && c.IP != 0x18AC) {
+		return
+	}
+	// An outer translated text object owns its rectangle; ignore its nested lines.
+	if len(o.pending) > 0 {
+		return
+	}
+	ss, sp := c.Seg[cpu.SS], c.R[cpu.SP]
+	arg := func(n uint16) uint16 { return m.Read16(cpu.Linear(ss, sp+4+n*2)) }
+	st := DisplayStamp{X: int(int16(arg(0))), Y: int(int16(arg(1))) + 40, H: 16, Color: uint8(arg(2)) & 15}
+	var raw []byte
+	if c.IP == 0x18AC {
+		obj := cpu.Linear(arg(1), arg(0))
+		if obj+16 >= uint32(len(m.Mem)) {
+			return
+		}
+		st.X, st.Y, st.W, st.H, st.Color = int(int16(m.Read16(obj+4))), int(int16(m.Read16(obj+6)))+40, int(m.Read16(obj+8)), int(m.Read16(obj+10)), 15
+		raw = displayCString(m, cpu.Linear(m.Read16(obj+14), m.Read16(obj+12)), false)
+	} else if c.IP == 0x1676 {
+		st.W, st.Color = int(arg(2)), uint8(arg(3))&15
+		raw = displayCString(m, cpu.Linear(arg(7), arg(6)), true)
+	} else {
+		raw = displayCString(m, cpu.Linear(arg(6), arg(5)), false)
+		st.W = len(raw) * 8
+	}
+	st.Text = o.translate(raw)
+	if st.Text == "" {
+		return
+	}
+	if st.X < 0 || st.Y < 40 || st.W < 1 || st.H < 15 || st.X >= 640 || st.Y >= 440 {
+		return
+	}
+	if st.W > 640-st.X {
+		st.W = 640 - st.X
+	}
+	if st.H > 440-st.Y {
+		st.H = 440 - st.Y
+	}
+	w, h, px := m.Planar()
+	if w != 640 || h != 480 {
+		return
+	}
+	st.Before = displayCrop(px, w, st)
+	o.pending = append(o.pending, displayPending{st, ss, sp + 4, m.Read16(cpu.Linear(ss, sp+2)), m.Read16(cpu.Linear(ss, sp)), m.Steps})
+}
+
+func (o *displayObserver) post(m *machine.Machine) {
+	if len(o.pending) == 0 {
+		return
+	}
+	p := o.pending[0]
+	c := m.CPU
+	if m.Steps-p.step > 10_000_000 {
+		o.pending = nil
+		return
+	}
+	if c.Seg[cpu.CS] != p.cs || c.IP != p.ip || c.Seg[cpu.SS] != p.ss || c.R[cpu.SP] != p.sp {
+		return
+	}
+	w, h, px := m.Planar()
+	if w == 640 && h == 480 {
+		p.stamp.Expected = displayCrop(px, w, p.stamp)
+		changed := false
+		for i := range p.stamp.Expected {
+			if p.stamp.Before[i] != p.stamp.Expected[i] {
+				changed = true
+				break
+			}
+		}
+		// An identical redraw leaves the existing stamp/background intact.
+		if !changed {
+			o.pending = nil
+			return
+		}
+		// Latest draw owns any overlapping rectangle.
+		kept := o.stamps[:0]
+		for _, old := range o.stamps {
+			if old.X >= p.stamp.X+p.stamp.W || old.X+old.W <= p.stamp.X || old.Y >= p.stamp.Y+p.stamp.H || old.Y+old.H <= p.stamp.Y {
+				kept = append(kept, old)
+			}
+		}
+		o.stamps = append(kept, p.stamp)
+		if len(o.stamps) > 512 {
+			o.stamps = o.stamps[len(o.stamps)-512:]
+		}
+	}
+	o.pending = nil
+}
+
+func (o *displayObserver) snapshot(f *Frame) {
+	kept := o.stamps[:0]
+	for _, s := range o.stamps {
+		matches := true
+		for y := 0; y < s.H && matches; y++ {
+			for x := 0; x < s.W; x++ {
+				i := y*s.W + x
+				if f.Px[(s.Y+y)*f.W+s.X+x] != s.Expected[i] {
+					matches = false
+					break
+				}
+			}
+		}
+		if matches {
+			kept = append(kept, s)
+			f.Display = append(f.Display, s)
+		}
+	}
+	o.stamps = kept
+}
+
+// DisplayFont returns the immutable active display catalog/font identity.
+func (s *Session) DisplayFont() (string, string) {
+	if s.display == nil {
+		return "", ""
+	}
+	return s.display.fontPath, s.display.code
+}
