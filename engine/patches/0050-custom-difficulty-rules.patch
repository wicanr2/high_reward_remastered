+			}
+			if !bytes.Equal(after, s.m.Mem) {
+				t.Fatal("劇情累乘")
+			}
+			if enabled && v.ret == 0x4dc1 {
+				s.hard.battleScaled = false
+				s.m.Write16(base+0x591+9, 13107)
+				s.m.Write16(base+0x591+11, 13107)
+				if e := s.hardPre(); e != nil {
+					t.Fatal(e)
+				}
+				if s.m.Peek16(base+0x591+9) != 32767 {
+					t.Fatal("最高段合法邊界錯誤")
+				}
+				s.hard.battleScaled = false
+				s.m.Write16(base+0x591+9, 1)
+				s.m.Write16(base+0x591+11, 13108)
+				before = append([]byte(nil), s.m.Mem...)
+				if e := s.hardPre(); e == nil {
+					t.Fatal("最高段溢位未拒絕")
+				}
+				if !bytes.Equal(before, s.m.Mem) {
+					t.Fatal("最高段溢位部分寫入")
+				}
+			}
+		}
+	}
+}
