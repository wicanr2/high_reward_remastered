+			c.IP = 0
+			if e := s.hardPre(); e != nil {
+				t.Fatal(e)
+			}
+			c.IP = 0x15c
+			c.Seg[cpu.DS] = 0x4d04
+			c.R[cpu.BP] = 0x7000
+			copy(s.m.Mem[cpu.Linear(0x7000, 0x159):], []byte{0xe8, 0xf9, 0x13, 0x1e, 0x68, 0x95, 0x0b})
+			a, b := cpu.Linear(s.stackSeg, 0x7000), cpu.Linear(s.stackSeg, 0x7100)
+			s.m.Write16(a, 0x7100)
+			s.m.Write16(a+2, 0x602)
+			s.m.Write16(a+4, 0x1514)
+			s.m.Write16(a+6, 0)
+			s.m.Write16(a+12, 7)
+			s.m.Write16(b+2, v.ret)
