+				if got := s.m.Peek16(at); got != uint16(101*p/100) {
+					t.Fatal(v.load, v.ret, f, got)
+				}
+				copy(before[at:at+2], s.m.Mem[at:at+2])
+			}
+			if !bytes.Equal(before, s.m.Mem) {
