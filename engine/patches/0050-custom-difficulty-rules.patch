diff --git a/apps/hr/play/challenge.go b/apps/hr/play/challenge.go
new file mode 100644
index 0000000..0bbbb40
--- /dev/null
+++ b/apps/hr/play/challenge.go
@@ -0,0 +1,326 @@
+package main
+
+import (
+	"fmt"
+	"image"
+	"image/color"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	"github.com/hajimehoshi/ebiten/v2/ebitenutil"
+	"github.com/hajimehoshi/ebiten/v2/text"
+	"github.com/hajimehoshi/ebiten/v2/vector"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+	"golang.org/x/image/font"
+)
+
+var challengeStartButton = image.Rect(900, 650, 1200, 698)
+var challengeButtons = [3]image.Rectangle{image.Rect(130, 700, 410, 752), image.Rect(670, 700, 900, 752), image.Rect(930, 700, 1160, 752)}
+var challengeKeys = [8]string{"debt", "rewards", "story", "shops", "aircraft", "tank", "western", "fortress"}
+
+func challengeRow(i int) image.Rectangle      { return image.Rect(130, 168+i*56, 1160, 218+i*56) }
+func challengeStrategy(i int) image.Rectangle { r := challengeRow(i); r.Min.X = 800; return r }
+
+// 草稿可記住關閉前的策略；有效設定一律使用 original 表示關閉。
+type challengeEditor struct {
+	rules          hrrt.ChallengeRules
+	aircraft, tank hrrt.VehicleRule
+	focus          int
+}
+
+func decodeChallengeFlag(given bool, mode, value string) (*hrrt.ChallengeRules, error) {
+	if !given {
+		return nil, nil
+	}
+	if mode != "custom" {
+		return nil, fmt.Errorf("-challenge-rules 必須搭配 -difficulty custom")
+	}
+	r, err := hrrt.DecodeChallengeRules([]byte(value))
+	if err != nil {
+		return nil, err
+	}
+	return &r, nil
+}
+
+func (d *difficultyGate) customRules() hrrt.ChallengeRules {
+	if d.rules.Schema == 0 {
+		return hrrt.DefaultChallengeRules()
+	}
+	return d.rules
+}
+func (d *difficultyGate) startGame(mode hrrt.Difficulty, r hrrt.ChallengeRules) (*game, error) {
+	if d.startWithRules != nil {
+		if mode == hrrt.DifficultyCustom {
+			return d.startWithRules(mode, &r)
+		}
+		return d.startWithRules(mode, nil)
+	}
+	return d.start(mode)
+}
+func (d *difficultyGate) openEditor() {
+	if d.g != nil && !d.menu {
+		d.pauseGame()
+	}
+	r := d.customRules()
+	if d.mode == hrrt.DifficultyCustom && d.g != nil {
+		r = d.activeRules
+	}
+	e := &challengeEditor{rules: r, aircraft: r.Aircraft, tank: r.Tank}
+	if e.aircraft == hrrt.VehicleOriginal {
+		e.aircraft = hrrt.VehicleBalanced
+	}
+	if e.tank == hrrt.VehicleOriginal {
+		e.tank = hrrt.VehicleBalanced
+	}
+	d.editor = e
+	d.menu = false
+	d.cursorUI(true)
+}
+func (e *challengeEditor) enabled(i int) bool {
+	switch i {
+	case 0:
+		return e.rules.DebtX5
+	case 1:
+		return e.rules.HalfRewards
+	case 2:
+		return e.rules.StagedStory
+	case 3:
+		return e.rules.LateAircraftShops
+	case 4:
+		return e.rules.Aircraft != hrrt.VehicleOriginal
+	case 5:
+		return e.rules.Tank != hrrt.VehicleOriginal
+	case 6:
+		return e.rules.WesternGuards
+	case 7:
+		return e.rules.FortressDefenses
+	}
+	return false
+}
+func (e *challengeEditor) toggle(i int) {
+	switch i {
+	case 0:
+		e.rules.DebtX5 = !e.rules.DebtX5
+	case 1:
+		e.rules.HalfRewards = !e.rules.HalfRewards
+	case 2:
+		e.rules.StagedStory = !e.rules.StagedStory
+	case 3:
+		e.rules.LateAircraftShops = !e.rules.LateAircraftShops
+	case 4:
+		if e.enabled(i) {
+			e.rules.Aircraft = hrrt.VehicleOriginal
+		} else {
+			e.rules.Aircraft = e.aircraft
+		}
+	case 5:
+		if e.enabled(i) {
+			e.rules.Tank = hrrt.VehicleOriginal
+		} else {
+			e.rules.Tank = e.tank
+		}
+	case 6:
+		e.rules.WesternGuards = !e.rules.WesternGuards
+	case 7:
+		e.rules.FortressDefenses = !e.rules.FortressDefenses
+	}
+}
+func (e *challengeEditor) strategy(i int) {
+	p := &e.aircraft
+	if i == 5 {
+		p = &e.tank
+	}
+	if *p == hrrt.VehicleBalanced {
+		*p = hrrt.VehicleTransport
+	} else {
+		*p = hrrt.VehicleBalanced
+	}
+	if e.enabled(i) {
+		if i == 4 {
+			e.rules.Aircraft = *p
+		} else {
+			e.rules.Tank = *p
+		}
+	}
+}
+func (d *difficultyGate) applyEditor() {
+	r := d.editor.rules
+	d.editor = nil
+	if d.g == nil {
+		d.rules = r
+		d.selected = 1
+		return
+	}
+	d.requestSwitch(hrrt.DifficultyCustom, r)
+}
+func (d *difficultyGate) updateEditor(env gameEnv) {
+	e := d.editor
+	if justPressed(ebiten.KeyEscape) || env.mouseJustDown(ebiten.MouseButtonRight) {
+		d.closeMenu()
+		return
+	}
+	if justPressed(ebiten.KeyArrowUp) {
+		if e.focus < 8 {
+			e.focus = (e.focus + 7) % 8
+		} else {
+			e.focus = 7
+		}
+	}
+	if justPressed(ebiten.KeyArrowDown) {
+		if e.focus < 8 {
+			e.focus = (e.focus + 1) % 8
+		} else {
+			e.focus = 0
+		}
+	}
+	if justPressed(ebiten.KeyTab) {
+		if e.focus < 8 {
+			e.focus = 8
+		} else {
+			e.focus = 8 + (e.focus-7)%3
+		}
+	}
+	if (justPressed(ebiten.KeyArrowLeft) || justPressed(ebiten.KeyArrowRight)) && (e.focus == 4 || e.focus == 5) {
+		e.strategy(e.focus)
+	}
+	activate := func(i int) {
+		switch i {
+		case 8:
+			e.rules = hrrt.DefaultChallengeRules()
+			e.aircraft, e.tank = hrrt.VehicleBalanced, hrrt.VehicleBalanced
+		case 9:
+			d.closeMenu()
+		case 10:
+			d.applyEditor()
+		default:
+			e.toggle(i)
+		}
+	}
+	if justPressed(ebiten.KeySpace) || justPressed(ebiten.KeyEnter) || justPressed(ebiten.KeyNumpadEnter) {
+		activate(e.focus)
+		return
+	}
+	if env.mouseJustDown(ebiten.MouseButtonLeft) {
+		x, y := env.cursor()
+		p := image.Pt(x, y)
+		for i := 0; i < 8; i++ {
+			if p.In(challengeRow(i)) {
+				e.focus = i
+				if (i == 4 || i == 5) && p.In(challengeStrategy(i)) {
+					e.strategy(i)
+				} else {
+					e.toggle(i)
+				}
+				return
+			}
+		}
+		for i, r := range challengeButtons {
+			if p.In(r) {
+				e.focus = 8 + i
+				activate(8 + i)
+				return
+			}
+		}
+	}
+}
+func (d *difficultyGate) drawEditor(screen *ebiten.Image) {
+	l := d.language()
+	face := d.fonts.face(l)
+	if face == nil {
+		l = langEN
+		face = d.fonts.face(l)
+	}
+	draw := func(s string, x, y int, c color.Color) {
+		if face != nil {
+			text.Draw(screen, s, face, x, y, c)
+		} else {
+			ebitenutil.DebugPrintAt(screen, toASCII(s), x, y-18)
+		}
+	}
+	fg, gold, muted := color.RGBA{215, 222, 235, 255}, color.RGBA{240, 221, 177, 255}, color.RGBA{150, 164, 185, 255}
+	vector.DrawFilledRect(screen, 0, 0, 1280, 844, color.RGBA{0, 0, 0, 210}, false)
+	vector.DrawFilledRect(screen, 100, 70, 1090, 710, color.RGBA{18, 26, 43, 255}, false)
+	draw(tr(l, "difficulty.settings.title"), 130, 112, gold)
+	draw(tr(l, "difficulty.settings.progress"), 130, 149, muted)
+	e := d.editor
+	for i, key := range challengeKeys {
+		r := challengeRow(i)
+		border := muted
+		if e.focus == i {
+			border = gold
+		}
+		vector.StrokeRect(screen, float32(r.Min.X), float32(r.Min.Y), float32(r.Dx()), float32(r.Dy()), 1, border, false)
+		vector.StrokeRect(screen, 147, float32(r.Min.Y+13), 24, 24, 1, fg, false)
+		if e.enabled(i) {
+			draw("x", 153, r.Min.Y+33, gold)
+		}
+		draw(tr(l, "difficulty.rule."+key), 188, r.Min.Y+33, fg)
+		if i == 4 || i == 5 {
+			strategy := e.aircraft
+			if i == 5 {
+				strategy = e.tank
+			}
+			c := fg
+			if !e.enabled(i) {
+				c = muted
+			}
+			box := challengeStrategy(i)
+			vector.StrokeRect(screen, float32(box.Min.X), float32(box.Min.Y+5), float32(box.Dx()-5), float32(box.Dy()-10), 1, c, false)
+			draw("< "+tr(l, "difficulty.strategy."+string(strategy))+" >", box.Min.X+14, r.Min.Y+33, c)
+		}
+	}
+	draw(tr(l, "difficulty.settings.hint"), 130, 655, muted)
+	draw(tr(l, "difficulty.settings.trial"), 130, 684, muted)
+	for i, r := range challengeButtons {
+		c := muted
+		if e.focus == i+8 {
+			c = gold
+		}
+		vector.StrokeRect(screen, float32(r.Min.X), float32(r.Min.Y), float32(r.Dx()), float32(r.Dy()), 1, c, false)
+		s := tr(l, []string{"difficulty.settings.defaults", "difficulty.switch.cancel", "difficulty.settings.apply"}[i])
+		w := len(s) * 6
+		if face != nil {
+			w = font.MeasureString(face, s).Ceil()
+		}
+		draw(s, r.Min.X+(r.Dx()-w)/2, r.Min.Y+34, fg)
+	}
+}
+func validateChallengeText(l lang, face font.Face) error {
+	check := func(key string, width int) error {
+		if font.MeasureString(face, tr(l, key)).Ceil() > width {
+			return fmt.Errorf("%s %s 設定文字越界", l, key)
+		}
+		return nil
+	}
+	for i, key := range challengeKeys {
+		w := 940
+		if i == 4 || i == 5 {
+			w = 590
+		}
+		if err := check("difficulty.rule."+key, w); err != nil {
+			return err
+		}
+	}
+	for _, key := range []string{"difficulty.strategy.balanced", "difficulty.strategy.transport"} {
+		if err := check(key, 290); err != nil {
+			return err
+		}
+	}
+	for _, key := range []string{"difficulty.settings.title", "difficulty.settings.progress", "difficulty.settings.hint", "difficulty.settings.trial"} {
+		if err := check(key, 1030); err != nil {
+			return err
+		}
+	}
+	for i, key := range []string{"difficulty.settings.defaults", "difficulty.switch.cancel", "difficulty.settings.apply"} {
+		if err := check(key, challengeButtons[i].Dx()-30); err != nil {
+			return err
+		}
+	}
+	if err := check("difficulty.settings", 260); err != nil {
+		return err
+	}
+	metrics := face.Metrics()
+	if (metrics.Ascent + metrics.Descent).Ceil() > 32 {
+		return fmt.Errorf("%s 設定列字高越界", l)
+	}
+	return nil
+}
