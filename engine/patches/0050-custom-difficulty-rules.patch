+				r.Tank = VehicleTransport
+			case "western":
+				r.WesternGuards = true
+			case "fortress":
+				r.FortressDefenses = true
+			case "all":
+				r = DefaultChallengeRules()
+			}
+			s := customSession(t, r)
+			expected := append([]byte(nil), a.m.Mem...)
+			put := func(at uint32, v uint32) { expected[at] = byte(v); expected[at+1] = byte(v >> 8) }
+			if r.DebtX5 {
+				put(0x37a34, 50000000)
+				put(0x37a36, 50000000>>16)
+			}
+			for _, v := range []struct {
+				r     VehicleRule
+				at    uint32
+				plane bool
+			}{{r.Aircraft, 0x3b880, true}, {r.Tank, 0x3b718, false}} {
+				if v.r == VehicleOriginal {
+					continue
+				}
+				atk, hp := uint32(50), uint32(75)
+				if v.r == VehicleTransport {
+					atk, hp = 10, 25
+				}
+				for i := uint32(0); i < 8; i++ {
+					at := v.at + i*45
+					put(at+2, uint32(a.m.Peek16(at+2))*atk/100)
+					if v.plane {
+						put(at, uint32(a.m.Peek16(at))*hp/100)
+					}
+				}
+			}
+			count := 0
+			for region := uint32(0); region < 11; region++ {
+				for j := uint32(0); j < 16; j++ {
+					town := a.m.Mem[0x340ec+region*73+57+j]
+					if town == 255 {
+						continue
+					}
+					at := challengeTownBase + uint32(town)*101
+					typ := a.m.Mem[at+24]
+					if r.WesternGuards && region >= 6 && town != 64 && typ <= 2 {
+						for _, f := range []uint32{26, 32, 34} {
+							p := uint32(125)
+							if region >= 9 {
+								p = 175
+							} else if region == 8 {
+								p = 150
+							}
+							if f == 34 {
+								p = 115
+								if region >= 9 {
+									p = 150
+								} else if region == 8 {
+									p = 125
+								}
+							}
+							v := uint32(a.m.Peek16(at+f)) * p / 100
+							if v > 999 {
+								v = 999
+							}
+							put(at+f, v)
+						}
+					}
+					if r.FortressDefenses && region != 4 && town != 64 && typ <= 1 {
+						count++
+						min := byte(3)
+						if region == 5 || region == 6 || region == 7 {
+							min = 1
+						}
+						if region == 2 || region == 3 || region == 8 {
+							min = 2
+						}
+						for _, f := range []uint32{36, 37} {
+							v := expected[at+f]
+							if v == 255 || v < min {
+								expected[at+f] = min
+							}
