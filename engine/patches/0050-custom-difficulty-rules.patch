+	zero := noChallengeRules()
+	b := customSession(t, zero)
+	if !bytes.Equal(a.m.Mem, b.m.Mem) {
+		t.Fatal("全關改變原版記憶體")
+	}
+	for _, rule := range []string{"debt", "aircraft", "aircraft-transport", "tank", "western", "fortress", "all"} {
+		t.Run(rule, func(t *testing.T) {
+			r := zero
+			switch rule {
+			case "debt":
+				r.DebtX5 = true
+			case "aircraft":
+				r.Aircraft = VehicleBalanced
+			case "aircraft-transport":
