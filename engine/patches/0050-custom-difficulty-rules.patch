index 0000000..e9daf92
--- /dev/null
+++ b/apps/hr/play/challenge_test.go
@@ -0,0 +1,165 @@
+package main
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+func TestChallengeDraftIsolationAndDisabledStrategy(t *testing.T) {
+	d, gr, pauses, resumes := toolbarRig(t)
+	d.openEditor()
+	if *pauses != 1 {
+		t.Fatal("編輯未暫停")
+	}
+	for i := 0; i < 8; i++ {
+		if !d.editor.enabled(i) {
+			t.Fatal("預設未全開", i)
+		}
+	}
+	r := d.editor.rules
+	d.editor.toggle(4)
+	disabled := d.editor.rules
+	d.editor.strategy(4)
+	if d.editor.rules != disabled || d.editor.aircraft != hrrt.VehicleTransport {
+		t.Fatal("關閉的 UI 策略進入有效設定")
+	}
+	d.editor.toggle(4)
+	if d.editor.rules.Aircraft != hrrt.VehicleTransport {
+		t.Fatal("未記住策略")
+	}
+	gr.fe.just[ebiten.KeyEscape] = true
+	d.Update()
+	if d.editor != nil || d.rules.Schema != 0 || *resumes != 1 || d.customRules() != r {
+		t.Fatal("取消改變待選設定")
+	}
+}
+
+func TestChallengeSameDigestAndFailedSwitchPreserveActive(t *testing.T) {
+	d, gr, _, resumes := toolbarRig(t)
+	r := hrrt.DefaultChallengeRules()
+	d.targetRules = r
+	d.installGame(gr.g, hrrt.DifficultyCustom)
+	d.startWithRules = func(hrrt.Difficulty, *hrrt.ChallengeRules) (*game, error) { t.Fatal("同組重建"); return nil, nil }
+	d.openEditor()
+	d.applyEditor()
+	if d.confirm || d.editor != nil || *resumes != 1 {
+		t.Fatal("同組未恢復")
+	}
+	d.openEditor()
+	d.editor.toggle(0)
+	target := d.editor.rules
+	d.applyEditor()
+	if !d.confirm || d.confirmFocus || d.activeRules != r || d.rules != r {
+		t.Fatal("未先確認或提前提交")
+	}
+	d.startWithRules = func(mode hrrt.Difficulty, rules *hrrt.ChallengeRules) (*game, error) {
+		if mode != hrrt.DifficultyCustom || rules == nil || *rules != target {
+			t.Fatal("錯誤目標")
+		}
+		return nil, errors.New("bad profile")
+	}
+	d.switchPending = true
+	d.Update()
+	if d.g != gr.g || d.activeRules != r || d.rules != r || d.switchErr == nil {
+		t.Fatal("失敗改變目前設定")
+	}
+	gr.fe.just[ebiten.KeyEscape] = true
+	d.Update()
+	gr.fe.just = map[ebiten.Key]bool{}
+	d.openEditor()
+	d.editor.toggle(0)
+	d.applyEditor()
+	next := newGameRig(t, themeOriginal, nil).g
+	d.startWithRules = func(mode hrrt.Difficulty, rules *hrrt.ChallengeRules) (*game, error) { return next, nil }
+	d.switchPending = true
+	d.Update()
+	if d.g != next || d.activeRules != target || d.rules != target || d.confirm {
+		t.Fatal("成功未提交")
+	}
+}
+
+func TestChallengeStartupAndLegacyCLIStayDistinct(t *testing.T) {
+	for _, mode := range []hrrt.Difficulty{hrrt.DifficultyOriginal, hrrt.DifficultyHard, hrrt.DifficultyCustom} {
+		d, gr, _, _ := toolbarRig(t)
+		d.g = nil
+		d.pending = true
+		d.directMode = &mode
+		d.startWithRules = func(got hrrt.Difficulty, rules *hrrt.ChallengeRules) (*game, error) {
+			if got != mode {
+				t.Fatal("CLI 路由改變", mode, got)
+			}
+			if (rules != nil) != (mode == hrrt.DifficultyCustom) {
+				t.Fatal("規則傳給錯誤模式")
+			}
+			return gr.g, nil
+		}
+		if err := d.Update(); err != nil {
+			t.Fatal(err)
+		}
+		if d.mode != mode {
+			t.Fatal(d.mode)
+		}
+	}
+	d, gr, _, _ := toolbarRig(t)
+	d.g = nil
+	d.selected = 1
+	d.pending = true
+	d.startWithRules = func(mode hrrt.Difficulty, rules *hrrt.ChallengeRules) (*game, error) {
+		if mode != hrrt.DifficultyCustom || *rules != hrrt.DefaultChallengeRules() {
+			t.Fatal("新高難度卡未採預設")
+		}
+		return gr.g, nil
+	}
+	d.Update()
+}
+
+func TestChallengeFlagPresenceAndKeyboard(t *testing.T) {
+	for _, mode := range []string{"", "original", "hard", "custom"} {
+		if _, err := decodeChallengeFlag(true, mode, ""); err == nil {
+			t.Fatal("明示空設定未拒絕", mode)
+		}
+	}
+	if r, err := decodeChallengeFlag(false, "custom", ""); err != nil || r != nil {
+		t.Fatal("未指定未保留預設", r, err)
+	}
+	value, _ := hrrt.DefaultChallengeRules().CanonicalJSON()
+	if r, err := decodeChallengeFlag(true, "custom", string(value)); err != nil || *r != hrrt.DefaultChallengeRules() {
+		t.Fatal(r, err)
+	}
+	d, gr, pauses, _ := toolbarRig(t)
+	gr.fe.just[ebiten.KeyF5] = true
+	d.Update()
+	if d.editor == nil || *pauses != 1 {
+		t.Fatal("遊戲中 F5 未開設定")
+	}
+	if ev := gr.ss.take(); len(ev) != 0 {
+		t.Fatal("F5 傳到 DOS", ev)
+	}
+	gr.fe.just = map[ebiten.Key]bool{}
+	gr.fe.press[ebiten.KeyF5] = 33
+	d.closeMenu()
+	if events := keyEvents(nil); len(events) != 0 {
+		t.Fatal("關閉設定後 F5 重複傳入 DOS", events)
+	}
+	d.openEditor()
+	d.g = nil
+	gr.fe.just = map[ebiten.Key]bool{ebiten.KeyQ: true}
+	gr.fe.ctrl = true
+	if err := d.Update(); err != ebiten.Termination {
+		t.Fatal("開場設定攔住 Ctrl+Q", err)
+	}
+}
+
+func TestDifficultyTitleSurvivesGameRefresh(t *testing.T) {
+	d, gr, _, _ := toolbarRig(t)
+	d.refreshTitle()
+	gr.g.env.setTitle("base title")
+	d.refreshTitle()
+	want := tr(gr.g.lang, "app.title", version) + "　[" + difficultyLabel(gr.g.lang, d.mode) + "]"
+	if got := gr.fe.titles[len(gr.fe.titles)-1]; got != want {
+		t.Fatal(got, want)
+	}
+}
