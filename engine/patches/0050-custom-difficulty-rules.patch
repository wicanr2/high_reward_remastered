+			{0x6ee9, 0x034d, [4]uint32{150, 150, 125, 100}}, {0x6ee9, 0x0a59, [4]uint32{150, 150, 125, 100}},
+			{0x6ee9, 0x10ba, [4]uint32{175, 175, 150, 115}}, {0x6ee9, 0x3bb8, [4]uint32{200, 200, 175, 130}},
+			{0x6ee9, 0x3e35, [4]uint32{200, 200, 175, 130}}, {0x6ee9, 0x4dc1, [4]uint32{250, 250, 200, 150}},
+			{0x749c, 0x20c6, [4]uint32{250, 250, 200, 150}}, {0x6ee9, 0x26c1, [4]uint32{150, 150, 150, 150}},
+			{0x6ee9, 0x27ef, [4]uint32{150, 150, 150, 150}}, {0x669d, 0x29, [4]uint32{100, 100, 100, 100}},
+		} {
