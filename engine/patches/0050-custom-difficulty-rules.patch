new file mode 100644
index 0000000..e770d7c
--- /dev/null
+++ b/apps/hr/runtime/challenge_runtime.go
@@ -0,0 +1,222 @@
+package runtime
+
+import (
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+// 016／038 固定 MAIN 的常駐表。位址均為 MZ 載入後的實體位址。
+const challengeTownBase uint32 = 0x319db
+
+func scalePositive(v, percent uint32) uint32 {
+	if v == 0 {
+		return 0
+	}
+	x := v * percent / 100
+	if x == 0 {
+		return 1
+	}
+	return x
+}
+
+func storyPercent(load, ret uint16, field uint32) uint32 {
+	hp, atk, def := uint32(150), uint32(150), uint32(150)
+	if load == 0x749c {
+		hp, atk, def = 250, 200, 150
+	} else {
+		switch ret {
+		case 0x034d, 0x0a59:
+			hp, atk, def = 150, 125, 100
+		case 0x10ba:
+			hp, atk, def = 175, 150, 115
+		case 0x3bb8, 0x3e35:
+			hp, atk, def = 200, 175, 130
+		case 0x4dc1:
+			hp, atk, def = 250, 200, 150
+		}
+	}
+	if field == 15 {
+		return atk
+	}
+	if field == 17 {
+		return def
+	}
+	return hp
+}
+
+func storyScale(h *hardRules, load, ret uint16, field uint32) uint32 {
+	if h.custom == nil {
+		return 150
+	}
+	return storyPercent(load, ret, field)
+}
+
+func (s *Session) initChallenge() error {
+	r := *s.opt.ChallengeRules
+	type change struct {
+		at            uint32
+		before, after byte
+	}
+	var changes []change
+	add := func(at uint32, v byte) { changes = append(changes, change{at, s.m.Mem[at], v}) }
+	word := func(at uint32, v uint32) { add(at, byte(v)); add(at+1, byte(v>>8)) }
+	if r.DebtX5 {
+		if s.m.Peek16(0x37a34) != 0x9680 || s.m.Peek16(0x37a36) != 0x98 {
+			return fmt.Errorf("自訂債務初值不符")
+		}
+		word(0x37a34, 50000000)
+		word(0x37a36, 50000000>>16)
+	}
+	for _, v := range []struct {
+		rule    VehicleRule
+		base    uint32
+		hp, atk []uint16
+		plane   bool
+	}{
+		{r.Tank, 0x3b718, []uint16{50, 60, 70, 80, 90, 100, 110, 130}, []uint16{35, 55, 90, 150, 255, 430, 730, 900}, false},
+		{r.Aircraft, 0x3b880, []uint16{24, 38, 52, 66, 80, 94, 108, 122}, []uint16{90, 125, 175, 245, 340, 475, 665, 930}, true},
+	} {
+		if v.rule == VehicleOriginal {
+			continue
+		}
+		attack, hp := uint32(50), uint32(75)
+		if v.rule == VehicleTransport {
+			attack, hp = 10, 25
+		}
+		for i := 0; i < 8; i++ {
+			a := v.base + uint32(i)*45
+			if s.m.Peek16(a) != v.hp[i] || s.m.Peek16(a+2) != v.atk[i] {
+				return fmt.Errorf("自訂載具第 %d 型原值不符", i)
+			}
+			word(a+2, scalePositive(uint32(v.atk[i]), attack))
+			if v.plane {
+				word(a, scalePositive(uint32(v.hp[i]), hp))
+			}
+		}
+	}
+	if r.WesternGuards || r.FortressDefenses {
+		if s.m.Peek16(0x27bef) != 0x01ab || s.m.Peek16(0x27bf1) != 0x3183 {
+			return fmt.Errorf("自訂城市指標不符")
+		}
+		var regions [99]int
+		for i := range regions {
+			regions[i] = -1
+		}
+		for region := 0; region < 11; region++ {
+			for j := 0; j < 16; j++ {
+				town := s.m.Mem[0x340ec+uint32(region)*73+57+uint32(j)]
+				if town == 0xff {
+					continue
+				}
+				if town >= 99 || regions[town] != -1 {
+					return fmt.Errorf("自訂國家城市索引不符")
+				}
+				regions[town] = region
+			}
+		}
+		for town, region := range regions {
+			if region < 0 {
+				return fmt.Errorf("自訂城市 %d 缺少國家", town)
+			}
+			a := challengeTownBase + uint32(town)*101
+			typ := s.m.Mem[a+0x18]
+			if r.WesternGuards && region >= 6 && town != 64 && typ <= 2 {
+				pct, armor := uint32(125), uint32(115)
+				if region == 8 {
+					pct, armor = 150, 125
+				}
+				if region >= 9 {
+					pct, armor = 175, 150
+				}
+				for _, f := range []uint32{0x1a, 0x20, 0x22} {
+					v := uint32(s.m.Peek16(a + f))
+					if v > 999 {
+						return fmt.Errorf("自訂城防原值超範圍")
+					}
+					p := pct
+					if f == 0x22 {
+						p = armor
+					}
+					x := scalePositive(v, p)
+					if x > 999 {
+						x = 999
+					}
+					word(a+f, x)
+				}
+			}
+			if r.FortressDefenses && typ <= 1 && region != 4 && town != 64 {
+				minimum := byte(3)
+				if region == 5 || region == 6 || region == 7 {
+					minimum = 1
+				}
+				if region == 2 || region == 3 || region == 8 {
+					minimum = 2
+				}
+				for _, f := range []uint32{0x24, 0x25} {
+					v := s.m.Mem[a+f]
+					if v != 0xff && v > 7 {
+						return fmt.Errorf("自訂城市載具索引不符")
+					}
+					if v == 0xff || v < minimum {
+						add(a+f, minimum)
+					}
+				}
+			}
+		}
+	}
+	// 先完成所有欄位驗證，再一次提交；此時 CPU 尚未執行。
+	for _, c := range changes {
+		if s.m.Mem[c.at] != c.before {
+			return fmt.Errorf("自訂規則寫入前狀態改變")
+		}
+	}
+	for _, c := range changes {
+		s.m.Mem[c.at] = c.after
+	}
+	s.hard = &hardRules{custom: &r}
+	return nil
+}
+
+type aircraftShop struct {
+	town uint16
+	slot int
+	typ  byte
+}
+
+var customDisabledShops = [...]aircraftShop{
+	{0, 7, 0x3d}, {15, 6, 0x3e}, {29, 7, 0x3f}, {35, 7, 0x3f},
+	{40, 6, 0x39}, {40, 7, 0x3a}, {43, 6, 0x3c}, {57, 4, 0x38},
+	{60, 6, 0x3b}, {63, 6, 0x3a}, {73, 4, 0x3d},
+}
+
+func (s *Session) customShop() error {
+	c := s.m.CPU
+	a, err := s.hardFrame(c.R[cpu.BP], 8)
+	if err != nil {
+		return err
+	}
+	town := s.m.Peek16(a + 6)
+	var targets []uint32
+	for _, p := range customDisabledShops {
+		if p.town != town {
+			continue
+		}
+		at := uint32(0x3a90c + p.slot*25 + 24)
+		if s.m.Mem[at] != p.typ {
+			return fmt.Errorf("自訂商店 %d 格 %d 類型不符", town, p.slot)
+		}
+		targets = append(targets, at)
+	}
+	if len(targets) == 0 {
+		return nil
+	}
+	if err := s.hardSignature(0x1c19, 0x63, []byte{0x83, 0xc4, 0x14, 0xba, 0x40, 0x3a, 0xb8, 0x0c, 0x05}); err != nil {
+		return err
+	}
+	for _, at := range targets {
+		s.m.Mem[at] = 0xff
+	}
+	s.armHardStep(20)
+	return nil
+}
