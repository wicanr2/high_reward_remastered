diff --git a/apps/hr/cmd/hrdifficultyprobe/main.go b/apps/hr/cmd/hrdifficultyprobe/main.go
new file mode 100644
index 0000000..52c5343
--- /dev/null
+++ b/apps/hr/cmd/hrdifficultyprobe/main.go
@@ -0,0 +1,222 @@
+// hrdifficultyprobe 只經 Session 與正常滑鼠輸入重播規格014驗收。
+// 快照含原版資料，只能輸出至本機研究目錄。沒有跳關或注入能力／金錢。
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/dos"
+	"github.com/wicanr2/dosgolem/internal/machine"
+	"github.com/wicanr2/dosgolem/internal/state"
+)
+
+// 只讀原版呼叫鏈，讓旅途輸入不會在一般戰鬥中選到「全體退卻」。
+func battleActive(m *machine.Machine) bool {
+	isBattle := func(cs uint16) bool {
+		return cs > 0 && m.Read16(cpu.Linear(cs-1, 0x0e)) == 0x53b5 && m.Read16(cpu.Linear(0x53b5, 0x10)) == cs
+	}
+	if isBattle(m.CPU.Seg[cpu.CS]) {
+		return true
+	}
+	bp := m.CPU.R[cpu.BP]
+	for i := 0; i < 24 && bp < 0xfffa; i++ {
+		a := cpu.Linear(m.CPU.Seg[cpu.SS], bp)
+		if isBattle(m.Read16(a + 4)) {
+			return true
+		}
+		next := m.Read16(a)
+		if next <= bp {
+			break
+		}
+		bp = next
+	}
+	// 部分文字等待不走 AH=3 滑鼠輪詢。固定右側健康面板的兩條邊框
+	// 是本輪正常畫面抽樣的輔助識別，不影響任何遊戲記憶體。
+	w, h, px := m.Planar()
+	if w == 640 && h == 480 && len(px) == w*h {
+		top, bottom := px[107*w+350], px[174*w+350]
+		a, b := 0, 0
+		for x := 350; x < 615; x++ {
+			if px[107*w+x] == top {
+				a++
+			}
+			if px[174*w+x] == bottom {
+				b++
+			}
+		}
+		return top != bottom && a > 255 && b > 255
+	}
+	return false
+}
+
+func main() {
+	orig := flag.String("orig", "/orig", "原版來源")
+	base := flag.String("profile-base", "", "存檔基底")
+	mode := flag.String("difficulty", "original", "original 或 hard")
+	out := flag.String("out", "", "本機輸出前綴")
+	resume := flag.String("resume", "", "接續同模式正常路徑快照")
+	actions := flag.String("actions", "", "x,y[,button] 以分號相隔；button -1 只移動")
+	keys := flag.String("keys", "", "正常鍵盤輸入 Esc 或 Enter，以逗號相隔")
+	init := flag.Bool("init", false, "由標題正常點選新遊戲並閱讀開場")
+	waitSteps := flag.Uint64("wait-steps", 0, "最後繼續執行的正常指令數")
+	dialogues := flag.Int("advance-dialogues", 0, "以正常點擊推進旅途對話；每次相隔 500 萬指令")
+	stopStory := flag.Bool("stop-on-story-battle", false, "首次記錄劇情敵軍倍率後停止旅途點擊")
+	flag.Parse()
+	if *out == "" || *base == "" {
+		panic("需要 out 與 profile-base")
+	}
+	difficulty, err := hrrt.ParseDifficulty(*mode)
+	if err != nil {
+		panic(err)
+	}
+	var logs []string
+	s, err := hrrt.Open(*orig, hrrt.Options{Difficulty: difficulty, SaveDir: *base, NoPacing: true, Log: func(f string, a ...any) { line := fmt.Sprintf(f, a...); logs = append(logs, line); fmt.Println(line) }})
+	if err != nil {
+		panic(err)
+	}
+	m, d := s.Machine(), s.DOS()
+	if *resume != "" {
+		if err := state.Load(*resume, m, d); err != nil {
+			panic(err)
+		}
+	}
+	run := func(n uint64) {
+		if st := s.RunSteps(m.Steps + n); st.Kind != hrrt.StopSteps {
+			panic(st)
+		}
+	}
+	click := func(x, y, button int) {
+		d.MoveMouse(x, y+40)
+		run(500000)
+		if button >= 0 {
+			d.PressMouse(button)
+			for i := 0; i < 3; i++ {
+				st, _ := s.RunToPoll(2000000)
+				if st != nil && st.Kind != hrrt.StopSteps {
+					panic(st)
+				}
+			}
+			d.ReleaseMouse(button)
+		}
+		run(5000000)
+	}
+	type receipt struct {
+		Label      string
+		Steps      uint64
+		Debt, Cash uint32
+		Logs       []string
+		Mouse      [7]uint16 // X/Y、範圍、按鍵狀態，供核對輸入實際落點。
+	}
+	var receipts []receipt
+	shot := func(label string) {
+		b, err := s.ScreenPNG()
+		if err != nil {
+			panic(err)
+		}
+		if err = os.WriteFile(*out+"-"+label+".png", b, 0644); err != nil {
+			panic(err)
+		}
+		if err = state.Save(*out+"-current.state", m, d); err != nil {
+			panic(err)
+		}
+		u32 := func(a uint32) uint32 { return uint32(m.Read16(a)) | uint32(m.Read16(a+2))<<16 }
+		receipts = append(receipts, receipt{label, m.Steps, u32(0x37a34), u32(0x37a28), append([]string(nil), logs...), [7]uint16{d.Mouse.X, d.Mouse.Y, d.Mouse.MinX, d.Mouse.MaxX, d.Mouse.MinY, d.Mouse.MaxY, d.Mouse.Buttons}})
+	}
+	if *init {
+		run(30000000)
+		click(312, 171, 0)
+		for i := 0; i < 18; i++ {
+			click(400, 220, 0)
+		}
+	} else if *resume == "" {
+		run(30000000)
+	}
+	shot("start")
+	if *keys != "" {
+		for _, name := range strings.Split(*keys, ",") {
+			k := dos.Key{Scan: 1, ASCII: 27}
+			if name == "Enter" {
+				k = dos.Key{Scan: 0x1c, ASCII: 13}
+			} else if name != "Esc" {
+				panic("未知按鍵：" + name)
+			}
+			s.Input(hrrt.Event{Kind: hrrt.EvKey, Key: k})
+			run(5000000)
+		}
+		shot("keys")
+	}
+	for i, action := range strings.Split(*actions, ";") {
+		if action == "" {
+			continue
+		}
+		v := strings.Split(action, ",")
+		if len(v) < 2 {
+			panic(action)
+		}
+		x, e := strconv.Atoi(v[0])
+		if e != nil {
+			panic(e)
+		}
+		y, e := strconv.Atoi(v[1])
+		if e != nil {
+			panic(e)
+		}
+		button := 0
+		if len(v) > 2 {
+			button, e = strconv.Atoi(v[2])
+			if e != nil {
+				panic(e)
+			}
+		}
+		click(x, y, button)
+		shot(fmt.Sprintf("%02d", i))
+	}
+	if *waitSteps > 0 {
+		run(*waitSteps)
+		shot("wait")
+	}
+	for i := 0; i < *dialogues; i++ {
+		st, _ := s.RunToPoll(5000000)
+		if st != nil && st.Kind != hrrt.StopSteps {
+			panic(st)
+		}
+		if battleActive(m) {
+			// 原版戰鬥命令選單固定第三項「戰鬥繼續」。不改能力或戰果。
+			click(320, 220, 0)
+			run(30000000)
+		} else {
+			// 點擊固定資訊欄，避免在地圖中央誤選城市或重新下達移動命令。
+			click(620, 390, 0)
+		}
+		if *stopStory {
+			seen := false
+			for _, line := range logs {
+				seen = seen || strings.Contains(line, "高難度劇情敵軍")
+			}
+			if seen {
+				shot("story-battle")
+				break
+			}
+		}
+		if (i+1)%20 == 0 {
+			shot(fmt.Sprintf("dialogue-%03d", i+1))
+		}
+	}
+	b, err := json.MarshalIndent(map[string]any{"mode": *mode, "source_sha256": "08ed144e8f8d6e97d19f0759bce2420665998143f2f0f056ab7adc718e550e3e", "fork_version": "014 working tree", "clock": "runtime default fixed DOS clock; battle srand from original clock call", "interval": hrrt.DefaultInterval, "profile": hrrt.SavePath(*base, difficulty), "receipts": receipts}, "", "  ")
+	if err != nil {
+		panic(err)
+	}
+	if err = os.WriteFile(*out+".json", b, 0644); err != nil {
+		panic(err)
+	}
+	fmt.Println(filepath.Base(*out), "complete", m.Steps)
+	fmt.Println("GAMEFILE.000 source", d.OpenedLayers["GAMEFILE.000"])
+}
diff --git a/apps/hr/play/difficulty.go b/apps/hr/play/difficulty.go
new file mode 100644
index 0000000..0e3c021
--- /dev/null
+++ b/apps/hr/play/difficulty.go
@@ -0,0 +1,170 @@
+package main
+
+import (
+	"fmt"
+	"image"
+	"image/color"
+	"strings"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	"github.com/hajimehoshi/ebiten/v2/ebitenutil"
+	"github.com/hajimehoshi/ebiten/v2/inpututil"
+	"github.com/hajimehoshi/ebiten/v2/text"
+	"github.com/hajimehoshi/ebiten/v2/vector"
+	"golang.org/x/image/font"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// difficultyGate 在唯一一次 RunGame 中先選難度，再建立與執行遊戲。
+// 選擇之前沒有 Session、CPU、音訊或存檔寫入。
+type difficultyGate struct {
+	start     func(hrrt.Difficulty) (*game, error)
+	g         *game
+	fonts     *fontSet
+	lang      lang
+	selected  int
+	pending   bool
+	err       error
+	mode      hrrt.Difficulty
+	lastTitle string
+	logf      func(string, ...any)
+}
+
+var difficultyCards = [2]image.Rectangle{image.Rect(80, 220, 610, 620), image.Rect(670, 220, 1200, 620)}
+
+func (d *difficultyGate) Update() error {
+	if d.g != nil {
+		err := d.g.Update()
+		title := tr(d.g.lang, "app.title", version) + "　[" + difficultyLabel(d.g.lang, d.mode) + "]"
+		if title != d.lastTitle {
+			ebiten.SetWindowTitle(title)
+			d.lastTitle = title
+		}
+		return err
+	}
+	if inpututil.IsKeyJustPressed(ebiten.KeyEscape) || ebiten.IsKeyPressed(ebiten.KeyControl) && inpututil.IsKeyJustPressed(ebiten.KeyQ) {
+		return ebiten.Termination
+	}
+	if d.err != nil {
+		return nil
+	}
+	if d.pending {
+		mode := hrrt.DifficultyOriginal
+		if d.selected == 1 {
+			mode = hrrt.DifficultyHard
+		}
+		d.mode = mode
+		g, err := d.start(mode)
+		if err != nil {
+			d.err = err
+			d.logf("啟動失敗：%v", err)
+			return nil
+		}
+		d.g = g
+		ebiten.SetCursorMode(ebiten.CursorModeHidden)
+		return nil
+	}
+	if inpututil.IsKeyJustPressed(ebiten.KeyTab) || inpututil.IsKeyJustPressed(ebiten.KeyArrowUp) || inpututil.IsKeyJustPressed(ebiten.KeyArrowDown) {
+		d.selected = 1 - d.selected
+	}
+	if inpututil.IsKeyJustPressed(ebiten.KeyArrowLeft) {
+		d.selected = 0
+	}
+	if inpututil.IsKeyJustPressed(ebiten.KeyArrowRight) {
+		d.selected = 1
+	}
+	if inpututil.IsKeyJustPressed(ebiten.KeyEnter) || inpututil.IsKeyJustPressed(ebiten.KeyNumpadEnter) {
+		d.pending = true
+	}
+	if inpututil.IsMouseButtonJustPressed(ebiten.MouseButtonLeft) {
+		x, y := ebiten.CursorPosition()
+		for i, r := range difficultyCards {
+			if image.Pt(x, y).In(r) {
+				d.selected = i
+				d.pending = true
+			}
+		}
+	}
+	return nil
+}
+
+func difficultyLabel(l lang, mode hrrt.Difficulty) string {
+	if mode == hrrt.DifficultyHard {
+		return tr(l, "difficulty.hard")
+	}
+	return tr(l, "difficulty.original")
+}
+
+func (d *difficultyGate) Draw(screen *ebiten.Image) {
+	if d.g != nil {
+		d.g.Draw(screen)
+		return
+	}
+	screen.Fill(color.RGBA{12, 16, 28, 255})
+	l := d.lang
+	face := d.fonts.face(l)
+	if face == nil {
+		l = langEN
+	}
+	draw := func(s string, x, y int, c color.Color) {
+		if face == nil {
+			ebitenutil.DebugPrintAt(screen, s, x, y-18)
+			return
+		}
+		text.Draw(screen, s, face, x, y, c)
+	}
+	fg := color.RGBA{215, 222, 235, 255}
+	muted := color.RGBA{174, 185, 204, 255}
+	draw(tr(l, "app.title", version), 80, 115, fg)
+	draw(tr(l, "difficulty.title"), 80, 170, muted)
+	for i, r := range difficultyCards {
+		vector.DrawFilledRect(screen, float32(r.Min.X), float32(r.Min.Y), float32(r.Dx()), float32(r.Dy()), color.RGBA{23, 32, 50, 255}, false)
+		border := color.RGBA{82, 97, 123, 255}
+		if i == d.selected {
+			border = color.RGBA{207, 183, 118, 255}
+		}
+		vector.StrokeRect(screen, float32(r.Min.X), float32(r.Min.Y), float32(r.Dx()), float32(r.Dy()), 3, border, false)
+		mode := hrrt.DifficultyOriginal
+		key := "difficulty.info.original"
+		if i == 1 {
+			mode = hrrt.DifficultyHard
+			key = "difficulty.info.hard"
+		}
+		draw(difficultyLabel(l, mode), r.Min.X+30, 285, color.RGBA{240, 221, 177, 255})
+		for n, line := range strings.Split(tr(l, key), "\n") {
+			draw(line, r.Min.X+30, 345+n*42, fg)
+		}
+	}
+	hint := tr(l, "difficulty.hint")
+	if d.pending {
+		hint = tr(l, "difficulty.loading")
+	}
+	if d.err != nil {
+		hint = tr(l, "difficulty.error")
+	}
+	draw(hint, 80, 715, muted)
+}
+func (d *difficultyGate) Layout(int, int) (int, int) {
+	if d.g != nil {
+		return d.g.Layout(1280, 800)
+	}
+	return 1280, 800
+}
+
+// validateDifficultyText 與實際繪製共用字面及卡片寬度。
+func validateDifficultyText(l lang, face font.Face) error {
+	for _, key := range []string{"difficulty.original", "difficulty.hard", "difficulty.info.original", "difficulty.info.hard"} {
+		for _, line := range strings.Split(tr(l, key), "\n") {
+			if font.MeasureString(face, line).Ceil() > 470 {
+				return fmt.Errorf("%s %s 超出卡片", l, key)
+			}
+		}
+	}
+	for _, key := range []string{"difficulty.hint", "difficulty.loading", "difficulty.error", "difficulty.title"} {
+		if font.MeasureString(face, tr(l, key)).Ceil() > 1120 {
+			return fmt.Errorf("%s %s 超出畫面", l, key)
+		}
+	}
+	return nil
+}
