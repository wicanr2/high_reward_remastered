+// 正對照把 IRQ 精確排在掛點前，第一道實際指令為 IRET。
+// 返回同一掛點時只能消耗既有變更；相同位置的下一次呼叫仍須正常套用。
+func TestHardHooksSurviveIRQBeforeInstruction(t *testing.T) {
+	for _, kind := range []string{"credit", "notice", "shop"} {
+		t.Run(kind, func(t *testing.T) {
+			s := hardSession(t)
+			m, c := s.m, s.m.CPU
+			m.Write16(0x20, 0)
+			m.Write16(0x22, 0x9000)
+			m.Mem[0x90000] = 0xcf // INT 08h: IRET
+			m.IRQ0Every = 300000
+			m.Steps = 1000000000
+			for invocation := 1; invocation <= 2; invocation++ {
+				c.R[cpu.SP], c.R[cpu.BP] = 0x7000, 0x7100
+				c.SetFlags(0x200)
+				a := cpu.Linear(s.stackSeg, 0x7000)
+				off := uint32(4)
+				if kind == "shop" {
+					c.Seg[cpu.CS], c.IP = 0x1c19, 0x63
+					m.Write16(cpu.Linear(s.stackSeg, 0x7106), 57)
+					raw, err := os.ReadFile(filepath.Join(origRoot(t), "SHOPTAB.TBL"))
+					if err != nil {
+						t.Fatal(err)
+					}
+					copy(m.Mem[0x3a90c:0x3a90c+200], raw[57*200:58*200])
+				} else {
+					installOverlayForTest(s, 0x6ee9, 0x7000)
+					c.Seg[cpu.CS], c.IP = 0x1a9a, 5
+					ret := uint16(0x175)
+					if kind == "notice" {
+						c.IP, ret, off = 0x2ac, 0x16b, 6
+					}
+					m.Write16(a, ret)
+					m.Write16(a+2, 0x7000)
+					m.Write16(a+off, 10000)
+					m.Write16(a+off+2, 0)
+				}
+				entryCS, entryIP := c.Seg[cpu.CS], c.IP
+				for step := 0; step < 2; step++ {
+					if st := s.RunSteps(m.Steps + 1); st.Kind != StopSteps {
+						t.Fatal(st)
+					}
+					if kind == "shop" {
+						if m.Read8(0x3a90c+4*25+24) != 0xff {
+							t.Fatal("商店未停用")
+						}
+					} else if m.Read16(a+off) != 5000 || m.Read16(a+off+2) != 0 {
+						t.Fatal("獎金重複除二")
+					}
+					if step == 0 {
+						if c.Seg[cpu.CS] != entryCS || c.IP != entryIP || len(s.hard.pending) != 1 {
+							t.Fatal("未停在 IRQ 返回的同一掛點")
+						}
+					} else {
+						cs, ip := m.Insn()
+						if cs != entryCS || ip != entryIP || len(s.hard.pending) != 0 {
+							t.Fatal("實際指令後未清除標記")
+						}
+					}
+				}
+				if m.Ticks != uint64(invocation) {
+					t.Fatal("IRQ 正對照未觸發", m.Ticks)
+				}
+				m.Steps += 300000
+			}
+		})
+	}
+}
