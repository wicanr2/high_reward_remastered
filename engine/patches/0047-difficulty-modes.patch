+func TestHardRejectsTruncatedSave(t *testing.T) {
+	s := hardSession(t)
+	if err := os.WriteFile(filepath.Join(s.d.Scratch, "GAMEFILE.000"), []byte("partial"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	_, err := Open(origRoot(t), s.opt)
+	if err == nil || !strings.Contains(err.Error(), "31839") {
+		t.Fatal("短存檔未拒絕", err)
+	}
+	b, err := os.ReadFile(filepath.Join(s.d.Scratch, "GAMEFILE.000"))
+	if err != nil || string(b) != "partial" {
+		t.Fatal("錯誤檔案被改寫", err)
+	}
+}
