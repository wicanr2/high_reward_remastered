@@ -0,0 +1,27 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestDifficultyChooserGlyphsAndBounds(t *testing.T) {
+	for _, l := range langOrder {
+		_, face := newFace(t, readFont(t, string(l)))
+		if err := validateDifficultyText(l, face); err != nil {
+			t.Error(err)
+		}
+		for key, s := range trTable[l] {
+			if strings.HasPrefix(key, "difficulty.") {
+				for _, r := range s {
+					if r == '\n' {
+						continue
+					}
+					if _, ok := face.GlyphAdvance(r); !ok {
+						t.Errorf("%s %s 缺字 %q", l, key, r)
+					}
+				}
+			}
+		}
+	}
+}
