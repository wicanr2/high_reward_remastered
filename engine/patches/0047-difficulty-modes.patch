diff --git a/apps/hr/runtime/difficulty.go b/apps/hr/runtime/difficulty.go
new file mode 100644
index 0000000..86c7739
--- /dev/null
+++ b/apps/hr/runtime/difficulty.go
@@ -0,0 +1,264 @@
+package runtime
+
+import (
+	"bytes"
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+// Difficulty 是規格014的玩法模式，與顯示主題無關。零值保留原版。
+type Difficulty string
+
+const (
+	DifficultyOriginal Difficulty = ""
+	DifficultyHard     Difficulty = "hard"
+)
+
+func ParseDifficulty(v string) (Difficulty, error) {
+	switch v {
+	case "original":
+		return DifficultyOriginal, nil
+	case "hard":
+		return DifficultyHard, nil
+	}
+	return "", fmt.Errorf("未知難度 %q，請使用 original 或 hard", v)
+}
+func (d Difficulty) String() string {
+	if d == DifficultyOriginal {
+		return "original"
+	}
+	return string(d)
+}
+
+type hardRules struct {
+	battleScaled bool
+	pending      []hardInvocation
+}
+
+// Step 可能先送 IRQ，當次真正執行的是 ISR。保留這次呼叫的標記，
+// 直到 Insn 證實掛點指令已消耗，避免 IRET 回來時再次修改引數。
+type hardInvocation struct {
+	cs, ip, ss, sp, bp uint16
+	spDelta            int16
+}
+
+func (s *Session) hardInvocation() hardInvocation {
+	c := s.m.CPU
+	return hardInvocation{cs: c.Seg[cpu.CS], ip: c.IP, ss: c.Seg[cpu.SS], sp: c.R[cpu.SP], bp: c.R[cpu.BP]}
+}
+func (s *Session) hardBeforeStep() error {
+	if len(s.hard.pending) > 0 {
+		key := s.hardInvocation()
+		for _, p := range s.hard.pending {
+			p.spDelta = 0
+			if p == key {
+				return nil
+			}
+		}
+	}
+	return s.hardPre()
+}
+func (s *Session) armHardStep(delta int16) {
+	p := s.hardInvocation()
+	p.spDelta = delta
+	s.hard.pending = append(s.hard.pending, p)
+}
+func (s *Session) hardAfterStep() {
+	if len(s.hard.pending) == 0 {
+		return
+	}
+	cs, ip := s.m.Insn()
+	c := s.m.CPU
+	keep := s.hard.pending[:0]
+	for _, p := range s.hard.pending {
+		if p.cs == cs && p.ip == ip && p.ss == c.Seg[cpu.SS] && uint16(int32(p.sp)+int32(p.spDelta)) == c.R[cpu.SP] && p.bp == c.R[cpu.BP] {
+			continue
+		}
+		keep = append(keep, p)
+	}
+	s.hard.pending = keep
+}
+
+// 只列原始 IDA overlay 與 far return IP；執行期 overlay 段由原廠 stub 解算。
+type storyGrant struct {
+	overlay, notice, credit uint16
+	amount                  uint32
+}
+
+var storyGrants = [...]storyGrant{
+	{0x6db5, 0x05ad, 0x05b7, 100000}, {0x6db5, 0x06a2, 0x06ac, 300000},
+	{0x6ee9, 0x016b, 0x0175, 10000}, {0x6ee9, 0x0418, 0x0422, 10000},
+	{0x6ee9, 0x0917, 0x0921, 20000}, {0x6ee9, 0x3a0a, 0x3a14, 50000},
+	{0x6ee9, 0x3ebb, 0x3ec5, 50000}, {0x6ee9, 0x4276, 0x4280, 100000},
+	{0x6ee9, 0x4e58, 0x4e62, 5000000}, {0x6ee9, 0x5a55, 0x5a60, 10000000},
+	{0x749c, 0x06d5, 0x06df, 1000000}, {0x749c, 0x13b6, 0x13c0, 600000},
+	{0x749c, 0x1456, 0x1460, 500000},
+}
+
+func (s *Session) overlayLoadSeg(cs uint16) uint16 {
+	o, ok := ovrByIdx(s.ovrIdxOfCS(cs))
+	if !ok {
+		return 0
+	}
+	// 反向核對 stub 目前仍指向此載入段。
+	if s.m.Peek16(cpu.Linear(o.StubSeg, 0x10)) != cs {
+		return 0
+	}
+	return o.LoadSeg
+}
+func storyBattle(load, ret uint16) bool {
+	if load == 0x749c {
+		return ret == 0x20c6
+	}
+	if load != 0x6ee9 {
+		return false
+	}
+	switch ret {
+	case 0x034d, 0x0a59, 0x10ba, 0x26c1, 0x27ef, 0x3bb8, 0x3e35, 0x4dc1:
+		return true
+	}
+	return false
+}
+func (s *Session) hardFrame(off uint16, size uint32) (uint32, error) {
+	c := s.m.CPU
+	if c.Seg[cpu.SS] != s.stackSeg || uint32(off)+size > 0x10000 {
+		return 0, fmt.Errorf("高難度掛鉤：堆疊範圍不符")
+	}
+	a := cpu.Linear(c.Seg[cpu.SS], off)
+	if a+size > 0xa0000 {
+		return 0, fmt.Errorf("高難度掛鉤：記憶體範圍不符")
+	}
+	return a, nil
+}
+func (s *Session) hardSignature(cs, ip uint16, b []byte) error {
+	a := cpu.Linear(cs, ip)
+	if a+uint32(len(b)) > uint32(len(s.m.Mem)) || !bytes.Equal(s.m.Mem[a:a+uint32(len(b))], b) {
+		return fmt.Errorf("高難度掛鉤：%04X:%04X 指令特徵不符", cs, ip)
+	}
+	return nil
+}
+func (s *Session) hardPre() error {
+	c := s.m.CPU
+	cs, ip := c.Seg[cpu.CS], c.IP
+	switch {
+	case cs == 0x1a9a && (ip == 0x0005 || ip == 0x02ac):
+		a, err := s.hardFrame(c.R[cpu.SP], 10)
+		if err != nil {
+			return err
+		}
+		load, ret := s.overlayLoadSeg(s.m.Peek16(a+2)), s.m.Peek16(a)
+		for _, g := range storyGrants {
+			target, amountOff := g.credit, uint32(4)
+			if ip == 0x02ac {
+				target, amountOff = g.notice, 6
+			}
+			if load != g.overlay || ret != target {
+				continue
+			}
+			if err := s.hardSignature(cs, ip, []byte{0x55, 0x8b, 0xec, 0x1e}); err != nil {
+				return err
+			}
+			v := uint32(s.m.Peek16(a+amountOff)) | uint32(s.m.Peek16(a+amountOff+2))<<16
+			if v != g.amount {
+				return fmt.Errorf("高難度獎金：%04X:%04X 原額 %d 不符 %d", load, ret, v, g.amount)
+			}
+			v /= 2
+			s.m.Write16(a+amountOff, uint16(v))
+			s.m.Write16(a+amountOff+2, uint16(v>>16))
+			s.armHardStep(-2) // push bp
+			s.logf("高難度獎金 %04X:%04X：%d → %d", load, ret, g.amount, v)
+			break
+		}
+	case cs == 0x1c19 && ip == 0x0063:
+		a, err := s.hardFrame(c.R[cpu.BP], 8)
+		if err != nil {
+			return err
+		}
+		town := s.m.Peek16(a + 6)
+		slot, typ := -1, byte(0)
+		switch town {
+		case 57:
+			slot, typ = 4, 0x38
+		case 60:
+			slot, typ = 6, 0x3b
+		case 63:
+			slot, typ = 6, 0x3a
+		}
+		if slot < 0 {
+			return nil
+		}
+		if err := s.hardSignature(cs, ip, []byte{0x83, 0xc4, 0x14, 0xba, 0x40, 0x3a, 0xb8, 0x0c, 0x05}); err != nil {
+			return err
+		}
+		at := uint32(0x3a90c + slot*25 + 24)
+		if s.m.Mem[at] != typ {
+			return fmt.Errorf("高難度商店：城鎮 %d 類型 %02X 不符 %02X", town, s.m.Mem[at], typ)
+		}
+		s.m.Mem[at] = 0xff
+		s.armHardStep(20) // add sp,14h
+	case ip == 0 || ip == 0x015c:
+		if s.overlayLoadSeg(cs) != 0x7718 {
+			return nil
+		}
+		if ip == 0 {
+			s.hard.battleScaled = false
+			return nil
+		}
+		if s.hard.battleScaled {
+			return nil
+		}
+		a, err := s.hardFrame(c.R[cpu.BP], 16)
+		if err != nil {
+			return err
+		}
+		if s.m.Peek16(a+2) != 0x0602 || s.m.Peek16(a+4) != 0x1514 {
+			return nil
+		}
+		parent := s.m.Peek16(a)
+		b, err := s.hardFrame(parent, 6)
+		if err != nil {
+			return err
+		}
+		load, ret := s.overlayLoadSeg(s.m.Peek16(b+4)), s.m.Peek16(b+2)
+		if !storyBattle(load, ret) {
+			return nil
+		}
+		if s.m.Peek16(a+12) != 7 || s.m.Peek16(a+6) >= 6 || c.Seg[cpu.DS] != 0x4d04 {
+			return fmt.Errorf("高難度戰鬥：劇情 frame 不符")
+		}
+		if err := s.hardSignature(cs, 0x0159, []byte{0xe8, 0xf9, 0x13, 0x1e, 0x68, 0x95, 0x0b}); err != nil {
+			return err
+		}
+		base := cpu.Linear(0x4d04, 0)
+		n := s.m.Peek16(base + 8)
+		if n == 0 || n > 11 || s.m.Peek16(base+0xe99) == 0 && s.m.Peek16(base+0xe9b) == 0 {
+			return fmt.Errorf("高難度戰鬥：敵方配置無效（%d）", n)
+		}
+		var updates []struct {
+			at uint32
+			v  uint16
+		}
+		for i := uint16(0); i < n; i++ {
+			for _, f := range []uint32{9, 11, 15, 17} {
+				at := base + 0x591 + uint32(i)*0x23 + f
+				v := uint32(s.m.Peek16(at))
+				v = v * 3 / 2
+				if v > 32767 {
+					return fmt.Errorf("高難度戰鬥：能力超過有號 16-bit 範圍")
+				}
+				updates = append(updates, struct {
+					at uint32
+					v  uint16
+				}{at, uint16(v)})
+			}
+		}
+		for _, u := range updates {
+			s.m.Write16(u.at, u.v)
+		}
+		s.hard.battleScaled = true
+		s.armHardStep(-2) // push ds
+		s.logf("高難度劇情敵軍 %04X:%04X：%d 筆生命與攻防 ×1.5", load, ret, n)
+	}
+	return nil
+}
diff --git a/apps/hr/runtime/difficulty_profile.go b/apps/hr/runtime/difficulty_profile.go
new file mode 100644
index 0000000..9ef67ab
--- /dev/null
+++ b/apps/hr/runtime/difficulty_profile.go
@@ -0,0 +1,285 @@
+package runtime
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/wicanr2/dosgolem/apps/hr/patch"
+)
+
+const hardProfileMarker = "{\"mode\":\"hard-v1\",\"source_sha256\":\"" + patch.MainEXESHA256 + "\"}\n"
+
+// SavePath 從同一玩家基底取得模式目錄；原版路徑保持不變。
+func SavePath(base string, d Difficulty) string {
+	if base == "" || d == DifficultyOriginal {
+		return base
+	}
+	return filepath.Clean(base) + "-hard"
+}
+
+// realTarget 解析尚未存在的目錄，仍核對所有已存在祖先的符號連結。
+func realTarget(p string) (string, error) {
+	a, err := filepath.Abs(p)
+	if err != nil {
+		return "", err
+	}
+	var tail []string
+	for {
+		r, e := filepath.EvalSymlinks(a)
+		if e == nil {
+			for i := len(tail) - 1; i >= 0; i-- {
+				r = filepath.Join(r, tail[i])
+			}
+			return r, nil
+		}
+		if !os.IsNotExist(e) {
+			return "", e
+		}
+		parent := filepath.Dir(a)
+		if parent == a {
+			return "", e
+		}
+		tail = append(tail, filepath.Base(a))
+		a = parent
+	}
+}
+func insidePath(parent, child string) bool {
+	r, err := filepath.Rel(parent, child)
+	return err == nil && r != ".." && !strings.HasPrefix(r, ".."+string(filepath.Separator))
+}
+
+func regularBytes(p string) ([]byte, error) {
+	st, err := os.Lstat(p)
+	if err != nil {
+		return nil, err
+	}
+	if !st.Mode().IsRegular() {
+		return nil, fmt.Errorf("必須是一般檔案：%s", p)
+	}
+	return os.ReadFile(p)
+}
+func profileWrite(p string, b []byte) error {
+	f, err := os.CreateTemp(filepath.Dir(p), ".difficulty-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err = f.Write(b); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Chmod(0o644); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(name, p)
+}
+func checkProfileIndex(b []byte) error {
+	lines := strings.Split(strings.TrimRight(string(b), "\r\n"), "\n")
+	if len(lines) != 5 || bytes.IndexByte(b, 0) >= 0 {
+		return fmt.Errorf("高難度 FNAME 必須恰有五行且無 NUL")
+	}
+	for i, line := range lines {
+		t := strings.FieldsFunc(line, func(r rune) bool { return r <= 32 })
+		if len(t) != 4 || t[0] != fmt.Sprint(i) || len(t[1]) > 10 || len(t[2]) > 9 || len(t[3]) > 21 {
+			return fmt.Errorf("高難度 FNAME 第 %d 行格式或欄位長度不符", i+1)
+		}
+	}
+	return nil
+}
+
+// prepareDifficulty 不改原版來源。高難度只投影必要檔案，排除來源附帶進度。
+func prepareDifficulty(root string, opt Options) (dosRoot, saveDir string, err error) {
+	if opt.Difficulty != DifficultyOriginal && opt.Difficulty != DifficultyHard {
+		return "", "", fmt.Errorf("未知難度 %q", opt.Difficulty)
+	}
+	saveDir = SavePath(opt.SaveDir, opt.Difficulty)
+	if opt.Difficulty == DifficultyOriginal {
+		if saveDir != "" {
+			if _, e := os.Lstat(filepath.Join(saveDir, "difficulty.json")); e == nil {
+				return "", "", fmt.Errorf("原版不能使用高難度進度目錄")
+			} else if !os.IsNotExist(e) {
+				return "", "", e
+			}
+		}
+		return root, saveDir, nil
+	}
+	if saveDir == "" {
+		return "", "", fmt.Errorf("高難度必須指定獨立可寫的 SaveDir 基底")
+	}
+	origReal, e := realTarget(root)
+	if e != nil {
+		return "", "", e
+	}
+	profileReal, e := realTarget(saveDir)
+	if e != nil {
+		return "", "", e
+	}
+	if insidePath(origReal, profileReal) || insidePath(profileReal, origReal) {
+		return "", "", fmt.Errorf("高難度資料目錄不能與原版來源重疊")
+	}
+	if e = CheckRequiredFiles(root, true); e != nil {
+		return "", "", e
+	}
+	if e = os.MkdirAll(saveDir, 0o755); e != nil {
+		return "", "", e
+	}
+	entries, e := os.ReadDir(saveDir)
+	if e != nil {
+		return "", "", e
+	}
+	marker := filepath.Join(saveDir, "difficulty.json")
+	m, e := regularBytes(marker)
+	if os.IsNotExist(e) {
+		if len(entries) != 0 {
+			return "", "", fmt.Errorf("高難度目錄已有未標記內容，保留資料並拒絕採用：%s", saveDir)
+		}
+		var index strings.Builder
+		for i := 0; i < 5; i++ {
+			fmt.Fprintf(&index, "%d ----/--/-- --/--/-- EMPTY\r\n", i)
+		}
+		if e = profileWrite(filepath.Join(saveDir, "fname.dat"), []byte(index.String())); e != nil {
+			return "", "", e
+		}
+		if e = profileWrite(marker, []byte(hardProfileMarker)); e != nil {
+			return "", "", e
+		}
+	} else if e != nil {
+		return "", "", e
+	} else if string(m) != hardProfileMarker {
+		return "", "", fmt.Errorf("高難度進度標記版本或來源不符")
+	}
+	entries, e = os.ReadDir(saveDir)
+	if e != nil {
+		return "", "", e
+	}
+	indexPath := ""
+	for _, v := range entries {
+		name := v.Name()
+		upper := strings.ToUpper(name)
+		allowed := name == "difficulty.json" || upper == "FNAME.DAT" || name == "data-v1"
+		if upper == "FNAME.DAT" {
+			if indexPath != "" {
+				return "", "", fmt.Errorf("高難度目錄有大小寫重複 FNAME")
+			}
+			indexPath = filepath.Join(saveDir, name)
+		}
+		for i := 0; i < 5; i++ {
+			allowed = allowed || upper == fmt.Sprintf("GAMEFILE.%03d", i)
+		}
+		if !allowed || v.Type()&os.ModeSymlink != 0 || v.IsDir() != (name == "data-v1") {
+			return "", "", fmt.Errorf("高難度目錄有未知或非一般項目：%s", name)
+		}
+		if strings.HasPrefix(upper, "GAMEFILE.") {
+			info, e := v.Info()
+			if e != nil {
+				return "", "", e
+			}
+			if info.Size() != 31839 {
+				return "", "", fmt.Errorf("高難度存檔 %s 長度 %d，應為 31839，保留檔案並拒絕載入", name, info.Size())
+			}
+		}
+	}
+	if indexPath == "" {
+		return "", "", fmt.Errorf("高難度進度索引遺失")
+	}
+	index, e := regularBytes(indexPath)
+	if e != nil {
+		return "", "", e
+	}
+	if e = checkProfileIndex(index); e != nil {
+		return "", "", e
+	}
+	dosRoot = filepath.Join(saveDir, "data-v1")
+	if e = os.MkdirAll(dosRoot, 0o755); e != nil {
+		return "", "", e
+	}
+	originals, e := os.ReadDir(root)
+	if e != nil {
+		return "", "", e
+	}
+	byName := map[string]string{}
+	for _, v := range originals {
+		byName[strings.ToUpper(v.Name())] = v.Name()
+	}
+	required := map[string]RequiredFile{}
+	for _, rf := range RequiredFiles() {
+		required[rf.Name] = rf
+	}
+	cached, e := os.ReadDir(dosRoot)
+	if e != nil {
+		return "", "", e
+	}
+	for _, v := range cached {
+		if _, ok := required[v.Name()]; !ok || !v.Type().IsRegular() {
+			return "", "", fmt.Errorf("高難度資料投影有未知項目：%s", v.Name())
+		}
+	}
+	for _, rf := range RequiredFiles() {
+		dst := filepath.Join(dosRoot, rf.Name)
+		b, e := regularBytes(dst)
+		if os.IsNotExist(e) {
+			b, e = os.ReadFile(filepath.Join(root, byName[rf.Name]))
+			if e != nil {
+				return "", "", e
+			}
+			h := sha256.Sum256(b)
+			if hex.EncodeToString(h[:]) != rf.SHA256 {
+				return "", "", fmt.Errorf("高難度輸入在複製前發生變動：%s", rf.Name)
+			}
+			if e = profileWrite(dst, b); e != nil {
+				return "", "", e
+			}
+		} else if e != nil {
+			return "", "", e
+		}
+		h := sha256.Sum256(b)
+		if int64(len(b)) != rf.Size || hex.EncodeToString(h[:]) != rf.SHA256 {
+			return "", "", fmt.Errorf("高難度資料投影雜湊不符：%s", rf.Name)
+		}
+	}
+	return dosRoot, saveDir, nil
+}
+
+func (s *Session) initDifficulty() error {
+	if s.opt.Difficulty != DifficultyHard {
+		return nil
+	}
+	a := uint32(0x37a34)
+	if !bytes.Equal(s.m.Mem[a:a+4], []byte{0x80, 0x96, 0x98, 0x00}) {
+		return fmt.Errorf("高難度初始債務特徵不符")
+	}
+	s.m.Write16(a, 0xf080)
+	s.m.Write16(a+2, 0x02fa)
+	s.hard = &hardRules{}
+	// 語言包既有驗證沒有資料檔語意允許清單；高難度額外拒絕進度檔與未知檔。
+	if s.d.LangDir != "" {
+		ents, e := os.ReadDir(s.d.LangDir)
+		if e != nil {
+			return e
+		}
+		for _, v := range ents {
+			allowed := false
+			for _, name := range langDataFiles {
+				allowed = allowed || strings.ToUpper(v.Name()) == name
+			}
+			if !allowed {
+				return fmt.Errorf("高難度語言層含不允許的檔案：%s", v.Name())
+			}
+		}
+	}
+	return nil
+}
diff --git a/apps/hr/runtime/difficulty_test.go b/apps/hr/runtime/difficulty_test.go
new file mode 100644
index 0000000..a21ef4a
--- /dev/null
+++ b/apps/hr/runtime/difficulty_test.go
@@ -0,0 +1,368 @@
+package runtime
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+func hardSession(t *testing.T) *Session {
+	t.Helper()
+	s, err := Open(origRoot(t), Options{Difficulty: DifficultyHard, SaveDir: filepath.Join(t.TempDir(), "saves"), NoDiag: true, NoPacing: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+func installOverlayForTest(s *Session, load, cs uint16) {
+	for _, o := range ovrStubs {
+		if o.LoadSeg == load {
+			s.m.Write16(cpu.Linear(cs-1, 0x0e), o.StubSeg)
+			s.m.Write16(cpu.Linear(o.StubSeg, 0x10), cs)
+			return
+		}
+	}
+	panic("unknown overlay")
+}
+
+func TestDifficultyDebtAndProfileIsolation(t *testing.T) {
+	root := origRoot(t)
+	base := filepath.Join(t.TempDir(), "saves")
+	a, err := Open(root, Options{SaveDir: base, NoDiag: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := Open(root, Options{SaveDir: base, Difficulty: DifficultyHard, NoDiag: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, x := range []struct {
+		s    *Session
+		want uint32
+	}{{a, 10000000}, {b, 50000000}} {
+		got := uint32(x.s.m.Peek16(0x37a34)) | uint32(x.s.m.Peek16(0x37a36))<<16
+		if got != x.want {
+			t.Fatal(got, x.want)
+		}
+	}
+	if a.d.Scratch == b.d.Scratch || b.d.Root == root {
+		t.Fatal("進度未隔離")
+	}
+	initial := append([]byte(nil), b.m.Mem...)
+	copy(initial[0x37a34:0x37a38], a.m.Mem[0x37a34:0x37a38])
+	if !bytes.Equal(initial, a.m.Mem) {
+		t.Fatal("新遊戲債務以外的記憶體有差異")
+	}
+	for i := 0; i < 5; i++ {
+		if _, err := os.Stat(filepath.Join(b.d.Root, fmt.Sprintf("GAMEFILE.%03d", i))); !os.IsNotExist(err) {
+			t.Fatal("投影包含舊存檔", err)
+		}
+	}
+	if _, err := Open(root, Options{SaveDir: b.d.Scratch}); err == nil {
+		t.Fatal("原版採用了高難度目錄")
+	}
+	if err := os.Remove(filepath.Join(b.d.Scratch, "fname.dat")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Open(root, Options{SaveDir: base, Difficulty: DifficultyHard}); err == nil {
+		t.Fatal("遺失索引卻開啟")
+	}
+}
+
+func TestHardProfileRejectsUnmarkedAndAliases(t *testing.T) {
+	root := origRoot(t)
+	base := filepath.Join(t.TempDir(), "saves")
+	if err := os.MkdirAll(SavePath(base, DifficultyHard), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(SavePath(base, DifficultyHard), "GAMEFILE.000"), []byte("keep"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Open(root, Options{SaveDir: base, Difficulty: DifficultyHard}); err == nil {
+		t.Fatal("接受未標記舊進度")
+	}
+	alias := filepath.Join(t.TempDir(), "original")
+	if err := os.Symlink(root, alias+"-hard"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := Open(root, Options{SaveDir: alias, Difficulty: DifficultyHard}); err == nil {
+		t.Fatal("接受原版符號連結")
+	}
+}
+
+func TestHardStoryRewardsAndNonStoryMoney(t *testing.T) {
+	s := hardSession(t)
+	c := s.m.CPU
+	c.R[cpu.SP] = 0x7000
+	a := cpu.Linear(s.stackSeg, 0x7000)
+	for _, g := range storyGrants {
+		for _, notice := range []bool{false, true} {
+			installOverlayForTest(s, g.overlay, 0x7000)
+			c.Seg[cpu.CS] = 0x1a9a
+			c.IP = 5
+			ret := g.credit
+			off := uint32(4)
+			if notice {
+				c.IP = 0x2ac
+				ret = g.notice
+				off = 6
+			}
+			s.m.Write16(a, ret)
+			s.m.Write16(a+2, 0x7000)
+			s.m.Write16(a+off, uint16(g.amount))
+			s.m.Write16(a+off+2, uint16(g.amount>>16))
+			before := append([]byte(nil), s.m.Mem...)
+			if err := s.hardPre(); err != nil {
+				t.Fatal(err)
+			}
+			got := uint32(s.m.Peek16(a+off)) | uint32(s.m.Peek16(a+off+2))<<16
+			if got != g.amount/2 {
+				t.Fatal(g, notice, got)
+			}
+			copy(before[a+off:a+off+4], s.m.Mem[a+off:a+off+4])
+			if !bytes.Equal(before, s.m.Mem) {
+				t.Fatal("獎金引數外有差異")
+			}
+		}
+	}
+	for _, ret := range []uint16{0x0d1f, 0x2248} {
+		installOverlayForTest(s, 0x6ee9, 0x7000)
+		c.Seg[cpu.CS] = 0x1a9a
+		c.IP = 5
+		s.m.Write16(a, ret)
+		s.m.Write16(a+2, 0x7000)
+		s.m.Write16(a+4, 1000)
+		s.m.Write16(a+6, 0)
+		before := append([]byte(nil), s.m.Mem...)
+		if err := s.hardPre(); err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(before, s.m.Mem) {
+			t.Fatal("退款或賭金被修改")
+		}
+	}
+}
+
+func TestHardShopThreeBytesOnly(t *testing.T) {
+	s := hardSession(t)
+	raw, err := os.ReadFile(filepath.Join(origRoot(t), "SHOPTAB.TBL"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := s.m.CPU
+	c.Seg[cpu.CS] = 0x1c19
+	c.IP = 0x63
+	c.R[cpu.BP] = 0x7000
+	a := cpu.Linear(s.stackSeg, 0x7000)
+	changes := 0
+	for town := 0; town < 99; town++ {
+		buf := s.m.Mem[0x3a90c : 0x3a90c+200]
+		copy(buf, raw[town*200:(town+1)*200])
+		s.m.Write16(a+6, uint16(town))
+		before := append([]byte(nil), s.m.Mem...)
+		if err := s.hardPre(); err != nil {
+			t.Fatal(err)
+		}
+		for i, b := range s.m.Mem {
+			if b != before[i] {
+				changes++
+				if b != 0xff || uint32(i) < 0x3a90c || uint32(i) >= 0x3a90c+200 {
+					t.Fatal("商店buffer外有差異")
+				}
+			}
+		}
+	}
+	if changes != 3 {
+		t.Fatal("商店差異", changes)
+	}
+}
