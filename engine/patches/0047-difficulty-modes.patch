+func TestHardStoryBattleFieldsAndOnce(t *testing.T) {
+	s := hardSession(t)
+	c := s.m.CPU
+	for _, source := range []struct {
+		load, ret uint16
+		scaled    bool
+	}{{0x6ee9, 0x034d, true}, {0x6ee9, 0x0a59, true}, {0x6ee9, 0x10ba, true}, {0x6ee9, 0x26c1, true}, {0x6ee9, 0x27ef, true}, {0x6ee9, 0x3bb8, true}, {0x6ee9, 0x3e35, true}, {0x6ee9, 0x4dc1, true}, {0x749c, 0x20c6, true}, {0x669d, 0x0029, false}} {
+		installOverlayForTest(s, 0x7718, 0x7000)
+		installOverlayForTest(s, source.load, 0x7200)
+		c.Seg[cpu.CS] = 0x7000
+		c.IP = 0
+		if err := s.hardPre(); err != nil {
+			t.Fatal(err)
+		}
+		c.IP = 0x15c
+		c.Seg[cpu.DS] = 0x4d04
+		c.R[cpu.BP] = 0x7000
+		copy(s.m.Mem[cpu.Linear(0x7000, 0x159):], []byte{0xe8, 0xf9, 0x13, 0x1e, 0x68, 0x95, 0x0b})
+		a := cpu.Linear(s.stackSeg, 0x7000)
+		b := cpu.Linear(s.stackSeg, 0x7100)
+		s.m.Write16(a, 0x7100)
+		s.m.Write16(a+2, 0x602)
+		s.m.Write16(a+4, 0x1514)
+		s.m.Write16(a+6, 0)
+		s.m.Write16(a+12, 7)
+		s.m.Write16(b+2, source.ret)
+		s.m.Write16(b+4, 0x7200)
+		base := cpu.Linear(0x4d04, 0)
+		s.m.Write16(base+8, 11)
+		s.m.Write16(base+0xe99, 0x100)
+		for i := 0; i < 11; i++ {
+			for _, f := range []uint32{9, 11, 15, 17} {
+				s.m.Write16(base+0x591+uint32(i)*35+f, uint16(11+i))
+			}
+		}
+		before := append([]byte(nil), s.m.Mem...)
+		if err := s.hardPre(); err != nil {
+			t.Fatal(err)
+		}
+		for i := 0; i < 11; i++ {
+			for _, f := range []uint32{9, 11, 15, 17} {
+				at := base + 0x591 + uint32(i)*35 + f
+				want := uint16(11 + i)
+				if source.scaled {
+					want = want * 3 / 2
+				}
+				if s.m.Peek16(at) != want {
+					t.Fatal(source, i, f)
+				}
+				copy(before[at:at+2], s.m.Mem[at:at+2])
+			}
+		}
+		if !bytes.Equal(before, s.m.Mem) {
+			t.Fatal("敵方四欄位外有差異")
+		}
+		after := append([]byte(nil), s.m.Mem...)
+		if err := s.hardPre(); err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(after, s.m.Mem) {
+			t.Fatal("同戰鬥重複放大")
+		}
+		if source.scaled {
+			s.hard.battleScaled = false
+			s.m.Write16(base+0x591+9, 30000)
+			before = append([]byte(nil), s.m.Mem...)
+			if err := s.hardPre(); err == nil {
+				t.Fatal("能力溢位未拒絕")
+			}
+			if !bytes.Equal(before, s.m.Mem) {
+				t.Fatal("溢位時部分寫入")
+			}
+		}
+	}
+}
