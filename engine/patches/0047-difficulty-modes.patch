+func TestHardIndexByteBounds(t *testing.T) {
+	var good strings.Builder
+	for i := 0; i < 5; i++ {
+		fmt.Fprintf(&good, "%d ----/--/-- --/--/-- EMPTY\r\n", i)
+	}
+	if err := checkProfileIndex([]byte(good.String())); err != nil {
+		t.Fatal(err)
+	}
+	for _, bad := range []string{"", strings.Replace(good.String(), " --/--/-- ", " ----/--/-- ", 1), strings.Replace(good.String(), "EMPTY", strings.Repeat("X", 22), 1), strings.Replace(good.String(), "0 ", "1 ", 1), good.String() + "\x00"} {
+		if err := checkProfileIndex([]byte(bad)); err == nil {
+			t.Fatal("錯誤索引未拒絕")
+		}
+	}
+}
