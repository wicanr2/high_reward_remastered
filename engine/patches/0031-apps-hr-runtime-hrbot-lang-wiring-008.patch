diff --git a/apps/hr/cmd/hrbot/lang.go b/apps/hr/cmd/hrbot/lang.go
index 5f49457..d3bddc9 100644
--- a/apps/hr/cmd/hrbot/lang.go
+++ b/apps/hr/cmd/hrbot/lang.go
@@ -1,16 +1,87 @@
 package main
 
-import "fmt"
+import (
+	"errors"
+	"fmt"
 
-// checkLangBound 是 `-lang-dir` 的暫時防護（hr `docs/spec/008` §3.1，L0）：要求語言層真的綁上了。
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+	"github.com/wicanr2/dosgolem/internal/dos"
+)
+
+// 語言層（hr `docs/spec/008` 第 3.1、3.2 節，L1 接線）。
+
+// langFailError 是 `-lang-dir` 的語言層沒有如預期啟用：`Session.LangStatus()` 的原因鍵非空，或沒有語言層也沒有原因鍵。
+// `main` 以退出碼 1 結束（與當機同碼；設定錯誤與其他失敗是 2）。
+type langFailError struct{ msg string }
+
+func (e *langFailError) Error() string { return e.msg }
+
+// exitCode 是 `run` 的錯誤對應的退出碼：語言層沒有啟用是 1，其他是 2。
+func exitCode(err error) int {
+	var lf *langFailError
+	if errors.As(err, &lf) {
+		return 1
+	}
+	return 2
+}
+
+// langGate 檢查 `Session.Open` 之後的語言層狀態（規格第 3.2 節：經 `Session.Open` 且傳了 `LangDir` 的無頭工具，
+// `LangStatus()` 回報非空原因鍵時非零結束，負對照路徑明示例外）。want 是 `-lang-dir` 的值，st 是 `Session.LangStatus()`，
+// allowFail 是 `-allow-lang-fail`。
 //
-// `hrrt.Open` 對不存在的目錄清空生效值、記一行、不回錯（前端不能因語言包消失而擋遊戲），
-// 而 hrbot 沒有給 `Options.Log`，那一行被丟掉：路徑打錯時機器人以原版跑完、退出碼 0，
-// 收據會看起來像語言包的結果。所以 `-lang-dir` 非空而 `Session` 的生效 `LangDir` 為空就回錯，拒絕執行。
-// L1 的 `Session.LangStatus()` 上線、非空原因鍵時非零結束（規格第 3.2 節）之後，換掉這個防護。
-func checkLangBound(want, effective string) error {
-	if want != "" && effective == "" {
-		return fmt.Errorf("-lang-dir %q 沒有綁上語言層（目錄不存在或不是目錄？Session 退成了原版），拒絕執行", want)
-	}
-	return nil
+// 回傳的 note 非空時，呼叫端要印出並記錄（驗證失敗但 `-allow-lang-fail` 明示放行）；err 非空時拒絕執行。
+//   - 沒給 `-lang-dir`：什麼都不檢查。
+//   - 原因鍵非空：預設拒絕；`-allow-lang-fail` 放行，只供負對照（證明驗證失敗時回退原版、畫面等於基準）。
+//   - `-lang-dir` 非空而生效的 `LangDir` 為空，原因鍵也為空：`Open` 的契約不允許（空的生效值一定伴隨原因鍵），
+//     出現就是程式錯誤，一律拒絕，`-allow-lang-fail` 也不放行。
+func langGate(want string, st hrrt.LangStatus, allowFail bool) (note string, err error) {
+	if want == "" {
+		return "", nil
+	}
+	if st.Reason == "" && st.LangDir == "" {
+		return "", &langFailError{fmt.Sprintf("-lang-dir %q：Session 的生效 LangDir 為空而原因鍵也為空（Open 的契約不允許），拒絕執行", want)}
+	}
+	if st.Reason == "" {
+		return "", nil
+	}
+	msg := fmt.Sprintf("-lang-dir %q：語言包沒有啟用，原因鍵 %s，生效 LangDir %q（遊戲內文字是原版）", want, st.Reason, st.LangDir)
+	if allowFail {
+		return msg + "；-allow-lang-fail 已明示，繼續（只供負對照）", nil
+	}
+	return "", &langFailError{msg + "，拒絕執行（負對照請明示 -allow-lang-fail）"}
+}
+
+// langSnapshot 是某個 Session 的語言層結束報告資料：`LangStatus()` 與 `DOS.OpenedLayers` 的複本
+// （機器人結束遊戲就重開 Session，結束報告要用最後一個 Session 的值，所以在 `endSession` 時留一份）。
+type langSnapshot struct {
+	Status hrrt.LangStatus
+	Layers map[string]dos.OpenedLayer
+}
+
+func snapshotLang(s *hrrt.Session) langSnapshot {
+	src := s.DOS().OpenedLayers
+	layers := make(map[string]dos.OpenedLayer, len(src))
+	for k, v := range src {
+		layers[k] = v
+	}
+	return langSnapshot{Status: s.LangStatus(), Layers: layers}
+}
+
+// text 是結束報告的語言層區段：生效的 `LangDir`、原因鍵與各資料檔與 `CFONT.15` 的命中層
+// （命中層的行格式與診斷 `info.txt` 的「語言層」區段共用 `hrrt.LangLayerText`）。
+func (l langSnapshot) text() string {
+	reason := l.Status.Reason
+	if reason == "" {
+		reason = "（無）"
+	}
+	return fmt.Sprintf("語言層：LangDir＝%q  原因鍵＝%s\n開檔命中層：\n%s", l.Status.LangDir, reason, hrrt.LangLayerText(l.Layers))
+}
+
+// summary 是 summary.json 的 "lang" 欄：生效的 LangDir、原因鍵與全部開過的檔名的首次與最近命中層。
+func (l langSnapshot) summary() map[string]any {
+	layers := make(map[string]any, len(l.Layers))
+	for k, v := range l.Layers {
+		layers[k] = map[string]string{"first": v.First, "last": v.Last}
+	}
+	return map[string]any{"lang_dir": l.Status.LangDir, "reason": l.Status.Reason, "layers": layers}
 }
diff --git a/apps/hr/cmd/hrbot/lang_test.go b/apps/hr/cmd/hrbot/lang_test.go
index 87548ad..351f75e 100644
--- a/apps/hr/cmd/hrbot/lang_test.go
+++ b/apps/hr/cmd/hrbot/lang_test.go
@@ -1,20 +1,216 @@
 package main
 
 import (
+	"errors"
+	"os"
+	"path/filepath"
 	"strings"
 	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+	"github.com/wicanr2/dosgolem/internal/dos"
 )
 
-// -lang-dir 非空而 Session 沒有綁上語言層（目錄不存在被清空）：拒絕執行，不退成原版收據。
-func TestCheckLangBound(t *testing.T) {
-	if err := checkLangBound("", ""); err != nil {
-		t.Errorf("沒有給 -lang-dir：%v", err)
+// 語言層接線（docs/spec/008 第 3.2 節，L1）。langGate 與報告文字是純函式（不需原版）；
+// openSession 與 run 的測試需要原版，缺檔 skip（原版只在測試執行時讀，不進儲存庫）。
+
+func origRoot(t *testing.T) string {
+	t.Helper()
+	root := os.Getenv("HR_ORIG")
+	if root == "" {
+		root = "/orig/orig"
+	}
+	if _, err := os.Stat(filepath.Join(root, "MAIN.EXE")); err != nil {
+		t.Skipf("沒有原版目錄（%s）：%v", root, err)
+	}
+	return root
+}
+
+// buildIdentityPack 用真的建置器造 identity 語言包，回傳 files/（也就是 -lang-dir 的值）。
+func buildIdentityPack(t *testing.T, root string) string {
+	t.Helper()
+	res, err := l10n.Build(l10n.Config{OrigDir: root, PackRoot: t.TempDir(), Code: "zh-TW", Mode: l10n.ModeIdentity})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return res.FilesDir()
+}
+
+func tamper(t *testing.T, files string) {
+	t.Helper()
+	p := filepath.Join(files, "SP.MES")
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
 	}
-	if err := checkLangBound("/p/zh/files", "/p/zh/files"); err != nil {
-		t.Errorf("語言層已綁定：%v", err)
+	b[0] ^= 0xFF
+	if err := os.WriteFile(p, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func newTestBot(t *testing.T, o options) *bot {
+	t.Helper()
+	o.interval = hrrt.DefaultInterval
+	o.hangSeconds = 30
+	out := t.TempDir()
+	lf, err := os.Create(filepath.Join(out, "actions.jsonl"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { lf.Close() })
+	return &bot{opt: o, out: out, log: lf, opens: map[string]int{}}
+}
+
+// langGate：沒給 -lang-dir 不檢查；原因鍵非空預設拒絕、-allow-lang-fail 放行；空的生效值而沒有原因鍵永遠拒絕。
+func TestLangGate(t *testing.T) {
+	const dir = "/p/zh/files"
+	cases := []struct {
+		name     string
+		want     string
+		st       hrrt.LangStatus
+		allow    bool
+		wantErr  bool
+		wantNote string // 子字串；空字串 ＝ 不該有 note
+	}{
+		{"沒給 -lang-dir", "", hrrt.LangStatus{}, false, false, ""},
+		{"沒給 -lang-dir 也不理會 allow", "", hrrt.LangStatus{}, true, false, ""},
+		{"語言層已啟用", dir, hrrt.LangStatus{LangDir: dir}, false, false, ""},
+		{"驗證失敗：預設拒絕", dir, hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}, false, true, ""},
+		{"驗證失敗：-allow-lang-fail 放行並留 note", dir, hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}, true, false, hrrt.LangReasonVerifyFailed},
+		{"原因鍵非空即失敗，即使生效值非空（矛盾的狀態不放行）", dir, hrrt.LangStatus{LangDir: dir, Reason: hrrt.LangReasonVerifyFailed}, false, true, ""},
+		{"生效值與原因鍵都空：不可能發生，拒絕", dir, hrrt.LangStatus{}, false, true, ""},
+		{"生效值與原因鍵都空：-allow-lang-fail 也不放行", dir, hrrt.LangStatus{}, true, true, ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			note, err := langGate(c.want, c.st, c.allow)
+			if (err != nil) != c.wantErr {
+				t.Fatalf("err ＝ %v，預期 wantErr ＝ %v", err, c.wantErr)
+			}
+			if err != nil {
+				var lf *langFailError
+				if !errors.As(err, &lf) || exitCode(err) != 1 {
+					t.Errorf("應是 *langFailError，退出碼 1：%T，%d", err, exitCode(err))
+				}
+				if c.st.Reason != "" && !strings.Contains(err.Error(), c.st.Reason) {
+					t.Errorf("訊息應點名原因鍵 %q：%v", c.st.Reason, err)
+				}
+				if !strings.Contains(err.Error(), c.want) {
+					t.Errorf("訊息應點名 -lang-dir：%v", err)
+				}
+			}
+			if (c.wantNote == "") != (note == "") || (c.wantNote != "" && !strings.Contains(note, c.wantNote)) {
+				t.Errorf("note ＝ %q，預期含 %q", note, c.wantNote)
+			}
+		})
+	}
+}
+
+func TestExitCode(t *testing.T) {
+	if got := exitCode(&langFailError{"x"}); got != 1 {
+		t.Errorf("langFailError 的退出碼 ＝ %d，預期 1", got)
+	}
+	if got := exitCode(errors.New("其他錯誤")); got != 2 {
+		t.Errorf("其他錯誤的退出碼 ＝ %d，預期 2", got)
+	}
+	wrapped := errors.Join(errors.New("外層"), &langFailError{"x"})
+	if got := exitCode(wrapped); got != 1 {
+		t.Errorf("包在別的錯誤裡的 langFailError 的退出碼 ＝ %d，預期 1", got)
+	}
+}
+
+// 結束報告的語言層區段：生效 LangDir、原因鍵、各資料檔與 CFONT.15 的命中層（格式與 info.txt 共用 hrrt.LangLayerText）。
+func TestLangSnapshotText(t *testing.T) {
+	ok := langSnapshot{
+		Status: hrrt.LangStatus{LangDir: "/p/zh/files"},
+		Layers: map[string]dos.OpenedLayer{"CFONT.15": {First: "lang", Last: "lang"}, "ESPMES.MRG": {First: "lang", Last: "lang"}, "MAIN.EXE": {First: "root", Last: "root"}},
+	}
+	got := ok.text()
+	for _, want := range []string{
+		"語言層：LangDir＝\"/p/zh/files\"  原因鍵＝（無）\n", "開檔命中層：\n",
+		"  CFONT.15  首次 lang  最近 lang\n", "  ESPMES.MRG  首次 lang  最近 lang\n", "  SP.MES  未開啟\n",
+	} {
+		if !strings.Contains(got, want) {
+			t.Errorf("報告缺 %q：\n%s", want, got)
+		}
+	}
+	if !strings.HasSuffix(got, hrrt.LangLayerText(ok.Layers)) {
+		t.Errorf("命中層應與 hrrt.LangLayerText 相同：\n%s", got)
+	}
+	failed := langSnapshot{Status: hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}, Layers: map[string]dos.OpenedLayer{"CFONT.15": {First: "root", Last: "root"}}}
+	got = failed.text()
+	for _, want := range []string{"語言層：LangDir＝\"\"  原因鍵＝verify-failed\n", "  CFONT.15  首次 root  最近 root\n"} {
+		if !strings.Contains(got, want) {
+			t.Errorf("驗證失敗的報告缺 %q：\n%s", want, got)
+		}
+	}
+	sum := failed.summary()
+	if sum["reason"] != hrrt.LangReasonVerifyFailed || sum["lang_dir"] != "" {
+		t.Errorf("summary ＝ %v", sum)
+	}
+}
+
+// openSession（需原版）：通過驗證的包正常開啟；驗證失敗預設拒絕（*langFailError，退出碼 1），
+// -allow-lang-fail 時能開啟且原因鍵是 verify-failed；沒給 -lang-dir 不受影響；-lang-dir 指向不存在的目錄同樣被擋。
+func TestOpenSessionLangGate(t *testing.T) {
+	root := origRoot(t)
+	good := buildIdentityPack(t, root)
+	bad := buildIdentityPack(t, root)
+	tamper(t, bad)
+	missing := filepath.Join(t.TempDir(), "nope", "files")
+
+	t.Run("通過驗證（明示 SkipLangDigest，不需要摘要）", func(t *testing.T) {
+		s, err := newTestBot(t, options{orig: root, langDir: good}).openSession(nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if st := s.LangStatus(); st != (hrrt.LangStatus{LangDir: filepath.Clean(good)}) {
+			t.Errorf("LangStatus ＝ %+v", st)
+		}
+	})
+	t.Run("沒給 -lang-dir", func(t *testing.T) {
+		s, err := newTestBot(t, options{orig: root}).openSession(nil)
+		if err != nil || s.LangStatus() != (hrrt.LangStatus{}) {
+			t.Fatalf("err ＝ %v 狀態 %+v", err, s.LangStatus())
+		}
+	})
+	for name, dir := range map[string]string{"竄改過的包": bad, "不存在的目錄": missing} {
+		t.Run(name+"：預設拒絕", func(t *testing.T) {
+			s, err := newTestBot(t, options{orig: root, langDir: dir}).openSession(nil)
+			var lf *langFailError
+			if err == nil || !errors.As(err, &lf) || exitCode(err) != 1 || s != nil {
+				t.Fatalf("應回 *langFailError：err ＝ %v s ＝ %v", err, s)
+			}
+			if !strings.Contains(err.Error(), hrrt.LangReasonVerifyFailed) {
+				t.Errorf("訊息應點名原因鍵：%v", err)
+			}
+		})
+		t.Run(name+"：-allow-lang-fail 放行，原因鍵記在 LangStatus", func(t *testing.T) {
+			s, err := newTestBot(t, options{orig: root, langDir: dir, allowLangFail: true}).openSession(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if st := s.LangStatus(); st != (hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}) {
+				t.Errorf("LangStatus ＝ %+v", st)
+			}
+		})
+	}
+}
+
+// run 的失敗路徑（需原版）：語言包被竄改時 run 在遊戲開跑之前回 *langFailError，main 以退出碼 1 結束。
+func TestRunLangFailExitsNonZero(t *testing.T) {
+	root := origRoot(t)
+	bad := buildIdentityPack(t, root)
+	tamper(t, bad)
+	// maxActions：突變使 run 不再拒絕時，遊戲只多玩一個動作就結束，測試以失敗收場而不是玩滿一個遊戲小時。
+	err := run(options{orig: root, out: t.TempDir(), langDir: bad, hours: 1, maxActions: 1, seed: 1, interval: hrrt.DefaultInterval, hangSeconds: 30})
+	var lf *langFailError
+	if err == nil || !errors.As(err, &lf) {
+		t.Fatalf("run 應回 *langFailError：%v", err)
 	}
-	err := checkLangBound("/p/typo/files", "")
-	if err == nil || !strings.Contains(err.Error(), "/p/typo/files") {
-		t.Fatalf("-lang-dir 沒綁上應回錯並點名路徑：%v", err)
+	if exitCode(err) != 1 {
+		t.Errorf("退出碼 ＝ %d，預期 1", exitCode(err))
 	}
 }
