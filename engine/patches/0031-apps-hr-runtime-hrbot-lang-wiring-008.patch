+package runtime_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// 外部測試套件：可以同時 import apps/hr/l10n 與 runtime（內部測試套件不行，l10n import runtime）。
+// 用真的建置器造 identity 語言包，確認建置端寫出的 manifest 與輸入摘要，正是 Session.Open 的驗證接受的那一種
+// （手造 manifest 的內部測試涵蓋不到建置端與驗證端的欄位漂移）。需原版，缺檔 skip。
+
+func extOrigRoot(t *testing.T) string {
+	t.Helper()
+	root := os.Getenv("HR_ORIG")
+	if root == "" {
+		root = "/orig/orig"
+	}
+	if _, err := os.Stat(filepath.Join(root, "MAIN.EXE")); err != nil {
+		t.Skipf("沒有原版目錄（%s）：%v", root, err)
+	}
+	return root
+}
+
+func TestOpenWithBuiltIdentityPack(t *testing.T) {
+	root := extOrigRoot(t)
+	cfg := l10n.Config{OrigDir: root, PackRoot: t.TempDir(), Code: "zh-TW", Mode: l10n.ModeIdentity}
+	res, err := l10n.Build(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest, err := l10n.ExpectedDigest(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if digest != res.Digest {
+		t.Fatalf("ExpectedDigest ＝ %s，Build 的 Digest ＝ %s", digest, res.Digest)
+	}
+	files := res.FilesDir()
+
+	s, err := hrrt.Open(root, hrrt.Options{LangDir: files, LangDigest: digest})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st := s.LangStatus(); st != (hrrt.LangStatus{LangDir: filepath.Clean(files)}) {
+		t.Fatalf("真建置器造的包應通過 Open 的驗證：%+v", st)
+	}
+	if got := s.DOS().LangManifest; got != res.ManifestSHA256 {
+		t.Errorf("DOS.LangManifest ＝ %s，Build 回報的 manifest 雜湊 ＝ %s", got, res.ManifestSHA256)
+	}
+
+	// 預期摘要不符（譯文表或政策改了而目錄沒換）：回退原版。
+	s2, err := hrrt.Open(root, hrrt.Options{LangDir: files, LangDigest: digest + "0"})
+	if err != nil || s2.LangStatus() != (hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}) {
+		t.Errorf("摘要不符應回退：err ＝ %v 狀態 %+v", err, s2.LangStatus())
+	}
+	// 明示略過摘要：摘要不符的包仍可啟用。
+	s3, err := hrrt.Open(root, hrrt.Options{LangDir: files, LangDigest: "ignored", SkipLangDigest: true})
+	if err != nil || s3.LangStatus().LangDir != filepath.Clean(files) {
+		t.Errorf("明示略過摘要後應啟用：err ＝ %v 狀態 %+v", err, s3.LangStatus())
+	}
+	// 竄改包內檔案：即使略過摘要也必須被拒。
+	p := filepath.Join(files, "SP.MES")
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b[0] ^= 0xFF
+	if err := os.WriteFile(p, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	s4, err := hrrt.Open(root, hrrt.Options{LangDir: files, SkipLangDigest: true})
+	if err != nil || s4.LangStatus() != (hrrt.LangStatus{Reason: hrrt.LangReasonVerifyFailed}) {
+		t.Errorf("竄改過的包應被拒：err ＝ %v 狀態 %+v", err, s4.LangStatus())
+	}
+}
