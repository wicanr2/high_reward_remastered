+// LangManifest 與正規化後的 LangDir 在 probe、hrsoak、Session 三處對同一個目錄算出相同值（規格第 3.2 節）。
+// probe 與 hrsoak 是通用工具，不能 import 本套件的驗證碼，各自把 `<dir>/../manifest.json` 的原始位元組取 SHA-256、
+// 路徑取 filepath.Abs 加 filepath.Clean；它們的測試對內容 "hello" 的 manifest 斷言 helloSHA（cmd/probe/langdir_test.go、
+// apps/hr/cmd/hrsoak/langdir_test.go，兩邊不驗證 manifest 內容）。本測試對 Session 側用的兩個函式
+// （verify.ManifestSHA256、normDir 與 verify.NormalizeDir）對同一個固定值與同一種路徑拼法斷言，所以三處斷言的是同一個值。
+// 端到端的對拍（同一個真包，三個工具各印一次）在收據 l1-wire1-report.md。
+func TestLangIdentityRules(t *testing.T) {
+	pack := t.TempDir()
+	files := filepath.Join(pack, "files")
+	if err := os.MkdirAll(files, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(pack, "manifest.json"), []byte("hello"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if sha256Of([]byte("hello")) != helloSHA {
+		t.Fatal("測試常數 helloSHA 與 sha256(\"hello\") 不符")
+	}
+	if got, err := verify.ManifestSHA256(pack); err != nil || got != helloSHA {
+		t.Errorf("verify.ManifestSHA256 ＝ %q，%v，預期 %s", got, err, helloSHA)
+	}
+	messy := files + string(filepath.Separator) + ".." + string(filepath.Separator) + "files" + string(filepath.Separator)
+	for _, in := range []string{files, messy} {
+		a, err := normDir(in)
+		b, err2 := verify.NormalizeDir(in)
+		if err != nil || err2 != nil || a != filepath.Clean(files) || b != a {
+			t.Errorf("normDir(%q) ＝ %q（%v），verify.NormalizeDir ＝ %q（%v），預期 %q", in, a, err, b, err2, filepath.Clean(files))
+		}
+	}
+	t.Chdir(pack)
+	if a, err := normDir("files"); err != nil || a != filepath.Clean(files) {
+		t.Errorf("相對路徑 normDir ＝ %q，%v", a, err)
+	}
+}
