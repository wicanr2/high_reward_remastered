+// -dup-ids：逐個「原項目位元組相同」的群組在 stderr 列一行 `<檔名>: id id id`（只列 id）；沒給時只印各檔的群組數。
+func TestBuildDupIDs(t *testing.T) {
+	s := newSynthOrig(t)
+	base := []string{"build", "-code", "zh-TW", "-mode", "identity", "-orig", s.dir}
+
+	// 沒給旗標：只印群組數，不列 id
+	code, _, e0 := exec("", append(append([]string{}, base...), "-out", t.TempDir())...)
+	if code != 0 || !strings.Contains(e0, "UWASA.MES 1 組") || strings.Contains(e0, "UWASA.MES#") {
+		t.Errorf("沒給 -dup-ids：%d\n%s", code, e0)
+	}
+	// 給了旗標：在同樣的摘要行之後，每個群組一行 `UWASA.MES: UWASA.MES#0 UWASA.MES#1`
+	code, _, e1 := exec("", append(append([]string{}, base...), "-out", t.TempDir(), "-dup-ids")...)
+	if code != 0 || !strings.Contains(e1, "UWASA.MES 1 組") || !strings.Contains(e1, "\nUWASA.MES: UWASA.MES#0 UWASA.MES#1\n") {
+		t.Errorf("-dup-ids：%d\n%s", code, e1)
+	}
+	if got, want := strings.Count(e1, "\nUWASA.MES: "), 1; got != want {
+		t.Errorf("群組行 %d 行，應為 %d 行：\n%s", got, want, e1)
+	}
+	if first := func(s string) string { l, _, _ := strings.Cut(s, "\n"); return l }; first(e0) != first(e1) {
+		t.Errorf("-dup-ids 不該改變摘要輸出：\n%s\n%s", first(e0), first(e1))
+	}
+
+	// 重用既有語言包時沒有群組資料：不列 id，並說明原因
+	out := t.TempDir()
+	if code, _, _ := exec("", append(append([]string{}, base...), "-out", out)...); code != 0 {
+		t.Fatal("第一次建置失敗")
+	}
+	code, stdout, e2 := exec("", append(append([]string{}, base...), "-out", out, "-dup-ids")...)
+	if code != 0 || parseKV(stdout)["reused"] != "true" || strings.Contains(e2, "UWASA.MES: ") || !strings.Contains(e2, "重用既有語言包") || !strings.Contains(e2, "-dup-ids") {
+		t.Errorf("重用時的 -dup-ids：%d\n%s", code, e2)
+	}
+
+	// 輸出只有 id，不含譯文：table 模式採用 UWASA 的譯文，stderr 不得出現譯文
+	row := func(id, orig, text string) l10n.Row {
+		r := l10n.Row{ID: id, SrcSHA: l10n.SrcSHA([]byte(orig)), Text: text, Status: l10n.StatusAccepted, By: "t", Batch: "t", Date: "2026-10-04"}
+		r.AccSHA = l10n.AccSHA(text)
+		return r
+	}
+	orig := s.enc(t, "山水火天地人")
+	root := tableRoot(t, "zh-TW", map[string]string{"UWASA.MES.tsv": tsv(t,
+		row("UWASA.MES#0", orig, "天地人水"), row("UWASA.MES#1", orig, "天地人水"))})
+	code, _, e3 := exec("", "build", "-code", "zh-TW", "-mode", "table", "-orig", s.dir, "-l10n", root, "-out", t.TempDir(), "-dup-ids")
+	if code != 0 || !strings.Contains(e3, "\nUWASA.MES: UWASA.MES#0 UWASA.MES#1\n") || !strings.Contains(e3, "採用 2 列") {
+		t.Fatalf("table 模式的 -dup-ids：%d\n%s", code, e3)
+	}
+	if strings.Contains(e3, "天地人") || strings.Contains(e3, "山水火") {
+		t.Errorf("stderr 含譯文或原文：\n%s", e3)
+	}
+}
+
+func TestBuildTableAndCandidates(t *testing.T) {
+	s := newSynthOrig(t)
+	row := func(id, orig, text, status string) l10n.Row {
+		r := l10n.Row{ID: id, SrcSHA: l10n.SrcSHA([]byte(orig)), Text: text, Status: status, By: "t", Batch: "t", Date: "2026-10-04"}
+		if status == l10n.StatusAccepted {
+			r.AccSHA = l10n.AccSHA(text)
+		}
+		return r
+	}
+	spTable := tsv(t,
+		row("SP.MES#0", s.enc(t, "一二三上下大小中國"), "上下大小", l10n.StatusAccepted),
+		row("SP.MES#1", s.enc(t, "人天地水火山"), "山水火天", l10n.StatusCandidate),
+	)
+	// -l10n 是 l10n 根目錄，譯文表在其下的 <代碼>/（代碼大小寫不分）
+	root := tableRoot(t, "ZH-tw", map[string]string{"SP.MES.tsv": spTable})
+	out := t.TempDir()
+	args := []string{"build", "-code", "zh-TW", "-mode", "table", "-orig", s.dir, "-l10n", root, "-out", out}
+	code, stdout, errOut := exec("", args...)
+	if code != 0 {
+		t.Fatalf("退出碼 %d：%s", code, errOut)
+	}
+	dir := parseKV(stdout)["dir"]
+	m, err := verify.Verify(dir, verify.Options{OrigHashes: s.hashes, SkipDigest: true})
+	if err != nil || m.Adopted != 1 || m.Policy.Mode != "table" || m.Policy.WithCandidates {
+		t.Fatalf("預設政策：%+v（%v）", m, err)
+	}
+	if !strings.Contains(errOut, "採用 1 列") {
+		t.Errorf("stderr 摘要缺採用列數：%s", errOut)
+	}
+	code, stdout2, errOut := exec("", append(args, "-with-candidates")...)
+	if code != 0 {
+		t.Fatalf("with-candidates：%d %s", code, errOut)
+	}
+	dir2 := parseKV(stdout2)["dir"]
+	m2, err := verify.Verify(dir2, verify.Options{OrigHashes: s.hashes, SkipDigest: true})
+	if err != nil || m2.Adopted != 2 || !m2.Policy.WithCandidates || dir2 == dir {
+		t.Errorf("with-candidates：%+v dir 相同=%v（%v）", m2, dir2 == dir, err)
+	}
+	// 沒有該語言的目錄：建置失敗（不是用法錯誤）
+	code, o, e := exec("", "build", "-code", "zh-TW", "-mode", "table", "-orig", s.dir, "-l10n", t.TempDir(), "-out", out)
+	if code != 1 || o != "" || !strings.Contains(e, "zh-TW") {
+		t.Errorf("沒有 <代碼> 目錄：%d %q %s", code, o, e)
+	}
+	// 政策旗標：COUNTRY.MES 的譯文需要旗標
+	cty := tsv(t, row("COUNTRY.MES#0", s.enc(t, "一二三上下大小中國人天地"), "山水火", l10n.StatusAccepted))
+	root2 := tableRoot(t, "zh-TW", map[string]string{"COUNTRY.MES.tsv": cty})
+	base := []string{"build", "-code", "zh-TW", "-mode", "table", "-orig", s.dir, "-l10n", root2, "-out", t.TempDir()}
+	if code, o, e := exec("", base...); code != 1 || o != "" || !strings.Contains(e, "-allow-country-offsets") {
+		t.Errorf("COUNTRY.MES 預設應拒絕並點名旗標：%d %q %s", code, o, e)
+	}
+	if code, o, e := exec("", append(base, "-allow-country-offsets")...); code != 0 {
+		t.Errorf("旗標開放後應成功：%d %q %s", code, o, e)
+	}
+}
+
+func TestBuildViolationsExitCode(t *testing.T) {
+	s := newSynthOrig(t)
+	bad := l10n.Row{ID: "SP.MES#0", SrcSHA: l10n.SrcSHA([]byte(s.enc(t, "一二三上下大小中國"))), Text: "上\U0001F600下", Status: l10n.StatusAccepted, By: "t", Batch: "t", Date: "2026-10-04"}
+	bad.AccSHA = l10n.AccSHA(bad.Text)
+	bad2 := l10n.Row{ID: "SYSTEM.MES#1", SrcSHA: l10n.SrcSHA([]byte(s.enc(t, "上下大小中國人"))), Text: "山水%s", Status: l10n.StatusAccepted, By: "t", Batch: "t", Date: "2026-10-04"}
+	bad2.AccSHA = l10n.AccSHA(bad2.Text)
+	root := tableRoot(t, "zh-TW", map[string]string{"SP.MES.tsv": tsv(t, bad), "SYSTEM.MES.tsv": tsv(t, bad2)})
+	out := t.TempDir()
+	code, o, e := exec("", "build", "-code", "zh-TW", "-mode", "table", "-orig", s.dir, "-l10n", root, "-out", out)
+	if code != 1 || o != "" {
+		t.Fatalf("違規應回 1 且 stdout 為空：%d %q", code, o)
+	}
+	for _, want := range []string{"2 項違規", "SP.MES#0", "SYSTEM.MES#1", "placeholder"} {
+		if !strings.Contains(e, want) {
+			t.Errorf("stderr 缺 %q：%s", want, e)
+		}
+	}
+	if ents, _ := os.ReadDir(out); len(ents) != 0 {
+		t.Errorf("違規的建置留下 %d 個項目", len(ents))
+	}
+}
+
+// 預設用 runtime 內嵌的 required.tsv 核對原版：合成的原版必須失敗，且不留下任何東西。
+func TestBuildChecksAgainstRequiredHashes(t *testing.T) {
+	s := newSynthOrig(t)
+	origHashesOverride = nil // 正式執行的路徑
+	out := t.TempDir()
+	code, o, e := exec("", "build", "-code", "zh-TW", "-mode", "identity", "-orig", s.dir, "-out", out)
+	if code != 1 || o != "" || !strings.Contains(e, "SHA-256") {
+		t.Errorf("雜湊不符應失敗：%d %q %s", code, o, e)
+	}
+	if ents, _ := os.ReadDir(out); len(ents) != 0 {
+		t.Errorf("雜湊不符不該留下東西：%d 個項目", len(ents))
+	}
+	// 原版目錄缺檔
+	code, o, e = exec("", "build", "-code", "zh-TW", "-mode", "identity", "-orig", filepath.Join(out, "nope"), "-out", out)
+	if code != 1 || o != "" || e == "" {
+		t.Errorf("原版目錄不存在：%d %q %s", code, o, e)
+	}
+}
+
+// 端對端：使用者原版加 fixture（合成譯文表），缺原版明確 skip。
+func TestEndToEndWithOriginal(t *testing.T) {
+	origDir := os.Getenv("HR_ORIG")
+	if origDir == "" {
+		origDir = "/orig/orig"
+	}
+	// 九個輸入全在才跑，缺任何一個就 skip（不用替代品；訊息格式同 l10n 套件的 readOrig）。
+	for _, n := range verify.InputNames() {
+		if _, err := os.Stat(filepath.Join(origDir, n)); err != nil {
+			t.Skipf("沒有原版檔案（%s）：%v", filepath.Join(origDir, n), err)
+		}
+	}
+	fixture := filepath.Join("..", "..", "l10n", "testdata", "fixture", "base")
+	ents, err := os.ReadDir(fixture)
+	if err != nil {
+		t.Skipf("沒有 fixture：%v", err)
+	}
+	root := tableRoot(t, "zh-TW", nil)
+	for _, e := range ents {
+		b, err := os.ReadFile(filepath.Join(fixture, e.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(root, "zh-TW", e.Name()), b, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	out := t.TempDir()
+	// 試作包（-with-candidates）：build、verify（含輸入摘要）、竄改後 verify 失敗
+	args := []string{"build", "-code", "zh-TW", "-mode", "table", "-orig", origDir, "-l10n", root, "-out", out, "-with-candidates"}
+	code, stdout, errOut := exec("", args...)
+	if code != 0 {
+		t.Fatalf("build：%d %s", code, errOut)
+	}
+	kv := parseKV(stdout)
+	d, err := l10n.ExpectedDigest(l10n.Config{Code: "zh-TW", Mode: l10n.ModeTable, TableDir: filepath.Join(root, "zh-TW"), Policy: l10n.Policy{WithCandidates: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if filepath.Base(kv["dir"]) != l10n.PackName("zh-TW", d) {
+		t.Errorf("目錄名 %s 與預期摘要不符 %s", filepath.Base(kv["dir"]), d)
+	}
+	code, vout, verr := exec("", "verify", "-digest", d, "-orig", origDir, kv["dir"])
+	if code != 0 || strings.TrimSpace(vout) != "manifest-sha256="+kv["manifest-sha256"] {
+		t.Fatalf("verify：%d %q %s", code, vout, verr)
+	}
+	// 與 identity 包不同的內容；identity 包與原檔逐位元組相同
+	code, stdout2, errOut := exec("", "build", "-code", "zh-TW", "-mode", "identity", "-orig", origDir, "-out", out)
+	if code != 0 {
+		t.Fatalf("identity build：%d %s", code, errOut)
+	}
+	idDir := parseKV(stdout2)["dir"]
+	for _, n := range []string{"COUNTRY.MES", "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES", "ESPMES.MRG", "SHOPTAB.TBL", "CFONT.15"} {
+		got, err1 := os.ReadFile(filepath.Join(idDir, "files", n))
+		want, err2 := os.ReadFile(filepath.Join(origDir, n))
+		if err1 != nil || err2 != nil || string(got) != string(want) {
+			t.Errorf("identity 包的 %s 與原檔不同（%v %v）", n, err1, err2)
+		}
+	}
+	// 負對照：竄改包內一個檔，verify 步驟必須失敗
+	p := filepath.Join(kv["dir"], "files", "SYSTEM.MES")
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b[len(b)/2] ^= 0x01
+	if err := os.WriteFile(p, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if code, vout, e := exec("", "verify", "-orig", origDir, kv["dir"]); code != 1 || vout != "" {
+		t.Errorf("竄改後 verify 應失敗：%d %q %s", code, vout, e)
+	}
+	// 負對照：輸入雜湊不符（原版內容不同），建置必須失敗
+	bad := t.TempDir()
+	for _, n := range verify.InputNames() {
+		src, err := os.ReadFile(filepath.Join(origDir, n))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if n == "SP.MES" {
+			src = append([]byte(nil), src...)
+			src[len(src)-3] ^= 0x01
+		}
+		if err := os.WriteFile(filepath.Join(bad, n), src, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if code, o, e := exec("", "build", "-code", "zh-TW", "-mode", "identity", "-orig", bad, "-out", t.TempDir()); code != 1 || o != "" || !strings.Contains(e, "SP.MES") {
+		t.Errorf("輸入雜湊不符應失敗：%d %q %s", code, o, e)
+	}
+}
diff --git a/apps/hr/cmd/hrl10n/leakscan_cmd.go b/apps/hr/cmd/hrl10n/leakscan_cmd.go
new file mode 100644
index 0000000..c6e6db2
--- /dev/null
+++ b/apps/hr/cmd/hrl10n/leakscan_cmd.go
@@ -0,0 +1,64 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/leakscan"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// textFileHashes 是片頭文字檔的 SHA-256（`apps/hr/runtime/required.tsv` 只收 MAIN.EXE 讀取的資料檔，不含它們）。
+// 來源：本專案 `docs/re/source-inventory.tsv`（jsdos 版與一般版相同）。只有雜湊，不含任何原版內容。
+var textFileHashes = map[string]string{
+	"OP.TXT":  "a9dc0000f871a1c87ae75208e58d5a8ebea522fa73d6db4a5660ae1b24e16d5d",
+	"OP0.TXT": "855c335b665d1ca7322718f7faa5cc7f6b611609083a5ca55d6bd6a0452cdc7a",
+	"OP1.TXT": "34b64935c33f7b2c2fd4f4ec4b13a916538a963750b4d8ae5f294bf4f4146a91",
+	"OP2.TXT": "42093687774e10b76245fcc38b1b7c50e90e4cf9a418f4d2d262eae20037ce48",
+	"OP3.TXT": "1cf4d9286348a5b70108049ae5326bb951441a37c6d2f950c45612e8eda0adee",
+	"OP4.TXT": "aeb1e8529e64c0190150aca56fb3fd4f0e7c6eaa009238bdc79963118f65969a",
+	"OP5.TXT": "ef4238c2793883462ba8440b6ee1b0e2dfb6a02edfe87ddc781ab967cb299c70",
+}
+
+// expectedHashes 回傳單位來源檔的預期 SHA-256（鍵是大寫檔名）。套件變數，測試可替換。
+var expectedHashes = func() map[string]string {
+	m := map[string]string{}
+	for _, rf := range hrrt.RequiredFiles() {
+		m[strings.ToUpper(rf.Name)] = rf.SHA256
+	}
+	for n, h := range textFileHashes {
+		m[n] = h
+	}
+	return m
+}
+
+// verifyOrigHashes 驗證單位來源檔的 SHA-256。單位身分是位移，只對特定位元組版本有意義：
+// 截斷的檔、另一個版本的資料檔、拿錯目錄的同名檔都必須失敗（AGENTS.md 第 2 節）。
+// 驗證放在這裡而不是 leakscan 套件，保住套件不依賴 dosgolem 內其他套件的獨立性。
+func verifyOrigHashes(files map[string][]byte) error {
+	want := expectedHashes()
+	var bad []string
+	for _, name := range leakscan.SourceFiles {
+		w, ok := want[name]
+		if !ok {
+			bad = append(bad, name+"（清單沒有預期雜湊）")
+			continue
+		}
+		sum := sha256.Sum256(files[name])
+		if hex.EncodeToString(sum[:]) != w {
+			bad = append(bad, name+"（雜湊不符）")
+		}
+	}
+	if len(bad) > 0 {
+		return fmt.Errorf("原版資料檔與預期版本不符：%s", strings.Join(bad, "、"))
+	}
+	return nil
+}
+
+// runLeakscan 是 leakscan 子命令：套件的 Main 加上原版雜湊閘門。
+func runLeakscan(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	return leakscan.MainWithGate(args, stdin, stdout, stderr, verifyOrigHashes)
+}
diff --git a/apps/hr/cmd/hrl10n/leakscan_cmd_test.go b/apps/hr/cmd/hrl10n/leakscan_cmd_test.go
new file mode 100644
index 0000000..781b2f2
--- /dev/null
+++ b/apps/hr/cmd/hrl10n/leakscan_cmd_test.go
@@ -0,0 +1,166 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/leakscan"
+)
+
+// leakscanSynthOrig 寫出合成的原版目錄：每個單位來源檔各有一個 4 字單位（合成的位元組，不是原版）。
+// 同時把 expectedHashes 換成這些檔案的雜湊（測試結束還原），讓閘門認得這份合成的「原版」。
+func leakscanSynthOrig(t *testing.T) (dir string, unit []byte) {
+	t.Helper()
+	dir = t.TempDir()
+	unit = []byte{0xC9, 0xA1, 0xC9, 0xA2, 0xC9, 0xA3, 0xC9, 0xA4}
+	want := map[string]string{}
+	for _, n := range leakscan.SourceFiles {
+		content := append(append([]byte{}, unit...), 0x0A)
+		if err := os.WriteFile(filepath.Join(dir, n), content, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		sum := sha256.Sum256(content)
+		want[n] = hex.EncodeToString(sum[:])
+	}
+	old := expectedHashes
+	expectedHashes = func() map[string]string { return want }
+	t.Cleanup(func() { expectedHashes = old })
+	return dir, unit
+}
+
+// leakscan 子命令：旗標原樣傳入，退出碼 0（無命中）、1（有命中）、2（閘門失敗）。
+func TestLeakscanSubcommand(t *testing.T) {
+	orig, unit := leakscanSynthOrig(t)
+	tree := t.TempDir()
+	if err := os.WriteFile(filepath.Join(tree, "clean.txt"), []byte("nothing here\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if code, out, errOut := exec("", "leakscan", "-orig", orig, tree); code != 0 || out != "" {
+		t.Errorf("乾淨的樹：退出碼 %d，stdout %q，stderr %q", code, out, errOut)
+	}
+	if err := os.WriteFile(filepath.Join(tree, "hit.bin"), append(append([]byte("x "), unit...), " y"...), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	code, out, errOut := exec("", "leakscan", "-orig", orig, tree)
+	if code != 1 || !strings.Contains(out, "hit.bin\tCOUNTRY.MES@0.0") || !strings.Contains(out, "hit.bin\tOP0.TXT@0.0") {
+		t.Errorf("有命中：退出碼 %d，stdout %q，stderr %q", code, out, errOut)
+	}
+	if code, _, _ := exec("", "leakscan", tree); code != 2 {
+		t.Errorf("沒有 -orig：退出碼 %d，要 2", code)
+	}
+	if code, _, _ := exec("", "leakscan", "-h"); code != 0 {
+		t.Errorf("-h：退出碼 %d，要 0", code)
+	}
+}
+
+// 原版雜湊閘門：內容與預期版本不符、清單缺這個檔的預期雜湊，都以退出碼 2 結束，訊息指出檔名。
+func TestLeakscanHashGate(t *testing.T) {
+	orig, _ := leakscanSynthOrig(t)
+	tree := t.TempDir()
+	if err := os.WriteFile(filepath.Join(tree, "clean.txt"), []byte("nothing here\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if code, _, errOut := exec("", "leakscan", "-orig", orig, tree); code != 0 {
+		t.Fatalf("雜湊相符：退出碼 %d，stderr %q", code, errOut)
+	}
+	// 每個單位來源檔各竄改一個位元組：全部都要被擋下。
+	for _, name := range leakscan.SourceFiles {
+		p := filepath.Join(orig, name)
+		b, err := os.ReadFile(p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		bad := append([]byte{}, b...)
+		bad[len(bad)-1] ^= 0x01
+		if err := os.WriteFile(p, bad, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		code, out, errOut := exec("", "leakscan", "-orig", orig, tree)
+		if code != 2 || out != "" || !strings.Contains(errOut, name+"（雜湊不符）") {
+			t.Errorf("竄改 %s：退出碼 %d，stdout %q，stderr %q", name, code, out, errOut)
+		}
+		if err := os.WriteFile(p, b, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// 預期清單缺一個檔：不能驗證就失敗。
+	old := expectedHashes
+	defer func() { expectedHashes = old }()
+	full := old()
+	for _, name := range leakscan.SourceFiles {
+		partial := map[string]string{}
+		for k, v := range full {
+			if k != name {
+				partial[k] = v
+			}
+		}
+		expectedHashes = func() map[string]string { return partial }
+		if code, _, errOut := exec("", "leakscan", "-orig", orig, tree); code != 2 || !strings.Contains(errOut, name+"（清單沒有預期雜湊）") {
+			t.Errorf("清單缺 %s：退出碼 %d，stderr %q", name, code, errOut)
+		}
+	}
+	// -check-allow 也要過閘門。
+	al := filepath.Join(tree, "allow.tsv")
+	if err := os.WriteFile(al, nil, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	b, _ := os.ReadFile(filepath.Join(orig, "SP.MES"))
+	if err := os.WriteFile(filepath.Join(orig, "SP.MES"), append(b, 'x'), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	expectedHashes = old // 合成的雜湊；SP.MES 已被改動，必然不符
+	if code, _, _ := exec("", "leakscan", "-orig", orig, "-check-allow", al); code != 2 {
+		t.Errorf("-check-allow 的雜湊閘門：退出碼 %d，要 2", code)
+	}
+}
+
+// 內嵌的預期雜湊涵蓋全部單位來源檔（cmd 的清單加上片頭文字檔的雜湊）。
+func TestExpectedHashesCoverSources(t *testing.T) {
+	want := expectedHashes()
+	for _, n := range leakscan.SourceFiles {
+		h, ok := want[n]
+		if !ok || len(h) != 64 {
+			t.Errorf("%s 沒有有效的預期雜湊：%q", n, h)
+		}
+	}
+}
+
+// 真原版：內嵌的雜湊與原版相符（乾淨的樹得 0），原版複本竄改一個位元組得 2。缺原版就 skip。
+func TestLeakscanRealOriginal(t *testing.T) {
+	dir := os.Getenv("HR_ORIG")
+	if dir == "" {
+		dir = "/orig/orig"
+	}
+	if _, err := leakscan.LoadOrig(dir); err != nil {
+		t.Skipf("沒有原版（%s）：%v", dir, err)
+	}
+	tree := t.TempDir()
+	if err := os.WriteFile(filepath.Join(tree, "clean.txt"), []byte("nothing here\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if code, out, errOut := exec("", "leakscan", "-orig", dir, tree); code != 0 || out != "" {
+		t.Fatalf("真原版：退出碼 %d，stdout %q，stderr %q", code, out, errOut)
+	}
+	// 在暫存目錄做原版複本，竄改一個位元組。
+	cp := t.TempDir()
+	files, err := leakscan.LoadOrig(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for n, b := range files {
+		if n == "SHOPTAB.TBL" {
+			b = append([]byte{}, b...)
+			b[100] ^= 0x01
+		}
+		if err := os.WriteFile(filepath.Join(cp, n), b, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if code, _, errOut := exec("", "leakscan", "-orig", cp, tree); code != 2 || !strings.Contains(errOut, "SHOPTAB.TBL（雜湊不符）") {
+		t.Errorf("竄改過的原版複本：退出碼 %d，stderr %q", code, errOut)
+	}
+}
diff --git a/apps/hr/cmd/hrl10n/main.go b/apps/hr/cmd/hrl10n/main.go
new file mode 100644
index 0000000..5855c4f
--- /dev/null
+++ b/apps/hr/cmd/hrl10n/main.go
@@ -0,0 +1,55 @@
+// Command hrl10n 是遊戲內文字多語系（docs/spec/008-ingame-text-localization）的命令列工具。
+//
+//	hrl10n leakscan  洩漏判準（第 3.9 節）：掃描版控內的檔案或 git 歷史，找出原版文字的引用
+//	hrl10n build     建置語言包（第 3.2 節）：解析、採用譯文、預算檢查、manifest，同名且驗證通過的目錄直接重用
+//	hrl10n verify    驗證語言包（第 3.2 節）：manifest、檔案雜湊、原版輸入雜湊、輸入摘要
+//
+// 加子命令只要在 commands 註冊一個函式：簽章是 func(args []string, stdin io.Reader, stdout, stderr io.Writer) int，
+// args 不含子命令名稱，回傳值就是退出碼。
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strings"
+)
+
+// command 是子命令的函式簽章。
+type command func(args []string, stdin io.Reader, stdout, stderr io.Writer) int
+
+// commands 是子命令註冊表。
+var commands = map[string]command{
+	"leakscan": runLeakscan,
+	"build":    runBuild,
+	"verify":   runVerify,
+}
+
+func usage(w io.Writer) {
+	names := make([]string, 0, len(commands))
+	for n := range commands {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	fmt.Fprintf(w, "用法：hrl10n <子命令> [旗標] [參數]\n子命令：%s\n", strings.Join(names, "、"))
+}
+
+// run 是 main 的可測試形式；回傳退出碼。
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	if len(args) == 0 {
+		usage(stderr)
+		return 2
+	}
+	cmd, ok := commands[args[0]]
+	if !ok {
+		fmt.Fprintf(stderr, "hrl10n：未知的子命令 %q\n", args[0])
+		usage(stderr)
+		return 2
+	}
+	return cmd(args[1:], stdin, stdout, stderr)
+}
+
+func main() {
+	os.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr))
+}
