+		// 把所有視窗鍵與整段鍵換成錯的：單位仍在，但自掃不再命中自己。
+		broken := NewIndex(w.units)
+		for _, m := range []*map[string][]int32{&broken.win, &broken.eq} {
+			nw := make(map[string][]int32, len(*m))
+			for k, ids := range *m {
+				nw[k+"x"] = ids
+			}
+			*m = nw
+		}
+		if err := broken.SelfCheck(); err == nil {
+			t.Error("鍵被破壞的索引必須自檢失敗")
+		}
+	})
