+package l10n
+
+import (
+	"bytes"
+	"hash/fnv"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/budget"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+)
+
+// 合成譯文表 fixture（docs/spec/008 第 8 節 `l10nBuilderVersion` 守護）。
+//
+// fixture 在 testdata/fixture/：
+//
+//	base/<資料檔名>.tsv     基礎：ESPMES、SP、SYSTEM、UWASA、POWERMES；含 %s、折行、多行、四種窗口類別、
+//	                        accepted、candidate、keep 列。不含 COUNTRY.MES 與 SHOPTAB.TBL 的非 keep 列
+//	country/COUNTRY.MES.tsv  只在 -allow-country-offsets 變體加進基礎
+//	shop/SHOPTAB.TBL.tsv     只在 -allow-shoptab 變體加進基礎
+//
+// 文字是合成的：由固定種子的產生器從 charmap-zh-TW 的漢字挑字排成，不是譯文，也不是原版文字。
+// src_sha256 取自使用者原版的項目（所以產生需要原版），選項目時避開短項目（雜湊可由字典窮舉還原）。
+// accepted 列的 acc_sha 一併填入。fixture 的 accepted 是測試值，不構成使用者接受（見 testdata/fixture/NOTICE.txt）。
+//
+// 重新產生：`HR_L10N_UPDATE_FIXTURE=1 go test -run TestUpdateFixture ./apps/hr/l10n/`（需要原版）。
+// 產生器只依賴原版與固定種子，輸出是決定性的。產生後再以 `HR_L10N_UPDATE_GOLDEN=1` 重產 golden。
+
+const fixtureDir = "testdata/fixture"
+
+// fixtureParts 是 fixture 的三個部分：目錄與其中的檔案。
+var fixtureParts = map[string][]string{
+	"base":    {"ESPMES.MRG", "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES"},
+	"country": {"COUNTRY.MES"},
+	"shop":    {"SHOPTAB.TBL"},
+}
+
+// origDirOrSkip 回傳原版目錄；九個輸入缺任何一個就 skip（不用替代品）。
+func origDirOrSkip(t testing.TB) string {
+	t.Helper()
+	readOrig(t, verify.InputNames()...)
+	if d := os.Getenv("HR_ORIG"); d != "" {
+		return d
+	}
+	return "/orig/orig"
+}
+
+// assembleFixture 把基礎 fixture 加上 extras（country、shop）的譯文表複製到暫存目錄，回傳該目錄。
+func assembleFixture(t testing.TB, extras ...string) string {
+	t.Helper()
+	dir := t.TempDir()
+	for _, part := range append([]string{"base"}, extras...) {
+		for _, n := range fixtureParts[part] {
+			b, err := os.ReadFile(filepath.Join(fixtureDir, part, n+".tsv"))
+			if err != nil {
+				t.Fatalf("讀 fixture：%v（先跑 HR_L10N_UPDATE_FIXTURE=1 go test -run TestUpdateFixture）", err)
+			}
+			if err := os.WriteFile(filepath.Join(dir, n+".tsv"), b, 0o644); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	return dir
+}
+
+// ---- 產生器 ----
+
+// fixturePool 回傳合成文字可用的字：字集內的漢字，Big5 lead 在 A1 至 DF、trail 在 S 集（40 至 7E、A1 至 DF），
+// 所以任何位置的字都不會讓 `1676` 模擬器看到 P 集位元組。依 Unicode 碼位排序。
+func fixturePool(t testing.TB) []rune {
+	t.Helper()
+	lines := strings.Split(strings.TrimSuffix(string(charmapTSV), "\n"), "\n")[1:]
+	var pool []rune
+	for _, ln := range lines {
+		f := strings.Split(strings.TrimSuffix(ln, "\r"), "\t")
+		u, err1 := strconv.ParseUint(f[0], 16, 32)
+		bg, err2 := strconv.ParseUint(f[1], 16, 16)
+		if err1 != nil || err2 != nil {
+			t.Fatalf("charmap 行格式：%q", ln)
+		}
+		lead, trail := byte(bg>>8), byte(bg)
+		if u < 0x4E00 || u > 0x9FFF || lead < 0xA1 || lead > 0xDF {
+			continue
+		}
+		if !(trail >= 0x40 && trail <= 0x7E || trail >= 0xA1 && trail <= 0xDF) {
+			continue
+		}
+		pool = append(pool, rune(u))
+	}
+	if len(pool) < 200 {
+		t.Fatalf("字池太小：%d", len(pool))
+	}
+	return pool
+}
+
+// textGen 是固定種子的字序產生器（FNV-1a 種子加 LCG）。
+type textGen struct {
+	pool  []rune
+	state uint64
+}
+
+func newTextGen(pool []rune, seed string) *textGen {
+	h := fnv.New64a()
+	h.Write([]byte(seed))
+	return &textGen{pool: pool, state: h.Sum64() | 1}
+}
+
+func (g *textGen) text(n int) string {
+	rs := make([]rune, n)
+	for i := range rs {
+		g.state = g.state*6364136223846793005 + 1442695040888963407
+		rs[i] = g.pool[int(g.state>>33)%len(g.pool)]
+	}
+	return string(rs)
+}
+
+// fxItem 是候選項目。
+type fxItem struct {
+	id    string
+	idx   int // 在檔案內的順序
+	orig  []byte
+	class string // ESPMES 的窗口類別
+}
+
+// fxCandidates 列出檔案內不在重複群組、位元組數 >= minLen 的項目（檔案順序）。
+func fxCandidates(f *File, minLen int) []fxItem {
+	dup := map[string]bool{}
+	for _, g := range f.DuplicateGroups() {
+		for _, id := range g {
+			dup[id] = true
+		}
+	}
+	var out []fxItem
+	for i, it := range f.Items {
+		if dup[it.ID] || len(it.Orig) < minLen {
+			continue
+		}
+		c := ""
+		if f.Kind == KindESP {
+			c, _ = ESPWindowClass(it.ID)
+		}
+		out = append(out, fxItem{id: it.ID, idx: i, orig: it.Orig, class: c})
+	}
+	return out
+}
+
+func fxFilter(items []fxItem, pred func(fxItem) bool) []fxItem {
+	var out []fxItem
+	for _, it := range items {
+		if pred(it) {
+			out = append(out, it)
+		}
+	}
+	return out
+}
+
+// fxFit 由大到小試 build(n)，回傳第一個編碼成功且通過 AutoWrap 加 Check 的文字（與建置器相同的檢查）。
+func fxFit(cs *Charmap, file string, it fxItem, from int, build func(n int) string) (string, bool) {
+	for n := from; n >= 1; n-- {
+		txt := build(n)
+		b, _, err := cs.Encode(txt)
+		if err != nil {
+			continue
+		}
+		in := budget.Input{ID: it.id, File: file, Class: it.class, Orig: it.orig, Trans: b}
+		wrapped, vs := budget.AutoWrap(in)
+		in.Trans = wrapped
+		vs = append(vs, budget.Check(in)...)
+		if len(vs) == 0 {
+			return txt, true
+		}
+	}
+	return "", false
+}
+
+// withSpecs 造一個保留原項目轉換規格（個數、順序、文字）的譯文：規格之間夾 n 個字。
+func withSpecs(g *textGen, specs []string, n int) string {
+	var sb strings.Builder
+	for _, s := range specs {
+		sb.WriteString(g.text(n))
+		sb.WriteString(s)
+	}
+	sb.WriteString(g.text(n))
+	return sb.String()
+}
+
+// fxRow 造 fixture 的一列。
+func fxRow(it fxItem, text, status string) Row {
+	r := Row{ID: it.id, SrcSHA: SrcSHA(it.orig), Text: text, Status: status, By: "fixture", Batch: "fixture-v1", Date: "2026-10-04",
+		Note: "合成測試值，accepted 不構成使用者接受"}
+	if status == StatusAccepted {
+		r.AccSHA = AccSHA(text)
+	}
+	return r
+}
+
+type fxPicker struct {
+	t    *testing.T
+	cs   *Charmap
+	pool []rune
+	file string
+	rows []Row
+	used map[string]bool
+}
+
+// take 從 items 中依序找第一個可用（沒被用過、文字產生得出來）的項目，加進 rows。
+func (p *fxPicker) take(items []fxItem, status string, from int, build func(it fxItem, g *textGen, n int) string) {
+	p.t.Helper()
+	for _, it := range items {
+		if p.used[it.id] {
+			continue
+		}
+		if status == StatusKeep {
+			p.used[it.id] = true
+			p.rows = append(p.rows, fxRow(it, "", status))
+			return
+		}
+		g := newTextGen(p.pool, it.id)
+		if txt, ok := fxFit(p.cs, p.file, it, from, func(n int) string { return build(it, g, n) }); ok {
+			p.used[it.id] = true
+			p.rows = append(p.rows, fxRow(it, txt, status))
+			return
+		}
+	}
+	p.t.Fatalf("%s：找不到可用的項目（候選 %d 個，狀態 %s，起始字數 %d，已選 %d 列）", p.file, len(items), status, from, len(p.rows))
+}
+
+func (p *fxPicker) sorted(f *File) []Row {
+	idx := map[string]int{}
+	for i, it := range f.Items {
+		idx[it.ID] = i
+	}
+	sort.Slice(p.rows, func(a, b int) bool { return idx[p.rows[a].ID] < idx[p.rows[b].ID] })
+	return p.rows
+}
+
+func plainText(n int) func(it fxItem, g *textGen, k int) string {
+	return func(_ fxItem, g *textGen, k int) string { return g.text(min(n, k)) }
+}
+
+// specBuild 造保留原項目轉換規格的譯文（每個規格之間夾 n 個字）。
+func specBuild(it fxItem, g *textGen, n int) string { return withSpecs(g, percentSpecs(it.orig), n) }
+
+// genFixture 由原版產生 fixture 三個部分的列。
+func genFixture(t *testing.T, orig map[string][]byte) map[string]map[string][]Row {
+	t.Helper()
+	cs := mustCharmap(t)
+	pool := fixturePool(t)
+	parse := func(n string) *File { return mustParse(t, n, orig[n]) }
+	out := map[string]map[string][]Row{"base": {}, "country": {}, "shop": {}}
+	newPicker := func(file string) *fxPicker {
+		return &fxPicker{t: t, cs: cs, pool: pool, file: file, used: map[string]bool{}}
+	}
+	noSpec := func(it fxItem) bool { return len(percentSpecs(it.orig)) == 0 && !bytes.Contains(it.orig, []byte{'%'}) }
+	hasSpec := func(it fxItem) bool { return len(percentSpecs(it.orig)) > 0 }
+
+	// ESPMES.MRG：四種窗口類別、%s、自動折行、多行、accepted、candidate、keep
+	{
+		f := parse("ESPMES.MRG")
+		p := newPicker("ESPMES.MRG")
+		all := fxCandidates(f, 24)
+		plain31 := fxFilter(all, func(it fxItem) bool { return it.class == ClassWin31x4 && noSpec(it) })
+		spec31 := fxFilter(all, func(it fxItem) bool { return it.class == ClassWin31x4 && hasSpec(it) })
+		// 這三個類別的項目很少（win63x8 只有三個，且都含轉換規格），放寬長度門檻到 16 bytes（8 個字，雜湊仍不可能窮舉），
+		// 也不排除含規格的項目：含規格者保留原規格，其餘排成單行。
+		wide := fxCandidates(f, 16)
+		w63 := fxFilter(wide, func(it fxItem) bool { return it.class == ClassWin63x8 })
+		w29 := fxFilter(wide, func(it fxItem) bool { return it.class == ClassWin29x4 })
+		none := fxFilter(wide, func(it fxItem) bool { return it.class == ClassNone && noSpec(it) })
+		mixed := func(it fxItem, g *textGen, n int) string {
+			if sp := percentSpecs(it.orig); len(sp) > 0 {
+				return withSpecs(g, sp, min(n, 3))
+			}
+			return g.text(min(n, 12))
+		}
+		p.take(plain31, StatusAccepted, 10, plainText(10))
+		p.take(plain31, StatusAccepted, 22, plainText(22)) // 超寬的行，要自動折行
+		p.take(plain31, StatusAccepted, 9, func(_ fxItem, g *textGen, n int) string {
+			return g.text(min(8, n)) + "\n" + g.text(min(9, n)) + "\n" + g.text(min(6, n))
+		})
+		if len(spec31) < 2 {
+			t.Fatalf("ESPMES 窗口 win31x4 含 %%s 的項目不足：%d", len(spec31))
+		}
+		p.take(spec31, StatusAccepted, 3, specBuild)
+		p.take(w63, StatusAccepted, 12, mixed)
+		p.take(w29, StatusAccepted, 12, mixed)
+		p.take(none, StatusAccepted, 11, plainText(11))
+		p.take(plain31, StatusCandidate, 9, plainText(9))
+		p.take(spec31, StatusCandidate, 3, specBuild)
+		p.take(plain31, StatusKeep, 0, nil)
+		p.take(plain31, StatusKeep, 0, nil)
+		out["base"]["ESPMES.MRG"] = p.sorted(f)
+	}
+	// SP.MES
+	{
+		f := parse("SP.MES")
+		p := newPicker("SP.MES")
+		all := fxFilter(fxCandidates(f, 24), noSpec)
+		p.take(all, StatusAccepted, 14, plainText(14))
+		p.take(all, StatusAccepted, 13, func(_ fxItem, g *textGen, n int) string { return g.text(n) + "\n" + g.text(min(9, n)) })
+		p.take(all, StatusCandidate, 12, plainText(12))
+		p.take(all, StatusKeep, 0, nil)
+		out["base"]["SP.MES"] = p.sorted(f)
+	}
+	// SYSTEM.MES：含 %s 的項目
+	{
+		f := parse("SYSTEM.MES")
+		p := newPicker("SYSTEM.MES")
+		all := fxCandidates(f, 24)
+		spec := fxFilter(all, hasSpec)
+		plain := fxFilter(all, noSpec)
+		if len(spec) == 0 {
+			t.Fatal("SYSTEM.MES 沒有含轉換規格的項目")
+		}
+		p.take(spec, StatusAccepted, 3, specBuild)
+		p.take(plain, StatusAccepted, 12, plainText(12))
+		p.take(plain, StatusCandidate, 10, plainText(10))
+		p.take(plain, StatusKeep, 0, nil)
+		out["base"]["SYSTEM.MES"] = p.sorted(f)
+	}
+	// UWASA.MES：重複來源群組，同群組的譯文必須相同
+	{
+		f := parse("UWASA.MES")
+		var groups [][]string
+		for _, g := range f.DuplicateGroups() {
+			if it, _ := f.Lookup(g[0]); len(it.Orig) >= 16 {
+				groups = append(groups, g)
+			}
+		}
+		sort.SliceStable(groups, func(a, b int) bool { return len(groups[a]) > len(groups[b]) })
+		if len(groups) < 2 {
+			t.Fatalf("UWASA.MES 的重複群組不足：%d", len(groups))
+		}
+		var rows []Row
+		for gi, status := range []string{StatusAccepted, StatusCandidate} {
+			it0, _ := f.Lookup(groups[gi][0])
+			item := fxItem{id: it0.ID, orig: it0.Orig}
+			txt, ok := fxFit(cs, "UWASA.MES", item, 8-gi, func(n int) string { return newTextGen(pool, "uwasa-"+strconv.Itoa(gi)).text(n) })
+			if !ok {
+				t.Fatal("UWASA.MES 群組文字產生失敗")
+			}
+			for _, id := range groups[gi] {
+				it, _ := f.Lookup(id)
+				rows = append(rows, fxRow(fxItem{id: id, orig: it.Orig}, txt, status))
+			}
+		}
+		p := &fxPicker{rows: rows}
+		out["base"]["UWASA.MES"] = p.sorted(f)
+	}
+	// POWERMES.MES
+	{
+		f := parse("POWERMES.MES")
+		p := newPicker("POWERMES.MES")
+		all := fxFilter(fxCandidates(f, 24), noSpec)
+		p.take(all, StatusAccepted, 13, plainText(13))
+		p.take(all, StatusAccepted, 12, func(_ fxItem, g *textGen, n int) string { return g.text(min(10, n)) + "\n" + g.text(min(7, n)) })
+		p.take(all, StatusAccepted, 9, plainText(9))
+		p.take(all, StatusCandidate, 11, plainText(11))
+		out["base"]["POWERMES.MES"] = p.sorted(f)
+	}
+	// COUNTRY.MES（只在 -allow-country-offsets 變體）：取最長的兩項
+	{
+		f := parse("COUNTRY.MES")
+		items := fxCandidates(f, 0)
+		sort.SliceStable(items, func(a, b int) bool { return len(items[a].orig) > len(items[b].orig) })
+		p := newPicker("COUNTRY.MES")
+		p.take(items, StatusAccepted, 12, plainText(12))
+		p.take(items, StatusAccepted, 16, plainText(16))
+		fxSampleFloor(t, f, fxRowIDs(p.rows))
+		out["country"]["COUNTRY.MES"] = p.sorted(f)
+	}
+	// SHOPTAB.TBL（只在 -allow-shoptab 變體）：取名稱最長（去掉補白）的三項
+	{
+		f := parse("SHOPTAB.TBL")
+		items := fxCandidates(f, 0)
+		trimmed := func(it fxItem) int { return len(bytes.TrimRight(it.orig, " ")) }
+		sort.SliceStable(items, func(a, b int) bool { return trimmed(items[a]) > trimmed(items[b]) })
+		var rows []Row
+		for _, it := range items[:3] {
+			n := min(10, max(trimmed(it)/2, 2))
+			txt := newTextGen(pool, it.id).text(n)
+			rows = append(rows, fxRow(it, txt, StatusAccepted))
+		}
+		fxSampleFloor(t, f, fxRowIDs(rows))
+		p := &fxPicker{rows: rows}
+		out["shop"]["SHOPTAB.TBL"] = p.sorted(f)
+	}
+	return out
+}
+
+// 取樣的長度下限：-allow-* 變體的取樣要選內容夠長、無法由字典窮舉還原 src_sha256 的項目（規格第 8 節）。
+const (
+	fxShopTrimmedMin = 16 // SHOPTAB.TBL：原名稱去掉補白後的位元組數
+	fxCountryOrigMin = 24 // COUNTRY.MES：原項目的位元組數
+)
+
+func fxRowIDs(rows []Row) []string {
+	ids := make([]string, len(rows))
+	for i, r := range rows {
+		ids[i] = r.ID
+	}
+	return ids
+}
+
+// fxSampleFloor 檢查取樣項目的原項目長度不低於下限（COUNTRY.MES 取位元組數，SHOPTAB.TBL 取去掉補白後的位元組數），
+// 並把實際長度（只有數字）寫進測試日誌；不足就 t.Fatalf。產生器與 TestFixtureSampleLengths 共用。
+func fxSampleFloor(t testing.TB, f *File, ids []string) {
+	t.Helper()
+	floor := 0
+	switch f.Kind {
+	case KindCountry:
+		floor = fxCountryOrigMin
+	case KindShop:
+		floor = fxShopTrimmedMin
+	default:
+		t.Fatalf("%s 沒有取樣長度下限", f.Name)
+	}
+	for i, id := range ids {
+		it, ok := f.Lookup(id)
+		if !ok {
+			t.Fatalf("%s 沒有取樣的項目 %s", f.Name, id)
+		}
+		n := len(it.Orig)
+		if f.Kind == KindShop {
+			n = len(bytes.TrimRight(it.Orig, " "))
+		}
+		t.Logf("%s 取樣第 %d 項：原項目 %d bytes（下限 %d）", f.Name, i+1, n, floor)
+		if n < floor {
+			t.Fatalf("%s 取樣第 %d 項：原項目 %d bytes，低於下限 %d（字典窮舉可能還原 src_sha256）", f.Name, i+1, n, floor)
+		}
+	}
+}
+
+// 已提交的 fixture 取樣符合長度下限（需要原版）：不重產 fixture，只對現有的列查原項目的長度。
+func TestFixtureSampleLengths(t *testing.T) {
+	origDirOrSkip(t)
+	orig := readOrigData(t)
+	for _, c := range []struct{ part, name string }{{"country", "COUNTRY.MES"}, {"shop", "SHOPTAB.TBL"}} {
+		fxSampleFloor(t, mustParse(t, c.name, orig[c.name]), fxRowIDs(loadFixtureTable(t, c.part, c.name).Rows))
+	}
+}
+
+// TestUpdateFixture 由使用者原版重新產生 testdata/fixture（HR_L10N_UPDATE_FIXTURE=1 才執行）。
+func TestUpdateFixture(t *testing.T) {
+	if os.Getenv("HR_L10N_UPDATE_FIXTURE") != "1" {
+		t.Skip("設 HR_L10N_UPDATE_FIXTURE=1 才重新產生 fixture")
+	}
+	origDirOrSkip(t)
+	orig := readOrigData(t)
+	gen := genFixture(t, orig)
+	for part, files := range gen {
+		if err := os.MkdirAll(filepath.Join(fixtureDir, part), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		for name, rows := range files {
+			var sb strings.Builder
+			if err := (&Table{Rows: rows}).Save(&sb); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(fixtureDir, part, name+".tsv"), []byte(sb.String()), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			t.Logf("%s/%s.tsv：%d 列", part, name, len(rows))
+		}
+	}
+}
+
+// ---- 檢查 ----
+
+// loadFixtureTable 讀 fixture 的一份譯文表。
+func loadFixtureTable(t testing.TB, part, name string) *Table {
+	t.Helper()
+	f, err := os.Open(filepath.Join(fixtureDir, part, name+".tsv"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	tbl, err := LoadTable(f)
+	if err != nil {
+		t.Fatalf("%s/%s.tsv：%v", part, name, err)
+	}
+	return tbl
+}
+
+// fixture 的形狀（不需要原版）：格式合法、acc_sha 正確、id 屬於該檔、字都在字集內、
+// 基礎 fixture 不含 COUNTRY.MES 與 SHOPTAB.TBL，accepted 與 candidate 與 keep 都有。
+func TestFixtureWellFormed(t *testing.T) {
+	cs := mustCharmap(t)
+	counts := map[string]int{}
+	for part, names := range fixtureParts {
+		for _, n := range names {
+			tbl := loadFixtureTable(t, part, n)
+			if len(tbl.Rows) == 0 {
+				t.Errorf("%s/%s.tsv 沒有列", part, n)
+			}
+			prefix := (&File{Name: n, Kind: map[string]Kind{"ESPMES.MRG": KindESP, "SHOPTAB.TBL": KindShop}[n]}).idPrefix() + "#"
+			for _, r := range tbl.Rows {
+				if !strings.HasPrefix(r.ID, prefix) {
+					t.Errorf("%s/%s.tsv：id %s 不屬於這個檔", part, n, r.ID)
+				}
+				counts[part+"/"+r.Status]++
+				switch r.Status {
+				case StatusAccepted:
+					if r.AccSHA != AccSHA(r.Text) {
+						t.Errorf("%s 的 acc_sha 不符", r.ID)
+					}
+				case StatusKeep:
+					if r.Text != "" {
+						t.Errorf("%s：keep 列不該有文字", r.ID)
+					}
+				}
+				if r.Status != StatusKeep {
+					if _, _, err := cs.Encode(r.Text); err != nil {
+						t.Errorf("%s 的文字有字集外的字：%v", r.ID, err)
+					}
+					for _, c := range r.Text {
+						if c != '\n' && c != '%' && c < 0x80 && !(c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z') {
+							t.Errorf("%s 的文字含意外的 ASCII 字元 %q", r.ID, c)
+						}
+					}
+				}
+				if r.By != "fixture" || !strings.Contains(r.Note, "不構成使用者接受") {
+					t.Errorf("%s：by 與 note 應註明是 fixture 測試值", r.ID)
+				}
+			}
+		}
+	}
+	for _, k := range []string{"base/accepted", "base/candidate", "base/keep", "country/accepted", "shop/accepted"} {
+		if counts[k] == 0 {
+			t.Errorf("fixture 缺 %s 列", k)
+		}
+	}
+	for _, k := range []string{"base/accepted", "base/candidate"} {
+		t.Logf("fixture %s：%d 列", k, counts[k])
+	}
+	if _, err := os.Stat(filepath.Join(fixtureDir, "NOTICE.txt")); err != nil {
+		t.Errorf("缺 NOTICE.txt：%v", err)
+	}
+}
+
+// goldenVariant 是 golden 的一個建置變體。
+type goldenVariant struct {
+	name   string
+	policy Policy
+	extras []string // 加進基礎的 fixture 部分
+}
+
+var goldenVariants = []goldenVariant{
+	{"default", Policy{}, nil},
+	{"with-candidates", Policy{WithCandidates: true}, nil},
+	{"allow-country-offsets", Policy{AllowCountryOffsets: true}, []string{"country"}},
+	{"allow-shoptab", Policy{AllowShoptab: true}, []string{"shop"}},
+}
+
+// buildVariant 以使用者原版加 fixture 建一個變體（table 模式，預設取 required.tsv 的雜湊核對原版）。
+func buildVariant(t testing.TB, origDir string, v goldenVariant) *Result {
+	t.Helper()
+	cfg := Config{
+		OrigDir: origDir, TableDir: assembleFixture(t, v.extras...), PackRoot: t.TempDir(),
+		Code: "zh-TW", Mode: ModeTable, Policy: v.policy,
+	}
+	return mustBuild(t, cfg)
+}
+
+// fixture 在使用者原版上的建置：各變體的採用列數、涵蓋範圍（需要原版）。
+func TestFixtureBuildsAllVariants(t *testing.T) {
+	origDir := origDirOrSkip(t)
+	cs := mustCharmap(t)
+	countAccepted := func(part string, withCand bool) int {
+		n := 0
+		for _, name := range fixtureParts[part] {
+			for _, r := range loadFixtureTable(t, part, name).Rows {
+				if r.Status == StatusAccepted || (withCand && r.Status == StatusCandidate) {
+					n++
+				}
+			}
+		}
+		return n
+	}
+	want := map[string]int{
+		"default":               countAccepted("base", false),
+		"with-candidates":       countAccepted("base", true),
+		"allow-country-offsets": countAccepted("base", false) + countAccepted("country", false),
+		"allow-shoptab":         countAccepted("base", false) + countAccepted("shop", false),
+	}
+	for _, v := range goldenVariants {
+		res := buildVariant(t, origDir, v)
+		if res.Manifest.Adopted != want[v.name] {
+			t.Errorf("%s：採用 %d 列，應為 %d", v.name, res.Manifest.Adopted, want[v.name])
+		}
+		if res.Manifest.Adopted == 0 {
+			t.Errorf("%s：fixture 沒有被採用的列", v.name)
+		}
+		hashes, err := OrigInputHashes(origDir)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := verify.Verify(res.Dir, verify.Options{OrigHashes: hashes, SkipDigest: true}); err != nil {
+			t.Errorf("%s：包驗證失敗：%v", v.name, err)
+		}
+	}
+
+	// 涵蓋：含 %s 的項目、折行（寫出的位元組比編碼多出 0x0A）、四種窗口類別、多行、重複群組。
+	res := buildVariant(t, origDir, goldenVariants[0])
+	espNew := mustParse(t, "ESPMES.MRG", packFile(t, res.Dir, "ESPMES.MRG"))
+	classes := map[string]bool{}
+	var hasSpec, hasWrap, hasMultiline bool
+	for _, name := range fixtureParts["base"] {
+		for _, r := range loadFixtureTable(t, "base", name).Rows {
+			if r.Status != StatusAccepted {
+				continue
+			}
+			enc, _, err := cs.Encode(r.Text)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(r.Text, "%s") {
+				hasSpec = true
+			}
+			if strings.Contains(r.Text, "\n") {
+				hasMultiline = true
+			}
+			if name == "ESPMES.MRG" {
+				c, _ := ESPWindowClass(r.ID)
+				classes[c] = true
+				it, _ := espNew.Lookup(r.ID)
+				if len(it.Orig) > len(enc) {
+					hasWrap = true
+				}
+			}
+		}
+	}
+	for _, c := range []string{ClassWin31x4, ClassWin63x8, ClassWin29x4, ClassNone} {
+		if !classes[c] {
+			t.Errorf("fixture 沒有涵蓋窗口類別 %s", c)
+		}
+	}
+	if !hasSpec || !hasWrap || !hasMultiline {
+		t.Errorf("fixture 涵蓋不足：%%s=%v 折行=%v 多行=%v", hasSpec, hasWrap, hasMultiline)
+	}
+	uw := mustParse(t, "UWASA.MES", packFile(t, res.Dir, "UWASA.MES"))
+	if len(uw.DuplicateGroups()) == 0 {
+		t.Error("UWASA.MES 的譯文包沒有重複群組")
+	}
+}
