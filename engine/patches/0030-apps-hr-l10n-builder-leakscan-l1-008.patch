+	}
+	if got := finalPacks(t, root); len(got) != 1 {
+		t.Errorf("包根下有 %v", got)
+	}
+	if got := tmpEntries(t, root); len(got) != 0 {
+		t.Errorf("自己的暫存目錄沒有丟棄：%v", got)
+	}
+	if res.ManifestSHA256 != innerRes.ManifestSHA256 {
+		t.Error("manifest 雜湊不同")
+	}
+}
