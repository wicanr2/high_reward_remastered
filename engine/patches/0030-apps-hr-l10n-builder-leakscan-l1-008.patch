+		code, _, errOut = runMain("", append([]string{"-orig", good, "-allow-empty"}, c.args...)...)
+		if code != ExitClean {
+			t.Errorf("%s 加 -allow-empty：退出碼 %d，stderr %s", c.name, code, errOut)
+		}
+	}
+	// 對照：有檔案就不是空範圍。
+	writeFile(t, tmp, "full/x.txt", []byte("nothing\n"))
+	if code, _, errOut := runMain("", "-orig", good, filepath.Join(tmp, "full")); code != ExitClean {
+		t.Errorf("有檔案的目錄：退出碼 %d，stderr %s", code, errOut)
+	}
+}
+
+// 清單格式：以引號開頭的行（git 的引號格式）失敗；-files-from0 與標準輸入。
+func TestMainListFormats(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		long := w.pick(t, 12, 60)
+		lrs, _ := clean(long)
+		leak := []byte("quote: " + string(lrs[:8]) + "\n")
+		root := t.TempDir()
+		// 路徑含非 ASCII 字元（git 預設會加引號）與空白。
+		fancy := writeFile(t, root, cp(0x4e2d, 0x6587)+" dir/"+cp(0x6a94)+" one.txt", leak)
+		plain := writeFile(t, root, "plain.txt", leak)
+
+		// 引號格式：git 在預設 core.quotepath 下的輸出。即使加 -skip-missing 也失敗。
+		quoted := writeFile(t, t.TempDir(), "quoted.list", []byte(plain+"\n\"dir/\\344\\270\\255.txt\"\n"))
+		for _, extra := range [][]string{nil, {"-skip-missing"}} {
+			code, out, errOut := runMain("", append([]string{"-orig", w.orig, "-files-from", quoted}, extra...)...)
+			if code != ExitUsage || out != "" || !strings.Contains(errOut, "引號") {
+				t.Errorf("引號格式的清單行 %v：退出碼 %d，stdout %q，stderr %s", extra, code, out, errOut)
+			}
+		}
+		// -files-from0：NUL 分隔，路徑原樣（含非 ASCII 與空白）。
+		nul := writeFile(t, t.TempDir(), "list0", []byte(fancy+"\x00"+plain+"\x00"))
+		code, out, errOut := runMain("", "-orig", w.orig, "-files-from0", nul)
+		if code != ExitHits || !strings.Contains(out, fancy+"\t") || !strings.Contains(out, plain+"\t") {
+			t.Errorf("-files-from0：退出碼 %d，stdout %q，stderr %s", code, out, errOut)
+		}
+		// NUL 清單的項目不存在：同樣失敗；-skip-missing 才略過。
+		nulMissing := writeFile(t, t.TempDir(), "list0m", []byte(plain+"\x00"+filepath.Join(root, "nope")+"\x00"))
+		if code, _, errOut = runMain("", "-orig", w.orig, "-files-from0", nulMissing); code != ExitUsage || !strings.Contains(errOut, "不存在") {
+			t.Errorf("NUL 清單有不存在的項目：退出碼 %d，stderr %s", code, errOut)
+		}
+		if code, _, _ = runMain("", "-orig", w.orig, "-files-from0", nulMissing, "-skip-missing"); code != ExitHits {
+			t.Errorf("NUL 清單加 -skip-missing：退出碼 %d", code)
+		}
+		// 以換行分隔的清單讀 NUL 項目（路徑含換行的檔案）：-files-from0 能處理。
+		weird := writeFile(t, root, "line1\nline2.txt", leak)
+		nulWeird := writeFile(t, t.TempDir(), "list0w", []byte(weird+"\x00"))
+		if code, out, _ = runMain("", "-orig", w.orig, "-files-from0", nulWeird); code != ExitHits || !strings.Contains(out, weird+"\t") {
+			t.Errorf("路徑含換行的 NUL 清單：退出碼 %d，stdout %q", code, out)
+		}
+		// 清單從標準輸入讀：-files-from - 與 -files-from0 -。
+		if code, out, _ = runMain(plain+"\n", "-orig", w.orig, "-files-from", "-"); code != ExitHits || !strings.Contains(out, plain+"\t") {
+			t.Errorf("-files-from -：退出碼 %d，stdout %q", code, out)
+		}
+		if code, out, _ = runMain(fancy+"\x00"+plain+"\x00", "-orig", w.orig, "-files-from0", "-"); code != ExitHits || !strings.Contains(out, fancy+"\t") {
+			t.Errorf("-files-from0 -：退出碼 %d，stdout %q", code, out)
+		}
+		if code, _, _ = runMain("", "-orig", w.orig, "-files-from", "-"); code != ExitUsage {
+			t.Errorf("標準輸入的清單是空的：退出碼 %d，要 %d", code, ExitUsage)
+		}
+	})
+}
+
+func TestMainUsage(t *testing.T) {
+	good := writeOrig(t, synthFiles())
+	tree := t.TempDir()
+	al := writeFile(t, tree, "allow.tsv", nil)
+	for name, args := range map[string][]string{
+		"沒有任何路徑":                      {"-orig", good},
+		"未知旗標":                        {"-orig", good, "-nope", tree},
+		"-history 加路徑":                {"-orig", good, "-history", tree},
+		"-history 加清單":                {"-orig", good, "-history", "-files-from", al},
+		"-history 加 NUL 清單":           {"-orig", good, "-history", "-files-from0", al},
+		"-history 加 -skip-missing":    {"-orig", good, "-history", "-skip-missing"},
+		"兩種清單":                        {"-orig", good, "-files-from", al, "-files-from0", al},
+		"-skip-missing 沒有清單":          {"-orig", good, "-skip-missing", tree},
+		"-check-allow 加路徑":            {"-orig", good, "-check-allow", al, tree},
+		"-check-allow 加歷史":            {"-orig", good, "-check-allow", al, "-history"},
+		"-check-allow 加 -allow":       {"-orig", good, "-check-allow", al, "-allow", al},
+		"-check-allow 加 NUL 清單":       {"-orig", good, "-check-allow", al, "-files-from0", al},
+		"-check-allow 加 -allow-empty": {"-orig", good, "-check-allow", al, "-allow-empty"},
+	} {
+		if code, out, _ := runMain("", args...); code != ExitUsage || out != "" {
+			t.Errorf("%s：退出碼 %d，stdout %q，要 %d", name, code, out, ExitUsage)
+		}
+	}
+	if code, _, _ := runMain("", "-h"); code != ExitClean {
+		t.Errorf("-h：退出碼 %d，要 %d", code, ExitClean)
+	}
+}
+
+// 效率：被掃的樹有數千個檔，單位有數千個。用雜湊集合比對，不是對每個檔暴力掃每個單位。
+func TestManyFiles(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		long := w.pick(t, 12, 60)
+		lrs, _ := clean(long)
+		root := t.TempDir()
+		body := strings.Repeat("The quick brown fox jumps over the lazy dog; %s %d.\n", 40)
+		cjk := strings.Repeat(cp(0x4e00, 0x4e8c, 0x4e09, 0x56db, 0x4e94, 0x516d, 0x4e03, 0x516b, 0x4e5d, 0x5341)+"\n", 20)
+		for i := 0; i < 3000; i++ {
+			content := body
+			if i%3 == 0 {
+				content += cjk
+			}
+			if i == 1234 {
+				content += string(lrs[:8])
+			}
+			writeFile(t, root, fmt.Sprintf("d%02d/f%04d.txt", i%50, i), []byte(content))
+		}
+		start := time.Now()
+		code, out, errOut := runMain("", "-orig", w.orig, root)
+		el := time.Since(start)
+		t.Logf("%s：掃描 3000 個檔（%d 個單位）用 %v", w.name, len(w.units), el)
+		if code != ExitHits || !strings.Contains(out, "f1234.txt\t"+long.ID) {
+			t.Fatalf("退出碼 %d，stdout %q，stderr %s", code, out, errOut)
+		}
+		if el > time.Minute {
+			t.Errorf("掃描太慢：%v", el)
+		}
+	})
+}
diff --git a/apps/hr/l10n/leakscan/index.go b/apps/hr/l10n/leakscan/index.go
new file mode 100644
index 0000000..85cf7b6
--- /dev/null
+++ b/apps/hr/l10n/leakscan/index.go
@@ -0,0 +1,344 @@
+package leakscan
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"sort"
+	"unicode/utf16"
+	"unicode/utf8"
+)
+
+// 比對（docs/spec/008 第 3.9 節第 3 項）。
+const (
+	// windowChars 是滑動視窗的字數（6 字 ＝ 12 bytes）。片段 >= windowChars 字用視窗比，
+	// minFragChars 至 windowChars-1 字的片段只比整段相等。
+	windowChars = 6
+
+	// minMembers 是視窗與整段鍵至少要有的非標點字數。標點占多數的片段是裝飾線（成排的符號與方框字元），
+	// 與一般文件的標點序列（"------"、"======"、"......"）無法區分，不能當引用的證據。
+	minMembers = 3
+
+	// 被掃檔案的兩種解碼：位元組形式（Big5 對齊解碼）與 UTF-8 形式。二進位檔（含 NUL）只比位元組形式。
+	formRaw  = true
+	formUTF8 = true
+)
+
+// Index 是單位的查找表。鍵是正規化後的片段（UTF-8 編碼），值是單位在 Units 內的索引。
+type Index struct {
+	units []Unit
+	win   map[string][]int32 // 長片段的每個 windowChars 字視窗
+	eq    map[string][]int32 // 短片段（minFragChars 至 windowChars-1 字）的整段
+}
+
+// scratch 是掃描時重複使用的緩衝區。
+type scratch struct {
+	cur  []rune
+	enc  []byte
+	offs []int
+}
+
+// NewIndex 為單位建立查找表。單位片段只走「連接」形式的正規化（可移除字元去掉）：
+// 被掃檔案兩種形式都做，單位只需要一種，因為「切開」形式的視窗是「連接」形式的子集。
+func NewIndex(units []Unit) *Index {
+	ix := &Index{units: units, win: map[string][]int32{}, eq: map[string][]int32{}}
+	var sc scratch
+	var cur []rune
+	for i, u := range units {
+		id := int32(i)
+		cur = runsOf(unitRunes(u), true, cur, func(run []rune) {
+			switch {
+			case len(run) >= windowChars:
+				sc.windows(run, func(key []byte) { addID(ix.win, key, id) })
+			case len(run) >= minFragChars && memberCount(run) >= minMembers:
+				sc.enc = encodeRunes(sc.enc[:0], run)
+				addID(ix.eq, sc.enc, id)
+			}
+		})
+	}
+	return ix
+}
+
+func addID(m map[string][]int32, key []byte, id int32) {
+	ids := m[string(key)]
+	if n := len(ids); n > 0 && ids[n-1] == id {
+		return
+	}
+	m[string(key)] = append(ids, id)
+}
+
+// Units 回傳索引使用的單位（唯讀）。
+func (ix *Index) Units() []Unit { return ix.units }
+
+// Stats 回傳視窗鍵與整段鍵的數量。
+func (ix *Index) Stats() (windows, exact int) { return len(ix.win), len(ix.eq) }
+
+func encodeRunes(dst []byte, rs []rune) []byte {
+	for _, r := range rs {
+		dst = utf8.AppendRune(dst, r)
+	}
+	return dst
+}
+
+// memberCount 回傳片段內的非標點字數。
+func memberCount(run []rune) int {
+	n := 0
+	for _, r := range run {
+		if r != punctRune {
+			n++
+		}
+	}
+	return n
+}
+
+// windows 對長度 >= windowChars 的片段逐一交出連續 windowChars 個字的視窗（UTF-8 編碼，不得保留）。
+// 非標點字少於 minMembers 的視窗不交出。
+func (sc *scratch) windows(run []rune, fn func(key []byte)) {
+	sc.enc = sc.enc[:0]
+	sc.offs = sc.offs[:0]
+	for _, r := range run {
+		sc.offs = append(sc.offs, len(sc.enc))
+		sc.enc = utf8.AppendRune(sc.enc, r)
+	}
+	sc.offs = append(sc.offs, len(sc.enc))
+	members := 0 // 目前視窗內的非標點字數（滑動計數）
+	for k := 0; k < windowChars-1 && k < len(run); k++ {
+		if run[k] != punctRune {
+			members++
+		}
+	}
+	for k := 0; k+windowChars <= len(run); k++ {
+		if run[k+windowChars-1] != punctRune {
+			members++
+		}
+		if members >= minMembers {
+			fn(sc.enc[sc.offs[k]:sc.offs[k+windowChars]])
+		}
+		if run[k] != punctRune {
+			members--
+		}
+	}
+}
+
+// matchStream 對一條字元串流做兩種形式（連接、切開）的正規化與比對，命中的單位索引加進 hs。
+func (ix *Index) matchStream(rs []rune, sc *scratch, hs *[]int32) {
+	for _, join := range [2]bool{true, false} {
+		sc.cur = runsOf(rs, join, sc.cur, func(run []rune) {
+			switch {
+			case len(run) >= windowChars:
+				if join { // 切開形式的視窗是連接形式的子集，不必重複查
+					sc.windows(run, func(key []byte) {
+						if ids := ix.win[string(key)]; ids != nil {
+							*hs = append(*hs, ids...)
+						}
+					})
+				}
+			case len(run) >= minFragChars && memberCount(run) >= minMembers:
+				sc.enc = encodeRunes(sc.enc[:0], run)
+				if ids := ix.eq[string(sc.enc)]; ids != nil {
+					*hs = append(*hs, ids...)
+				}
+			}
+		})
+	}
+}
+
+// matchBytes 掃一段位元組：位元組形式（兩種對齊），文字檔再加 UTF-8 形式。
+func (ix *Index) matchBytes(b []byte, utf8Form bool, sc *scratch, hs *[]int32) {
+	if !needsDecode(b) {
+		return
+	}
+	if formRaw {
+		ix.matchStream(decodeBig5(b, false), sc, hs)
+		ix.matchStream(decodeBig5(b, true), sc, hs)
+	}
+	if formUTF8 && utf8Form {
+		ix.matchStream(decodeUTF8(b), sc, hs)
+	}
+}
+
+// chunkBytes 是單次解碼的區塊大小：解碼成字元串流的尖峰記憶體約為輸入的 8 倍，大內容分塊處理。
+// 套件變數，測試可縮小。
+var chunkBytes = 8 << 20
+
+// chunkSearch 是找區塊切點時向後搜尋的最大 bytes 數。
+const chunkSearch = 64 << 10
+
+// chunkEnd 回傳 b[off:] 這一塊的結尾。切點選在 ASCII 數字（其次是其他 < 0x40 的 ASCII 位元組）之前：
+// 這些位元組不會是 Big5 雙位元組字的一部分，所以不會把字或對齊切壞，數字也一定切斷片段。
+// 找不到時（搜尋範圍內沒有這類位元組）在原位切開。
+func chunkEnd(b []byte, off int) int {
+	end := off + chunkBytes
+	if end >= len(b) {
+		return len(b)
+	}
+	limit := end + chunkSearch
+	if limit > len(b) {
+		limit = len(b)
+	}
+	other := -1
+	for j := end; j < limit; j++ {
+		switch c := b[j]; {
+		case c >= '0' && c <= '9':
+			return j
+		case c < 0x40 && other < 0:
+			other = j
+		}
+	}
+	if other >= 0 {
+		return other
+	}
+	return end
+}
+
+// matchChunked 把 b 分塊交給 matchBytes。
+func (ix *Index) matchChunked(b []byte, utf8Form bool, sc *scratch, hs *[]int32) {
+	for off := 0; off < len(b); {
+		end := chunkEnd(b, off)
+		ix.matchBytes(b[off:end], utf8Form, sc, hs)
+		off = end
+	}
+}
+
+// formUTF16 控制帶 BOM 的 UTF-16 檔案（Windows 編輯器的「Unicode」存檔）是否解碼比對（供突變驗證切換）。
+// 這類檔案含 NUL，會被當成二進位檔，只比位元組形式，所以另外解碼。沒有 BOM 的 UTF-16 是已知漏報。
+const formUTF16 = true
+
+// matchUTF16 解碼帶 BOM 的 UTF-16（FF FE 小端、FE FF 大端）並比對；沒有 BOM 就什麼都不做。
+// 以偶數位元組為單位分塊（切點可能落在一個字上，影響範圍只有切點附近的一個字）。
+func (ix *Index) matchUTF16(b []byte, sc *scratch, hs *[]int32) {
+	if !formUTF16 || len(b) < 4 {
+		return
+	}
+	var big bool
+	switch {
+	case b[0] == 0xFF && b[1] == 0xFE:
+	case b[0] == 0xFE && b[1] == 0xFF:
+		big = true
+	default:
+		return
+	}
+	b = b[2:]
+	step := chunkBytes &^ 1
+	if step < 2 {
+		step = 2
+	}
+	for off := 0; off+1 < len(b); off += step {
+		end := off + step
+		if end > len(b) {
+			end = len(b)
+		}
+		part := b[off:end]
+		units := make([]uint16, len(part)/2)
+		for i := range units {
+			if big {
+				units[i] = uint16(part[2*i])<<8 | uint16(part[2*i+1])
+			} else {
+				units[i] = uint16(part[2*i+1])<<8 | uint16(part[2*i])
+			}
+		}
+		ix.matchStream(utf16.Decode(units), sc, hs)
+	}
+}
+
+// KeyedUnits 回傳至少有一個查找鍵（視窗或整段）的單位索引，遞增。沒有鍵的單位永遠不會命中。
+func (ix *Index) KeyedUnits() []int {
+	seen := make(map[int32]bool)
+	for _, m := range []map[string][]int32{ix.win, ix.eq} {
+		for _, ids := range m {
+			for _, id := range ids {
+				seen[id] = true
+			}
+		}
+	}
+	out := make([]int, 0, len(seen))
+	for id := range seen {
+		out = append(out, int(id))
+	}
+	sort.Ints(out)
+	return out
+}
+
+// selfCheckSamples 是自檢取樣的單位數上限。
+const selfCheckSamples = 64
+
+// SelfCheck 是索引建好之後的正對照與反對照（偵測器要先證明會報警，AGENTS.md 第 6 節）：
+// 取等間隔的有鍵單位，各以 Big5 位元組與 UTF-8 文字單獨掃描，每個都必須命中自己；純 ASCII 內容必須零命中。
+// 索引沒有任何鍵、或自檢失敗時回錯誤（分類表或 golang.org/x/text 的變動使鍵集合異常時，工具不能安靜地回 0）。
+func (ix *Index) SelfCheck() error {
+	keyed := ix.KeyedUnits()
+	if len(keyed) == 0 || len(ix.win)+len(ix.eq) == 0 {
+		return errors.New("自檢失敗：索引沒有任何查找鍵")
+	}
+	has := func(content []byte, want int) bool {
+		for _, i := range ix.ScanContent(content) {
+			if i == want {
+				return true
+			}
+		}
+		return false
+	}
+	step := len(keyed)/selfCheckSamples + 1
+	for j := 0; j < len(keyed); j += step {
+		i := keyed[j]
+		u := ix.units[i]
+		if !has(u.Big5, i) {
+			return fmt.Errorf("自檢失敗：單位 %s 以位元組自掃沒有命中自己", u.ID)
+		}
+		if u.Text != "" && !has([]byte(u.Text), i) {
+			return fmt.Errorf("自檢失敗：單位 %s 以 UTF-8 文字自掃沒有命中自己", u.ID)
+		}
+	}
+	if hits := ix.ScanContent([]byte("plain ascii text, 100% sure: %s %d ......")); len(hits) != 0 {
+		return errors.New("自檢失敗：純 ASCII 內容不應命中任何單位")
+	}
+	return nil
+}
+
+// needsDecode 回報 b 是否可能含非 ASCII 文字：有高位元組，或有 \uXXXX、\UXXXXXXXX 跳脫（還原後是非 ASCII 字元）。
+// 都沒有的內容（純 ASCII）不可能命中單位，略過解碼。
+func needsDecode(b []byte) bool {
+	for i, c := range b {
+		if c >= 0x80 || c == '\\' && i+1 < len(b) && (b[i+1] == 'u' || b[i+1] == 'U') {
+			return true
+		}
+	}
+	return false
+}
+
+func hasHigh(b []byte) bool {
+	for _, c := range b {
+		if c >= 0x80 {
+			return true
+		}
+	}
+	return false
+}
+
+// ScanContent 掃描一個檔案的內容，回傳命中的單位索引（遞增、不重複）。
+// 含 NUL 的檔案視為二進位檔，只比位元組形式；其他檔案兩種形式都比。
+// 十六進位拼寫（>= 12 個位元組）還原後，兩種形式都比。
+func (ix *Index) ScanContent(content []byte) []int {
+	var hs []int32
+	var sc scratch
+	binary := bytes.IndexByte(content, 0) >= 0
+	ix.matchChunked(content, !binary, &sc, &hs)
+	ix.matchUTF16(content, &sc, &hs)
+	for _, blobs := range [][][]byte{hexBlobs(content, hexMinBytes), escapedHexBlobs(content, hexMinBytes)} {
+		for _, blob := range blobs {
+			ix.matchChunked(blob, true, &sc, &hs)
+		}
+	}
+	if len(hs) == 0 {
+		return nil
+	}
+	sort.Slice(hs, func(i, j int) bool { return hs[i] < hs[j] })
+	out := make([]int, 0, len(hs))
+	for i, v := range hs {
+		if i > 0 && hs[i-1] == v {
+			continue
+		}
+		out = append(out, int(v))
+	}
+	return out
+}
