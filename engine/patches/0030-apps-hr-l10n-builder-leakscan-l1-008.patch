index 0000000..3aca52e
--- /dev/null
+++ b/apps/hr/l10n/budgetadapter_test.go
@@ -0,0 +1,81 @@
+package l10n
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+// 預算套件的接合點：BudgetChecker（只檢查）與 wrapRun（折行加檢查，記錄折完的位元組）。位元組全部自造。
+
+func TestBudgetCheckerConvertsViolations(t *testing.T) {
+	w := newSynthWorld(t)
+	chk := BudgetChecker()
+	orig := w.parsedItem("ESPMES#121.1")
+	good := w.enc("山水火天地")
+	if got := chk("ESPMES.MRG", ClassWin31x4, "ESPMES#121.1", orig, good); len(got) != 0 {
+		t.Errorf("合格的譯文不該有違規：%v", got)
+	}
+	long := w.enc(strings.Repeat("一二三上下", 4)) // 40 bytes，超過行寬 30
+	got := chk("ESPMES.MRG", ClassWin31x4, "ESPMES#121.1", orig, long)
+	if len(got) == 0 || !strings.HasPrefix(got[0], "line-width: ") {
+		t.Errorf("超寬的行應回 line-width 規則鍵：%v", got)
+	}
+	for _, s := range got {
+		if strings.ContainsAny(s, "一二三上下") {
+			t.Errorf("違規字串含譯文：%q", s)
+		}
+	}
+	// 未知的窗口失敗即關閉
+	if got := chk("NOSUCH.MES", "", "NOSUCH.MES#0", nil, good); len(got) != 1 || !strings.Contains(got[0], "unknown-window") {
+		t.Errorf("未知檔案：%v", got)
+	}
+	// SHOPTAB 沒有窗口：略過（名稱欄只受 Adopt 的長度上限約束）
+	if got := chk("SHOPTAB.TBL", "", "SHOPTAB#0.0", nil, good); len(got) != 0 {
+		t.Errorf("SHOPTAB 不經預算檢查：%v", got)
+	}
+	if got := chk("shoptab.tbl", "", "SHOPTAB#0.0", nil, good); len(got) != 0 {
+		t.Errorf("SHOPTAB 檔名大小寫不分：%v", got)
+	}
+}
+
+func TestWrapRunRecordsFinalBytes(t *testing.T) {
+	w := newSynthWorld(t)
+	run := newWrapRun()
+	chk := run.checker()
+	orig := w.parsedItem("ESPMES#121.1")
+
+	short := w.enc("山水火天地")
+	if got := chk("ESPMES.MRG", ClassWin31x4, "ESPMES#121.1", orig, short); len(got) != 0 {
+		t.Fatalf("合格：%v", got)
+	}
+	if !bytes.Equal(run.final["ESPMES#121.1"], short) {
+		t.Error("不需要折行的譯文應原樣記錄")
+	}
+
+	long := w.enc(strings.Repeat("一二三上下", 4))
+	if got := chk("ESPMES.MRG", ClassWin31x4, "ESPMES#121.2", orig, long); len(got) != 0 {
+		t.Fatalf("折行後應合格：%v", got)
+	}
+	fin := run.final["ESPMES#121.2"]
+	if bytes.Equal(fin, long) || !bytes.Equal(bytes.ReplaceAll(fin, []byte{0x0A}, nil), long) {
+		t.Error("折行結果應只比原譯文多 0x0A")
+	}
+	// 無法折進列數預算的譯文：違規（rows）被回報，不重複
+	huge := w.enc(strings.Repeat("大小中國人", 26))
+	got := chk("ESPMES.MRG", ClassWin31x4, "ESPMES#121.3", orig, huge)
+	if len(got) == 0 {
+		t.Fatal("列數過多應回違規")
+	}
+	seen := map[string]bool{}
+	for _, s := range got {
+		if seen[s] {
+			t.Errorf("違規字串重複：%q", s)
+		}
+		seen[s] = true
+	}
+	// SHOPTAB：原樣記錄，不檢查
+	if got := chk("SHOPTAB.TBL", "", "SHOPTAB#0.1", nil, short); len(got) != 0 || !bytes.Equal(run.final["SHOPTAB#0.1"], short) {
+		t.Errorf("SHOPTAB：%v", got)
+	}
+}
diff --git a/apps/hr/l10n/build.go b/apps/hr/l10n/build.go
new file mode 100644
index 0000000..8c65083
--- /dev/null
+++ b/apps/hr/l10n/build.go
@@ -0,0 +1,520 @@
+package l10n
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+)
+
+// 語言包建置器（docs/spec/008 第 3.2、3.3 節）。
+//
+// 語言包是建置產物，位置 `<l10n-packs>/<代碼>-<輸入摘要前 12 碼>/`：
+//
+//	files/<檔名>     LangDir：七個資料檔與 CFONT.15（L1 的 CFONT.15 是原版的逐位元組複本，L2 才換補丁字模）
+//	manifest.json    在 files/ 之外，最後寫
+//
+// 建置輸出完全由輸入摘要決定，所以同名目錄存在且驗證通過就直接使用，不重建。
+
+// l2Supported 表示 L2（字模補丁與自訂字碼）是否已實作。L2 之前，table 模式只支援沿用原版 Big5 碼的 zh-TW
+// （docs/spec/008 第 3.2 節啟用規則 4）。
+const l2Supported = false
+
+const (
+	codeZhTW     = "zh-TW"
+	codeIdentity = "identity"
+	cfontName    = "CFONT.15"
+	// maxPackSlots 是同一個輸入摘要的語言包目錄名額：基底名與 -2 至 -9。
+	maxPackSlots = 9
+	// staleTmpAge 是暫存目錄的過期門檻：修改時間超過它的 `.tmp-*` 在啟動時盡力清掉。
+	staleTmpAge = time.Hour
+	// renameRetries 與 renameRetryDelay：改名失敗而第一個不存在的名額沒變時（不是競爭造成的失敗，例如 Windows
+	// 防毒軟體剛掃過新目錄的暫時性失敗），除了第一次嘗試之外最多再重試 3 次（共 4 次嘗試），每次之前等 50 ms。
+	renameRetries    = 3
+	renameRetryDelay = 50 * time.Millisecond
+)
+
+var codePattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$`)
+
+// Config 是建置的輸入。
+type Config struct {
+	OrigDir  string // 原版目錄
+	TableDir string // 譯文表目錄：直接含 `<資料檔名>.tsv` 的目錄（`l10n/<代碼>`，見 TableDirFor）。只有 table 模式用
+	PackRoot string // 語言包根（`l10n-packs`）
+	Code     string // 代碼。table 模式 L2 之前只認 zh-TW；identity 模式取 zh-TW 或 identity
+	Mode     Mode
+	// Policy 是採用政策。identity 模式不接受任何旗標（identity 不讀譯文表，旗標無意義，拒絕而不是無聲忽略）。
+	Policy Policy
+	// OrigHashes 覆蓋九個原版輸入的預期 SHA-256（測試與工具縫隙，必須含九個輸入）。空值取 required.tsv。
+	OrigHashes map[string]string
+
+	hooks *buildHooks // 測試縫隙
+}
+
+// buildHooks 是測試縫隙。回呼類的縫隙（beforeManifest、beforeRename、afterTableRead、onBuild）最多觸發一次，
+// 所以縫隙內可以再呼叫 Build（把內層的 hooks 清掉即可）；rename 與 sleep 是替身函式，每次嘗試都會呼叫。
+type buildHooks struct {
+	beforeManifest func() error                        // 檔案寫完、manifest 寫入之前；回錯則建置失敗
+	beforeRename   func(tmp, dst string)               // 第一次改名之前
+	afterTableRead func()                              // 譯文表讀入並算完雜湊之後、解析之前（table 模式）
+	onBuild        func()                              // 每次實際建置（算出輸出、寫暫存）觸發一次
+	rename         func(oldpath, newpath string) error // 取代 os.Rename（每次嘗試都呼叫，不限一次）
+	sleep          func(time.Duration)                 // 取代改名重試之間的等待（預設 time.Sleep）
+	keepTmpOnFail  bool                                // 失敗時不清暫存目錄（模擬行程被殺）
+	version        string                              // 覆寫建置器版本
+}
+
+func (c Config) version() string {
+	if c.hooks != nil && c.hooks.version != "" {
+		return c.hooks.version
+	}
+	return Version()
+}
+
+// Validate 檢查設定（代碼、模式與政策旗標的組合）。Build 與 ExpectedDigest 都先呼叫它。
+func (c Config) Validate() error {
+	if !codePattern.MatchString(c.Code) {
+		return fmt.Errorf("l10n: 代碼 %q 不合法（英數字、底線與連字號，最長 32 字）", c.Code)
+	}
+	switch c.Mode {
+	case ModeTable:
+		if c.TableDir == "" {
+			return errors.New("l10n: table 模式需要譯文表目錄")
+		}
+		if c.Code != codeZhTW && !l2Supported {
+			return fmt.Errorf("l10n: table 模式在 L2 之前只支援 %s（沒有字模補丁就沒有其他語言的字碼）", codeZhTW)
+		}
+	case ModeIdentity:
+		if c.Code != codeZhTW && c.Code != codeIdentity {
+			return fmt.Errorf("l10n: identity 模式的代碼只能是 %s 或 %s", codeZhTW, codeIdentity)
+		}
+		if c.Policy != (Policy{}) {
+			return errors.New("l10n: identity 模式不讀譯文表，不接受政策旗標")
+		}
+	default:
+		return fmt.Errorf("l10n: 未知的模式 %q（table 或 identity）", string(c.Mode))
+	}
+	return nil
+}
+
+func (c Config) verifyPolicy() verify.Policy {
+	return verify.Policy{
+		Mode:                string(c.Mode),
+		WithCandidates:      c.Policy.WithCandidates,
+		AllowCountryOffsets: c.Policy.AllowCountryOffsets,
+		AllowShoptab:        c.Policy.AllowShoptab,
+	}
+}
+
+// readTables 讀譯文表目錄內的七個資料檔譯文表（table 模式）；identity 模式不讀任何譯文表，回 nil。
+func (c Config) readTables() (map[string][]byte, error) {
+	if c.Mode == ModeIdentity {
+		return nil, nil
+	}
+	return readTableFiles(c.TableDir)
+}
+
+// tableHash 只讀譯文表目錄算雜湊（ExpectedDigest 用）；identity 與沒有譯文表時是 emptyTableHash。
+func (c Config) tableHash() (string, error) {
+	tables, err := c.readTables()
+	if err != nil {
+		return "", err
+	}
+	return tableHashOf(tables), nil
+}
+
+func (c Config) digest(orig map[string]string, tableHash string) string {
+	return digestOf(digestInput{
+		Version:   c.version(),
+		Orig:      orig,
+		TableHash: tableHash,
+		PatchHash: "",
+		Policy:    c.verifyPolicy(),
+	})
+}
+
+// ExpectedDigest 不建置，算出這份設定的預期輸入摘要（前端用它當 Session.Open 的 LangDigest）。
+// 只讀譯文表目錄（table 模式）；原版輸入雜湊取 required.tsv（或 Config.OrigHashes），不讀原版檔案。
+func ExpectedDigest(cfg Config) (string, error) {
+	if err := cfg.Validate(); err != nil {
+		return "", err
+	}
+	orig, err := expectedInputHashes(cfg.OrigHashes)
+	if err != nil {
+		return "", err
+	}
+	th, err := cfg.tableHash()
+	if err != nil {
+		return "", err
+	}
+	return cfg.digest(orig, th), nil
+}
+
+// PackName 回傳語言包目錄的基底名：`<代碼>-<輸入摘要前 12 碼>`。
+func PackName(code, digest string) string {
+	if len(digest) > 12 {
+		digest = digest[:12]
+	}
+	return code + "-" + digest
+}
+
+// Result 是建置結果。
+type Result struct {
+	Dir            string                // 語言包根（絕對路徑，含 manifest.json）；LangDir 是 Dir 下的 files/
+	Reused         bool                  // 直接用了已存在且驗證通過的目錄（沒有安裝這次的建置）
+	Manifest       *verify.Manifest      // 語言包的 manifest
+	ManifestSHA256 string                // manifest.json 原始位元組的 SHA-256
+	Digest         string                // 輸入摘要
+	Duplicates     map[string][][]string // 各檔「原項目位元組相同」的 id 群組（只列 id）；只在實際建置時填
+}
+
+// FilesDir 回傳語言層目錄（LangDir）。
+func (r *Result) FilesDir() string { return filepath.Join(r.Dir, verify.FilesDir) }
+
+// ViolationsError 是譯文表違規造成的建置失敗：全部違規一起回報，每項點名檔案、項目 id 與規則鍵，不含文句。
+type ViolationsError struct{ Items []string }
+
+func (e *ViolationsError) Error() string {
+	return fmt.Sprintf("l10n: 譯文表有 %d 項違規：\n  %s", len(e.Items), strings.Join(e.Items, "\n  "))
+}
+
+// ErrSerialExhausted：基底名與 -2 至 -9 都已存在，且沒有一個驗證通過。
+var ErrSerialExhausted = errors.New("l10n: 語言包目錄的序號用盡（基底名與 -2 至 -9 都已存在且驗證失敗），遊戲內文字維持原版")
+
+// slotName 回傳第 i 個名額的目錄名：0 是基底名，其餘是 `<基底名>-<i+1>`。
+func slotName(base string, i int) string {
+	if i == 0 {
+		return base
+	}
+	return base + "-" + strconv.Itoa(i+1)
+}
+
+// Build 建置語言包（或重用已驗證通過的同名目錄）。步驟（spec 第 3.2 節）：
+//
+//  1. 讀九個原版輸入並核對 SHA-256（缺或不符即失敗，不猜測套用）；
+//  2. 算輸入摘要與目錄名；啟動時盡力清掉過期的 `.tmp-*`；
+//  3. 依序探測基底名與 -2 至 -9，第一個驗證通過者直接使用（Reused）；
+//  4. 否則算出輸出（解析、採用譯文、預算檢查加折行、序列化），寫到同層暫存目錄，manifest 最後寫，
+//     `os.Rename` 到第一個不存在的名稱；改名失敗時回到「已存在」分支重驗，驗證失敗不搬動也不刪除舊目錄。
+//
+// 不刪任何 `<代碼>-…` 目錄，也不覆寫已存在的目錄。
+func Build(cfg Config) (*Result, error) {
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+	if cfg.PackRoot == "" {
+		return nil, errors.New("l10n: 缺語言包根目錄")
+	}
+	h := cfg.hooks
+	if h == nil {
+		h = &buildHooks{}
+	}
+
+	// 1. 原版輸入
+	want, err := expectedInputHashes(cfg.OrigHashes)
+	if err != nil {
+		return nil, err
+	}
+	inputs, err := readOrigInputs(cfg.OrigDir)
+	if err != nil {
+		return nil, err
+	}
+	var bad []string
+	for _, n := range verify.InputNames() {
+		if sha256Hex(inputs[n]) != want[n] {
+			bad = append(bad, n)
+		}
+	}
+	if len(bad) > 0 {
+		return nil, fmt.Errorf("l10n: 原版輸入的 SHA-256 與清單不符（%s），不猜測套用", strings.Join(bad, "、"))
+	}
+
+	// 2. 摘要與目錄。譯文表只讀這一次：雜湊、解析共用同一份位元組，manifest 記的 table_hash 與包內容必定是同一份輸入。
+	tables, err := cfg.readTables()
+	if err != nil {
+		return nil, err
+	}
+	th := tableHashOf(tables)
+	if h.afterTableRead != nil {
+		h.afterTableRead()
+	}
+	digest := cfg.digest(want, th)
+	base := PackName(cfg.Code, digest)
+	root, err := verify.NormalizeDir(cfg.PackRoot)
+	if err != nil {
+		return nil, fmt.Errorf("l10n: 語言包根目錄：%w", err)
+	}
+	if err := os.MkdirAll(root, 0o755); err != nil {
+		return nil, fmt.Errorf("l10n: 建立語言包根目錄：%w", err)
+	}
+	sweepStaleTmp(root, time.Now())
+
+	vopt := verify.Options{OrigHashes: want, ExpectDigest: digest}
+	valid := func(dir string) *verify.Manifest {
+		m, err := verify.Verify(dir, vopt)
+		if err != nil || m.Code != cfg.Code {
+			return nil
+		}
+		return m
+	}
+	reuse := func(i int, m *verify.Manifest) (*Result, error) {
+		dir := filepath.Join(root, slotName(base, i))
+		sum, err := verify.ManifestSHA256(dir)
+		if err != nil {
+			return nil, fmt.Errorf("l10n: 讀 manifest：%w", err)
+		}
+		return &Result{Dir: dir, Reused: true, Manifest: m, ManifestSHA256: sum, Digest: digest}, nil
+	}
+	// probe 依序探測名額：第一個驗證通過者回傳 (名額, manifest)；沒有通過者回傳第一個不存在的名額（-1 表示沒有）。
+	probe := func() (validIdx int, m *verify.Manifest, free int) {
+		free = -1
+		for i := 0; i < maxPackSlots; i++ {
+			p := filepath.Join(root, slotName(base, i))
+			if _, err := os.Lstat(p); err != nil {
+				if free < 0 && errors.Is(err, fs.ErrNotExist) {
+					free = i
+				}
+				continue
+			}
+			if m := valid(p); m != nil {
+				return i, m, free
+			}
+		}
+		return -1, nil, free
+	}
+
+	// 3. 探測
+	vi, vm, free := probe()
+	if vi >= 0 {
+		return reuse(vi, vm)
+	}
+	if free < 0 {
+		return nil, ErrSerialExhausted
+	}
+
+	// 4. 建置
+	outs, adopted, dups, err := cfg.render(inputs, tables)
+	if err != nil {
+		return nil, err
+	}
+	if h.onBuild != nil {
+		h.onBuild()
+	}
+	m := &verify.Manifest{
+		Format:         verify.ManifestFormat,
+		Code:           cfg.Code,
+		Policy:         cfg.verifyPolicy(),
+		OrigInputs:     copyMap(want),
+		TableHash:      th,
+		TableFormat:    TableFormat,
+		PatchHash:      "",
+		BuilderVersion: cfg.version(),
+		InputDigest:    digest,
+		Adopted:        adopted,
+	}
+	names := make([]string, 0, len(outs))
+	for n := range outs {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	for _, n := range names {
+		m.Files = append(m.Files, verify.FileEntry{Name: n, SHA256: sha256Hex(outs[n]), Size: int64(len(outs[n]))})
+	}
+	tmp, err := os.MkdirTemp(root, fmt.Sprintf(".tmp-%s-%d-", slotName(base, free), os.Getpid()))
+	if err != nil {
+		return nil, fmt.Errorf("l10n: 建立暫存目錄：%w", err)
+	}
+	discard := func() {
+		if !h.keepTmpOnFail {
+			_ = os.RemoveAll(tmp)
+		}
+	}
+	if err := writePack(tmp, outs, m, h); err != nil {
+		discard()
+		return nil, err
+	}
+
+	// 改名到位。失敗時回到「已存在」分支重驗；驗證失敗不搬動舊目錄，改用下一個不存在的名額。
+	// 第一個不存在的名額沒變，代表失敗不是競爭造成的（目的地沒有任何人占用）：可能是權限，也可能是 Windows
+	// 防毒軟體剛掃過新目錄的暫時性失敗，所以對同一個名額重試 renameRetries 次再回錯。
+	rename, sleep := os.Rename, time.Sleep
+	if h.rename != nil {
+		rename = h.rename
+	}
+	if h.sleep != nil {
+		sleep = h.sleep
+	}
+	dst := filepath.Join(root, slotName(base, free))
+	first := true
+	retried := 0 // 目前這個名額已重試的次數
+	for tries := 0; ; tries++ {
+		if first && h.beforeRename != nil {
+			h.beforeRename(tmp, dst)
+		}
+		first = false
+		rerr := rename(tmp, dst)
+		if rerr == nil {
+			sum, err := verify.ManifestSHA256(dst)
+			if err != nil {
+				return nil, fmt.Errorf("l10n: 讀 manifest：%w", err)
+			}
+			return &Result{Dir: dst, Manifest: m, ManifestSHA256: sum, Digest: digest, Duplicates: dups}, nil
+		}
+		vi, vm, free2 := probe()
+		if vi >= 0 {
+			discard()
+			return reuse(vi, vm)
+		}
+		if free2 < 0 {
+			discard()
+			return nil, ErrSerialExhausted
+		}
+		next := filepath.Join(root, slotName(base, free2))
+		if next == dst && retried < renameRetries {
+			retried++
+			sleep(renameRetryDelay)
+			continue
+		}
+		if next == dst || tries >= 2*maxPackSlots {
+			discard()
+			return nil, fmt.Errorf("l10n: 改名到 %s 失敗：%w", filepath.Base(dst), rerr)
+		}
+		dst, retried = next, 0
+	}
+}
+
+func copyMap(m map[string]string) map[string]string {
+	out := make(map[string]string, len(m))
+	for k, v := range m {
+		out[k] = v
+	}
+	return out
+}
+
+// writePack 把輸出寫進暫存目錄 tmp：先寫 files/ 內的檔案，manifest.json 最後寫。
+func writePack(tmp string, outs map[string][]byte, m *verify.Manifest, h *buildHooks) error {
+	if err := os.Chmod(tmp, 0o755); err != nil {
+		return fmt.Errorf("l10n: 暫存目錄權限：%w", err)
+	}
+	filesDir := filepath.Join(tmp, verify.FilesDir)
+	if err := os.Mkdir(filesDir, 0o755); err != nil {
+		return fmt.Errorf("l10n: 建立 files/：%w", err)
+	}
+	for _, fe := range m.Files {
+		if err := os.WriteFile(filepath.Join(filesDir, fe.Name), outs[fe.Name], 0o644); err != nil {
+			return fmt.Errorf("l10n: 寫 %s：%w", fe.Name, err)
+		}
+	}
+	if h.beforeManifest != nil {
+		if err := h.beforeManifest(); err != nil {
+			return err
+		}
+	}
+	raw, err := m.Marshal()
+	if err != nil {
+		return fmt.Errorf("l10n: 序列化 manifest：%w", err)
+	}
+	if err := os.WriteFile(filepath.Join(tmp, verify.ManifestName), raw, 0o644); err != nil {
+		return fmt.Errorf("l10n: 寫 manifest.json：%w", err)
+	}
+	return nil
+}
+
+// sweepStaleTmp 盡力清掉過期的暫存目錄：名稱以 `.tmp-` 開頭、修改時間距 now 超過 staleTmpAge。
+// 只刪暫存項目，絕不刪 `<代碼>-…` 語言包目錄（沒有可靠方法判斷它是否正被其他執行個體使用）。
+// 刪不掉（例如 Windows 檔案被占用）就忽略。
+func sweepStaleTmp(root string, now time.Time) {
+	ents, err := os.ReadDir(root)
+	if err != nil {
+		return
+	}
+	for _, e := range ents {
+		if !strings.HasPrefix(e.Name(), ".tmp-") {
+			continue
+		}
+		info, err := e.Info()
+		if err != nil || now.Sub(info.ModTime()) <= staleTmpAge {
+			continue
+		}
+		_ = os.RemoveAll(filepath.Join(root, e.Name()))
+	}
+}
+
+// render 算出語言包 files/ 的全部輸出（不碰磁碟）：解析七個資料檔，table 模式依譯文表採用譯文
+// （編碼、折行、預算檢查，違規全部收集後失敗），序列化；CFONT.15 是原版的逐位元組複本（L2 才換補丁字模）。
+// 回傳輸出、採用列數與各檔「原項目位元組相同」的 id 群組。tables 是 readTables 讀入的譯文表位元組
+// （大寫資料檔名為鍵，identity 模式為 nil）；render 不再碰磁碟上的譯文表。
+func (c Config) render(inputs, tables map[string][]byte) (outs map[string][]byte, adopted int, dups map[string][][]string, err error) {
+	var cs *Charmap
+	if c.Mode == ModeTable {
+		if cs, err = LoadCharmap(); err != nil {
+			return nil, 0, nil, err
+		}
+	}
+	outs = make(map[string][]byte, len(dataFileNames)+1)
+	dups = make(map[string][][]string)
+	var violations []string
+	for _, name := range dataFileNames {
+		data := inputs[name]
+		f, perr := Parse(name, data)
+		if perr != nil {
+			return nil, 0, nil, perr
+		}
+		if g := f.DuplicateGroups(); len(g) > 0 {
+			dups[name] = g
+		}
+		var repl map[string][]byte
+		if tb, ok := tables[name]; ok {
+			tbl, terr := LoadTable(bytes.NewReader(tb))
+			if terr != nil {
+				return nil, 0, nil, fmt.Errorf("l10n: %s.tsv：%w", name, terr)
+			}
+			prefix := f.idPrefix() + "#"
+			for _, row := range tbl.Rows {
+				if !strings.HasPrefix(row.ID, prefix) {
+					violations = append(violations, fmt.Sprintf("%s: %s: id 不屬於這個檔案的譯文表", name, row.ID))
+				}
+			}
+			run := newWrapRun()
+			r, n, vs, aerr := tbl.Adopt(f, c.Policy, cs, run.checker())
+			if aerr != nil {
+				return nil, 0, nil, aerr
+			}
+			violations = append(violations, vs...)
+			if len(vs) == 0 {
+				// 寫進檔案的位元組要是通過 Check 的那一份（折行之後的結果）。
+				for id := range r {
+					b, ok := run.final[id]
+					if !ok {
+						return nil, 0, nil, fmt.Errorf("l10n: 內部錯誤：%s 沒有折行結果", id)
+					}
+					r[id] = b
+				}
+				repl = r
+				adopted += n
+			}
+		}
+		b, serr := f.Serialize(repl, SerializeOptions{ExactCountryOffsets: c.Policy.AllowCountryOffsets})
+		if serr != nil {
+			return nil, 0, nil, serr
+		}
+		if len(repl) == 0 && !bytes.Equal(b, data) {
+			return nil, 0, nil, fmt.Errorf("l10n: %s 沒有譯文卻往返不符（解析器與序列化器不一致），拒絕建置", name)
+		}
+		outs[name] = b
+	}
+	if len(violations) > 0 {
+		return nil, 0, nil, &ViolationsError{Items: violations}
+	}
+	outs[cfontName] = bytes.Clone(inputs[cfontName])
+	return outs, adopted, dups, nil
+}
diff --git a/apps/hr/l10n/build_helpers_test.go b/apps/hr/l10n/build_helpers_test.go
new file mode 100644
index 0000000..56ec4b1
--- /dev/null
+++ b/apps/hr/l10n/build_helpers_test.go
@@ -0,0 +1,240 @@
+package l10n
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+)
+
+// 建置器測試的合成世界：九個「原版輸入」由測試自造（位元組是自造的，字取自字集內的字 一二三上下大小中國人天地水火山無有不），
+// 不含任何原版文字；雜湊以 Config.OrigHashes 傳入，所以不需要原版。
+
+// synthWorld 是一組合成的原版輸入。
+type synthWorld struct {
+	t      *testing.T
+	cs     *Charmap
+	orig   string // 原版目錄
+	files  map[string][]byte
+	hashes map[string]string
+	parsed map[string]*File
+}
+
+func newSynthWorld(t *testing.T) *synthWorld {
+	t.Helper()
+	w := &synthWorld{
+		t: t, cs: mustCharmap(t), orig: t.TempDir(),
+		files: map[string][]byte{}, hashes: map[string]string{}, parsed: map[string]*File{},
+	}
+	b := func(s string) string { return string(w.enc(s)) }
+	w.files["COUNTRY.MES"] = buildMES([]string{b("一二三上下大小中國人天地水火山無有不"), b("山水火"), b("無有不一二三上下")}, 2)
+	w.files["SP.MES"] = buildMES([]string{b("一二三"), b("上下大小中國") + "\n" + b("人天"), b("人天地水火山無有不")}, 0)
+	w.files["SYSTEM.MES"] = buildMES([]string{b("一二") + "%s" + b("三"), b("上下大小中國"), b("人天地水火山")}, 0)
+	dup := b("山水火天地人")
+	w.files["UWASA.MES"] = buildMES([]string{dup, dup, dup, b("無有不一二三")}, 0)
+	w.files["POWERMES.MES"] = buildMES([]string{b("一二三上下大小中國人天地水火山"), b("無有不")}, 0)
+	w.files["ESPMES.MRG"] = buildESP(125, map[int][]string{
+		44:  {b("一二三"), b("上下大小中國人天地水火山"), b("山水火天地人無有不")},
+		121: {b("一二三上下"), b("大小中國人天地水火山"), b("無有不一二三上下大小"), b("天地")},
+	})
+	w.files["SHOPTAB.TBL"] = buildShop(1, []string{
+		b("一二三上下"), b("大小中國人"), b("天地水火山"), b("無有不一二"), b("三上下大小"), b("中國人天地"), b("水火山無有"), b("不一二三上"),
+	})
+	w.files["MAIN.EXE"] = bytes.Repeat([]byte("synthetic main exe "), 40)
+	w.files["CFONT.15"] = bytes.Repeat([]byte{0x00, 0x7E, 0xA5, 0xFF}, 300)
+	for _, n := range verify.InputNames() {
+		if err := os.WriteFile(filepath.Join(w.orig, n), w.files[n], 0o644); err != nil {
+			t.Fatal(err)
+		}
+		w.hashes[n] = sha256Hex(w.files[n])
+	}
+	for _, n := range dataFileNames {
+		w.parsed[n] = mustParse(t, n, w.files[n])
+	}
+	return w
+}
+
+// enc 把 UTF-8 轉成編碼位元組（字集內的字，`%s` 原樣）。
+func (w *synthWorld) enc(s string) []byte {
+	w.t.Helper()
+	out, _, err := w.cs.Encode(s)
+	if err != nil {
+		w.t.Fatalf("合成輸入編碼失敗：%v", err)
+	}
+	return out
+}
+
+// cfg 回傳指向合成世界的設定。
+func (w *synthWorld) cfg(packRoot, tableDir string, mode Mode, p Policy) Config {
+	return Config{OrigDir: w.orig, TableDir: tableDir, PackRoot: packRoot, Code: "zh-TW", Mode: mode, Policy: p, OrigHashes: w.hashes}
+}
+
+// dataFileOfID 取譯文表 id 所屬的資料檔名。
+func dataFileOfID(id string) string {
+	p, _, _ := strings.Cut(id, "#")
+	switch p {
+	case "ESPMES":
+		return "ESPMES.MRG"
+	case "SHOPTAB":
+		return "SHOPTAB.TBL"
+	}
+	return p
+}
+
+// row 造一列譯文表（src_sha256 取自合成原項目；accepted 列帶 acc_sha）。
+func (w *synthWorld) row(id, text, status string) Row {
+	w.t.Helper()
+	f := w.parsed[dataFileOfID(id)]
+	if f == nil {
+		w.t.Fatalf("id %s 沒有對應的資料檔", id)
+	}
+	it, ok := f.Lookup(id)
+	if !ok {
+		w.t.Fatalf("合成原版沒有項目 %s", id)
+	}
+	r := Row{ID: id, SrcSHA: SrcSHA(it.Orig), Text: text, Status: status, By: "synthetic", Batch: "synthetic", Date: "2026-10-04"}
+	if status == StatusAccepted {
+		r.AccSHA = AccSHA(text)
+	}
+	return r
+}
+
+// writeTable 把列依資料檔分組，寫成 dir 內的 `<資料檔名>.tsv`。
+func (w *synthWorld) writeTable(dir string, rows ...Row) {
+	w.t.Helper()
+	by := map[string]*Table{}
+	for _, r := range rows {
+		n := dataFileOfID(r.ID)
+		if by[n] == nil {
+			by[n] = &Table{}
+		}
+		by[n].Rows = append(by[n].Rows, r)
+	}
+	for n, tbl := range by {
+		var sb strings.Builder
+		if err := tbl.Save(&sb); err != nil {
+			w.t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, n+".tsv"), []byte(sb.String()), 0o644); err != nil {
+			w.t.Fatal(err)
+		}
+	}
+}
+
+// tableDir 建一個含給定列的譯文表目錄。
+func (w *synthWorld) tableDir(rows ...Row) string {
+	w.t.Helper()
+	d := filepath.Join(w.t.TempDir(), "zh-TW")
+	if err := os.MkdirAll(d, 0o755); err != nil {
+		w.t.Fatal(err)
+	}
+	w.writeTable(d, rows...)
+	return d
+}
+
+// standardRows 是一組通過預算檢查的列：三個 accepted、一個 candidate、一個 keep。
+func (w *synthWorld) standardRows() []Row {
+	return []Row{
+		w.row("SP.MES#0", "上下大小", StatusAccepted),
+		w.row("SP.MES#1", "山水火天地人", StatusCandidate),
+		w.row("SYSTEM.MES#0", "天地%s水火", StatusAccepted),
+		w.row("SYSTEM.MES#1", "", StatusKeep),
+		w.row("ESPMES#121.0", "中國人天地水火山", StatusAccepted),
+	}
+}
+
+// packFile 讀語言包 files/ 內的檔案。
+func packFile(t testing.TB, dir, name string) []byte {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join(dir, verify.FilesDir, name))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+// mustBuild 建置並要求成功。
+func mustBuild(t testing.TB, cfg Config) *Result {
+	t.Helper()
+	res, err := Build(cfg)
+	if err != nil {
+		t.Fatalf("Build：%v", err)
+	}
+	return res
+}
+
+// packEntries 列出語言包根下的項目名（排序）。
+func packEntries(t testing.TB, root string) []string {
+	t.Helper()
+	ents, err := os.ReadDir(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out []string
+	for _, e := range ents {
+		out = append(out, e.Name())
+	}
+	sort.Strings(out)
+	return out
+}
+
+// finalPacks 列出語言包根下的語言包目錄名（排除暫存目錄）。
+func finalPacks(t testing.TB, root string) []string {
+	t.Helper()
+	var out []string
+	for _, n := range packEntries(t, root) {
+		if !strings.HasPrefix(n, ".tmp-") {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// tmpEntries 列出語言包根下的暫存目錄名。
+func tmpEntries(t testing.TB, root string) []string {
+	t.Helper()
+	var out []string
+	for _, n := range packEntries(t, root) {
+		if strings.HasPrefix(n, ".tmp-") {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// verifyPack 以 w 的原版雜湊與給定預期摘要驗證語言包根。
+func (w *synthWorld) verifyPack(dir, digest string) error {
+	_, err := verify.Verify(dir, verify.Options{OrigHashes: w.hashes, ExpectDigest: digest})
+	return err
+}
+
+// setShopNames 以給定的名稱（編碼後的位元組字串，可含 `%s` 之類的轉換規格）重寫合成世界的 SHOPTAB.TBL，
+// 原版檔、雜湊與解析結果一併更新。只能在建置之前呼叫。
+func (w *synthWorld) setShopNames(names ...string) {
+	w.t.Helper()
+	data := buildShop(1, names)
+	if err := os.WriteFile(filepath.Join(w.orig, "SHOPTAB.TBL"), data, 0o644); err != nil {
+		w.t.Fatal(err)
+	}
+	w.files["SHOPTAB.TBL"] = data
+	w.hashes["SHOPTAB.TBL"] = sha256Hex(data)
+	w.parsed["SHOPTAB.TBL"] = mustParse(w.t, "SHOPTAB.TBL", data)
+}
+
+// corruptPack 竄改語言包 files/ 內第一個檔案的一個位元組（用在「已存在但驗證失敗」的案例）。
+func corruptPack(t testing.TB, dir string) {
+	t.Helper()
+	p := filepath.Join(dir, verify.FilesDir, "SP.MES")
+	b, err := os.ReadFile(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b[len(b)/2] ^= 0xFF
+	if err := os.WriteFile(p, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/apps/hr/l10n/build_pack_test.go b/apps/hr/l10n/build_pack_test.go
new file mode 100644
index 0000000..cbba807
--- /dev/null
+++ b/apps/hr/l10n/build_pack_test.go
@@ -0,0 +1,1024 @@
+package l10n
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+)
+
+// 語言包目錄的建置、原子性、重用、序號與清理（docs/spec/008 第 3.2 節、第 8 節建置原子性列）。合成世界，不需要原版。
+
+// poolCfg 是這組測試共用的設定：table 模式、含 candidate 列的 fixture 譯文表。
+func poolCfg(w *synthWorld, root string) Config {
+	return w.cfg(root, w.tableDir(w.standardRows()...), ModeTable, Policy{})
+}
+
+// listFiles 讀語言包根的 manifest 與 files/ 內全部檔案，鍵 `manifest` 與 `files/<檔名>`。
+func listFiles(t *testing.T, dir string) map[string][]byte {
+	t.Helper()
+	out := map[string][]byte{}
+	raw, err := os.ReadFile(filepath.Join(dir, verify.ManifestName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	out["manifest"] = raw
+	ents, err := os.ReadDir(filepath.Join(dir, verify.FilesDir))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range ents {
+		out["files/"+e.Name()] = packFile(t, dir, e.Name())
+	}
+	return out
+}
+
+// 同輸入重複建置至少 20 次：manifest 與所有檔案逐位元組相同，目錄名相同。
+func TestBuildRepeatable(t *testing.T) {
+	w := newSynthWorld(t)
+	td := w.tableDir(append(w.standardRows(), w.row("UWASA.MES#0", "山水火", StatusAccepted), w.row("UWASA.MES#1", "山水火", StatusAccepted), w.row("UWASA.MES#2", "山水火", StatusAccepted))...)
+	for _, mode := range []Mode{ModeTable, ModeIdentity} {
+		var ref map[string][]byte
+		var refName string
+		for i := 0; i < 20; i++ {
+			res := mustBuild(t, w.cfg(t.TempDir(), td, mode, Policy{}))
+			got := listFiles(t, res.Dir)
+			if i == 0 {
+				ref, refName = got, filepath.Base(res.Dir)
+				continue
+			}
+			if filepath.Base(res.Dir) != refName || len(got) != len(ref) {
+				t.Fatalf("%s 第 %d 次：目錄名或檔案數不同", mode, i)
+			}
+			for k, v := range ref {
+				if !bytes.Equal(got[k], v) {
+					t.Fatalf("%s 第 %d 次：%s 與第一次不同", mode, i, k)
+				}
+			}
+		}
+	}
+}
+
+// 同名目錄驗證通過就不重建：以包根（files/ 之外）的哨兵檔斷言，不用修改時間。
+func TestBuildReusesValidPack(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	cfg := poolCfg(w, root)
+	built := 0
+	cfg.hooks = &buildHooks{onBuild: func() { built++ }}
+	r1 := mustBuild(t, cfg)
+	if r1.Reused || built != 1 {
+		t.Fatalf("第一次：Reused=%v built=%d", r1.Reused, built)
+	}
+	sentinel := filepath.Join(r1.Dir, "sentinel.txt")
+	if err := os.WriteFile(sentinel, []byte("keep me"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	r2 := mustBuild(t, cfg)
+	if !r2.Reused || r2.Dir != r1.Dir || built != 1 {
+		t.Errorf("第二次應重用：Reused=%v dir 相同=%v built=%d", r2.Reused, r2.Dir == r1.Dir, built)
+	}
+	if b, err := os.ReadFile(sentinel); err != nil || string(b) != "keep me" {
+		t.Errorf("哨兵檔消失（目錄被重建了）：%v", err)
+	}
+	if r2.ManifestSHA256 != r1.ManifestSHA256 || r2.Manifest.Adopted != r1.Manifest.Adopted {
+		t.Error("重用的結果與第一次不同")
+	}
+	if got := finalPacks(t, root); len(got) != 1 {
+		t.Errorf("包根下有 %v", got)
+	}
+}
+
+// manifest 寫入前注入失敗：不留下可通過驗證的包，也不留下語言包目錄；
+// 行程被殺（暫存目錄殘留）時，殘留的目錄沒有 manifest.json，驗證必須拒絕。
+func TestBuildAtomicBeforeManifest(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	cfg := poolCfg(w, root)
+	boom := errors.New("injected failure")
+	cfg.hooks = &buildHooks{beforeManifest: func() error { return boom }}
+	if _, err := Build(cfg); !errors.Is(err, boom) {
+		t.Fatalf("應回注入的錯誤：%v", err)
+	}
+	if got := packEntries(t, root); len(got) != 0 {
+		t.Errorf("注入失敗後包根下有 %v", got)
+	}
+
+	cfg.hooks = &buildHooks{beforeManifest: func() error { return boom }, keepTmpOnFail: true}
+	if _, err := Build(cfg); !errors.Is(err, boom) {
+		t.Fatalf("應回注入的錯誤：%v", err)
+	}
+	if got := finalPacks(t, root); len(got) != 0 {
+		t.Errorf("注入失敗後不該有語言包目錄：%v", got)
+	}
+	tmps := tmpEntries(t, root)
+	if len(tmps) != 1 {
+		t.Fatalf("應殘留一個暫存目錄：%v", tmps)
+	}
+	d, err := ExpectedDigest(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = w.verifyPack(filepath.Join(root, tmps[0]), d)
+	if !verify.IsCode(err, verify.CodeNoManifest) {
+		t.Errorf("殘留的半成品必須被驗證拒絕（no-manifest），實際 %v", err)
+	}
+	// 殘留的暫存目錄（新的）不影響下一次建置，也不被當成語言包。
+	cfg.hooks = nil
+	res := mustBuild(t, cfg)
+	if res.Reused || w.verifyPack(res.Dir, d) != nil {
+		t.Error("殘留之後的正常建置失敗")
+	}
+	if got := tmpEntries(t, root); len(got) != 1 {
+		t.Errorf("新的暫存目錄應原樣留下：%v", got)
+	}
+}
