+package leakscan
+
+import "testing"
+
+// 全單位自我回收：每個有查找鍵的單位，以它的 Big5 位元組與 UTF-8 文字各單獨掃一次，都必須命中自己。
+// 這一次檢查單位端與掃描端的正規化是否對稱，涵蓋含標點、引號、全形英數的真實單位。
+func TestSelfRecovery(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		keyed := w.ix.KeyedUnits()
+		if len(keyed) == 0 {
+			t.Fatal("沒有有鍵的單位")
+		}
+		bad := 0
+		for _, i := range keyed {
+			u := w.units[i]
+			hit := func(content []byte) bool {
+				for _, h := range w.ix.ScanContent(content) {
+					if h == i {
+						return true
+					}
+				}
+				return false
+			}
+			if !hit(u.Big5) {
+				bad++
+				if bad <= 10 {
+					t.Errorf("%s：以位元組自掃沒有命中自己", u.ID)
+				}
+			}
+			if u.Text != "" && !hit([]byte(u.Text)) {
+				bad++
+				if bad <= 10 {
+					t.Errorf("%s：以 UTF-8 文字自掃沒有命中自己", u.ID)
+				}
+			}
+		}
+		if bad > 0 {
+			t.Errorf("%s：%d 個失敗（共 %d 個有鍵的單位）", w.name, bad, len(keyed))
+		}
+		t.Logf("%s：%d 個有鍵的單位（共 %d 個），全部以位元組與文字自掃命中自己", w.name, len(keyed), len(w.units))
+	})
+}
diff --git a/apps/hr/l10n/leakscan/scan.go b/apps/hr/l10n/leakscan/scan.go
new file mode 100644
index 0000000..bcb30a9
--- /dev/null
+++ b/apps/hr/l10n/leakscan/scan.go
@@ -0,0 +1,311 @@
+package leakscan
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// DataFiles 是單位的主要來源：原版的七個資料檔（不含 CFONT.15：點陣字模沒有文字，對齊解碼只會得到偶然成立的片段）。
+var DataFiles = []string{"COUNTRY.MES", "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES", "ESPMES.MRG", "SHOPTAB.TBL"}
+
+// TextFiles 是純 Big5 文字檔（片頭文字），抽取規則與資料檔相同；單位身分的檔名欄用實際檔名。
+var TextFiles = []string{"OP.TXT", "OP0.TXT", "OP1.TXT", "OP2.TXT", "OP3.TXT", "OP4.TXT", "OP5.TXT"}
+
+// SourceFiles 是全部的單位來源，缺任何一個都使閘門失敗。
+var SourceFiles = append(append([]string{}, DataFiles...), TextFiles...)
+
+// LoadOrig 讀入原版目錄的單位來源檔（檔名大小寫不拘）。缺任何一個就回錯誤：閘門失敗關閉，不略過。
+func LoadOrig(dir string) (map[string][]byte, error) {
+	ents, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, fmt.Errorf("原版目錄無法讀取：%w", err)
+	}
+	actual := make(map[string]string, len(ents))
+	for _, e := range ents {
+		if !e.IsDir() {
+			actual[strings.ToUpper(e.Name())] = e.Name()
+		}
+	}
+	files := make(map[string][]byte, len(SourceFiles))
+	var missing []string
+	for _, want := range SourceFiles {
+		name, ok := actual[want]
+		if !ok {
+			missing = append(missing, want)
+			continue
+		}
+		b, err := os.ReadFile(filepath.Join(dir, name))
+		if err != nil {
+			return nil, fmt.Errorf("讀取 %s 失敗：%w", want, err)
+		}
+		files[want] = b
+	}
+	if len(missing) > 0 {
+		return nil, fmt.Errorf("原版目錄缺資料檔：%s", strings.Join(missing, "、"))
+	}
+	return files, nil
+}
+
+// Hit 是一筆命中。Commit 只在歷史模式有值。內容不在輸出內。
+type Hit struct {
+	Commit string
+	Path   string
+	UnitID string
+}
+
+// ListOptions 是 FileList 的選項。
+type ListOptions struct {
+	From        string // -files-from：每行一個路徑；"-" 讀標準輸入
+	From0       string // -files-from0：以 NUL 分隔（對應 git ls-files -z）；"-" 讀標準輸入
+	SkipMissing bool   // 清單內不存在的項目是否略過（預設是錯誤）
+}
+
+// ListResult 是 FileList 的結果。
+type ListResult struct {
+	Files   []string // 排序、去重
+	Skipped int      // 略過的非一般檔案（目錄內的符號連結、清單內的符號連結與目錄）
+	Missing int      // 清單內不存在而略過的項目數（只有 SkipMissing 時才會是非零）
+}
+
+// maxMissingShown 是錯誤訊息中最多列出的不存在路徑數。
+const maxMissingShown = 10
+
+// FileList 收集要掃的檔案：目錄遞迴（略過 .git 目錄與非一般檔案），檔案直接收；結果排序、去重。
+//
+// 閘門失敗關閉：位置參數不存在或是符號連結、清單項目不存在（沒有 SkipMissing）、清單行以引號開頭
+// （git 在預設 core.quotepath 下對含非 ASCII 的路徑加引號，會被誤當成不存在）、清單檔無法讀取，都回錯誤。
+func FileList(args []string, opt ListOptions, stdin io.Reader) (ListResult, error) {
+	var res ListResult
+	seen := map[string]bool{}
+	add := func(p string) {
+		p = CleanPath(p)
+		if !seen[p] {
+			seen[p] = true
+			res.Files = append(res.Files, p)
+		}
+	}
+	for _, a := range args {
+		st, err := os.Lstat(a)
+		if err != nil {
+			return res, err
+		}
+		if st.Mode()&fs.ModeSymlink != 0 {
+			return res, fmt.Errorf("位置參數 %s 是符號連結：請給實際的檔案或目錄", a)
+		}
+		if !st.IsDir() {
+			if !st.Mode().IsRegular() {
+				return res, fmt.Errorf("位置參數 %s 不是一般檔案或目錄", a)
+			}
+			add(a)
+			continue
+		}
+		err = filepath.WalkDir(a, func(p string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return err
+			}
+			switch {
+			case d.IsDir():
+				if d.Name() == ".git" {
+					return filepath.SkipDir
+				}
+			case d.Type().IsRegular():
+				add(p)
+			default:
+				res.Skipped++
+			}
+			return nil
+		})
+		if err != nil {
+			return res, err
+		}
+	}
+	for _, src := range []struct {
+		path string
+		nul  bool
+	}{{opt.From, false}, {opt.From0, true}} {
+		if src.path == "" {
+			continue
+		}
+		entries, err := readList(src.path, src.nul, stdin)
+		if err != nil {
+			return res, err
+		}
+		var missing []string
+		for _, e := range entries {
+			st, err := os.Lstat(e)
+			switch {
+			case err != nil && errors.Is(err, fs.ErrNotExist):
+				missing = append(missing, e)
+			case err != nil:
+				return res, err
+			case st.Mode().IsRegular():
+				add(e)
+			default:
+				res.Skipped++
+			}
+		}
+		if len(missing) > 0 {
+			if !opt.SkipMissing {
+				shown := missing
+				if len(shown) > maxMissingShown {
+					shown = shown[:maxMissingShown]
+				}
+				return res, fmt.Errorf("清單內有 %d 個項目不存在（例如 %s）：工作目錄不對、或清單含已刪除的檔案；確認後才可加 -skip-missing",
+					len(missing), strings.Join(shown, "、"))
+			}
+			res.Missing += len(missing)
+		}
+	}
+	sort.Strings(res.Files)
+	return res, nil
+}
+
+// readList 讀入清單。NUL 分隔時每個項目原樣使用；換行分隔時略過空行，並拒絕以引號開頭的行（git 的引號格式）。
+func readList(path string, nul bool, stdin io.Reader) ([]string, error) {
+	var b []byte
+	var err error
+	if path == "-" {
+		b, err = io.ReadAll(stdin)
+	} else {
+		b, err = os.ReadFile(path)
+	}
+	if err != nil {
+		return nil, fmt.Errorf("無法讀取清單 %s：%w", path, err)
+	}
+	sep := "\n"
+	if nul {
+		sep = "\x00"
+	}
+	var out []string
+	for _, item := range strings.Split(string(b), sep) {
+		if !nul {
+			item = strings.TrimRight(item, "\r")
+		}
+		if item == "" {
+			continue
+		}
+		if !nul && strings.HasPrefix(item, `"`) {
+			return nil, fmt.Errorf("清單 %s 有以引號開頭的行（git 引號格式，含非 ASCII 的路徑會被加引號）：請用 git -c core.quotepath=off ls-files，或改用 -files-from0 加 git ls-files -z", path)
+		}
+		out = append(out, item)
+	}
+	return out, nil
+}
+
+// ScanFiles 掃描檔案清單，對每個命中呼叫 emit（依路徑、單位順序）。回傳掃描的檔案數。
+func ScanFiles(ix *Index, files []string, emit func(Hit)) (int, error) {
+	n := 0
+	for _, p := range files {
+		b, err := os.ReadFile(p)
+		if err != nil {
+			return n, err
+		}
+		n++
+		for _, i := range ix.ScanContent(b) {
+			emit(Hit{Path: p, UnitID: ix.units[i].ID})
+		}
+	}
+	return n, nil
+}
+
+const (
+	// maxRecord 是歷史串流單筆內容的大小上限；超過就失敗（不預先配置，內容逐步讀入）。
+	maxRecord = 256 << 20
+	// maxHeaderLine 是歷史串流標頭行的長度上限；沒有換行的串流（例如誤把二進位導入）不會被整個讀進記憶體。
+	maxHeaderLine = 64 << 10
+	// endMarker 是歷史串流的結尾標記：`END\t<記錄數>\n`。
+	endMarker = "END"
+)
+
+// ScanHistory 讀取歷史串流並掃描。串流格式固定為重複的記錄，最後以結尾標記收尾：
+//
+//	<commit>\t<路徑>\t<大小>\n 加 <大小> 個位元組 加 \n   （重複）
+//	END\t<記錄數>\n
+//
+// 沒有結尾標記（串流在記錄邊界被截斷也一樣）、記錄數與標記不符、標記之後還有資料、路徑含製表符或換行、
+// 標頭欄位數不對、標頭行超過 maxHeaderLine、大小不是純十進位數字或超過 maxRecord、內容被截斷、
+// 內容後不是換行，一律回錯誤。相同內容的結果會重用（同一個 blob 出現在許多 commit）。回傳掃描的記錄數。
+func ScanHistory(ix *Index, r io.Reader, emit func(Hit)) (int, error) {
+	br := bufio.NewReaderSize(r, maxHeaderLine+1)
+	cache := map[[sha256.Size]byte][]int{}
+	var buf bytes.Buffer
+	n := 0
+	for {
+		line, err := br.ReadSlice('\n')
+		switch {
+		case errors.Is(err, bufio.ErrBufferFull):
+			return n, fmt.Errorf("第 %d 筆記錄的標頭行超過 %d bytes", n+1, maxHeaderLine)
+		case err == io.EOF && len(line) == 0:
+			return n, fmt.Errorf("串流在第 %d 筆記錄之前結束，沒有結尾標記（%s\\t<記錄數>）：串流被截斷或上游失敗", n+1, endMarker)
+		case err != nil:
+			return n, fmt.Errorf("第 %d 筆記錄的標頭被截斷或讀取失敗：%w", n+1, err)
+		}
+		f := strings.Split(strings.TrimSuffix(string(line), "\n"), "\t")
+		if len(f) == 2 && f[0] == endMarker {
+			cnt, ok := parseCount(f[1])
+			if !ok {
+				return n, fmt.Errorf("結尾標記的記錄數不是十進位數字")
+			}
+			if cnt != n {
+				return n, fmt.Errorf("結尾標記的記錄數 %d 與實際讀到的 %d 筆不符：串流被截斷或重複", cnt, n)
+			}
+			if _, err := br.ReadByte(); err != io.EOF {
+				return n, fmt.Errorf("結尾標記之後還有資料")
+			}
+			return n, nil
+		}
+		if len(f) != 3 || f[0] == "" || f[1] == "" {
+			return n, fmt.Errorf("第 %d 筆記錄的標頭格式錯誤（需要 <commit>\\t<路徑>\\t<大小>；路徑不得含製表符或換行）", n+1)
+		}
+		size, ok := parseCount(f[2])
+		if !ok {
+			return n, fmt.Errorf("第 %d 筆記錄的大小不是十進位數字", n+1)
+		}
+		if size > maxRecord {
+			return n, fmt.Errorf("第 %d 筆記錄的大小 %d 超過上限 %d", n+1, size, maxRecord)
+		}
+		buf.Reset()
+		if _, err := io.CopyN(&buf, br, int64(size)); err != nil {
+			return n, fmt.Errorf("第 %d 筆記錄的內容被截斷：%w", n+1, err)
+		}
+		if c, err := br.ReadByte(); err != nil || c != '\n' {
+			return n, fmt.Errorf("第 %d 筆記錄的內容之後不是換行（大小欄位與內容不符）", n+1)
+		}
+		n++
+		content := buf.Bytes()
+		sum := sha256.Sum256(content)
+		hits, ok := cache[sum]
+		if !ok {
+			hits = ix.ScanContent(content)
+			cache[sum] = hits
+		}
+		for _, i := range hits {
+			emit(Hit{Commit: f[0], Path: CleanPath(f[1]), UnitID: ix.units[i].ID})
+		}
+		if buf.Cap() > 64<<20 { // 不讓一筆大 blob 的緩衝區一直佔著記憶體
+			buf = bytes.Buffer{}
+		}
+	}
+}
+
+// parseCount 只收純十進位數字（不收正負號、空白與空字串）。
+func parseCount(s string) (int, bool) {
+	if s == "" || strings.Trim(s, "0123456789") != "" {
+		return 0, false
+	}
+	v, err := strconv.ParseUint(s, 10, 62)
+	if err != nil || v > 1<<40 {
+		return 0, false
+	}
+	return int(v), true
+}
diff --git a/apps/hr/l10n/leakscan/shoptab_test.go b/apps/hr/l10n/leakscan/shoptab_test.go
new file mode 100644
index 0000000..91f99ad
--- /dev/null
+++ b/apps/hr/l10n/leakscan/shoptab_test.go
@@ -0,0 +1,105 @@
+package leakscan
+
+import (
+	"bytes"
+	"testing"
+)
+
+// 規格 docs/spec/008 第 2 節：SHOPTAB.TBL 每筆 25 bytes，名稱 20 bytes，第 21 個位元組是 00，其後 4 個位元組未說明。
+// 單位端以 0x00 與 0x0A 切段、由段起點貪婪配對，段的開頭可能帶著上一筆那 4 個位元組。
+// 這個測試驗證原版的每個名稱欄都對齊：單位起點與 25 的餘數必須是偶數（名稱從 25 的倍數起算，雙位元組字相差偶數個位元組），
+// 起點不落在名稱欄之外，每個名稱欄各有一個單位且有查找鍵。
+func TestShoptabFrame(t *testing.T) {
+	files, err := LoadOrig(origDir(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	data := files["SHOPTAB.TBL"]
+	if len(data)%25 != 0 || len(data) == 0 {
+		t.Fatalf("SHOPTAB.TBL 長度 %d 不是 25 的倍數", len(data))
+	}
+	rec := len(data) / 25
+	for k := 0; k < rec; k++ {
+		if data[k*25+20] != 0 {
+			t.Fatalf("第 %d 筆的第 21 個位元組不是 00（規格第 2 節的事實）", k)
+		}
+	}
+	units := ExtractUnits(map[string][]byte{"SHOPTAB.TBL": data})
+	ix := NewIndex(units)
+	keyed := map[int]bool{}
+	for _, i := range ix.KeyedUnits() {
+		keyed[i] = true
+	}
+	perField := make([]int, rec)
+	perFieldKeyed := make([]int, rec)
+	for i, u := range units {
+		m := u.FragOff % 25
+		if m%2 != 0 {
+			t.Errorf("%s：片段起點 %d 與 25 的餘數 %d 是奇數（名稱錯位）", u.ID, u.FragOff, m)
+		}
+		if m >= 20 {
+			t.Errorf("%s：片段起點 %d 落在名稱欄之外（餘數 %d）", u.ID, u.FragOff, m)
+			continue
+		}
+		perField[u.FragOff/25]++
+		if keyed[i] {
+			perFieldKeyed[u.FragOff/25]++
+		}
+	}
+	noUnit, noKey := 0, 0
+	for k := 0; k < rec; k++ {
+		if perField[k] == 0 {
+			noUnit++
+		}
+		if perFieldKeyed[k] == 0 {
+			noKey++
+		}
+	}
+	if noUnit != 0 || noKey != 0 {
+		t.Errorf("SHOPTAB.TBL %d 筆：沒有單位的名稱欄 %d 個、沒有查找鍵的名稱欄 %d 個（要 0）", rec, noUnit, noKey)
+	}
+	t.Logf("SHOPTAB.TBL %d 筆，單位 %d 個，每個名稱欄都有單位且有查找鍵", rec, len(units))
+}
+
+// 合成版：只用規格第 2 節的框架事實（名稱 20 bytes、第 21 個位元組 00、其後 4 個未說明的位元組）。
+// 未說明的位元組取多種型態（含 NUL、0A、一般 ASCII 與 ASCII 範圍的位元組）；每個名稱都必須成為起點在 25 的倍數的單位。
+func TestShoptabFrameSynthetic(t *testing.T) {
+	p := newSynPool(0xC9, 0xE8, 77)
+	unknown := [][]byte{
+		{0x05, 0x00, 0x00, 0x00}, {0x00, 0x00, 0x00, 0x00}, {0xE8, 0x03, 0x00, 0x00},
+		{0x0A, 0x00, 0x00, 0x00}, {0x01, 0x02, 0x03, 0x04}, {0x7F, 0x7E, 0x40, 0x41},
+	}
+	const n = 60
+	var data []byte
+	names := make([][]byte, n)
+	for k := 0; k < n; k++ {
+		name := codeBytes(p.take(4 + k%7)) // 4 至 10 字
+		names[k] = name
+		field := make([]byte, 20)
+		copy(field, name)
+		data = append(data, field...)
+		data = append(data, 0x00)
+		data = append(data, unknown[k%len(unknown)]...)
+	}
+	units := ExtractUnits(map[string][]byte{"SHOPTAB.TBL": data})
+	byStart := map[int]Unit{}
+	for _, u := range units {
+		if u.FragOff%25 != 0 {
+			t.Errorf("%s：片段起點 %d 不是 25 的倍數", u.ID, u.FragOff)
+		}
+		byStart[u.FragOff] = u
+	}
+	for k := 0; k < n; k++ {
+		u, ok := byStart[k*25]
+		if !ok {
+			t.Errorf("第 %d 筆的名稱沒有成為起點在 %d 的單位", k, k*25)
+			continue
+		}
+		if !bytes.Equal(u.Big5, names[k]) {
+			t.Errorf("第 %d 筆的單位內容與名稱不符（長 %d，名稱長 %d）", k, len(u.Big5), len(names[k]))
+		}
+	}
+	if len(units) != n {
+		t.Errorf("單位數 %d，要 %d（每筆一個）", len(units), n)
+	}
+}
diff --git a/apps/hr/l10n/leakscan/source_test.go b/apps/hr/l10n/leakscan/source_test.go
new file mode 100644
index 0000000..87e5236
--- /dev/null
+++ b/apps/hr/l10n/leakscan/source_test.go
@@ -0,0 +1,45 @@
+package leakscan
+
+import (
+	"reflect"
+	"testing"
+)
+
+// 單位來源檔：七個資料檔加七個片頭文字檔（OP.TXT、OP0.TXT 至 OP5.TXT），名單寫死在測試裡。
+func TestSourceFiles(t *testing.T) {
+	want := []string{
+		"COUNTRY.MES", "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES", "ESPMES.MRG", "SHOPTAB.TBL",
+		"OP.TXT", "OP0.TXT", "OP1.TXT", "OP2.TXT", "OP3.TXT", "OP4.TXT", "OP5.TXT",
+	}
+	if !reflect.DeepEqual(SourceFiles, want) {
+		t.Fatalf("SourceFiles ＝ %v，要 %v", SourceFiles, want)
+	}
+	files, err := LoadOrig(writeOrig(t, synthFiles()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) != len(want) {
+		t.Fatalf("LoadOrig 載入 %d 個檔，要 %d", len(files), len(want))
+	}
+	for _, n := range want {
+		if len(files[n]) == 0 {
+			t.Errorf("LoadOrig 沒有載入 %s", n)
+		}
+	}
+	// 原版：每個來源檔都有單位，單位身分的檔名欄是實際檔名。
+	t.Run("original", func(t *testing.T) {
+		orig, err := LoadOrig(origDir(t))
+		if err != nil {
+			t.Fatal(err)
+		}
+		seen := map[string]int{}
+		for _, u := range ExtractUnits(orig) {
+			seen[u.File]++
+		}
+		for _, n := range want {
+			if seen[n] == 0 {
+				t.Errorf("原版的 %s 沒有抽出單位", n)
+			}
+		}
+	})
+}
diff --git a/apps/hr/l10n/leakscan/stats_test.go b/apps/hr/l10n/leakscan/stats_test.go
new file mode 100644
index 0000000..9fbe84f
--- /dev/null
+++ b/apps/hr/l10n/leakscan/stats_test.go
@@ -0,0 +1,166 @@
+package leakscan
+
+import (
+	"os"
+	"sort"
+	"testing"
+)
+
+// origDir 回傳原版目錄；缺檔就 skip（CLAUDE.md [HARD]：不用替代品）。
+func origDir(t testing.TB) string {
+	t.Helper()
+	dir := os.Getenv("HR_ORIG")
+	if dir == "" {
+		dir = "/orig/orig"
+	}
+	if _, err := LoadOrig(dir); err != nil {
+		t.Skipf("沒有原版資料檔（%s）：%v", dir, err)
+	}
+	return dir
+}
+
+// noKeyReason 回傳單位沒有查找鍵的原因（用單位自己的片段重算，與索引的建立獨立）。
+func noKeyReason(u Unit) string {
+	ps := pieces(u)
+	if len(ps) == 0 {
+		return "正規化後沒有片段（全是標點或可移除字元）"
+	}
+	split := false
+	for _, r := range unitRunes(u) {
+		if classify(unify(r)) == clsSplit {
+			split = true
+		}
+	}
+	longest := 0
+	for _, p := range ps {
+		if len(p) > longest {
+			longest = len(p)
+		}
+	}
+	switch {
+	case longest < 3 && split:
+		return "有切斷字元（半形英數、原版不可能有的字元）切斷後不足 3 字"
+	case longest < 3:
+		return "正規化後不足 3 字"
+	case longest < 6:
+		return "3 至 5 字片段的非標點字不足 3 個"
+	}
+	return "視窗全部不足 3 個非標點字"
+}
+
+// 原版資料檔的單位統計（只記計數，不記內容）：分檔的單位數、沒有查找鍵的單位數與原因，
+// 以及 SHOPTAB.TBL 的 25 bytes 框架對照（規格 008 第 2 節：每筆 25 bytes，名稱 20 bytes，第 21 個位元組為 00）。
+func TestOriginalUnitStats(t *testing.T) {
+	files, err := LoadOrig(origDir(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	units := ExtractUnits(files)
+	ix := NewIndex(units)
+	keyed := map[int]bool{}
+	for _, i := range ix.KeyedUnits() {
+		keyed[i] = true
+	}
+	type tally struct{ units, byteOnly, noKey, long int }
+	per := map[string]*tally{}
+	reasons := map[string]map[string]int{} // 檔 -> 原因 -> 計數
+	lens := map[int]int{}
+	for i, u := range units {
+		p := per[u.File]
+		if p == nil {
+			p = &tally{}
+			per[u.File] = p
+			reasons[u.File] = map[string]int{}
+		}
+		p.units++
+		if u.ByteOnly {
+			p.byteOnly++
+		}
+		if u.SegChars > AllowMaxSegChars {
+			p.long++
+		}
+		if !keyed[i] {
+			p.noKey++
+			reasons[u.File][noKeyReason(u)]++
+		}
+		n := len(u.Big5) / 2
+		if n > 12 {
+			n = 12
+		}
+		lens[n]++
+	}
+	names := make([]string, 0, len(per))
+	for n := range per {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	total, noKey := 0, 0
+	for _, n := range names {
+		p := per[n]
+		total += p.units
+		noKey += p.noKey
+		t.Logf("%-14s 檔案 %6d bytes，單位 %5d，僅位元組形式 %d，所屬段 > %d 字 %d，沒有查找鍵 %d",
+			n, len(files[n]), p.units, p.byteOnly, AllowMaxSegChars, p.long, p.noKey)
+		rs := make([]string, 0, len(reasons[n]))
+		for r := range reasons[n] {
+			rs = append(rs, r)
+		}
+		sort.Strings(rs)
+		for _, r := range rs {
+			t.Logf("    沒有鍵的原因：%s：%d", r, reasons[n][r])
+		}
+	}
+	for n := 3; n <= 12; n++ {
+		suffix := ""
+		if n == 12 {
+			suffix = "以上"
+		}
+		t.Logf("片段 %d%s 字：%d 個", n, suffix, lens[n])
+	}
+	w, e := ix.Stats()
+	t.Logf("單位合計 %d；沒有查找鍵 %d；視窗鍵 %d、整段鍵 %d", total, noKey, w, e)
+	for _, n := range SourceFiles {
+		if per[n] == nil || per[n].units == 0 {
+			t.Errorf("%s 沒有抽出單位", n)
+		}
+	}
+
+	// SHOPTAB.TBL：25 bytes 框架。名稱欄 [25k, 25k+20) 各應有一個起點落在欄內的單位，單位起點與 25 的餘數必須是偶數
+	// （名稱從 25 的倍數起算，雙位元組字的起點與它相差偶數個位元組），且每個名稱欄的單位都有查找鍵。
+	shop := files["SHOPTAB.TBL"]
+	if len(shop)%25 != 0 {
+		t.Fatalf("SHOPTAB.TBL 長度 %d 不是 25 的倍數", len(shop))
+	}
+	rec := len(shop) / 25
+	odd, outside := 0, 0
+	fieldUnits := make([]int, rec) // 起點落在第 k 個名稱欄內的單位數
+	fieldKeyed := make([]int, rec)
+	for i, u := range units {
+		if u.File != "SHOPTAB.TBL" {
+			continue
+		}
+		m := u.FragOff % 25
+		if m%2 != 0 {
+			odd++
+		}
+		if m >= 20 {
+			outside++
+			continue
+		}
+		fieldUnits[u.FragOff/25]++
+		if keyed[i] {
+			fieldKeyed[u.FragOff/25]++
+		}
+	}
+	noUnit, noKeyed := 0, 0
+	for k := 0; k < rec; k++ {
+		if fieldUnits[k] == 0 {
+			noUnit++
+		}
+		if fieldKeyed[k] == 0 {
+			noKeyed++
+		}
+	}
+	t.Logf("SHOPTAB.TBL：%d 筆；單位起點與 25 的餘數為奇數的單位 %d 個、起點落在欄外（餘數 >= 20）的單位 %d 個；沒有單位的名稱欄 %d 個、沒有查找鍵的名稱欄 %d 個",
+		rec, odd, outside, noUnit, noKeyed)
+}
diff --git a/apps/hr/l10n/leakscan/units.go b/apps/hr/l10n/leakscan/units.go
new file mode 100644
index 0000000..4694dda
--- /dev/null
+++ b/apps/hr/l10n/leakscan/units.go
@@ -0,0 +1,166 @@
+package leakscan
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// 單位抽取（docs/spec/008 第 3.9 節第 3 項）。只依賴原始位元組，與建置器的解析器無關。
+const (
+	// minFragChars 是單位片段的最短字數（連續雙位元組字，標點也算一字）。
+	minFragChars = 3
+	// minSegBytes 是所屬段的最短位元組數；更短的段與一般詞無法區分。
+	minSegBytes = 8
+	// AllowMaxSegChars 是 allowlist 可登記的所屬段字數上限。
+	AllowMaxSegChars = 7
+)
+
+// Unit 是一個可比對的原版文字片段。內容只存在記憶體裡，不會被輸出。
+type Unit struct {
+	ID       string // 單位身分：<檔名>@<段起點位移（大寫十六進位）>.<片段序號>
+	File     string // 原版檔名
+	SegOff   int    // 所屬段的起點位移（0x00 與 0x0A 之間）
+	FragOff  int    // 片段在檔案內的絕對起點位移（供對齊檢查；不是身分的一部分）
+	Seq      int    // 片段序號：該段內 >= minFragChars 字的片段，由 0 起算
+	Big5     []byte // 片段的原始位元組（全是雙位元組字）
+	Text     string // UTF-8 解碼；只要有一個字 x/text 解不出就是空字串
+	ByteOnly bool   // x/text 解不出：Text 為空，位元組形式仍會比對
+	SegChars int    // 所屬段的字數（解碼後字元數：雙位元組字與單位元組字元各算一字）
+}
+
+// FormatUnitID 產生單位身分。
+func FormatUnitID(file string, segOff, seq int) string {
+	return fmt.Sprintf("%s@%X.%d", file, segOff, seq)
+}
+
+// ParseUnitID 解析單位身分並回傳正規形式（檔名大寫、位移大寫十六進位、無前導零）。
+func ParseUnitID(s string) (canonical string, ok bool) {
+	at := strings.LastIndexByte(s, '@')
+	dot := strings.LastIndexByte(s, '.')
+	if at <= 0 || dot < at+2 || dot == len(s)-1 {
+		return "", false
+	}
+	off, err := parseUint(s[at+1:dot], 16)
+	if err != nil {
+		return "", false
+	}
+	seq, err := parseUint(s[dot+1:], 10)
+	if err != nil {
+		return "", false
+	}
+	return FormatUnitID(strings.ToUpper(s[:at]), off, seq), true
+}
+
+// parseUint 只收純數字（不收正負號與底線）。
+func parseUint(s string, base int) (int, error) {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if !(c >= '0' && c <= '9' || base == 16 && (c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F')) {
+			return 0, strconv.ErrSyntax
+		}
+	}
+	v, err := strconv.ParseUint(s, base, 31)
+	return int(v), err
+}
+
+// ExtractUnits 由原版資料檔的原始位元組抽出單位。files 的鍵是檔名；輸出依檔名、位移排序，與 map 迭代順序無關。
+func ExtractUnits(files map[string][]byte) []Unit {
+	big5Init()
+	names := make([]string, 0, len(files))
+	for n := range files {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	var units []Unit
+	for _, name := range names {
+		data := files[name]
+		for start := 0; start < len(data); {
+			end := start
+			for end < len(data) && data[end] != 0x00 && data[end] != 0x0A {
+				end++
+			}
+			if end-start >= minSegBytes {
+				units = appendSegUnits(units, name, start, data[start:end])
+			}
+			start = end + 1
+		}
+	}
+	return units
+}
+
+// appendSegUnits 對一個段做對齊的 Big5 解碼：ASCII 與無法對齊的位元組切開片段，
+// 取連續雙位元組字 >= minFragChars 的片段。
+func appendSegUnits(units []Unit, name string, off int, seg []byte) []Unit {
+	chars := segChars(seg)
+	seq := 0
+	fragStart := -1
+	flush := func(i int) {
+		if fragStart < 0 {
+			return
+		}
+		if (i-fragStart)/2 >= minFragChars {
+			u := newUnit(name, off, seq, seg[fragStart:i], chars)
+			u.FragOff = off + fragStart
+			units = append(units, u)
+			seq++
+		}
+		fragStart = -1
+	}
+	for i := 0; i < len(seg); {
+		if pairAt(seg, i) >= 0 {
+			if fragStart < 0 {
+				fragStart = i
+			}
+			i += 2
+			continue
+		}
+		flush(i)
+		i++
+	}
+	flush(len(seg))
+	return units
+}
+
+func newUnit(name string, off, seq int, frag []byte, segChars int) Unit {
+	b := make([]byte, len(frag))
+	copy(b, frag)
+	u := Unit{ID: FormatUnitID(name, off, seq), File: name, SegOff: off, Seq: seq, Big5: b, SegChars: segChars}
+	var sb strings.Builder
+	for i := 0; i+1 < len(b); i += 2 {
+		r, ok := big5Rune(int(b[i])<<8 | int(b[i+1]))
+		if !ok {
+			u.ByteOnly = true
+			break
+		}
+		sb.WriteRune(r)
+	}
+	if !u.ByteOnly {
+		u.Text = sb.String()
+	}
+	return u
+}
+
+// segChars 回傳段的字數：結構合法的雙位元組碼算一字，其餘位元組各算一字。
+func segChars(seg []byte) int {
+	n := 0
+	for i := 0; i < len(seg); n++ {
+		if pairAt(seg, i) >= 0 {
+			i += 2
+		} else {
+			i++
+		}
+	}
+	return n
+}
+
+// unitRunes 回傳單位片段的字元串流（x/text 解不出的字用替身字元）。
+func unitRunes(u Unit) []rune {
+	rs := make([]rune, 0, len(u.Big5)/2)
+	for i := 0; i+1 < len(u.Big5); i += 2 {
+		r, _ := big5Rune(int(u.Big5[i])<<8 | int(u.Big5[i+1]))
+		rs = append(rs, r)
+	}
+	return rs
+}
diff --git a/apps/hr/l10n/leakscan/units_test.go b/apps/hr/l10n/leakscan/units_test.go
new file mode 100644
index 0000000..e4286b3
--- /dev/null
+++ b/apps/hr/l10n/leakscan/units_test.go
@@ -0,0 +1,235 @@
+package leakscan
+
+import (
+	"bytes"
+	"fmt"
+	"go/build"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// 合成資料檔的單位：每個檔的片段字數與序號（對照 synthFiles 的說明）。
+func TestExtractSynthetic(t *testing.T) {
+	files := synthFiles()
+	units := ExtractUnits(files)
+	got := map[string][]int{}
+	for _, u := range units {
+		got[u.File] = append(got[u.File], len(u.Big5)/2)
+	}
+	want := map[string][]int{
+		"COUNTRY.MES":  {14, 6, 7, 8},
+		"SP.MES":       {3, 4, 5},
+		"SYSTEM.MES":   {4},
+		"UWASA.MES":    {3, 4, 3, 5},
+		"POWERMES.MES": {9, 17},
+		"ESPMES.MRG":   {6, 9, 12},
+		"SHOPTAB.TBL":  {3, 4, 5, 3, 3, 3},
+		"OP.TXT":       {5},
+		"OP0.TXT":      {5},
+		"OP1.TXT":      {5},
+		"OP2.TXT":      {5},
+		"OP3.TXT":      {5},
+		"OP4.TXT":      {5},
+		"OP5.TXT":      {5},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("各檔片段字數 ＝ %v，要 %v（SYSTEM.MES 只能有最後一個 4 字單位：7 bytes 的段、只有 2 字片段的段、純 ASCII 的段都沒有單位）", got, want)
+	}
+	// 序號：由 0 起算，只算 >= 3 字的片段；同一段的單位共用位移與字數。
+	var uw []Unit
+	for _, u := range units {
+		if u.File == "UWASA.MES" {
+			uw = append(uw, u)
+		}
+	}
+	for i, u := range uw {
+		if u.Seq != i || u.SegOff != uw[0].SegOff || u.SegChars != 21 {
+			t.Errorf("UWASA 單位 %d：序號 %d、位移 %d、段字數 %d", i, u.Seq, u.SegOff, u.SegChars)
+		}
+		if u.ID != fmt.Sprintf("UWASA.MES@%X.%d", u.SegOff, i) {
+			t.Errorf("單位身分 %q 與位移、序號不符", u.ID)
+		}
+	}
+	// 3 字加 "%s" 的段：段字數 5（3 個雙位元組字加 2 個單位元組字元）。
+	for _, u := range units {
+		if u.File == "SP.MES" && len(u.Big5) == 6 && u.SegChars != 5 {
+			t.Errorf("3 字加 %%s 的段字數 ＝ %d，要 5", u.SegChars)
+		}
+	}
+}
+
+// 以獨立寫法重算原版的單位身分清單，與 ExtractUnits 逐項比對（片段 3 字門檻與段 8 bytes 門檻在真資料上的對照）。
+func TestExtractAgainstOracle(t *testing.T) {
+	files, err := LoadOrig(origDir(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for n := range files {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	var want []string
+	short2, shortSeg := 0, 0 // 真資料裡確實存在的負例：2 字片段、< 8 bytes 但有 >= 3 字的段
+	for _, name := range names {
+		data := files[name]
+		segStart := 0
+		for i := 0; i <= len(data); i++ {
+			if i < len(data) && data[i] != 0x00 && data[i] != 0x0A {
+				continue
+			}
+			seg := data[segStart:i]
+			var frags []int // 每個連續雙位元組字片段的字數
+			run := 0
+			for k := 0; k < len(seg); {
+				if k+1 < len(seg) && seg[k] >= 0x81 && seg[k] <= 0xFE &&
+					(seg[k+1] >= 0x40 && seg[k+1] <= 0x7E || seg[k+1] >= 0xA1 && seg[k+1] <= 0xFE) {
+					run++
+					k += 2
+					continue
+				}
+				if run > 0 {
+					frags = append(frags, run)
+				}
+				run = 0
+				k++
+			}
+			if run > 0 {
+				frags = append(frags, run)
+			}
+			seq := 0
+			for _, n := range frags {
+				switch {
+				case len(seg) < 8:
+					if n >= 3 {
+						shortSeg++
+					}
+				case n >= 3:
+					want = append(want, fmt.Sprintf("%s@%X.%d", name, segStart, seq))
+					seq++
+				case n == 2:
+					short2++
+				}
+			}
+			segStart = i + 1
+		}
+	}
+	var got []string
+	for _, u := range ExtractUnits(files) {
+		got = append(got, u.ID)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("單位身分清單不一致：ExtractUnits %d 個，獨立計算 %d 個", len(got), len(want))
+	}
+	t.Logf("原版：單位 %d 個；真資料中存在的負例：>= 8 bytes 的段內 2 字片段 %d 個、< 8 bytes 但有 >= 3 字片段的段 %d 個", len(got), short2, shortSeg)
+	if short2 == 0 || shortSeg == 0 {
+		t.Logf("注意：原版沒有 %d/%d 類負例，對應的門檻突變只由合成資料測試負責", short2, shortSeg)
+	}
+}
+
+func TestUnitInvariants(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		if len(w.units) == 0 {
+			t.Fatal("沒有單位")
+		}
+		for _, u := range w.units {
+			if len(u.Big5)%2 != 0 || len(u.Big5) < 2*3 {
+				t.Fatalf("%s：位元組數 %d 不合法", u.ID, len(u.Big5))
+			}
+			for i := 0; i < len(u.Big5); i += 2 {
+				if pairAt(u.Big5, i) < 0 {
+					t.Fatalf("%s：第 %d 字不是結構合法的雙位元組字", u.ID, i/2)
+				}
+			}
+			canon, ok := ParseUnitID(u.ID)
+			if !ok || canon != u.ID {
+				t.Fatalf("單位身分 %q 無法往返", u.ID)
+			}
+			data := w.files[u.File]
+			if u.SegOff != 0 && data[u.SegOff-1] != 0x00 && data[u.SegOff-1] != 0x0A {
+				t.Fatalf("%s：位移 %d 不是段起點", u.ID, u.SegOff)
+			}
+			end := u.SegOff
+			for end < len(data) && data[end] != 0x00 && data[end] != 0x0A {
+				end++
+			}
+			seg := data[u.SegOff:end]
+			if u.FragOff < u.SegOff || u.FragOff+len(u.Big5) > end || !bytes.Equal(data[u.FragOff:u.FragOff+len(u.Big5)], u.Big5) {
+				t.Fatalf("%s：片段位移 %d 與內容不符", u.ID, u.FragOff)
+			}
+			if len(seg) < 8 || !bytes.Contains(seg, u.Big5) {
+				t.Fatalf("%s：所屬段長 %d bytes 或不含片段", u.ID, len(seg))
+			}
+			if u.SegChars != segChars(seg) {
+				t.Fatalf("%s：段字數 %d，重算 %d", u.ID, u.SegChars, segChars(seg))
+			}
+			if (u.Text == "") != u.ByteOnly {
+				t.Fatalf("%s：Text 與 ByteOnly 不一致", u.ID)
+			}
+		}
+	})
+}
+
+// 單位身分只取決於檔名與位元組：與其他檔、map 迭代順序、建置器的解析器都無關。
+func TestUnitIdentityIndependentOfParser(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		ids := func(us []Unit) []string {
+			var out []string
+			for _, u := range us {
+				out = append(out, u.ID)
+			}
+			return out
+		}
+		// 只給一個檔，得到的單位身分必須是完整結果裡該檔的子序列（完全相同）。
+		for name, data := range w.files {
+			var sub []string
+			for _, u := range w.units {
+				if u.File == name {
+					sub = append(sub, u.ID)
+				}
+			}
+			alone := ids(ExtractUnits(map[string][]byte{name: data}))
+			if !reflect.DeepEqual(alone, sub) {
+				t.Fatalf("%s：單獨抽取與完整抽取不一致", name)
+			}
+		}
+		again := ids(ExtractUnits(w.files))
+		if !reflect.DeepEqual(again, ids(w.units)) {
+			t.Fatal("重複抽取的結果不一致")
+		}
+	})
+	// 套件不得依賴建置器、解析器或 dosgolem 內的任何其他套件。
+	pkg, err := build.ImportDir(".", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, imp := range pkg.Imports {
+		first := strings.SplitN(imp, "/", 2)[0]
+		isStd := !strings.Contains(first, ".")
+		if !isStd && !strings.HasPrefix(imp, "golang.org/x/text/") {
+			t.Errorf("leakscan 不得匯入 %s（單位抽取必須與解析器無關）", imp)
+		}
+	}
+}
+
+func TestParseUnitID(t *testing.T) {
+	ok := map[string]string{
+		"SP.MES@1A.0":          "SP.MES@1A.0",
+		"sp.mes@001a.0":        "SP.MES@1A.0",
+		"ESPMES.MRG@0.12":      "ESPMES.MRG@0.12",
+		"COUNTRY.MES@ABCDEF.7": "COUNTRY.MES@ABCDEF.7",
+	}
+	for in, want := range ok {
+		if got, good := ParseUnitID(in); !good || got != want {
+			t.Errorf("ParseUnitID(%q) ＝ %q, %v，要 %q", in, got, good, want)
+		}
+	}
+	for _, bad := range []string{"", "SP.MES", "SP.MES@", "SP.MES@1A", "SP.MES@1A.", "SP.MES@.0", "SP.MES@xyz.0", "@1A.0",
+		"SP.MES@1A.-1", "SP.MES@+1A.0", "SP.MES@1_0.0", "SP.MES@1A.0x"} {
+		if got, good := ParseUnitID(bad); good {
+			t.Errorf("ParseUnitID(%q) 應失敗，得到 %q", bad, got)
+		}
+	}
+}
diff --git a/apps/hr/l10n/leakscan/world_test.go b/apps/hr/l10n/leakscan/world_test.go
new file mode 100644
index 0000000..f0b1543
--- /dev/null
+++ b/apps/hr/l10n/leakscan/world_test.go
@@ -0,0 +1,264 @@
+package leakscan
+
+import (
+	"bytes"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"unicode"
+)
+
+// 測試的「世界」：一組原版資料檔、由它抽出的單位與索引。
+//
+//	合成世界：資料檔由測試自造，字元取自 Big5 次常用字區（不是任何原版文字），永遠執行。
+//	原版世界：資料檔取自使用者原版（HR_ORIG，預設 /orig/orig），缺檔就 skip。
+//
+// 測試原始碼不含任何 CJK 字面值；所有文字在執行時由合成字元或原版產生，fixture 只寫進 t.TempDir()。
+type world struct {
+	name  string
+	orig  string // -orig 用的目錄（合成世界是暫存目錄，原版世界是真原版目錄）
+	files map[string][]byte
+	units []Unit
+	ix    *Index
+	fill  *synPool // 填充字元：每個世界（每個測試）自己一份，-count 與 -shuffle 下不會用盡
+}
+
+func newWorld(name string, files map[string][]byte) *world {
+	units := ExtractUnits(files)
+	// 填充字元與合成世界的字元分屬不同區（lead E9 至 F8），不會與任何合成單位相等。
+	return &world{name: name, files: files, units: units, ix: NewIndex(units), fill: newSynPool(0xE9, 0xF8, 7)}
+}
+
+// filler 取 n 個填充字元（互不相同，不會與合成單位的字元重疊）。
+func (w *world) filler(n int) []int { return w.fill.take(n) }
+
+// cp 把碼位轉成字串：原始碼不放 CJK 與 \u 跳脫字面值，非 ASCII 字元一律在執行時由碼位產生。
+func cp(rs ...rune) string { return string(rs) }
+
+// forEachWorld 對合成世界與原版世界各跑一次。
+func forEachWorld(t *testing.T, fn func(t *testing.T, w *world)) {
+	t.Helper()
+	// 子測試名稱用 ASCII：t.TempDir 會把測試名稱放進路徑，而輸出的路徑必須維持純 ASCII。
+	t.Run("synthetic", func(t *testing.T) {
+		w := newWorld("合成", synthFiles())
+		w.orig = writeOrig(t, w.files)
+		fn(t, w)
+	})
+	t.Run("original", func(t *testing.T) {
+		dir := origDir(t)
+		files, err := LoadOrig(dir)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w := newWorld("原版", files)
+		w.orig = dir
+		fn(t, w)
+	})
+}
+
+// scan 回傳內容命中的單位身分集合。
+func (w *world) scan(content []byte) map[string]bool {
+	out := map[string]bool{}
+	for _, i := range w.ix.ScanContent(content) {
+		out[w.units[i].ID] = true
+	}
+	return out
+}
+
+// pieces 回傳單位片段在「連接」正規化下的片段（複製，可保留）。
+func pieces(u Unit) [][]rune {
+	var out [][]rune
+	runsOf(unitRunes(u), true, nil, func(run []rune) { out = append(out, append([]rune(nil), run...)) })
+	return out
+}
+
+// clean 回報單位是否「乾淨」：正規化後恰好一個片段，沒有任何字被改動（沒有標點、空白、標記），
+// 這樣 UTF-8 文字與 Big5 位元組都可以直接當 fixture 內容。
+func clean(u Unit) (rs []rune, ok bool) {
+	if u.ByteOnly {
+		return nil, false
+	}
+	ps := pieces(u)
+	if len(ps) != 1 || len(ps[0])*2 != len(u.Big5) || string(ps[0]) != u.Text {
+		return nil, false
+	}
+	return ps[0], true
+}
+
+// pick 找第一個「乾淨」且字數在 [lo, hi] 的單位。
+func (w *world) pick(t *testing.T, lo, hi int) Unit {
+	t.Helper()
+	for _, u := range w.units {
+		if rs, ok := clean(u); ok && len(rs) >= lo && len(rs) <= hi {
+			return u
+		}
+	}
+	t.Skipf("%s世界沒有字數在 %d 至 %d 的乾淨單位", w.name, lo, hi)
+	return Unit{}
+}
+
+// keyIDs 回傳整段鍵（短片段）對應的全部單位身分：重複的原文會讓多個單位共用同一個鍵。
+func (w *world) keyIDs(rs []rune) []string {
+	var out []string
+	for _, i := range w.ix.eq[string(encodeRunes(nil, rs))] {
+		out = append(out, w.units[i].ID)
+	}
+	return out
+}
+
+func anyIn(set map[string]bool, ids ...string) bool {
+	for _, id := range ids {
+		if set[id] {
+			return true
+		}
+	}
+	return false
+}
+
+// ---- 合成資料 ----
+
+// synPool 提供互不相同的合成字元（Big5 雙位元組碼）。每個碼只發一次，所以不同呼叫取得的序列不會相同。
+type synPool struct {
+	codes []int
+	next  int
+}
+
+// newSynPool 取 lead 在 [lo, hi]、尾位元組在 A1 至 FE 的漢字（排除標點與符號），以固定種子洗牌。
+func newSynPool(lo, hi int, seed int64) *synPool {
+	big5Init()
+	p := &synPool{}
+	for lead := lo; lead <= hi; lead++ {
+		for trail := 0xA1; trail <= 0xFE; trail++ {
+			code := lead<<8 | trail
+			if r := big5Dec[code]; r != 0 && classify(r) == clsMember && !unicode.IsPunct(r) {
+				p.codes = append(p.codes, code)
+			}
+		}
+	}
+	rng := rand.New(rand.NewSource(seed))
+	rng.Shuffle(len(p.codes), func(i, j int) { p.codes[i], p.codes[j] = p.codes[j], p.codes[i] })
+	return p
+}
+
+func (p *synPool) take(n int) []int {
+	if p.next+n > len(p.codes) {
+		panic("合成字元用盡")
+	}
+	out := p.codes[p.next : p.next+n]
+	p.next += n
+	return out
+}
+
+func codeBytes(parts ...[]int) []byte {
+	var b []byte
+	for _, codes := range parts {
+		for _, c := range codes {
+			b = append(b, byte(c>>8), byte(c))
+		}
+	}
+	return b
+}
+
+func codeText(codes []int) string {
+	var sb strings.Builder
+	for _, c := range codes {
+		sb.WriteRune(big5Dec[c])
+	}
+	return sb.String()
+}
+
+// 全形逗號的 Big5 碼（A141）。
+const fullComma = 0xA141
+
+// punctCodes 回傳 n 個分類為標點的 Big5 碼（取 lead A1 的符號區）。
+func punctCodes(n int) []int {
+	big5Init()
+	var out []int
+	for trail := 0x40; trail <= 0xFE && len(out) < n; trail++ {
+		code := 0xA1<<8 | trail
+		if r := big5Dec[code]; r != 0 && classify(unify(r)) == clsPunct {
+			out = append(out, code)
+		}
+	}
+	return out
+}
+
+// synthFiles 自造七個資料檔。段以 0x0A 與 0x00 交錯分隔。
+//
+//	COUNTRY.MES  14 字、6 字、7 字、8 字的單一片段
+//	SP.MES       3 字加 "%s"（8 bytes）、4 字（8 bytes）、5 字
+//	SYSTEM.MES   7 bytes 的段（3 字加 "x"）、只有 2 字片段的段、純 ASCII 的段：都沒有單位；最後一個 4 字的段有單位
+//	UWASA.MES    一個 21 字的長段，被 "%s" 切成 3、4、3、5 字四個短片段
+//	POWERMES.MES 4 字、全形逗號、4 字（片段內含標點）；2 字加 12 個標點加 3 字（裝飾線）
+//	ESPMES.MRG   另一組 6、9、12 字
+//	SHOPTAB.TBL  另一組 3、4、5 字（各自成段），再加段字數 7 的 3 字單位與段字數 8 的兩個 3 字單位
+//	OP.TXT、OP0.TXT 至 OP5.TXT  各一個 5 字的段（後接 CRLF）
+func synthFiles() map[string][]byte {
+	p := newSynPool(0xC9, 0xE8, 3)
+	join := func(segs ...[]byte) []byte {
+		var out []byte
+		for i, s := range segs {
+			out = append(out, s...)
+			if i%2 == 0 {
+				out = append(out, 0x0A)
+			} else {
+				out = append(out, 0x00)
+			}
+		}
+		return out
+	}
+	cat := func(parts ...[]byte) []byte { return bytes.Join(parts, nil) }
+	files := map[string][]byte{}
+	files["COUNTRY.MES"] = join(codeBytes(p.take(14)), codeBytes(p.take(6)), codeBytes(p.take(7)), codeBytes(p.take(8)))
+	files["SP.MES"] = join(cat(codeBytes(p.take(3)), []byte("%s")), codeBytes(p.take(4)), codeBytes(p.take(5)))
+	files["SYSTEM.MES"] = join(
+		cat(codeBytes(p.take(3)), []byte("x")),
+		cat(codeBytes(p.take(2)), []byte("AB"), codeBytes(p.take(2)), []byte("CD")),
+		[]byte("plain ascii segment %s with %d and more than eight bytes"),
+		codeBytes(p.take(4)), // 唯一的單位：每個資料檔都要抽得出單位，閘門才不會因覆蓋檢查失敗
+	)
+	files["UWASA.MES"] = join(cat(
+		codeBytes(p.take(3)), []byte("%s"), codeBytes(p.take(4)), []byte("%s"),
+		codeBytes(p.take(3)), []byte("%s"), codeBytes(p.take(5))))
+	files["POWERMES.MES"] = join(
+		cat(codeBytes(p.take(4)), codeBytes([]int{fullComma}), codeBytes(p.take(4))),
+		cat(codeBytes(p.take(2)), codeBytes(punctCodes(12)), codeBytes(p.take(3))), // 裝飾線：標點占多數
+	)
+	files["ESPMES.MRG"] = join(codeBytes(p.take(6)), codeBytes(p.take(9)), codeBytes(p.take(12)))
+	files["SHOPTAB.TBL"] = join(
+		cat(codeBytes(p.take(3)), []byte("%d")), codeBytes(p.take(4)), codeBytes(p.take(5)),
+		cat(codeBytes(p.take(3)), []byte("%s"), codeBytes(p.take(2))), // 段字數 7：可登記的上限
+		cat(codeBytes(p.take(3)), []byte("%s"), codeBytes(p.take(3)))) // 段字數 8：超過上限
+	// 片頭文字檔：每個一個 5 字的段，後面接 CRLF（純文字檔的換行是 0x0D 0x0A）。
+	for _, n := range TextFiles {
+		files[n] = cat(codeBytes(p.take(5)), []byte("\r\n"))
+	}
+	return files
+}
+
+// writeOrig 把資料檔寫進新的暫存目錄並回傳目錄路徑。
+func writeOrig(t testing.TB, files map[string][]byte) string {
+	t.Helper()
+	dir := t.TempDir()
+	for name, b := range files {
+		if err := os.WriteFile(filepath.Join(dir, name), b, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+// writeFile 在目錄內寫檔（含子目錄）並回傳完整路徑。
+func writeFile(t testing.TB, dir, name string, content []byte) string {
+	t.Helper()
+	p := filepath.Join(dir, name)
+	if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, content, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
diff --git a/apps/hr/l10n/mes.go b/apps/hr/l10n/mes.go
new file mode 100644
index 0000000..b23cb9e
--- /dev/null
+++ b/apps/hr/l10n/mes.go
@@ -0,0 +1,109 @@
+package l10n
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+)
+
+// `*.MES`（docs/spec/008 第 2 節）：u16 K，K 個 u32 偏移，首偏移 ＝ 2 ＋ 4K，項目 i 為 [偏移 i, 偏移 i+1)，
+// 每個偏移前一位元組為 NUL，末偏移指向結尾的 0xFF；共 K - 1 項。
+// COUNTRY.MES 的偏移 5 起（含末偏移）比真實起點大 2，其餘四個檔精確。
+
+func parseMES(name string, kind Kind, d []byte) (*File, error) {
+	if len(d) < 2 {
+		return nil, errors.New("檔案短於 2 bytes")
+	}
+	k := int(binary.LittleEndian.Uint16(d))
+	if k < 1 {
+		return nil, errors.New("偏移個數 K 為 0")
+	}
+	head := 2 + 4*k
+	if head >= len(d) {
+		return nil, fmt.Errorf("偏移表（K=%d，%d bytes）超出檔案（%d bytes）", k, head, len(d))
+	}
+	offs := make([]int, k)
+	for i := range offs {
+		offs[i] = int(binary.LittleEndian.Uint32(d[2+4*i:]))
+	}
+	if offs[0] != head {
+		return nil, fmt.Errorf("首偏移為 %d，應為 2 + 4K = %d", offs[0], head)
+	}
+	// 依 NUL 切出實體項目（真實起點）。
+	pos := head
+	trueOff := make([]int, k)
+	items := make([]Item, 0, k-1)
+	for i := 0; i < k-1; i++ {
+		trueOff[i] = pos
+		j := -1
+		if pos < len(d) {
+			j = bytes.IndexByte(d[pos:], 0)
+		}
+		if j < 0 {
+			return nil, fmt.Errorf("項目 %d 沒有結尾 NUL", i)
+		}
+		items = append(items, Item{ID: fmt.Sprintf("%s#%d", name, i), Orig: bytes.Clone(d[pos : pos+j])})
+		pos += j + 1
+	}
+	trueOff[k-1] = pos
+	if pos >= len(d) || d[pos] != 0xFF {
+		return nil, fmt.Errorf("第 %d 個項目之後應為結尾的 0xFF", k-1)
+	}
+	if pos != len(d)-1 {
+		return nil, fmt.Errorf("結尾 0xFF 之後還有 %d 個多餘位元組", len(d)-1-pos)
+	}
+	// 偏移表與真實起點的差。
+	bias := 0
+	first := -1
+	for i := range offs {
+		if offs[i] != trueOff[i] {
+			first = i
+			break
+		}
+	}
+	if first >= 0 {
+		if kind != KindCountry {
+			return nil, fmt.Errorf("偏移 %d 為 %d，與依 NUL 切出的起點 %d 不符（此檔偏移表應精確）", first, offs[first], trueOff[first])
+		}
+		for i := first; i < k; i++ {
+			if offs[i]-trueOff[i] != countryBiasAmount {
+				return nil, fmt.Errorf("偏移 %d 與真實起點相差 %d，COUNTRY.MES 只容許從某一項起一律多 %d", i, offs[i]-trueOff[i], countryBiasAmount)
+			}
+		}
+		bias = first
+	}
+	return &File{Name: name, Kind: kind, Items: items, countryBias: bias}, nil
+}
+
+// serializeMES 由項目重建檔案。bias 大於 0 時，偏移 bias 起（含末偏移）多 countryBiasAmount。
+func serializeMES(items [][]byte, bias int) ([]byte, error) {
+	k := len(items) + 1
+	if k > 0xFFFF {
+		return nil, fmt.Errorf("項目數 %d 超過 u16 上限", len(items))
+	}
+	head := 2 + 4*k
+	size := head + 1
+	for _, it := range items {
+		size += len(it) + 1
+	}
+	out := make([]byte, 0, size)
+	out = putU16(out, k)
+	pos := head
+	for i := 0; i < k; i++ {
+		off := pos
+		if bias > 0 && i >= bias {
+			off += countryBiasAmount
+		}
+		out = putU32(out, off)
+		if i < len(items) {
+			pos += len(items[i]) + 1
+		}
+	}
+	for _, it := range items {
+		out = append(out, it...)
+		out = append(out, 0)
+	}
+	out = append(out, 0xFF)
+	return out, nil
+}
diff --git a/apps/hr/l10n/mes_test.go b/apps/hr/l10n/mes_test.go
new file mode 100644
index 0000000..7bce6d6
--- /dev/null
+++ b/apps/hr/l10n/mes_test.go
@@ -0,0 +1,216 @@
+package l10n
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+// 手寫的位元組：K ＝ 3，兩個項目 "AB" 與 "CD\nE"。
+//
+//	03 00                      K
+//	0E 00 00 00                偏移 0 ＝ 2 + 4 x 3 ＝ 14
+//	11 00 00 00                偏移 1 ＝ 14 + 3 ＝ 17
+//	16 00 00 00                偏移 2 ＝ 17 + 5 ＝ 22（指向 FF）
+//	41 42 00  43 44 0A 45 00  FF
+var mesLiteral = []byte{
+	0x03, 0x00,
