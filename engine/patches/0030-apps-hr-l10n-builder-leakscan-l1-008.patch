+const (
+	txtA = t1 + t2 // 一二
+	txtB = t2 + t3 // 二三
+	txtC = t4 + t5 // 上下
+)
+
+func uwasaFile(t *testing.T) *File {
+	// 項目 0、2、4 內容相同（原項目位元組相同的群組）。
+	return mustParse(t, "UWASA.MES", buildMES([]string{"AA", "BB", "AA", "CC", "AA"}, 0))
+}
+
+func encOf(t *testing.T, cs *Charmap, s string) []byte {
+	t.Helper()
+	b, _, err := cs.Encode(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
