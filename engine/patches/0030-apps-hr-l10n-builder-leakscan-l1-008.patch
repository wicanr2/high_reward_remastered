+
+func TestHexBlobs(t *testing.T) {
+	b12 := "a4 40 a4 41 a4 42 a4 43 a4 44 a4 45"
+	cases := []struct {
+		name string
+		in   string
+		want int // 還原出的 blob 數
+		n    int // 第一個 blob 的長度
+	}{
+		{"12 個位元組，空白分隔", b12, 1, 12},
+		{"12 個位元組，連續", strings.ReplaceAll(b12, " ", ""), 1, 12},
+		{"11 個位元組不還原", b12[:len(b12)-3], 0, 0},
+		{"大小寫混用", "A4 40 a4 41 A4 42 a4 43 A4 44 a4 45", 1, 12},
+		{"tab 分隔", strings.ReplaceAll(b12, " ", "\t"), 1, 12},
+		{"0x 前綴不還原", "0x" + strings.ReplaceAll(b12, " ", ""), 0, 0},
+		{"夾在文字中", "dump: " + b12 + ".", 1, 12},
+		{"兩個空白不算單一分隔", strings.ReplaceAll(b12, " ", "  "), 0, 0},
+		{"奇數位十六進位", strings.ReplaceAll(b12, " ", "") + "f", 1, 12},
+		{"從單字中間不啟動", "zz" + strings.ReplaceAll(b12, " ", ""), 0, 0},
+	}
+	for _, tc := range cases {
+		got := hexBlobs([]byte(tc.in), hexMinBytes)
+		if len(got) != tc.want || (tc.want > 0 && len(got[0]) != tc.n) {
+			t.Errorf("%s：得到 %d 個 blob %v，要 %d 個（首個 %d bytes）", tc.name, len(got), got, tc.want, tc.n)
+		}
+	}
+	if got := hexBlobs([]byte(b12), hexMinBytes); len(got) == 1 && !bytes.Equal(got[0], []byte{0xa4, 0x40, 0xa4, 0x41, 0xa4, 0x42, 0xa4, 0x43, 0xa4, 0x44, 0xa4, 0x45}) {
+		t.Errorf("還原的位元組錯誤：% x", got[0])
+	}
+}
+
+// 標點占多數的片段（裝飾線）不是引用的證據：成排的標點不命中，也不會讓「全是標點」的視窗命中。
+func TestPunctuationOnlyNoFalsePositive(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		var sb strings.Builder
+		for _, line := range []string{
+			strings.Repeat("-", 80), strings.Repeat("=", 80), strings.Repeat(".", 40), "|---|---|---|",
+			strings.Repeat("*", 30), "...... ...... ......", strings.Repeat("!?", 20), strings.Repeat(",;:", 20),
+			strings.Repeat(cp(0x2500), 40), strings.Repeat(cp(0x2026), 10),
+			strings.Repeat(cp(0xff0c, 0x3002), 20), strings.Repeat(cp(0x203b), 20),
+		} {
+			sb.WriteString(line + "\n")
+			// 標點前後各接兩個字：成排的標點被夾在片段內部（頭尾的標點會被去掉，只有夾在中間才會形成視窗）。
+			sb.WriteString(codeText(w.filler(2)) + line + codeText(w.filler(2)) + "\n")
+		}
+		// 位元組形式：Big5 符號區的碼成排出現。
+		raw := bytes.Repeat(codeBytes(punctCodes(40)), 3)
+		rawEdge := codeBytes(w.filler(2), punctCodes(40), punctCodes(40), w.filler(2))
+		for name, content := range map[string][]byte{
+			"ASCII 與全形標點":   []byte(sb.String()),
+			"Big5 符號碼":      raw,
+			"Big5 符號碼夾在字之間": rawEdge,
+			"UTF-8 符號":      []byte(strings.Repeat(codeText(punctCodes(40)), 3)),
+			"UTF-8 符號夾在字之間": []byte(codeText(w.filler(2)) + codeText(punctCodes(40)) + codeText(w.filler(2))),
+		} {
+			if hits := w.scan(content); len(hits) != 0 {
+				t.Errorf("%s：%s命中 %d 個單位（標點占多數的片段不應命中）", w.name, name, len(hits))
+			}
+		}
+	})
+}
+
+// 位元組結構合法、x/text 卻解不出的雙位元組碼：單位標為 ByteOnly（沒有 UTF-8 文字），仍以位元組形式命中。
+func TestByteOnlyUnit(t *testing.T) {
+	big5Init()
+	bad := -1
+	for lead := 0x81; lead <= 0xFE && bad < 0; lead++ {
+		for trail := 0xA1; trail <= 0xFE; trail++ {
+			if big5Dec[lead<<8|trail] == 0 {
+				bad = lead<<8 | trail
+				break
+			}
+		}
+	}
+	if bad < 0 {
+		t.Skip("x/text 的 Big5 表涵蓋全部結構合法的雙位元組碼")
+	}
+	p := newSynPool(0xC9, 0xE8, 21)
+	frag := codeBytes(p.take(3), []int{bad}, p.take(3))
+	files := synthFiles()
+	files["SP.MES"] = append(append(files["SP.MES"], 0x0A), frag...)
+	w := newWorld("byteonly", files)
+	var u Unit
+	found := false
+	for _, c := range w.units {
+		if bytes.Equal(c.Big5, frag) {
+			u, found = c, true
+		}
+	}
+	if !found {
+		t.Fatal("含不可解碼字的片段沒有成為單位")
+	}
+	if !u.ByteOnly || u.Text != "" {
+		t.Errorf("ByteOnly ＝ %v，Text 長度 %d：x/text 解不出時 Text 必須為空", u.ByteOnly, len(u.Text))
+	}
+	if !w.scan(append(append([]byte("x "), frag...), " y"...))[u.ID] {
+		t.Error("位元組形式沒有命中含不可解碼字的單位")
+	}
+}
diff --git a/apps/hr/l10n/leakscan/norm.go b/apps/hr/l10n/leakscan/norm.go
new file mode 100644
index 0000000..2f07c9f
--- /dev/null
+++ b/apps/hr/l10n/leakscan/norm.go
@@ -0,0 +1,309 @@
+package leakscan
+
+import (
+	"unicode"
+	"unicode/utf8"
+)
+
+// 正規化（docs/spec/008 第 3.9 節第 3 項）：單位與被掃檔案文字走同一條路徑。
+//
+// 字元串流先逐字元分類：
+//
+//	clsSplit   切斷：ASCII 英數、無法由 Big5 解出的字元（含 U+FFFD）。
+//	clsRemove  可移除：空白、控制字元、標記字元（反引號、星號、底線、">"、"|"、括號、引號等）。
+//	clsPunct   標點：其餘標點與符號，全形與半形視為同一個字元（統一成 punctRune），留在片段內。
+//	clsMember  片段成員：可由 Big5 解出的非標點字元（漢字等）。
+//
+// 一個「片段」是連續的成員與標點，頭尾的標點去掉。標點留在片段內，是為了讓單位片段的字數與
+// 規格定義（連續雙位元組字，標點也是雙位元組字）一致，6 字視窗才能跨過逗號。
+//
+// 可移除字元有兩種處理，兩種都做，命中取聯集（規格第 3.9 節第 3 項同時寫了「去掉標記」與
+// 「被 ASCII 或標記隔開的引用，各片段分別比」，兩句要兩種處理才都成立）：
+//
+//	連接（join）：可移除字元直接去掉，前後相連，所以行內被標記或跳脫換行切開的引用仍然命中。
+//	切開（split）：可移除字元當分隔，所以表格儲存格與逐行列出的短標籤各自成為一個片段。
+type cls uint8
+
+const (
+	clsSplit cls = iota
+	clsRemove
+	clsPunct
+	clsMember
+)
+
+// punctRune 是所有標點統一後的代表字元（U+3001，頓號）。
+const punctRune rune = 0x3001
+
+// asciiMarkers 是被視為標記而移除的 ASCII 字元。
+const asciiMarkers = "`*_><|[]{}()#^~\\\"'"
+
+var (
+	asciiCls [128]cls
+	bmpCls   [0x10000]cls
+)
+
+func init() {
+	for c := 0; c < 128; c++ {
+		switch {
+		case c <= 0x20 || c == 0x7F:
+			asciiCls[c] = clsRemove
+		case c >= '0' && c <= '9', c >= 'A' && c <= 'Z', c >= 'a' && c <= 'z':
+			asciiCls[c] = clsSplit
+		default:
+			asciiCls[c] = clsPunct
+		}
+	}
+	for i := 0; i < len(asciiMarkers); i++ {
+		asciiCls[asciiMarkers[i]] = clsRemove
+	}
+	big5Init()
+	for r := rune(0x80); r < 0x10000; r++ {
+		bmpCls[r] = classifyWide(r)
+	}
+}
+
+// classifyWide 分類非 ASCII 的 BMP 字元（已經過全形統一）。
+func classifyWide(r rune) cls {
+	switch {
+	case r == utf8.RuneError:
+		return clsSplit
+	case unicode.IsSpace(r), unicode.IsControl(r):
+		return clsRemove
+	case unicode.In(r, unicode.Ps, unicode.Pe, unicode.Pi, unicode.Pf):
+		return clsRemove // 括號與引號：全形、半形一視同仁
+	case unicode.Is(unicode.Cf, r):
+		return clsRemove // 格式字元（零寬空白 U+200B、零寬連接 U+200D、BOM U+FEFF、軟連字號 U+00AD）：看不見，插在文字中間不能使引用失效
+	case !inBig5(r):
+		return clsSplit // 原版不可能出現的字元（簡體專用字、emoji…）：不能構成引用，切斷
+	case unicode.IsPunct(r), unicode.IsSymbol(r):
+		return clsPunct
+	}
+	return clsMember
+}
+
+// classify 分類已統一寬度的字元。
+func classify(r rune) cls {
+	switch {
+	case r < 0:
+		return clsSplit
+	case r < 0x80:
+		return asciiCls[r]
+	case r < 0x10000:
+		return bmpCls[r]
+	case r >= puaBase && r < puaBase+0x10000:
+		return clsMember // x/text 解不出的雙位元組碼（只在位元組形式出現）
+	}
+	return clsSplit
+}
+
+// isFullwidthAlnum 回報 r 是否是全形數字或全形英文字母（U+FF10 至 U+FF19、U+FF21 至 U+FF3A、U+FF41 至 U+FF5A）。
+func isFullwidthAlnum(r rune) bool {
+	return r >= 0xFF10 && r <= 0xFF19 || r >= 0xFF21 && r <= 0xFF3A || r >= 0xFF41 && r <= 0xFF5A
+}
+
+// unify 統一全形與半形標點：全形 ASCII 標點與符號（U+FF01 至 U+FF5E 內，除全形英數）變半形，全形空白變空白。
+// 全形英數不變：它們是原版字模內的雙位元組字，也是單位片段的成員（規格：片段是連續雙位元組字）；
+// 半形英數則切斷片段（規格：被 ASCII 隔開的引用各片段分別比），兩者不互相等同。
+// 若把全形英數也變成半形，含全形英數的單位（SHOPTAB 的名稱有近半數）會被切成不足 3 字的碎片而失去查找鍵。
+func unify(r rune) rune {
+	if r >= 0xFF01 && r <= 0xFF5E {
+		if isFullwidthAlnum(r) {
+			return r
+		}
+		return r - 0xFEE0
+	}
+	if r == 0x3000 {
+		return ' '
+	}
+	return r
+}
+
+// 跳脫還原的開關（供突變驗證切換）：unescapeOn 控制 \n、\r、\t、\\；uEscapeOn 控制 \uXXXX 與 \UXXXXXXXX。
+const (
+	unescapeOn = true
+	uEscapeOn  = true
+)
+
+// parseHexRunes 把 rs 開頭的 n 個十六進位字元解成碼位；不足 n 個或含非十六進位字元回 false。
+func parseHexRunes(rs []rune, n int) (rune, bool) {
+	if len(rs) < n {
+		return 0, false
+	}
+	var v rune
+	for _, r := range rs[:n] {
+		if r > 0x7F || !isHexDigit(byte(r)) {
+			return 0, false
+		}
+		v = v<<4 | rune(hexVal(byte(r)))
+		if v > 0x10FFFF {
+			return utf8.RuneError, true // 超出碼位範圍：吃掉這個跳脫，但得到切斷用的字元
+		}
+	}
+	if v >= 0xD800 && v <= 0xDFFF {
+		return utf8.RuneError, true // 單獨的代理碼位
+	}
+	return v, true
+}
+
+// runsOf 把字元串流切成片段並逐一交給 emit（emit 不得保留切片）。join 為真走「連接」，否則走「切開」。
+// 跳脫還原：\n、\r、\t 視為空白類（可移除字元），\\ 視為一個反斜線（標記），
+// \uXXXX 與 \UXXXXXXXX 還原成該碼位的字元（JSON 的 ensure_ascii 輸出、Go 與 Python 原始碼的字串常值）。
+func runsOf(rs []rune, join bool, cur []rune, emit func(run []rune)) []rune {
+	cur = cur[:0]
+	flush := func() {
+		s, e := 0, len(cur)
+		for s < e && cur[s] == punctRune {
+			s++
+		}
+		for e > s && cur[e-1] == punctRune {
+			e--
+		}
+		if e > s {
+			emit(cur[s:e])
+		}
+		cur = cur[:0]
+	}
+	for i := 0; i < len(rs); i++ {
+		r := rs[i]
+		if unescapeOn && r == '\\' && i+1 < len(rs) {
+			switch rs[i+1] {
+			case 'n', 'r', 't':
+				r = ' '
+				i++
+			case '\\':
+				i++
+			case 'u', 'U':
+				if !uEscapeOn {
+					break
+				}
+				n := 4
+				if rs[i+1] == 'U' {
+					n = 8
+				}
+				if v, ok := parseHexRunes(rs[i+2:], n); ok {
+					r = v
+					i += 1 + n
+				}
+			}
+		}
+		r = unify(r)
+		switch classify(r) {
+		case clsSplit:
+			flush()
+		case clsRemove:
+			if !join {
+				flush()
+			}
+		case clsPunct:
+			cur = append(cur, punctRune)
+		case clsMember:
+			cur = append(cur, r)
+		}
+	}
+	flush()
+	return cur
+}
+
+// hexMinBytes 是十六進位拼寫還原成位元組的最短長度。
+const hexMinBytes = 12
+
+func isHexDigit(c byte) bool {
+	return c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F'
+}
+
+func isAlnum(c byte) bool {
+	return c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
+}
+
+func hexVal(c byte) byte {
+	switch {
+	case c >= '0' && c <= '9':
+		return c - '0'
+	case c >= 'a' && c <= 'f':
+		return c - 'a' + 10
+	}
+	return c - 'A' + 10
+}
+
+// hexBlobs 找出十六進位拼寫（`A4 41 …`、`a441…`，位元組對之間可有單一空白或定位字元）並還原成位元組。
+// 只還原 >= minBytes 個位元組的拼寫，且必須從單字（英數序列）的開頭開始（所以 `0x`、`\x` 前綴不還原，已知漏報）。
+func hexBlobs(b []byte, minBytes int) [][]byte {
+	var out [][]byte
+	for i := 0; i < len(b); {
+		if !isHexDigit(b[i]) || (i > 0 && isAlnum(b[i-1])) {
+			i++
+			continue
+		}
+		j := i
+		var blob []byte
+		for j+1 < len(b) && isHexDigit(b[j]) && isHexDigit(b[j+1]) {
+			blob = append(blob, hexVal(b[j])<<4|hexVal(b[j+1]))
+			j += 2
+			if j+2 < len(b) && (b[j] == ' ' || b[j] == '\t') && isHexDigit(b[j+1]) && isHexDigit(b[j+2]) {
+				j++
+			}
+		}
+		if len(blob) >= minBytes {
+			out = append(out, blob)
+		}
+		if j > i {
+			i = j
+		} else {
+			i++
+		}
+	}
+	return out
+}
+
+// escapedHexAt 辨認位置 i 的一個位元組記號：`\xHH`（kind 1）或 `0xHH`、`0XHH`（kind 2）。n 為記號長度，0 表示不是記號。
+func escapedHexAt(b []byte, i int) (val byte, n, kind int) {
+	if i+3 >= len(b) || !isHexDigit(b[i+2]) || !isHexDigit(b[i+3]) {
+		return 0, 0, 0
+	}
+	switch {
+	case b[i] == '\\' && b[i+1] == 'x':
+		kind = 1
+	case b[i] == '0' && (b[i+1] == 'x' || b[i+1] == 'X') && (i == 0 || !isAlnum(b[i-1])):
+		kind = 2
+	default:
+		return 0, 0, 0
+	}
+	return hexVal(b[i+2])<<4 | hexVal(b[i+3]), 4, kind
+}
+
+// maxEscapedGap 是 `0xHH` 記號之間最多容許的分隔字元數（逗號、空白、定位字元、換行，涵蓋 C、Go 的陣列常值與縮排）。
+const maxEscapedGap = 16
+
+// escapedHexBlobs 找出 `\xA4\x41…`（連續）與 `0xA4, 0x41, …`（以逗號、空白或換行分隔）形式的拼寫並還原成位元組，
+// 只還原 >= minBytes 個位元組的拼寫（與 hexBlobs 同門檻）。Python 與 Go 原始碼的位元組常值常用這兩種寫法。
+func escapedHexBlobs(b []byte, minBytes int) [][]byte {
+	var out [][]byte
+	for i := 0; i < len(b); {
+		v, n, kind := escapedHexAt(b, i)
+		if n == 0 {
+			i++
+			continue
+		}
+		blob := []byte{v}
+		j := i + n
+		for {
+			k := j
+			if kind == 2 {
+				for k < len(b) && k-j < maxEscapedGap && (b[k] == ',' || b[k] == ' ' || b[k] == '\t' || b[k] == '\n' || b[k] == '\r') {
+					k++
+				}
+			}
+			v2, n2, kind2 := escapedHexAt(b, k)
+			if n2 == 0 || kind2 != kind {
+				break
+			}
+			blob = append(blob, v2)
+			j = k + n2
+		}
+		if len(blob) >= minBytes {
+			out = append(out, blob)
+		}
+		i = j
+	}
+	return out
+}
diff --git a/apps/hr/l10n/leakscan/norm_test.go b/apps/hr/l10n/leakscan/norm_test.go
new file mode 100644
index 0000000..c7eb460
--- /dev/null
+++ b/apps/hr/l10n/leakscan/norm_test.go
@@ -0,0 +1,388 @@
+package leakscan
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode/utf8"
+)
+
+// worldWith 是在合成世界的 SP.MES 後面追加幾個段所得到的世界。
+func worldWith(extra ...[]byte) *world {
+	files := synthFiles()
+	for _, seg := range extra {
+		files["SP.MES"] = append(append(files["SP.MES"], 0x0A), seg...)
+	}
+	return newWorld("合成", files)
+}
+
+// unitOf 以片段位元組找單位。
+func (w *world) unitOf(t *testing.T, frag []byte) Unit {
+	t.Helper()
+	for _, u := range w.units {
+		if bytes.Equal(u.Big5, frag) {
+			return u
+		}
+	}
+	t.Fatalf("找不到片段位元組對應的單位")
+	return Unit{}
+}
+
+// codeOf 回傳解成 r 的 Big5 碼；找不到回 -1。
+func codeOf(r rune) int {
+	big5Init()
+	for code, d := range big5Dec {
+		if d == r {
+			return code
+		}
+	}
+	return -1
+}
+
+// jsonEscape 以 \uXXXX（BMP）或 \UXXXXXXXX 寫出非 ASCII 字元（Python json.dump 預設的 ensure_ascii 輸出）。
+func jsonEscape(s string, upper bool) string {
+	var sb strings.Builder
+	for _, r := range s {
+		switch {
+		case r < 0x80:
+			sb.WriteRune(r)
+		case r <= 0xFFFF && upper:
+			fmt.Fprintf(&sb, "\\u%04X", r)
+		case r <= 0xFFFF:
+			fmt.Fprintf(&sb, "\\u%04x", r)
+		default:
+			fmt.Fprintf(&sb, "\\U%08x", r)
+		}
+	}
+	return sb.String()
+}
+
+// \uXXXX 與 \UXXXXXXXX 跳脫還原：JSON 的 ensure_ascii 輸出、Go 與 Python 原始碼的字串常值。
+func TestUnicodeEscapes(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		u := w.pick(t, 12, 40)
+		rs, _ := clean(u)
+		half := string(rs[:len(rs)/2+1]) // 至少 7 字：視窗命中
+		cases := map[string]string{
+			"小寫":         jsonEscape(u.Text, false),
+			"大寫":         jsonEscape(u.Text, true),
+			"JSON 物件":    `{"text": "` + jsonEscape(u.Text, false) + `", "n": 3}`,
+			"半句":         "x = '" + jsonEscape(half, false) + "'",
+			"混用原字元與跳脫":   string(rs[:3]) + jsonEscape(string(rs[3:]), false),
+			"\\U 八位數":    strings.ReplaceAll(jsonEscape(u.Text, false), `\u`, `\U0000`),
+			"跳脫之間夾標記與換行": jsonEscape(string(rs[:3]), false) + `**\n` + jsonEscape(string(rs[3:]), false),
+		}
+		for name, content := range cases {
+			if !w.scan([]byte(content))[u.ID] {
+				t.Errorf("%s：%s 沒有命中 %s", w.name, name, u.ID)
+			}
+		}
+		// 無效的跳脫不得 panic，也不連接兩半：位數不足、非十六進位、單獨的代理碼位、超出碼位範圍。
+		// 用 6 至 8 字的單位：兩半都不足 6 字，才看得出有沒有連接。
+		short := w.pick(t, 6, 8)
+		srs, _ := clean(short)
+		l, r := string(srs[:len(srs)/2]), string(srs[len(srs)/2:])
+		bs := "\\" // 反斜線（原始碼不直接寫 \u 加十六進位，避免被編輯工具轉成字元）
+		for _, bad := range []string{bs + "u12", bs + "uZZZZ", bs + "ud800", bs + "U00110000", bs + "U0000", bs + "u"} {
+			if w.scan([]byte(l + bad + r))[short.ID] {
+				t.Errorf("%s：無效跳脫 %q 不應連接兩半", w.name, bad)
+			}
+		}
+		// 對照：有效的跳脫在同一個位置照樣連接（兩半各 3 至 4 字，連接後才是整個單位）。
+		if !w.scan([]byte(l + jsonEscape(string(srs[len(srs)/2:len(srs)/2+1]), false) + string(srs[len(srs)/2+1:])))[short.ID] {
+			t.Errorf("%s：夾一個有效跳脫的 6 至 8 字單位沒有命中 %s", w.name, short.ID)
+		}
+	})
+}
