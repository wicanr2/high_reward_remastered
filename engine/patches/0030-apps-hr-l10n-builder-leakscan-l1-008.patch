+// 已存在的目錄驗證失敗：不搬動、不刪除舊目錄（inode 與內容不變），改建 -2。
+func TestBuildExistingInvalidIsNotMoved(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	cfg := poolCfg(w, root)
+	r1 := mustBuild(t, cfg)
+	corruptPack(t, r1.Dir)
+	st1, err := os.Stat(r1.Dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	snap := listFiles(t, r1.Dir)
+
+	r2 := mustBuild(t, cfg)
+	if r2.Reused || filepath.Base(r2.Dir) != filepath.Base(r1.Dir)+"-2" {
+		t.Fatalf("應建 -2：Reused=%v dir=%s", r2.Reused, filepath.Base(r2.Dir))
+	}
+	st2, err := os.Stat(r1.Dir)
+	if err != nil || !os.SameFile(st1, st2) {
+		t.Errorf("舊目錄被搬動或換掉了（inode 不同）：%v", err)
+	}
+	now := listFiles(t, r1.Dir)
+	if len(now) != len(snap) {
+		t.Error("舊目錄的內容被動過")
+	}
+	for k, v := range snap {
