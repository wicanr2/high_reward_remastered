+func TestBuildIdentityAndVerify(t *testing.T) {
+	s := newSynthOrig(t)
+	out := t.TempDir()
+	code, stdout, errOut := exec("", "build", "-code", "zh-TW", "-mode", "identity", "-orig", s.dir, "-out", out)
+	if code != 0 {
+		t.Fatalf("退出碼 %d：%s", code, errOut)
+	}
+	kv := parseKV(stdout)
+	if kv["reused"] != "false" || !filepath.IsAbs(kv["dir"]) || len(kv["manifest-sha256"]) != 64 {
+		t.Fatalf("stdout 格式不符：%q", stdout)
+	}
+	if sha, err := verify.ManifestSHA256(kv["dir"]); err != nil || sha != kv["manifest-sha256"] {
+		t.Errorf("印出的 manifest 雜湊不符：%s（%v）", kv["manifest-sha256"], err)
+	}
+	// identity 包與原檔逐位元組相同
+	for _, n := range []string{"COUNTRY.MES", "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES", "ESPMES.MRG", "SHOPTAB.TBL", "CFONT.15"} {
+		got, err := os.ReadFile(filepath.Join(kv["dir"], "files", n))
+		want, _ := os.ReadFile(filepath.Join(s.dir, n))
+		if err != nil || string(got) != string(want) {
+			t.Errorf("%s 與原檔不同（%v）", n, err)
+		}
+	}
+	// 第二次：重用
+	code, stdout2, errOut := exec("", "build", "-code", "zh-TW", "-mode", "identity", "-orig", s.dir, "-out", out)
+	kv2 := parseKV(stdout2)
+	if code != 0 || kv2["reused"] != "true" || kv2["dir"] != kv["dir"] || kv2["manifest-sha256"] != kv["manifest-sha256"] {
+		t.Errorf("第二次應重用：%d %q %s", code, stdout2, errOut)
+	}
+
+	// verify：不帶 -digest 略過摘要，印出 manifest 雜湊
+	code, vout, verr := exec("", "verify", "-orig", s.dir, kv["dir"])
+	if code != 0 || strings.TrimSpace(vout) != "manifest-sha256="+kv["manifest-sha256"] {
+		t.Errorf("verify：%d %q %s", code, vout, verr)
+	}
+	// 帶正確與錯誤的 -digest
+	d, err := l10n.ExpectedDigest(l10n.Config{Code: "zh-TW", Mode: l10n.ModeIdentity, OrigHashes: s.hashes})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if code, _, e := exec("", "verify", "-digest", d, "-orig", s.dir, kv["dir"]); code != 0 {
+		t.Errorf("正確的 -digest：%d %s", code, e)
+	}
+	wrong := strings.Replace(d, d[:4], "ffff", 1)
+	if code, vout, e := exec("", "verify", "-digest", wrong, "-orig", s.dir, kv["dir"]); code != 1 || vout != "" || !strings.Contains(e, "digest") {
+		t.Errorf("錯誤的 -digest 應失敗：%d %q %s", code, vout, e)
+	}
+	// 竄改包內一個檔：verify 必須失敗（負對照）
+	p := filepath.Join(kv["dir"], "files", "SP.MES")
+	b, _ := os.ReadFile(p)
+	b[len(b)/2] ^= 0xFF
+	if err := os.WriteFile(p, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if code, vout, e := exec("", "verify", "-orig", s.dir, kv["dir"]); code != 1 || vout != "" || !strings.Contains(e, "file-hash") {
+		t.Errorf("竄改後 verify 應失敗：%d %q %s", code, vout, e)
+	}
+	// 竄改過的目錄再 build：不搬動，改建 -2
+	code, stdout3, errOut := exec("", "build", "-code", "zh-TW", "-mode", "identity", "-orig", s.dir, "-out", out)
+	kv3 := parseKV(stdout3)
+	if code != 0 || kv3["reused"] != "false" || kv3["dir"] != kv["dir"]+"-2" {
+		t.Errorf("竄改後 build 應改建 -2：%d %q %s", code, stdout3, errOut)
+	}
+}
