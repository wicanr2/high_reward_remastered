+		pRaw := writeFile(t, root, "m/raw.bin", append(append([]byte{0}, long.Big5[:12]...), 0))
+		writeFile(t, root, "clean.txt", []byte("nothing to see here: %s %d\n"))
+
+		code, out, errOut := runMain("", "-orig", w.orig, root)
+		if code != ExitHits {
+			t.Fatalf("退出碼 ＝ %d，要 %d；stderr：%s", code, ExitHits, errOut)
+		}
+		got := map[string]map[string]bool{}
