+func TestAdoptAccSHAMismatchIsCandidate(t *testing.T) {
+	cs := mustCharmap(t)
+	f := uwasaFile(t)
+	edited := mkRow(f, 1, StatusAccepted, txtA)
+	edited.Text = txtB // 接受之後改了 text：acc_sha 不再相符
+	empty := mkRow(f, 3, StatusAccepted, txtC)
+	empty.AccSHA = ""
+	tb := &Table{Rows: []Row{edited, empty}}
+	repl, n, viol, err := tb.Adopt(f, Policy{}, cs, nil)
+	if err != nil || len(viol) != 0 || n != 0 || len(repl) != 0 {
+		t.Errorf("acc_sha 不符或為空的 accepted 要視為 candidate，預設不採用：採用 %d 違規 %v err %v", n, viol, err)
+	}
+	repl, n, _, _ = tb.Adopt(f, Policy{WithCandidates: true}, cs, nil)
+	if n != 2 || !bytes.Equal(repl["UWASA.MES#1"], encOf(t, cs, txtB)) {
+		t.Errorf("WithCandidates 下它們才被採用：採用 %d", n)
+	}
+	// acc_sha 相符的 accepted 預設就採用。
+	ok := &Table{Rows: []Row{mkRow(f, 1, StatusAccepted, txtB)}}
+	if _, n, _, _ := ok.Adopt(f, Policy{}, cs, nil); n != 1 {
+		t.Errorf("acc_sha 相符的 accepted 採用 %d 列", n)
+	}
+}
