+// 語言包驗證（docs/spec/008 第 3.2 節、第 8 節 manifest 驗證列）。包是測試自造的，內容是假位元組。
+
+const goodDigest = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+
+type testPack struct {
+	root  string
+	m     *Manifest
+	files map[string][]byte
+	orig  map[string]string
+}
+
+func sum(b []byte) string {
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:])
+}
+
+// newTestPack 在暫存目錄寫一個合法的語言包：三個檔案，九個原版輸入雜湊，輸入摘要 goodDigest。
+func newTestPack(t *testing.T) *testPack {
+	t.Helper()
+	p := &testPack{
+		root:  t.TempDir(),
+		files: map[string][]byte{"CFONT.15": []byte("font-bytes"), "SP.MES": []byte("sp-bytes-0123456789"), "SYSTEM.MES": []byte("sys")},
+		orig:  map[string]string{},
+	}
+	for i, n := range InputNames() {
+		p.orig[n] = sum([]byte{byte(i), 'o'})
+	}
+	p.m = &Manifest{
+		Format: ManifestFormat, Code: "zh-TW", Policy: Policy{Mode: "table"},
+		OrigInputs: copyMap(p.orig), TableHash: sum(nil), TableFormat: "tsv-1", BuilderVersion: "abcd1234",
+		InputDigest: goodDigest, Adopted: 2,
+	}
+	if err := os.MkdirAll(filepath.Join(p.root, FilesDir), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for _, n := range []string{"CFONT.15", "SP.MES", "SYSTEM.MES"} {
+		b := p.files[n]
+		if err := os.WriteFile(filepath.Join(p.root, FilesDir, n), b, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		p.m.Files = append(p.m.Files, FileEntry{Name: n, SHA256: sum(b), Size: int64(len(b))})
+	}
+	p.writeManifest(t)
+	return p
+}
+
+func copyMap(m map[string]string) map[string]string {
+	out := map[string]string{}
+	for k, v := range m {
+		out[k] = v
+	}
+	return out
+}
+
+func (p *testPack) writeManifest(t *testing.T) {
+	t.Helper()
+	raw, err := p.m.Marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(p.root, ManifestName), raw, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func (p *testPack) opt() Options {
+	return Options{OrigHashes: copyMap(p.orig), ExpectDigest: goodDigest}
+}
+
+// wantCode 要求 err 是原因鍵為 code 的驗證錯誤。
+func wantCode(t *testing.T, what string, err error, code string) {
+	t.Helper()
+	if err == nil {
+		t.Errorf("%s：應失敗（%s），實際通過", what, code)
+		return
+	}
+	var ve *Error
+	if !errors.As(err, &ve) || ve.Code != code {
+		t.Errorf("%s：應為 %s，實際 %v", what, code, err)
+	}
+}
+
+func TestVerifyOK(t *testing.T) {
+	p := newTestPack(t)
+	m, err := Verify(p.root, p.opt())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.Code != "zh-TW" || len(m.Files) != 3 || m.Adopted != 2 || m.InputDigest != goodDigest {
+		t.Errorf("回傳的 manifest 不符：%+v", m)
+	}
+	// 原版雜湊的鍵大小寫不分；多出的鍵（例如 required.tsv 的其他檔案）被忽略
+	o := p.opt()
+	o.OrigHashes = map[string]string{}
+	for k, v := range p.orig {
+		o.OrigHashes[strings.ToLower(k)] = v
+	}
+	o.OrigHashes["ALCOHOL.MID"] = sum(nil)
+	if _, err := Verify(p.root, o); err != nil {
+		t.Errorf("小寫鍵與多餘的鍵：%v", err)
+	}
+	// 包根（files/ 之外）的其他檔案不影響驗證（重用判斷用包根的哨兵檔）
