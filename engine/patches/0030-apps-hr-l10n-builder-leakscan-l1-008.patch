+// manifest 被改過（輸入摘要、原版輸入雜湊、檔案列表）的同名目錄驗證失敗：不重用、不搬動，改建 -2。
+func TestBuildReuseRejectsTamperedManifest(t *testing.T) {
+	for name, mut := range map[string]func(*verify.Manifest){
+		"輸入摘要":    func(m *verify.Manifest) { m.InputDigest = strings.Repeat("0", 64) },
+		"原版輸入雜湊":  func(m *verify.Manifest) { m.OrigInputs["MAIN.EXE"] = strings.Repeat("0", 64) },
+		"檔案列表少一項": func(m *verify.Manifest) { m.Files = m.Files[1:] },
+	} {
+		w := newSynthWorld(t)
+		root := t.TempDir()
+		cfg := poolCfg(w, root)
+		r1 := mustBuild(t, cfg)
+		p := filepath.Join(r1.Dir, verify.ManifestName)
+		raw, err := os.ReadFile(p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		m, err := verify.ParseManifest(raw)
+		if err != nil {
+			t.Fatal(err)
+		}
+		mut(m)
+		raw, err = m.Marshal()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, raw, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		r2 := mustBuild(t, cfg)
+		if r2.Reused || filepath.Base(r2.Dir) != filepath.Base(r1.Dir)+"-2" {
+			t.Errorf("%s被改過的目錄不該重用：Reused=%v dir=%s", name, r2.Reused, filepath.Base(r2.Dir))
+		}
+	}
+}
