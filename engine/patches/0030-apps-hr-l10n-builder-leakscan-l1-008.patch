+			_, _, viol, err := tb.Adopt(c.f, c.pol, cs, nil)
+			if err != nil || len(viol) != 1 || !containsAll(viol[0], c.f.Name, c.flagName, c.f.Items[0].ID) {
+				t.Errorf("%s 的 %s 列、旗標未開：要失敗並點名檔案與旗標：%v（err %v）", c.f.Name, status, viol, err)
+			}
+			// 預設政策下 candidate 本來不採用，但旗標檢查看列的 status，不看採用結果。
+			repl, n, viol, err := tb.Adopt(c.f, c.polOn, cs, nil)
+			if err != nil || len(viol) != 0 {
+				t.Errorf("%s 旗標開啟：%v %v", c.f.Name, viol, err)
+			}
+			wantN := 0
+			if status == StatusAccepted {
+				wantN = 1
+			}
+			if n != wantN || len(repl) != wantN {
+				t.Errorf("%s 旗標開啟，%s 列：採用 %d，應為 %d", c.f.Name, status, n, wantN)
+			}
+		}
+		// 全部 keep：不需要旗標。
+		tb := &Table{Rows: []Row{mkRow(c.f, 0, StatusKeep, ""), mkRow(c.f, 1, StatusKeep, "")}}
+		if _, n, viol, err := tb.Adopt(c.f, c.pol, cs, nil); err != nil || len(viol) != 0 || n != 0 {
+			t.Errorf("%s 全部 keep 不需旗標：%v %v", c.f.Name, viol, err)
+		}
+	}
+}
