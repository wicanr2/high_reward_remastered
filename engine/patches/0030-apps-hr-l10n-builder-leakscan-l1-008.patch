+// 256 值逐點對照：S 集、P 集的分類對照 `docs/spec/008` 第 2 節的範圍（範圍寫死在這裡）；
+// 00 與 0A 是迴圈頂端的終止值，不屬 S 集或 P 集的分類結果。
+func TestClassify256(t *testing.T) {
+	inS := func(b int) bool { return b >= 0x20 && b <= 0x7E || b >= 0xA1 && b <= 0xDF }
+	inP := func(b int) bool { return b >= 0x01 && b <= 0x1F || b >= 0x7F && b <= 0xA0 || b >= 0xE0 && b <= 0xFF }
+	var nS, nP, nEnd int
+	for b := 0; b < 256; b++ {
+		var want class
+		switch {
+		case b == 0x00 || b == 0x0A:
+			want = classEnd
+			nEnd++
+		case inS(b):
+			want = classS
+			nS++
+		case inP(b):
+			want = classP
+			nP++
+		default:
+			t.Fatalf("測試的範圍有洞：%02X 不屬任何一類", b)
+		}
+		if got := classify(byte(b)); got != want {
+			t.Errorf("classify(%02X) = %d，要 %d", b, got, want)
+		}
+	}
+	// 158 個 S 集（95 加 63）、96 個 P 集（30 加 34 加 32）、2 個終止值
+	if nS != 158 || nP != 96 || nEnd != 2 {
+		t.Fatalf("計數 S=%d P=%d 終止=%d，要 158、96、2", nS, nP, nEnd)
+	}
+}
