+// `\xA4\x41…` 與 `0xA4, 0x41, …` 形式的拼寫（Python 與 Go 原始碼的位元組常值）。
+func TestEscapedHexBlobs(t *testing.T) {
+	bs := []byte{0xa4, 0x40, 0xa4, 0x41, 0xa4, 0x42, 0xa4, 0x43, 0xa4, 0x44, 0xa4, 0x45}
+	bsx := func(sep string, prefix string, n int) string {
+		parts := make([]string, n)
+		for i := 0; i < n; i++ {
+			parts[i] = prefix + fmt.Sprintf("%02x", bs[i%len(bs)])
+		}
+		return strings.Join(parts, sep)
+	}
+	cases := []struct {
+		name string
+		in   string
+		want int
+		n    int
+	}{
+		{"\\x 連續 12 個", bsx("", `\x`, 12), 1, 12},
+		{"\\x 連續 11 個不還原", bsx("", `\x`, 11), 0, 0},
+		{"\\x 夾在字串常值中", `b"` + bsx("", `\x`, 12) + `"`, 1, 12},
+		{"0x 逗號空白 12 個", bsx(", ", "0x", 12), 1, 12},
+		{"0x 11 個不還原", bsx(", ", "0x", 11), 0, 0},
+		{"0x 大寫 X", strings.ReplaceAll(bsx(",", "0x", 12), "0x", "0X"), 1, 12},
+		{"0x 換行與縮排", "{\n\t" + bsx(",\n\t", "0x", 12) + ",\n}", 1, 12},
+		{"0x 只有空白分隔", bsx(" ", "0x", 12), 1, 12},
+		{"0x 起點前是英數不啟動", "z" + bsx(",", "0x", 12), 0, 0},
+		{"0x 分隔太長不連接", bsx(strings.Repeat(" ", 20), "0x", 12), 0, 0},
+		{"\\x 與 0x 混用不連接", bsx("", `\x`, 6) + bsx(",", "0x", 6), 0, 0},
+		{"\\x 之間有空白不連接", bsx(" ", `\x`, 12), 0, 0},
+	}
+	for _, tc := range cases {
+		got := escapedHexBlobs([]byte(tc.in), hexMinBytes)
+		if len(got) != tc.want || (tc.want > 0 && len(got[0]) != tc.n) {
+			t.Errorf("%s：得到 %d 個 blob，要 %d 個（首個 %d bytes）", tc.name, len(got), tc.want, tc.n)
+		}
+	}
+	if got := escapedHexBlobs([]byte(bsx("", `\x`, 12)), hexMinBytes); len(got) == 1 && !bytes.Equal(got[0], bs) {
+		t.Errorf("還原的位元組錯誤：% x", got[0])
+	}
+}
