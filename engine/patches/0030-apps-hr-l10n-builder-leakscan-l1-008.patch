+	markers := []string{"`", "*", "**", "_", ">", "|", "[", "]", " | ", " ", "\t", "\n", "\r\n", "`*`",
+		cp(0xff0a), cp(0x3000), cp(0x300c), cp(0x300d), "(", ")", cp(0xff08), cp(0xff09), "\"", "'", "{", "}", "#", "~"}
