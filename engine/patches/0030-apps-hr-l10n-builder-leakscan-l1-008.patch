+	// 以 lead 與 trail 兩個位元組判定：只有 (A4, 44) 之後算標點折點，折在第 5 個字之後，第二列剛好 15 個字
+	in.Trans = pairs(0xA4, 0x40, 20)
+	in.BreakAfter = func(lead, trail byte) bool { return lead == 0xA4 && trail == 0x44 }
+	want := cat(pairs(0xA4, 0x40, 5), nl, pairs(0xA4, 0x45, 15))
+	if out := wrapped(t, in); !bytes.Equal(out, want) {
+		t.Fatalf("(A4, 44) 標點：折行結果 %x，要 %x", out, want)
+	}
+
+	// 全部不算標點：回到第一列填滿
+	in.BreakAfter = func(byte, byte) bool { return false }
+	want = cat(pairs(0xA4, 0x40, 15), nl, pairs(0xA4, 0x4F, 5))
+	if out := wrapped(t, in); !bytes.Equal(out, want) {
+		t.Fatalf("無標點：折行結果 %x，要 %x", out, want)
+	}
+
+	// lead 在 A2 的字由呼叫端宣告成標點：在 A2 B0 之後折
+	in.Trans = cat(pairs(0xA4, 0x40, 9), hb("A2 AF A2 B0"), pairs(0xA4, 0x50, 9))
+	in.BreakAfter = func(lead, _ byte) bool { return lead == 0xA2 }
+	want = cat(pairs(0xA4, 0x40, 9), hb("A2 AF A2 B0"), nl, pairs(0xA4, 0x50, 9))
+	if out := wrapped(t, in); !bytes.Equal(out, want) {
+		t.Fatalf("A2 標點：折行結果 %x，要 %x", out, want)
+	}
+
+	// nil 回到預設：A1 才算標點，A2 不算
+	in.BreakAfter = nil
+	want = cat(pairs(0xA4, 0x40, 9), hb("A2 AF A2 B0"), pairs(0xA4, 0x50, 4), nl, pairs(0xA4, 0x54, 5))
+	if out := wrapped(t, in); !bytes.Equal(out, want) {
+		t.Fatalf("預設標點：折行結果 %x，要 %x", out, want)
+	}
+}
+
+// 最後一列的 `1676` 檢查有兩個方向（`newWrapper` 的 `b < n || l.term`）：
+// 原行以 0x0A 結尾時，最後一列後面接的是那個 0x0A，必須通過模擬；原行以項目結尾時，NUL 不會被吃，不檢查。
+func TestAutoWrapLastPiece1676(t *testing.T) {
+	// 以 0x0A 結尾的行，最後一列固定以 A4 E0 結尾，任何折法都會吃掉那個換行：找不到合格折點
+	in := okInput()
+	in.Trans = cat(pairs(0xA4, 0x40, 19), hb("A4 E0"), nl, pairs(0xA4, 0x40, 2))
+	out, vs := AutoWrap(in)
+	wantRules(t, vs, RuleLineWidth)
+	if len(vs) != 1 || vs[0].Detail != "line=0 no-breakpoint" {
+		t.Fatalf("違規 %+v，要 line=0 no-breakpoint", vs)
+	}
+	if !bytes.Equal(out, in.Trans) {
+		t.Fatalf("找不到折點的行要維持原樣：%x", out)
+	}
+
+	// 以項目結尾的行，最後一列以 A4 E0 結尾是安全的：折成 15 加 5 個單位，沒有違規
+	in.Trans = cat(pairs(0xA4, 0x40, 19), hb("A4 E0"))
+	got := wrapped(t, in)
+	want := cat(pairs(0xA4, 0x40, 15), nl, pairs(0xA4, 0x4F, 4), hb("A4 E0"))
+	if !bytes.Equal(got, want) {
+		t.Fatalf("折行結果 %x，要 %x", got, want)
+	}
+	in.Trans = got
+	if vs := Check(in); len(vs) != 0 {
+		t.Fatalf("折完應通過 Check：%+v", vs)
+	}
+}
+
+// WrapAndCheck：折完之後對輸出再 Check。`length` 可能在折完才超過：`win63x8`，原項目 9 列（R_item 為 9），
+// 譯文單行 504 bytes（252 個字，字面與展開都不超過 511），折成 9 列加 8 個換行得 512。
+func TestWrapAndCheck(t *testing.T) {
+	short := pairs(0xA4, 0x40, 2)
+	in := Input{
+		ID: "ESPMES#9.9", File: "ESPMES", Class: "win63x8",
+		Orig:  cat(short, nl, short, nl, short, nl, short, nl, short, nl, short, nl, short, nl, short, nl, short),
+		Trans: bytes.Repeat(pairs(0xA4, 0x40, 28), 9),
+	}
+	if len(in.Trans) != 504 {
+		t.Fatalf("樣本長度 %d，要 504", len(in.Trans))
+	}
+	// 輸入沒有 length 違規（有行寬違規）
+	for _, v := range Check(in) {
+		if v.Rule == RuleLength {
+			t.Fatalf("輸入不該有 length 違規：%+v", v)
+		}
+	}
+	// AutoWrap 自己沒有違規，輸出卻超過 511
+	out, vs := AutoWrap(in)
+	if len(vs) != 0 {
+		t.Fatalf("AutoWrap 不該回違規：%+v", vs)
+	}
+	if len(out) != 512 || bytes.Count(out, nl) != 8 {
+		t.Fatalf("輸出長度 %d 換行 %d，要 512、8", len(out), bytes.Count(out, nl))
+	}
+	// WrapAndCheck 回 Check(輸出)：只有 length
+	wout, wvs := WrapAndCheck(in)
+	if !bytes.Equal(wout, out) {
+		t.Fatalf("WrapAndCheck 的輸出與 AutoWrap 不同")
+	}
+	wantRules(t, wvs, RuleLength)
+	if wvs[0].ID != "ESPMES#9.9" {
+		t.Fatalf("ID = %q", wvs[0].ID)
+	}
+
+	// 沒有違規的情形：回折好的位元組與空違規
+	ok := okInput()
+	ok.Trans = pairs(0xA4, 0x40, 20)
+	wout, wvs = WrapAndCheck(ok)
+	if len(wvs) != 0 || !bytes.Equal(wout, cat(pairs(0xA4, 0x40, 15), nl, pairs(0xA4, 0x4F, 5))) {
+		t.Fatalf("輸出 %x 違規 %+v", wout, wvs)
+	}
+
+	// 折不下的行：維持原樣，違規以 Check(輸出) 的形式回報（line-width），不是 AutoWrap 的 no-breakpoint 字樣
+	bad := okInput()
+	bad.Trans = bytes.Repeat(hb("A4 E0"), 20)
+	wout, wvs = WrapAndCheck(bad)
+	if !bytes.Equal(wout, bad.Trans) {
+		t.Fatalf("折不下的行要維持原樣：%x", wout)
+	}
+	if got := ruleSet(wvs); !reflect.DeepEqual(got, []string{RuleExpandedWidth, RuleLineWidth}) {
+		t.Fatalf("違規 %v", got)
+	}
+
+	// 未知窗口：失敗即關閉
+	if _, vs := WrapAndCheck(Input{File: "NOPE", Trans: []byte("AB")}); len(vs) != 1 || vs[0].Detail != "unknown-window" {
+		t.Fatalf("%+v", vs)
+	}
+}
+
+// randWrapLine 造一行隨機的單位：S 集字、含 P 集 trail 的字、標點（lead A1）、全形數字（lead A2）、數字、`%s`、lead 在 P 集的字。
+func randWrapLine(r *rand.Rand, n int) []byte {
+	var tr []byte
+	for j := 0; j < n; j++ {
+		switch r.Intn(11) {
+		case 0:
+			tr = append(tr, '%', 's')
+		case 1:
+			tr = append(tr, byte('0'+r.Intn(10)))
+		case 2:
+			tr = append(tr, 0xA1, byte(0x40+r.Intn(0x3F)))
+		case 3:
+			tr = append(tr, 0xA4, byte(0xE0+r.Intn(0x20))) // trail 在 P 集（FF 以內）
+		case 4:
+			tr = append(tr, byte(0xE0+r.Intn(0x1A)), byte(0x40+r.Intn(0x3F)))
+		case 5:
+			tr = append(tr, 0xA2, byte(0xAF+r.Intn(10)))
+		default:
+			tr = append(tr, 0xA4, byte(0x40+r.Intn(0x3F)))
+		}
+	}
+	return tr
+}
+
+// outLineStarts 回傳輸入的每一行在輸出裡的第一個行號（輸出把某些行折成多行，後面的行號會位移）。
+func outLineStarts(in, out []byte) []int {
+	inLines := bytes.Split(in, nl)
+	outLines := bytes.Split(out, nl)
+	starts := make([]int, len(inLines))
+	idx := 0
+	for j, il := range inLines {
+		starts[j] = idx
+		for acc := 0; ; {
+			acc += len(outLines[idx])
+			idx++
+			if acc >= len(il) {
+				break
+			}
+		}
+	}
+	return starts
+}
+
+// 多行輸入的性質測試（seed 固定）：每個輸入 1 至 3 行（以 0x0A 分隔，可能以空行結尾），原項目 1 至 4 行。
+// 只取「沒有超寬的行本來就通過 `1676`」的輸入（否則 Check 的 `1676` 違規來自 AutoWrap 不負責的行）。
+//   - AutoWrap 沒回違規：Check(輸出) 的行寬、展開寬度、渲染列數與 `1676` 四項都過；
+//   - 回了違規：只能是 line-width 或 rows，且每個違規的行都在 Check(輸出) 的違規內
+//     （no-breakpoint 的行維持原樣，仍以 line-width 或 expanded-width 出現在位移後的行號；rows 同樣成立）；
+//   - 去掉換行後的位元組不變；WrapAndCheck 等於 AutoWrap 之後 Check。
+func TestAutoWrapPropertyMultiLine(t *testing.T) {
+	t.Logf("seed = %d", propSeed)
+	r := rand.New(rand.NewSource(propSeed))
+	files := []Input{
+		{File: "ESPMES", Class: "win31x4"}, {File: "ESPMES", Class: "win63x8"}, {File: "ESPMES", Class: "win29x4"},
+		{File: "SYSTEM.MES"}, {File: "SP.MES"}, {File: "COUNTRY.MES"},
+	}
+	okN, failedN, termWrapped, skipped := 0, 0, 0, 0
+	for i := 0; i < 8000; i++ {
+		in := files[r.Intn(len(files))]
+		var parts, origs [][]byte
+		for j, n := 0, 1+r.Intn(3); j < n; j++ {
+			parts = append(parts, randWrapLine(r, r.Intn(45)))
+		}
+		if r.Intn(6) == 0 {
+			parts = append(parts, nil) // 以換行結尾，最後多一個空行
+		}
+		for j, n := 0, 1+r.Intn(4); j < n; j++ {
+			origs = append(origs, pairs(0xA4, 0x40, 1+r.Intn(30)))
+		}
+		tr := bytes.Join(parts, nl)
+		in.Trans, in.Orig = tr, bytes.Join(origs, nl)
+		win, _ := WindowFor(in.File, in.Class)
+		e, _ := itemMetrics(in.Orig, win)
+		anyWrap, preFail := false, false
+		for _, l := range splitLines(scanUnits(tr), len(tr)) {
+			need := l.lit > win.W || l.exp > max(win.W, e)
+			anyWrap = anyWrap || need
+			if !need && l.term && LineEatsNewlineAdversarial(tr[l.start:l.end+1]) {
+				preFail = true
+			}
+		}
+		if !anyWrap || preFail {
+			skipped++
+			continue
+		}
+		out, vs := AutoWrap(in)
+		if !bytes.Equal(bytes.ReplaceAll(out, nl, nil), bytes.ReplaceAll(tr, nl, nil)) {
+			t.Fatalf("折行改動了位元組：%x → %x", tr, out)
+		}
+		wout, wvs := WrapAndCheck(in)
+		outIn := in
+		outIn.Trans = out
+		if !bytes.Equal(wout, out) || !reflect.DeepEqual(wvs, Check(outIn)) {
+			t.Fatalf("WrapAndCheck 不等於 AutoWrap 之後 Check：輸入 %x", tr)
+		}
+		checked := Check(outIn)
+		for _, v := range vs {
+			switch v.Rule {
+			case RuleLineWidth:
+				var n int
+				if _, err := fmt.Sscanf(v.Detail, "line=%d no-breakpoint", &n); err != nil {
+					t.Fatalf("意外的 line-width 違規：%+v", v)
+				}
+				prefix := fmt.Sprintf("line=%d ", outLineStarts(tr, out)[n])
+				found := false
+				for _, c := range checked {
+					found = found || (c.Rule == RuleLineWidth || c.Rule == RuleExpandedWidth) && strings.HasPrefix(c.Detail, prefix)
+				}
+				if !found {
+					t.Fatalf("AutoWrap 的 %+v 不在 Check(輸出) 的違規內：輸入 %x 輸出 %x（%+v）", v, tr, out, checked)
+				}
+			case RuleRows:
+				found := false
+				for _, c := range checked {
+					found = found || c.Rule == RuleRows
+				}
+				if !found {
+					t.Fatalf("AutoWrap 的 %+v 不在 Check(輸出) 的違規內：輸入 %x 輸出 %x（%+v）", v, tr, out, checked)
+				}
+			default:
+				t.Fatalf("意外的違規：%+v", v)
+			}
+		}
+		if len(vs) != 0 {
+			failedN++
+			continue
+		}
+		okN++
+		for _, l := range splitLines(scanUnits(tr), len(tr)) {
+			if l.term && (l.lit > win.W || l.exp > max(win.W, e)) {
+				termWrapped++
+			}
+		}
+		for _, v := range checked {
+			switch v.Rule {
+			case RuleLineWidth, RuleExpandedWidth, RuleRows, Rule1676:
+				t.Fatalf("折完不通過 %s：輸入 %x 輸出 %x（%+v）", v.Rule, tr, out, v)
+			}
+		}
+	}
+	t.Logf("折行成功 %d 組（其中以 0x0A 結尾而被折的行 %d 條），回違規 %d 組，略過 %d 組", okN, termWrapped, failedN, skipped)
+	if okN < 500 || termWrapped < 200 || failedN < 200 {
+		t.Fatalf("樣本太少：成功 %d、term 行 %d、違規 %d", okN, termWrapped, failedN)
+	}
+}
+
+func TestAutoWrapUnknownWindow(t *testing.T) {
+	out, vs := AutoWrap(Input{ID: "x", File: "NOPE", Trans: []byte("AB")})
+	wantRules(t, vs, RuleLineWidth)
+	if string(out) != "AB" {
+		t.Fatalf("%q", out)
+	}
+}
+
+// 性質測試（seed 固定）：單行輸入隨機組合（S 集字、含 P 集 trail 的字、標點、數字、`%s`），
+// 凡需要折行者，折完若沒有回違規，Check 在行寬、展開寬度、渲染列數與 `1676` 四項都必須通過，
+// 且去掉換行後的位元組不變；有違規時只能是 line-width 或 rows。
+func TestAutoWrapProperty(t *testing.T) {
+	t.Logf("seed = %d", propSeed)
+	r := rand.New(rand.NewSource(propSeed))
+	files := []Input{
+		{File: "ESPMES", Class: "win31x4"}, {File: "ESPMES", Class: "win63x8"}, {File: "ESPMES", Class: "win29x4"},
+		{File: "SYSTEM.MES"}, {File: "SP.MES"}, {File: "COUNTRY.MES"},
+	}
+	wrappedN, failedN := 0, 0
+	for i := 0; i < 5000; i++ {
+		in := files[r.Intn(len(files))]
+		var tr []byte
+		for j, n := 0, 1+r.Intn(60); j < n; j++ {
+			switch r.Intn(10) {
+			case 0:
+				tr = append(tr, '%', 's')
+			case 1:
+				tr = append(tr, byte('0'+r.Intn(10)))
+			case 2:
+				tr = append(tr, 0xA1, byte(0x40+r.Intn(0x3F)))
+			case 3:
+				tr = append(tr, 0xA4, byte(0xE0+r.Intn(0x20))) // trail 在 P 集（FF 以內）
+			case 4:
+				tr = append(tr, byte(0xE0+r.Intn(0x1A)), byte(0x40+r.Intn(0x3F)))
+			default:
+				tr = append(tr, 0xA4, byte(0x40+r.Intn(0x3F)))
+			}
+		}
+		in.Trans = tr
+		in.Orig = pairs(0xA4, 0x40, 1+r.Intn(30))
+		win, _ := WindowFor(in.File, in.Class)
+		e, _ := itemMetrics(in.Orig, win)
+		l := splitLines(scanUnits(tr), len(tr))[0]
+		if l.lit <= win.W && l.exp <= max(win.W, e) {
+			continue
+		}
+		out, vs := AutoWrap(in)
+		if !bytes.Equal(bytes.ReplaceAll(out, nl, nil), tr) {
+			t.Fatalf("折行改動了位元組：%x → %x", tr, out)
+		}
+		for _, v := range vs {
+			if v.Rule != RuleLineWidth && v.Rule != RuleRows {
+				t.Fatalf("意外的違規：%+v", v)
+			}
+		}
+		if len(vs) != 0 {
+			failedN++
+			continue
+		}
+		wrappedN++
+		in.Trans = out
+		for _, v := range Check(in) {
+			switch v.Rule {
+			case RuleLineWidth, RuleExpandedWidth, RuleRows, Rule1676:
+				t.Fatalf("折完不通過 %s：輸入 %x 輸出 %x（%+v）", v.Rule, tr, out, v)
+			}
+		}
+	}
+	t.Logf("折行 %d 組，回違規 %d 組", wrappedN, failedN)
+	if wrappedN < 500 {
+		t.Fatalf("成功折行的樣本太少（%d）", wrappedN)
+	}
+}
