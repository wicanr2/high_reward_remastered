new file mode 100644
index 0000000..63c898c
--- /dev/null
+++ b/apps/hr/l10n/esp.go
@@ -0,0 +1,174 @@
+package l10n
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+)
+
+// ESPMES.MRG（docs/spec/008 第 2 節，docs/re/024 第 4.2 節）：
+//
+//	外層：u16 N（原版 126），N - 1 個 u32 偏移（沒有終止偏移，首偏移 ＝ 2 ＋ 4 x (N - 1) ＝ 表尾）。
+//	      群組 g 的區段是 [偏移 g, 偏移 g+1)，最後一個群組延伸到檔尾；偏移相同的是空群組（沒有區段）。
+//	內層：u16 N2，N2 個 u32 偏移（相對群組起點），首偏移 ＝ 2 ＋ 4 x N2，項目 j 為 [偏移 j, 偏移 j+1)（含結尾 NUL），
+//	      共 N2 - 1 項；最後一個偏移指向群組最後一個位元組 0xFF，群組以 `00 FF` 結尾。
+
+// espGroup 是外層的一個群組。項目在 File.Items 內依群組順序連續排列。
+type espGroup struct {
+	empty        bool // 沒有區段（偏移與下一個相同）
+	first, count int  // 項目是 Items[first : first+count]
+}
+
+func parseESP(name string, d []byte) (*File, error) {
+	if len(d) < 2 {
+		return nil, errors.New("檔案短於 2 bytes")
+	}
+	n := int(binary.LittleEndian.Uint16(d))
+	ng := n - 1 // 外層偏移個數 ＝ 群組數
+	if ng < 1 {
+		return nil, fmt.Errorf("外層 N ＝ %d，沒有群組", n)
+	}
+	head := 2 + 4*ng
+	if head > len(d) {
+		return nil, fmt.Errorf("外層偏移表（%d bytes）超出檔案（%d bytes）", head, len(d))
+	}
+	offs := make([]int, ng)
+	for i := range offs {
+		offs[i] = int(binary.LittleEndian.Uint32(d[2+4*i:]))
+	}
+	if offs[0] != head {
+		return nil, fmt.Errorf("外層首偏移為 %d，應為表尾 2 + 4 x %d = %d", offs[0], ng, head)
+	}
+	for i := 1; i < ng; i++ {
+		if offs[i] < offs[i-1] {
+			return nil, fmt.Errorf("外層偏移 %d（%d）小於前一個（%d）", i, offs[i], offs[i-1])
+		}
+	}
+	if offs[ng-1] > len(d) {
+		return nil, fmt.Errorf("外層末偏移 %d 超過檔長 %d", offs[ng-1], len(d))
+	}
+	f := &File{Name: name, Kind: KindESP}
+	f.espGroups = make([]espGroup, ng)
+	for g := 0; g < ng; g++ {
+		start, end := offs[g], len(d)
+		if g+1 < ng {
+			end = offs[g+1]
+		}
+		if start == end {
+			f.espGroups[g] = espGroup{empty: true, first: len(f.Items)}
+			continue
+		}
+		items, err := parseESPGroup(d[start:end])
+		if err != nil {
+			return nil, fmt.Errorf("群組 %d：%w", g, err)
+		}
+		f.espGroups[g] = espGroup{first: len(f.Items), count: len(items)}
+		for j, orig := range items {
+			f.Items = append(f.Items, Item{ID: fmt.Sprintf("ESPMES#%d.%d", g, j), Orig: orig})
+		}
+	}
+	return f, nil
+}
+
+// parseESPGroup 解析一個非空群組，回傳 N2 - 1 個項目（去掉結尾 NUL）。
+func parseESPGroup(grp []byte) ([][]byte, error) {
+	if len(grp) < 2 {
+		return nil, errors.New("區段短於 2 bytes")
+	}
+	n2 := int(binary.LittleEndian.Uint16(grp))
+	if n2 < 1 {
+		return nil, errors.New("N2 為 0")
+	}
+	head := 2 + 4*n2
+	if head >= len(grp) {
+		return nil, fmt.Errorf("內層偏移表（N2=%d，%d bytes）超出區段（%d bytes）", n2, head, len(grp))
+	}
+	o2 := make([]int, n2)
+	for i := range o2 {
+		o2[i] = int(binary.LittleEndian.Uint32(grp[2+4*i:]))
+	}
+	if o2[0] != head {
+		return nil, fmt.Errorf("內層首偏移為 %d，應為 2 + 4 x N2 = %d", o2[0], head)
+	}
+	last := len(grp) - 1
+	if o2[n2-1] != last {
+		return nil, fmt.Errorf("內層末偏移為 %d，應指向區段最後一個位元組（%d）", o2[n2-1], last)
+	}
+	if grp[last] != 0xFF {
+		return nil, errors.New("區段最後一個位元組不是 0xFF")
+	}
+	items := make([][]byte, 0, n2-1)
+	for j := 0; j+1 < n2; j++ {
+		s, e := o2[j], o2[j+1]
+		if e <= s {
+			return nil, fmt.Errorf("內層偏移 %d（%d）不小於下一個（%d）", j, s, e)
+		}
+		it := grp[s:e]
+		if it[len(it)-1] != 0 {
+			return nil, fmt.Errorf("項目 %d 不以 NUL 結尾", j)
+		}
+		body := it[:len(it)-1]
+		if bytes.IndexByte(body, 0) >= 0 {
+			return nil, fmt.Errorf("項目 %d 內含 NUL", j)
+		}
+		items = append(items, bytes.Clone(body))
+	}
+	return items, nil
+}
+
+// serializeESP 由項目重建檔案：外層保留 N 與 N - 1 個偏移，空群組的偏移取「目前位置」（即下一個非空群組的起點）。
+func (f *File) serializeESP(cur [][]byte) ([]byte, error) {
+	ng := len(f.espGroups)
+	head := 2 + 4*ng
+	var body bytes.Buffer
+	starts := make([]int, ng)
+	pos := head
+	for g, grp := range f.espGroups {
+		starts[g] = pos
+		if grp.empty {
+			continue
+		}
+		gb, err := serializeESPGroup(cur[grp.first : grp.first+grp.count])
+		if err != nil {
+			return nil, fmt.Errorf("l10n: 群組 %d：%w", g, err)
+		}
+		body.Write(gb)
+		pos += len(gb)
+	}
+	out := make([]byte, 0, pos)
+	out = putU16(out, ng+1)
+	for _, s := range starts {
+		out = putU32(out, s)
+	}
+	out = append(out, body.Bytes()...)
+	return out, nil
+}
+
+// serializeESPGroup 重建一個群組：N2 ＝ 項目數 ＋ 1，偏移相對群組起點，並重新寫出結尾的 0xFF。
+func serializeESPGroup(items [][]byte) ([]byte, error) {
+	n2 := len(items) + 1
+	if n2 > 0xFFFF {
+		return nil, fmt.Errorf("項目數 %d 超過 u16 上限", len(items))
+	}
+	head := 2 + 4*n2
+	size := head + 1
+	for _, it := range items {
+		size += len(it) + 1
+	}
+	out := make([]byte, 0, size)
+	out = putU16(out, n2)
+	pos := head
+	for j := 0; j < n2; j++ {
+		out = putU32(out, pos)
+		if j < len(items) {
+			pos += len(items[j]) + 1
+		}
+	}
+	for _, it := range items {
+		out = append(out, it...)
+		out = append(out, 0)
+	}
+	out = append(out, 0xFF)
+	return out, nil
+}
