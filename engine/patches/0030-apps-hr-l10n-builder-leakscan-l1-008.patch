+// newSynthOrig 在暫存目錄寫九個合成的原版輸入，並讓 build 的預期雜湊指向它們。
+func newSynthOrig(t *testing.T) *synthOrig {
+	t.Helper()
+	cs, err := l10n.LoadCharmap()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &synthOrig{dir: t.TempDir(), hashes: map[string]string{}, cs: cs}
+	e := func(x string) string { return s.enc(t, x) }
+	files := map[string][]byte{
+		"COUNTRY.MES":  mesBytes(e("一二三上下大小中國人天地")),
+		"SP.MES":       mesBytes(e("一二三上下大小中國"), e("人天地水火山")),
+		"SYSTEM.MES":   mesBytes(e("一二")+"%s"+e("三"), e("上下大小中國人")),
+		"UWASA.MES":    mesBytes(e("山水火天地人"), e("山水火天地人")), // 兩個原項目位元組相同：一個重複來源群組
+		"POWERMES.MES": mesBytes(e("無有不一二三上下大小")),
+		"ESPMES.MRG":   espBytes(e("一二三上下"), e("大小中國人天地水火山")),
+		"SHOPTAB.TBL":  shopBytes(),
+		"MAIN.EXE":     []byte("synthetic main"),
+		"CFONT.15":     []byte("synthetic font"),
+	}
+	for n, b := range files {
+		if err := os.WriteFile(filepath.Join(s.dir, n), b, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		s.hashes[n] = sum(b)
+	}
+	origHashesOverride = s.hashes
+	t.Cleanup(func() { origHashesOverride = nil })
+	return s
+}
