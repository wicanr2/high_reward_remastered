+func TestLoadTableErrorsNameTheLine(t *testing.T) {
+	hdr := "id\tsrc_sha256\ttext\tstatus\tacc_sha\tby\tbatch\tdate\tnote\n"
+	ok1 := "SP.MES#1\t0123456789abcdef\t一\tkeep\t\t\t\t\t\n"
+	row := func(id, sha, text, status, acc string) string {
+		return id + "\t" + sha + "\t" + text + "\t" + status + "\t" + acc + "\t\t\t\t\n"
+	}
+	cases := []struct {
+		name, src, sub string
+	}{
+		{"空檔", "", "缺表頭"},
+		{"表頭錯", "id\ttext\n" + ok1, "第 1 行"},
+		{"欄數太少", hdr + ok1 + "SP.MES#2\t0123456789abcdef\t一\tkeep\n", "第 3 行：欄位數 4"},
+		{"欄數太多", hdr + "SP.MES#2\t0123456789abcdef\t一\tkeep\t\t\t\t\t\tx\n", "第 2 行：欄位數 10"},
+		{"未知跳脫", hdr + ok1 + row("SP.MES#2", "0123456789abcdef", `一\x二`, "keep", ""), "第 3 行 text 欄：未知的跳脫 \\x"},
+		{"結尾反斜線", hdr + row("SP.MES#2", "0123456789abcdef", `一\`, "keep", ""), "第 2 行 text 欄"},
+		{"status 錯", hdr + ok1 + ok1[:0] + row("SP.MES#2", "0123456789abcdef", "一", "done", ""), "第 3 行：status"},
+		{"src_sha 太短", hdr + row("SP.MES#2", "0123", "一", "keep", ""), "第 2 行：src_sha256"},
+		{"src_sha 大寫", hdr + row("SP.MES#2", "0123456789ABCDEF", "一", "keep", ""), "第 2 行：src_sha256"},
+		{"acc_sha 格式錯", hdr + row("SP.MES#2", "0123456789abcdef", "一", "accepted", "xyz"), "第 2 行：acc_sha"},
+		{"id 格式錯", hdr + row("sp#2", "0123456789abcdef", "一", "keep", ""), "第 2 行：id"},
+		{"id 重複", hdr + ok1 + row("SP.MES#1", "0123456789abcdef", "二", "keep", ""), "第 3 行：id SP.MES#1 與第 2 行重複"},
+		{"空行", hdr + ok1 + "\n" + ok1, "第 3 行：欄位數 1"},
+		{"text 含 CR", hdr + row("SP.MES#2", "0123456789abcdef", "一\r二", "keep", ""), "第 2 行：text 欄含 CR"},
+		{"不合法的 UTF-8", hdr + row("SP.MES#2", "0123456789abcdef", "\xff", "keep", ""), "第 2 行：不是合法的 UTF-8"},
+	}
+	for _, c := range cases {
+		_, err := LoadTable(strings.NewReader(c.src))
+		if err == nil {
+			t.Errorf("%s：應該回錯", c.name)
+			continue
+		}
+		if !strings.Contains(err.Error(), c.sub) {
+			t.Errorf("%s：錯誤訊息 %q 不含 %q", c.name, err, c.sub)
+		}
+	}
+}
