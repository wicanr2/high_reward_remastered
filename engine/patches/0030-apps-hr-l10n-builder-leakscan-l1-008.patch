+func TestTableSaveLoadRoundTrip(t *testing.T) {
+	rows := []Row{
+		{ID: "SP.MES#0", SrcSHA: "0123456789abcdef", Text: "一二\n三\t四\\五\\n", Status: StatusAccepted, AccSHA: AccSHA("x"), By: "譯者 A", Batch: "b1", Date: "2026-10-04", Note: "備註\t含 tab\n與換行"},
+		{ID: "ESPMES#44.1", SrcSHA: "fedcba9876543210", Text: "", Status: StatusKeep},
+		{ID: "SHOPTAB#98.7", SrcSHA: "0000000000000000", Text: "%s 與 %03d", Status: StatusCandidate},
+	}
+	tb := &Table{Rows: rows}
+	s := saveString(t, tb)
+	// 手寫的預期（跳脫 \n、\t、\\）。
+	want := "id\tsrc_sha256\ttext\tstatus\tacc_sha\tby\tbatch\tdate\tnote\n" +
+		"SP.MES#0\t0123456789abcdef\t一二\\n三\\t四\\\\五\\\\n\taccepted\t" + AccSHA("x") + "\t譯者 A\tb1\t2026-10-04\t備註\\t含 tab\\n與換行\n" +
+		"ESPMES#44.1\tfedcba9876543210\t\tkeep\t\t\t\t\t\n" +
+		"SHOPTAB#98.7\t0000000000000000\t%s 與 %03d\tcandidate\t\t\t\t\t\n"
+	if s != want {
+		t.Errorf("Save 輸出：\n got %q\nwant %q", s, want)
+	}
+	back, err := LoadTable(strings.NewReader(s))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(back.Rows) != len(rows) {
+		t.Fatalf("讀回 %d 列", len(back.Rows))
+	}
+	for i := range rows {
+		if back.Rows[i] != rows[i] {
+			t.Errorf("第 %d 列往返不符：\n got %+v\nwant %+v", i, back.Rows[i], rows[i])
+		}
+	}
+	if s2 := saveString(t, back); s2 != s {
+		t.Error("再存一次不逐位元相同")
+	}
+}
