+// 譯文表只讀一次：雜湊與解析共用同一份位元組。讀入之後、解析之前把譯文表換掉，建置的結果仍是讀入時的版本，
+// manifest 的 table_hash 與包內容對得上（讀兩次的實作會算出舊版的雜湊，卻用新版的內容建包）。
+func TestBuildReadsTablesOnce(t *testing.T) {
+	w := newSynthWorld(t)
+	td := w.tableDir(w.standardRows()...)
+	wantHash, err := TableHash(td)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := w.cfg(t.TempDir(), td, ModeTable, Policy{})
+	wantDigest, err := ExpectedDigest(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ref := mustBuild(t, w.cfg(t.TempDir(), td, ModeTable, Policy{})) // 參照：沒有換表的建置
+
+	hooked := 0
+	cfg.hooks = &buildHooks{afterTableRead: func() {
+		hooked++
+		// SP 換成別的譯文，SYSTEM 的譯文表消失
+		w.writeTable(td, w.row("SP.MES#0", "山水火天地人", StatusAccepted))
+		if err := os.Remove(filepath.Join(td, "SYSTEM.MES.tsv")); err != nil {
+			t.Error(err)
+		}
+	}}
+	res := mustBuild(t, cfg)
+	if hooked != 1 {
+		t.Fatalf("縫隙觸發 %d 次，應為 1", hooked)
+	}
+	if now, _ := TableHash(td); now == wantHash {
+		t.Fatal("縫隙沒有改動譯文表，測試無效")
+	}
+	if res.Manifest.TableHash != wantHash || res.Digest != wantDigest || res.Manifest.Adopted != ref.Manifest.Adopted {
+		t.Errorf("manifest 與建置前讀到的版本不符：table_hash=%s digest=%s adopted=%d", res.Manifest.TableHash, res.Digest, res.Manifest.Adopted)
+	}
+	for _, n := range packNames {
+		if !bytes.Equal(packFile(t, res.Dir, n), packFile(t, ref.Dir, n)) {
+			t.Errorf("%s 與讀入時的版本不同：包內容用了後來換掉的譯文表", n)
+		}
+	}
+}
