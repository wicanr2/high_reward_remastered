+func mkRow(f *File, idx int, status, text string) Row {
+	it := f.Items[idx]
+	r := Row{ID: it.ID, SrcSHA: SrcSHA(it.Orig), Text: text, Status: status}
+	if status == StatusAccepted {
+		r.AccSHA = AccSHA(text)
+	}
+	return r
+}
+
+func saveString(t *testing.T, tb *Table) string {
+	t.Helper()
+	var sb strings.Builder
+	if err := tb.Save(&sb); err != nil {
+		t.Fatal(err)
+	}
+	return sb.String()
+}
