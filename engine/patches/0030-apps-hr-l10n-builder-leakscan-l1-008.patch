+package l10n
+
+import (
+	"bytes"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+
+	"golang.org/x/text/encoding/traditionalchinese"
+)
+
+func TestCharmapEmbedded(t *testing.T) {
+	cs := mustCharmap(t)
+	if cs.Len() != 1716 {
+		t.Errorf("字數 %d，應為 1716（docs/re/020 第 5.3 節）", cs.Len())
+	}
+	if len(cs.toBig) != len(cs.fromBig) {
+		t.Fatalf("toBig %d、fromBig %d：不是一對一", len(cs.toBig), len(cs.fromBig))
+	}
+	// 每個碼都能被 x/text 的 Big5 解碼為同一字（這裡不經 big5Rune，直接用解碼器）。
+	dec := traditionalchinese.Big5.NewDecoder()
+	for r, code := range cs.toBig {
+		if cs.fromBig[code] != r {
+			t.Errorf("U+%04X ↔ %04X 不是互逆", r, code)
+		}
+		s, err := dec.String(string([]byte{byte(code >> 8), byte(code)}))
+		if err != nil || s != string(r) {
+			t.Errorf("碼 %04X 經 x/text 解碼是 %q（err %v），表中是 U+%04X", code, s, err, r)
+		}
+	}
+	// 檔案形態：表頭、兩欄、大寫十六進位、unicode 由小到大；沒有文句。
+	lines := strings.Split(strings.TrimSuffix(string(charmapTSV), "\n"), "\n")
+	if lines[0] != "unicode\tbig5" || len(lines) != 1717 {
+		t.Fatalf("表頭 %q，行數 %d", lines[0], len(lines))
+	}
+	re := regexp.MustCompile(`^[0-9A-F]{4,6}\t[0-9A-F]{4}$`)
+	prev := int64(-1)
+	for i, ln := range lines[1:] {
+		if !re.MatchString(ln) {
+			t.Fatalf("第 %d 行格式不符：%q", i+2, ln)
+		}
+		u, _ := strconv.ParseInt(ln[:strings.IndexByte(ln, '\t')], 16, 32)
+		if u <= prev {
+			t.Fatalf("第 %d 行 unicode 沒有由小到大", i+2)
+		}
+		prev = u
+	}
+	if bytes.Contains(charmapTSV, []byte("\r")) {
+		t.Error("charmap 應為 LF 換行")
+	}
+}
+
+func TestCharmapAccessors(t *testing.T) {
+	cs := mustCharmap(t)
+	code, ok := cs.Big5('一')
+	if !ok || code != 0xA440 {
+		t.Errorf("Big5(一) ＝ %04X, %v", code, ok)
+	}
+	if r, ok := cs.Rune(0xA440); !ok || r != '一' {
+		t.Errorf("Rune(A440) ＝ %q, %v", r, ok)
+	}
+	if _, ok := cs.Big5('汉'); ok {
+		t.Error("簡體字『汉』不在原版字集內")
+	}
+}
+
+func TestCharmapEncode(t *testing.T) {
+	cs := mustCharmap(t)
+	enc := func(s string) []byte {
+		t.Helper()
+		b, bad, err := cs.Encode(s)
+		if err != nil || len(bad) != 0 {
+			t.Fatalf("Encode(%q)：err %v bad %v", s, err, bad)
+		}
+		return b
+	}
+	// 單位元組白名單：數字、`/`、`:`、大寫字母原樣；`\n` 轉 0x0A。
+	if got := enc("ABCXYZ0123456789/:\nQ"); string(got) != "ABCXYZ0123456789/:\nQ" {
+		t.Errorf("白名單：%q", got)
+	}
+	if got := enc("\n"); !bytes.Equal(got, []byte{0x0A}) {
+		t.Errorf("換行：%X", got)
+	}
+	// `%` 轉換規格原樣。
+	for _, s := range []string{"%s", "%d", "%ld", "%03d", "%02d", "%1d", "%2d", "%4d", "%10ld", "%c", "%x", "%-5d", "%.3d"} {
+		if got := enc("A" + s + "B"); string(got) != "A"+s+"B" {
+			t.Errorf("%s：%q", s, got)
+		}
+	}
+	// 字集內的字轉 Big5 雙位元組（原版碼）。
+	if got := enc(t1 + t2 + t3 + t4 + t5); !bytes.Equal(got, []byte{0xA4, 0x40, 0xA4, 0x47, 0xA4, 0x54, 0xA4, 0x57, 0xA4, 0x55}) {
+		t.Errorf("字集內的字：%X", got)
+	}
+	// 混合：數字、`%s` 與中文。
+	if got := enc("3" + t1 + "%s" + t2 + "\n" + t3); !bytes.Equal(got, []byte{'3', 0xA4, 0x40, '%', 's', 0xA4, 0x47, 0x0A, 0xA4, 0x54}) {
+		t.Errorf("混合：%X", got)
+	}
+	// 空字串。
+	if got := enc(""); len(got) != 0 {
+		t.Errorf("空字串：%X", got)
+	}
+}
+
+func TestCharmapEncodeRejects(t *testing.T) {
+	cs := mustCharmap(t)
+	// 字集外的字：簡體字、小寫字母、空白、標點、半形標點、CR、Tab、不合法 UTF-8。
+	text := "汉" + t1 + "a" + " " + "." + "," + "-" + "?" + "\r" + "\t" + "汉" + "\xff"
+	b, bad, err := cs.Encode(text)
+	if err == nil || b != nil {
+		t.Fatalf("字集外的字應失敗：b %X err %v", b, err)
+	}
+	wantBad := []rune{'汉', 'a', ' ', '.', ',', '-', '?', '\r', '\t', 0xFFFD}
+	if string(bad) != string(wantBad) {
+		t.Errorf("badRunes ＝ %U；應為 %U（去重、依首次出現順序）", bad, wantBad)
+	}
+	// 只回報碼位，不回報文句。
+	if strings.Contains(err.Error(), "汉") || strings.Contains(err.Error(), "?") {
+		t.Errorf("錯誤訊息含文句：%v", err)
+	}
+	if !strings.Contains(err.Error(), "U+6C49") {
+		t.Errorf("錯誤訊息要列碼位：%v", err)
+	}
+	// 不合法的 % 序列。
+	for _, s := range []string{"%", "A%", "%%", "%z", "% d", "%.d", "%ll", "%5", "100%"} {
+		b, _, err := cs.Encode(s)
+		if err == nil || b != nil || !strings.Contains(err.Error(), "% 序列") {
+			t.Errorf("Encode(%q) 應因 %% 序列失敗：b %X err %v", s, b, err)
+		}
+	}
+	// 小寫的 s、d、l 只在 % 序列內合法。
+	if _, bad, err := cs.Encode("%s s d l"); err == nil || len(bad) != 4 {
+		t.Errorf("%% 序列外的 s、d、l 與空白要回報：bad %U err %v", bad, err)
+	}
+}
+
+// 往返（碼解回原字）不符的字要回報：用手造的不一致表。
+func TestCharmapEncodeRoundTripMismatch(t *testing.T) {
+	cs := &Charmap{
+		toBig:   map[rune]uint16{'一': 0xA440, '二': 0xA447},
+		fromBig: map[uint16]rune{0xA440: '丁', 0xA447: '二'},
+	}
+	b, bad, err := cs.Encode("二一")
+	if err == nil || b != nil || string(bad) != "一" {
+		t.Errorf("往返不符的字要回報：b %X bad %U err %v", b, bad, err)
+	}
+}
+
+func TestCharmapDecode(t *testing.T) {
+	cs := mustCharmap(t)
+	got, err := cs.Decode([]byte{0xA4, 0x40, 'A', '%', 's', 0x0A, 0xA4, 0x47, ' ', '1'})
+	if err != nil || got != "一A%s\n二 1" {
+		t.Errorf("Decode：%q %v", got, err)
+	}
+	// 孤立的高位元組、控制碼與不合法的雙位元組以 <XX> 標示，並回 err。
+	got, err = cs.Decode([]byte{0x93, 0xFC, 0xA4, 0x40, 0x00, 0xA1})
+	if err == nil {
+		t.Error("無法解碼的位元組要回 err")
+	}
+	if got != "<93><FC>一<00><A1>" {
+		t.Errorf("Decode 的標示：%q", got)
+	}
+	if s, err := cs.Decode(nil); err != nil || s != "" {
+		t.Errorf("空輸入：%q %v", s, err)
+	}
+}
+
+func TestPercentSpecLen(t *testing.T) {
+	cases := map[string]int{
+		"%s": 2, "%d": 2, "%ld": 3, "%03d": 4, "%10ld": 5, "%1d": 3, "%s abc": 2, "%d%d": 2,
+		"%-5d": 4, "%+d": 3, "%#x": 3, "%.3d": 4, "%5.2s": 5, "%hd": 3, "%Lu": 3,
+		"": 0, "%": 0, "A%d": 0, "%%": 0, "%z": 0, "% d": 0, "%.d": 0, "%5": 0, "%ll": 0, "%l": 0, "%10": 0,
+	}
+	for s, want := range cases {
+		if got := PercentSpecLen(s); got != want {
+			t.Errorf("PercentSpecLen(%q) ＝ %d，應為 %d", s, got, want)
+		}
+	}
+}
+
+func TestParseCharmapRejects(t *testing.T) {
+	good := "unicode\tbig5\n4E00\tA440\n4E8C\tA447\n"
+	if _, err := parseCharmap([]byte(good), true); err != nil {
+		t.Fatal(err)
+	}
+	cases := map[string]string{
+		"表頭錯":             "u\tb\n4E00\tA440\n",
+		"欄數錯":             "unicode\tbig5\n4E00\n",
+		"unicode 不是十六進位":  "unicode\tbig5\nZZZZ\tA440\n",
+		"unicode 是 ASCII": "unicode\tbig5\n0041\tA440\n",
+		"big5 碼不合法":       "unicode\tbig5\n4E00\t8140\n",
+		"unicode 沒有遞增":    "unicode\tbig5\n4E8C\tA447\n4E00\tA440\n",
+		"unicode 重複":      "unicode\tbig5\n4E00\tA440\n4E00\tA447\n",
+		"big5 碼重複":        "unicode\tbig5\n4E00\tA440\n4E8C\tA440\n",
+		"與 x/text 不符":     "unicode\tbig5\n4E01\tA440\n",
+	}
+	for name, s := range cases {
+		if _, err := parseCharmap([]byte(s), true); err == nil {
+			t.Errorf("%s：應該回錯", name)
+		}
+	}
+	// 不核對 x/text 時，「與 x/text 不符」可以通過，其餘格式錯誤仍失敗。
+	if _, err := parseCharmap([]byte(cases["與 x/text 不符"]), false); err != nil {
+		t.Errorf("verify ＝ false 時只做格式檢查：%v", err)
+	}
+	// CRLF 可讀。
+	if _, err := parseCharmap([]byte("unicode\tbig5\r\n4E00\tA440\r\n"), true); err != nil {
+		t.Errorf("CRLF：%v", err)
+	}
+}
+
+// ---- GenerateCharmap ----
+
+// synthSources 造一組合成來源：七個資料檔與七個 OP 文字檔，內容只用幾個已知的 Big5 碼。
+func synthSources() map[string][]byte {
+	one := []byte{0xA4, 0x40}   // 一
+	two := []byte{0xA4, 0x47}   // 二
+	three := []byte{0xA4, 0x54} // 三
+	four := []byte{0xA4, 0x5D}  // 也 A45D（4E5F）
+	cat := func(parts ...[]byte) string { return string(bytes.Join(parts, nil)) }
+	files := map[string][]byte{
+		"COUNTRY.MES":  buildMES([]string{cat(one, []byte("AB"), two)}, 0),
+		"SP.MES":       buildMES([]string{cat(three), cat(one, []byte{0x93})}, 0),
+		"SYSTEM.MES":   buildMES([]string{"%s"}, 0),
+		"UWASA.MES":    buildMES([]string{cat(two)}, 0),
+		"POWERMES.MES": buildMES([]string{cat(four, []byte{0xA1})}, 0), // 尾端孤立的 A1 不成對
+		"ESPMES.MRG":   buildESP(3, map[int][]string{1: {cat(one, two)}}),
+		"SHOPTAB.TBL":  buildShop(1, []string{cat(three, three)}),
+		"OP.TXT":       []byte(cat(one) + "\r\n" + cat(two) + "\r\n"),
+	}
+	for _, n := range []string{"OP0.TXT", "OP1.TXT", "OP2.TXT", "OP3.TXT", "OP4.TXT", "OP5.TXT"} {
+		files[n] = []byte("  abc\r\n")
+	}
+	return files
+}
+
+func TestGenerateCharmapSynthetic(t *testing.T) {
+	files := synthSources()
+	extra := [][]byte{{0xA4, 0x45, 0xA4, 0x40}, {0x80, 0xA4, 0x4A}} // 丑（A445）、一；孤立 0x80 後的 A44A
+	out, rep, err := GenerateCharmap(files, extra)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// 一、二、三、也 在資料檔；丑 與 A44A 在 extra；一共有。
+	want := map[uint16]bool{0xA440: true, 0xA447: true, 0xA454: true, 0xA45D: true, 0xA445: true, 0xA44A: true}
+	got := codesFromTSV(t, out)
+	if len(got) != len(want) {
+		t.Errorf("輸出 %d 個碼，應為 %d：%X", len(got), len(want), got)
+	}
+	for c := range want {
+		if _, ok := got[c]; !ok {
+			t.Errorf("缺碼 %04X", c)
+		}
+	}
+	if rep.Total != 6 || rep.FromData != 4 || rep.FromExtra != 3 || rep.Shared != 1 {
+		t.Errorf("統計：%+v", rep)
+	}
+	// 輸出格式：表頭、unicode 由小到大、LF。
+	lines := strings.Split(strings.TrimSuffix(string(out), "\n"), "\n")
+	if lines[0] != "unicode\tbig5" || len(lines) != 7 {
+		t.Fatalf("輸出行數 %d：%q", len(lines), lines[0])
+	}
+	if _, err := parseCharmap(out, true); err != nil {
+		t.Errorf("產生的表要能被 parseCharmap 讀回：%v", err)
+	}
+	// 決定性：兩次產生逐位元相同；來源檔名大小寫不分。
+	lower := map[string][]byte{}
+	for n, b := range files {
+		lower[strings.ToLower(n)] = b
+	}
+	out2, _, err := GenerateCharmap(lower, extra)
+	if err != nil || !bytes.Equal(out, out2) {
+		t.Errorf("兩次產生不同或失敗：%v", err)
+	}
+	// extra 的順序不影響輸出。
+	out3, _, _ := GenerateCharmap(files, [][]byte{extra[1], extra[0]})
+	if !bytes.Equal(out, out3) {
+		t.Error("extra 順序不同，輸出不同")
+	}
+}
+
+func TestGenerateCharmapMissingSource(t *testing.T) {
+	files := synthSources()
+	delete(files, "OP3.TXT")
+	delete(files, "SP.MES")
+	_, _, err := GenerateCharmap(files, nil)
+	if err == nil || !containsAll(err.Error(), "OP3.TXT", "SP.MES") {
+		t.Errorf("缺來源檔要點名：%v", err)
+	}
+}
+
+func codesFromTSV(t *testing.T, tsv []byte) map[uint16]rune {
+	t.Helper()
+	m := map[uint16]rune{}
+	for _, ln := range strings.Split(strings.TrimSuffix(string(tsv), "\n"), "\n")[1:] {
+		f := strings.Split(ln, "\t")
+		u, _ := strconv.ParseUint(f[0], 16, 32)
+		b, _ := strconv.ParseUint(f[1], 16, 16)
+		m[uint16(b)] = rune(u)
+	}
+	return m
+}
+
+// 一對一不成立時要報出來，不靜默覆蓋：找 x/text 解成同一字的兩個碼、解不出字的碼。
+func TestGenerateCharmapCollisionsAndUndecodable(t *testing.T) {
+	byRune := map[rune][]uint16{}
+	var undecodable []uint16
+	for lead := 0xA1; lead <= 0xF9; lead++ {
+		for trail := 0x40; trail <= 0xFE; trail++ {
+			code := uint16(lead)<<8 | uint16(trail)
+			if !validBig5Code(code) {
+				continue
+			}
+			if r, ok := big5Rune(code); ok {
+				byRune[r] = append(byRune[r], code)
+			} else {
+				undecodable = append(undecodable, code)
+			}
+		}
+	}
+	var pair []uint16
+	for _, cs := range byRune {
+		if len(cs) == 2 && (pair == nil || cs[0] < pair[0]) {
+			pair = cs
+		}
+	}
+	files := synthSources()
+	if pair != nil {
+		extra := [][]byte{{byte(pair[1] >> 8), byte(pair[1])}, {byte(pair[0] >> 8), byte(pair[0])}}
+		out, rep, err := GenerateCharmap(files, extra)
+		if err == nil || len(rep.Collisions) != 1 || rep.Collisions[0] != [2]uint16{pair[0], pair[1]} {
+			t.Errorf("碰撞 %04X：err %v rep %+v", pair, err, rep)
+		}
+		if got := codesFromTSV(t, out); got[pair[1]] != 0 {
+			t.Errorf("碰撞的較大碼 %04X 不該輸出", pair[1])
+		}
+	} else {
+		t.Log("x/text 的 Big5 沒有兩碼解成同一字的情形：碰撞偵測以 undecodable 路徑涵蓋")
+	}
+	if len(undecodable) > 0 {
+		c := undecodable[0]
+		extra := [][]byte{{byte(c >> 8), byte(c)}}
+		_, rep, err := GenerateCharmap(files, extra)
+		if err == nil || len(rep.Undecodable) != 1 || rep.Undecodable[0] != c {
+			t.Errorf("解不出字的碼 %04X：err %v rep %+v", c, err, rep)
+		}
+	} else {
+		t.Log("合法範圍內的碼 x/text 全部可解")
+	}
+	t.Logf("x/text Big5：重複解碼的碼組 %d、合法範圍內解不出的碼 %d", func() int {
+		n := 0
+		for _, cs := range byRune {
+			if len(cs) >= 2 {
+				n++
+			}
+		}
+		return n
+	}(), len(undecodable))
+}
+
+// ---- 以原版驗證（需原版）----
+
+var opTxtNames = []string{"OP.TXT", "OP0.TXT", "OP1.TXT", "OP2.TXT", "OP3.TXT", "OP4.TXT", "OP5.TXT"}
+
+func readOrigCharmapSources(t testing.TB) map[string][]byte {
+	t.Helper()
+	return readOrig(t, append(append([]string{}, dataFileNames...), opTxtNames...)...)
+}
+
+// idaTextDir 是 IDA 嚴格掃描輸出的目錄（docs/re/020 的 str*.tsv，含原版字串的十六進位，只在使用者機器上）。
+func idaStrings(t testing.TB, file, seg string) [][]byte {
+	t.Helper()
+	dir := os.Getenv("HR_IDA_TEXT")
+	if dir == "" {
+		root := os.Getenv("HR_ORIG")
+		if root == "" {
+			root = "/orig/orig"
+		}
+		dir = filepath.Join(filepath.Dir(root), "ida-text", "out")
+	}
+	b, err := os.ReadFile(filepath.Join(dir, file))
+	if err != nil {
+		t.Skipf("沒有 IDA 掃描輸出（%s）：%v", filepath.Join(dir, file), err)
+	}
+	var out [][]byte
+	for _, ln := range strings.Split(strings.TrimSpace(string(b)), "\n")[1:] {
+		f := strings.Split(ln, "\t")
+		if len(f) < 10 || (seg != "" && f[0][:4] != seg) {
+			continue
+		}
+		if bc, _ := strconv.Atoi(f[4]); bc < 2 {
+			continue
+		}
+		raw, err := hex.DecodeString(f[9])
+		if err != nil {
+			t.Fatalf("%s：十六進位解碼失敗：%v", file, err)
+		}
+		out = append(out, raw)
+	}
+	return out
+}
+
+// 資料檔與 OP*.TXT 的每個對齊解碼字都在嵌入的字集內（只需原版資料檔，不需 IDA 輸出）。
+func TestCharmapCoversOriginalFileText(t *testing.T) {
+	files := readOrigCharmapSources(t)
+	cs := mustCharmap(t)
+	out, rep, err := GenerateCharmap(files, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rep.Total != 1527 {
+		t.Errorf("資料檔與 OP*.TXT 的不重複字 %d，docs/re/020 的工具量到 1527", rep.Total)
+	}
+	for code := range codesFromTSV(t, out) {
+		if _, ok := cs.Rune(code); !ok {
+			t.Errorf("嵌入的字集缺資料檔用到的碼 %04X", code)
+		}
+	}
+}
+
+// 以 IDA 輸出加原版重新產生，與嵌入的 charmap-zh-TW.tsv 逐位元相同，兩次產生也相同（需原版與 IDA 輸出）。
+func TestGenerateCharmapReproducesEmbedded(t *testing.T) {
+	files := readOrigCharmapSources(t)
+	var extra [][]byte
+	extra = append(extra, idaStrings(t, "str.tsv", "")...)
+	extra = append(extra, idaStrings(t, "str-OP.tsv", "204D")...)
+	extra = append(extra, idaStrings(t, "str-END.tsv", "21A8")...)
+	out1, rep, err := GenerateCharmap(files, extra)
+	if err != nil {
+		t.Fatalf("%v（%+v）", err, rep)
+	}
+	out2, _, _ := GenerateCharmap(files, extra)
+	if !bytes.Equal(out1, out2) {
+		t.Error("兩次產生不逐位元相同")
+	}
+	if !bytes.Equal(out1, charmapTSV) {
+		t.Errorf("重新產生的表（%d 字）與嵌入的不同（%d bytes 對 %d bytes）", rep.Total, len(out1), len(charmapTSV))
+	}
+	if rep.Total != 1716 {
+		t.Errorf("Total ＝ %d，應為 1716", rep.Total)
+	}
+}
+
+// Decode 對原版的每個項目：回 err 若且唯若有無法配成雙位元組的高位元組或 0x0A 以外的控制碼（獨立判斷）。
+// 另：只含雙位元組字、0x0A 與白名單 ASCII（無 %）的項目，Decode 再 Encode 逐位元組還原。
+func TestCharmapDecodeEncodeOriginalItems(t *testing.T) {
+	orig := readOrigData(t)
+	cs := mustCharmap(t)
+	independentlyDecodable := func(b []byte) bool {
+		for i := 0; i < len(b); i++ {
+			c := b[i]
+			switch {
+			case c >= 0xA1 && c <= 0xF9 && i+1 < len(b) && validBig5Code(uint16(c)<<8|uint16(b[i+1])):
+				i++
+			case c == 0x0A || (c >= 0x20 && c <= 0x7E):
+			default:
+				return false
+			}
+		}
+		return true
+	}
+	whitelistOnly := func(b []byte) bool {
+		for i := 0; i < len(b); i++ {
+			c := b[i]
+			switch {
+			case c >= 0xA1 && c <= 0xF9 && i+1 < len(b) && validBig5Code(uint16(c)<<8|uint16(b[i+1])):
+				i++
+			case c == 0x0A, c >= '0' && c <= '9', c >= 'A' && c <= 'Z', c == '/', c == ':':
+			default:
+				return false
+			}
+		}
+		return true
+	}
+	checked, roundtripped, withErr := 0, 0, 0
+	for _, n := range dataFileNames {
+		f := mustParse(t, n, orig[n])
+		for _, it := range f.Items {
+			if n == "SHOPTAB.TBL" {
+				continue // 補白是 0x20，下面另測
+			}
+			checked++
+			s, err := cs.Decode(it.Orig)
+			if (err == nil) != independentlyDecodable(it.Orig) {
+				t.Errorf("%s：Decode 的 err ＝ %v，與獨立判斷不符", it.ID, err)
+			}
+			if err != nil {
+				withErr++
+				continue
+			}
+			if whitelistOnly(it.Orig) {
+				b, bad, err := cs.Encode(s)
+				if err != nil || len(bad) != 0 || !bytes.Equal(b, it.Orig) {
+					t.Errorf("%s：Decode 再 Encode 沒有還原（err %v）", it.ID, err)
+				}
+				roundtripped++
+			}
+		}
+	}
+	t.Logf("檢查 %d 項，Decode 回 err %d 項，Decode 再 Encode 還原 %d 項", checked, withErr, roundtripped)
+	if roundtripped < 300 {
+		t.Errorf("還原的項目只有 %d，樣本太少", roundtripped)
+	}
+	if withErr == 0 || withErr > 18 {
+		t.Errorf("Decode 回 err 的項目 %d：原版有 18 處非 Big5 的孤立高位元組（docs/re/020 第 2.1 節），應為 1 至 18 項", withErr)
+	}
+}
+
+// SHOPTAB 名稱欄（尾端 0x20 補白）：去掉補白後 Decode 再 Encode 還原；補白在 Encode 是字集外字元，所以先去掉。
+func TestCharmapShopNames(t *testing.T) {
+	data := readOrig(t, "SHOPTAB.TBL")["SHOPTAB.TBL"]
+	f := mustParse(t, "SHOPTAB.TBL", data)
+	cs := mustCharmap(t)
+	n := 0
+	for _, it := range f.Items {
+		name := bytes.TrimRight(it.Orig, " ")
+		s, err := cs.Decode(name)
+		if err != nil {
+			continue
+		}
+		b, bad, err := cs.Encode(s)
+		if err == nil && len(bad) == 0 && bytes.Equal(b, name) {
+			n++
+		}
+	}
+	if n < 600 {
+		t.Errorf("還原的名稱欄只有 %d / %d", n, len(f.Items))
+	}
+}
diff --git a/apps/hr/l10n/charmapgen.go b/apps/hr/l10n/charmapgen.go
new file mode 100644
index 0000000..be7d04e
--- /dev/null
+++ b/apps/hr/l10n/charmapgen.go
@@ -0,0 +1,134 @@
+package l10n
+
+import (
+	"bytes"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// 字集的來源（docs/re/020 第 5.1、5.3 節的「全部來源」）：七個資料檔、OP.TXT 與 OP0.TXT 至 OP5.TXT，
+// 以及 MAIN.EXE、OP.EXE、END.EXE 內由 IDA 嚴格掃描取得的字串（由呼叫端經 extra 提供）。
+var charmapDataSources = []string{
+	"COUNTRY.MES", "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES", "ESPMES.MRG", "SHOPTAB.TBL",
+	"OP.TXT", "OP0.TXT", "OP1.TXT", "OP2.TXT", "OP3.TXT", "OP4.TXT", "OP5.TXT",
+}
+
+// CharmapReport 是 GenerateCharmap 的統計。
+type CharmapReport struct {
+	Total       int         // 輸出的字數
+	FromData    int         // 資料檔（七個資料檔與 OP*.TXT）的不重複字
+	FromExtra   int         // extra 字串的不重複字
+	Shared      int         // 兩者共有
+	Undecodable []uint16    // x/text 解不出單一字的碼（不輸出）
+	Collisions  [][2]uint16 // 解成同一個字的兩個碼（較小的碼在前；只輸出較小的碼）
+}
+
+// alignedChars 把 raw 依對齊解碼（由左到右，lead 為 A1 至 F9 且下一個位元組是 trail 才成對）
+// 取出的雙位元組碼加入 set。孤立的高位元組與 ASCII 略過。
+func alignedChars(raw []byte, set map[uint16]struct{}) {
+	for i := 0; i < len(raw); i++ {
+		if raw[i] >= 0xA1 && raw[i] <= 0xF9 && i+1 < len(raw) {
+			code := uint16(raw[i])<<8 | uint16(raw[i+1])
+			if validBig5Code(code) {
+				set[code] = struct{}{}
+				i++
+			}
+		}
+	}
+}
+
+// GenerateCharmap 由原版檔案位元組產生 charmap-zh-TW.tsv 的內容（純函式，不讀檔、不連網）。
+//
+// files 的鍵是檔名（大小寫不分），必須含七個資料檔與 OP.TXT、OP0.TXT 至 OP5.TXT：
+// 資料檔經 Parse 切成實體項目（SHOPTAB 取每個 20 bytes 名稱欄），OP*.TXT 依換行切成行，
+// 逐項以對齊解碼取雙位元組字，不用位元組樣式比對。
+// extra 是呼叫端提供的額外字串（MAIN.EXE、OP.EXE、END.EXE 的字串區，由 IDA 嚴格掃描取得），同樣以對齊解碼取字。
+//
+// 每個碼以 x/text 的 Big5 解碼成 Unicode；解不出單一字的記入 Undecodable，兩個碼解成同一個字的記入 Collisions，
+// 這兩種情形一對一不成立，回傳 err（TSV 仍含其餘字，供檢視）。輸出依 unicode 由小到大，
+// 兩欄 unicode、big5（十六進位大寫，至少 4 位），LF 換行。
+func GenerateCharmap(files map[string][]byte, extra [][]byte) ([]byte, CharmapReport, error) {
+	byName := make(map[string][]byte, len(files))
+	for n, b := range files {
+		byName[strings.ToUpper(n)] = b
+	}
+	var missing []string
+	for _, n := range charmapDataSources {
+		if _, ok := byName[n]; !ok {
+			missing = append(missing, n)
+		}
+	}
+	if len(missing) > 0 {
+		return nil, CharmapReport{}, fmt.Errorf("l10n: 缺少來源檔 %s", strings.Join(missing, "、"))
+	}
+	data := make(map[uint16]struct{})
+	for _, n := range charmapDataSources {
+		b := byName[n]
+		if strings.HasSuffix(n, ".TXT") {
+			for _, ln := range bytes.Split(b, []byte("\n")) {
+				alignedChars(ln, data)
+			}
+			continue
+		}
+		f, err := Parse(n, b)
+		if err != nil {
+			return nil, CharmapReport{}, err
+		}
+		for _, it := range f.Items {
+			alignedChars(it.Orig, data)
+		}
+	}
+	ex := make(map[uint16]struct{})
+	for _, s := range extra {
+		alignedChars(s, ex)
+	}
+	var rep CharmapReport
+	rep.FromData, rep.FromExtra = len(data), len(ex)
+	all := make(map[uint16]struct{}, len(data)+len(ex))
+	for c := range data {
+		all[c] = struct{}{}
+	}
+	for c := range ex {
+		if _, ok := data[c]; ok {
+			rep.Shared++
+		}
+		all[c] = struct{}{}
+	}
+	codes := make([]int, 0, len(all))
+	for c := range all {
+		codes = append(codes, int(c))
+	}
+	sort.Ints(codes)
+	type ent struct {
+		r rune
+		c uint16
+	}
+	var ents []ent
+	owner := make(map[rune]uint16)
+	for _, ci := range codes {
+		code := uint16(ci)
+		r, ok := big5Rune(code)
+		if !ok || r < 0x80 {
+			rep.Undecodable = append(rep.Undecodable, code)
+			continue
+		}
+		if first, dup := owner[r]; dup {
+			rep.Collisions = append(rep.Collisions, [2]uint16{first, code})
+			continue
+		}
+		owner[r] = code
+		ents = append(ents, ent{r, code})
+	}
+	sort.Slice(ents, func(i, j int) bool { return ents[i].r < ents[j].r })
+	var out bytes.Buffer
+	out.WriteString(charmapHeader + "\n")
+	for _, e := range ents {
+		fmt.Fprintf(&out, "%04X\t%04X\n", e.r, e.c)
+	}
+	rep.Total = len(ents)
+	if len(rep.Undecodable) > 0 || len(rep.Collisions) > 0 {
+		return out.Bytes(), rep, fmt.Errorf("l10n: 一對一不成立：%d 個碼解不出單一字，%d 組碼解成同一個字", len(rep.Undecodable), len(rep.Collisions))
+	}
+	return out.Bytes(), rep, nil
+}
