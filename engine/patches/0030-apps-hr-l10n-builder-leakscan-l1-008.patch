+func wrapped(t *testing.T, in Input) []byte {
+	t.Helper()
+	out, vs := AutoWrap(in)
+	if len(vs) != 0 {
+		t.Fatalf("AutoWrap 回違規：%+v", vs)
+	}
+	return out
+}
+
+func TestAutoWrapNoChange(t *testing.T) {
+	in := okInput()
+	out := wrapped(t, in)
+	if !bytes.Equal(out, in.Trans) {
+		t.Fatalf("沒有超寬的行不該改動：%x", out)
+	}
+	// 回傳的是複本，改它不影響輸入
+	out[0] ^= 0xFF
+	if in.Trans[0] != 0xA4 {
+		t.Fatal("AutoWrap 不該回傳輸入的別名")
+	}
+}
+
+// 20 個雙位元組字（40 bytes）超過 W ＝ 30：折成 15 個字加 5 個字（沒有標點時，非標點折點一次，
+// 平手時第一列盡量填滿），折完整體通過 Check。
+func TestAutoWrapBasic(t *testing.T) {
+	in := okInput()
+	in.Trans = pairs(0xA4, 0x40, 20)
+	out := wrapped(t, in)
+	want := cat(pairs(0xA4, 0x40, 15), nl, pairs(0xA4, 0x4F, 5))
+	if !bytes.Equal(out, want) {
+		t.Fatalf("折行結果 %x，要 %x", out, want)
+	}
+	in.Trans = out
+	if vs := Check(in); len(vs) != 0 {
+		t.Fatalf("折完應通過 Check：%+v", vs)
+	}
+}
+
+// 優先在標點之後折：第 10 個字是符號區的字（lead A1），在它之後折（兩列各 20 bytes），而不是填滿第一列。
+func TestAutoWrapPunctuation(t *testing.T) {
+	in := okInput()
+	in.Trans = cat(pairs(0xA4, 0x40, 9), hb("A1 43"), pairs(0xA4, 0x50, 10))
+	out := wrapped(t, in)
+	want := cat(pairs(0xA4, 0x40, 9), hb("A1 43"), nl, pairs(0xA4, 0x50, 10))
+	if !bytes.Equal(out, want) {
+		t.Fatalf("折行結果 %x，要 %x", out, want)
+	}
+}
+
+// 不選違規折點：第 15 個字是 (A4, E0)，最貪婪的折點會使第一列以它結尾而吃掉換行。
