+// 歷史串流。
+type rec struct{ commit, path, content string }
+
+// streamBody 是沒有結尾標記的記錄串流；stream 在後面加上結尾標記 `END\t<記錄數>\n`。
+func streamBody(recs ...rec) string {
+	var sb strings.Builder
+	for _, r := range recs {
+		fmt.Fprintf(&sb, "%s\t%s\t%d\n%s\n", r.commit, r.path, len(r.content), r.content)
+	}
+	return sb.String()
+}
+
+func stream(recs ...rec) string {
+	return streamBody(recs...) + fmt.Sprintf("END\t%d\n", len(recs))
+}
