+// 標頭宣稱很大的內容、實際只有一點點：不依標頭大小預先配置，明確失敗。
+func TestHistoryNoPreallocation(t *testing.T) {
+	w := newWorld("合成", synthFiles())
+	in := fmt.Sprintf("c1\ta.txt\t%d\nshort\n", maxRecord) // 宣稱 maxRecord 大，內容被截斷
+	var ms0, ms1 runtime.MemStats
+	runtime.GC()
+	runtime.ReadMemStats(&ms0)
+	_, err := ScanHistory(w.ix, strings.NewReader(in), func(Hit) {})
+	runtime.ReadMemStats(&ms1)
+	if err == nil || !strings.Contains(err.Error(), "截斷") {
+		t.Fatalf("被截斷的大記錄必須失敗：%v", err)
+	}
+	if grew := ms1.TotalAlloc - ms0.TotalAlloc; grew > 32<<20 {
+		t.Errorf("讀取一個宣稱 %d bytes、實際只有幾個 bytes 的記錄配置了 %d bytes：不應依標頭大小預先配置", maxRecord, grew)
