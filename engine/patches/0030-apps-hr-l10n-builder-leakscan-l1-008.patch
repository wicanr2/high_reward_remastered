+package l10n
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+// 手寫的 ESPMES：外層 N ＝ 6（5 個群組）。群組 1 有兩個項目 "Hi"、"Yo"，群組 3 有一個項目 "Z"，
+// 群組 0、2、4 是空群組（偏移取下一個非空群組的起點，最後一個取檔尾）。
+//
+//	06 00
+//	16 00 00 00   群組 0：空，取群組 1 的起點 22
+//	16 00 00 00   群組 1：起點 22
+//	2B 00 00 00   群組 2：空，取群組 3 的起點 43
+//	2B 00 00 00   群組 3：起點 43
+//	38 00 00 00   群組 4：空，取檔尾 56
+//	群組 1（21 bytes）：03 00 | 0E 00 00 00  11 00 00 00  14 00 00 00 | "Hi" 00 "Yo" 00 | FF
+//	群組 3（13 bytes）：02 00 | 0A 00 00 00  0C 00 00 00 | "Z" 00 | FF
+var espLiteral = []byte{
+	0x06, 0x00,
+	0x16, 0x00, 0x00, 0x00,
+	0x16, 0x00, 0x00, 0x00,
+	0x2B, 0x00, 0x00, 0x00,
+	0x2B, 0x00, 0x00, 0x00,
+	0x38, 0x00, 0x00, 0x00,
+	0x03, 0x00, 0x0E, 0x00, 0x00, 0x00, 0x11, 0x00, 0x00, 0x00, 0x14, 0x00, 0x00, 0x00,
+	'H', 'i', 0x00, 'Y', 'o', 0x00, 0xFF,
+	0x02, 0x00, 0x0A, 0x00, 0x00, 0x00, 0x0C, 0x00, 0x00, 0x00,
+	'Z', 0x00, 0xFF,
+}
+
+func TestESPLiteral(t *testing.T) {
+	f := mustParse(t, "ESPMES.MRG", espLiteral)
+	if f.Kind != KindESP || f.Name != "ESPMES.MRG" {
+		t.Fatalf("Kind／Name：%v %s", f.Kind, f.Name)
+	}
+	var ids []string
+	for _, it := range f.Items {
+		ids = append(ids, it.ID+"="+string(it.Orig))
+	}
+	if got := strings.Join(ids, " "); got != "ESPMES#1.0=Hi ESPMES#1.1=Yo ESPMES#3.0=Z" {
+		t.Errorf("項目：%s", got)
+	}
+	if len(f.espGroups) != 5 {
+		t.Fatalf("群組數 %d，應為 5", len(f.espGroups))
+	}
+	for g, wantEmpty := range []bool{true, false, true, false, true} {
+		if f.espGroups[g].empty != wantEmpty {
+			t.Errorf("群組 %d 的 empty ＝ %v", g, f.espGroups[g].empty)
+		}
+	}
+	if got := mustSerialize(t, f, nil, SerializeOptions{}); !bytes.Equal(got, espLiteral) {
+		t.Errorf("identity 不符：\n got %X\nwant %X", got, espLiteral)
+	}
+	// 與獨立造出的位元組一致（驗證 buildESP 與手寫位元組相同）。
+	if got := buildESP(5, map[int][]string{1: {"Hi", "Yo"}, 3: {"Z"}}); !bytes.Equal(got, espLiteral) {
+		t.Errorf("buildESP 與手寫位元組不同：%X", got)
+	}
+}
+
+func TestESPReplaceRewritesOffsetsAndFF(t *testing.T) {
+	f := mustParse(t, "ESPMES.MRG", espLiteral)
+	repl := map[string][]byte{"ESPMES#1.0": []byte("Hello"), "ESPMES#3.0": []byte("")}
+	got := mustSerialize(t, f, repl, SerializeOptions{})
+	want := buildESP(5, map[int][]string{1: {"Hello", "Yo"}, 3: {""}})
+	if !bytes.Equal(got, want) {
+		t.Fatalf("取代後：\n got %X\nwant %X", got, want)
+	}
+	// 每個非空群組都以 `00 FF` 結尾（序列化要重新寫出 FF）；群組長度 ＝ 末偏移 ＋ 1。
+	n := int(binary.LittleEndian.Uint16(got))
+	var offs []int
+	for i := 0; i < n-1; i++ {
+		offs = append(offs, int(binary.LittleEndian.Uint32(got[2+4*i:])))
+	}
+	for g := 0; g < n-1; g++ {
+		end := len(got)
+		if g+1 < n-1 {
+			end = offs[g+1]
+		}
+		if offs[g] == end {
+			continue
+		}
+		grp := got[offs[g]:end]
+		if len(grp) < 2 || grp[len(grp)-2] != 0x00 || grp[len(grp)-1] != 0xFF {
+			t.Errorf("群組 %d 沒有以 00 FF 結尾：…%X", g, grp[max(0, len(grp)-4):])
+		}
+		n2 := int(binary.LittleEndian.Uint16(grp))
+		last := int(binary.LittleEndian.Uint32(grp[2+4*(n2-1):]))
+		if last+1 != len(grp) {
+			t.Errorf("群組 %d：末偏移 %d，群組長度 %d（應為末偏移 + 1）", g, last, len(grp))
+		}
+	}
+}
+
+// 獨立的項目總數斷言：用測試自己的讀法數 N2 - 1，不經過套件的解析器。
+func espCountsIndependently(data []byte) (perGroup map[int]int, total int) {
+	n := int(binary.LittleEndian.Uint16(data))
+	offs := make([]int, n-1)
+	for i := range offs {
+		offs[i] = int(binary.LittleEndian.Uint32(data[2+4*i:]))
+	}
+	perGroup = map[int]int{}
+	for g := range offs {
+		end := len(data)
+		if g+1 < len(offs) {
+			end = offs[g+1]
+		}
+		if offs[g] == end {
+			continue
+		}
+		n2 := int(binary.LittleEndian.Uint16(data[offs[g]:]))
+		perGroup[g] = n2 - 1
+		total += n2 - 1
+	}
+	return
+}
+
+func parsedCounts(f *File) (perGroup map[int]int, total int) {
+	perGroup = map[int]int{}
+	for _, it := range f.Items {
+		var g, j int
+		if _, err := fmt.Sscanf(it.ID, "ESPMES#%d.%d", &g, &j); err != nil {
+			panic(err)
+		}
+		perGroup[g]++
+		total++
+	}
+	return
+}
+
+func TestESPCountsSynthetic(t *testing.T) {
+	data := buildESP(9, map[int][]string{2: {"a", "b", "c"}, 5: {"d"}, 8: {"e", "f"}})
+	per, total := espCountsIndependently(data)
+	if total != 6 || per[2] != 3 || per[5] != 1 || per[8] != 2 {
+		t.Fatalf("獨立讀法本身有誤：%v %d", per, total)
+	}
+	f := mustParse(t, "ESPMES.MRG", data)
+	gp, gt := parsedCounts(f)
+	if gt != total {
+		t.Errorf("解析器項目總數 %d，獨立讀法 %d", gt, total)
+	}
+	for g, c := range per {
+		if gp[g] != c {
+			t.Errorf("群組 %d：解析器 %d 項，N2 - 1 ＝ %d", g, gp[g], c)
+		}
+	}
+	if len(gp) != len(per) {
+		t.Errorf("非空群組數：解析器 %d，獨立讀法 %d", len(gp), len(per))
+	}
+}
+
+func TestESPEmptyAndZeroItemGroups(t *testing.T) {
+	// 群組 1 非空但沒有項目（N2 ＝ 1，區段 7 bytes），群組 0 與 2 為空，群組 3 有一項。
+	data := buildESP(4, map[int][]string{1: {}, 3: {"x"}})
+	f := mustParse(t, "ESPMES.MRG", data)
+	if len(f.Items) != 1 || f.Items[0].ID != "ESPMES#3.0" {
+		t.Fatalf("項目：%+v", f.Items)
+	}
+	if f.espGroups[1].empty || f.espGroups[1].count != 0 {
+		t.Errorf("群組 1 應為非空、零項目：%+v", f.espGroups[1])
+	}
+	if got := mustSerialize(t, f, nil, SerializeOptions{}); !bytes.Equal(got, data) {
+		t.Errorf("identity 不符：\n got %X\nwant %X", got, data)
+	}
+}
+
+func TestESPParseErrors(t *testing.T) {
+	good := cloneBytes(espLiteral)
+	mut := func(f func(b []byte)) []byte { b := cloneBytes(good); f(b); return b }
+	cases := []struct {
+		name string
+		data []byte
+		sub  string
+	}{
+		{"太短", []byte{0x06}, "短於"},
+		{"沒有群組", []byte{0x01, 0x00, 0xFF}, "沒有群組"},
+		{"外層偏移表超出檔案", []byte{0x7F, 0x00, 0x00, 0x00}, "超出檔案"},
+		{"外層首偏移不是表尾", mut(func(b []byte) { b[2] = 0x17 }), "首偏移"},
+		{"外層偏移遞減", mut(func(b []byte) { b[10] = 0x15 }), "小於前一個"},
+		{"外層末偏移超過檔長", mut(func(b []byte) { b[18] = 0x39 }), "超過檔長"},
+		{"內層首偏移錯", mut(func(b []byte) { b[22+2]++ }), "內層首偏移"},
+		{"內層末偏移不指向 FF", mut(func(b []byte) { b[22+10]-- }), "內層末偏移"},
+		{"區段最後不是 FF", mut(func(b []byte) { b[22+20] = 0xFE }), "0xFF"},
+		{"項目不以 NUL 結尾", mut(func(b []byte) { b[22+16] = 'x' }), "NUL"},
+		{"內層偏移不遞增", mut(func(b []byte) { b[22+6] = 0x0E }), "不小於"},
+	}
+	for _, c := range cases {
+		_, err := Parse("ESPMES.MRG", c.data)
+		if err == nil {
+			t.Errorf("%s：應該回錯", c.name)
+			continue
+		}
+		if !strings.Contains(err.Error(), c.sub) {
+			t.Errorf("%s：錯誤訊息 %q 不含 %q", c.name, err, c.sub)
+		}
+	}
+}
+
+func TestESPReplValidation(t *testing.T) {
+	f := mustParse(t, "ESPMES.MRG", espLiteral)
+	if _, err := f.Serialize(map[string][]byte{"ESPMES#2.0": []byte("x")}, SerializeOptions{}); err == nil {
+		t.Error("空群組沒有項目，替換應回錯")
+	}
+	if _, err := f.Serialize(map[string][]byte{"ESPMES#1.0": []byte("a\x00")}, SerializeOptions{}); err == nil {
+		t.Error("內含 NUL 的替換應回錯")
+	}
+}
