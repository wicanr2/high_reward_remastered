index 0000000..79ea107
--- /dev/null
+++ b/apps/hr/l10n/verify/verify.go
@@ -0,0 +1,333 @@
+// Package verify 驗證語言包（docs/spec/008 第 3.2 節）：manifest 的型別、讀寫與驗證函式。
+//
+// 這是葉層套件，只 import 標準庫：runtime（Session.Open）、apps/hr/l10n（建置器）與 cmd/hrl10n 都 import 它，
+// 所以不會讓 runtime 與 apps/hr/l10n 互相 import。Manifest 型別只定義在這裡，建置端寫、驗證端讀同一個型別，
+// 避免兩處欄位漂移。
+//
+// 語言包目錄結構：
+//
+//	<包根>/manifest.json   在 files/ 之外，避免被 searchFor 列舉
+//	<包根>/files/<檔名>     LangDir，只放 manifest 列出的檔
+//
+// 驗證失敗的錯誤是 *Error：Code 是原因鍵，Detail 不含原版文字與譯文，只有檔名、數字、雜湊與固定句式。
+package verify
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// 目錄與檔名。
+const (
+	ManifestName = "manifest.json"
+	FilesDir     = "files"
+)
+
+// ManifestFormat 是 manifest 的格式版本。
+const ManifestFormat = 1
+
+// inputNames 是語言包建置的九個原版輸入（大寫檔名，依字母序）：七個資料檔、字模與 MAIN.EXE（spec 第 1 節）。
+var inputNames = []string{
+	"CFONT.15", "COUNTRY.MES", "ESPMES.MRG", "MAIN.EXE", "POWERMES.MES", "SHOPTAB.TBL", "SP.MES", "SYSTEM.MES", "UWASA.MES",
+}
+
+// InputNames 回傳九個原版輸入的檔名（大寫，依字母序）。每次回傳新的切片。
+func InputNames() []string { return append([]string(nil), inputNames...) }
+
+// FileEntry 是 manifest 列出的一個檔案。
+type FileEntry struct {
+	Name   string `json:"name"`
+	SHA256 string `json:"sha256"`
+	Size   int64  `json:"size"`
+}
+
+// Policy 是建置政策（spec 第 3.2 節）：模式 `table` 或 `identity`，加三個旗標。
+type Policy struct {
+	Mode                string `json:"mode"`
+	WithCandidates      bool   `json:"with_candidates"`
+	AllowCountryOffsets bool   `json:"allow_country_offsets"`
+	AllowShoptab        bool   `json:"allow_shoptab"`
+}
+
+// Canonical 以固定順序序列化政策（輸入摘要用）：模式、with-candidates、allow-country-offsets、allow-shoptab。
+func (p Policy) Canonical() string {
+	b := func(v bool) string {
+		if v {
+			return "1"
+		}
+		return "0"
+	}
+	return "mode=" + p.Mode +
+		";with-candidates=" + b(p.WithCandidates) +
+		";allow-country-offsets=" + b(p.AllowCountryOffsets) +
+		";allow-shoptab=" + b(p.AllowShoptab)
+}
+
+// Manifest 是語言包的 manifest.json。欄位順序固定、不含時間戳記與主機資訊，所以同輸入的建置輸出逐位元相同。
+type Manifest struct {
+	Format         int               `json:"format"`
+	Code           string            `json:"code"`
+	Policy         Policy            `json:"policy"`
+	Files          []FileEntry       `json:"files"`        // 依檔名排序
+	OrigInputs     map[string]string `json:"orig_inputs"`  // 九個原版輸入：檔名到 SHA-256（encoding/json 依鍵排序輸出）
+	TableHash      string            `json:"table_hash"`   // 譯文表整體雜湊
+	TableFormat    string            `json:"table_format"` // 譯文表格式版本
+	PatchHash      string            `json:"patch_hash"`   // 補丁雜湊（L1 為空字串）
+	BuilderVersion string            `json:"builder_version"`
+	InputDigest    string            `json:"input_digest"`
+	Adopted        int               `json:"adopted"` // 實際被採用的非 keep 譯文列數
+}
+
+// Marshal 回傳 manifest.json 的位元組：兩格縮排、結尾一個 LF。
+func (m *Manifest) Marshal() ([]byte, error) {
+	b, err := json.MarshalIndent(m, "", "  ")
+	if err != nil {
+		return nil, err
+	}
+	return append(b, '\n'), nil
+}
+
+// ParseManifest 解析 manifest.json 的位元組。未知欄位與結尾多餘的內容都視為格式錯誤（失敗即關閉）。
+func ParseManifest(raw []byte) (*Manifest, error) {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.DisallowUnknownFields()
+	var m Manifest
+	if err := dec.Decode(&m); err != nil {
+		return nil, err
+	}
+	if _, err := dec.Token(); !errors.Is(err, io.EOF) {
+		return nil, errors.New("json 之後還有多餘內容")
+	}
+	return &m, nil
+}
+
+// 原因鍵。
+const (
+	CodeBadOptions     = "bad-options"  // 呼叫端沒給必要的選項
+	CodeNoManifest     = "no-manifest"  // manifest.json 不存在或不是一般檔案
+	CodeBadManifest    = "bad-manifest" // manifest 格式錯誤
+	CodeFileMissing    = "file-missing" // manifest 列出的檔案不存在
+	CodeFileUnsafe     = "file-unsafe"  // 檔案不是一般檔案（目錄、符號連結等）
+	CodeFileSize       = "file-size"    // 位元組數不符
+	CodeFileHash       = "file-hash"    // SHA-256 不符
+	CodeFileExtra      = "file-extra"   // files/ 內有 manifest 沒列的項目
+	CodeOrigHash       = "orig-hash"    // 原版輸入雜湊不符
+	CodeDigestMismatch = "digest"       // 輸入摘要不符
+)
+
+// Error 是驗證失敗的錯誤。Code 是原因鍵，Detail 不含原版文字與譯文，只有檔名、數字、雜湊與固定句式。
+type Error struct {
+	Code   string
+	Detail string
+}
+
+func (e *Error) Error() string {
+	if e.Detail == "" {
+		return "l10n verify: " + e.Code
+	}
+	return "l10n verify: " + e.Code + ": " + e.Detail
+}
+
+func fail(code, format string, a ...any) error {
+	return &Error{Code: code, Detail: fmt.Sprintf(format, a...)}
+}
+
+// IsCode 判斷 err 是否為原因鍵是 code 的驗證錯誤。
+func IsCode(err error, code string) bool {
+	var e *Error
+	return errors.As(err, &e) && e.Code == code
+}
+
+// Options 是驗證選項。
+type Options struct {
+	// OrigHashes：原版檔名到 SHA-256（小寫十六進位）。必須含九個輸入（InputNames）；多的忽略。
+	// manifest 記錄的九個原版輸入雜湊必須與它逐一相符，且 manifest 不得多出別的鍵。
+	OrigHashes map[string]string
+	// ExpectDigest：預期的輸入摘要。SkipDigest 為假時必填，並與 manifest 的 InputDigest 相等。
+	ExpectDigest string
+	// SkipDigest 為真時略過輸入摘要這一項，其餘驗證照常。
+	SkipDigest bool
+}
+
+// NormalizeDir 把目錄正規化成 `filepath.Abs` 加 `filepath.Clean`（與 runtime 的 normDir 同一條規則）。
+func NormalizeDir(dir string) (string, error) {
+	abs, err := filepath.Abs(dir)
+	if err != nil {
+		return "", err
+	}
+	return filepath.Clean(abs), nil
+}
+
+// ManifestSHA256 回傳 packRoot 下 manifest.json 原始位元組的 SHA-256（小寫十六進位）。
+func ManifestSHA256(packRoot string) (string, error) {
+	raw, err := os.ReadFile(filepath.Join(packRoot, ManifestName))
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+func isHex64(s string) bool {
+	if len(s) != 64 {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+// safeName 判斷 manifest 列出的檔名只是一個檔名（不含路徑成分）：白名單 `[A-Za-z0-9._-]+`，且不是 `.` 與 `..`。
+// 白名單同時擋掉路徑分隔符、NUL 與 Windows 的 `:`（NTFS 替代資料流）。八個語言包檔名（七個資料檔與 CFONT.15）都在白名單內。
+// Windows 的保留裝置名（CON、NUL 等）照規格不擋：檔名清單由建置器寫出，不會產出保留名，要放進 manifest 得先有
+// 資料目錄的寫入權；擋它要維護一份隨 Windows 版本變動的名單，得不償失。
+func safeName(n string) bool {
+	if n == "" || n == "." || n == ".." {
+		return false
+	}
+	for i := 0; i < len(n); i++ {
+		c := n[i]
+		if !(c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '.' || c == '_' || c == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+// hashFile 回傳檔案的 SHA-256 與位元組數。
+func hashFile(p string) (string, int64, error) {
+	f, err := os.Open(p)
+	if err != nil {
+		return "", 0, err
+	}
+	defer f.Close()
+	h := sha256.New()
+	n, err := io.Copy(h, f)
+	if err != nil {
+		return "", 0, err
+	}
+	return hex.EncodeToString(h.Sum(nil)), n, nil
+}
+
+// Verify 驗證 root（含 manifest.json 的語言包根）：
+//   - manifest 格式正確；列出的檔名只是檔名、不重複（大小寫不分）、雜湊是 64 碼小寫十六進位；
+//   - manifest 列出的檔案都在 files/ 內、是一般檔案、位元組數與 SHA-256 相符；
+//   - files/ 內沒有 manifest 沒列的項目（只掃 files/，包根的其他檔不看）；
+//   - 原版輸入雜湊與 opt.OrigHashes 相符（九個輸入，一個不多一個不少）；
+//   - 輸入摘要等於 opt.ExpectDigest（SkipDigest 為真時略過這一項）。
+//
+// 成功回傳 manifest；失敗回 *Error。
+func Verify(root string, opt Options) (*Manifest, error) {
+	if len(opt.OrigHashes) == 0 {
+		return nil, fail(CodeBadOptions, "沒有原版輸入雜湊")
+	}
+	if !opt.SkipDigest && opt.ExpectDigest == "" {
+		return nil, fail(CodeBadOptions, "沒有預期輸入摘要，也沒有明示略過")
+	}
+	mp := filepath.Join(root, ManifestName)
+	if st, err := os.Lstat(mp); err != nil || !st.Mode().IsRegular() {
+		return nil, fail(CodeNoManifest, "%s", ManifestName)
+	}
+	raw, err := os.ReadFile(mp)
+	if err != nil {
+		return nil, fail(CodeNoManifest, "%s", ManifestName)
+	}
+	m, err := ParseManifest(raw)
+	if err != nil {
+		return nil, fail(CodeBadManifest, "%v", err)
+	}
+	if m.Format != ManifestFormat {
+		return nil, fail(CodeBadManifest, "format=%d", m.Format)
+	}
+	if len(m.Files) == 0 {
+		return nil, fail(CodeBadManifest, "沒有列出任何檔案")
+	}
+	seen := make(map[string]bool, len(m.Files))
+	for _, fe := range m.Files {
+		if !safeName(fe.Name) {
+			return nil, fail(CodeBadManifest, "檔名 %q 不是單純的檔名", fe.Name)
+		}
+		up := strings.ToUpper(fe.Name)
+		if seen[up] {
+			return nil, fail(CodeBadManifest, "檔名 %s 重複", fe.Name)
+		}
+		seen[up] = true
+		if !isHex64(fe.SHA256) || fe.Size < 0 {
+			return nil, fail(CodeBadManifest, "%s 的雜湊或大小格式不符", fe.Name)
+		}
+	}
+
+	filesDir := filepath.Join(root, FilesDir)
+	listed := make(map[string]bool, len(m.Files))
+	for _, fe := range m.Files {
+		listed[fe.Name] = true
+		p := filepath.Join(filesDir, fe.Name)
+		st, err := os.Lstat(p)
+		if err != nil {
+			return nil, fail(CodeFileMissing, "%s", fe.Name)
+		}
+		if !st.Mode().IsRegular() {
+			return nil, fail(CodeFileUnsafe, "%s", fe.Name)
+		}
+		if st.Size() != fe.Size {
+			return nil, fail(CodeFileSize, "%s manifest=%d actual=%d", fe.Name, fe.Size, st.Size())
+		}
+		sum, n, err := hashFile(p)
+		if err != nil {
+			return nil, fail(CodeFileMissing, "%s", fe.Name)
+		}
+		if n != fe.Size {
+			return nil, fail(CodeFileSize, "%s manifest=%d actual=%d", fe.Name, fe.Size, n)
+		}
+		if sum != fe.SHA256 {
+			return nil, fail(CodeFileHash, "%s", fe.Name)
+		}
+	}
+	ents, err := os.ReadDir(filesDir)
+	if err != nil {
+		return nil, fail(CodeFileMissing, "%s/", FilesDir)
+	}
+	for _, e := range ents {
+		if !listed[e.Name()] {
+			return nil, fail(CodeFileExtra, "%s", e.Name())
+		}
+	}
+
+	want := make(map[string]string, len(inputNames))
+	have := make(map[string]string, len(opt.OrigHashes))
+	for k, v := range opt.OrigHashes {
+		have[strings.ToUpper(k)] = v
+	}
+	for _, n := range inputNames {
+		h, ok := have[n]
+		if !ok {
+			return nil, fail(CodeBadOptions, "原版輸入雜湊缺 %s", n)
+		}
+		want[n] = h
+	}
+	if len(m.OrigInputs) != len(want) {
+		return nil, fail(CodeOrigHash, "manifest 的原版輸入有 %d 項，應為 %d 項", len(m.OrigInputs), len(want))
+	}
+	for _, n := range inputNames {
+		if got, ok := m.OrigInputs[n]; !ok || got != want[n] {
+			return nil, fail(CodeOrigHash, "%s", n)
+		}
+	}
+
+	if !opt.SkipDigest && m.InputDigest != opt.ExpectDigest {
+		return nil, fail(CodeDigestMismatch, "manifest=%s expect=%s", m.InputDigest, opt.ExpectDigest)
+	}
+	return m, nil
+}
