+// ExpectedInputHashes：預設取 runtime 內嵌的 required.tsv（與 Session.Open 的來源相同），override 非空時取它，
+// 缺任何一個輸入就回錯。hrl10n verify 以它當原版雜湊的預設來源。
+func TestExpectedInputHashes(t *testing.T) {
+	req, err := requiredInputHashes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := ExpectedInputHashes(nil)
+	if err != nil || len(got) != len(verify.InputNames()) {
+		t.Fatalf("預設：%d 項（%v）", len(got), err)
+	}
+	for _, n := range verify.InputNames() {
+		if got[n] != req[n] || len(got[n]) != 64 {
+			t.Errorf("%s：%q，應等於 required.tsv 的 %q", n, got[n], req[n])
+		}
+	}
+	over := map[string]string{}
+	for i, n := range verify.InputNames() {
+		over[strings.ToLower(n)] = sha256Hex([]byte{byte(i)}) // 鍵大小寫不分
+	}
+	got, err = ExpectedInputHashes(over)
+	if err != nil || got["SP.MES"] != over["sp.mes"] || got["MAIN.EXE"] != over["main.exe"] {
+		t.Errorf("override 沒有生效：%v（%v）", got, err)
+	}
+	delete(over, "uwasa.mes")
+	if _, err := ExpectedInputHashes(over); err == nil || !strings.Contains(err.Error(), "UWASA.MES") {
+		t.Errorf("override 缺一個輸入應回錯並點名：%v", err)
+	}
+}
