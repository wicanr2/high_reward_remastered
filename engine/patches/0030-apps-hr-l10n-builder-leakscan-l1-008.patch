+// CleanPath 與 allowlist 的路徑比對：./ 前綴、重複斜線、. 與 .. 段都正規化後才比對。
+func TestCleanPath(t *testing.T) {
+	for in, want := range map[string]string{
+		"a/b.md":      "a/b.md",
+		"./a/b.md":    "a/b.md",
+		"a//b.md":     "a/b.md",
+		"a/./b.md":    "a/b.md",
+		"a/c/../b.md": "a/b.md",
+		"./a//b.md":   "a/b.md",
+		"/abs/x":      "/abs/x",
+		"b.md":        "b.md",
+	} {
+		if got := CleanPath(in); got != want {
+			t.Errorf("CleanPath(%q) ＝ %q，要 %q", in, got, want)
+		}
+	}
+	set := NewAllowSet([]AllowEntry{{Path: CleanPath("./a//b.md"), UnitID: "SP.MES@0.0"}})
+	if !set.Has("a/b.md", "SP.MES@0.0") || !set.Has("./a/./b.md", "SP.MES@0.0") {
+		t.Error("寫法不同但正規化後相同的路徑應被放行")
+	}
+	if set.Has("a/c.md", "SP.MES@0.0") || set.Has("a/b.md", "SP.MES@0.1") {
+		t.Error("路徑或單位身分不同不應放行")
+	}
+	// 經 ParseAllow：allowlist 寫 ./a//b.md，輸出的路徑是 a/b.md。
+	entries, rejects, err := ParseAllow(strings.NewReader("./a//b.md\tSP.MES@0.0\n"))
+	if err != nil || len(rejects) != 0 || len(entries) != 1 || entries[0].Path != "a/b.md" {
+		t.Errorf("ParseAllow 的路徑正規化：%v %v %v", entries, rejects, err)
+	}
+}
