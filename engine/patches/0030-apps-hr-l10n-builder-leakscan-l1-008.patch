+// utf16Bytes 把字串編成 UTF-16（只含 BMP 字元），可選大端與 BOM。
+func utf16Bytes(s string, be, bom bool) []byte {
+	var out []byte
+	put := func(v uint16) {
+		if be {
+			out = append(out, byte(v>>8), byte(v))
+		} else {
+			out = append(out, byte(v), byte(v>>8))
+		}
+	}
+	if bom {
+		put(0xFEFF)
+	}
+	for _, r := range s {
+		put(uint16(r))
+	}
+	return out
+}
