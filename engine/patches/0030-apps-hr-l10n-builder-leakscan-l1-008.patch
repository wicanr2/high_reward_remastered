+// 試點邊界變體（規格第 4 節 L1 試點）：k ＝ 31，P 集位元組在偏移 30，下一次呼叫偏移 32（k ＋ 1）。
+func TestConcretePilotBoundary(t *testing.T) {
+	filler := func(n int) []byte { // S 集、不含 0x20 與 0x25
+		b := make([]byte, n)
+		for i := range b {
+			b[i] = 'A'
+		}
+		return b
+	}
+	// 前 30 個位元組為 S 集，偏移 30 為 P（E0），偏移 31 為 S，偏移 32 至 34 為 E0 E1 0A，偏移 35 起接 S 集再 NUL
+	s := cat(filler(30), hb("E0 42 E0 E1 0A 43 43"))
+	offs, eats := ConcreteCalls(s, 31)
+	if !reflect.DeepEqual(offs, []int{0, 32, 35}) || eats {
+		t.Fatalf("同步假說：偏移 %v 吃換行 %v，要 [0 32 35]、false", offs, eats)
+	}
+	// 位移假說：第二次呼叫從位移狀態起算，偏移 32 的 E0 被吃、E1 多吃 0A，只有兩次呼叫。
+	// 以「從偏移 33 起的同步模擬」表示（E0 已被吃）。
+	offs2, eats2 := ConcreteCalls(s[33:], 31)
+	if len(offs2) != 1 || !eats2 {
+		t.Fatalf("位移假說：偏移 %v 吃換行 %v，要一次呼叫且吃換行", offs2, eats2)
+	}
+	// 對照組：P 集位元組在偏移 29，偏移 30 起全為 S 集（不含 0A）直到 NUL，預測偏移 31，兩個假說預測相同
+	c := cat(filler(29), hb("E0"), filler(20))
+	offs3, eats3 := ConcreteCalls(c, 31)
+	if !reflect.DeepEqual(offs3, []int{0, 31}) || eats3 {
+		t.Fatalf("對照組：偏移 %v 吃換行 %v，要 [0 31]、false", offs3, eats3)
+	}
+}
