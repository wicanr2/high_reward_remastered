@@ -0,0 +1,66 @@
+package l10n
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/budget"
+)
+
+// 預算套件（apps/hr/l10n/budget）與譯文表採用規則（Table.Adopt）的接合點（docs/spec/008 第 3.5 節）。
+//
+// Adopt 的 Checker 只回違規字串，回不了位元組；而自動折行會改變最後寫進檔案的位元組。所以建置用的 wrapRun
+// 在 Checker 內做「AutoWrap，再對折完的位元組跑 Check」，把折完的位元組存進側表，Adopt 結束後由建置器取代
+// repl 的內容：寫進檔案的位元組就是剛剛通過 Check 的那一份。
+// BudgetChecker 是只檢查、不折行的版本（對編碼後的位元組直接跑 Check）。
+
+// shopFile 是 SHOPTAB 的檔名。預算套件沒有 SHOPTAB 的窗口（名稱欄不走對話框），Check 對它一律回 unknown-window，
+// 所以兩個 Checker 都略過它：名稱欄只受 Adopt 的規則（<= 20 bytes、不含換行、轉換規格與原項目逐字相同）
+// 與 Serialize 的 0x00 檢查約束。
+const shopFile = "SHOPTAB.TBL"
+
+// violationStrings 把預算套件的違規轉成字串：`<規則鍵>: <細節>`。細節只含行號、位元組偏移與計數，不含文句。
+func violationStrings(vs []budget.Violation) []string {
+	out := make([]string, 0, len(vs))
+	for _, v := range vs {
+		if v.Detail == "" {
+			out = append(out, v.Rule)
+			continue
+		}
+		out = append(out, fmt.Sprintf("%s: %s", v.Rule, v.Detail))
+	}
+	return out
+}
+
+// BudgetChecker 把 budget.Check 轉成 Checker：對編碼後的譯文位元組直接檢查（不折行），違規字串是 `<規則鍵>: <細節>`。
+// 僅供測試與前端預檢使用：建置器本身用 wrapRun（折行加檢查），沒有正式呼叫者。
+func BudgetChecker() Checker {
+	return func(file, class, id string, orig, trans []byte) []string {
+		if strings.EqualFold(file, shopFile) {
+			return nil
+		}
+		return violationStrings(budget.Check(budget.Input{ID: id, File: file, Class: class, Orig: orig, Trans: trans}))
+	}
+}
+
+// wrapRun 是一次建置（一個資料檔）的「折行加檢查」：Checker 對每個被採用的譯文做 AutoWrap，
+// 再對折完的位元組跑 Check，折完的位元組記在 final（鍵是項目 id）。
+type wrapRun struct {
+	final map[string][]byte
+}
+
+func newWrapRun() *wrapRun { return &wrapRun{final: make(map[string][]byte)} }
+
+// checker 回傳 Adopt 用的 Checker：以 budget.WrapAndCheck 折行並對折完的位元組跑 Check（規格第 3.5 節 (g)）。
+// AutoWrap 自己的違規都能由 Check(輸出) 重新導出（budget.WrapAndCheck 的文件），所以只回 Check 的違規，不會重複。
+func (w *wrapRun) checker() Checker {
+	return func(file, class, id string, orig, trans []byte) []string {
+		if strings.EqualFold(file, shopFile) {
+			w.final[id] = trans
+			return nil
+		}
+		wrapped, vs := budget.WrapAndCheck(budget.Input{ID: id, File: file, Class: class, Orig: orig, Trans: trans})
+		w.final[id] = wrapped
+		return violationStrings(vs)
+	}
+}
