+	}
+	// 缺任何一個單位來源檔（七個資料檔與七個片頭文字檔）都失敗，且訊息指出缺哪個。
+	for _, name := range SourceFiles {
+		files := synthFiles()
+		delete(files, name)
+		dir := writeOrig(t, files)
+		code, out, errOut := runMain("", "-orig", dir, scanRoot)
