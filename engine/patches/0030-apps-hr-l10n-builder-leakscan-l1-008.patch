+// 序號目錄的探測：依序探測基底名與 -2 至 -9，第一個驗證通過者直接使用。
+func TestBuildSerialProbe(t *testing.T) {
+	w := newSynthWorld(t)
+
+	// placePack 在別的暫存根目錄建一個有效的語言包，再改名放到 root 的第 slot 個名額（0 是基底名，1 是 -2，…）。
+	// 名額由測試直接指定，與建置器的探測順序無關。
