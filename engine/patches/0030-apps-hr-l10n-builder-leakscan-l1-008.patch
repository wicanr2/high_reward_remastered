diff --git a/apps/hr/cmd/hrl10n/build.go b/apps/hr/cmd/hrl10n/build.go
new file mode 100644
index 0000000..a8618b2
--- /dev/null
+++ b/apps/hr/cmd/hrl10n/build.go
@@ -0,0 +1,146 @@
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n"
+)
+
+// origHashesOverride 覆蓋九個原版輸入的預期 SHA-256（測試縫隙，build 與 verify 共用）。
+// 正式執行為 nil，取 runtime 內嵌的 required.tsv（l10n.ExpectedInputHashes）。
+var origHashesOverride map[string]string
+
+// defaultPackRoot 是 -out 的預設值：使用者資料目錄（與 play 的 dataDir 同一條規則）下的 l10n-packs。
+// 取不到使用者設定目錄時退到暫存目錄（語言包不跨次保留，spec 第 3.2 節已知差異）。
+func defaultPackRoot() string {
+	base, err := os.UserConfigDir()
+	if err != nil {
+		base = os.TempDir()
+	}
+	return filepath.Join(base, "high_reward", "l10n-packs")
+}
+
+// runBuild 實作 `hrl10n build`（docs/spec/008 第 3.2 節命令列契約）：
+//
+//	build -code <代碼> -mode table|identity -orig <原版目錄> [-l10n <l10n 根目錄>] [-out <l10n-packs 目錄>]
+//	      [-with-candidates] [-allow-country-offsets] [-allow-shoptab] [-dup-ids]
+//
+// -l10n 是 l10n 根目錄（與前端旗標 -l10n、環境變數 HR_L10N 同義），譯文表在其下的 `<代碼>/`（代碼大小寫不分）；
+// 只有 table 模式需要。-out 預設是資料目錄的 l10n-packs（Docker 內要明示）。
+// identity 模式不讀譯文表，不接受三個政策旗標。
+// -dup-ids 在 stderr 逐個「原項目位元組相同」的群組列一行 `<檔名>: id id id`（只列 id）；沒給時只印各檔的群組數。
+// 群組只在實際建置時有資料，重用既有語言包時沒有。
+// 成功時 stdout 印三行：dir、reused、manifest-sha256。退出碼：0 成功，1 建置失敗，2 用法錯誤。
+func runBuild(args []string, _ io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("build", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	code := fs.String("code", "", "語言代碼（table 模式 zh-TW；identity 模式 zh-TW 或 identity）")
+	mode := fs.String("mode", "", "table 或 identity")
+	orig := fs.String("orig", "", "原版目錄")
+	l10nRoot := fs.String("l10n", "", "l10n 根目錄（table 模式需要；譯文表在其下的 <代碼>/）")
+	out := fs.String("out", "", "l10n-packs 目錄（預設：使用者資料目錄下的 l10n-packs）")
+	withCand := fs.Bool("with-candidates", false, "採用 candidate 列（試作包，只在 hrl10n）")
+	allowCountry := fs.Bool("allow-country-offsets", false, "允許 COUNTRY.MES 有譯文（只在 hrl10n）")
+	allowShop := fs.Bool("allow-shoptab", false, "允許 SHOPTAB.TBL 有譯文（只在 hrl10n）")
+	dupIDs := fs.Bool("dup-ids", false, "逐個重複來源群組列出 id（stderr，只列 id；預設只印各檔的群組數）")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return 0
+		}
+		return 2
+	}
+	usage := func(format string, a ...any) int {
+		fmt.Fprintf(stderr, "hrl10n build：%s\n", fmt.Sprintf(format, a...))
+		return 2
+	}
+	if fs.NArg() != 0 {
+		return usage("多餘的參數 %q", fs.Args())
+	}
+	if *code == "" || *mode == "" || *orig == "" {
+		return usage("缺必要旗標：-code、-mode、-orig")
+	}
+	cfg := l10n.Config{
+		OrigDir:    *orig,
+		PackRoot:   *out,
+		Code:       *code,
+		Mode:       l10n.Mode(*mode),
+		Policy:     l10n.Policy{WithCandidates: *withCand, AllowCountryOffsets: *allowCountry, AllowShoptab: *allowShop},
+		OrigHashes: origHashesOverride,
+	}
+	if cfg.PackRoot == "" {
+		cfg.PackRoot = defaultPackRoot()
+	}
+	switch cfg.Mode {
+	case l10n.ModeTable:
+		if *l10nRoot == "" {
+			return usage("table 模式需要 -l10n")
+		}
+		// 先做不依賴磁碟的檢查（代碼與模式的組合），再找譯文表目錄。
+		cfg.TableDir = *l10nRoot
+		if err := cfg.Validate(); err != nil {
+			return usage("%v", err)
+		}
+		dir, ok := l10n.TableDirFor(*l10nRoot, cfg.Code)
+		if !ok {
+			fmt.Fprintf(stderr, "hrl10n build：%s 底下沒有 %s 目錄（譯文表在 <l10n>/<代碼>/）\n", *l10nRoot, cfg.Code)
+			return 1
+		}
+		cfg.TableDir = dir
+	case l10n.ModeIdentity:
+		if *l10nRoot != "" {
+			return usage("identity 模式不讀譯文表，不接受 -l10n")
+		}
+		if err := cfg.Validate(); err != nil {
+			return usage("%v", err)
+		}
+	default:
+		return usage("-mode 只能是 table 或 identity，收到 %q", *mode)
+	}
+
+	res, err := l10n.Build(cfg)
+	if err != nil {
+		var ve *l10n.ViolationsError
+		if errors.As(err, &ve) {
+			fmt.Fprintf(stderr, "hrl10n build：譯文表有 %d 項違規（檔案: 項目 id: 規則鍵: 細節）：\n", len(ve.Items))
+			for _, it := range ve.Items {
+				fmt.Fprintf(stderr, "  %s\n", it)
+			}
+			return 1
+		}
+		fmt.Fprintf(stderr, "hrl10n build：%v\n", err)
+		return 1
+	}
+	fmt.Fprintf(stdout, "dir=%s\nreused=%t\nmanifest-sha256=%s\n", res.Dir, res.Reused, res.ManifestSHA256)
+	fmt.Fprintf(stderr, "hrl10n build：%s，模式 %s，採用 %d 列，輸入摘要 %s，建置器版本 %s\n",
+		map[bool]string{true: "重用既有語言包", false: "已建置"}[res.Reused],
+		res.Manifest.Policy.Mode, res.Manifest.Adopted, res.Digest, res.Manifest.BuilderVersion)
+	if len(res.Duplicates) > 0 {
+		var names []string
+		for n := range res.Duplicates {
+			names = append(names, n)
+		}
+		sort.Strings(names)
+		parts := make([]string, len(names))
+		for i, n := range names {
+			parts[i] = fmt.Sprintf("%s %d 組", n, len(res.Duplicates[n]))
+		}
+		fmt.Fprintf(stderr, "hrl10n build：原項目位元組相同的 id 群組（同群組的譯文必須相同）：%s\n", strings.Join(parts, "、"))
+		if *dupIDs {
+			for _, n := range names {
+				for _, g := range res.Duplicates[n] {
+					fmt.Fprintf(stderr, "%s: %s\n", n, strings.Join(g, " "))
+				}
+			}
+		}
+	} else if *dupIDs && res.Reused {
+		fmt.Fprintln(stderr, "hrl10n build：-dup-ids：重用既有語言包，沒有重複來源群組的資料（換一個 -out 重新建置才會列出）")
+	}
+	return 0
+}
diff --git a/apps/hr/cmd/hrl10n/build_test.go b/apps/hr/cmd/hrl10n/build_test.go
new file mode 100644
index 0000000..5774c76
--- /dev/null
+++ b/apps/hr/cmd/hrl10n/build_test.go
@@ -0,0 +1,632 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+)
+
+// `hrl10n build` 與 `hrl10n verify` 的測試（docs/spec/008 第 3.2 節命令列契約）。
+// 合成測試用自造的「原版」（位元組自造，字取自字集內的字），雜湊經 origHashesOverride 縫隙傳入（build 與 verify 共用）；
+// 端對端測試用使用者原版加 fixture（合成譯文表），缺原版明確 skip。
+
+func sum(b []byte) string {
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:])
+}
+
+func le32(v int) []byte { return binary.LittleEndian.AppendUint32(nil, uint32(v)) }
+func le16(v int) []byte { return binary.LittleEndian.AppendUint16(nil, uint16(v)) }
+
+func mesBytes(items ...string) []byte {
+	k := len(items) + 1
+	out := le16(k)
+	pos := 2 + 4*k
+	for i := 0; i < k; i++ {
+		out = append(out, le32(pos)...)
+		if i < len(items) {
+			pos += len(items[i]) + 1
+		}
+	}
+	for _, it := range items {
+		out = append(out, it...)
+		out = append(out, 0)
+	}
+	return append(out, 0xFF)
+}
+
+// espBytes 造 ESPMES.MRG：125 個外層群組，只有群組 121 非空。
+func espBytes(items ...string) []byte {
+	grp := le16(len(items) + 1)
+	pos := 2 + 4*(len(items)+1)
+	for j := 0; j <= len(items); j++ {
+		grp = append(grp, le32(pos)...)
+		if j < len(items) {
+			pos += len(items[j]) + 1
+		}
+	}
+	for _, it := range items {
+		grp = append(grp, it...)
+		grp = append(grp, 0)
+	}
+	grp = append(grp, 0xFF)
+	const ng = 125
+	head := 2 + 4*ng
+	out := le16(ng + 1)
+	for g := 0; g < ng; g++ {
+		if g <= 121 {
+			out = append(out, le32(head)...)
+		} else {
+			out = append(out, le32(head+len(grp))...)
+		}
+	}
+	return append(out, grp...)
+}
+
+func shopBytes() []byte {
+	var out []byte
+	for f := 0; f < 8; f++ {
+		name := []byte("ABC")
+		for len(name) < 20 {
+			name = append(name, 0x20)
+		}
+		out = append(out, name...)
+		out = append(out, 0, 1, 2, 3, 4)
+	}
+	return out
+}
