+		c.PackRoot, c.hooks = t.TempDir(), nil
+		res := mustBuild(t, c)
+		d, err := ExpectedDigest(c)
+		if err != nil {
+			t.Fatal(err)
+		}
+		dst := filepath.Join(mustAbs(t, root), slotName(PackName(c.Code, d), slot))
