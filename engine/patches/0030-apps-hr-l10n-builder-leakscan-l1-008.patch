+// 啟動時只清過期（超過 1 小時）的 `.tmp-*`；新的留下；任何 `<代碼>-…` 目錄（含舊的序號目錄）都不刪。
+func TestBuildSweepsStaleTmpOnly(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	mk := func(name string, age time.Duration) {
+		dir := filepath.Join(root, name)
+		if err := os.MkdirAll(filepath.Join(dir, "files"), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "files", "x"), []byte("x"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		ts := time.Now().Add(-age)
+		if err := os.Chtimes(dir, ts, ts); err != nil {
+			t.Fatal(err)
+		}
+	}
+	mk(".tmp-old-1-aaaa", 2*time.Hour)
+	mk(".tmp-old-2-bbbb", 49*time.Hour)
+	mk(".tmp-new-1-cccc", 5*time.Minute)
+	mk(".tmp-edge-1-dddd", 59*time.Minute)
+	mk("zh-TW-000000000000", 72*time.Hour)   // 舊的語言包目錄（輸入改變而留下的）
+	mk("zh-TW-000000000000-2", 72*time.Hour) // 舊的序號目錄
+	mustBuild(t, w.cfg(root, "", ModeIdentity, Policy{}))
+	got := packEntries(t, root)
+	has := func(n string) bool {
+		for _, g := range got {
+			if g == n {
+				return true
+			}
+		}
+		return false
+	}
+	for _, gone := range []string{".tmp-old-1-aaaa", ".tmp-old-2-bbbb"} {
+		if has(gone) {
+			t.Errorf("過期的 %s 沒有被清掉", gone)
+		}
+	}
+	for _, kept := range []string{".tmp-new-1-cccc", ".tmp-edge-1-dddd", "zh-TW-000000000000", "zh-TW-000000000000-2"} {
+		if !has(kept) {
+			t.Errorf("%s 不該被刪（現有：%v）", kept, got)
+		}
+	}
+}
