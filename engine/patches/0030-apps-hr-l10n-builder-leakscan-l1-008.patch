+		if code, _, errOut := runMain("", "-orig", writeOrig(t, files), scanRoot); code != ExitUsage || !strings.Contains(errOut, name+" 沒有抽出任何單位") {
+			t.Errorf("%s 抽不出單位：退出碼 %d，stderr %s", name, code, errOut)
