+// 改名失敗而第一個不存在的名額沒變（不是競爭造成的）：可能是暫時性失敗（例如 Windows 防毒軟體剛掃過新目錄），
+// 重試至多 3 次（共 4 次嘗試），每次之前等 50 ms。第 1、2 次嘗試失敗、第 3 次（第 2 次重試）成功。
+func TestBuildRenameTransientFailureRetries(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	cfg := poolCfg(w, root)
+	boom := errors.New("sharing violation")
+	attempts := 0
+	var sleeps []time.Duration
+	cfg.hooks = &buildHooks{
+		rename: func(oldp, newp string) error {
+			attempts++
+			if attempts <= 2 {
+				return boom
+			}
+			return os.Rename(oldp, newp)
+		},
+		sleep: func(d time.Duration) { sleeps = append(sleeps, d) },
+	}
+	res := mustBuild(t, cfg)
+	if res.Reused || attempts != 3 {
+		t.Errorf("Reused=%v，改名嘗試 %d 次，應為 3 次（兩次失敗加一次成功）", res.Reused, attempts)
+	}
+	if len(sleeps) != 2 || sleeps[0] != 50*time.Millisecond || sleeps[1] != 50*time.Millisecond {
+		t.Errorf("每次重試之前應等 50 ms：%v", sleeps)
+	}
+	d, _ := ExpectedDigest(cfg)
+	if filepath.Base(res.Dir) != PackName("zh-TW", d) {
+		t.Errorf("重試不該改變名額：%s", filepath.Base(res.Dir))
+	}
+	if err := w.verifyPack(res.Dir, d); err != nil {
+		t.Error(err)
+	}
+	if got := finalPacks(t, root); len(got) != 1 {
+		t.Errorf("包根下有 %v", got)
+	}
+	if got := tmpEntries(t, root); len(got) != 0 {
+		t.Errorf("暫存目錄殘留：%v", got)
+	}
+}
