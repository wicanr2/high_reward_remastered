+		"沒給 -orig": {scanRoot},
+		"空目錄":      {"-orig", t.TempDir(), scanRoot},
+	} {
+		if code, out, errOut := runMain("", args...); code != ExitUsage || out != "" {
+			t.Errorf("%s：退出碼 %d，stdout %q，stderr %s", name, code, out, errOut)
+		}
+	}
+	// 檔案都在但抽不出任何單位（例如拿錯檔案）：判準不可靠，同樣失敗。
+	for _, name := range []string{"SYSTEM.MES", "OP3.TXT"} {
