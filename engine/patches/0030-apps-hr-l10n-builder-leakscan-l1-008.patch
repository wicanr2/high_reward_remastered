+// 全形英數是原版字模內的雙位元組字，是單位片段的成員；半形英數切斷片段，兩者不互相等同。
+func TestFullwidthAlnumUnit(t *testing.T) {
+	p := newSynPool(0xC9, 0xE8, 41)
+	fa, fb, f1, f2 := codeOf(0xFF21), codeOf(0xFF22), codeOf(0xFF11), codeOf(0xFF12)
+	if fa < 0 || fb < 0 || f1 < 0 || f2 < 0 {
+		t.Skip("x/text 的 Big5 表沒有全形英數")
+	}
+	segA := append(codeBytes([]int{fa, fb}, p.take(1)), []byte("%s")...) // 2 個全形字母加 1 個漢字：3 字
+	segB := codeBytes([]int{f1, f2}, p.take(2))                          // 2 個全形數字加 2 個漢字：4 字
+	w := worldWith(segA, segB)
+	keyed := map[int]bool{}
+	for _, i := range w.ix.KeyedUnits() {
+		keyed[i] = true
+	}
+	for name, frag := range map[string][]byte{"全形字母": segA[:6], "全形數字": segB} {
+		u := w.unitOf(t, frag)
+		idx := -1
+		for i, c := range w.units {
+			if c.ID == u.ID {
+				idx = i
+			}
+		}
+		if !keyed[idx] {
+			t.Errorf("含%s的單位 %s 必須有查找鍵（全形英數是片段成員，不是切斷字元）", name, u.ID)
+		}
+		if !w.scan([]byte(u.Text))[u.ID] || !w.scan(u.Big5)[u.ID] {
+			t.Errorf("含%s的單位 %s 以自己的文字與位元組掃描必須命中自己", name, u.ID)
+		}
+		// 半形英數切斷片段：把全形換成半形後不命中（規格：ASCII 隔開的引用各片段分別比）。
+		half := strings.Map(func(r rune) rune {
+			if isFullwidthAlnum(r) {
+				return r - 0xFEE0
+			}
+			return r
+		}, u.Text)
+		if w.scan([]byte(half))[u.ID] {
+			t.Errorf("含%s的單位 %s：換成半形英數後不應命中", name, u.ID)
+		}
+	}
+}
