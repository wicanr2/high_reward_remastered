+func TestSrcAccSHA(t *testing.T) {
+	// SHA-256("abc") ＝ ba7816bf 8f01cfea 414140de 5dae2223 b00361a3 96177a9c b410ff61 f20015ad
+	if got := SrcSHA([]byte("abc")); got != "ba7816bf8f01cfea" {
+		t.Errorf("SrcSHA(abc) ＝ %s", got)
+	}
+	if got := AccSHA("abc"); got != "ba7816bf8f01cfea" {
+		t.Errorf("AccSHA(abc) ＝ %s", got)
+	}
+	if got := AccSHA("一"); len(got) != 16 || got == AccSHA("二") {
+		t.Errorf("AccSHA(一) ＝ %s", got)
+	}
+	if SrcSHA(nil) != "e3b0c44298fc1c14" {
+		t.Errorf("SrcSHA(空) ＝ %s", SrcSHA(nil))
+	}
+}
