index 0000000..087f94b
--- /dev/null
+++ b/apps/hr/l10n/tabledir_test.go
@@ -0,0 +1,319 @@
+package l10n
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// FindTableDir 的尋找順序（spec 第 3.2 節）：旗標、環境變數、.AppImage 旁、執行檔旁、macOS Contents/Resources、
+// 目前目錄、資料目錄；除了旗標與環境變數（l10n 目錄本身），其餘是 <基底>/l10n（目錄名大小寫不分）。
+
+func TestFindTableDirOrder(t *testing.T) {
+	// 七個來源的候選路徑，依序。第 i 案：只有第 i 個以後的候選存在，結果必須是第 i 個。
+	type cand struct {
+		name string
+		set  func(s *TableSearch, base string) string // 設定來源並回傳預期的 l10n 目錄
+		dir  string                                   // 要建立的目錄（相對於案例根目錄）
+	}
+	cands := []cand{
+		{"旗標", func(s *TableSearch, b string) string { s.Flag = filepath.Join(b, "flag"); return s.Flag }, "flag"},
+		{"環境變數", func(s *TableSearch, b string) string { s.Env = filepath.Join(b, "env"); return s.Env }, "env"},
+		{"AppImage 旁", func(s *TableSearch, b string) string {
+			s.AppImageDir = filepath.Join(b, "app")
+			return filepath.Join(s.AppImageDir, "l10n")
+		}, "app/l10n"},
+		{"執行檔旁", func(s *TableSearch, b string) string {
+			s.ExeDir = filepath.Join(b, "exe")
+			return filepath.Join(s.ExeDir, "l10n")
+		}, "exe/l10n"},
+		{"macOS Resources", func(s *TableSearch, b string) string {
+			s.MacResources = filepath.Join(b, "mac")
+			return filepath.Join(s.MacResources, "l10n")
+		}, "mac/l10n"},
+		{"目前目錄", func(s *TableSearch, b string) string {
+			s.Cwd = filepath.Join(b, "cwd")
