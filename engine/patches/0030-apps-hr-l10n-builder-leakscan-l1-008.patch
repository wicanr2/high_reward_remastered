+		}
+		res := mustBuild(t, cfg)
+		if res.Reused || filepath.Base(res.Dir) != slotBase(cfg)+"-2" {
+			t.Errorf("應建在 -2：Reused=%v dir=%s", res.Reused, filepath.Base(res.Dir))
+		}
+		if ents, err := os.ReadDir(occupied); err != nil || len(ents) != 0 {
+			t.Errorf("空目錄被動過（%d 個項目）：%v", len(ents), err)
+		}
+		if got := tmpEntries(t, root); len(got) != 0 {
+			t.Errorf("暫存目錄殘留：%v", got)
+		}
+	})
+	t.Run("符號連結指向驗證通過的包", func(t *testing.T) {
+		src := t.TempDir()
+		srcPack := mustBuild(t, poolCfg(w, src))
+		root := t.TempDir()
+		cfg := poolCfg(w, root)
+		link := filepath.Join(root, slotBase(cfg))
+		if err := os.Symlink(srcPack.Dir, link); err != nil {
+			t.Skipf("無法建立符號連結（%v），略過符號連結案例", err)
+		}
+		built := 0
+		cfg.hooks = &buildHooks{onBuild: func() { built++ }}
+		res := mustBuild(t, cfg)
+		if !res.Reused || built != 0 || res.Dir != filepath.Join(mustAbs(t, root), slotBase(cfg)) {
+			t.Errorf("符號連結的包根目前會被接受並重用：Reused=%v built=%d dir=%s", res.Reused, built, res.Dir)
+		}
+		if got := finalPacks(t, root); len(got) != 1 {
+			t.Errorf("包根下有 %v", got)
+		}
+	})
+}
