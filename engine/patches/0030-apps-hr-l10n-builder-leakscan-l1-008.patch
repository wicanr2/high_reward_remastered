+// 改名之前另一個執行個體建好了同名的有效目錄：改名失敗，回到已存在分支重驗，通過就用它並丟棄自己的暫存目錄。
+func TestBuildRenameRaceValidCompetitor(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	cfg := poolCfg(w, root)
+	inner := cfg // 內層沒有縫隙
+	var innerRes *Result
+	built := 0
+	cfg.hooks = &buildHooks{
+		onBuild:      func() { built++ },
+		beforeRename: func(tmp, dst string) { innerRes = mustBuild(t, inner) },
+	}
+	res := mustBuild(t, cfg)
+	if innerRes == nil {
+		t.Fatal("縫隙沒有觸發")
+	}
+	if !res.Reused || res.Dir != innerRes.Dir || built != 1 {
