+	f := mustParse(t, "UWASA.MES", data)
+	uniq := map[string]bool{}
+	for _, it := range f.Items {
+		uniq[string(it.Orig)] = true
+	}
+	if len(uniq) != 10 {
+		t.Fatalf("不重複內容 %d，應為 10", len(uniq))
+	}
+	groups := f.DuplicateGroups()
+	total := 0
+	for _, g := range groups {
+		total += len(g)
+	}
+	if len(groups) != 10 || total != 110 {
+		t.Errorf("重複群組 %d 個、共 %d 項；應為 10 個、110 項", len(groups), total)
+	}
+}
diff --git a/apps/hr/l10n/shop.go b/apps/hr/l10n/shop.go
new file mode 100644
index 0000000..d77e120
--- /dev/null
+++ b/apps/hr/l10n/shop.go
@@ -0,0 +1,70 @@
+package l10n
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+)
+
+// SHOPTAB.TBL（docs/spec/008 第 2 節，docs/re/024 第 4.1 節）：無表頭，每筆記錄 200 bytes（原版 99 筆），
+// 每筆 8 個 25 bytes 欄位；欄位是 20 bytes 名稱（尾端以 0x20 補滿）加 5 bytes 其他資料，
+// 名稱之後的第一個位元組（欄位的第 21 個）必須是 0x00。
+
+const (
+	shopRecordSize = 200
+	shopFieldSize  = 25
+	shopFieldsPer  = 8
+	shopNameSize   = 20
+)
+
+// checkShopField 檢查名稱之後的第一個位元組是 0x00（原版 792 欄全部如此）。field 是 25 bytes 欄位。
+func checkShopField(field []byte) error {
+	if field[shopNameSize] != 0x00 {
+		return fmt.Errorf("名稱之後的第一個位元組為 0x%02X，應為 0x00", field[shopNameSize])
+	}
+	return nil
+}
+
+func parseShop(name string, d []byte) (*File, error) {
+	if len(d) == 0 || len(d)%shopRecordSize != 0 {
+		return nil, fmt.Errorf("檔長 %d 不是 %d 的正整數倍", len(d), shopRecordSize)
+	}
+	f := &File{Name: name, Kind: KindShop, shopRaw: bytes.Clone(d)}
+	for r := 0; r < len(d)/shopRecordSize; r++ {
+		for i := 0; i < shopFieldsPer; i++ {
+			o := r*shopRecordSize + i*shopFieldSize
+			if err := checkShopField(d[o : o+shopFieldSize]); err != nil {
+				return nil, fmt.Errorf("記錄 %d 欄位 %d：%w", r, i, err)
+			}
+			f.Items = append(f.Items, Item{
+				ID:   fmt.Sprintf("SHOPTAB#%d.%d", r, i),
+				Orig: bytes.Clone(d[o : o+shopNameSize]),
+			})
+		}
+	}
+	return f, nil
+}
+
+// serializeShop 由項目重建檔案：名稱欄取目前的項目（<= 20 bytes，尾端補 0x20），其餘位元組取自樣板。
+// 每個欄位寫出後重新檢查名稱之後的第一個位元組。
+func (f *File) serializeShop(cur [][]byte) ([]byte, error) {
+	if len(cur) != len(f.shopRaw)/shopRecordSize*shopFieldsPer {
+		return nil, errors.New("l10n: SHOPTAB 項目數與記錄數不符")
+	}
+	out := bytes.Clone(f.shopRaw)
+	for idx, name := range cur {
+		r, i := idx/shopFieldsPer, idx%shopFieldsPer
+		o := r*shopRecordSize + i*shopFieldSize
+		if len(name) > shopNameSize {
+			return nil, fmt.Errorf("l10n: %s 的名稱 %d bytes，超過欄位上限 %d bytes", f.Items[idx].ID, len(name), shopNameSize)
+		}
+		n := copy(out[o:o+shopNameSize], name)
+		for k := n; k < shopNameSize; k++ {
+			out[o+k] = 0x20
+		}
+		if err := checkShopField(out[o : o+shopFieldSize]); err != nil {
+			return nil, fmt.Errorf("l10n: %s：%w", f.Items[idx].ID, err)
+		}
+	}
+	return out, nil
+}
diff --git a/apps/hr/l10n/shop_test.go b/apps/hr/l10n/shop_test.go
new file mode 100644
index 0000000..6d2ebde
--- /dev/null
+++ b/apps/hr/l10n/shop_test.go
@@ -0,0 +1,88 @@
+package l10n
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestShopSynthetic(t *testing.T) {
+	names := []string{"AB", "一二", "123456789012345678901"[:20], "", "X"}
+	data := buildShop(2, names)
+	if len(data) != 400 {
+		t.Fatalf("合成檔長 %d", len(data))
+	}
+	f := mustParse(t, "SHOPTAB.TBL", data)
+	if f.Kind != KindShop || len(f.Items) != 16 {
+		t.Fatalf("Kind %v 項目數 %d", f.Kind, len(f.Items))
+	}
+	if f.Items[0].ID != "SHOPTAB#0.0" || f.Items[8].ID != "SHOPTAB#1.0" || f.Items[15].ID != "SHOPTAB#1.7" {
+		t.Errorf("ID：%s %s %s", f.Items[0].ID, f.Items[8].ID, f.Items[15].ID)
+	}
+	if len(f.Items[0].Orig) != 20 || string(f.Items[0].Orig) != "AB"+strings.Repeat(" ", 18) {
+		t.Errorf("Orig 要含補白共 20 bytes：%q", f.Items[0].Orig)
+	}
+	if got := mustSerialize(t, f, nil, SerializeOptions{}); !bytes.Equal(got, data) {
+		t.Error("identity 不符")
+	}
+}
+
+func TestShopReplacePadsAndKeepsTail(t *testing.T) {
+	data := buildShop(1, []string{"AB", "CD"})
+	f := mustParse(t, "SHOPTAB.TBL", data)
+	// 較短：尾端補 0x20 到 20 bytes；名稱之後的第一個位元組仍是 00；後 4 bytes 原樣不動。
+	got := mustSerialize(t, f, map[string][]byte{"SHOPTAB#0.0": []byte("一二三")}, SerializeOptions{})
+	want := buildShop(1, []string{"一二三", "CD"})
+	if !bytes.Equal(got, want) {
+		t.Fatalf("補白：\n got %q\nwant %q", got[:25], want[:25])
+	}
+	if got[20] != 0x00 || !bytes.Equal(got[21:25], data[21:25]) {
+		t.Errorf("名稱以外的 5 bytes 要原樣保留：%X", got[20:25])
+	}
+	if !bytes.Equal(got[9:20], bytes.Repeat([]byte{0x20}, 11)) {
+		t.Errorf("補白位元組：%X", got[:20])
+	}
+	// 剛好 20 bytes 可以。
+	full := strings.Repeat("A", 20)
+	got = mustSerialize(t, f, map[string][]byte{"SHOPTAB#0.1": []byte(full)}, SerializeOptions{})
+	if string(got[25:45]) != full || got[45] != 0x00 {
+		t.Errorf("20 bytes：%X", got[25:50])
+	}
+	// 21 bytes 回錯。
+	if _, err := f.Serialize(map[string][]byte{"SHOPTAB#0.0": []byte(full + "B")}, SerializeOptions{}); err == nil {
+		t.Error("名稱超過 20 bytes 應回錯")
+	}
+	// 含 NUL 回錯。
+	if _, err := f.Serialize(map[string][]byte{"SHOPTAB#0.0": []byte("a\x00b")}, SerializeOptions{}); err == nil {
+		t.Error("名稱含 0x00 應回錯")
+	}
+}
+
+func TestShopByte21Check(t *testing.T) {
+	data := buildShop(2, []string{"AB"})
+	// 解析：任何一欄名稱之後的第一個位元組不是 00 就失敗。
+	for _, off := range []int{20, 25 + 20, 200 + 7*25 + 20, 200 + 3*25 + 20} {
+		b := cloneBytes(data)
+		b[off] = 0x20
+		if _, err := Parse("SHOPTAB.TBL", b); err == nil {
+			t.Errorf("位移 %d 的位元組不是 00，Parse 應回錯", off)
+		} else if !strings.Contains(err.Error(), "0x00") {
+			t.Errorf("錯誤訊息：%v", err)
+		}
+	}
+	// 序列化：模型被破壞（樣板的該位元組不是 00）時，輸出檢查要擋下。
+	f := mustParse(t, "SHOPTAB.TBL", data)
+	f.shopRaw[25+20] = 0x01
+	if _, err := f.Serialize(nil, SerializeOptions{}); err == nil {
+		t.Error("樣板的名稱後位元組不是 00，Serialize 應回錯")
+	}
+}
+
+func TestShopParseErrors(t *testing.T) {
+	if _, err := Parse("SHOPTAB.TBL", nil); err == nil {
+		t.Error("空檔應回錯")
+	}
+	if _, err := Parse("SHOPTAB.TBL", make([]byte, 199)); err == nil {
+		t.Error("檔長不是 200 的整數倍應回錯")
+	}
+}
diff --git a/apps/hr/l10n/table.go b/apps/hr/l10n/table.go
new file mode 100644
index 0000000..39fbb2b
--- /dev/null
+++ b/apps/hr/l10n/table.go
@@ -0,0 +1,380 @@
+package l10n
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"regexp"
+	"slices"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/budget"
+)
+
+// 譯文表（docs/spec/008 第 3.3 節）：`l10n/<code>/<檔名>.tsv`，UTF-8，製表符分隔，跳脫 `\n`、`\t`、`\\`。
+// 第 1 行是固定表頭（比照 hd/provenance.tsv），欄位順序固定。
+
+// status 的三個值。
+const (
+	StatusCandidate = "candidate"
+	StatusAccepted  = "accepted"
+	StatusKeep      = "keep"
+)
+
+// GroupExceptionNote 是 note 欄內明示「同群組譯文可以不同」的記號。
+// 規格第 3.3 節只說「除非 note 明示例外」，沒有定義記號，這是本套件選的常數。
+// 比對帶邊界：note 以 `;` 或 `；` 切成片段，去掉前後空白後，有一個片段恰好等於這個常數才算
+// （`語境不同; group-exception` 算；`不是 group-exception`、`group-exceptions`、`xgroup-exception` 不算）。
+const GroupExceptionNote = "group-exception"
+
+// hasGroupException 判斷 note 是否明示同群組例外（見 GroupExceptionNote 的邊界規則）。
+func hasGroupException(note string) bool {
+	for _, seg := range strings.FieldsFunc(note, func(r rune) bool { return r == ';' || r == '；' }) {
+		if strings.TrimSpace(seg) == GroupExceptionNote {
+			return true
+		}
+	}
+	return false
+}
+
+const tableHeader = "id\tsrc_sha256\ttext\tstatus\tacc_sha\tby\tbatch\tdate\tnote"
+
+// utf8BOM 是 UTF-8 的位元組順序記號（EF BB BF）。
+const utf8BOM = "\xEF\xBB\xBF"
+
+var (
+	idPattern  = regexp.MustCompile(`^[A-Z][A-Z0-9_.]*#[0-9]+(\.[0-9]+)?$`)
+	sha16      = regexp.MustCompile(`^[0-9a-f]{16}$`)
+	fieldNames = [9]string{"id", "src_sha256", "text", "status", "acc_sha", "by", "batch", "date", "note"}
+)
+
+// Row 是譯文表的一列。
+type Row struct{ ID, SrcSHA, Text, Status, AccSHA, By, Batch, Date, Note string }
+
+// Table 是譯文表（列依檔案順序）。
+type Table struct{ Rows []Row }
+
+// SrcSHA 回傳原項目位元組的 SHA-256 前 16 碼（小寫十六進位）。SHOPTAB 取 20 bytes 欄位含補白。
+func SrcSHA(orig []byte) string {
+	h := sha256.Sum256(orig)
+	return hex.EncodeToString(h[:8])
+}
+
+// AccSHA 回傳 accepted 列接受時 text 的 SHA-256 前 16 碼（對 UTF-8 位元組）。
+func AccSHA(text string) string { return SrcSHA([]byte(text)) }
+
+func (r Row) fields() [9]string {
+	return [9]string{r.ID, r.SrcSHA, r.Text, r.Status, r.AccSHA, r.By, r.Batch, r.Date, r.Note}
+}
+
+// validate 檢查一列的格式（LoadTable 與 Save 共用，所以存出去的檔一定讀得回來）。
+func (r Row) validate() error {
+	if !idPattern.MatchString(r.ID) {
+		return fmt.Errorf("id %q 格式不符（應為 <檔名>#<索引>、ESPMES#<群組>.<子> 或 SHOPTAB#<記錄>.<欄位>）", r.ID)
+	}
+	if !sha16.MatchString(r.SrcSHA) {
+		return errors.New("src_sha256 應為 16 碼小寫十六進位")
+	}
+	switch r.Status {
+	case StatusCandidate, StatusAccepted, StatusKeep:
+	default:
+		return fmt.Errorf("status %q 不是 candidate、accepted、keep 之一", r.Status)
+	}
+	if r.AccSHA != "" && !sha16.MatchString(r.AccSHA) {
+		return errors.New("acc_sha 應為空或 16 碼小寫十六進位")
+	}
+	for i, f := range r.fields() {
+		if strings.ContainsRune(f, '\r') {
+			return fmt.Errorf("%s 欄含 CR（只跳脫 \\n、\\t、\\\\，不收 CR）", fieldNames[i])
+		}
+		if !utf8.ValidString(f) {
+			return fmt.Errorf("%s 欄不是合法的 UTF-8", fieldNames[i])
+		}
+	}
+	return nil
+}
+
+func escapeField(s string) string {
+	if !strings.ContainsAny(s, "\\\n\t") {
+		return s
+	}
+	var sb strings.Builder
+	for i := 0; i < len(s); i++ {
+		switch s[i] {
+		case '\\':
+			sb.WriteString(`\\`)
+		case '\n':
+			sb.WriteString(`\n`)
+		case '\t':
+			sb.WriteString(`\t`)
+		default:
+			sb.WriteByte(s[i])
+		}
+	}
+	return sb.String()
+}
+
+func unescapeField(s string) (string, error) {
+	if !strings.Contains(s, `\`) {
+		return s, nil
+	}
+	var sb strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] != '\\' {
+			sb.WriteByte(s[i])
+			continue
+		}
+		i++
+		if i >= len(s) {
+			return "", errors.New(`結尾的 \ 沒有接跳脫字元`)
+		}
+		switch s[i] {
+		case 'n':
+			sb.WriteByte('\n')
+		case 't':
+			sb.WriteByte('\t')
+		case '\\':
+			sb.WriteByte('\\')
+		default:
+			return "", fmt.Errorf(`未知的跳脫 \%c（只認 \n、\t、\\）`, s[i])
+		}
+	}
+	return sb.String(), nil
+}
+
+// LoadTable 讀譯文表。格式錯誤（表頭、欄數、跳脫、status、雜湊格式、id 重複、不合法的 UTF-8）點名行號回錯。
+// 接受 UTF-8 BOM 與 CRLF 換行；空行是格式錯誤。
+func LoadTable(r io.Reader) (*Table, error) {
+	data, err := io.ReadAll(r)
+	if err != nil {
+		return nil, fmt.Errorf("l10n: 讀譯文表：%w", err)
+	}
+	text := strings.TrimPrefix(string(data), utf8BOM)
+	lines := strings.Split(text, "\n")
+	if lines[len(lines)-1] == "" {
+		lines = lines[:len(lines)-1]
+	}
+	if len(lines) == 0 {
+		return nil, errors.New("l10n: 譯文表第 1 行：缺表頭")
+	}
+	t := &Table{}
+	firstLine := make(map[string]int)
+	for i, ln := range lines {
+		no := i + 1
+		ln = strings.TrimSuffix(ln, "\r")
+		if !utf8.ValidString(ln) {
+			return nil, fmt.Errorf("l10n: 譯文表第 %d 行：不是合法的 UTF-8", no)
+		}
+		if i == 0 {
+			if ln != tableHeader {
+				return nil, fmt.Errorf("l10n: 譯文表第 1 行：表頭應為 %q", tableHeader)
+			}
+			continue
+		}
+		f := strings.Split(ln, "\t")
+		if len(f) != len(fieldNames) {
+			return nil, fmt.Errorf("l10n: 譯文表第 %d 行：欄位數 %d，應為 %d", no, len(f), len(fieldNames))
+		}
+		var v [9]string
+		for k := range f {
+			u, err := unescapeField(f[k])
+			if err != nil {
+				return nil, fmt.Errorf("l10n: 譯文表第 %d 行 %s 欄：%w", no, fieldNames[k], err)
+			}
+			v[k] = u
+		}
+		row := Row{ID: v[0], SrcSHA: v[1], Text: v[2], Status: v[3], AccSHA: v[4], By: v[5], Batch: v[6], Date: v[7], Note: v[8]}
+		if err := row.validate(); err != nil {
+			return nil, fmt.Errorf("l10n: 譯文表第 %d 行：%w", no, err)
+		}
+		if prev, dup := firstLine[row.ID]; dup {
+			return nil, fmt.Errorf("l10n: 譯文表第 %d 行：id %s 與第 %d 行重複", no, row.ID, prev)
+		}
+		firstLine[row.ID] = no
+		t.Rows = append(t.Rows, row)
+	}
+	return t, nil
+}
+
+// Save 寫出譯文表（表頭加各列，LF 換行）。每列先過與 LoadTable 相同的格式檢查，
+// 所以寫出的檔一定讀得回來；id 重複也回錯。
+func (t *Table) Save(w io.Writer) error {
+	var sb strings.Builder
+	sb.WriteString(tableHeader + "\n")
+	seen := make(map[string]bool, len(t.Rows))
+	for i, row := range t.Rows {
+		if err := row.validate(); err != nil {
+			return fmt.Errorf("l10n: 第 %d 列（%s）：%w", i+1, row.ID, err)
+		}
+		if seen[row.ID] {
+			return fmt.Errorf("l10n: 第 %d 列：id %s 重複", i+1, row.ID)
+		}
+		seen[row.ID] = true
+		f := row.fields()
+		for k := range f {
+			if k > 0 {
+				sb.WriteByte('\t')
+			}
+			sb.WriteString(escapeField(f[k]))
+		}
+		sb.WriteByte('\n')
+	}
+	_, err := io.WriteString(w, sb.String())
+	return err
+}
+
+// Policy 是採用政策（docs/spec/008 第 3.2、3.3 節）。
+type Policy struct {
+	WithCandidates      bool // 採用 candidate 列（預設把 candidate 視為 keep）
+	AllowCountryOffsets bool // 允許 COUNTRY.MES 有非 keep 列
+	AllowShoptab        bool // 允許 SHOPTAB.TBL 有非 keep 列
+}
+
+// SerializeOptions 導出與這個政策配套的序列化選項：AllowCountryOffsets 為真時 COUNTRY.MES 重算精確偏移。
+// 兩個旗標必須同步設定，從這裡導出就不會漏設。
+func (p Policy) SerializeOptions() SerializeOptions {
+	return SerializeOptions{ExactCountryOffsets: p.AllowCountryOffsets}
+}
+
+// Checker 由呼叫端注入（預算檢查在別的套件），回傳違規說明字串；nil 表示不檢查。
+// file 是 File.Name；class：ESPMES 項目為 ESPWindowClass 的值，其他檔案為空字串；
+// orig 是原項目位元組，trans 是編碼後的譯文位元組。
+type Checker func(file, class, id string, orig, trans []byte) []string
+
+// Adopt 依政策挑出要採用的列並編碼（只處理 id 屬於 f 的列，其他檔案的列略過）。
+//
+//   - 預設只採用 accepted（acc_sha 必須等於 AccSHA(text)，不符視為 candidate）；keep 與 candidate 保留原版位元組，
+//     WithCandidates 才採用 candidate；
+//   - 每一列的 src_sha256 必須與原項目相符（含 keep 列），不符記一條違規；
+//   - COUNTRY.MES 或 SHOPTAB.TBL 有非 keep 列（看列的 status，不看採用結果）而對應旗標未開，記違規並點名檔案與旗標；
+//   - 譯文編碼失敗（字集外的字、不合法的 % 序列）、SHOPTAB 名稱超過 20 bytes 或含換行、SHOPTAB 名稱內的轉換規格
+//     與原項目不同（規則鍵 placeholder）、Checker 回報的違規都併入；
+//     有 Checker 時 ESPMES 項目查不到窗口類別也記違規（不呼叫 Checker，繼續處理其他列）；
+//   - 同群組（原項目位元組相同）的被採用列，編碼後位元組必須相同，note 明示 GroupExceptionNote（帶邊界）的列除外。
+//     群組內有些列被採用、有些保留原版，不算違規（部分翻譯本來就允許，群組清單用 File.DuplicateGroups 列出）。
+//
+// 回傳 id 到編碼後位元組、採用列數（實際被採用的非 keep 列數）與全部違規（不是遇到第一個就停，依譯文表順序，
+// 群組違規在最後）。有任何違規時 repl 為 nil、採用列數為 0，呼叫端必須視為建置失敗。
+// err 只放結構性錯誤（nil 參數）。
+func (t *Table) Adopt(f *File, p Policy, cs *Charmap, chk Checker) (repl map[string][]byte, adopted int, violations []string, err error) {
+	if t == nil || f == nil || cs == nil {
+		return nil, 0, nil, errors.New("l10n: Adopt 需要譯文表、檔案與字集")
+	}
+	prefix := f.idPrefix() + "#"
+	addV := func(id, format string, a ...any) {
+		violations = append(violations, fmt.Sprintf("%s: %s: %s", f.Name, id, fmt.Sprintf(format, a...)))
+	}
+	enc := make(map[string][]byte)
+	exempt := make(map[string]bool)
+	seen := make(map[string]bool)
+	for _, row := range t.Rows {
+		if !strings.HasPrefix(row.ID, prefix) {
+			continue
+		}
+		if seen[row.ID] {
+			addV(row.ID, "譯文表內 id 重複")
+			continue
+		}
+		seen[row.ID] = true
+		idx, ok := f.index[row.ID]
+		if !ok {
+			addV(row.ID, "檔案內沒有這個項目")
+			continue
+		}
+		item := f.Items[idx]
+		if row.SrcSHA != SrcSHA(item.Orig) {
+			addV(row.ID, "src_sha256 與原項目不符（譯文表與原版檔案版本不同）")
+			continue
+		}
+		if row.Status != StatusKeep {
+			if f.Kind == KindCountry && !p.AllowCountryOffsets {
+				addV(row.ID, "COUNTRY.MES 有非 keep 列，需旗標 -allow-country-offsets")
+				continue
+			}
+			if f.Kind == KindShop && !p.AllowShoptab {
+				addV(row.ID, "SHOPTAB.TBL 有非 keep 列，需旗標 -allow-shoptab")
+				continue
+			}
+		}
+		eff := row.Status
+		if eff == StatusAccepted && row.AccSHA != AccSHA(row.Text) {
+			eff = StatusCandidate
+		}
+		if eff == StatusKeep || (eff == StatusCandidate && !p.WithCandidates) {
+			continue
+		}
+		b, _, eerr := cs.Encode(row.Text)
+		if eerr != nil {
+			addV(row.ID, "%s", strings.TrimPrefix(eerr.Error(), "l10n: "))
+			continue
+		}
+		if len(b) == 0 {
+			addV(row.ID, "譯文為空（要保留原版請用 keep）")
+			continue
+		}
+		if f.Kind == KindShop && len(b) > shopNameSize {
+			addV(row.ID, "名稱 %d bytes，超過欄位上限 %d bytes", len(b), shopNameSize)
+			continue
+		}
+		if f.Kind == KindShop && bytes.IndexByte(b, 0x0A) >= 0 {
+			addV(row.ID, "名稱欄位是單行，不能含換行")
+			continue
+		}
+		if f.Kind == KindShop {
+			// SHOPTAB 沒有預算套件的窗口，轉接器不做預算檢查（budgetadapter.go），佔位符規則在這裡補上：
+			// 名稱內的轉換規格必須與原項目逐字相同（原項目沒有就不得有）。細節只放個數，不放規格與文句。
+			if o, n := percentSpecs(item.Orig), percentSpecs(b); !slices.Equal(o, n) {
+				addV(row.ID, "%s: 名稱欄的轉換規格必須與原項目逐字相同（譯文 %d 個，原項目 %d 個）", budget.RulePlaceholder, len(n), len(o))
+				continue
+			}
+		}
+		if chk != nil {
+			class := ""
+			if f.Kind == KindESP {
+				c, ok := ESPWindowClass(row.ID)
+				if !ok {
+					addV(row.ID, "esp-windows.tsv 沒有此項目，無法決定窗口類別")
+					continue
+				}
+				class = c
+			}
+			for _, msg := range chk(f.Name, class, row.ID, item.Orig, b) {
+				addV(row.ID, "%s", msg)
+			}
+		}
+		enc[row.ID] = b
+		if hasGroupException(row.Note) {
+			exempt[row.ID] = true
+		}
+	}
+	// 同群組一致性：依檔案順序，每個群組報一次。
+	byContent := make(map[string][]string)
+	var order []string
+	for _, it := range f.Items {
+		if _, ok := enc[it.ID]; !ok || exempt[it.ID] {
+			continue
+		}
+		k := string(it.Orig)
+		if _, ok := byContent[k]; !ok {
+			order = append(order, k)
+		}
+		byContent[k] = append(byContent[k], it.ID)
+	}
+	for _, k := range order {
+		ids := byContent[k]
+		for _, id := range ids[1:] {
+			if string(enc[id]) != string(enc[ids[0]]) {
+				violations = append(violations, fmt.Sprintf("%s: 同群組（原項目位元組相同）的譯文不一致：%s", f.Name, strings.Join(ids, "、")))
+				break
+			}
+		}
+	}
+	if len(violations) > 0 {
+		return nil, 0, violations, nil
+	}
+	return enc, len(enc), nil, nil
+}
