+		{"最後偏移錯", func() []byte { b := cloneBytes(good); b[10] += 2; return b }(), "不符"},
+		{"結尾不是 FF", func() []byte { b := cloneBytes(good); b[len(b)-1] = 0xFE; return b }(), "0xFF"},
+		{"FF 之後有多餘位元組", append(cloneBytes(good), 0x00), "多餘"},
+		{"項目沒有結尾 NUL", []byte{0x02, 0x00, 0x0A, 0x00, 0x00, 0x00, 0x0C, 0x00, 0x00, 0x00, 0x41, 0x42}, "NUL"},
