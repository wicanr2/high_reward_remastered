+// minMembers 的邊界成對案例：視窗含 2 個非標點字不命中、含 3 個命中；3 至 5 字整段鍵同理。
+func TestMinMembersBoundary(t *testing.T) {
+	p := newSynPool(0xC9, 0xE8, 99)
+	m := p.take(5)
+	// 11 字：2 個字、6 個標點、3 個字。6 字視窗各含 2、1、0、1、2、3 個非標點字。
+	longFrag := codeBytes(m[:2], punctCodes(6), m[2:5])
+	e1Frag := codeBytes(p.take(1), punctCodes(1), p.take(1), punctCodes(1), p.take(1)) // 5 字，3 個非標點字
+	e2Frag := codeBytes(p.take(1), punctCodes(2), p.take(1))                           // 4 字，2 個非標點字
+	w := worldWith(longFrag, e1Frag, e2Frag)
+	text := func(rs []rune) string { // 標點換成半形逗號
+		var sb strings.Builder
+		for _, r := range rs {
+			if classify(unify(r)) == clsPunct {
+				sb.WriteByte(',')
+			} else {
+				sb.WriteRune(r)
+			}
+		}
+		return sb.String()
+	}
+	u := w.unitOf(t, longFrag)
+	rs := unitRunes(u)
+	if len(rs) != 11 {
+		t.Fatalf("合成單位長 %d，要 11", len(rs))
+	}
+	// 視窗夾在填充字之間（頭尾標點會被去掉，夾在中間才形成視窗）。
+	pad := func(s string) []byte { return []byte(codeText(w.filler(2)) + s + codeText(w.filler(2))) }
+	members := []int{2, 1, 0, 1, 2, 3}
+	for k := 0; k <= 5; k++ {
+		hit := w.scan(pad(text(rs[k : k+6])))[u.ID]
+		if want := members[k] >= 3; hit != want {
+			t.Errorf("視窗 %d（%d 個非標點字）：命中 ＝ %v，要 %v", k, members[k], hit, want)
+		}
+	}
+	e1, e2 := w.unitOf(t, e1Frag), w.unitOf(t, e2Frag)
+	if !w.scan([]byte(text(unitRunes(e1))))[e1.ID] {
+		t.Error("3 個非標點字的 5 字整段鍵必須命中")
+	}
+	if w.scan([]byte(text(unitRunes(e2))))[e2.ID] {
+		t.Error("2 個非標點字的 4 字整段鍵不應命中")
+	}
+}
