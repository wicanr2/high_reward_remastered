+func TestAdoptDefaultPolicy(t *testing.T) {
+	cs := mustCharmap(t)
+	f := uwasaFile(t)
+	tb := &Table{Rows: []Row{
+		mkRow(f, 1, StatusAccepted, txtA),
+		mkRow(f, 3, StatusCandidate, txtB),
+		mkRow(f, 0, StatusKeep, ""),
+	}}
+	repl, n, viol, err := tb.Adopt(f, Policy{}, cs, nil)
+	if err != nil || len(viol) != 0 {
+		t.Fatalf("err %v 違規 %v", err, viol)
+	}
+	if n != 1 || len(repl) != 1 || !bytes.Equal(repl["UWASA.MES#1"], encOf(t, cs, txtA)) {
+		t.Errorf("預設只採用 accepted：採用 %d 列，repl %v", n, repl)
+	}
+	if _, ok := repl["UWASA.MES#3"]; ok {
+		t.Error("預設政策下 candidate 要視為 keep，不採用")
+	}
+	// WithCandidates：candidate 也採用。
+	repl, n, viol, err = tb.Adopt(f, Policy{WithCandidates: true}, cs, nil)
+	if err != nil || len(viol) != 0 || n != 2 {
+		t.Fatalf("WithCandidates：err %v 違規 %v 採用 %d", err, viol, n)
+	}
+	if !bytes.Equal(repl["UWASA.MES#3"], encOf(t, cs, txtB)) || !bytes.Equal(repl["UWASA.MES#1"], encOf(t, cs, txtA)) {
+		t.Errorf("WithCandidates 的編碼：%v", repl)
+	}
+	if _, ok := repl["UWASA.MES#0"]; ok {
+		t.Error("keep 列永遠不採用")
+	}
+	// 結果交給 Serialize：只有被採用的項目改變。
+	out := mustSerialize(t, f, repl, SerializeOptions{})
+	want := buildMES([]string{"AA", string(encOf(t, cs, txtA)), "AA", string(encOf(t, cs, txtB)), "AA"}, 0)
+	if !bytes.Equal(out, want) {
+		t.Error("Adopt 的結果交給 Serialize 後不符預期")
+	}
+}
