+// 需要使用者原版：identity 包與原檔逐位元組相同；table 模式沒有任何譯文表時同樣與原檔相同（只有模式欄位不同）。
+func TestBuildIdentityOriginal(t *testing.T) {
+	origDir := origDirOrSkip(t)
+	orig := readOrig(t, packNames...)
+	id := mustBuild(t, Config{OrigDir: origDir, PackRoot: t.TempDir(), Code: "zh-TW", Mode: ModeIdentity})
+	empty := t.TempDir()
+	tb := mustBuild(t, Config{OrigDir: origDir, TableDir: empty, PackRoot: t.TempDir(), Code: "zh-TW", Mode: ModeTable})
+	for _, n := range packNames {
+		if !bytes.Equal(packFile(t, id.Dir, n), orig[n]) {
+			t.Errorf("identity 包的 %s 與原檔不同", n)
+		}
+		if !bytes.Equal(packFile(t, tb.Dir, n), orig[n]) {
+			t.Errorf("沒有譯文表的 table 包的 %s 與原檔不同", n)
+		}
+	}
+	if id.Manifest.Adopted != 0 || tb.Manifest.Adopted != 0 || id.Digest == tb.Digest {
+		t.Errorf("採用列數與摘要：identity %d、table %d；兩者摘要應不同（模式欄位）", id.Manifest.Adopted, tb.Manifest.Adopted)
+	}
+	if id.Manifest.TableHash != emptyTableHash || tb.Manifest.TableHash != emptyTableHash {
+		t.Error("無表與 identity 的譯文表整體雜湊都應是空位元組串的 SHA-256")
+	}
+	// manifest 的原版輸入雜湊就是 required.tsv 的值
+	req, err := requiredInputHashes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for n, h := range req {
+		if id.Manifest.OrigInputs[n] != h {
+			t.Errorf("manifest 的 %s 雜湊不是 required.tsv 的值", n)
+		}
+	}
+	// 以 Verify 驗證
+	hashes, err := OrigInputHashes(origDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := verify.Verify(id.Dir, verify.Options{OrigHashes: hashes, ExpectDigest: id.Digest}); err != nil {
+		t.Error(err)
+	}
