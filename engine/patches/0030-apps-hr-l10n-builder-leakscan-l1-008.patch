+		t.Error("allow-shoptab 不該放行 COUNTRY.MES")
+	}
+	if _, err := Build(w.cfg(t.TempDir(), w.tableDir(shop), ModeTable, Policy{AllowCountryOffsets: true})); err == nil {
+		t.Error("allow-country-offsets 不該放行 SHOPTAB.TBL")
+	}
+	// candidate 列同樣算非 keep 列
+	cand := w.row("COUNTRY.MES#0", "上下大小中國人", StatusCandidate)
+	if _, err := Build(w.cfg(t.TempDir(), w.tableDir(cand), ModeTable, Policy{})); err == nil {
