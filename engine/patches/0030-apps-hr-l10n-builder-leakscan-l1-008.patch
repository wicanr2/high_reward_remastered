+	}
+	for i, it := range items {
+		if string(f.Items[i].Orig) != it {
+			t.Errorf("項目 %d 要依 NUL 切出真實項目，不是依偏差的偏移", i)
+		}
+	}
+	// 全部 keep：原樣保留偏移表的 +2 偏差與最後偏移多出的部分。
+	if got := mustSerialize(t, f, nil, SerializeOptions{}); !bytes.Equal(got, data) {
+		t.Error("identity 要保留偏差")
+	}
+	if got := mustSerialize(t, f, nil, SerializeOptions{ExactCountryOffsets: true}); !bytes.Equal(got, data) {
+		t.Error("沒有譯文時，ExactCountryOffsets 不改變 identity")
+	}
+	// 含譯文：只有 ExactCountryOffsets 才重算，否則回錯。
+	repl := map[string][]byte{"COUNTRY.MES#1": []byte("XY")}
+	if _, err := f.Serialize(repl, SerializeOptions{}); err == nil {
+		t.Error("COUNTRY.MES 含譯文且未開 ExactCountryOffsets 應回錯")
+	} else if !strings.Contains(err.Error(), "ExactCountryOffsets") {
+		t.Errorf("錯誤訊息要點名旗標：%v", err)
