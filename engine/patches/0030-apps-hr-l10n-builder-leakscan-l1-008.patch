+			t.Fatal(err)
+		}
+		return dst
+	}
+
+	t.Run("基底名與 -2 都有效用基底名", func(t *testing.T) {
+		root := t.TempDir()
+		cfg := poolCfg(w, root)
+		base := placePack(cfg, root, 0)
+		two := placePack(cfg, root, 1)
+		built := 0
+		cfg.hooks = &buildHooks{onBuild: func() { built++ }}
+		res := mustBuild(t, cfg)
+		if !res.Reused || res.Dir != base || res.Dir == two || built != 0 {
+			t.Errorf("應用基底名：Reused=%v dir=%s built=%d", res.Reused, filepath.Base(res.Dir), built)
+		}
+	})
+
+	t.Run("基底名無效、-2 不存在、-3 有效用 -3", func(t *testing.T) {
+		root := t.TempDir()
+		cfg := poolCfg(w, root)
+		corruptPack(t, placePack(cfg, root, 0))
+		three := placePack(cfg, root, 2)
+		built := 0
+		cfg.hooks = &buildHooks{onBuild: func() { built++ }}
+		res := mustBuild(t, cfg)
+		if !res.Reused || res.Dir != three || built != 0 {
+			t.Errorf("應用 -3：Reused=%v dir=%s built=%d", res.Reused, filepath.Base(res.Dir), built)
+		}
+	})
+
+	t.Run("基底名不存在、-2 有效用 -2", func(t *testing.T) {
+		root := t.TempDir()
+		cfg := poolCfg(w, root)
+		two := placePack(cfg, root, 1)
+		built := 0
+		cfg.hooks = &buildHooks{onBuild: func() { built++ }}
+		res := mustBuild(t, cfg)
+		if !res.Reused || res.Dir != two || built != 0 {
+			t.Errorf("應用 -2：Reused=%v dir=%s built=%d", res.Reused, filepath.Base(res.Dir), built)
+		}
+	})
+
+	t.Run("基底名永久損毀時連續啟動 10 次得到同一個序號目錄，不重複建置", func(t *testing.T) {
+		root := t.TempDir()
+		cfg := poolCfg(w, root)
+		r1 := mustBuild(t, cfg)
+		corruptPack(t, r1.Dir)
