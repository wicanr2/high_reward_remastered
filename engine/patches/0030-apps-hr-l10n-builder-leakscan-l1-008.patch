+}
+
+// eats 是具體模式在整串展開位元組上有沒有 0A 被步驟 4 多吃（k 取夠大，不碰寬度停止）。
+func eats(s []byte) bool {
+	_, e := ConcreteCalls(s, 100)
+	return e
+}
+
+// `%s` 的兩種離開狀態分開看：同步離開用空展開與 S 集展開，位移離開用結尾為 P 集位元組的展開。
+// 對抗模式的結果必須是兩者的聯集。
+func TestAdversarialExitStates(t *testing.T) {
+	tests := []struct {
+		format             string
+		syncFails, offFail bool
+	}{
+		{"%s E0 E1 0A", false, true},
+		{"%s E0 E1 E2 0A", true, false},
+		{"%s E0 E1 E2 E3 0A", false, true},
+		{"%s A4 E0 E1 E2 0A", true, true},
+		{"%s 0A", false, true},
+		{"%s 41 0A", false, false},
+	}
+	syncExps := [][]byte{nil, []byte("A"), []byte("AB")}
+	offExps := [][]byte{{0xE0}, {'A', 0xE0}, {0xA4, 0xFD}}
+	for _, tc := range tests {
+		f := hb(tc.format)
+		var sync, off bool
+		for _, e := range syncExps {
+			sync = sync || eats(expandFmt(f, e))
+		}
+		for _, e := range offExps {
+			off = off || eats(expandFmt(f, e))
+		}
+		if sync != tc.syncFails || off != tc.offFail {
+			t.Errorf("%q：同步離開 %v、位移離開 %v，要 %v、%v", tc.format, sync, off, tc.syncFails, tc.offFail)
+		}
+		if got := LineEatsNewlineAdversarial(f); got != (tc.syncFails || tc.offFail) {
+			t.Errorf("%q：對抗模式 %v，要同步與位移的聯集 %v", tc.format, got, tc.syncFails || tc.offFail)
+		}
+	}
+}
+
+// 樣板行（固定語料）：必含只有位移離開失敗的 `[%s] E0 E1 0A` 與只有同步離開失敗的 `[%s] E0 E1 E2 0A`。
+var sampleLines = []string{
+	"%s E0 E1 0A", "%s E0 E1 E2 0A", "%s E0 E1 E2 E3 0A", "%s A4 E0 E1 E2 0A", "%s 0A", "%s 41 0A", "%s 40 0A",
+	"41 %s E0 0A", "E0 %s 0A", "E0 %s E1 0A", "A4 %s E0 0A", "%s %s E0 0A", "%s E0 %s 0A", "%s A4 40 0A",
+	"%s FD 0A", "%s A4 FD 0A", "A4 40 %s 0A", "%s E0 E1 7E 0A", "%s 7F 0A", "%s 01 0A",
+}
+
+const propSeed = 20261004
+
+// 性質測試：具體模式失敗者（任一個展開使 0A 被多吃），對抗模式必須也失敗。
+// 展開內容為隨機位元組（長度 0 至 20，排除 00 與 0A），seed 固定（propSeed）。
+// 另驗：吃換行的判定與寬度無關（k 取 2、3、5、31、100 結果相同）。
+func TestAdversarialProperty(t *testing.T) {
+	t.Logf("seed = %d", propSeed)
+	r := rand.New(rand.NewSource(propSeed))
+	randByte := func(not ...byte) byte {
+		for {
+			b := byte(r.Intn(256))
+			ok := true
+			for _, n := range not {
+				ok = ok && b != n
+			}
+			if ok {
+				return b
+			}
+		}
+	}
+	randExp := func() []byte {
+		e := make([]byte, r.Intn(21))
+		for i := range e {
+			e[i] = randByte(0x00, 0x0A)
+		}
+		return e
+	}
+	var fixed [][]byte
+	for _, s := range sampleLines {
+		fixed = append(fixed, hb(s))
+	}
+	ks := []int{2, 3, 5, 31, 100}
+	hits, total := 0, 0
+	for i := 0; i < 40000; i++ {
+		var f []byte
+		if i%2 == 0 {
+			f = fixed[r.Intn(len(fixed))]
+		} else {
+			for j, n := 0, r.Intn(11); j < n; j++ {
+				if r.Intn(5) == 0 {
+					f = append(f, '%', 's')
+				} else {
+					f = append(f, randByte(0x00, 0x0A, '%'))
+				}
+			}
+			f = append(f, 0x0A)
+		}
+		exps := make([][]byte, countS(f))
+		for j := range exps {
+			exps[j] = randExp()
+		}
+		s := expandFmt(f, exps...)
+		base := eats(s)
+		for _, k := range ks {
+			if _, e := ConcreteCalls(s, k); e != base {
+				t.Fatalf("吃換行的判定與 k 有關：%x k=%d", s, k)
+			}
+		}
+		total++
+		if base {
+			hits++
+			if !LineEatsNewlineAdversarial(f) {
+				t.Fatalf("具體模式失敗而對抗模式通過：格式 %x 展開 %x", f, s)
+			}
+		}
+	}
+	t.Logf("隨機 %d 組，具體模式失敗 %d 組", total, hits)
+	if hits < 1000 {
+		t.Fatalf("具體模式失敗的樣本太少（%d），性質測試沒有鑑別力", hits)
+	}
+}
+
+// 確定性窮舉：展開字串取類別字母表 {S, P}（各一個代表值）、長度 0 至 8，
+// 兩個必含樣板都要涵蓋。除了「具體失敗則對抗失敗」（上界），也驗對抗模式不過度保守：
+// 對抗模式失敗時，窮舉中至少有一個展開使 0A 被吃（兩種離開狀態用長度 0 至 2 的展開就到得了）。
+func TestAdversarialExhaustive(t *testing.T) {
+	alphabet := []byte{'A', 0xE0} // S 集代表值、P 集代表值
+	enum := func(maxLen int) [][]byte {
+		out := [][]byte{nil}
+		for l := 1; l <= maxLen; l++ {
+			prev := out
+			for _, p := range prev {
+				if len(p) != l-1 {
+					continue
+				}
+				for _, a := range alphabet {
+					out = append(out, append(append([]byte(nil), p...), a))
+				}
+			}
+		}
+		return out
+	}
+	one := enum(8)
+	if len(one) != 511 {
+		t.Fatalf("窮舉長度 0 至 8 應有 511 個展開，得 %d", len(one))
+	}
+	two := one // 兩個 %s 的樣板，每個槽位也是長度 0 至 8（511 x 511 組）
+	required := map[string]bool{"%s E0 E1 0A": false, "%s E0 E1 E2 0A": false}
+	for _, line := range sampleLines {
+		f := hb(line)
+		var combos [][][]byte
+		switch countS(f) {
+		case 1:
+			for _, e := range one {
+				combos = append(combos, [][]byte{e})
+			}
+		case 2:
+			for _, e1 := range two {
+				for _, e2 := range two {
+					combos = append(combos, [][]byte{e1, e2})
+				}
+			}
+		default:
+			t.Fatalf("樣板 %q 的 %%s 個數不在窮舉範圍", line)
+		}
+		anyEat := false
+		for _, c := range combos {
+			anyEat = anyEat || eats(expandFmt(f, c...))
+		}
+		adv := LineEatsNewlineAdversarial(f)
+		if anyEat && !adv {
+			t.Errorf("%q：窮舉有展開使 0A 被吃，對抗模式卻通過", line)
+		}
+		if adv && !anyEat {
+			t.Errorf("%q：對抗模式失敗，窮舉卻沒有任何展開使 0A 被吃", line)
+		}
+		if _, ok := required[line]; ok {
+			required[line] = true
+		}
+	}
+	for l, ok := range required {
+		if !ok {
+			t.Errorf("窮舉沒涵蓋必含樣板 %q", l)
+		}
+	}
+}
diff --git a/apps/hr/l10n/budget/units.go b/apps/hr/l10n/budget/units.go
new file mode 100644
index 0000000..b7b63d7
--- /dev/null
+++ b/apps/hr/l10n/budget/units.go
@@ -0,0 +1,174 @@
+package budget
+
+// 轉換規格與記號切分。`%` 規格在 `_vsprintf` 看到的是原始位元組，它不認得 Big5，
+// 所以規格的辨識走原始位元組；Big5 配對只套用在規格以外的位元組（與 `287C:02E1` 的配對一致：
+// 第一個 >= 0x80 的位元組當 lead，下一個位元組當 trail）。
+
+// convSpec 是一個完整的轉換規格，例如 `%s`、`%03d`、`%10ld`。
+type convSpec struct {
+	n     int  // 規格在格式字串占的位元組數（含 `%`）
+	conv  byte // 型別字元：`s` 或 `d`
+	long  bool // 長度修飾 `l`（只和 `d` 搭配）
+	width int  // 寬度，-1 表示未指定
+	prec  int  // 精度，-1 表示未指定
+}
+
+// 計算慣例的型別上界（規格第 3.5 節）：`%s` 20、`%d` 6、`%ld` 11。
+const (
+	boundS  = 20
+	boundD  = 6
+	boundLD = 11
+)
+
+// expand 是規格展開後的位元組數（計算慣例）：帶寬度或精度者取寬度、精度與型別上界的最大值。
+func (c convSpec) expand() int {
+	bound := boundD
+	switch {
+	case c.conv == 's':
+		bound = boundS
+	case c.long:
+		bound = boundLD
+	}
+	return max(bound, c.width, c.prec)
+}
+
+// maxNum 限制寬度與精度的數值，避免惡意輸入溢位。
+const maxNum = 1 << 20
+
+func readDigits(b []byte, i int) (next, v int) {
+	for i < len(b) && b[i] >= '0' && b[i] <= '9' {
+		v = min(v*10+int(b[i]-'0'), maxNum)
+		i++
+	}
+	return i, v
+}
+
+// parseSpec 解析 b[i]（必為 `%`）起的轉換規格：`%` 旗標 寬度 `.`精度 `l` 型別。
+// 只支援 `s`、`d`、`ld`（計算慣例只定義了這三種，語料也只有這三種，`docs/re/024` 第 3.2 節）；
+// 其他型別、`*` 寬度、`%%` 與不完整的規格回 false（失敗即關閉，由呼叫端當成違規）。
+// 旗標只收 `-`、`+`、`#`、`0`：空白旗標（`% d`）不收，免得 0x20 藏在規格裡躲過空白規則
+// （原版語料沒有這種規格）。
+func parseSpec(b []byte, i int) (convSpec, bool) {
+	sp := convSpec{width: -1, prec: -1}
+	j := i + 1
+	for j < len(b) && (b[j] == '-' || b[j] == '+' || b[j] == '#' || b[j] == '0') {
+		j++
+	}
+	if k, v := readDigits(b, j); k > j {
+		sp.width, j = v, k
+	}
+	if j < len(b) && b[j] == '.' {
+		k, v := readDigits(b, j+1)
+		sp.prec, j = v, k
+	}
+	if j < len(b) && b[j] == 'l' {
+		sp.long = true
+		j++
+	}
+	if j >= len(b) {
+		return convSpec{}, false
+	}
+	switch c := b[j]; {
+	case c == 's' && !sp.long, c == 'd':
+		sp.conv = c
+		sp.n = j + 1 - i
+		return sp, true
+	}
+	return convSpec{}, false
+}
+
+type unitKind uint8
+
+const (
+	uSingle unitKind = iota // 單位元組字
+	uPair                   // 雙位元組字：lead（>= 0x80）加 trail
+	uLone                   // 沒有 trail 的 lead
+	uSpec                   // 轉換規格
+	uNL                     // 0x0A 換行
+)
+
+// unit 是 Big5 配對、規格與換行切出的最小單位。
+type unit struct {
+	kind unitKind
+	off  int      // 在原位元組串的起點
+	n    int      // 占的位元組數（字面）
+	exp  int      // 計算慣例的展開位元組數
+	spec convSpec // 只在 uSpec 有意義
+	bad  bool     // 只在 uSingle：這個 `%` 不是可解析的規格（由 placeholder 規則回報）
+}
+
+// scanUnits 把位元組串切成單位。lead 之後若沒有 trail（串尾，或接著 0x0A、0x00、`%`），
+// 這個 lead 單獨成 uLone，後面的位元組照原本的種類處理：vsprintf 先看到 `%`，
+// 而 0x0A 在 `1676` 的迴圈頂端是行的結尾。
+func scanUnits(b []byte) []unit {
+	var us []unit
+	for i := 0; i < len(b); {
+		c := b[i]
+		switch {
+		case c == '%':
+			if sp, ok := parseSpec(b, i); ok {
+				us = append(us, unit{kind: uSpec, off: i, n: sp.n, exp: sp.expand(), spec: sp})
+				i += sp.n
+			} else {
+				us = append(us, unit{kind: uSingle, off: i, n: 1, exp: 1, bad: true})
+				i++
+			}
+		case c == 0x0A:
+			us = append(us, unit{kind: uNL, off: i, n: 1, exp: 1})
+			i++
+		case c >= 0x80:
+			if i+1 < len(b) && b[i+1] != 0x0A && b[i+1] != 0x00 && b[i+1] != '%' {
+				us = append(us, unit{kind: uPair, off: i, n: 2, exp: 2})
+				i += 2
+			} else {
+				us = append(us, unit{kind: uLone, off: i, n: 1, exp: 1})
+				i++
+			}
+		default:
+			us = append(us, unit{kind: uSingle, off: i, n: 1, exp: 1})
+			i++
+		}
+	}
+	return us
+}
+
+// line 是以 0x0A 或項目結尾分隔的一行。
+type line struct {
+	units      []unit
+	start, end int  // 位元組範圍 [start, end)，不含結尾的 0x0A
+	term       bool // 以 0x0A 結尾（false 表示以項目結尾）
+	lit, exp   int  // 字面位元組數、展開位元組數（計算慣例）
+}
+
+// splitLines 依 uNL 切行。至少回一行（空串是一個空行）。
+func splitLines(us []unit, total int) []line {
+	var out []line
+	cur := line{}
+	for _, u := range us {
+		if u.kind == uNL {
+			cur.end, cur.term = u.off, true
+			out = append(out, cur)
+			cur = line{start: u.off + 1}
+			continue
+		}
+		cur.units = append(cur.units, u)
+		cur.lit += u.n
+		cur.exp += u.exp
+	}
+	cur.end = total
+	return append(out, cur)
+}
+
+// rowsFor 是展開位元組數 exp 在除數 div 下的渲染列數：max(1, ceil(exp / div))。
+func rowsFor(exp, div int) int {
+	return max(1, (exp+div-1)/div)
+}
+
+// itemMetrics 由原項目算 E_item（最長行的展開位元組數）與 R_item（渲染列數，除數取窗口容量）。
+func itemMetrics(orig []byte, w Window) (eItem, rItem int) {
+	for _, l := range splitLines(scanUnits(orig), len(orig)) {
+		eItem = max(eItem, l.exp)
+		rItem += rowsFor(l.exp, w.Cap)
+	}
+	return eItem, rItem
+}
diff --git a/apps/hr/l10n/budget/units_test.go b/apps/hr/l10n/budget/units_test.go
new file mode 100644
index 0000000..3f44bed
--- /dev/null
+++ b/apps/hr/l10n/budget/units_test.go
@@ -0,0 +1,133 @@
+package budget
+
+import "testing"
+
+func TestParseSpec(t *testing.T) {
+	tests := []struct {
+		in       string
+		ok       bool
+		n        int
+		conv     byte
+		long     bool
+		exp      int
+		leftover string // 規格之後的位元組，確認 n 正確
+	}{
+		{"%s", true, 2, 's', false, 20, ""},
+		{"%d", true, 2, 'd', false, 6, ""},
+		{"%ld", true, 3, 'd', true, 11, ""},
+		{"%03d", true, 4, 'd', false, 6, ""},  // 寬度 3 小於型別上界 6
+		{"%10ld", true, 5, 'd', true, 11, ""}, // 寬度 10 小於型別上界 11
+		{"%15ld", true, 5, 'd', true, 15, ""}, // 寬度大於型別上界
+		{"%1d", true, 3, 'd', false, 6, ""},
+		{"%4d", true, 3, 'd', false, 6, ""},
+		{"%10s", true, 4, 's', false, 20, ""},
+		{"%30s", true, 4, 's', false, 30, ""},
+		{"%.5s", true, 4, 's', false, 20, ""},
+		{"%.40s", true, 5, 's', false, 40, ""},
+		{"%-8d", true, 4, 'd', false, 8, ""},
+		{"%sAB", true, 2, 's', false, 20, "AB"},
+		{"% d", false, 0, 0, false, 0, ""}, // 空白旗標不收
+		{"%u", false, 0, 0, false, 0, ""},  // 只定義 s、d、ld
+		{"%x", false, 0, 0, false, 0, ""},
+		{"%c", false, 0, 0, false, 0, ""},
+		{"%%", false, 0, 0, false, 0, ""},
+		{"%*d", false, 0, 0, false, 0, ""},
+		{"%ls", false, 0, 0, false, 0, ""},
+		{"%", false, 0, 0, false, 0, ""},
+		{"%l", false, 0, 0, false, 0, ""},
+		{"%5", false, 0, 0, false, 0, ""},
+	}
+	for _, tc := range tests {
+		sp, ok := parseSpec([]byte(tc.in), 0)
+		if ok != tc.ok {
+			t.Errorf("%q：ok = %v，要 %v", tc.in, ok, tc.ok)
+			continue
+		}
+		if !ok {
+			continue
+		}
+		if sp.n != tc.n || sp.conv != tc.conv || sp.long != tc.long || sp.expand() != tc.exp {
+			t.Errorf("%q：n=%d conv=%c long=%v expand=%d，要 %d %c %v %d", tc.in, sp.n, sp.conv, sp.long, sp.expand(), tc.n, tc.conv, tc.long, tc.exp)
+		}
+		if got := tc.in[sp.n:]; got != tc.leftover {
+			t.Errorf("%q：規格之後是 %q，要 %q", tc.in, got, tc.leftover)
+		}
+	}
+}
+
+func TestScanUnits(t *testing.T) {
+	// 單位元組字、雙位元組字、規格、換行、沒有 trail 的 lead、`%` 擋在 lead 與 trail 之間
+	b := hb("41 A4 40 %s 0A A4 0A A4 %s 42 %q")
+	us := scanUnits(b)
+	want := []struct {
+		kind unitKind
+		n    int
+		exp  int
+	}{
+		{uSingle, 1, 1}, {uPair, 2, 2}, {uSpec, 2, 20}, {uNL, 1, 1},
+		{uLone, 1, 1}, {uNL, 1, 1}, {uLone, 1, 1}, {uSpec, 2, 20}, {uSingle, 1, 1},
+		{uSingle, 1, 1}, {uSingle, 1, 1}, // `%q`：`%` 無法解析（bad）加一個 `q`
+	}
+	if len(us) != len(want) {
+		t.Fatalf("單位數 %d，要 %d：%+v", len(us), len(want), us)
+	}
+	total := 0
+	for i, w := range want {
+		if us[i].kind != w.kind || us[i].n != w.n || us[i].exp != w.exp {
+			t.Errorf("單位 %d：%+v，要 %+v", i, us[i], w)
+		}
+		if us[i].off != total {
+			t.Errorf("單位 %d 的 off = %d，要 %d", i, us[i].off, total)
+		}
+		total += us[i].n
+	}
+	if total != len(b) {
+		t.Fatalf("單位涵蓋 %d 位元組，要 %d", total, len(b))
+	}
+	if !us[9].bad || us[10].bad {
+		t.Errorf("`%%q` 的 bad 標記：%v %v", us[9].bad, us[10].bad)
+	}
+}
+
+// lead 之後接 NUL：NUL 不當 trail，lead 單獨成 lone lead，NUL 自己是一個單位元組單位。
+func TestScanUnitsLeadNUL(t *testing.T) {
+	us := scanUnits(hb("A4 00 41"))
+	if len(us) != 3 || us[0].kind != uLone || us[1].kind != uSingle || us[1].off != 1 || us[2].kind != uSingle {
+		t.Fatalf("%+v", us)
+	}
+}
+
+func TestSplitLinesAndMetrics(t *testing.T) {
+	// 空串是一個空行；結尾的 0A 使最後多一個空行
+	if ls := splitLines(nil, 0); len(ls) != 1 || ls[0].term || ls[0].lit != 0 {
+		t.Fatalf("空串：%+v", ls)
+	}
+	b := hb("41 42 0A 43")
+	ls := splitLines(scanUnits(b), len(b))
+	if len(ls) != 2 || !ls[0].term || ls[1].term || ls[0].start != 0 || ls[0].end != 2 || ls[1].start != 3 || ls[1].end != 4 {
+		t.Fatalf("兩行：%+v", ls)
+	}
+	b = hb("41 0A")
+	ls = splitLines(scanUnits(b), len(b))
+	if len(ls) != 2 || ls[1].start != 2 || ls[1].end != 2 {
+		t.Fatalf("結尾 0A：%+v", ls)
+	}
+
+	// 原項目 1 行、40 個非規格位元組加 2 個 `%s`：E_item = 80，窗口容量 31 下 R_item = 3
+	orig := cat([]byte("%s"), pairs(0xA4, 0x40, 9), []byte("%s"), pairs(0xA4, 0x40, 11))
+	if len(orig) != 44 {
+		t.Fatalf("樣本長度 %d，要 44", len(orig))
+	}
+	e, r := itemMetrics(orig, Window{W: 30, H: 4, Cap: 31})
+	if e != 80 || r != 3 {
+		t.Fatalf("E_item=%d R_item=%d，要 80、3", e, r)
+	}
+	// R_item 的除數是窗口容量不是 W：31 bytes 的一行是 1 列（除數 W 會得 2 列）
+	e, r = itemMetrics(cat(pairs(0xA4, 0x40, 15), []byte("1")), Window{W: 30, H: 4, Cap: 31})
+	if e != 31 || r != 1 {
+		t.Fatalf("E_item=%d R_item=%d，要 31、1", e, r)
+	}
+	if rowsFor(0, 30) != 1 || rowsFor(30, 30) != 1 || rowsFor(31, 30) != 2 || rowsFor(61, 30) != 3 {
+		t.Fatal("rowsFor")
+	}
+}
diff --git a/apps/hr/l10n/budget/window.go b/apps/hr/l10n/budget/window.go
new file mode 100644
index 0000000..71f4d41
--- /dev/null
+++ b/apps/hr/l10n/budget/window.go
@@ -0,0 +1,60 @@
+// Package budget 實作 hr `docs/spec/008` 第 3.5 節的預算與檢查：窗口表、行寬與行數、
+// 單位元組白名單、佔位符、`25DC:1676` 吃換行模擬器與自動折行。
+//
+// 純函式，只用標準庫，沒有 I/O。輸入的位元組已是 Big5 與單位元組的編碼結果；
+// 檔案解析、譯文表、轉碼與 manifest 在 `apps/hr/l10n` 的其他套件。
+//
+// 測試一律用自造的位元組，不含原版文字。
+package budget
+
+import "strings"
+
+// Window 是一個窗口的行寬、行數與容量（規格第 3.5 節窗口表）。
+type Window struct {
+	W   int // 行寬上限（位元組，偶數）：窗口容量減一格再向下取偶數
+	H   int // 窗口行數；窗口未知者為 4
+	Cap int // 窗口容量 (w-8)/8，R_item 的除數與模擬器的 k；窗口未知為 31
+}
+
+// 窗口容量（位元組）。出處：`docs/re/023` 第 4.3 節與 `docs/re/024` 第 2.3 節的窗口表。
+const (
+	capWin31 = 31 // 256x67：`01A3`、`06CF`；窗口未知者比照它
+	capWin63 = 63 // 512x131：`07FE`
+	capWin29 = 29 // 240x64：VS 畫面
+	capSP    = 71 // 576x64：`SP.MES` 內文
+	capCtry  = 67 // 544x80：`COUNTRY.MES` 內文
+)
+
+// newWindow 依規格：W 取窗口容量減一格，向下取偶數（雙位元組字成對，行尾字不跨出窗口）。
+func newWindow(capacity, h int) Window {
+	w := capacity - 1
+	w -= w % 2
+	return Window{W: w, H: h, Cap: capacity}
+}
+
+// WindowFor 依檔名與 ESPMES 的窗口類別回窗口，未知的檔名或類別回 false。
+//
+// 檔名不分大小寫，`ESPMES` 與 `ESPMES.MRG` 視為同一個。`class` 只有 ESPMES 用，其他檔案忽略。
+// 窗口未知者（ESPMES `none`、`SYSTEM.MES`、`POWERMES.MES`）一律比照 win31x4（W 30、H 4、Cap 31），
+// `UWASA.MES` 走 `01A3`，也是 win31x4（規格第 3.5 節窗口表與其後的說明）。
+func WindowFor(file, class string) (Window, bool) {
+	switch strings.ToUpper(file) {
+	case "ESPMES", "ESPMES.MRG":
+		switch class {
+		case "win31x4", "none":
+			return newWindow(capWin31, 4), true
+		case "win63x8":
+			return newWindow(capWin63, 8), true
+		case "win29x4":
+			return newWindow(capWin29, 4), true
+		}
+		return Window{}, false
+	case "SP.MES":
+		return newWindow(capSP, 4), true
+	case "COUNTRY.MES":
+		return newWindow(capCtry, 5), true
+	case "UWASA.MES", "SYSTEM.MES", "POWERMES.MES":
+		return newWindow(capWin31, 4), true
+	}
+	return Window{}, false
+}
diff --git a/apps/hr/l10n/budget/wrap.go b/apps/hr/l10n/budget/wrap.go
new file mode 100644
index 0000000..de0ffcc
--- /dev/null
+++ b/apps/hr/l10n/budget/wrap.go
@@ -0,0 +1,219 @@
+package budget
+
+import "fmt"
+
+// 自動折行（規格第 3.5 節「行寬與行數」列）：超寬的行依單位寬度（單位元組字 1、雙位元組字 2、
+// 轉換規格取它在格式字串占的位元組數）在單位邊界插入 0x0A，不拆雙位元組對，也不拆轉換規格。
+// 每一個折點都要通過 `1676` 模擬（折點之前的那一列加上 0x0A 不得被多吃，折點之後的下一列從同步狀態起算）。
+
+const inf = 1 << 30
+
+// defaultBreakAfter 是 zh-TW 的預設標點規則（`Input.BreakAfter` 為 nil 時使用）：雙位元組字的 lead 等於 A1。
+// 規格沒有定義標點集合。審查核對 `charmap-zh-TW.tsv`（原版 1716 字的碼位表）：lead A1 的 20 字全是標點或符號；
+// A2 的 51 字中 50 個是全形數字與字母，A3 的 5 字不是標點，所以不能取 A1 至 A3
+// （`docs/re/020` 第 293 行的 76 個符號字是字模分區統計，不是標點分類）。
+// 這是強推論的啟發式，只影響折行品質，不影響正確性：每個折點都通過模擬與寬度檢查。
+// L2 之後全形標點配自訂碼，lead 範圍規則不再成立，由呼叫端以 `Input.BreakAfter` 依字集決定。
+func defaultBreakAfter(lead, _ byte) bool {
+	return lead == 0xA1
+}
+
+// cand 是以某個單位結尾的一個合格列：從單位 a 起，渲染列數 rows。
+type cand struct {
+	a, rows int
+}
+
+// wrapper 對一行求折行方案。
+type wrapper struct {
+	t          []byte
+	us         []unit
+	breakAfter func(lead, trail byte) bool // 在這個雙位元組字之後折算標點折點
+	cands      [][]cand                    // cands[b]：單位 [a, b) 構成一個合格列的所有 a，a 由大到小
+}
+
+// isPunct 判定單位 u 是不是「標點之後優先折」的標點：只有雙位元組字可能是，單位元組的 `/`、`:` 不算
+// （它們出現在日期與時間的數字串內，在其後折行會把數字串切開）。
+func (w *wrapper) isPunct(u unit) bool {
+	return u.kind == uPair && w.breakAfter(w.t[u.off], w.t[u.off+1])
+}
+
+// newWrapper 列出每個結尾 b 的合格列：字面位元組 <= W、展開位元組 <= limit，
+// 且（後面接 0x0A 時，即不是行的最後一列，或行本身以 0x0A 結尾）通過 `1676` 對抗模式。
+func newWrapper(t []byte, l line, win Window, limit int, breakAfter func(lead, trail byte) bool) *wrapper {
+	us := l.units
+	n := len(us)
+	lit := make([]int, n+1)
+	exp := make([]int, n+1)
+	for i, u := range us {
+		lit[i+1] = lit[i] + u.n
+		exp[i+1] = exp[i] + u.exp
+	}
+	w := &wrapper{t: t, us: us, breakAfter: breakAfter, cands: make([][]cand, n+1)}
+	for b := 1; b <= n; b++ {
+		for a := b - 1; a >= 0 && lit[b]-lit[a] <= win.W && exp[b]-exp[a] <= limit; a-- {
+			raw := t[us[a].off : us[b-1].off+us[b-1].n]
+			if b < n || l.term {
+				if LineEatsNewlineAdversarial(append(append([]byte(nil), raw...), 0x0A)) {
+					continue
+				}
+			}
+			w.cands[b] = append(w.cands[b], cand{a: a, rows: rowsFor(exp[b]-exp[a], win.W)})
+		}
+	}
+	return w
+}
+
+// minRows 是折完之後的最少渲染列數；沒有合格折法回 inf。
+func (w *wrapper) minRows() int {
+	n := len(w.us)
+	m := make([]int, n+1)
+	for b := 1; b <= n; b++ {
+		m[b] = inf
+		for _, c := range w.cands[b] {
+			if m[c.a] < inf {
+				m[b] = min(m[b], m[c.a]+c.rows)
+			}
+		}
+	}
+	return m[n]
+}
+
+// solve 在渲染列數不超過 budget 的限制下，以「非標點折點最少」為先、列數最少為次，
+// 回傳折點（每個是下一列的第一個單位索引）與實際列數。budget 必須 >= minRows()。
+func (w *wrapper) solve(budget int) (cuts []int, rows int) {
+	n := len(w.us)
+	cost := make([][]int, n+1)
+	par := make([][]int, n+1)
+	parRows := make([][]int, n+1)
+	for b := range cost {
+		cost[b] = make([]int, budget+1)
+		par[b] = make([]int, budget+1)
+		parRows[b] = make([]int, budget+1)
+		for r := range cost[b] {
+			cost[b][r] = inf
+		}
+	}
+	cost[0][0] = 0
+	for b := 1; b <= n; b++ {
+		pen := 0 // 在單位 b-1 之後折：不是標點就算一次非標點折點
+		if b < n && !w.isPunct(w.us[b-1]) {
+			pen = 1
+		}
+		for _, c := range w.cands[b] {
+			for r := c.rows; r <= budget; r++ {
+				prev := cost[c.a][r-c.rows]
+				if prev == inf {
+					continue
+				}
+				if v := prev + pen; v < cost[b][r] {
+					cost[b][r], par[b][r], parRows[b][r] = v, c.a, c.rows
+				}
+			}
+		}
+	}
+	best, bestR := inf, -1
+	for r := 0; r <= budget; r++ {
+		if cost[n][r] < best {
+			best, bestR = cost[n][r], r
+		}
+	}
+	if bestR < 0 {
+		return nil, inf
+	}
+	for b, r := n, bestR; b > 0; {
+		a := par[b][r]
+		if a > 0 {
+			cuts = append(cuts, a)
+		}
+		r -= parRows[b][r]
+		b = a
+	}
+	for i, j := 0, len(cuts)-1; i < j; i, j = i+1, j-1 {
+		cuts[i], cuts[j] = cuts[j], cuts[i]
+	}
+	return cuts, bestR
+}
+
+// AutoWrap 對超寬的行（字面位元組 > W，或展開位元組 > max(W, E_item)）自動插入 0x0A，
+// 回傳折好的位元組與違規。沒有超寬的行原樣保留；折完仍超過行數 max(H, R_item) 或某行找不到
+// 合格折點時回違規（`rows`、`line-width`），這時 `rows` 的情形仍回傳最少列數的折法，
+// 找不到折點的行維持原樣。多行超寬時依序分配列數預算：先給每行最少列數，剩餘的由前面的行優先使用。
+// 標點折點由 `in.BreakAfter` 決定，nil 時用 `defaultBreakAfter`（zh-TW：lead 等於 A1）。
+//
+// AutoWrap 只保證折點本身（行寬 (1)、(2)、渲染列數 (3) 與 `1676`），不檢查長度、控制碼、空白、白名單、佔位符。
+// 折行插入的換行會增加位元組數與展開值，輸入沒有 `length` 違規的項目在折完之後可能超過 511，
+// 所以輸出必須再跑 `Check`；`WrapAndCheck` 把這兩步合在一起。
+func AutoWrap(in Input) ([]byte, []Violation) {
+	var vs []Violation
+	add := func(rule, f string, a ...any) {
+		vs = append(vs, Violation{ID: in.ID, Rule: rule, Detail: fmt.Sprintf(f, a...)})
+	}
+	out := append([]byte(nil), in.Trans...)
+	win, ok := WindowFor(in.File, in.Class)
+	if !ok {
+		add(RuleLineWidth, "unknown-window")
+		return out, vs
+	}
+	t := in.Trans
+	lines := splitLines(scanUnits(t), len(t))
+	eItem, rItem := itemMetrics(in.Orig, win)
+	limit := max(win.W, eItem)
+	maxRows := max(win.H, rItem)
+
+	breakAfter := in.BreakAfter
+	if breakAfter == nil {
+		breakAfter = defaultBreakAfter
+	}
+
+	wr := make([]*wrapper, len(lines)) // nil：不折
+	minr := make([]int, len(lines))
+	total := 0
+	for i, l := range lines {
+		minr[i] = rowsFor(l.exp, win.W)
+		if l.lit > win.W || l.exp > limit {
+			w := newWrapper(t, l, win, limit, breakAfter)
+			if m := w.minRows(); m < inf {
+				wr[i], minr[i] = w, m
+			} else {
+				add(RuleLineWidth, "line=%d no-breakpoint", i)
+			}
+		}
+		total += minr[i]
+	}
+	spare := maxRows - total
+	if spare < 0 {
+		add(RuleRows, "rows=%d limit=%d", total, maxRows)
+		spare = 0
+	}
+
+	out = out[:0]
+	for i, l := range lines {
+		if wr[i] == nil {
+			out = append(out, t[l.start:l.end]...)
+		} else {
+			cuts, used := wr[i].solve(minr[i] + spare)
+			spare -= used - minr[i]
+			prev := 0
+			for _, c := range cuts {
+				out = append(out, t[l.units[prev].off:l.units[c-1].off+l.units[c-1].n]...)
+				out = append(out, 0x0A)
+				prev = c
+			}
+			out = append(out, t[l.units[prev].off:l.end]...)
+		}
+		if l.term {
+			out = append(out, 0x0A)
+		}
+	}
+	return out, vs
+}
+
+// WrapAndCheck 先 `AutoWrap`，再對折好的輸出跑 `Check`，回傳折好的位元組與 `Check(輸出)` 的違規（空表示全部通過）。
+// 回的違規不含 `AutoWrap` 自己的違規：它們都能由 `Check(輸出)` 重新導出（折不下的行維持原樣，
+// 仍以 `line-width` 或 `expanded-width` 出現；總列數超過時 `rows` 同樣成立）。
+// 折行新增的換行使位元組數與展開值變大，`length` 可能在折完之後才超過，所以必須對輸出再檢查。
+func WrapAndCheck(in Input) ([]byte, []Violation) {
+	out, _ := AutoWrap(in)
+	in.Trans = out
+	return out, Check(in)
+}
