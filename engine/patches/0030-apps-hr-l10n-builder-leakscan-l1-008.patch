+// 兩個執行個體並行建置收斂到同一個有效目錄（縫隙讓兩邊都建完才一起改名）。
+func TestBuildConcurrentConverges(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	base := poolCfg(w, root)
+	var gate sync.WaitGroup
+	gate.Add(2)
+	results := make([]*Result, 2)
+	errs := make([]error, 2)
+	var wg sync.WaitGroup
+	for i := 0; i < 2; i++ {
+		cfg := base
+		cfg.hooks = &buildHooks{beforeRename: func(tmp, dst string) { gate.Done(); gate.Wait() }}
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			results[i], errs[i] = Build(cfg)
+		}(i)
+	}
+	wg.Wait()
+	for i := range errs {
+		if errs[i] != nil {
+			t.Fatalf("執行個體 %d：%v", i, errs[i])
+		}
+	}
+	if results[0].Dir != results[1].Dir {
+		t.Fatalf("兩個執行個體得到不同的目錄：%s、%s", results[0].Dir, results[1].Dir)
+	}
+	if results[0].Reused == results[1].Reused {
+		t.Errorf("應恰有一個重用：%v、%v", results[0].Reused, results[1].Reused)
+	}
+	d, _ := ExpectedDigest(base)
+	if err := w.verifyPack(results[0].Dir, d); err != nil {
+		t.Error(err)
+	}
+	if got := finalPacks(t, root); len(got) != 1 {
+		t.Errorf("包根下有 %v", got)
+	}
+	if got := tmpEntries(t, root); len(got) != 0 {
+		t.Errorf("暫存目錄殘留：%v", got)
+	}
+}
