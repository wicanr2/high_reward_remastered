+// 登記上限的邊界：所屬段 7 個字可登記，8 個字不可；規則逐單位成立。
+func TestCheckAllowBoundary(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		var entries []AllowEntry
+		wantReject := map[string]bool{}
+		saw7, saw8 := false, false
+		for i, u := range w.units {
+			entries = append(entries, AllowEntry{Line: i + 1, Path: "x", UnitID: u.ID})
+			if u.SegChars > 7 {
+				wantReject[u.ID] = true
+			}
+			saw7 = saw7 || u.SegChars == 7
+			saw8 = saw8 || u.SegChars == 8
+		}
+		if !saw7 || !saw8 {
+			t.Fatalf("%s世界沒有段字數 7 與 8 的單位，邊界無法驗證", w.name)
+		}
+		got := map[string]bool{}
+		for _, r := range CheckAllow(entries, w.units) {
+			got[r.UnitID] = true
+		}
+		for id := range wantReject {
+			if !got[id] {
+				t.Fatalf("所屬段超過 7 字的單位 %s 沒有被拒", id)
+			}
+		}
+		for id := range got {
+			if !wantReject[id] {
+				t.Fatalf("所屬段不超過 7 字的單位 %s 被拒", id)
+			}
+		}
+	})
+}
