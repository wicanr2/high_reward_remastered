+	good := raw(p)
+	for name, bad := range map[string][]byte{
+		"垃圾":          []byte("not json"),
+		"未知欄位":        []byte(strings.Replace(string(good), `"adopted"`, `"surprise": 1, "adopted"`, 1)),
+		"結尾多餘內容":      append(append([]byte(nil), good...), []byte(`{"x":1}`)...),
+		"格式版本錯":       []byte(strings.Replace(string(good), `"format": 1`, `"format": 2`, 1)),
+		"files 欄位被改名": []byte(strings.Replace(string(good), `"files": [`, `"files_renamed": [`, 1)),
+		"檔名含路徑":       []byte(strings.Replace(string(good), `"SP.MES"`, `"../SP.MES"`, 1)),
+		"檔名含反斜線":      []byte(strings.Replace(string(good), `"SP.MES"`, `"a\\b"`, 1)),
+		"檔名是點":        []byte(strings.Replace(string(good), `"SP.MES"`, `"."`, 1)),
+		"雜湊不是 64 碼":   []byte(strings.Replace(string(good), sum(p.files["SP.MES"]), "abcd", 1)),
+		"雜湊含大寫":       []byte(strings.Replace(string(good), sum(p.files["SP.MES"]), strings.ToUpper(sum(p.files["SP.MES"])), 1)),
+	} {
+		put(p, bad)
+		_, err := Verify(p.root, p.opt())
+		wantCode(t, name, err, CodeBadManifest)
+	}
+	// 檔名重複（大小寫不分）
+	p = newTestPack(t)
+	p.m.Files = append(p.m.Files, FileEntry{Name: "sp.mes", SHA256: p.m.Files[1].SHA256, Size: p.m.Files[1].Size})
+	p.writeManifest(t)
+	_, err = Verify(p.root, p.opt())
+	wantCode(t, "檔名重複", err, CodeBadManifest)
+	// 檔案列表為空
+	p = newTestPack(t)
+	p.m.Files = nil
+	p.writeManifest(t)
+	_, err = Verify(p.root, p.opt())
+	wantCode(t, "沒有列出檔案", err, CodeBadManifest)
+	// 負的大小
+	p = newTestPack(t)
+	p.m.Files[0].Size = -1
+	p.writeManifest(t)
+	_, err = Verify(p.root, p.opt())
+	wantCode(t, "負的大小", err, CodeBadManifest)
+}
+
+func TestVerifyOrigHashes(t *testing.T) {
+	p := newTestPack(t)
+	// 一個輸入雜湊不符
+	o := p.opt()
+	o.OrigHashes["SP.MES"] = sum([]byte("another original"))
+	_, err := Verify(p.root, o)
+	wantCode(t, "原版輸入雜湊不符", err, CodeOrigHash)
+	if err != nil && !strings.Contains(err.Error(), "SP.MES") {
+		t.Errorf("應點名輸入：%v", err)
+	}
+	// 每個輸入都要被比對
+	for _, n := range InputNames() {
+		o := p.opt()
+		o.OrigHashes[n] = sum([]byte("x" + n))
+		_, err := Verify(p.root, o)
+		wantCode(t, "改 "+n, err, CodeOrigHash)
+	}
+	// manifest 少一個輸入、多一個輸入
+	p2 := newTestPack(t)
+	delete(p2.m.OrigInputs, "MAIN.EXE")
+	p2.writeManifest(t)
+	_, err = Verify(p2.root, p2.opt())
+	wantCode(t, "manifest 少一個輸入", err, CodeOrigHash)
+	p3 := newTestPack(t)
+	p3.m.OrigInputs["EXTRA.BIN"] = sum(nil)
+	p3.writeManifest(t)
+	_, err = Verify(p3.root, p3.opt())
+	wantCode(t, "manifest 多一個輸入", err, CodeOrigHash)
+	// manifest 用一個不屬於九個輸入的鍵換掉其中一個
+	p4 := newTestPack(t)
+	p4.m.OrigInputs["EXTRA.BIN"] = p4.m.OrigInputs["MAIN.EXE"]
+	delete(p4.m.OrigInputs, "MAIN.EXE")
+	p4.writeManifest(t)
+	_, err = Verify(p4.root, p4.opt())
+	wantCode(t, "manifest 輸入換了鍵", err, CodeOrigHash)
+}
+
+func TestVerifyDigest(t *testing.T) {
+	p := newTestPack(t)
+	o := p.opt()
+	o.ExpectDigest = strings.Replace(goodDigest, "0123", "9999", 1)
+	_, err := Verify(p.root, o)
+	wantCode(t, "輸入摘要不符", err, CodeDigestMismatch)
+
+	// SkipDigest：略過摘要這一項
+	o.SkipDigest = true
+	if _, err := Verify(p.root, o); err != nil {
+		t.Errorf("SkipDigest 為真時摘要不符仍應通過：%v", err)
+	}
+	o.ExpectDigest = ""
+	if _, err := Verify(p.root, o); err != nil {
+		t.Errorf("SkipDigest 為真時不需要預期摘要：%v", err)
+	}
+	// 但其他驗證照常：檔案雜湊不符必須被拒
+	if err := os.WriteFile(filepath.Join(p.root, FilesDir, "SP.MES"), []byte("sp-bytes-XXXXXXXXXX"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	_, err = Verify(p.root, o)
+	wantCode(t, "SkipDigest 時檔案雜湊不符", err, CodeFileHash)
+	// 原版輸入雜湊不符也必須被拒
+	p = newTestPack(t)
+	o = p.opt()
+	o.SkipDigest = true
+	o.OrigHashes["CFONT.15"] = sum([]byte("other"))
+	_, err = Verify(p.root, o)
+	wantCode(t, "SkipDigest 時原版雜湊不符", err, CodeOrigHash)
+}
+
+func TestVerifyBadOptions(t *testing.T) {
+	p := newTestPack(t)
+	_, err := Verify(p.root, Options{ExpectDigest: goodDigest})
+	wantCode(t, "沒有原版雜湊", err, CodeBadOptions)
+	_, err = Verify(p.root, Options{OrigHashes: p.orig})
+	wantCode(t, "沒有預期摘要又沒有明示略過", err, CodeBadOptions)
+	o := p.opt()
+	delete(o.OrigHashes, "UWASA.MES")
+	_, err = Verify(p.root, o)
+	wantCode(t, "原版雜湊缺一個輸入", err, CodeBadOptions)
+	if !IsCode(err, CodeBadOptions) || IsCode(err, CodeFileHash) || IsCode(nil, CodeBadOptions) {
+		t.Error("IsCode 判斷錯誤")
+	}
+}
+
+func TestManifestSHA256AndNormalizeDir(t *testing.T) {
+	p := newTestPack(t)
+	raw, err := os.ReadFile(filepath.Join(p.root, ManifestName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := ManifestSHA256(p.root)
+	if err != nil || got != sum(raw) {
+		t.Errorf("ManifestSHA256 ＝ %s（%v），應為 manifest.json 原始位元組的 SHA-256 %s", got, err, sum(raw))
+	}
+	if _, err := ManifestSHA256(filepath.Join(t.TempDir(), "nope")); err == nil {
+		t.Error("缺 manifest.json 應回錯")
+	}
+	if d, err := NormalizeDir("a/../b//c/"); err != nil || !filepath.IsAbs(d) || filepath.Base(d) != "c" || strings.Contains(d, "..") || strings.HasSuffix(d, "/") {
+		t.Errorf("NormalizeDir ＝ %q（%v）", d, err)
+	}
+	if a, _ := NormalizeDir("x"); a != func() string { w, _ := os.Getwd(); return filepath.Join(w, "x") }() {
+		t.Errorf("相對路徑應接在目前目錄之後：%s", a)
+	}
+}
+
+func TestManifestMarshalStable(t *testing.T) {
+	p := newTestPack(t)
+	a, err := p.m.Marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 20; i++ { // map 欄位（orig_inputs）的輸出順序必須固定
+		b, _ := p.m.Marshal()
+		if string(a) != string(b) {
+			t.Fatal("同一個 manifest 兩次序列化不同")
+		}
+	}
+	if a[len(a)-1] != '\n' || strings.Contains(string(a), "\r") {
+		t.Error("manifest 應以 LF 結尾且不含 CR")
+	}
+	back, err := ParseManifest(a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, _ := back.Marshal()
+	if string(a) != string(c) {
+		t.Error("讀回再寫出不相同")
+	}
+}
+
+func TestPolicyCanonical(t *testing.T) {
+	got := Policy{Mode: "table", WithCandidates: true, AllowShoptab: true}.Canonical()
+	want := "mode=table;with-candidates=1;allow-country-offsets=0;allow-shoptab=1"
+	if got != want {
+		t.Errorf("Canonical ＝ %q，應為 %q", got, want)
+	}
+}
+
+func TestInputNames(t *testing.T) {
+	n := InputNames()
+	if len(n) != 9 {
+		t.Fatalf("九個輸入，實際 %d", len(n))
+	}
+	for i := 1; i < len(n); i++ {
+		if n[i-1] >= n[i] {
+			t.Errorf("InputNames 應依字母序：%v", n)
+		}
+	}
+	n[0] = "MUTATED"
+	if InputNames()[0] == "MUTATED" {
+		t.Error("InputNames 應回傳複本")
+	}
+}
