+	}
+	for _, r := range "大小中國人上下天地水火" {
+		if strings.ContainsRune(all, r) {
+			t.Errorf("違規清單含譯文文句（%q）：\n%s", string(r), all)
+		}
+	}
+	if len(ve.Items) < 3 {
+		t.Errorf("違規只有 %d 項，應全部收集（至少 3 項）：\n%s", len(ve.Items), all)
