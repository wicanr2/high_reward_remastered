+// 由位元組算的雜湊（tableHashOf）與由目錄算的雜湊（TableHash）同一個公式；沒有檔案取空位元組串的 SHA-256。
+func TestTableHashOfMatchesTableHash(t *testing.T) {
+	w := newSynthWorld(t)
+	if tableHashOf(nil) != emptyTableHash || tableHashOf(map[string][]byte{}) != emptyTableHash {
+		t.Error("沒有檔案應取空位元組串的 SHA-256")
+	}
+	d := w.tableDir(w.row("SP.MES#0", "上下大小", StatusAccepted), w.row("SYSTEM.MES#1", "山水", StatusCandidate))
+	files, err := readTableFiles(d)
+	if err != nil || len(files) != 2 || files["SP.MES"] == nil || files["SYSTEM.MES"] == nil {
+		t.Fatalf("readTableFiles：%v %d 個檔", err, len(files))
+	}
+	want, err := TableHash(d)
+	if err != nil || tableHashOf(files) != want {
+		t.Errorf("tableHashOf %s 與 TableHash %s 不同（%v）", tableHashOf(files), want, err)
+	}
+	// 位元組內容進雜湊：換一個位元組就不同
+	files["SP.MES"] = append(bytes.Clone(files["SP.MES"]), '\n')
+	if tableHashOf(files) == want {
+		t.Error("內容改變，雜湊卻相同")
+	}
+}
