+	big := strings.Repeat("x", 8<<20) // 先建好輸入，不算進量測
+	runtime.GC()
+	runtime.ReadMemStats(&ms0)
+	_, err = ScanHistory(w.ix, strings.NewReader(big), func(Hit) {})
+	runtime.ReadMemStats(&ms1)
+	if err == nil || !strings.Contains(err.Error(), "標頭行") {
+		t.Fatalf("沒有換行的巨量輸入必須在標頭行上限失敗：%v", err)
+	}
+	if grew := ms1.TotalAlloc - ms0.TotalAlloc; grew > 4<<20 {
+		t.Errorf("標頭行過長時配置了 %d bytes", grew)
+	}
+}
