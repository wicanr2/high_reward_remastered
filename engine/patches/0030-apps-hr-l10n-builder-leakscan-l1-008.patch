+package l10n
+
+// 譯文表的合併與完整性檢查（docs/spec/008 第 3.3 節「合併規則」、第 8 節「譯文表完整性與合併規則」）。
+
+// MergeReport 是 Table.Merge 的結果清單，每項只列 id（依批次內的順序）。
+type MergeReport struct {
+	Added       []string // 原表沒有的 id：批次的列附加在表尾
+	Replaced    []string // 原列為 candidate：被批次的列替換
+	Overwritten []string // 原列為 accepted 或 keep，allowOverwrite 為真：替換並退回 candidate、清空 acc_sha
+	Rejected    []string // 原列為 accepted 或 keep，allowOverwrite 為假：拒絕，原列不變
+	Unchanged   []string // 批次的列與原列逐欄相同：略過（不算拒絕）
+	Invalid     []string // 批次的列格式不合（Row.validate）或 id 在批次內重複（只處理第一列）：略過
+}
+
+// Merge 把一批列合併進譯文表，回傳新表（不改動 t 與 batch）與結果清單。
+//
+// 規則（規格第 3.3 節：批次合併只能替換 candidate 列，改動 accepted 或 keep 列要明確旗標並自動退回 candidate）：
+//   - 批次的列在原表沒有同 id：附加在表尾；
+//   - 原列為 candidate：以批次的列替換（位置不變）；
+//   - 原列為 accepted 或 keep：allowOverwrite 為假就拒絕，列入 Rejected，原列不變；
+//     為真就以批次的列替換，並把 status 退回 candidate、清空 acc_sha（接受要使用者重新明示）；
+//   - 批次的列與原列逐欄相同：略過，列入 Unchanged；
+//   - 批次的列格式不合或 id 在批次內重複：略過，列入 Invalid。
+//
+// 替換或附加時批次的列原樣使用（包含它自己的 status）；批次要引入 accepted 列等於替使用者接受，
+// 由產生批次的工具負責，本函式不介入。
+func (t *Table) Merge(batch *Table, allowOverwrite bool) (*Table, MergeReport) {
+	var rep MergeReport
+	out := &Table{}
+	if t != nil {
+		out.Rows = append(out.Rows, t.Rows...)
+	}
+	if batch == nil {
+		return out, rep
+	}
+	pos := make(map[string]int, len(out.Rows))
+	for i, r := range out.Rows {
+		if _, dup := pos[r.ID]; !dup {
+			pos[r.ID] = i
+		}
+	}
+	seen := make(map[string]bool, len(batch.Rows))
+	for _, nr := range batch.Rows {
+		if seen[nr.ID] {
+			rep.Invalid = append(rep.Invalid, nr.ID)
+			continue
+		}
+		seen[nr.ID] = true
+		if nr.validate() != nil {
+			rep.Invalid = append(rep.Invalid, nr.ID)
+			continue
+		}
+		i, ok := pos[nr.ID]
+		if !ok {
+			pos[nr.ID] = len(out.Rows)
+			out.Rows = append(out.Rows, nr)
+			rep.Added = append(rep.Added, nr.ID)
+			continue
+		}
+		old := out.Rows[i]
+		if old == nr {
+			rep.Unchanged = append(rep.Unchanged, nr.ID)
+			continue
+		}
+		if old.Status == StatusCandidate {
+			out.Rows[i] = nr
+			rep.Replaced = append(rep.Replaced, nr.ID)
+			continue
+		}
+		if !allowOverwrite {
+			rep.Rejected = append(rep.Rejected, nr.ID)
+			continue
+		}
+		nr.Status = StatusCandidate
+		nr.AccSHA = ""
+		out.Rows[i] = nr
+		rep.Overwritten = append(rep.Overwritten, nr.ID)
+	}
+	return out, rep
+}
+
+// Coverage 回報譯文表與一個檔案的項目對照（依檔案順序與表內順序）：
+// missing 是該檔的項目 id 在表內沒有列；unknown 是表內的 id 不是該檔的項目（包含別的檔案的 id 與不存在的索引）。
+// 一份完整的表 missing 為空，用於「刪一列檢查必須失敗」與 L3 閘門。f 為 nil 時視為沒有項目。
+func (t *Table) Coverage(f *File) (missing, unknown []string) {
+	have := make(map[string]bool)
+	if t != nil {
+		for _, r := range t.Rows {
+			have[r.ID] = true
+		}
+	}
+	if f != nil {
+		for _, it := range f.Items {
+			if !have[it.ID] {
+				missing = append(missing, it.ID)
+			}
+		}
+	}
+	if t != nil {
+		seen := make(map[string]bool)
+		for _, r := range t.Rows {
+			if seen[r.ID] {
+				continue
+			}
+			seen[r.ID] = true
+			if f == nil {
+				unknown = append(unknown, r.ID)
+				continue
+			}
+			if _, ok := f.index[r.ID]; !ok {
+				unknown = append(unknown, r.ID)
+			}
+		}
+	}
+	return missing, unknown
+}
+
+// UnclaimedIDs 回傳表內沒有被任何一個給定檔案認領的 id（依表內順序，每個 id 只列一次）。
+// 認領是 id 等於某個檔案的某個項目 id；前綴打錯、索引不存在、格式不合的 id 都不會被認領。
+// `Adopt` 只處理前綴屬於該檔的列，前綴打錯的列會被每一次 Adopt 略過，所以建置端要另用這個檢查。
+func (t *Table) UnclaimedIDs(files []*File) []string {
+	if t == nil {
+		return nil
+	}
+	var out []string
+	seen := make(map[string]bool)
+	for _, r := range t.Rows {
+		if seen[r.ID] {
+			continue
+		}
+		seen[r.ID] = true
+		claimed := false
+		for _, f := range files {
+			if f == nil {
+				continue
+			}
+			if _, ok := f.index[r.ID]; ok {
+				claimed = true
+				break
+			}
+		}
+		if !claimed {
+			out = append(out, r.ID)
+		}
+	}
+	return out
+}
diff --git a/apps/hr/l10n/tablemerge_test.go b/apps/hr/l10n/tablemerge_test.go
new file mode 100644
index 0000000..64db0ff
--- /dev/null
+++ b/apps/hr/l10n/tablemerge_test.go
@@ -0,0 +1,217 @@
+package l10n
+
+import (
+	"strings"
+	"testing"
+)
+
+func mergeBase(t *testing.T) (*File, *Table) {
+	t.Helper()
+	f := mustParse(t, "SP.MES", buildMES([]string{"a", "b", "c", "d"}, 0))
+	return f, &Table{Rows: []Row{
+		mkRow(f, 0, StatusAccepted, txtA),
+		mkRow(f, 1, StatusKeep, ""),
+		mkRow(f, 2, StatusCandidate, txtB),
+	}}
+}
+
+func mergeRowByID(tb *Table, id string) (Row, bool) {
+	for _, r := range tb.Rows {
+		if r.ID == id {
+			return r, true
+		}
+	}
+	return Row{}, false
+}
+
+func mergeIDs(tb *Table) string {
+	var s []string
+	for _, r := range tb.Rows {
+		s = append(s, r.ID)
+	}
+	return strings.Join(s, ",")
+}
+
+func TestMergeDoesNotOverwriteAcceptedOrKeep(t *testing.T) {
+	f, tb := mergeBase(t)
+	before := saveString(t, tb)
+	batch := &Table{Rows: []Row{
+		mkRow(f, 0, StatusCandidate, txtC), // 原列 accepted
+		mkRow(f, 1, StatusCandidate, txtC), // 原列 keep
+		mkRow(f, 2, StatusCandidate, txtC), // 原列 candidate
+		mkRow(f, 3, StatusCandidate, txtC), // 原表沒有
+	}}
+	out, rep := tb.Merge(batch, false)
+	if got := strings.Join(rep.Rejected, ","); got != "SP.MES#0,SP.MES#1" {
+		t.Errorf("Rejected ＝ %q；原列為 accepted 或 keep 時，旗標未開要拒絕並列出 id", got)
+	}
+	if strings.Join(rep.Replaced, ",") != "SP.MES#2" || strings.Join(rep.Added, ",") != "SP.MES#3" ||
+		len(rep.Overwritten) != 0 || len(rep.Unchanged) != 0 || len(rep.Invalid) != 0 {
+		t.Errorf("其餘清單：%+v", rep)
+	}
+	// 被拒絕的列不改；candidate 被替換；新的附加在表尾，順序是原表加新列。
+	if r, _ := mergeRowByID(out, "SP.MES#0"); r != tb.Rows[0] {
+		t.Errorf("accepted 列被改動：%+v", r)
+	}
+	if r, _ := mergeRowByID(out, "SP.MES#1"); r != tb.Rows[1] {
+		t.Errorf("keep 列被改動：%+v", r)
+	}
+	if r, _ := mergeRowByID(out, "SP.MES#2"); r != batch.Rows[2] {
+		t.Errorf("candidate 列沒有被替換：%+v", r)
+	}
+	if got := mergeIDs(out); got != "SP.MES#0,SP.MES#1,SP.MES#2,SP.MES#3" {
+		t.Errorf("列的順序：%s", got)
+	}
+	// 不改動輸入；結果存得出去、讀得回來。
+	if saveString(t, tb) != before {
+		t.Error("Merge 改動了原表")
+	}
+	if back, err := LoadTable(strings.NewReader(saveString(t, out))); err != nil || len(back.Rows) != 4 {
+		t.Errorf("合併結果存檔再讀回：%v", err)
+	}
+}
+
+func TestMergeOverwriteFlagDemotesToCandidate(t *testing.T) {
+	f, tb := mergeBase(t)
+	accepted := mkRow(f, 0, StatusAccepted, txtC) // 批次的列自己帶 accepted 與 acc_sha
+	keep := mkRow(f, 1, StatusKeep, "")
+	keep.Note = "改成翻譯" // 與原 keep 列不同
+	batch := &Table{Rows: []Row{accepted, keep}}
+	out, rep := tb.Merge(batch, true)
+	if strings.Join(rep.Overwritten, ",") != "SP.MES#0,SP.MES#1" || len(rep.Rejected) != 0 {
+		t.Fatalf("旗標開啟：%+v", rep)
+	}
+	r0, _ := mergeRowByID(out, "SP.MES#0")
+	if r0.Status != StatusCandidate || r0.AccSHA != "" || r0.Text != txtC {
+		t.Errorf("覆蓋 accepted 列要退回 candidate 並清空 acc_sha：%+v", r0)
+	}
+	r1, _ := mergeRowByID(out, "SP.MES#1")
+	if r1.Status != StatusCandidate || r1.Note != "改成翻譯" {
+		t.Errorf("覆蓋 keep 列要退回 candidate：%+v", r1)
+	}
+	// 退回 candidate 之後，預設政策不採用（需要使用者重新接受）。
+	cs := mustCharmap(t)
+	repl, n, viol, err := out.Adopt(f, Policy{}, cs, nil)
+	if err != nil || len(viol) != 0 || n != 0 || len(repl) != 0 {
+		t.Errorf("覆蓋後的列預設不被採用：%v %v %d", viol, err, n)
+	}
+	// 原表不動。
+	if tb.Rows[0].Status != StatusAccepted || tb.Rows[0].AccSHA == "" {
+		t.Error("Merge 改動了原表的列")
+	}
+}
+
+func TestMergeUnchangedInvalidAndNil(t *testing.T) {
+	f, tb := mergeBase(t)
+	bad := mkRow(f, 3, StatusCandidate, txtA)
+	bad.Status = "bogus"
+	dupA := mkRow(f, 3, StatusCandidate, txtB)
+	dupB := mkRow(f, 3, StatusCandidate, txtC)
+	batch := &Table{Rows: []Row{
+		tb.Rows[0], // 與原列逐欄相同：略過，不算拒絕
+		bad,
+		dupA,
+		dupB, // 批次內重複的 id：只處理第一列
+	}}
+	out, rep := tb.Merge(batch, false)
+	if strings.Join(rep.Unchanged, ",") != "SP.MES#0" || len(rep.Rejected) != 0 {
+		t.Errorf("逐欄相同的列：%+v", rep)
+	}
+	// bad 是 #3 的第一列但格式不合；dupA、dupB 之後的列：第一列（bad）先被標 seen 並判無效，其後的重複 id 也無效。
+	if strings.Join(rep.Invalid, ",") != "SP.MES#3,SP.MES#3,SP.MES#3" || len(rep.Added) != 0 {
+		t.Errorf("Invalid ＝ %v，Added ＝ %v", rep.Invalid, rep.Added)
+	}
+	if mergeIDs(out) != "SP.MES#0,SP.MES#1,SP.MES#2" {
+		t.Errorf("無效列不應進表：%s", mergeIDs(out))
+	}
+	// 第一列有效時，其後同 id 的列才是重複。
+	out, rep = tb.Merge(&Table{Rows: []Row{dupA, dupB}}, false)
+	if strings.Join(rep.Added, ",") != "SP.MES#3" || strings.Join(rep.Invalid, ",") != "SP.MES#3" {
+		t.Errorf("批次內重複：%+v", rep)
+	}
+	if r, _ := mergeRowByID(out, "SP.MES#3"); r != dupA {
+		t.Errorf("批次內重複的 id 只處理第一列：%+v", r)
+	}
+	// nil 批次與 nil 原表。
+	if out, rep := tb.Merge(nil, false); len(out.Rows) != 3 || len(rep.Added)+len(rep.Replaced)+len(rep.Rejected) != 0 {
+		t.Errorf("nil 批次：%d 列 %+v", len(out.Rows), rep)
+	}
+	if out, rep := (*Table)(nil).Merge(&Table{Rows: []Row{dupA}}, false); len(out.Rows) != 1 || len(rep.Added) != 1 {
+		t.Errorf("nil 原表：%d 列 %+v", len(out.Rows), rep)
+	}
+}
+
+func TestCoverageReportsMissingAndUnknown(t *testing.T) {
+	f := mustParse(t, "SP.MES", buildMES([]string{"a", "b", "c", "d"}, 0))
+	full := &Table{}
+	for i := range f.Items {
+		full.Rows = append(full.Rows, mkRow(f, i, StatusKeep, ""))
+	}
+	if missing, unknown := full.Coverage(f); len(missing) != 0 || len(unknown) != 0 {
+		t.Fatalf("完整的表：missing %v unknown %v", missing, unknown)
+	}
+	// 刪一列：missing 必須回報（規格第 8 節「刪一列檢查必須失敗」）。
+	del := &Table{Rows: append(append([]Row(nil), full.Rows[:2]...), full.Rows[3:]...)}
+	missing, unknown := del.Coverage(f)
+	if strings.Join(missing, ",") != "SP.MES#2" || len(unknown) != 0 {
+		t.Errorf("刪一列：missing %v unknown %v", missing, unknown)
+	}
+	// 表內有不屬於該檔的 id：別的檔、不存在的索引。
+	extra := &Table{Rows: append(append([]Row(nil), full.Rows...),
+		Row{ID: "SYSTEM.MES#0", SrcSHA: "0123456789abcdef", Status: StatusKeep},
+		Row{ID: "SP.MES#99", SrcSHA: "0123456789abcdef", Status: StatusKeep},
+		Row{ID: "SP.MES#99", SrcSHA: "0123456789abcdef", Status: StatusKeep}, // 重複只列一次
+	)}
+	missing, unknown = extra.Coverage(f)
+	if len(missing) != 0 || strings.Join(unknown, ",") != "SYSTEM.MES#0,SP.MES#99" {
+		t.Errorf("多出的 id：missing %v unknown %v", missing, unknown)
+	}
+	// nil：全部缺，或全部不屬於。
+	if missing, _ := (*Table)(nil).Coverage(f); len(missing) != 4 {
+		t.Errorf("nil 表：missing %v", missing)
+	}
+	if missing, unknown := full.Coverage(nil); len(missing) != 0 || len(unknown) != 4 {
+		t.Errorf("nil 檔案：missing %v unknown %v", missing, unknown)
+	}
+}
+
+func TestUnclaimedIDs(t *testing.T) {
+	sp := mustParse(t, "SP.MES", buildMES([]string{"a", "b"}, 0))
+	uw := mustParse(t, "UWASA.MES", buildMES([]string{"x"}, 0))
+	tb := &Table{Rows: []Row{
+		mkRow(sp, 1, StatusKeep, ""),
+		mkRow(uw, 0, StatusKeep, ""),
+		{ID: "SP.MEZ#1", SrcSHA: "0123456789abcdef", Status: StatusKeep},     // 前綴打錯
+		{ID: "SP.MES#99", SrcSHA: "0123456789abcdef", Status: StatusKeep},    // 索引不存在
+		{ID: "SYSTEM.MES#0", SrcSHA: "0123456789abcdef", Status: StatusKeep}, // 檔案沒有給
+		{ID: "not an id", SrcSHA: "0123456789abcdef", Status: StatusKeep},    // 格式不合（手造的表才會有）
+		{ID: "SP.MEZ#1", SrcSHA: "0123456789abcdef", Status: StatusKeep},     // 重複只列一次
+	}}
+	got := tb.UnclaimedIDs([]*File{sp, uw})
+	if strings.Join(got, "|") != "SP.MEZ#1|SP.MES#99|SYSTEM.MES#0|not an id" {
+		t.Errorf("UnclaimedIDs ＝ %q", got)
+	}
+	// 前綴打錯的列被每一次 Adopt 略過（無聲掉落），所以需要這個檢查。
+	cs := mustCharmap(t)
+	typo := &Table{Rows: []Row{{ID: "SP.MEZ#1", SrcSHA: SrcSHA(sp.Items[1].Orig), Text: txtA, Status: StatusAccepted, AccSHA: AccSHA(txtA)}}}
+	for _, f := range []*File{sp, uw} {
+		if _, n, viol, err := typo.Adopt(f, Policy{}, cs, nil); err != nil || len(viol) != 0 || n != 0 {
+			t.Errorf("%s：前綴打錯的列應被 Adopt 略過：%v %v %d", f.Name, viol, err, n)
+		}
+	}
+	if got := typo.UnclaimedIDs([]*File{sp, uw}); len(got) != 1 || got[0] != "SP.MEZ#1" {
+		t.Errorf("前綴打錯的列必須被 UnclaimedIDs 列出：%v", got)
+	}
+	// 全部被認領：空。
+	ok := &Table{Rows: []Row{mkRow(sp, 0, StatusKeep, ""), mkRow(uw, 0, StatusKeep, "")}}
+	if got := ok.UnclaimedIDs([]*File{sp, uw}); len(got) != 0 {
+		t.Errorf("全部被認領：%v", got)
+	}
+	// 沒有給檔案或 nil 表。
+	if got := ok.UnclaimedIDs(nil); len(got) != 2 {
+		t.Errorf("沒有給檔案：%v", got)
+	}
+	if got := (*Table)(nil).UnclaimedIDs([]*File{sp}); got != nil {
+		t.Errorf("nil 表：%v", got)
+	}
+}
