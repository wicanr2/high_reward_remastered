+// runMain 在行程內執行 `hrl10n leakscan`，回傳退出碼、標準輸出與標準錯誤。
+func runMain(stdin string, args ...string) (int, string, string) {
+	var o, e bytes.Buffer
+	code := Main(args, strings.NewReader(stdin), &o, &e)
+	return code, o.String(), e.String()
+}
