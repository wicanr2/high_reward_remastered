+// 獨立的總數斷言：用測試自己的讀法（espCountsIndependently）數 N2 - 1，不經過解析器。
+// 往返在解析器與序列化器一致地錯時仍然相等，所以它不能當偵測器；這個斷言才是。
+func TestOriginalESPCounts(t *testing.T) {
+	orig := readOrig(t, "ESPMES.MRG")["ESPMES.MRG"]
+	per, total := espCountsIndependently(orig)
+	if total != 1024 {
+		t.Fatalf("獨立讀法：項目總數 %d，應為 1024", total)
+	}
+	// N2 合計 1034（每個非空群組的 N2 比項目數多 1，共 10 個非空群組）。
+	n2sum := 0
+	for g := range per {
+		n2sum += per[g] + 1
+	}
+	if n2sum != 1034 || len(per) != 10 {
+		t.Errorf("N2 合計 %d（應為 1034），非空群組 %d（應為 10）", n2sum, len(per))
+	}
+	f := mustParse(t, "ESPMES.MRG", orig)
+	gp, gt := parsedCounts(f)
+	if gt != 1024 {
+		t.Errorf("解析器項目總數 %d，應為 1024（多出一項會得到 1034）", gt)
+	}
+	for g, c := range per {
+		if gp[g] != c {
+			t.Errorf("群組 %d：解析器 %d 項，N2 - 1 ＝ %d", g, gp[g], c)
+		}
+	}
+	// 外層：N ＝ 126、125 個偏移、非空群組 44 與 116 至 124、空群組 115 個。
+	if n := int(binary.LittleEndian.Uint16(orig)); n != 126 {
+		t.Errorf("外層 N ＝ %d", n)
+	}
+	for _, g := range []int{44, 116, 117, 118, 119, 120, 121, 122, 123, 124} {
+		if _, ok := per[g]; !ok {
+			t.Errorf("群組 %d 應為非空", g)
+		}
+	}
+	empty := 0
+	for _, g := range f.espGroups {
+		if g.empty {
+			empty++
+		}
+	}
+	if len(f.espGroups) != 125 || empty != 115 {
+		t.Errorf("群組數 %d（應為 125），空群組 %d（應為 115）", len(f.espGroups), empty)
+	}
+}
