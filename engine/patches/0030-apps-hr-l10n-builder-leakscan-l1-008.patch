+// 寫進檔案的位元組是折行之後、通過 Check 的那一份。
+func TestBuildWritesAutoWrappedBytes(t *testing.T) {
+	w := newSynthWorld(t)
+	long := strings.Repeat("一二三上下", 4) // 20 字、40 bytes，超過窗口行寬 30
+	td := w.tableDir(w.row("ESPMES#121.1", long, StatusAccepted))
+	res := mustBuild(t, w.cfg(t.TempDir(), td, ModeTable, Policy{}))
+	esp := mustParse(t, "ESPMES.MRG", packFile(t, res.Dir, "ESPMES.MRG"))
+	it, _ := esp.Lookup("ESPMES#121.1")
+	plain := w.enc(long)
+	if bytes.Equal(it.Orig, plain) || bytes.Count(it.Orig, []byte{0x0A}) < 1 {
+		t.Fatal("超寬的行沒有被折行")
+	}
+	if !bytes.Equal(bytes.ReplaceAll(it.Orig, []byte{0x0A}, nil), plain) {
+		t.Error("折行只能插入 0x0A，不能改動其他位元組")
+	}
+	in := budget.Input{ID: "ESPMES#121.1", File: "ESPMES.MRG", Class: ClassWin31x4, Orig: w.parsedItem("ESPMES#121.1"), Trans: plain}
+	wrapped, vs := budget.AutoWrap(in)
+	if len(vs) != 0 || !bytes.Equal(it.Orig, wrapped) {
+		t.Errorf("寫出的位元組不等於 AutoWrap 的結果（違規 %v）", vs)
+	}
+	in.Trans = it.Orig
+	if vs := budget.Check(in); len(vs) != 0 {
+		t.Errorf("寫出的位元組沒有通過 Check：%v", vs)
+	}
