+		t.Errorf("COUNTRY.MES 預設應拒絕並點名旗標：%v", err)
+	}
+	_, err = Build(w.cfg(t.TempDir(), w.tableDir(shop), ModeTable, Policy{}))
+	if err == nil || !strings.Contains(err.Error(), "SHOPTAB.TBL") || !strings.Contains(err.Error(), "-allow-shoptab") {
+		t.Errorf("SHOPTAB.TBL 預設應拒絕並點名旗標：%v", err)
