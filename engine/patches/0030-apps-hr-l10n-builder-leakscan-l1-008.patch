+type synthOrig struct {
+	dir    string
+	hashes map[string]string
+	cs     *l10n.Charmap
+}
+
+func (s *synthOrig) enc(t *testing.T, text string) string {
+	t.Helper()
+	b, _, err := s.cs.Encode(text)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
