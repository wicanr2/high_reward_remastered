diff --git a/apps/hr/l10n/charmap.go b/apps/hr/l10n/charmap.go
new file mode 100644
index 0000000..67a1fc3
--- /dev/null
+++ b/apps/hr/l10n/charmap.go
@@ -0,0 +1,280 @@
+package l10n
+
+import (
+	_ "embed"
+	"fmt"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"golang.org/x/text/encoding/traditionalchinese"
+)
+
+// charmapTSV 是原版已用字的 Unicode 對 Big5 碼一對一表：兩欄 unicode、big5（十六進位，大寫），
+// 依 unicode 由小到大，只有單字，沒有文句（docs/spec/008 第 1 節）。產生方法見 GenerateCharmap。
+//
+//go:embed data/charmap-zh-TW.tsv
+var charmapTSV []byte
+
+const charmapHeader = "unicode\tbig5"
+
+// Charmap 是 zh-TW 的轉碼表：沿用原版 Big5 碼與原版字模，字集限於表內（docs/spec/008 第 3.4、3.5 節）。
+type Charmap struct {
+	toBig   map[rune]uint16
+	fromBig map[uint16]rune
+}
+
+// LoadCharmap 讀 go:embed 的 data/charmap-zh-TW.tsv，並逐碼與 golang.org/x/text 的 Big5 解碼核對。
+func LoadCharmap() (*Charmap, error) { return parseCharmap(charmapTSV, true) }
+
+// big5Rune 以 x/text 的 Big5 解碼一個雙位元組碼；解不出單一字（含 U+FFFD）回 false。
+func big5Rune(code uint16) (rune, bool) {
+	b, err := traditionalchinese.Big5.NewDecoder().Bytes([]byte{byte(code >> 8), byte(code)})
+	if err != nil {
+		return 0, false
+	}
+	r, n := utf8.DecodeRune(b)
+	if r == utf8.RuneError || n != len(b) {
+		return 0, false
+	}
+	return r, true
+}
+
+// validBig5Code 判斷碼是否在原版使用的 Big5 範圍：lead A1 至 F9，trail 40 至 7E 或 A1 至 FE。
+func validBig5Code(code uint16) bool {
+	lead, trail := byte(code>>8), byte(code)
+	return lead >= 0xA1 && lead <= 0xF9 && (trail >= 0x40 && trail <= 0x7E || trail >= 0xA1 && trail <= 0xFE)
+}
+
+// parseCharmap 解析 TSV。verify 為真時逐碼用 x/text 核對 Unicode 與 Big5 碼互為解碼結果。
+func parseCharmap(b []byte, verify bool) (*Charmap, error) {
+	lines := strings.Split(strings.TrimSuffix(string(b), "\n"), "\n")
+	if strings.TrimSuffix(lines[0], "\r") != charmapHeader {
+		return nil, fmt.Errorf("charmap：第 1 行表頭應為 %q", charmapHeader)
+	}
+	c := &Charmap{toBig: make(map[rune]uint16, len(lines)), fromBig: make(map[uint16]rune, len(lines))}
+	prev := rune(-1)
+	for i, ln := range lines[1:] {
+		no := i + 2
+		f := strings.Split(strings.TrimSuffix(ln, "\r"), "\t")
+		if len(f) != 2 {
+			return nil, fmt.Errorf("charmap 第 %d 行：應為兩欄 unicode<TAB>big5", no)
+		}
+		u, err := strconv.ParseUint(f[0], 16, 32)
+		if err != nil || u < 0x80 || !utf8.ValidRune(rune(u)) {
+			return nil, fmt.Errorf("charmap 第 %d 行：unicode 欄不是合法的非 ASCII 碼位", no)
+		}
+		bg, err := strconv.ParseUint(f[1], 16, 16)
+		if err != nil || !validBig5Code(uint16(bg)) {
+			return nil, fmt.Errorf("charmap 第 %d 行：big5 欄不是合法的雙位元組碼", no)
+		}
+		r, code := rune(u), uint16(bg)
+		if r <= prev {
+			return nil, fmt.Errorf("charmap 第 %d 行：unicode 欄必須由小到大且不重複", no)
+		}
+		prev = r
+		if _, dup := c.fromBig[code]; dup {
+			return nil, fmt.Errorf("charmap 第 %d 行：big5 碼 %04X 重複", no, code)
+		}
+		if verify {
+			if dr, ok := big5Rune(code); !ok || dr != r {
+				return nil, fmt.Errorf("charmap 第 %d 行：big5 碼 %04X 經 x/text 解碼不是 U+%04X", no, code, r)
+			}
+		}
+		c.toBig[r] = code
+		c.fromBig[code] = r
+	}
+	return c, nil
+}
+
+// Len 回傳字數。
+func (c *Charmap) Len() int { return len(c.toBig) }
+
+// Big5 回傳字的 Big5 碼；字不在字集內回 false。
+func (c *Charmap) Big5(r rune) (uint16, bool) {
+	code, ok := c.toBig[r]
+	return code, ok
+}
+
+// Rune 回傳 Big5 碼對應的字；碼不在字集內回 false。
+func (c *Charmap) Rune(code uint16) (rune, bool) {
+	r, ok := c.fromBig[code]
+	return r, ok
+}
+
+// PercentSpecLen 回傳 s 開頭（必須是 '%'）的 printf 轉換規格的位元組長度，不是合法規格回 0。
+// 規格：`%` 旗標（`-+#0`）寬度 [`.`精度] [長度修飾 `l`、`h`、`L`] 型別（`diuoxXcs`）。
+// 原版出現的只有 `%s`、`%d`、`%ld`、`%1d`、`%2d`、`%02d`、`%03d`、`%4d`、`%10ld`（docs/re/020、024）。
+// `%%` 不是合法規格：半形 `%` 在原版字模畫成空白（docs/re/020 第 3.3 節）。
+func PercentSpecLen(s string) int {
+	if len(s) < 2 || s[0] != '%' {
+		return 0
+	}
+	i := 1
+	digits := func() int {
+		n := 0
+		for i < len(s) && s[i] >= '0' && s[i] <= '9' {
+			i++
+			n++
+		}
+		return n
+	}
+	for i < len(s) && strings.IndexByte("-+#0", s[i]) >= 0 {
+		i++
+	}
+	digits()
+	if i < len(s) && s[i] == '.' {
+		i++
+		if digits() == 0 {
+			return 0
+		}
+	}
+	if i < len(s) && strings.IndexByte("lhL", s[i]) >= 0 {
+		i++
+	}
+	if i < len(s) && strings.IndexByte("diuoxXcs", s[i]) >= 0 {
+		return i + 1
+	}
+	return 0
+}
+
+// percentSpecs 依序取出位元組內的 `%` 轉換規格（文字，見 PercentSpecLen）。不是合法規格的 `%` 略過；
+// 雙位元組字（lead >= 0xA1）整組跳過（Big5 的 trail 不會是 0x25，跳過只是不去讀字的內部）。
+// SHOPTAB 名稱欄的佔位符規則（Adopt）與 fixture 產生器共用。
+func percentSpecs(b []byte) []string {
+	var out []string
+	for i := 0; i < len(b); {
+		c := b[i]
+		switch {
+		case c == '%':
+			n := PercentSpecLen(string(b[i:min(i+16, len(b))]))
+			if n == 0 {
+				i++
+				continue
+			}
+			out = append(out, string(b[i:i+n]))
+			i += n
+		case c >= 0xA1 && i+1 < len(b):
+			i += 2
+		default:
+			i++
+		}
+	}
+	return out
+}
+
+// singleByteOK 是單位元組白名單：數字、`/`、`:`、大寫字母（docs/spec/008 第 3.5 節，docs/re/020 第 3.3 節）。
+func singleByteOK(r rune) bool {
+	return r >= '0' && r <= '9' || r >= 'A' && r <= 'Z' || r == '/' || r == ':'
+}
+
+// Encode 把 UTF-8 譯文轉成位元組：
+//   - `\n` 轉 0x0A；
+//   - 單位元組白名單（數字、`/`、`:`、大寫字母）原樣；
+//   - `%` 轉換規格（`%s`、`%d`、`%ld`、`%03d` 等，見 PercentSpecLen）原樣；
+//   - 其餘每個字必須在字集內，轉為 Big5 雙位元組；
+//
+// 不在字集、或往返（碼解回原字）不符的字記入 badRunes（只回報碼位，不回報文句，去重並依首次出現順序）。
+// 不合法的 `%` 序列也算失敗。有任何失敗時 b 為 nil，err 非 nil。
+func (c *Charmap) Encode(text string) (b []byte, badRunes []rune, err error) {
+	rs := []rune(text)
+	out := make([]byte, 0, len(text))
+	seen := make(map[rune]bool)
+	var badPct []int
+	for i := 0; i < len(rs); {
+		r := rs[i]
+		switch {
+		case r == '\n':
+			out = append(out, 0x0A)
+			i++
+		case r == '%':
+			j := min(i+16, len(rs))
+			n := PercentSpecLen(string(rs[i:j]))
+			if n == 0 {
+				badPct = append(badPct, i)
+				i++
+				continue
+			}
+			for k := 0; k < n; k++ {
+				out = append(out, byte(rs[i+k]))
+			}
+			i += n
+		case singleByteOK(r):
+			out = append(out, byte(r))
+			i++
+		default:
+			code, ok := c.toBig[r]
+			if !ok || c.fromBig[code] != r {
+				if !seen[r] {
+					seen[r] = true
+					badRunes = append(badRunes, r)
+				}
+				i++
+				continue
+			}
+			out = append(out, byte(code>>8), byte(code))
+			i++
+		}
+	}
+	if len(badRunes) > 0 || len(badPct) > 0 {
+		var parts []string
+		if len(badRunes) > 0 {
+			cps := make([]string, len(badRunes))
+			for k, r := range badRunes {
+				cps[k] = fmt.Sprintf("U+%04X", r)
+			}
+			parts = append(parts, "字集外的字 "+strings.Join(cps, " "))
+		}
+		if len(badPct) > 0 {
+			ps := make([]string, len(badPct))
+			for k, p := range badPct {
+				ps[k] = strconv.Itoa(p)
+			}
+			parts = append(parts, "不合法的 % 序列（字元位置 "+strings.Join(ps, "、")+"）")
+		}
+		return nil, badRunes, fmt.Errorf("l10n: %s", strings.Join(parts, "；"))
+	}
+	return out, nil, nil
+}
+
+// Decode 把原版位元組轉成 UTF-8（建置報告與匯出用）：0x0A 轉 `\n`，0x20 至 0x7E 原樣，
+// Big5 雙位元組字轉成對應的字（表內查不到時用 x/text 解碼）。
+// 無法解碼的位元組（孤立的高位元組、其他控制碼、不合法的雙位元組）以 `<XX>` 十六進位標示，
+// 此時 err 非 nil，但回傳的字串仍可用於顯示。
+func (c *Charmap) Decode(b []byte) (string, error) {
+	var sb strings.Builder
+	bad := 0
+	for i := 0; i < len(b); {
+		x := b[i]
+		switch {
+		case x == 0x0A:
+			sb.WriteByte('\n')
+			i++
+		case x >= 0x20 && x <= 0x7E:
+			sb.WriteByte(x)
+			i++
+		case i+1 < len(b) && validBig5Code(uint16(x)<<8|uint16(b[i+1])):
+			code := uint16(x)<<8 | uint16(b[i+1])
+			r, ok := c.fromBig[code]
+			if !ok {
+				r, ok = big5Rune(code)
+			}
+			if ok {
+				sb.WriteRune(r)
+				i += 2
+				continue
+			}
+			fmt.Fprintf(&sb, "<%02X>", x)
+			bad++
+			i++
+		default:
+			fmt.Fprintf(&sb, "<%02X>", x)
+			bad++
+			i++
+		}
+	}
+	if bad > 0 {
+		return sb.String(), fmt.Errorf("l10n: %d 個位元組無法解碼，以 <XX> 標示", bad)
+	}
+	return sb.String(), nil
+}
diff --git a/apps/hr/l10n/charmap_extra_test.go b/apps/hr/l10n/charmap_extra_test.go
new file mode 100644
index 0000000..44e9fbd
--- /dev/null
+++ b/apps/hr/l10n/charmap_extra_test.go
@@ -0,0 +1,77 @@
+package l10n
+
+import (
+	"strings"
+	"testing"
+)
+
+// 審查 S8：對字集內全部字與白名單逐字編碼，輸出位元組必須落在
+// {lead A1 至 F9 加 trail 40 至 7E 或 A1 至 FE 的雙位元組、白名單單位元組}，所以永遠不會產生
+// 0x00、0x20、0x7F、單位元組小寫或標點。
+func TestCharmapEncodeOutputProperty(t *testing.T) {
+	cs := mustCharmap(t)
+	whitelist := "0123456789/:ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+	inWhitelist := func(b byte) bool { return strings.IndexByte(whitelist, b) >= 0 }
+	var all strings.Builder
+	n := 0
+	for r, code := range cs.toBig {
+		b, bad, err := cs.Encode(string(r))
+		if err != nil || len(bad) != 0 {
+			t.Fatalf("U+%04X：%v %v", r, err, bad)
+		}
+		if len(b) != 2 || uint16(b[0])<<8|uint16(b[1]) != code || !validBig5Code(code) {
+			t.Fatalf("U+%04X 編碼成 %X，應為雙位元組 %04X", r, b, code)
+		}
+		for _, x := range b {
+			if x == 0x00 || x == 0x20 || x == 0x0A || x == 0x7F {
+				t.Fatalf("U+%04X 的輸出含不該出現的位元組 %02X", r, x)
+			}
+		}
+		all.WriteRune(r)
+		n++
+	}
+	if n != 1716 {
+		t.Fatalf("字集 %d 字", n)
+	}
+	for _, c := range whitelist {
+		b, _, err := cs.Encode(string(c))
+		if err != nil || len(b) != 1 || b[0] != byte(c) || !inWhitelist(b[0]) {
+			t.Errorf("白名單 %q：%X %v", c, b, err)
+		}
+	}
+	// 整串（全部 1716 字加白名單加換行）：長度 ＝ 2 x 1716 ＋ 白名單 ＋ 1，且每個位元組都合法。
+	text := all.String() + whitelist + "\n"
+	b, bad, err := cs.Encode(text)
+	if err != nil || len(bad) != 0 {
+		t.Fatalf("整串：%v %v", err, bad)
+	}
+	if want := 2*1716 + len(whitelist) + 1; len(b) != want {
+		t.Fatalf("整串輸出 %d bytes，應為 %d", len(b), want)
+	}
+	for i := 0; i < len(b); {
+		x := b[i]
+		switch {
+		case x == 0x0A || inWhitelist(x):
+			i++
+		case i+1 < len(b) && validBig5Code(uint16(x)<<8|uint16(b[i+1])):
+			i += 2
+		default:
+			t.Fatalf("整串輸出的位移 %d 的位元組 %02X 不在 {雙位元組、白名單、0x0A} 內", i, x)
+		}
+	}
+}
+
+// 審查 S8：U+0000 與 U+007F 是字集外的字。
+func TestCharmapEncodeRejectsControlRunes(t *testing.T) {
+	cs := mustCharmap(t)
+	for _, s := range []string{"\x00", "\x7f", "A\x00B", "一\x7f二", "\x01", "\x1f"} {
+		b, bad, err := cs.Encode(s)
+		if err == nil || b != nil || len(bad) == 0 {
+			t.Errorf("Encode(%q) 應失敗：b %X bad %U err %v", s, b, bad, err)
+		}
+	}
+	_, bad, _ := cs.Encode("\x00\x7f")
+	if string(bad) != "\x00\x7f" {
+		t.Errorf("badRunes ＝ %U", bad)
+	}
+}
