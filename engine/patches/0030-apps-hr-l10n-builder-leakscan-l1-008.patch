+// 持續失敗：重試 3 次（共 4 次嘗試）之後回錯，錯誤可由 errors.Is 取回原因，不留暫存目錄也不留語言包。
+func TestBuildRenamePersistentFailureGivesUp(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	cfg := poolCfg(w, root)
+	boom := errors.New("access denied")
+	attempts, slept := 0, 0
+	cfg.hooks = &buildHooks{
+		rename: func(oldp, newp string) error { attempts++; return boom },
+		sleep:  func(time.Duration) { slept++ },
+	}
+	_, err := Build(cfg)
+	if !errors.Is(err, boom) {
+		t.Fatalf("應回改名的原因：%v", err)
+	}
+	if attempts != 4 || slept != 3 {
+		t.Errorf("改名嘗試 %d 次、等待 %d 次，應為 4 次（第一次加 3 次重試）與 3 次", attempts, slept)
+	}
+	if got := packEntries(t, root); len(got) != 0 {
+		t.Errorf("失敗之後包根下有 %v", got)
+	}
+}
