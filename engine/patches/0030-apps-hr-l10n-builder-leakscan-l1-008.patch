+	collect := func(rs []rune, join bool) []string {
+		var out []string
+		runsOf(rs, join, nil, func(run []rune) { out = append(out, string(run)) })
+		return out
+	}
+	str := func(parts ...any) []rune {
+		var out []rune
+		for _, p := range parts {
+			switch v := p.(type) {
+			case []rune:
+				out = append(out, v...)
+			case string:
+				out = append(out, []rune(v)...)
+			}
+		}
+		return out
+	}
+	sa, sb, sc := string(a), string(b), string(c)
+	pr := string(punctRune)
+	for _, tc := range []struct {
+		name string
+		in   []rune
+		join bool
+		want []string
+	}{
+		{"連接：標記去掉", str(a, "**", b), true, []string{sa + sb}},
+		{"切開：標記分隔", str(a, "**", b), false, []string{sa, sb}},
+		{"英數一律切開", str(a, "x1", b), true, []string{sa, sb}},
+		{"頭尾標點去掉", str(",", a, cp(0x3002)), true, []string{sa}},
+		{"內部標點保留並統一", str(a, cp(0xff0c), b), true, []string{sa + pr + sb}},
+		{"半形逗號同樣統一", str(a, ",", b), true, []string{sa + pr + sb}},
+		{"全形英數是片段成員（不統一成半形）", str(a, cp(0xff21), b), true, []string{sa + cp(0xff21) + sb}},
+		{"半形英數切斷片段", str(a, "A", b), true, []string{sa, sb}},
+		{"原版不可能有的字元切斷", str(a, cp(0x1F600), b), true, []string{sa, sb}},
+		{"跳脫換行：連接", str(a, `\n`, b), true, []string{sa + sb}},
+		{"跳脫換行：切開", str(a, `\n`, b), false, []string{sa, sb}},
