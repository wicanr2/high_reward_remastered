+// 手造一個語言包（不需要真原版）：manifest 記錄 origInputs 當作原版輸入雜湊，files/ 只有一個檔。回傳包根。
+func writeSyntheticPack(t *testing.T, origInputs map[string]string) string {
+	t.Helper()
+	root := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(root, verify.FilesDir), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	body := []byte("synthetic pack body")
+	if err := os.WriteFile(filepath.Join(root, verify.FilesDir, "SP.MES"), body, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	m := &verify.Manifest{
+		Format: verify.ManifestFormat, Code: "zh-TW", Policy: verify.Policy{Mode: "identity"},
+		Files:      []verify.FileEntry{{Name: "SP.MES", SHA256: sum(body), Size: int64(len(body))}},
+		OrigInputs: origInputs, TableHash: sum(nil), TableFormat: l10n.TableFormat, BuilderVersion: "synthetic",
+		InputDigest: strings.Repeat("0", 64),
+	}
+	raw, err := m.Marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, verify.ManifestName), raw, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return root
+}
