+package l10n
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// `l10nBuilderVersion` 守護（docs/spec/008 第 3.2 節、第 8 節建置原子性與重用列）。
+//
+// golden 是機器產生的文字檔（data/builder-golden.txt，go:embed）：合成譯文表 fixture 在 table 模式、以使用者原版建出的
+// 四個變體（預設、-with-candidates、-allow-country-offsets、-allow-shoptab）各列：
+//
+//	[變體名]
+//	adopted=<採用列數>
+//	manifest=<manifest 去掉建置器版本與輸入摘要之後的 SHA-256>
+//	<檔名>=<files/ 內該檔的 SHA-256>        依檔名排序，八個檔
+//
+// 無註解、LF、固定排序。建置器版本是 golden 位元組的 SHA-256 前 8 碼：建置輸出一改變，golden 就必須重產，
+// 版本隨之改變；不可能只重產 golden 而保留舊版本。
+// identity 包的輸出恆等於原檔、manifest 含版本，兩者都不能當黃金值（所以 golden 用 fixture 的 table 模式輸出）。
+//
+// 重寫 golden：`HR_L10N_UPDATE_GOLDEN=1 go test -run TestGolden ./apps/hr/l10n/`（需要原版）。
+// golden 是編譯時內嵌的：重寫之後要重新編譯（再跑一次測試）Version() 才會跟著變。
+
+const goldenPath = "data/builder-golden.txt"
+
+// computeGolden 建四個變體並產生 golden 文字。
+func computeGolden(t testing.TB, origDir string) []byte {
+	t.Helper()
+	var sb strings.Builder
+	for _, v := range goldenVariants {
+		res := buildVariant(t, origDir, v)
+		m := *res.Manifest
+		m.BuilderVersion, m.InputDigest = "", ""
+		raw, err := m.Marshal()
+		if err != nil {
+			t.Fatal(err)
+		}
+		fmt.Fprintf(&sb, "[%s]\nadopted=%d\nmanifest=%s\n", v.name, res.Manifest.Adopted, sha256Hex(raw))
+		ents, err := os.ReadDir(res.FilesDir())
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, e := range ents { // ReadDir 依檔名排序
+			fmt.Fprintf(&sb, "%s=%s\n", e.Name(), sha256Hex(packFile(t, res.Dir, e.Name())))
+		}
+	}
+	return []byte(sb.String())
+}
+
+// goldenFirstDiff 回傳兩份 golden 第一個不同的行（空字串表示相同）。行只含變體名、計數與雜湊。
+func goldenFirstDiff(got, want []byte) string {
+	if bytes.Equal(got, want) {
+		return ""
+	}
+	g, w := strings.Split(string(got), "\n"), strings.Split(string(want), "\n")
+	for i := 0; i < len(g) || i < len(w); i++ {
+		var a, b string
+		if i < len(g) {
+			a = g[i]
+		}
+		if i < len(w) {
+			b = w[i]
+		}
+		if a != b {
+			return fmt.Sprintf("第 %d 行：輸出 %q，golden %q", i+1, a, b)
+		}
+	}
+	return "長度不同"
+}
+
+func TestGolden(t *testing.T) {
+	origDir := origDirOrSkip(t)
+	got := computeGolden(t, origDir)
+	if os.Getenv("HR_L10N_UPDATE_GOLDEN") == "1" {
+		if err := os.WriteFile(goldenPath, got, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		t.Logf("已重寫 %s（%d bytes），新的建置器版本是 %s（重新編譯後生效）", goldenPath, len(got), versionOf(got))
+		return
+	}
+	if d := goldenFirstDiff(got, builderGolden); d != "" {
+		t.Fatalf("建置輸出與內嵌的 golden 不符（%s）。建置輸出改變就必須重產 golden（HR_L10N_UPDATE_GOLDEN=1），版本隨之改變", d)
+	}
+	// 同一輸入再建一次：結果相同（golden 不是偶然）
+	if d := goldenFirstDiff(computeGolden(t, origDir), got); d != "" {
+		t.Errorf("同一輸入兩次建置的 golden 不同：%s", d)
+	}
+}
+
+// golden 與版本的形狀（不需要原版）。
+func TestGoldenFormat(t *testing.T) {
+	g := string(builderGolden)
+	if g == "" || g[len(g)-1] != '\n' || strings.Contains(g, "\r") {
+		t.Fatal("golden 應非空、以 LF 結尾、不含 CR")
+	}
+	hex64 := regexp.MustCompile(`^[0-9a-f]{64}$`)
+	lines := strings.Split(strings.TrimSuffix(g, "\n"), "\n")
+	adopted := map[string]int{}
+	i := 0
+	for _, v := range goldenVariants {
+		if i >= len(lines) || lines[i] != "["+v.name+"]" {
+			t.Fatalf("第 %d 行應為變體標頭 [%s]（變體固定順序）", i+1, v.name)
+		}
+		i++
+		k, val, ok := strings.Cut(lines[i], "=")
+		n, err := strconv.Atoi(val)
+		if !ok || k != "adopted" || err != nil || n <= 0 {
+			t.Fatalf("第 %d 行應為 adopted=<正整數>：%q", i+1, lines[i])
+		}
+		adopted[v.name] = n
+		i++
+		if k, val, ok := strings.Cut(lines[i], "="); !ok || k != "manifest" || !hex64.MatchString(val) {
+			t.Fatalf("第 %d 行應為 manifest=<SHA-256>：%q", i+1, lines[i])
+		}
+		i++
+		for _, name := range packNames {
+			if i >= len(lines) {
+				t.Fatal("golden 被截斷")
+			}
+			k, val, ok := strings.Cut(lines[i], "=")
+			if !ok || k != name || !hex64.MatchString(val) {
+				t.Fatalf("第 %d 行應為 %s=<SHA-256>（依檔名排序）：%q", i+1, name, lines[i])
+			}
+			if name == "CFONT.15" { // L1 的 CFONT.15 是原版的逐位元組複本
+				h, err := requiredInputHashes()
+				if err != nil || val != h["CFONT.15"] {
+					t.Errorf("%s 的 CFONT.15 雜湊應等於 required.tsv 的值", v.name)
+				}
+			}
+			i++
+		}
+	}
+	if i != len(lines) {
+		t.Errorf("golden 多出 %d 行", len(lines)-i)
+	}
+	if strings.Contains(g, "#") {
+		t.Error("golden 不應有註解")
+	}
+	// 採用列數的關係：with-candidates 多於預設；兩個 allow 變體各多於預設
+	if !(adopted["with-candidates"] > adopted["default"] && adopted["allow-country-offsets"] > adopted["default"] && adopted["allow-shoptab"] > adopted["default"]) {
+		t.Errorf("各變體的採用列數不符預期：%v", adopted)
+	}
+}
+
+// 版本由 golden 位元組導出；golden 內容改一個位元組，版本必須不同。
+func TestBuilderVersionDerivedFromGolden(t *testing.T) {
+	v := Version()
+	if !regexp.MustCompile(`^[0-9a-f]{8}$`).MatchString(v) || v != versionOf(builderGolden) {
+		t.Fatalf("Version() ＝ %q，應為 golden 位元組 SHA-256 的前 8 碼 %s", v, versionOf(builderGolden))
+	}
+	if v != sha256Hex(builderGolden)[:8] {
+		t.Error("版本不是 SHA-256 的前 8 碼")
+	}
+	for i := 0; i < len(builderGolden); i += max(1, len(builderGolden)/50) {
+		mod := bytes.Clone(builderGolden)
+		mod[i] ^= 0x01
+		if versionOf(mod) == v {
+			t.Errorf("golden 第 %d 個位元組改一個位元，版本沒有改變", i)
+		}
+	}
+	// 追加一個位元組也改變版本
+	if versionOf(append(bytes.Clone(builderGolden), '\n')) == v {
+		t.Error("golden 追加一個位元組，版本沒有改變")
+	}
+	// 建置器版本進 manifest 與輸入摘要
+	w := newSynthWorld(t)
+	res := mustBuild(t, w.cfg(t.TempDir(), "", ModeIdentity, Policy{}))
+	if res.Manifest.BuilderVersion != v {
+		t.Errorf("manifest 的建置器版本 %q，應為 %q", res.Manifest.BuilderVersion, v)
+	}
+}
+
+// 比較器不是恆真：輸出改一個位元組，golden 比對必須失敗（比較器本身的驗證；
+// 「改序列化器一個位元組」的突變驗證在報告的突變表）。
+func TestGoldenComparerDetectsChange(t *testing.T) {
+	if d := goldenFirstDiff(builderGolden, builderGolden); d != "" {
+		t.Fatalf("相同的 golden 判為不同：%s", d)
+	}
+	for i := 0; i < len(builderGolden); i += max(1, len(builderGolden)/40) {
+		if builderGolden[i] == '\n' {
+			continue
+		}
+		mod := bytes.Clone(builderGolden)
+		mod[i] ^= 0x01
+		if goldenFirstDiff(mod, builderGolden) == "" {
+			t.Errorf("改第 %d 個位元組，比較器沒有發現", i)
+		}
+	}
+	if goldenFirstDiff(builderGolden[:len(builderGolden)-1], builderGolden) == "" {
+		t.Error("截斷一個位元組，比較器沒有發現")
+	}
+}
diff --git a/apps/hr/l10n/helpers_test.go b/apps/hr/l10n/helpers_test.go
new file mode 100644
index 0000000..622c3b5
--- /dev/null
+++ b/apps/hr/l10n/helpers_test.go
@@ -0,0 +1,168 @@
+package l10n
+
+import (
+	"bytes"
+	"encoding/binary"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// 原版素材不在本儲存庫：缺檔就 skip，不用替代檔（CLAUDE.md [HARD]）。
+// 原版目錄取 HR_ORIG，預設 /orig/orig；缺任何一個要用的檔就 skip。
+func readOrig(t testing.TB, names ...string) map[string][]byte {
+	t.Helper()
+	root := os.Getenv("HR_ORIG")
+	if root == "" {
+		root = "/orig/orig"
+	}
+	out := make(map[string][]byte, len(names))
+	for _, n := range names {
+		b, err := os.ReadFile(filepath.Join(root, n))
+		if err != nil {
+			t.Skipf("沒有原版檔案（%s）：%v", filepath.Join(root, n), err)
+		}
+		out[n] = b
+	}
+	return out
+}
+
+// 七個資料檔。
+func readOrigData(t testing.TB) map[string][]byte { return readOrig(t, dataFileNames...) }
+
+func le16(v int) []byte { return binary.LittleEndian.AppendUint16(nil, uint16(v)) }
+func le32(v int) []byte { return binary.LittleEndian.AppendUint32(nil, uint32(v)) }
+
+// buildMES 以獨立於套件序列化器的寫法造 `*.MES` 位元組（合成測試用）。
+// bias > 0：偏移 bias 起（含末偏移）多 2。
+func buildMES(items []string, bias int) []byte {
+	k := len(items) + 1
+	var out []byte
+	out = append(out, le16(k)...)
+	pos := 2 + 4*k
+	for i := 0; i < k; i++ {
+		o := pos
+		if bias > 0 && i >= bias {
+			o += 2
+		}
+		out = append(out, le32(o)...)
+		if i < len(items) {
+			pos += len(items[i]) + 1
+		}
+	}
+	for _, it := range items {
+		out = append(out, it...)
+		out = append(out, 0)
+	}
+	return append(out, 0xFF)
+}
+
+// buildESP 造 ESPMES.MRG：外層有 ng 個群組（N ＝ ng + 1），groups 的鍵是群組索引，值是該群組的項目；
+// 沒列出的群組是空群組，偏移取下一個非空群組的起點（最後一個之後取檔尾）。
+func buildESP(ng int, groups map[int][]string) []byte {
+	gb := make([][]byte, ng)
+	for g, items := range groups {
+		n2 := len(items) + 1
+		var b []byte
+		b = append(b, le16(n2)...)
+		pos := 2 + 4*n2
+		for j := 0; j < n2; j++ {
+			b = append(b, le32(pos)...)
+			if j < len(items) {
+				pos += len(items[j]) + 1
+			}
+		}
+		for _, it := range items {
+			b = append(b, it...)
+			b = append(b, 0)
+		}
+		b = append(b, 0xFF)
+		gb[g] = b
+	}
+	starts := make([]int, ng)
+	pos := 2 + 4*ng
+	for g := 0; g < ng; g++ {
+		starts[g] = pos
+		pos += len(gb[g])
+	}
+	var out []byte
+	out = append(out, le16(ng+1)...)
+	for _, s := range starts {
+		out = append(out, le32(s)...)
+	}
+	for _, b := range gb {
+		out = append(out, b...)
+	}
+	return out
+}
+
+// buildShop 造 SHOPTAB.TBL：每筆記錄 8 個欄位，names 依序填入（不足的欄位填空白名稱），
+// 名稱補 0x20 到 20 bytes，其後 00，再接 4 bytes tail（固定樣式，可由 tailOf 取回）。
+func buildShop(records int, names []string) []byte {
+	var out []byte
+	idx := 0
+	for r := 0; r < records; r++ {
+		for f := 0; f < 8; f++ {
+			name := ""
+			if idx < len(names) {
+				name = names[idx]
+			}
+			idx++
+			b := []byte(name)
+			for len(b) < 20 {
+				b = append(b, 0x20)
+			}
+			out = append(out, b...)
+			out = append(out, 0x00, byte(r), byte(f), 0x5A, 0xA5)
+		}
+	}
+	return out
+}
+
+func cloneBytes(b []byte) []byte { return bytes.Clone(b) }
+
+// 在測試用的字集內挑的字（原版已用字，單字）：一、二、三、上、下。
+const (
+	t1 = "一"
+	t2 = "二"
+	t3 = "三"
+	t4 = "上"
+	t5 = "下"
+)
+
+func mustParse(t testing.TB, name string, data []byte) *File {
+	t.Helper()
+	f, err := Parse(name, data)
+	if err != nil {
+		t.Fatalf("Parse(%s)：%v", name, err)
+	}
+	return f
+}
+
+func mustSerialize(t testing.TB, f *File, repl map[string][]byte, opt SerializeOptions) []byte {
+	t.Helper()
+	b, err := f.Serialize(repl, opt)
+	if err != nil {
+		t.Fatalf("Serialize(%s)：%v", f.Name, err)
+	}
+	return b
+}
+
+func mustCharmap(t testing.TB) *Charmap {
+	t.Helper()
+	cs, err := LoadCharmap()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return cs
+}
+
+func containsAll(s string, subs ...string) bool {
+	for _, x := range subs {
+		if !strings.Contains(s, x) {
+			return false
+		}
+	}
+	return true
+}
diff --git a/apps/hr/l10n/l10n.go b/apps/hr/l10n/l10n.go
new file mode 100644
index 0000000..91cb3ee
--- /dev/null
+++ b/apps/hr/l10n/l10n.go
@@ -0,0 +1,201 @@
+// Package l10n 是《高報酬戰將》遊戲內文字多語系的檔案格式、譯文表與轉碼（docs/spec/008 第 3.3、3.5 節）。
+//
+// 套件只認資料格式，不含任何原版文字或位址：
+//   - 七個資料檔（COUNTRY.MES、SP.MES、SYSTEM.MES、UWASA.MES、POWERMES.MES、ESPMES.MRG、SHOPTAB.TBL）
+//     的解析與序列化（Parse、File.Serialize）；
+//   - 譯文表 TSV（LoadTable、Table.Save）與採用規則（Table.Adopt）；
+//   - zh-TW 沿用原版 Big5 碼的轉碼（Charmap）；
+//   - ESPMES 項目的窗口類別（ESPWindowClass）。
+//
+// 預算檢查、1676 模擬器、manifest、洩漏掃描都在別的套件；預算檢查經 Checker 由呼叫端注入。
+package l10n
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"path"
+	"strings"
+)
+
+// Kind 是檔案的格式種類。零值是 KindMES。
+type Kind int
+
+const (
+	// KindMES 是偏移表精確的 `*.MES`（SP、SYSTEM、UWASA、POWERMES）。
+	KindMES Kind = iota
+	// KindCountry 是 COUNTRY.MES：偏移表從某一項起多 2。
+	KindCountry
+	// KindESP 是 ESPMES.MRG（兩層表）。
+	KindESP
+	// KindShop 是 SHOPTAB.TBL（99 x 200 bytes 的固定記錄）。
+	KindShop
+)
+
+// String 回傳種類名稱，供錯誤訊息使用。
+func (k Kind) String() string {
+	switch k {
+	case KindMES:
+		return "MES"
+	case KindCountry:
+		return "COUNTRY"
+	case KindESP:
+		return "ESP"
+	case KindShop:
+		return "SHOP"
+	}
+	return fmt.Sprintf("Kind(%d)", int(k))
+}
+
+// Item 是檔案內一個可翻譯的實體項目。
+type Item struct {
+	// ID：`*.MES` 為 `<檔名>#<索引>`；ESPMES 為 `ESPMES#<群組>.<子>`；SHOPTAB 為 `SHOPTAB#<記錄>.<欄位>`。
+	ID string
+	// Orig 是原項目位元組：以 NUL 切出，去掉結尾 NUL，保留內部 0x0A。SHOPTAB 為 20 bytes 欄位（含補白）。
+	Orig []byte
+}
+
+// File 是解析後的資料檔。序列化一律由 Items 重建，不回傳快取的原始位元組。
+type File struct {
+	Name  string // 大寫檔名，例如 "SP.MES"
+	Kind  Kind
+	Items []Item
+
+	index map[string]int // ID 到 Items 的位置
+
+	// COUNTRY.MES：偏移表從第幾個偏移（0 起算）起比實際起點大 countryBiasAmount；0 表示沒有偏差。
+	countryBias int
+	// ESPMES.MRG：外層群組（偏移表的 N - 1 項）。
+	espGroups []espGroup
+	// SHOPTAB.TBL：原始位元組，當作名稱欄以外 5 bytes 的樣板。
+	shopRaw []byte
+}
+
+// countryBiasAmount 是 COUNTRY.MES 偏移表偏差的大小（docs/re/020 第 2.2 節，confirmed）。
+const countryBiasAmount = 2
+
+// 資料檔名稱。
+var dataFileNames = []string{
+	"COUNTRY.MES", "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES", "ESPMES.MRG", "SHOPTAB.TBL",
+}
+
+// Parse 解析七個資料檔之一；name 大小寫不分。格式不符回錯。
+func Parse(name string, data []byte) (*File, error) {
+	n := strings.ToUpper(path.Base(strings.ReplaceAll(name, "\\", "/")))
+	var (
+		f   *File
+		err error
+	)
+	switch n {
+	case "COUNTRY.MES":
+		f, err = parseMES(n, KindCountry, data)
+	case "SP.MES", "SYSTEM.MES", "UWASA.MES", "POWERMES.MES":
+		f, err = parseMES(n, KindMES, data)
+	case "ESPMES.MRG":
+		f, err = parseESP(n, data)
+	case "SHOPTAB.TBL":
+		f, err = parseShop(n, data)
+	default:
+		return nil, fmt.Errorf("l10n: 不支援的檔案 %q（只認 %s）", name, strings.Join(dataFileNames, "、"))
+	}
+	if err != nil {
+		return nil, fmt.Errorf("l10n: 解析 %s：%w", n, err)
+	}
+	f.index = make(map[string]int, len(f.Items))
+	for i, it := range f.Items {
+		f.index[it.ID] = i
+	}
+	return f, nil
+}
+
+// idPrefix 是這個檔案所有項目 ID 在 '#' 之前的部分。
+func (f *File) idPrefix() string {
+	switch f.Kind {
+	case KindESP:
+		return "ESPMES"
+	case KindShop:
+		return "SHOPTAB"
+	}
+	return f.Name
+}
+
+// Lookup 以 ID 取項目。
+func (f *File) Lookup(id string) (Item, bool) {
+	i, ok := f.index[id]
+	if !ok {
+		return Item{}, false
+	}
+	return f.Items[i], true
+}
+
+// DuplicateGroups 列出「原項目位元組相同」的 ID 群組（兩項以上），依首次出現的順序，群組內依檔案順序。
+// 建置報告只列 ID，不含內容。
+func (f *File) DuplicateGroups() [][]string {
+	byContent := make(map[string][]string)
+	var order []string
+	for _, it := range f.Items {
+		k := string(it.Orig)
+		if _, ok := byContent[k]; !ok {
+			order = append(order, k)
+		}
+		byContent[k] = append(byContent[k], it.ID)
+	}
+	var out [][]string
+	for _, k := range order {
+		if ids := byContent[k]; len(ids) > 1 {
+			out = append(out, ids)
+		}
+	}
+	return out
+}
+
+// SerializeOptions 是序列化選項。
+type SerializeOptions struct {
+	// ExactCountryOffsets：COUNTRY.MES 含譯文時重算精確偏移（去掉 +2 偏差）。未開則含譯文的 COUNTRY.MES 回錯。
+	ExactCountryOffsets bool
+}
+
+// Serialize 以 repl（ID 到新位元組，已去掉結尾 NUL）取代對應項目並重新序列化。
+// repl 為空時必須與原檔逐位元組相同（identity）。
+//
+// COUNTRY.MES：repl 為空時原樣保留偏移表的 +2 偏差與最後偏移多 1；repl 非空時只有 ExactCountryOffsets 為真
+// 才重算精確偏移，否則回錯。
+// 其餘檔案的偏移表一律由項目重算。
+func (f *File) Serialize(repl map[string][]byte, opt SerializeOptions) ([]byte, error) {
+	cur := make([][]byte, len(f.Items))
+	for i, it := range f.Items {
+		cur[i] = it.Orig
+	}
+	for id, b := range repl {
+		i, ok := f.index[id]
+		if !ok {
+			return nil, fmt.Errorf("l10n: %s 沒有項目 %s", f.Name, id)
+		}
+		if bytes.IndexByte(b, 0) >= 0 {
+			return nil, fmt.Errorf("l10n: %s 的替換位元組含 0x00（項目以 NUL 結尾，內部不能有 NUL）", id)
+		}
+		cur[i] = b
+	}
+	switch f.Kind {
+	case KindMES:
+		return serializeMES(cur, 0)
+	case KindCountry:
+		bias := f.countryBias
+		if len(repl) > 0 {
+			if !opt.ExactCountryOffsets {
+				return nil, fmt.Errorf("l10n: %s 含譯文，需要 ExactCountryOffsets（旗標 -allow-country-offsets）才能重算偏移", f.Name)
+			}
+			bias = 0
+		}
+		return serializeMES(cur, bias)
+	case KindESP:
+		return f.serializeESP(cur)
+	case KindShop:
+		return f.serializeShop(cur)
+	}
+	return nil, fmt.Errorf("l10n: 未知的檔案種類 %v", f.Kind)
+}
+
+// putU16、putU32 以小端附加。
+func putU16(b []byte, v int) []byte { return binary.LittleEndian.AppendUint16(b, uint16(v)) }
+func putU32(b []byte, v int) []byte { return binary.LittleEndian.AppendUint32(b, uint32(v)) }
diff --git a/apps/hr/l10n/leakscan/allow.go b/apps/hr/l10n/leakscan/allow.go
new file mode 100644
index 0000000..49b22e2
--- /dev/null
+++ b/apps/hr/l10n/leakscan/allow.go
@@ -0,0 +1,98 @@
+package leakscan
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"path"
+	"path/filepath"
+	"strings"
+)
+
+// allowlist（tools/l10n/leakscan-allow.tsv）：已知良性命中，欄位為「路徑」與「單位身分」，以 Tab 分隔，
+// `#` 開頭是註解。登記以單位身分為準；所屬段超過 AllowMaxSegChars 個字的單位不得登記
+// （避免長句被 ASCII 或 `%` 序列切成多個短片段後逐片段登記）。
+
+// AllowEntry 是 allowlist 的一行。
+type AllowEntry struct {
+	Line   int
+	Path   string // 已正規化（斜線、path.Clean、去掉前導 ./）
+	UnitID string // 正規形式（見 ParseUnitID）
+}
+
+// Reject 是被拒絕的一行（內容只有行號、路徑、單位身分與原因，不含原版文字）。
+type Reject struct {
+	Line   int
+	Path   string
+	UnitID string
+	Reason string
+}
+
+func (r Reject) String() string {
+	return fmt.Sprintf("行 %d\t%s\t%s\t%s", r.Line, r.Path, r.UnitID, r.Reason)
+}
+
+// CleanPath 把路徑正規化成輸出與 allowlist 比對共用的寫法。
+func CleanPath(p string) string {
+	p = path.Clean(filepath.ToSlash(p))
+	return strings.TrimPrefix(p, "./")
+}
+
+// ParseAllow 讀入 allowlist。格式錯誤的行放進 rejects，其餘放進 entries。
+func ParseAllow(r io.Reader) (entries []AllowEntry, rejects []Reject, err error) {
+	sc := bufio.NewScanner(r)
+	sc.Buffer(make([]byte, 0, 64*1024), 1<<20)
+	for n := 1; sc.Scan(); n++ {
+		line := strings.TrimRight(sc.Text(), "\r")
+		if strings.TrimSpace(line) == "" || strings.HasPrefix(strings.TrimSpace(line), "#") {
+			continue
+		}
+		f := strings.Split(line, "\t")
+		if len(f) != 2 || strings.TrimSpace(f[0]) == "" || strings.TrimSpace(f[1]) == "" {
+			rejects = append(rejects, Reject{Line: n, Reason: "格式錯誤：需要「路徑 Tab 單位身分」兩欄"})
+			continue
+		}
+		id, ok := ParseUnitID(strings.TrimSpace(f[1]))
+		if !ok {
+			rejects = append(rejects, Reject{Line: n, Path: CleanPath(strings.TrimSpace(f[0])), Reason: "單位身分格式錯誤（需要 <檔名>@<十六進位位移>.<序號>）"})
+			continue
+		}
+		entries = append(entries, AllowEntry{Line: n, Path: CleanPath(strings.TrimSpace(f[0])), UnitID: id})
+	}
+	return entries, rejects, sc.Err()
+}
+
+// CheckAllow 驗證登記項目：單位必須存在，且所屬段不得超過 AllowMaxSegChars 個字。
+func CheckAllow(entries []AllowEntry, units []Unit) []Reject {
+	byID := make(map[string]*Unit, len(units))
+	for i := range units {
+		byID[units[i].ID] = &units[i]
+	}
+	var rejects []Reject
+	for _, e := range entries {
+		u, ok := byID[e.UnitID]
+		switch {
+		case !ok:
+			rejects = append(rejects, Reject{e.Line, e.Path, e.UnitID, "單位不存在於原版資料檔（單位身分過期或寫錯）"})
+		case u.SegChars > AllowMaxSegChars:
+			rejects = append(rejects, Reject{e.Line, e.Path, e.UnitID,
+				fmt.Sprintf("所屬段 %d 字，超過登記上限 %d 字", u.SegChars, AllowMaxSegChars)})
+		}
+	}
+	return rejects
+}
+
+// AllowSet 以（路徑，單位身分）查詢是否已登記。
+type AllowSet map[[2]string]bool
+
+// NewAllowSet 由登記項目建立查詢集合。
+func NewAllowSet(entries []AllowEntry) AllowSet {
+	s := make(AllowSet, len(entries))
+	for _, e := range entries {
+		s[[2]string{e.Path, e.UnitID}] = true
+	}
+	return s
+}
+
+// Has 回報（路徑，單位身分）是否已登記；nil 集合一律回 false。
+func (s AllowSet) Has(p, unitID string) bool { return s[[2]string{CleanPath(p), unitID}] }
diff --git a/apps/hr/l10n/leakscan/big5.go b/apps/hr/l10n/leakscan/big5.go
new file mode 100644
index 0000000..0800b00
--- /dev/null
+++ b/apps/hr/l10n/leakscan/big5.go
@@ -0,0 +1,126 @@
+// Package leakscan 實作 hrl10n leakscan 的內容判準（docs/spec/008-ingame-text-localization 第 3.9 節）：
+// 由使用者自備的原版七個資料檔抽出「單位」，再掃描版控內的檔案或 git 歷史，找出原版文字的引用。
+//
+// 單位的抽取只依賴原始位元組，與任何解析器無關；輸出只有路徑（歷史模式加 commit）與單位身分，不輸出內容。
+// 本套件不含任何原版文字；測試所需的原版資料在執行時由 HR_ORIG（預設 /orig/orig）讀取，缺檔就 skip。
+package leakscan
+
+import (
+	"sync"
+	"unicode/utf8"
+
+	"golang.org/x/text/encoding/traditionalchinese"
+)
+
+// puaBase 是「位元組結構合法、但 x/text 解不出字」的雙位元組碼的替身字元：puaBase + 碼值
+// （Supplementary Private Use Area-A）。這類字只能以位元組形式比對，不會與任何 UTF-8 文字相等。
+const puaBase rune = 0xF0000
+
+var (
+	big5Once sync.Once
+	big5Dec  [0x10000]rune     // 索引為 lead<<8|trail；0 表示 x/text 無法解成單一字元
+	big5Uni  [0x10000 / 8]byte // 可由 Big5 解出的 BMP 字元集合（位元圖），用來判斷文字裡的字元能不能出現在原版
+)
+
+// isLead 與 isTrail 是 Big5 雙位元組字的位元組結構（與 x/text 的解碼器一致）。
+func isLead(b byte) bool  { return b >= 0x81 && b <= 0xFE }
+func isTrail(b byte) bool { return (b >= 0x40 && b <= 0x7E) || (b >= 0xA1 && b <= 0xFE) }
+
+func big5Init() {
+	big5Once.Do(func() {
+		dec := traditionalchinese.Big5.NewDecoder()
+		var pair [2]byte
+		for lead := 0x81; lead <= 0xFE; lead++ {
+			for trail := 0x40; trail <= 0xFE; trail++ {
+				if !isTrail(byte(trail)) {
+					continue
+				}
+				pair[0], pair[1] = byte(lead), byte(trail)
+				out, err := dec.Bytes(pair[:])
+				if err != nil {
+					continue
+				}
+				r, n := utf8.DecodeRune(out)
+				if r == utf8.RuneError || n != len(out) { // 只收剛好解成一個字元的碼
+					continue
+				}
+				big5Dec[lead<<8|trail] = r
+				if r < 0x10000 {
+					big5Uni[r>>3] |= 1 << (uint(r) & 7)
+				}
+			}
+		}
+	})
+}
+
+// pairAt 回傳 b[i:] 開頭的雙位元組字碼（lead<<8|trail）；位元組結構不合法回 -1。
+func pairAt(b []byte, i int) int {
+	if i+1 < len(b) && isLead(b[i]) && isTrail(b[i+1]) {
+		return int(b[i])<<8 | int(b[i+1])
+	}
+	return -1
+}
+
+// big5Rune 回傳碼值對應的字元；x/text 解不出時回替身字元與 false。
+func big5Rune(code int) (rune, bool) {
+	big5Init()
+	if r := big5Dec[code]; r != 0 {
+		return r, true
+	}
+	return puaBase + rune(code), false
+}
+
+// inBig5 回報字元能不能由 Big5 解出（BMP 以位元圖判斷；替身字元另計）。
+func inBig5(r rune) bool {
+	big5Init()
+	if r >= puaBase && r < puaBase+0x10000 {
+		return true
+	}
+	return r >= 0 && r < 0x10000 && big5Uni[r>>3]&(1<<(uint(r)&7)) != 0
+}
+
+// decodeBig5 把原始位元組由左至右對齊解碼成字元串流：
+// ASCII 位元組原樣放入；結構合法的雙位元組碼放入對應字元（解不出者放替身字元）；其餘位元組放 U+FFFD（切斷用）。
+// skipFirst 為真時，每段連續高位元組（>= 0x81）的第一個位元組視為無效：用來探另一種對齊，
+// 因為前面多一個位元組會讓整段高位元組錯位，而錯位只會在下一個 ASCII 位元組處重新對齊。
+func decodeBig5(b []byte, skipFirst bool) []rune {
+	big5Init()
+	out := make([]rune, 0, len(b))
+	prevHigh := false
+	for i := 0; i < len(b); {
+		c := b[i]
+		if c < 0x80 {
+			out = append(out, rune(c))
+			prevHigh = false
+			i++
+			continue
+		}
+		if skipFirst && !prevHigh {
+			out = append(out, utf8.RuneError)
+			prevHigh = true
+			i++
+			continue
+		}
+		prevHigh = true
+		if code := pairAt(b, i); code >= 0 {
+			r, _ := big5Rune(code)
+			out = append(out, r)
+			i += 2
+			continue
+		}
+		out = append(out, utf8.RuneError)
+		i++
+	}
+	return out
+}
+
+// decodeUTF8 把位元組寬鬆解成字元串流；無效位元組成為 U+FFFD。
+func decodeUTF8(b []byte) []rune {
+	out := make([]rune, 0, len(b))
+	for i := 0; i < len(b); {
+		r, n := utf8.DecodeRune(b[i:])
+		out = append(out, r) // 無效位元組得到 RuneError（n == 1）
+		i += n
+	}
+	return out
+}
diff --git a/apps/hr/l10n/leakscan/chunk_test.go b/apps/hr/l10n/leakscan/chunk_test.go
new file mode 100644
index 0000000..f96e122
--- /dev/null
+++ b/apps/hr/l10n/leakscan/chunk_test.go
@@ -0,0 +1,86 @@
+package leakscan
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// withChunk 縮小分塊大小，測試結束還原。
+func withChunk(t *testing.T, n int) {
+	t.Helper()
+	old := chunkBytes
+	chunkBytes = n
+	t.Cleanup(func() { chunkBytes = old })
+}
+
+// 切點選在數字（其次是其他 < 0x40 的 ASCII 位元組）之前，所以跨過分塊邊界的引用不會被切開。
+func TestChunkBoundary(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		u := w.pick(t, 6, 8) // 6 至 8 字：從中間切開的兩半都不足 6 字，切壞了就一定漏報
+		withChunk(t, 100)
+		prefix := strings.Repeat("a", 95)
+		for name, after := range map[string]string{
+			"邊界後有數字":  " 7 " + strings.Repeat("b", 50),
+			"邊界後只有空白": " " + strings.Repeat("b", 50),
+			"邊界後有換行":  "\n" + strings.Repeat("b", 50),
+		} {
+			content := []byte(prefix + u.Text + after) // 引用從第 95 個位元組起，跨過第 100 個位元組
+			if !w.scan(content)[u.ID] {
+				t.Errorf("%s：%s：跨過分塊邊界的引用沒有命中 %s", w.name, name, u.ID)
+			}
+		}
+	})
+}
+
+// 分塊不改變結果：只要找得到切點，各種分塊大小的命中與不分塊相同。
+func TestChunkedEqualsWhole(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		var quotes []string
+		for _, rng := range [][2]int{{12, 60}, {6, 8}, {3, 5}} {
+			u := w.pick(t, rng[0], rng[1])
+			rs, _ := clean(u)
+			if len(rs) >= 12 {
+				quotes = append(quotes, string(rs[:8]))
+			} else {
+				quotes = append(quotes, u.Text)
+			}
+		}
+		var sb strings.Builder
+		for i := 0; i < 300; i++ {
+			fmt.Fprintf(&sb, "line %d: %s | note %s\n", i, quotes[i%3], strings.Repeat("x", i%17))
+		}
+		content := []byte(sb.String())
+		want := w.scan(content)
+		if len(want) == 0 {
+			t.Fatal("基準內容沒有命中，無法比較")
+		}
+		for _, n := range []int{16, 50, 128, 1000, 4096} {
+			withChunk(t, n)
+			if got := w.scan(content); !reflect.DeepEqual(got, want) {
+				t.Errorf("%s：分塊大小 %d 的命中數 %d，不分塊 %d", w.name, n, len(got), len(want))
+			}
+		}
+	})
+}
+
+// 預設分塊大小（8 MiB）：引用跨過第一個邊界的大內容。
+func TestChunkDefaultSize(t *testing.T) {
+	forEachWorld(t, func(t *testing.T, w *world) {
+		u := w.pick(t, 6, 8)
+		unit := []byte("0123456789 abcdefghij\n")
+		const size = 20 << 20
+		content := make([]byte, 0, size+len(u.Text)+64)
+		for len(content) < chunkBytes {
+			content = append(content, unit...)
+		}
+		content = append(content[:chunkBytes-4], u.Text...) // 起點離第一個邊界 4 個位元組，跨過它
+		for len(content) < size {
+			content = append(content, unit...)
+		}
+		if !w.scan(content)[u.ID] {
+			t.Errorf("%s：跨過 8 MiB 邊界的引用沒有命中 %s", w.name, u.ID)
+		}
+	})
+}
diff --git a/apps/hr/l10n/leakscan/cli.go b/apps/hr/l10n/leakscan/cli.go
new file mode 100644
index 0000000..fa9e2d8
--- /dev/null
+++ b/apps/hr/l10n/leakscan/cli.go
@@ -0,0 +1,215 @@
+package leakscan
+
+import (
+	"bufio"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+)
+
+// 退出碼約定。閘門失敗（原版缺席、allowlist 無效、輸入無法讀取、掃描範圍是空的）與用法錯誤一律是 ExitUsage，不略過。
+const (
+	ExitClean = 0 // 無命中
+	ExitHits  = 1 // 有命中（-check-allow 時為有被拒的登記行）
+	ExitUsage = 2 // 用法錯誤或閘門失敗
+)
+
+// Gate 是呼叫端提供的額外閘門：在原版資料檔載入之後、抽取單位之前呼叫，回錯誤就以 ExitUsage 結束。
+// 例如 cmd/hrl10n 以原版雜湊清單驗證檔案內容；套件本身不依賴 apps/hr/runtime，以保持獨立。
+type Gate func(files map[string][]byte) error
+
+// afterIndex 讓測試在索引建好之後、自檢之前破壞索引，以驗證自檢確實擋得住。正式程式碼不設。
+var afterIndex func(ix *Index)
+
+// Main 是 `hrl10n leakscan` 的進入點（沒有額外閘門）。args 不含子命令名稱。
+func Main(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	return MainWithGate(args, stdin, stdout, stderr, nil)
+}
+
+// MainWithGate 與 Main 相同，另在原版資料檔載入後呼叫 gate（可為 nil）。
+// 輸出只有路徑（歷史模式加 commit）與單位身分，不輸出內容。
+func MainWithGate(args []string, stdin io.Reader, stdout, stderr io.Writer, gate Gate) int {
+	fs := flag.NewFlagSet("hrl10n leakscan", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	orig := fs.String("orig", "", "原版目錄（必須含單位來源檔，缺任何一個即失敗）")
+	allowFile := fs.String("allow", "", "allowlist TSV（路徑 Tab 單位身分；已知良性命中）")
+	checkAllow := fs.String("check-allow", "", "驗證 allowlist 檔本身（需要 -orig）：列出被拒的行並以非零結束，不掃描")
+	history := fs.Bool("history", false, "從標準輸入讀 <commit>\\t<路徑>\\t<大小>\\n 加內容加 \\n 的記錄串流，以 END\\t<記錄數>\\n 結尾")
+	filesFrom := fs.String("files-from", "", "清單檔，每行一個要掃的路徑（- 讀標準輸入；以引號開頭的行是錯誤）")
+	filesFrom0 := fs.String("files-from0", "", "清單檔，以 NUL 分隔（對應 git ls-files -z；- 讀標準輸入）")
+	skipMissing := fs.Bool("skip-missing", false, "清單內不存在的項目略過並印計數（預設是錯誤；只用於 -files-from 與 -files-from0）")
+	allowEmpty := fs.Bool("allow-empty", false, "掃描 0 個檔案或 0 筆歷史記錄時仍回 0（預設是錯誤；只供測試）")
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "用法：hrl10n leakscan -orig <原版目錄> [-allow <檔>] [-files-from <清單> | -files-from0 <清單>] [-skip-missing] [路徑或目錄…]")
+		fmt.Fprintln(stderr, "      hrl10n leakscan -orig <原版目錄> [-allow <檔>] -history < 串流")
+		fmt.Fprintln(stderr, "      hrl10n leakscan -orig <原版目錄> -check-allow <檔>")
+		fmt.Fprintln(stderr, "退出碼：0 無命中，1 有命中，2 用法錯誤或閘門失敗")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return ExitClean
+		}
+		return ExitUsage
+	}
+	rest := fs.Args()
+	fail := func(format string, a ...any) int {
+		fmt.Fprintf(stderr, "leakscan：%s\n", fmt.Sprintf(format, a...))
+		return ExitUsage
+	}
+
+	switch {
+	case *checkAllow != "" && (*allowFile != "" || *history || *filesFrom != "" || *filesFrom0 != "" || *skipMissing || *allowEmpty || len(rest) > 0):
+		return fail("-check-allow 只驗證 allowlist，不能與其他掃描旗標或路徑並用")
+	case *history && (*filesFrom != "" || *filesFrom0 != "" || *skipMissing || len(rest) > 0):
+		return fail("-history 從標準輸入讀串流，不能再給路徑、清單或 -skip-missing")
+	case *filesFrom != "" && *filesFrom0 != "":
+		return fail("-files-from 與 -files-from0 擇一")
+	case *skipMissing && *filesFrom == "" && *filesFrom0 == "":
+		return fail("-skip-missing 只用於 -files-from 與 -files-from0")
+	case *checkAllow == "" && !*history && *filesFrom == "" && *filesFrom0 == "" && len(rest) == 0:
+		fs.Usage()
+		return fail("沒有指定要掃描的路徑")
+	}
+
+	// 閘門：原版缺席時失敗，不略過。
+	if *orig == "" {
+		return fail("缺少 -orig：沒有原版就無法判準，閘門失敗（不略過）")
+	}
+	files, err := LoadOrig(*orig)
+	if err != nil {
+		return fail("%v：閘門失敗（不略過）", err)
+	}
+	if gate != nil {
+		if err := gate(files); err != nil {
+			return fail("%v：閘門失敗（不略過）", err)
+		}
+	}
+	units := ExtractUnits(files)
+	if err := checkUnitCoverage(units); err != nil {
+		return fail("%v：閘門失敗（不略過）", err)
+	}
+
+	if *checkAllow != "" {
+		_, rejects, err := loadAllow(*checkAllow, units)
+		if err != nil {
+			return fail("%v", err)
+		}
+		for _, r := range rejects {
+			fmt.Fprintln(stdout, r)
+		}
+		fmt.Fprintf(stderr, "leakscan：allowlist 被拒 %d 行\n", len(rejects))
+		if len(rejects) > 0 {
+			return ExitHits
+		}
+		return ExitClean
+	}
+
+	var allowed AllowSet
+	if *allowFile != "" {
+		entries, rejects, err := loadAllow(*allowFile, units)
+		if err != nil {
+			return fail("%v", err)
+		}
+		if len(rejects) > 0 {
+			for _, r := range rejects {
+				fmt.Fprintln(stderr, r)
+			}
+			return fail("allowlist 無效（%d 行被拒），閘門失敗；先用 -check-allow 修正", len(rejects))
+		}
+		allowed = NewAllowSet(entries)
+	}
+
+	ix := NewIndex(units)
+	if afterIndex != nil {
+		afterIndex(ix)
+	}
+	if err := ix.SelfCheck(); err != nil {
+		return fail("%v：閘門失敗（不略過）", err)
+	}
+	out := bufio.NewWriter(stdout)
+	defer out.Flush()
+	nHit, nAllowed := 0, 0
+	emit := func(h Hit) {
+		if allowed.Has(h.Path, h.UnitID) {
+			nAllowed++
+			return
+		}
+		nHit++
+		if h.Commit != "" {
+			fmt.Fprintf(out, "%s\t%s\t%s\n", h.Commit, h.Path, h.UnitID)
+		} else {
+			fmt.Fprintf(out, "%s\t%s\n", h.Path, h.UnitID)
+		}
+	}
+
+	var scanned int
+	what := "個檔案"
+	if *history {
+		what = "筆記錄"
+		scanned, err = ScanHistory(ix, stdin, emit)
+		if err != nil {
+			out.Flush()
+			return fail("歷史串流錯誤：%v", err)
+		}
+	} else {
+		list, err := FileList(rest, ListOptions{From: *filesFrom, From0: *filesFrom0, SkipMissing: *skipMissing}, stdin)
+		if err != nil {
+			return fail("無法收集檔案：%v", err)
+		}
+		if list.Skipped > 0 {
+			fmt.Fprintf(stderr, "leakscan：略過 %d 個非一般檔案（符號連結等）\n", list.Skipped)
+		}
+		if list.Missing > 0 {
+			fmt.Fprintf(stderr, "leakscan：-skip-missing：略過 %d 個清單內不存在的項目\n", list.Missing)
+		}
+		scanned, err = ScanFiles(ix, list.Files, emit)
+		if err != nil {
+			out.Flush()
+			return fail("讀取檔案失敗：%v", err)
+		}
+	}
+	nWin, nEq := ix.Stats()
+	fmt.Fprintf(stderr, "leakscan：單位 %d 個（視窗鍵 %d、整段鍵 %d），掃描 %d %s，命中 %d 項，allowlist 放行 %d 項\n",
+		len(units), nWin, nEq, scanned, what, nHit, nAllowed)
+	if scanned == 0 && !*allowEmpty {
+		return fail("掃描範圍是空的（0 %s）：路徑、工作目錄或上游串流有問題；確定要放行時才加 -allow-empty", what)
+	}
+	if nHit > 0 {
+		return ExitHits
+	}
+	return ExitClean
+}
+
+// checkUnitCoverage 確認每個單位來源檔都抽得出單位；抽不出來代表檔案不是預期的原版，判準不可靠。
+func checkUnitCoverage(units []Unit) error {
+	per := map[string]int{}
+	for _, u := range units {
+		per[u.File]++
+	}
+	for _, name := range SourceFiles {
+		if per[name] == 0 {
+			return fmt.Errorf("%s 沒有抽出任何單位", name)
+		}
+	}
+	return nil
+}
+
+// loadAllow 讀入並驗證 allowlist，回傳有效項目與全部被拒的行（格式錯誤、單位不存在、所屬段過長）。
+func loadAllow(path string, units []Unit) ([]AllowEntry, []Reject, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, nil, fmt.Errorf("無法讀取 allowlist：%w", err)
+	}
+	defer f.Close()
+	entries, rejects, err := ParseAllow(f)
+	if err != nil {
+		return nil, nil, fmt.Errorf("讀取 allowlist 失敗：%w", err)
+	}
+	rejects = append(rejects, CheckAllow(entries, units)...)
+	sort.SliceStable(rejects, func(i, j int) bool { return rejects[i].Line < rejects[j].Line })
+	return entries, rejects, nil
+}
