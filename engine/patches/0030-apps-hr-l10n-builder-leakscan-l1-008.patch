+	in.Trans = cat(pairs(0xA4, 0x40, 14), hb("A4 E0"), pairs(0xA4, 0x50, 5))
+	out := wrapped(t, in)
+	want := cat(pairs(0xA4, 0x40, 14), nl, hb("A4 E0"), pairs(0xA4, 0x50, 5))
+	if !bytes.Equal(out, want) {
+		t.Fatalf("折行結果 %x，要 %x", out, want)
+	}
+	in.Trans = out
+	if vs := Check(in); len(vs) != 0 {
+		t.Fatalf("折完應通過 Check：%+v", vs)
+	}
+}
+
+// 每個折點都會吃換行（全是 A4 E0）：找不到合格折點，回 line-width，原樣保留。
+func TestAutoWrapNoBreakpoint(t *testing.T) {
