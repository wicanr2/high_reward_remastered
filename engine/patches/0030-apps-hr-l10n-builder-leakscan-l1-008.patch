+func TestAdoptGroupConsistency(t *testing.T) {
+	cs := mustCharmap(t)
+	f := uwasaFile(t)
+	// 項目 0、2、4 是同群組。
+	diff := &Table{Rows: []Row{
+		mkRow(f, 0, StatusAccepted, txtA),
+		mkRow(f, 2, StatusAccepted, txtA),
+		mkRow(f, 4, StatusAccepted, txtB),
+		mkRow(f, 1, StatusAccepted, txtC), // 別的群組，不影響
+	}}
+	repl, n, viol, err := diff.Adopt(f, Policy{}, cs, nil)
+	if err != nil || repl != nil || n != 0 || len(viol) != 1 {
+		t.Fatalf("同群組譯文不一致要失敗：repl %v n %d viol %v err %v", repl, n, viol, err)
+	}
+	if !containsAll(viol[0], "UWASA.MES#0", "UWASA.MES#2", "UWASA.MES#4", "同群組") || strings.Contains(viol[0], "UWASA.MES#1") {
+		t.Errorf("違規要列出群組的 id：%s", viol[0])
+	}
+	// note 明示例外（該列退出比對）：通過。
+	exc := &Table{Rows: append([]Row(nil), diff.Rows...)}
+	exc.Rows[2].Note = "此處語境不同；" + GroupExceptionNote
+	if _, n, viol, err := exc.Adopt(f, Policy{}, cs, nil); err != nil || len(viol) != 0 || n != 4 {
+		t.Errorf("明示例外：%v err %v 採用 %d", viol, err, n)
+	}
+	// 一致：通過。
+	same := &Table{Rows: []Row{mkRow(f, 0, StatusAccepted, txtA), mkRow(f, 2, StatusAccepted, txtA), mkRow(f, 4, StatusAccepted, txtA)}}
+	if _, n, viol, err := same.Adopt(f, Policy{}, cs, nil); err != nil || len(viol) != 0 || n != 3 {
+		t.Errorf("一致的群組：%v err %v 採用 %d", viol, err, n)
+	}
+	// 群組內有些列沒有被採用（keep、candidate、不在表內）：部分翻譯，不算違規。
+	part := &Table{Rows: []Row{mkRow(f, 0, StatusAccepted, txtA), mkRow(f, 2, StatusKeep, ""), mkRow(f, 4, StatusCandidate, txtB)}}
+	if _, n, viol, err := part.Adopt(f, Policy{}, cs, nil); err != nil || len(viol) != 0 || n != 1 {
+		t.Errorf("部分採用：%v err %v 採用 %d", viol, err, n)
+	}
+	// WithCandidates 把 candidate 採用後，同群組比對生效。
+	if _, _, viol, _ := part.Adopt(f, Policy{WithCandidates: true}, cs, nil); len(viol) != 1 {
+		t.Errorf("WithCandidates 下，採用的列不一致要失敗：%v", viol)
+	}
+}
+
+func TestAdoptReportsAllViolations(t *testing.T) {
+	cs := mustCharmap(t)
+	f := uwasaFile(t)
+	badSrc := mkRow(f, 1, StatusAccepted, txtA)
+	badSrc.SrcSHA = "0000000000000000"
+	badRune := mkRow(f, 3, StatusAccepted, "汉"+t1)
+	badPct := mkRow(f, 0, StatusAccepted, "%z")
+	unknown := Row{ID: "UWASA.MES#99", SrcSHA: "0123456789abcdef", Status: StatusKeep}
+	empty := mkRow(f, 2, StatusAccepted, "")
+	chkViol := mkRow(f, 4, StatusAccepted, txtB)
+	called := 0
+	chk := func(file, class, id string, orig, trans []byte) []string {
+		called++
+		if id == "UWASA.MES#4" {
+			return []string{"違規甲", "違規乙"}
+		}
+		return nil
+	}
+	tb := &Table{Rows: []Row{badSrc, badRune, badPct, unknown, empty, chkViol, {ID: "SP.MES#1", SrcSHA: "0123456789abcdef", Status: StatusKeep}}}
+	_, _, viol, err := tb.Adopt(f, Policy{}, cs, chk)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(viol) != 7 {
+		t.Fatalf("違規 %d 條，應為 7（不是遇到第一個就停）：\n%s", len(viol), strings.Join(viol, "\n"))
+	}
+	wantSub := []string{"UWASA.MES#1: src_sha256", "UWASA.MES#3: 字集外的字 U+6C49", "UWASA.MES#0: ", "UWASA.MES#99: 檔案內沒有", "UWASA.MES#2: 譯文為空", "UWASA.MES#4: 違規甲", "UWASA.MES#4: 違規乙"}
+	for i, s := range wantSub {
+		if !strings.Contains(viol[i], s) {
+			t.Errorf("違規 %d ＝ %q，應含 %q", i, viol[i], s)
+		}
+	}
+	if !strings.HasPrefix(viol[0], "UWASA.MES: ") {
+		t.Errorf("違規要以檔名開頭：%q", viol[0])
+	}
+	// Checker 的違規併入（兩條都在）；只有通過其他檢查的被採用列才會呼叫 Checker。
+	joined := strings.Join(viol, "\n")
+	if !strings.Contains(joined, "UWASA.MES#4: 違規乙") {
+		t.Error("Checker 的第二條違規沒有併入")
+	}
+	if called != 1 {
+		t.Errorf("Checker 被呼叫 %d 次，應只對通過編碼檢查的被採用列呼叫 1 次", called)
+	}
+	// 違規訊息不含譯文文句。
+	if strings.Contains(joined, "汉") {
+		t.Error("違規訊息含譯文文句")
+	}
+}
+
+func TestAdoptCheckerArguments(t *testing.T) {
+	cs := mustCharmap(t)
+	// ESPMES：群組 44 與 116（esp-windows.tsv 有這些鍵）。
+	esp := mustParse(t, "ESPMES.MRG", buildESP(125, map[int][]string{44: {"a", "b", "c"}, 116: {"d"}}))
+	type call struct {
+		file, class, id string
+		orig, trans     []byte
+	}
+	var calls []call
+	chk := func(file, class, id string, orig, trans []byte) []string {
+		calls = append(calls, call{file, class, id, orig, trans})
+		return nil
+	}
+	tb := &Table{Rows: []Row{
+		mkRow(esp, 0, StatusAccepted, txtA), // #44.0
+		mkRow(esp, 1, StatusAccepted, txtB), // #44.1
+		mkRow(esp, 2, StatusKeep, ""),       // #44.2
+		mkRow(esp, 3, StatusCandidate, txtC),
+	}}
+	if _, n, viol, err := tb.Adopt(esp, Policy{}, cs, chk); err != nil || len(viol) != 0 || n != 2 {
+		t.Fatalf("n %d viol %v err %v", n, viol, err)
+	}
+	if len(calls) != 2 {
+		t.Fatalf("Checker 呼叫 %d 次，應為 2（keep 與未採用的 candidate 不檢查）", len(calls))
+	}
+	c0, c1 := calls[0], calls[1]
+	if c0.file != "ESPMES.MRG" || c0.class != ClassWin31x4 || c0.id != "ESPMES#44.0" || string(c0.orig) != "a" || !bytes.Equal(c0.trans, encOf(t, cs, txtA)) {
+		t.Errorf("第一次呼叫：%+v", c0)
+	}
+	if c1.class != ClassWin63x8 || c1.id != "ESPMES#44.1" {
+		t.Errorf("第二次呼叫：%+v", c1)
+	}
+	// 非 ESPMES 檔的 class 是空字串。
+	sp := mustParse(t, "SP.MES", buildMES([]string{"x"}, 0))
+	calls = nil
+	tb = &Table{Rows: []Row{mkRow(sp, 0, StatusAccepted, txtA)}}
+	if _, _, _, err := tb.Adopt(sp, Policy{}, cs, chk); err != nil || len(calls) != 1 || calls[0].class != "" || calls[0].file != "SP.MES" {
+		t.Errorf("非 ESPMES：%+v err %v", calls, err)
+	}
+	// ESPMES 項目查不到窗口類別是違規（併入違規清單，不回 err，也不呼叫 Checker）。
+	odd := mustParse(t, "ESPMES.MRG", buildESP(10, map[int][]string{5: {"a"}}))
+	tb = &Table{Rows: []Row{mkRow(odd, 0, StatusAccepted, txtA)}}
+	calls = nil
+	if _, n, viol, err := tb.Adopt(odd, Policy{}, cs, chk); err != nil || n != 0 || len(viol) != 1 || len(calls) != 0 ||
+		!containsAll(viol[0], "ESPMES.MRG: ESPMES#5.0: ", "esp-windows.tsv") {
+		t.Errorf("esp-windows.tsv 沒有的 ESPMES id，在有 Checker 時應記一條違規：%v err %v 呼叫 %d 次", viol, err, len(calls))
+	}
+	// 沒有 Checker 時不查窗口。
+	if _, n, viol, err := tb.Adopt(odd, Policy{}, cs, nil); err != nil || len(viol) != 0 || n != 1 {
+		t.Errorf("沒有 Checker：%v %v %d", err, viol, n)
+	}
+}
+
+func TestAdoptMiscRules(t *testing.T) {
+	cs := mustCharmap(t)
+	// 其他檔案的列略過；同檔但不存在的項目是違規；SHOPTAB 名稱超過 20 bytes 是違規。
+	f := mustParse(t, "SP.MES", buildMES([]string{"x", "y"}, 0))
+	other := Row{ID: "SYSTEM.MES#0", SrcSHA: "0123456789abcdef", Text: "汉", Status: StatusAccepted, AccSHA: AccSHA("汉")}
+	tb := &Table{Rows: []Row{other, mkRow(f, 1, StatusAccepted, txtA)}}
+	if _, n, viol, err := tb.Adopt(f, Policy{}, cs, nil); err != nil || len(viol) != 0 || n != 1 {
+		t.Errorf("其他檔案的列要略過：%v %v %d", viol, err, n)
+	}
+	shop := mustParse(t, "SHOPTAB.TBL", buildShop(1, []string{"AB"}))
+	long := strings.Repeat(t1, 11) // 編碼後 22 bytes
+	tb = &Table{Rows: []Row{mkRow(shop, 0, StatusAccepted, long), mkRow(shop, 1, StatusAccepted, strings.Repeat(t1, 6)+"AB")}}
+	_, _, viol, err := tb.Adopt(shop, Policy{AllowShoptab: true}, cs, nil)
+	if err != nil || len(viol) != 1 || !containsAll(viol[0], "SHOPTAB#0.0", "20") {
+		t.Errorf("SHOPTAB 名稱超過 20 bytes：%v %v", viol, err)
+	}
+	// 表內 id 重複（手造的表）。
+	dup := &Table{Rows: []Row{mkRow(f, 1, StatusKeep, ""), mkRow(f, 1, StatusKeep, "")}}
+	if _, _, viol, _ := dup.Adopt(f, Policy{}, cs, nil); len(viol) != 1 || !strings.Contains(viol[0], "重複") {
+		t.Errorf("重複 id：%v", viol)
+	}
+	// nil 參數。
+	if _, _, _, err := (*Table)(nil).Adopt(f, Policy{}, cs, nil); err == nil {
+		t.Error("nil 譯文表應回 err")
+	}
+	if _, _, _, err := tb.Adopt(nil, Policy{}, cs, nil); err == nil {
+		t.Error("nil 檔案應回 err")
+	}
+	if _, _, _, err := tb.Adopt(f, Policy{}, nil, nil); err == nil {
+		t.Error("nil 字集應回 err")
+	}
+	// 空表：repl 為空 map、採用 0、無違規。
+	repl, n, viol, err := (&Table{}).Adopt(f, Policy{}, cs, nil)
+	if err != nil || len(viol) != 0 || n != 0 || len(repl) != 0 {
+		t.Errorf("空表：%v %v %d %v", repl, viol, n, err)
+	}
+}
+
+func TestIDPrefixAndDuplicateGroups(t *testing.T) {
+	for name, want := range map[string]string{"SP.MES": "SP.MES#", "COUNTRY.MES": "COUNTRY.MES#", "ESPMES.MRG": "ESPMES#", "SHOPTAB.TBL": "SHOPTAB#"} {
+		var data []byte
+		switch name {
+		case "ESPMES.MRG":
+			data = buildESP(3, map[int][]string{1: {"a"}})
+		case "SHOPTAB.TBL":
+			data = buildShop(1, nil)
+		default:
+			data = buildMES([]string{"a"}, 0)
+		}
+		f := mustParse(t, name, data)
+		if f.idPrefix()+"#" != want {
+			t.Errorf("%s 的 id 前綴 %q", name, f.idPrefix())
+		}
+		for _, it := range f.Items {
+			if !strings.HasPrefix(it.ID, want) {
+				t.Errorf("%s：項目 %s 不以 %s 開頭", name, it.ID, want)
+			}
+		}
+	}
+	f := mustParse(t, "UWASA.MES", buildMES([]string{"AA", "BB", "AA", "CC", "BB", "AA", "DD"}, 0))
+	got := f.DuplicateGroups()
+	if len(got) != 2 || strings.Join(got[0], ",") != "UWASA.MES#0,UWASA.MES#2,UWASA.MES#5" || strings.Join(got[1], ",") != "UWASA.MES#1,UWASA.MES#4" {
+		t.Errorf("DuplicateGroups ＝ %v", got)
+	}
+	if _, ok := f.Lookup("UWASA.MES#3"); !ok {
+		t.Error("Lookup 找不到項目")
+	}
+	if _, ok := f.Lookup("UWASA.MES#9"); ok {
+		t.Error("Lookup 找到不存在的項目")
+	}
+}
diff --git a/apps/hr/l10n/tabledir.go b/apps/hr/l10n/tabledir.go
new file mode 100644
index 0000000..a3298a3
--- /dev/null
+++ b/apps/hr/l10n/tabledir.go
@@ -0,0 +1,133 @@
+package l10n
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// 譯文表的尋找（docs/spec/008 第 3.2 節「譯文表的尋找順序」），與 play 的 findHD、findOriginal 一致，
+// 再加資料目錄的 l10n/（這一項是 008 新增，findHD 沒有）。
+
+// TableSearch 是尋找譯文表所需的各個來源。空字串的來源略過。
+type TableSearch struct {
+	Flag         string // 旗標 -l10n 的值（l10n 目錄本身）
+	Env          string // 環境變數 HR_L10N 的值（l10n 目錄本身）
+	AppImageDir  string // .AppImage 檔案所在的目錄（環境變數 APPIMAGE 的目錄部分）
+	ExeDir       string // 執行檔所在的目錄
+	MacResources string // macOS app 的 Contents/Resources
+	Cwd          string // 目前目錄
+	DataDir      string // 使用者資料目錄（l10n-packs 的上一層）
+}
+
+// subdirFold 在 base 內找名為 name 的子目錄（名稱大小寫不分），回傳完整路徑。
+func subdirFold(base, name string) (string, bool) {
+	if p := filepath.Join(base, name); isDir(p) {
+		return p, true
+	}
+	ents, err := os.ReadDir(base)
+	if err != nil {
+		return "", false
+	}
+	for _, e := range ents {
+		if strings.EqualFold(e.Name(), name) && isDir(filepath.Join(base, e.Name())) {
+			return filepath.Join(base, e.Name()), true
+		}
+	}
+	return "", false
+}
+
+func isDir(p string) bool {
+	st, err := os.Stat(p)
+	return err == nil && st.IsDir()
+}
+
+// FindTableDir 依序找存在的 l10n 目錄並回傳第一個：旗標值、環境變數值（這兩個本身就是 l10n 目錄），
+// 然後 `.AppImage` 所在目錄、執行檔所在目錄、macOS 的 Contents/Resources、目前目錄、資料目錄下的 `l10n/`
+// （目錄名大小寫不分）。找不到回 ("", false)，不是錯誤。回傳的是 l10n 根目錄；
+// 某個語言的譯文表在它底下的 `<代碼>/`，見 TableDirFor。
+//
+// 它只看 l10n 目錄存在與否，不看裡面有沒有某個語言：執行檔旁一個空的 `l10n/` 會遮住資料目錄的
+// `l10n/zh-TW/`。前端（planIngame 的 hasTable、ingameStatus 的 avail）要改用 FindTableDirFor。
+func FindTableDir(s TableSearch) (string, bool) {
+	for _, d := range []string{s.Flag, s.Env} {
+		if d != "" && isDir(d) {
+			return d, true
+		}
+	}
+	for _, base := range []string{s.AppImageDir, s.ExeDir, s.MacResources, s.Cwd, s.DataDir} {
+		if base == "" {
+			continue
+		}
+		if d, ok := subdirFold(base, "l10n"); ok {
+			return d, true
+		}
+	}
+	return "", false
+}
+
+// TableDirFor 回傳 l10n 根目錄下某個語言的譯文表目錄（`<根>/<代碼>`，代碼大小寫不分）。
+// 這個目錄直接含 `<資料檔名>.tsv`，就是 Config.TableDir。沒有該語言的目錄回 ("", false)。
+// 只看目錄存在與否，不看裡面有沒有譯文表檔（明示 l10n 根目錄的 `hrl10n build -l10n` 用它）；
+// 「該語言有譯文表」的判定見 FindTableDirFor。
+func TableDirFor(l10nRoot, code string) (string, bool) {
+	if l10nRoot == "" || code == "" {
+		return "", false
+	}
+	return subdirFold(l10nRoot, code)
+}
+
+// hasTableFile 判斷 dir 內是否至少有一個七個資料檔之一的譯文表（`<資料檔名>.tsv`，檔名大小寫不分，不含子目錄）。
+// 只看檔名，不解析內容；同一個資料檔有兩份大小寫不同的檔案仍算有（那是 Build 要回報的錯誤，不是「不存在」）。
+func hasTableFile(dir string) bool {
+	ents, err := os.ReadDir(dir)
+	if err != nil {
+		return false
+	}
+	want := tableFileNames()
+	for _, e := range ents {
+		if _, ok := want[strings.ToUpper(e.Name())]; ok && !e.IsDir() {
+			return true
+		}
+	}
+	return false
+}
+
+// hasTableFor 判斷 l10n 根目錄下是否有某個語言的譯文表：`<根>/<代碼>/`（代碼大小寫不分）存在，
+// 且其中至少有一個譯文表檔（hasTableFile）。空的 `<代碼>/` 目錄不算（否則會建出採用 0 列的 table 包）。
+func hasTableFor(l10nRoot, code string) bool {
+	d, ok := TableDirFor(l10nRoot, code)
+	return ok && hasTableFile(d)
+}
+
+// FindTableDirFor 依 FindTableDir 的來源順序，回傳第一個「含 `<代碼>/` 譯文表」的 l10n 根目錄
+// （docs/spec/008 第 3.2 節的 per-code 語意）：`<根>/<代碼>/`（代碼大小寫不分）存在，且其中至少有一個
+// 七個資料檔之一的譯文表檔。這個「找到」就是前端的 hasTable 與 avail 的「譯文表存在」。
+//
+//   - 旗標是使用者明示的來源：旗標值是存在的目錄時，由它單獨決定，沒有該語言的譯文表就回 ("", false)，
+//     不往下找（下一個候選不能默默取代使用者明示的來源）；旗標不是目錄（空字串、不存在、是檔案）時略過，
+//     與 FindTableDir 相同。
+//   - 環境變數值與其餘各來源是一般候選：沒有該語言的譯文表就往下一個找。
+func FindTableDirFor(s TableSearch, code string) (dir string, ok bool) {
+	if code == "" {
+		return "", false
+	}
+	if s.Flag != "" && isDir(s.Flag) {
+		if hasTableFor(s.Flag, code) {
+			return s.Flag, true
+		}
+		return "", false
+	}
+	if s.Env != "" && isDir(s.Env) && hasTableFor(s.Env, code) {
+		return s.Env, true
+	}
+	for _, base := range []string{s.AppImageDir, s.ExeDir, s.MacResources, s.Cwd, s.DataDir} {
+		if base == "" {
+			continue
+		}
+		if d, found := subdirFold(base, "l10n"); found && hasTableFor(d, code) {
+			return d, true
+		}
+	}
+	return "", false
+}
diff --git a/apps/hr/l10n/tabledir_test.go b/apps/hr/l10n/tabledir_test.go
