+func (w *world) unitByID() map[string]Unit {
+	m := make(map[string]Unit, len(w.units))
+	for _, u := range w.units {
+		m[u.ID] = u
+	}
+	return m
+}
+
+// pickRegistrable 找一個 3 至 5 字、可登記的短單位：它的整段鍵對應的所有單位，所屬段都 <= AllowMaxSegChars 個字。
+func (w *world) pickRegistrable(t *testing.T) (Unit, []string) {
+	t.Helper()
+	by := w.unitByID()
+	for _, u := range w.units {
+		rs, ok := clean(u)
+		if !ok || len(rs) < 3 || len(rs) > 5 {
+			continue
+		}
+		ids := w.keyIDs(rs)
+		good := true
+		for _, id := range ids {
+			if by[id].SegChars > AllowMaxSegChars {
+				good = false
+			}
+		}
+		if good {
+			return u, ids
+		}
+	}
+	t.Skipf("%s世界沒有可登記的短單位", w.name)
+	return Unit{}, nil
+}
+
+// pickShortInLongSeg 找一個來自長段（> AllowMaxSegChars 個字）的 3 至 5 字短片段。
+func (w *world) pickShortInLongSeg(t *testing.T) Unit {
+	t.Helper()
+	for _, u := range w.units {
+		if rs, ok := clean(u); ok && len(rs) >= 3 && len(rs) <= 5 && u.SegChars > AllowMaxSegChars {
+			return u
+		}
+	}
+	t.Skipf("%s世界沒有來自長段的短片段", w.name)
+	return Unit{}
+}
