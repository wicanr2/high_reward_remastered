+// 以下測試需要原版資料檔：缺檔明確 skip（readOrig），不用替代品。
+
+var wantOrigItems = map[string]int{
+	"COUNTRY.MES": 11, "SP.MES": 116, "SYSTEM.MES": 314, "UWASA.MES": 110, "POWERMES.MES": 192,
+	"ESPMES.MRG": 1024, "SHOPTAB.TBL": 792,
+}
+
+// roundtrip 是往返比對器：解析、序列化、與輸入逐位元組比較。
+func roundtrip(name string, data []byte) error {
+	f, err := Parse(name, data)
+	if err != nil {
+		return err
+	}
+	out, err := f.Serialize(nil, SerializeOptions{})
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(out, data) {
+		i := 0
+		for i < len(out) && i < len(data) && out[i] == data[i] {
+			i++
+		}
+		return fmt.Errorf("往返不符：第 %d 個位元組起不同（輸出 %d bytes，輸入 %d bytes）", i, len(out), len(data))
+	}
+	return nil
+}
+
+func TestOriginalRoundtrip(t *testing.T) {
+	orig := readOrigData(t)
+	for _, n := range dataFileNames {
+		f := mustParse(t, n, orig[n])
+		if len(f.Items) != wantOrigItems[n] {
+			t.Errorf("%s：項目數 %d，應為 %d", n, len(f.Items), wantOrigItems[n])
+		}
+		if err := roundtrip(n, orig[n]); err != nil {
+			t.Errorf("%s：%v", n, err)
+		}
+		ids := make(map[string]bool, len(f.Items))
+		for _, it := range f.Items {
+			if ids[it.ID] {
+				t.Errorf("%s：id %s 重複", n, it.ID)
+			}
+			ids[it.ID] = true
+			if !idPattern.MatchString(it.ID) {
+				t.Errorf("%s：id %s 不符譯文表的 id 格式", n, it.ID)
+			}
+		}
+	}
+}
+
+// 負對照：改動一個偏移（SHOPTAB 為名稱後的結構位元組）的位元組，往返比對必須失敗。
+// 兩層驗證：(1) 比較器本身不是恆真：序列化輸出與改動後的預期不相等；
+// (2) 嚴格的解析器對改動後的檔案回錯，往返因此失敗。
+func TestOriginalRoundtripNegativeControl(t *testing.T) {
+	orig := readOrigData(t)
+	pos := map[string]int{
+		"COUNTRY.MES":  2 + 4*3,
+		"SP.MES":       2 + 4*3,
+		"SYSTEM.MES":   2 + 4*3,
+		"UWASA.MES":    2 + 4*3,
+		"POWERMES.MES": 2 + 4*3,
+		"ESPMES.MRG":   2 + 4*10, // 外層偏移
+		"SHOPTAB.TBL":  3*25 + 20,
+	}
+	for _, n := range dataFileNames {
+		data := orig[n]
+		out := mustSerialize(t, mustParse(t, n, data), nil, SerializeOptions{})
+		mut := cloneBytes(data)
+		mut[pos[n]] ^= 0x01
+		if bytes.Equal(out, mut) {
+			t.Errorf("%s：比較器對改動過的預期仍判相等", n)
+		}
+		if err := roundtrip(n, mut); err == nil {
+			t.Errorf("%s：位移 %d 改一個位元後，往返比對必須失敗", n, pos[n])
+		}
+	}
+	// ESPMES 內層偏移（群組 116 起點 1066，第 5 個偏移）。
+	mut := cloneBytes(orig["ESPMES.MRG"])
+	mut[1066+2+4*5] ^= 0x01
+	if err := roundtrip("ESPMES.MRG", mut); err == nil {
+		t.Error("ESPMES.MRG 內層偏移改一個位元後，往返比對必須失敗")
+	}
+}
