+// 建置器的內容測試（合成世界，不需要原版）：模式、採用規則、預算檢查與折行、旗標、輸入檢查。
+
+var packNames = []string{"CFONT.15", "COUNTRY.MES", "ESPMES.MRG", "POWERMES.MES", "SHOPTAB.TBL", "SP.MES", "SYSTEM.MES", "UWASA.MES"}
+
+func TestBuildIdentity(t *testing.T) {
+	w := newSynthWorld(t)
+	root := t.TempDir()
+	cfg := w.cfg(root, "", ModeIdentity, Policy{})
+	res := mustBuild(t, cfg)
+	if res.Reused {
+		t.Fatal("第一次建置不該是重用")
+	}
+	if !filepath.IsAbs(res.Dir) {
+		t.Errorf("Result.Dir 應是絕對路徑：%s", res.Dir)
+	}
+	// identity 包與原檔逐位元組相同（含 COUNTRY.MES 的偏移偏差）；MAIN.EXE 不在 files/ 內。
+	for _, n := range packNames {
+		if got := packFile(t, res.Dir, n); !bytes.Equal(got, w.files[n]) {
+			t.Errorf("%s 與原檔不同", n)
+		}
+	}
+	ents, err := os.ReadDir(filepath.Join(res.Dir, verify.FilesDir))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ents) != len(packNames) {
+		t.Errorf("files/ 有 %d 個檔，應為 %d", len(ents), len(packNames))
+	}
+	m := res.Manifest
+	if m.Code != "zh-TW" || m.Policy.Mode != "identity" || m.Policy.WithCandidates || m.Adopted != 0 {
+		t.Errorf("manifest 欄位不符：%+v", m)
+	}
+	if m.TableHash != emptyTableHash || m.PatchHash != "" || m.BuilderVersion != Version() || m.TableFormat != TableFormat {
+		t.Errorf("manifest 的雜湊與版本欄位不符：%+v", m)
+	}
+	var names []string
+	for _, f := range m.Files {
+		names = append(names, f.Name)
+	}
+	if strings.Join(names, ",") != strings.Join(packNames, ",") {
+		t.Errorf("manifest 列出的檔案 %v，應為 %v（依檔名排序）", names, packNames)
+	}
+	for n, h := range w.hashes {
+		if m.OrigInputs[n] != h {
+			t.Errorf("manifest 的原版輸入 %s 雜湊不符", n)
+		}
+	}
+	d, err := ExpectedDigest(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Digest != d || m.InputDigest != d || filepath.Base(res.Dir) != PackName("zh-TW", d) {
+		t.Errorf("摘要或目錄名不符：result=%s manifest=%s expected=%s dir=%s", res.Digest, m.InputDigest, d, filepath.Base(res.Dir))
+	}
+	if err := w.verifyPack(res.Dir, d); err != nil {
+		t.Errorf("新建的包驗證失敗：%v", err)
+	}
+	sum, err := verify.ManifestSHA256(res.Dir)
+	if err != nil || sum != res.ManifestSHA256 {
+		t.Errorf("manifest 雜湊不符：%s vs %s（%v）", sum, res.ManifestSHA256, err)
+	}
+	raw, err := os.ReadFile(filepath.Join(res.Dir, verify.ManifestName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	back, err := verify.ParseManifest(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	again, _ := back.Marshal()
+	if !bytes.Equal(again, raw) {
+		t.Error("manifest 讀回再寫出不相同（格式不穩定）")
+	}
+	// 重複來源群組：UWASA.MES 有一組三個相同的項目。
+	if g := res.Duplicates["UWASA.MES"]; len(g) != 1 || len(g[0]) != 3 {
+		t.Errorf("UWASA.MES 的重複群組 %v", g)
+	}
+}
