+	for _, n := range []string{"CFONT.15", "COUNTRY.MES", "ESPMES.MRG", "POWERMES.MES", "SHOPTAB.TBL", "SP.MES", "SYSTEM.MES", "UWASA.MES"} {
+		b := []byte("body of " + n)
+		if err := os.WriteFile(filepath.Join(root, FilesDir, n), b, 0o644); err != nil {
+			t.Fatal(err)
+		}
+		m.Files = append(m.Files, FileEntry{Name: n, SHA256: sum(b), Size: int64(len(b))})
