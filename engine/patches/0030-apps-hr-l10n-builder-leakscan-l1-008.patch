+// verify 的原版雜湊來源：預設與 Session.Open 相同（runtime 內嵌的 required.tsv），-orig 選填，
+// 給了就另外要求目錄內的實際雜湊與 manifest 相符。-orig 只會加嚴，不會取代預設來源的核對。
+func TestVerifyOrigHashSource(t *testing.T) {
+	s := newSynthOrig(t) // origHashesOverride = 合成原版的雜湊
+	out := t.TempDir()
+	_, stdout, _ := exec("", "build", "-code", "zh-TW", "-mode", "identity", "-orig", s.dir, "-out", out)
+	dir := parseKV(stdout)["dir"]
+	if dir == "" {
+		t.Fatal("build 失敗")
+	}
+	sha := parseKV(stdout)["manifest-sha256"]
+
+	// 不帶 -orig：以預期雜湊表（這裡是縫隙的合成雜湊）驗證，通過；帶相符的 -orig 同樣通過
+	if code, o, e := exec("", "verify", dir); code != 0 || strings.TrimSpace(o) != "manifest-sha256="+sha {
+		t.Errorf("不帶 -orig：%d %q %s", code, o, e)
+	}
+	if code, o, e := exec("", "verify", "-orig", s.dir, dir); code != 0 || strings.TrimSpace(o) != "manifest-sha256="+sha {
+		t.Errorf("帶相符的 -orig：%d %q %s", code, o, e)
+	}
+
+	// 預期雜湊表換成另一份（一個輸入不同）：manifest 記錄的是別份原版，不帶 -orig 也被拒。
+	other := map[string]string{}
+	for k, v := range s.hashes {
+		other[k] = v
+	}
+	other["SP.MES"] = sum([]byte("another original"))
+	origHashesOverride = other
+	if code, o, e := exec("", "verify", dir); code != 1 || o != "" || !strings.Contains(e, "orig-hash") || !strings.Contains(e, "SP.MES") {
+		t.Errorf("manifest 記錄了另一份原版的雜湊，不帶 -orig 應被拒：%d %q %s", code, o, e)
+	}
+	// 帶 -orig 也一樣：-orig 目錄的實際檔案與 manifest 相符，不能讓預設來源的核對失效（舊行為會通過）。
+	if code, o, e := exec("", "verify", "-orig", s.dir, dir); code != 1 || o != "" || !strings.Contains(e, "orig-hash") {
+		t.Errorf("-orig 不得取代預設來源的核對：%d %q %s", code, o, e)
+	}
+
+	// 正式路徑（沒有縫隙，取 required.tsv）：合成原版建出的包被拒
+	origHashesOverride = nil
+	if code, o, e := exec("", "verify", dir); code != 1 || o != "" || !strings.Contains(e, "orig-hash") {
+		t.Errorf("正式路徑：合成原版的包應被 required.tsv 拒絕：%d %q %s", code, o, e)
+	}
+	// manifest 記錄的就是 required.tsv 的雜湊：不帶 -orig 通過（手造的包，不需要真原版）
+	required, err := l10n.ExpectedInputHashes(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	good := writeSyntheticPack(t, required)
+	if code, o, e := exec("", "verify", good); code != 0 || !strings.HasPrefix(o, "manifest-sha256=") {
+		t.Errorf("manifest 與 required.tsv 相符，不帶 -orig 應通過：%d %q %s", code, o, e)
+	}
+	// 帶 -orig 但目錄內的實際雜湊與 manifest 不符（合成原版 ≠ required.tsv 的雜湊）：拒絕，並說明是 -orig 的比對
+	if code, o, e := exec("", "verify", "-orig", s.dir, good); code != 1 || o != "" || !strings.Contains(e, "orig-hash") || !strings.Contains(e, "-orig") {
+		t.Errorf("-orig 的實際雜湊與 manifest 不符應被拒：%d %q %s", code, o, e)
+	}
+	// 原版目錄缺檔：-orig 讀不到就失敗，不退回只用預設來源
+	if code, o, e := exec("", "verify", "-orig", filepath.Join(out, "nope"), good); code != 1 || o != "" || e == "" {
+		t.Errorf("-orig 目錄讀不到：%d %q %s", code, o, e)
+	}
+	// -digest 與預設來源併用：摘要相符通過、不符失敗（手造包的 manifest 摘要是 64 個 0）
+	if code, _, e := exec("", "verify", "-digest", strings.Repeat("0", 64), good); code != 0 {
+		t.Errorf("manifest 的摘要相符時 -digest 應通過：%d %s", code, e)
+	}
+	if code, _, e := exec("", "verify", "-digest", strings.Repeat("1", 64), good); code != 1 || !strings.Contains(e, "digest") {
+		t.Errorf("-digest 不符應失敗：%d %s", code, e)
+	}
+}
