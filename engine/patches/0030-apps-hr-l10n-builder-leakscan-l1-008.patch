+// assertNoContent：輸出不得含任何單位的文字或位元組；stdout 必須是純 ASCII；
+// 輸出本身餵回 ScanContent 必須零命中（輸出若帶出視窗大小的片段，整段比對抓不到，餵回掃描就抓得到）。
+func assertNoContent(t *testing.T, w *world, stream, s string, ascii bool) {
+	t.Helper()
+	if hits := w.ix.ScanContent([]byte(s)); len(hits) != 0 {
+		t.Fatalf("%s 餵回 ScanContent 命中 %d 個單位（例如 %s）：輸出帶出了原版內容", stream, len(hits), w.units[hits[0]].ID)
+	}
+	if ascii {
+		for i := 0; i < len(s); i++ {
+			if s[i] >= 0x80 {
+				t.Fatalf("%s 含非 ASCII 位元組（位置 %d）：輸出只能有路徑與單位身分", stream, i)
+			}
+		}
+	}
+	for _, u := range w.units {
+		if u.Text != "" && strings.Contains(s, u.Text) {
+			t.Fatalf("%s 含單位 %s 的文字", stream, u.ID)
+		}
+		if strings.Contains(s, string(u.Big5)) {
+			t.Fatalf("%s 含單位 %s 的位元組", stream, u.ID)
+		}
+	}
+}
