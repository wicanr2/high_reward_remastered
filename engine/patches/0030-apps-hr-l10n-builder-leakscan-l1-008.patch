+// 葉層屬性：verify 套件的非測試檔只 import 標準庫，不得 import apps/hr/l10n、apps/hr/runtime（它們反過來 import verify，
+// 會成環）或任何第三方套件。標準庫的判定：import 路徑第一段不含 `.`。
+func TestPackageImportsOnlyStdlib(t *testing.T) {
+	ents, err := os.ReadDir(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	checked := 0
+	for _, e := range ents {
+		if e.IsDir() || !strings.HasSuffix(e.Name(), ".go") || strings.HasSuffix(e.Name(), "_test.go") {
+			continue
+		}
+		src, err := os.ReadFile(e.Name())
+		if err != nil {
+			t.Fatal(err)
+		}
+		bad, err := nonStdlibImports(e.Name(), src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		checked++
+		if len(bad) > 0 {
+			t.Errorf("%s import 了標準庫以外的套件：%v", e.Name(), bad)
+		}
+	}
+	if checked == 0 {
+		t.Fatal("沒有檢查到任何非測試檔")
+	}
+}
+
+// nonStdlibImports 回傳 Go 原始碼的 import 路徑中不屬於標準庫的（第一段含 `.`，或指到 apps/hr/l10n、apps/hr/runtime）。
+func nonStdlibImports(name string, src []byte) ([]string, error) {
+	f, err := parser.ParseFile(token.NewFileSet(), name, src, parser.ImportsOnly)
+	if err != nil {
+		return nil, err
+	}
+	var bad []string
+	for _, im := range f.Imports {
+		path, err := strconv.Unquote(im.Path.Value)
+		if err != nil {
+			return nil, err
+		}
+		first, _, _ := strings.Cut(path, "/")
+		if strings.Contains(first, ".") || strings.Contains(path, "apps/hr/l10n") || strings.Contains(path, "apps/hr/runtime") {
+			bad = append(bad, path)
+		}
+	}
+	return bad, nil
+}
+
+// 守護測試自己要會報警：對含禁止 import 的合成原始碼回報，對只有標準庫的不回報。
+func TestNonStdlibImportsDetects(t *testing.T) {
+	for name, tc := range map[string]struct {
+		src  string
+		want int
+	}{
+		"只有標準庫":             {"package x\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"encoding/json\"\n)\n", 0},
+		"import l10n":       {"package x\nimport \"github.com/wicanr2/dosgolem/apps/hr/l10n\"\n", 1},
+		"import 同層 runtime": {"package x\nimport hrrt \"github.com/wicanr2/dosgolem/apps/hr/runtime\"\n", 1},
+		"第三方套件":             {"package x\nimport \"golang.org/x/text/encoding\"\n", 1},
+		"標準庫加兩個禁止":          {"package x\nimport (\n\t\"os\"\n\t\"github.com/wicanr2/dosgolem/apps/hr/l10n/verify\"\n\t\"example.com/y\"\n)\n", 2},
+	} {
+		bad, err := nonStdlibImports("x.go", []byte(tc.src))
+		if err != nil || len(bad) != tc.want {
+			t.Errorf("%s：回報 %v（%v），應有 %d 個", name, bad, err, tc.want)
+		}
+	}
+}
