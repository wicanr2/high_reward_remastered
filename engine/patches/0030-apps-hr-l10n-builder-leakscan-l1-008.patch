+func TestTableHash(t *testing.T) {
+	w := newSynthWorld(t)
+	if h, err := TableHash(t.TempDir()); err != nil || h != emptyTableHash {
+		t.Errorf("空目錄的雜湊 %s（%v），應為空位元組串的 SHA-256", h, err)
+	}
+	rows := []Row{w.row("SP.MES#0", "上下大小", StatusAccepted), w.row("SYSTEM.MES#1", "山水", StatusCandidate)}
+	d1 := w.tableDir(rows...)
+	h1, err := TableHash(d1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// 公式：對「大寫資料檔名 TAB 內容 SHA-256 LF」依檔名排序後取 SHA-256
+	spRaw, _ := os.ReadFile(filepath.Join(d1, "SP.MES.tsv"))
+	sysRaw, _ := os.ReadFile(filepath.Join(d1, "SYSTEM.MES.tsv"))
+	want := sha256Hex([]byte("SP.MES\t" + sha256Hex(spRaw) + "\nSYSTEM.MES\t" + sha256Hex(sysRaw) + "\n"))
+	if h1 != want {
+		t.Errorf("雜湊公式不符：%s vs %s", h1, want)
+	}
+	// 與檔案順序、目錄位置與結構、檔名大小寫無關
+	d2 := filepath.Join(t.TempDir(), "deep", "er", "elsewhere")
+	if err := os.MkdirAll(d2, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(d2, "system.mes.TSV"), sysRaw, 0o644); err != nil { // 先寫後面的
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(d2, "Sp.Mes.Tsv"), spRaw, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(d2, "sub"), 0o755); err != nil { // 子目錄不算
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(d2, "sub", "SP.MES.tsv"), []byte("ignored"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(d2, "notes.txt"), []byte("ignored"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if h2, err := TableHash(d2); err != nil || h2 != h1 {
+		t.Errorf("同樣的內容換目錄與檔名大小寫，雜湊不同：%s vs %s（%v）", h2, h1, err)
+	}
+	// 內容改一個位元組、少一個檔，雜湊都不同
+	d3 := w.tableDir(w.row("SP.MES#0", "上下大小中", StatusAccepted), rows[1])
+	if h3, _ := TableHash(d3); h3 == h1 {
+		t.Error("內容不同雜湊卻相同")
+	}
+	d4 := w.tableDir(rows[0])
+	if h4, _ := TableHash(d4); h4 == h1 {
+		t.Error("少一個檔雜湊卻相同")
+	}
+	// 同一個資料檔名換成別的檔（SP 的內容放進 SYSTEM）：檔名也進雜湊
+	d5 := filepath.Join(t.TempDir(), "x")
+	if err := os.MkdirAll(d5, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(d5, "SYSTEM.MES.tsv"), spRaw, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	d6 := filepath.Join(t.TempDir(), "x")
+	if err := os.MkdirAll(d6, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(d6, "SP.MES.tsv"), spRaw, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	h5, _ := TableHash(d5)
+	h6, _ := TableHash(d6)
+	if h5 == h6 {
+		t.Error("資料檔名沒有進雜湊")
+	}
+	if _, err := TableHash(filepath.Join(t.TempDir(), "nope")); err == nil {
+		t.Error("目錄不存在應回錯")
+	}
+}
