+func segHasFragment(seg []byte, minChars int) bool {
+	run := 0
+	for i := 0; i < len(seg); {
+		if pairAt(seg, i) >= 0 {
+			run++
+			i += 2
+			if run >= minChars {
+				return true
+			}
+			continue
+		}
+		run = 0
+		i++
+	}
+	return false
+}
