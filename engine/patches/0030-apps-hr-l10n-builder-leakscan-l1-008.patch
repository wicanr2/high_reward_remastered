+package main
+
+import (
+	"bytes"
+	"io"
+	"strings"
+	"testing"
+)
+
+func exec(stdin string, args ...string) (int, string, string) {
+	var o, e bytes.Buffer
+	code := run(args, strings.NewReader(stdin), &o, &e)
+	return code, o.String(), e.String()
+}
+
+func TestRunDispatch(t *testing.T) {
+	if code, _, errOut := exec(""); code != 2 || !strings.Contains(errOut, "子命令") {
+		t.Errorf("沒有子命令：退出碼 %d，stderr %q", code, errOut)
+	}
+	if code, _, errOut := exec("", "nope"); code != 2 || !strings.Contains(errOut, "nope") {
+		t.Errorf("未知子命令：退出碼 %d，stderr %q", code, errOut)
+	}
+	for _, name := range []string{"build", "verify"} {
+		// build、verify 已實作（測試在 build_test.go）：未知旗標是用法錯誤，不再回「尚未實作」。
+		code, out, errOut := exec("", name, "-x")
+		if code != 2 || out != "" || strings.Contains(errOut, "尚未實作") || !strings.Contains(errOut, name) {
+			t.Errorf("%s：退出碼 %d，stdout %q，stderr %q", name, code, out, errOut)
+		}
+	}
+}
+
+// 加子命令只需要註冊一個函式；函式拿到的參數不含子命令名稱，退出碼原樣回傳。
+func TestRegisterSubcommand(t *testing.T) {
+	var gotArgs []string
+	var gotIn string
+	commands["probe"] = func(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+		gotArgs = args
+		b, _ := io.ReadAll(stdin)
+		gotIn = string(b)
+		io.WriteString(stdout, "ok")
+		return 7
+	}
+	defer delete(commands, "probe")
+	code, out, _ := exec("input", "probe", "-a", "b")
+	if code != 7 || out != "ok" || gotIn != "input" || strings.Join(gotArgs, " ") != "-a b" {
+		t.Errorf("退出碼 %d，stdout %q，stdin %q，參數 %v", code, out, gotIn, gotArgs)
+	}
+	if _, _, errOut := exec(""); !strings.Contains(errOut, "probe") {
+		t.Errorf("用法應列出新註冊的子命令：%q", errOut)
+	}
+}
diff --git a/apps/hr/cmd/hrl10n/verify.go b/apps/hr/cmd/hrl10n/verify.go
new file mode 100644
index 0000000..3f3550f
--- /dev/null
+++ b/apps/hr/cmd/hrl10n/verify.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+)
+
+// runVerify 實作 `hrl10n verify`（docs/spec/008 第 3.2 節命令列契約）：
+//
+//	verify [-digest <預期摘要>] [-orig <原版目錄>] <語言包目錄>
+//
+// 語言包目錄是含 manifest.json 的包根（`probe`、`hrbot` 的 -lang-dir 取的是它底下的 files/）。
+// 與 Session.Open 共用同一個驗證函式（apps/hr/l10n/verify），原版輸入雜湊的預設來源也相同：
+// runtime 內嵌的 required.tsv（l10n.ExpectedInputHashes，與 Session.Open 的 RequiredFiles 同源），
+// 所以「verify 通過」的條件不弱於實際啟用的條件。
+// 給 -orig 時另外要求該目錄內九個檔案的實際 SHA-256 與 manifest 相符（判斷「這個包是不是由眼前這份原版建的」），
+// 這是疊加的條件，不取代 required.tsv 的核對。
+// 不帶 -digest 時略過輸入摘要這一項，其餘驗證照常。
+// 成功時 stdout 印 `manifest-sha256=<manifest.json 的 SHA-256>` 供收據記錄。
+// 退出碼：0 通過，1 驗證失敗，2 用法錯誤。
+func runVerify(args []string, _ io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("verify", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	digest := fs.String("digest", "", "預期輸入摘要（不給就略過這一項）")
+	orig := fs.String("orig", "", "原版目錄（選填；給了就另外要求目錄內的實際雜湊與 manifest 相符）")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return 0
+		}
+		return 2
+	}
+	if fs.NArg() != 1 {
+		fmt.Fprintln(stderr, "用法：hrl10n verify [-digest <預期摘要>] [-orig <原版目錄>] <語言包目錄>")
+		return 2
+	}
+	root := fs.Arg(0)
+	want, err := l10n.ExpectedInputHashes(origHashesOverride)
+	if err != nil {
+		fmt.Fprintf(stderr, "hrl10n verify：%v\n", err)
+		return 1
+	}
+	m, err := verify.Verify(root, verify.Options{OrigHashes: want, ExpectDigest: *digest, SkipDigest: *digest == ""})
+	if err != nil {
+		fmt.Fprintf(stderr, "hrl10n verify：%v\n", err)
+		return 1
+	}
+	if *orig != "" {
+		actual, err := l10n.OrigInputHashes(*orig)
+		if err != nil {
+			fmt.Fprintf(stderr, "hrl10n verify：%v\n", err)
+			return 1
+		}
+		// 第二輪只為比對 manifest 與 -orig 目錄的實際雜湊（摘要與檔案已在第一輪驗過）。
+		if _, err := verify.Verify(root, verify.Options{OrigHashes: actual, SkipDigest: true}); err != nil {
+			fmt.Fprintf(stderr, "hrl10n verify：與 -orig 目錄內的實際檔案不符：%v\n", err)
+			return 1
+		}
+	}
+	sum, err := verify.ManifestSHA256(root)
+	if err != nil {
+		fmt.Fprintf(stderr, "hrl10n verify：%v\n", err)
+		return 1
+	}
+	fmt.Fprintf(stdout, "manifest-sha256=%s\n", sum)
+	skipped := ""
+	if *digest == "" {
+		skipped = "（略過輸入摘要）"
+	}
+	fmt.Fprintf(stderr, "hrl10n verify：通過%s，%d 個檔案，模式 %s，採用 %d 列\n", skipped, len(m.Files), m.Policy.Mode, m.Adopted)
+	return 0
+}
diff --git a/apps/hr/l10n/adopt_extra_test.go b/apps/hr/l10n/adopt_extra_test.go
new file mode 100644
index 0000000..5522eab
--- /dev/null
+++ b/apps/hr/l10n/adopt_extra_test.go
@@ -0,0 +1,171 @@
+package l10n
+
+import (
+	"strings"
+	"testing"
+)
+
+// S1：GroupExceptionNote 的比對帶邊界（以 `;` 或 `；` 切片段，去掉前後空白後恰好相等）。
+func TestGroupExceptionBoundary(t *testing.T) {
+	cases := map[string]bool{
+		"group-exception":                true,
+		"  group-exception  ":            true,
+		"語境不同; group-exception":          true,
+		"group-exception；譯名另議":           true,
+		"甲;group-exception;乙":            true,
+		"":                               false,
+		"不是 group-exception":             false,
+		"group-exceptions":               false,
+		"xgroup-exception":               false,
+		"group-exception!":               false,
+		"no group-exception here":        false,
+		"group-exception 與 group-except": false,
+		"group exception":                false,
+		"GROUP-EXCEPTION":                false,
+	}
+	for note, want := range cases {
+		if got := hasGroupException(note); got != want {
+			t.Errorf("hasGroupException(%q) ＝ %v，應為 %v", note, got, want)
+		}
+	}
+	// 經由 Adopt：否定句的 note 不能讓該列退出同群組比對。
+	cs := mustCharmap(t)
+	f := uwasaFile(t)
+	rows := func(note string) *Table {
+		a, b := mkRow(f, 0, StatusAccepted, txtA), mkRow(f, 2, StatusAccepted, txtB)
+		b.Note = note
+		return &Table{Rows: []Row{a, b}}
+	}
+	if _, _, viol, _ := rows("不是 "+GroupExceptionNote).Adopt(f, Policy{}, cs, nil); len(viol) != 1 {
+		t.Errorf("否定句不是例外記號，同群組不一致應失敗：%v", viol)
+	}
+	if _, n, viol, _ := rows("語境不同；"+GroupExceptionNote).Adopt(f, Policy{}, cs, nil); len(viol) != 0 || n != 2 {
+		t.Errorf("帶邊界的例外記號應放行：%v 採用 %d", viol, n)
+	}
+}
+
+// S3：ESPMES 項目查不到窗口類別，併入違規，不丟掉已累積的違規。
+func TestAdoptMissingWindowClassKeepsOtherViolations(t *testing.T) {
+	cs := mustCharmap(t)
+	odd := mustParse(t, "ESPMES.MRG", buildESP(10, map[int][]string{5: {"a", "b", "c"}}))
+	badSrc := mkRow(odd, 0, StatusAccepted, txtA)
+	badSrc.SrcSHA = "0000000000000000"
+	noClass := mkRow(odd, 1, StatusAccepted, txtB)
+	badRune := mkRow(odd, 2, StatusAccepted, "汉")
+	tb := &Table{Rows: []Row{badSrc, noClass, badRune}}
+	calls := 0
+	chk := func(file, class, id string, orig, trans []byte) []string { calls++; return nil }
+	repl, n, viol, err := tb.Adopt(odd, Policy{}, cs, chk)
+	if err != nil {
+		t.Fatalf("查不到窗口類別不是結構性錯誤：%v", err)
+	}
+	if repl != nil || n != 0 || len(viol) != 3 || calls != 0 {
+		t.Fatalf("違規 %d 條（應為 3）、Checker 呼叫 %d 次：\n%s", len(viol), calls, strings.Join(viol, "\n"))
+	}
+	for i, sub := range []string{"ESPMES#5.0: src_sha256", "ESPMES#5.1: esp-windows.tsv", "ESPMES#5.2: 字集外的字"} {
+		if !strings.Contains(viol[i], sub) {
+			t.Errorf("違規 %d ＝ %q，應含 %q", i, viol[i], sub)
+		}
+	}
+}
+
+// 審查 S9：SHOPTAB 名稱是單行欄位，Adopt 拒絕含換行的名稱。
+func TestAdoptShopRejectsNewline(t *testing.T) {
+	cs := mustCharmap(t)
+	shop := mustParse(t, "SHOPTAB.TBL", buildShop(1, []string{"AB", "CD"}))
+	tb := &Table{Rows: []Row{
+		mkRow(shop, 0, StatusAccepted, txtA+"\n"+txtB),
+		mkRow(shop, 1, StatusAccepted, txtA+txtB),
+	}}
+	_, n, viol, err := tb.Adopt(shop, Policy{AllowShoptab: true}, cs, nil)
+	if err != nil || n != 0 || len(viol) != 1 || !containsAll(viol[0], "SHOPTAB#0.0", "換行") {
+		t.Errorf("含換行的名稱：採用 %d 違規 %v err %v", n, viol, err)
+	}
+	ok := &Table{Rows: tb.Rows[1:]}
+	if repl, n, viol, err := ok.Adopt(shop, Policy{AllowShoptab: true}, cs, nil); err != nil || len(viol) != 0 || n != 1 || len(repl["SHOPTAB#0.1"]) != 8 {
+		t.Errorf("單行名稱：%v %v %d", viol, err, n)
+	}
+}
+
+// SHOPTAB 名稱欄略過預算套件（沒有窗口），佔位符規則由 Adopt 補上：名稱內的轉換規格必須與原項目逐字相同
+// （個數、順序、型別），原項目沒有就不得有；違規點名 id 與規則鍵 placeholder，細節不含譯文。
+func TestAdoptShopPlaceholderRule(t *testing.T) {
+	cs := mustCharmap(t)
+	// 項目 0 到 3 的原名稱：一個 %s、沒有規格、一個 %d、%s 接 %d（原名稱是自造的 ASCII）。
+	shop := mustParse(t, "SHOPTAB.TBL", buildShop(1, []string{"AB%sCD", "EF", "GH%dIJ", "KL%sMN%d"}))
+	pol := Policy{AllowShoptab: true}
+	for _, c := range []struct {
+		name string
+		idx  int
+		text string
+		ok   bool
+	}{
+		{"原項目沒有規格，譯文加 %s", 1, txtA + "%s", false},
+		{"原項目沒有規格，譯文也沒有", 1, txtA + txtB, true},
+		{"原項目的 %s 原樣保留", 0, txtC + "%s", true},
+		{"原項目的 %s 被拿掉", 0, txtA + txtB, false},
+		{"%s 換成 %d", 0, txtC + "%d", false},
+		{"%s 變成兩個", 0, "%s" + txtC + "%s", false},
+		{"%d 原樣保留", 2, "%d" + txtA, true},
+		{"%d 的寬度旗標不同（逐字相同才算）", 2, "%03d" + txtA, false},
+		{"%s 接 %d 原樣保留", 3, txtA + "%s" + txtB + "%d", true},
+		{"%s 接 %d 順序對調", 3, txtA + "%d" + txtB + "%s", false},
+		{"%s 接 %d 少一個", 3, txtA + "%s", false},
+	} {
+		tb := &Table{Rows: []Row{mkRow(shop, c.idx, StatusAccepted, c.text)}}
+		repl, n, viol, err := tb.Adopt(shop, pol, cs, nil)
+		id := shop.Items[c.idx].ID
+		if err != nil {
+			t.Errorf("%s：%v", c.name, err)
+			continue
+		}
+		if c.ok {
+			if len(viol) != 0 || n != 1 || len(repl[id]) == 0 {
+				t.Errorf("%s：應通過：採用 %d 違規 %v", c.name, n, viol)
+			}
+			continue
+		}
+		if len(viol) != 1 || n != 0 || repl != nil || !containsAll(viol[0], "SHOPTAB.TBL", id, "placeholder") {
+			t.Errorf("%s：應回一條 placeholder 違規：採用 %d 違規 %v", c.name, n, viol)
+			continue
+		}
+		if strings.ContainsAny(viol[0], txtA+txtB+txtC+"%") {
+			t.Errorf("%s：違規字串含譯文或規格文字：%q", c.name, viol[0])
+		}
+	}
+	// 其他 SHOPTAB 規則仍先於佔位符規則（超長、換行不會多報一條 placeholder）
+	long := &Table{Rows: []Row{mkRow(shop, 1, StatusAccepted, strings.Repeat(txtA, 6)+"%s")}}
+	if _, _, viol, _ := long.Adopt(shop, pol, cs, nil); len(viol) != 1 || strings.Contains(viol[0], "placeholder") {
+		t.Errorf("超長的名稱只該回長度違規：%v", viol)
+	}
+}
+
+// 審查 S9：Policy.SerializeOptions 導出與政策配套的序列化選項。
+func TestPolicySerializeOptions(t *testing.T) {
+	if (Policy{}).SerializeOptions().ExactCountryOffsets {
+		t.Error("預設政策不重算 COUNTRY.MES 偏移")
+	}
+	if !(Policy{AllowCountryOffsets: true}).SerializeOptions().ExactCountryOffsets {
+		t.Error("AllowCountryOffsets 要導出 ExactCountryOffsets")
+	}
+	for _, p := range []Policy{{WithCandidates: true}, {AllowShoptab: true}} {
+		if p.SerializeOptions().ExactCountryOffsets {
+			t.Errorf("%+v 不應影響 COUNTRY.MES 偏移", p)
+		}
+	}
+	// 端到端：Adopt 加導出的選項可以序列化含譯文的 COUNTRY.MES；選項漏設就失敗。
+	cs := mustCharmap(t)
+	country := mustParse(t, "COUNTRY.MES", buildMES([]string{"甲", "乙"}, 1))
+	tb := &Table{Rows: []Row{mkRow(country, 0, StatusAccepted, txtA)}}
+	pol := Policy{AllowCountryOffsets: true}
+	repl, _, viol, err := tb.Adopt(country, pol, cs, nil)
+	if err != nil || len(viol) != 0 {
+		t.Fatalf("%v %v", viol, err)
+	}
+	if _, err := country.Serialize(repl, pol.SerializeOptions()); err != nil {
+		t.Errorf("導出的選項應能序列化：%v", err)
+	}
+	if _, err := country.Serialize(repl, SerializeOptions{}); err == nil {
+		t.Error("沒有 ExactCountryOffsets 應失敗")
+	}
+}
diff --git a/apps/hr/l10n/budget/check.go b/apps/hr/l10n/budget/check.go
new file mode 100644
index 0000000..287d8b3
--- /dev/null
+++ b/apps/hr/l10n/budget/check.go
@@ -0,0 +1,153 @@
+package budget
+
+import "fmt"
+
+// 規則鍵（規格第 3.5 節檢查表）。`line-width`、`expanded-width`、`rows` 依序是行寬規則的 (1)、(2)、(3)。
+const (
+	RuleLength        = "length"
+	RuleControl       = "control"
+	RuleSpace         = "space"
+	RuleWhitelist     = "whitelist"
+	RulePlaceholder   = "placeholder"
+	RuleLineWidth     = "line-width"
+	RuleExpandedWidth = "expanded-width"
+	RuleRows          = "rows"
+	Rule1676          = "1676"
+)
+
+// maxItemLen 是單項長度上限：`3E41:0423` 容量 0x200 含結尾 NUL（`docs/re/023` 第 3 節）。
+const maxItemLen = 511
+
+// Input 是一個譯文項目的檢查輸入。
+type Input struct {
+	ID    string // 回報用，例如 "ESPMES#121.0"
+	File  string
+	Class string // 只有 ESPMES 用
+	Orig  []byte // 原項目位元組，已去掉結尾 NUL，保留內部 0x0A
+	Trans []byte // 譯文位元組（已是 Big5 與單位元組的編碼結果），去掉結尾 NUL
+
+	// BreakAfter 供 `AutoWrap` 判定「標點之後優先折」：回傳 true 表示在這個雙位元組字（lead、trail）之後折算標點折點。
+	// 可選；nil 時用 zh-TW 預設（lead 等於 A1）。L2 之後全形標點配自訂碼，由字集決定。`Check` 不用它。
+	BreakAfter func(lead, trail byte) bool
+}
+
+// Violation 是一項違規。Detail 只含位元組偏移、行號與數字，不含文字內容。
+type Violation struct {
+	ID     string
+	Rule   string
+	Detail string
+}
+
+// 單位元組白名單（規格第 3.5 節）：0x0A、數字、`/`、`:`、大寫字母。
+// 與原項目相同的 `%` 序列另外由佔位符規則處理。
+func whitelisted(c byte) bool {
+	return c == 0x0A || c >= '0' && c <= '9' || c == '/' || c == ':' || c >= 'A' && c <= 'Z'
+}
+
+// Check 回傳譯文的全部違規（空切片表示通過）。規則 (1) 至 (3) 與計算慣例見規格第 3.5 節：
+//   - (1) 每行字面位元組 <= W
+//   - (2) 每行展開位元組 <= max(W, E_item)
+//   - (3) 項目渲染列數 <= max(H, R_item)
+//
+// 窗口未知的檔名或類別回一項 `line-width` 違規（失敗即關閉）。
+func Check(in Input) []Violation {
+	var vs []Violation
+	add := func(rule, f string, a ...any) {
+		vs = append(vs, Violation{ID: in.ID, Rule: rule, Detail: fmt.Sprintf(f, a...)})
+	}
+	win, ok := WindowFor(in.File, in.Class)
+	if !ok {
+		add(RuleLineWidth, "unknown-window")
+		return vs
+	}
+	t := in.Trans
+	us := scanUnits(t)
+	lines := splitLines(us, len(t))
+	eItem, rItem := itemMetrics(in.Orig, win)
+
+	// 單項長度：原始位元組與展開後的最壞值都不得超過上限
+	exp := len(lines) - 1 // 換行
+	for _, l := range lines {
+		exp += l.exp
+	}
+	if len(t) > maxItemLen || exp > maxItemLen {
+		add(RuleLength, "raw=%d expanded=%d limit=%d", len(t), exp, maxItemLen)
+	}
+
+	// 控制碼、空白、白名單：逐單位檢查，每個違規位元組只回報在一條規則下
+	for _, u := range us {
+		switch u.kind {
+		case uSingle:
+			c := t[u.off]
+			switch {
+			case c < 0x20: // 含 0x00；0x0A 在 scanUnits 已是換行單位
+				add(RuleControl, "offset=%d", u.off)
+			case c == 0x20:
+				add(RuleSpace, "offset=%d", u.off)
+			case !whitelisted(c) && !u.bad:
+				add(RuleWhitelist, "offset=%d", u.off)
+			}
+		case uPair:
+			switch tr := t[u.off+1]; {
+			case tr < 0x20:
+				add(RuleControl, "offset=%d trail", u.off+1)
+			case tr == 0x20:
+				add(RuleSpace, "offset=%d trail", u.off+1)
+			}
+		case uLone:
+			if u.off+1 < len(t) && t[u.off+1] == 0x0A {
+				add(RuleControl, "offset=%d newline-as-trail", u.off)
+			} else {
+				add(RuleWhitelist, "offset=%d lone-lead", u.off)
+			}
+		}
+	}
+
+	// 佔位符：完整轉換規格的個數、順序、型別與原項目相同
+	origSpecs := specTexts(in.Orig, scanUnits(in.Orig))
+	transSpecs := specTexts(t, us)
+	for _, u := range us {
+		if u.kind == uSingle && u.bad {
+			add(RulePlaceholder, "malformed offset=%d", u.off)
+		}
+	}
+	if len(origSpecs) != len(transSpecs) {
+		add(RulePlaceholder, "count orig=%d trans=%d", len(origSpecs), len(transSpecs))
+	} else {
+		for i := range origSpecs {
+			if origSpecs[i] != transSpecs[i] {
+				add(RulePlaceholder, "index=%d mismatch", i)
+			}
+		}
+	}
+
+	// 行寬 (1)、(2)，渲染列數 (3)，`1676` 模擬
+	rows := 0
+	for i, l := range lines {
+		if l.lit > win.W {
+			add(RuleLineWidth, "line=%d literal=%d limit=%d", i, l.lit, win.W)
+		}
+		if l.exp > max(win.W, eItem) {
+			add(RuleExpandedWidth, "line=%d expanded=%d limit=%d", i, l.exp, max(win.W, eItem))
+		}
+		rows += rowsFor(l.exp, win.W)
+		if l.term && LineEatsNewlineAdversarial(t[l.start:l.end+1]) {
+			add(Rule1676, "line=%d", i)
+		}
+	}
+	if rows > max(win.H, rItem) {
+		add(RuleRows, "rows=%d limit=%d", rows, max(win.H, rItem))
+	}
+	return vs
+}
+
+// specTexts 取出各轉換規格的完整文字，依出現順序。
+func specTexts(b []byte, us []unit) []string {
+	var out []string
+	for _, u := range us {
+		if u.kind == uSpec {
+			out = append(out, string(b[u.off:u.off+u.n]))
+		}
+	}
+	return out
+}
diff --git a/apps/hr/l10n/budget/check_test.go b/apps/hr/l10n/budget/check_test.go
new file mode 100644
index 0000000..4c744ef
--- /dev/null
+++ b/apps/hr/l10n/budget/check_test.go
@@ -0,0 +1,437 @@
+package budget
+
+import (
+	"reflect"
+	"strconv"
+	"testing"
+)
+
+// 窗口表（規格第 3.5 節）：行寬、行數、容量逐項對照規格寫死的值。
+func TestWindowFor(t *testing.T) {
+	tests := []struct {
+		file, class string
+		want        Window
+		ok          bool
+	}{
+		{"ESPMES", "win31x4", Window{30, 4, 31}, true},
+		{"ESPMES", "win63x8", Window{62, 8, 63}, true},
+		{"ESPMES", "win29x4", Window{28, 4, 29}, true},
+		{"ESPMES", "none", Window{30, 4, 31}, true},
+		{"ESPMES.MRG", "win31x4", Window{30, 4, 31}, true},
+		{"espmes", "win63x8", Window{62, 8, 63}, true},
+		{"SP.MES", "", Window{70, 4, 71}, true},
+		{"COUNTRY.MES", "", Window{66, 5, 67}, true},
+		{"UWASA.MES", "", Window{30, 4, 31}, true},
+		{"SYSTEM.MES", "", Window{30, 4, 31}, true},
+		{"POWERMES.MES", "", Window{30, 4, 31}, true},
+		{"SYSTEM.MES", "win63x8", Window{30, 4, 31}, true}, // class 只有 ESPMES 用
+		{"ESPMES", "", Window{}, false},                    // 類別未知
+		{"ESPMES", "win99x9", Window{}, false},
+		{"SHOPTAB.TBL", "", Window{}, false},
+		{"", "", Window{}, false},
+	}
+	for _, tc := range tests {
+		got, ok := WindowFor(tc.file, tc.class)
+		if ok != tc.ok || got != tc.want {
+			t.Errorf("WindowFor(%q, %q) = %+v, %v，要 %+v, %v", tc.file, tc.class, got, ok, tc.want, tc.ok)
+		}
+		if ok && (got.W%2 != 0 || got.W != got.Cap-1-(got.Cap-1)%2) {
+			t.Errorf("%q %q：W=%d 不是容量 %d 減一格向下取偶數", tc.file, tc.class, got.W, got.Cap)
+		}
+	}
+}
+
+// 行寬 W 取窗口容量減一格再向下取偶數：窗口表的容量都是奇數所以減一已是偶數，偶數容量才用得到向下取偶數。
+func TestNewWindowEvenFloor(t *testing.T) {
+	for _, tc := range []struct{ capacity, w int }{{31, 30}, {32, 30}, {33, 32}, {2, 0}} {
+		if got := newWindow(tc.capacity, 4); got.W != tc.w || got.Cap != tc.capacity || got.H != 4 {
+			t.Errorf("newWindow(%d, 4) = %+v，W 要 %d", tc.capacity, got, tc.w)
+		}
+	}
+}
+
+// okInput 是通過全部檢查的基準輸入：ESPMES win31x4（W 30、H 4、Cap 31），
+// 原項目 2 行（20、10 bytes），譯文 2 行（24、12 bytes），都是 S 集的雙位元組字。
+func okInput() Input {
+	return Input{
+		ID:    "ESPMES#0.0",
+		File:  "ESPMES",
+		Class: "win31x4",
+		Orig:  cat(pairs(0xA4, 0x40, 10), nl, pairs(0xA4, 0x40, 5)),
+		Trans: cat(pairs(0xA4, 0x40, 12), nl, pairs(0xA4, 0x50, 6)),
+	}
+}
+
+func TestCheckPass(t *testing.T) {
+	in := okInput()
+	if vs := Check(in); len(vs) != 0 {
+		t.Fatalf("基準輸入應通過：%+v", vs)
+	}
+	// 白名單內的單位元組：數字、`/`、`:`、大寫字母，單位元組字放在行尾
+	in.Trans = cat(pairs(0xA4, 0x40, 4), []byte("12/05:AB"), nl, []byte("Z9"))
+	if vs := Check(in); len(vs) != 0 {
+		t.Fatalf("白名單字元應通過：%+v", vs)
+	}
+	// 單位元組白名單逐值對照（0x30 至 0x39、`/`、`:`、0x41 至 0x5A，加換行）
+	for b := 0; b < 256; b++ {
+		want := b == 0x0A || b >= 0x30 && b <= 0x39 || b == 0x2F || b == 0x3A || b >= 0x41 && b <= 0x5A
+		if got := whitelisted(byte(b)); got != want {
+			t.Errorf("whitelisted(%02X) = %v，要 %v", b, got, want)
+		}
+	}
+	// 與原項目相同的 `%` 序列（含 `%03d`、`%ld`），字面 25 bytes 在 30 以內，展開 43 在 max(30, E_item) 以內
+	in.Orig = cat([]byte("%s%03d%ld"), pairs(0xA4, 0x40, 8))
+	in.Trans = cat(pairs(0xA4, 0x40, 3), []byte("%s%03d%ld"), pairs(0xA4, 0x40, 5))
+	if vs := Check(in); len(vs) != 0 {
+		t.Fatalf("相同佔位符應通過：%+v", vs)
+	}
+}
+
+// 每條規則各一個違規輸入，違規的規則鍵恰為該規則（別的規則都不該被牽動）。
+func TestCheckRules(t *testing.T) {
+	longLines := func(n int) []byte { // n 行、每行 30 個 S 集雙位元組字（60 bytes）
+		var b []byte
+		for i := 0; i < n; i++ {
+			if i > 0 {
+				b = append(b, nl...)
+			}
+			b = append(b, pairs(0xA4, 0x40, 30)...)
+		}
+		return b
+	}
+	tests := []struct {
+		name string
+		in   func() Input
+		want []string
+	}{
+		{"單項長度：9 行 x 60 bytes ＝ 548 > 511", func() Input {
+			return Input{File: "ESPMES", Class: "win63x8", Orig: longLines(9), Trans: longLines(9)}
+		}, []string{RuleLength}},
+		{"控制碼：0x01 在行首", func() Input {
+			in := okInput()
+			in.Trans = cat([]byte{0x01}, pairs(0xA4, 0x40, 12), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleControl}},
+		{"控制碼：0x00", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 3), []byte{0x00}, pairs(0xA4, 0x40, 3), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleControl}},
+		{"控制碼：trail 在 01 至 1F", func() Input {
+			in := okInput()
+			in.Trans = cat(hb("A4 05"), pairs(0xA4, 0x40, 10), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleControl}},
+		{"控制碼：0A 落在 trail 位置（lead 後直接換行）", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 5), hb("A4 0A"), pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleControl}},
+		{"空白：0x20", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 3), []byte{0x20}, pairs(0xA4, 0x40, 3), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleSpace}},
+		{"空白：trail 是 0x20", func() Input {
+			in := okInput()
+			in.Trans = cat(hb("A4 20"), pairs(0xA4, 0x40, 10), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleSpace}},
+		{"白名單：小寫字母", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 3), []byte("a"), pairs(0xA4, 0x40, 3), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleWhitelist}},
+		{"白名單：標點 `.`", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 3), []byte("."), pairs(0xA4, 0x40, 3), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleWhitelist}},
+		{"白名單：0x7F", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 3), []byte{0x7F}, pairs(0xA4, 0x40, 3), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleWhitelist}},
+		{"白名單：串尾沒有 trail 的 lead", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 12), nl, pairs(0xA4, 0x50, 5), []byte{0xA4})
+			return in
+		}, []string{RuleWhitelist}},
+		{"白名單：lead 之後直接接 `%s`（`%` 擋在 lead 與 trail 之間）", func() Input {
+			in := okInput()
+			in.Orig = cat([]byte("%s"), pairs(0xA4, 0x40, 5))
+			in.Trans = cat(pairs(0xA4, 0x40, 2), []byte{0xA4}, []byte("%s"), pairs(0xA4, 0x40, 2))
+			return in
+		}, []string{RuleWhitelist}},
+		{"控制碼加白名單：lead 之後接 NUL（NUL 不當 trail）", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 3), hb("A4 00"), pairs(0xA4, 0x40, 3), nl, pairs(0xA4, 0x50, 6))
+			return in
+		}, []string{RuleControl, RuleWhitelist}},
+		{"佔位符：個數少一個", func() Input {
+			in := okInput()
+			in.Orig = cat([]byte("%s"), pairs(0xA4, 0x40, 5))
+			in.Trans = pairs(0xA4, 0x40, 6)
+			return in
+		}, []string{RulePlaceholder}},
+		{"佔位符：個數多一個", func() Input {
+			in := okInput()
+			in.Trans = cat([]byte("%d"), pairs(0xA4, 0x40, 6))
+			return in
+		}, []string{RulePlaceholder}},
+		{"佔位符：順序不同", func() Input {
+			in := okInput()
+			in.Orig = cat([]byte("%s"), pairs(0xA4, 0x40, 3), []byte("%d"))
+			in.Trans = cat([]byte("%d"), pairs(0xA4, 0x40, 3), []byte("%s"))
+			return in
+		}, []string{RulePlaceholder}},
+		{"佔位符：型別不同", func() Input {
+			in := okInput()
+			in.Orig = cat([]byte("%d"), pairs(0xA4, 0x40, 3))
+			in.Trans = cat([]byte("%ld"), pairs(0xA4, 0x40, 3))
+			return in
+		}, []string{RulePlaceholder}},
+		{"佔位符：寬度不同", func() Input {
+			in := okInput()
+			in.Orig = cat([]byte("%03d"), pairs(0xA4, 0x40, 3))
+			in.Trans = cat([]byte("%d"), pairs(0xA4, 0x40, 3))
+			return in
+		}, []string{RulePlaceholder}},
+		{"行寬 (1)：字面超過 W 而展開在 max(W, E_item) 內（SYSTEM.MES，窗口未知比照 30）", func() Input {
+			// 原項目 `%s` 加 22 個雙位元組字：E_item = 64；譯文 `%s` 加 19 個雙位元組字：字面 40 > 30，展開 58 <= 64
+			return Input{File: "SYSTEM.MES",
+				Orig:  cat([]byte("%s"), pairs(0xA4, 0x40, 22)),
+				Trans: cat([]byte("%s"), pairs(0xA4, 0x40, 19))}
+		}, []string{RuleLineWidth}},
+		{"行寬 (1)：窗口未知，原項目含 `%s`（E_item = 64），譯文一行 40 個字面位元組不含 `%`", func() Input {
+			return Input{File: "SYSTEM.MES",
+				Orig:  cat([]byte("%s"), pairs(0xA4, 0x40, 22)),
+				Trans: pairs(0xA4, 0x40, 20)}
+		}, []string{RuleLineWidth, RulePlaceholder}},
+		{"行寬 (1)：窗口未知，不含 `%` 的 40 字面位元組", func() Input {
+			return Input{File: "SYSTEM.MES", Class: "",
+				Orig:  cat(pairs(0xA4, 0x40, 22)),
+				Trans: pairs(0xA4, 0x40, 20)}
+		}, []string{RuleLineWidth}},
+		{"行寬 (2)：展開位元組超過 max(W, E_item)", func() Input {
+			in := okInput()
+			in.Orig = cat([]byte("%s"), pairs(0xA4, 0x40, 4)) // E_item = 28
+			in.Trans = cat([]byte("%s"), pairs(0xA4, 0x40, 12))
+			return in
+		}, []string{RuleExpandedWidth}},
+		{"渲染列數 (3)：`ESPMES#118.2` 類比，字面與展開都合格而渲染列數 5 > max(4, 3)", func() Input {
+			in := okInput()
+			in.Orig = cat([]byte("%s"), pairs(0xA4, 0x40, 9), []byte("%s"), pairs(0xA4, 0x40, 11))
+			l1 := cat([]byte("%s"), pairs(0xA4, 0x40, 11), []byte("1"))
+			l2 := cat(pairs(0xA4, 0x40, 5), []byte("%s"), pairs(0xA4, 0x40, 6), []byte("2"))
+			l3 := pairs(0xA4, 0x40, 5)
+			in.Trans = cat(l1, nl, l2, nl, l3)
+			return in
+		}, []string{RuleRows}},
+		{"渲染列數 (3)：`R_item` 反例，5 行各 30 bytes，R_item = 4", func() Input {
+			in := okInput()
+			in.Orig = cat(pairs(0xA4, 0x40, 15), []byte("1"), nl, pairs(0xA4, 0x40, 2), nl, pairs(0xA4, 0x40, 2), nl, pairs(0xA4, 0x40, 2))
+			var tr []byte
+			for i := 0; i < 5; i++ {
+				if i > 0 {
+					tr = append(tr, nl...)
+				}
+				tr = append(tr, pairs(0xA4, 0x40, 15)...)
+			}
+			in.Trans = tr
+			return in
+		}, []string{RuleRows}},
+		{"渲染列數 (3)：譯文端除數是 W 不是容量（展開恰 31）", func() Input {
+			in := okInput()
+			// 原項目與譯文都是 4 行，每行 `%s` 加 11 個字面位元組：展開恰 31，E_item = 31，R_item = 4 x 1。
+			// 譯文端除數取 W = 30，每行 2 列共 8 列 > max(4, 4)；除數取容量 31 則每行 1 列，會被放行。
+			line := cat([]byte("%s"), pairs(0xA4, 0x40, 5), []byte("1"))
+			in.Orig = cat(line, nl, line, nl, line, nl, line)
+			in.Trans = cat(line, nl, line, nl, line, nl, line)
+			return in
+		}, []string{RuleRows}},
+		{"渲染列數 (3)：結尾 0A 多出一個空行也算一列", func() Input {
+			in := okInput()
+			in.Orig = pairs(0xA4, 0x40, 3)
+			in.Trans = cat(pairs(0xA4, 0x40, 3), nl, nl, nl, nl)
+			return in
+		}, []string{RuleRows}},
+		{"1676：行尾字 (S 集 lead、P 集 trail) 吃掉換行", func() Input {
+			in := okInput()
+			in.Trans = cat(pairs(0xA4, 0x40, 5), hb("A4 E0"), nl, pairs(0xA4, 0x50, 3))
+			return in
+		}, []string{Rule1676}},
+		{"1676：`%s` 緊接 0A", func() Input {
+			in := okInput()
+			in.Orig = cat(pairs(0xA4, 0x40, 3), []byte("%s"), nl, pairs(0xA4, 0x50, 3))
+			in.Trans = cat(pairs(0xA4, 0x40, 3), []byte("%s"), nl, pairs(0xA4, 0x50, 3))
+			return in
+		}, []string{Rule1676}},
+	}
+	for i, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			in := tc.in()
+			in.ID = "ID#" + strconv.Itoa(i)
+			vs := Check(in)
+			wantRules(t, vs, tc.want...)
+			for _, v := range vs {
+				if v.ID != in.ID {
+					t.Errorf("Violation.ID = %q，要 %q", v.ID, in.ID)
+				}
+			}
+		})
+	}
+}
+
+// 單項長度規則的展開值：沒有展開時 548 bytes 超過上限；有 `%s` 時，字面 <= 511 但展開後 > 511 也要擋。
+func TestCheckLengthExpanded(t *testing.T) {
+	// win63x8：W 62、H 8。8 行各含 20 個字加 `%s` 與一個數字，加最後一行 20 個字：
+	// 字面 8*(40+2+1+1)+40 = 392，展開 8*61+40+8 個換行 = 536 > 511
+	var o []byte
+	for i := 0; i < 8; i++ {
+		o = append(o, cat(pairs(0xA4, 0x40, 20), []byte("%s1"), nl)...)
+	}
+	o = append(o, pairs(0xA4, 0x40, 20)...)
+	in := Input{ID: "x", File: "ESPMES", Class: "win63x8", Orig: o, Trans: o}
+	if len(o) > maxItemLen {
+		t.Fatalf("樣本字面長度 %d 不該超過 511", len(o))
+	}
+	vs := Check(in)
+	wantRules(t, vs, RuleLength)
+	// 同樣的項目把 `%s` 去掉（字面與展開都在 511 以內）就不觸發 length
+	in.Orig = bytesReplaceAll(o, "%s", "")
+	in.Trans = in.Orig
+	if vs := Check(in); len(vs) != 0 {
+		t.Fatalf("沒有 %%s 的版本應通過：%+v", vs)
+	}
+}
+
+// 單項長度的邊界：511 bytes 通過，512 bytes 被擋（`3E41:0423` 容量 0x200 含 NUL）。
+// win63x8（W 62、H 8），9 行，原項目與譯文相同所以 R_item ＝ 9，渲染列數不構成限制。
+func TestCheckLengthBoundary(t *testing.T) {
+	mk := func(last []byte) []byte {
+		var b []byte
+		for i := 0; i < 8; i++ {
+			b = append(b, pairs(0xA4, 0x40, 31)...) // 62 bytes
+			b = append(b, nl...)
+		}
+		return append(b, last...)
+	}
+	for _, tc := range []struct {
+		name string
+		last []byte
+		n    int
+		want []string
+	}{
+		{"511 bytes", cat(pairs(0xA4, 0x40, 3), []byte("1")), 511, nil},
+		{"512 bytes", pairs(0xA4, 0x40, 4), 512, []string{RuleLength}},
+	} {
+		b := mk(tc.last)
+		if len(b) != tc.n {
+			t.Fatalf("%s：樣本長度 %d", tc.name, len(b))
+		}
+		vs := Check(Input{File: "ESPMES", Class: "win63x8", Orig: b, Trans: b})
+		wantRules(t, vs, tc.want...)
+	}
+}
+
+// 單項長度的展開值要計換行位元組：win63x8，原項目與譯文相同。行樣板是 20 個字加 `%s1` 加換行，
+// 重複 8 行（字面 44、展開 61 加 1 個換行），尾行 7 個字加 `1`（15 bytes）使總展開 511，通過；
+// 尾行 8 個字（16 bytes）使總展開 512，只回 length。兩者字面總長（367、368）都小於 511，
+// 不會被原始位元組數那一支擋下，所以只有展開值計入換行才分得出 511 與 512。
+func TestCheckLengthExpandedNewline(t *testing.T) {
+	line := cat(pairs(0xA4, 0x40, 20), []byte("%s1"), nl)
+	var head []byte
+	for i := 0; i < 8; i++ {
+		head = append(head, line...)
+	}
+	for _, tc := range []struct {
+		name string
+		tail []byte
+		raw  int
+		want []string
+	}{
+		{"展開 511 通過", cat(pairs(0xA4, 0x40, 7), []byte("1")), 367, nil},
+		{"展開 512 只回 length", pairs(0xA4, 0x40, 8), 368, []string{RuleLength}},
+	} {
+		b := cat(head, tc.tail)
+		if len(b) != tc.raw {
+			t.Fatalf("%s：字面總長 %d，要 %d", tc.name, len(b), tc.raw)
+		}
+		vs := Check(Input{File: "ESPMES", Class: "win63x8", Orig: b, Trans: b})
+		wantRules(t, vs, tc.want...)
+		if tc.want != nil && vs[0].Detail != "raw="+strconv.Itoa(tc.raw)+" expanded=512 limit=511" {
+			t.Fatalf("%s：Detail = %q", tc.name, vs[0].Detail)
+		}
+	}
+}
+
+func bytesReplaceAll(b []byte, old, new string) []byte {
+	var out []byte
+	for i := 0; i < len(b); {
+		if i+len(old) <= len(b) && string(b[i:i+len(old)]) == old {
+			out = append(out, new...)
+			i += len(old)
+			continue
+		}
+		out = append(out, b[i])
+		i++
+	}
+	return out
+}
+
+// 原項目自己（原版位元組）在 (2) 下合格：E_item 讓含 `%s` 的原項目不會因計算慣例過寬而自己就超過。
+func TestCheckOrigPassesExpandedWidth(t *testing.T) {
+	orig := cat([]byte("%s"), pairs(0xA4, 0x40, 9), []byte("%s"), pairs(0xA4, 0x40, 11)) // 1 行、44 bytes、E_item = 80
+	vs := Check(Input{ID: "o", File: "ESPMES", Class: "win31x4", Orig: orig, Trans: orig})
+	for _, v := range vs {
+		if v.Rule == RuleExpandedWidth {
+			t.Fatalf("原項目自己不該違反 (2)：%+v", v)
+		}
+	}
+	// 它違反 (1)（44 > 30）是預期的：原項目自己不受 (1) 約束，只有譯文受約束；渲染列數 3 在 max(4, 3) 內
+	if got := ruleSet(vs); !reflect.DeepEqual(got, []string{RuleLineWidth}) {
+		t.Fatalf("原項目當譯文的違規 = %v", got)
+	}
+}
+
+func TestCheckUnknownWindow(t *testing.T) {
+	for _, in := range []Input{
+		{ID: "a", File: "SHOPTAB.TBL", Trans: pairs(0xA4, 0x40, 2)},
+		{ID: "b", File: "ESPMES", Class: "bogus", Trans: pairs(0xA4, 0x40, 2)},
+	} {
+		vs := Check(in)
+		wantRules(t, vs, RuleLineWidth)
+		if vs[0].Detail != "unknown-window" || vs[0].ID != in.ID {
+			t.Errorf("%+v", vs)
+		}
+	}
+}
+
+// 空白旗標的規格（`% d`）不被當成規格：`%` 是無法解析的佔位符，0x20 照空白規則回報。
+func TestCheckSpaceFlag(t *testing.T) {
+	in := okInput()
+	in.Trans = cat(pairs(0xA4, 0x40, 3), []byte("% d"), pairs(0xA4, 0x40, 3))
+	got := map[string]bool{}
+	for _, v := range Check(in) {
+		got[v.Rule] = true
+	}
+	if !got[RuleSpace] || !got[RulePlaceholder] {
+		t.Fatalf("`%% d` 應回 space 與 placeholder，得 %v", got)
+	}
+}
+
+// 無法解析或不支援的 `%`（失敗即關閉）：整個違規至少含 placeholder。
+func TestCheckMalformedPlaceholder(t *testing.T) {
+	for _, tr := range []string{"%q", "%u", "%%", "%5", "%*d", "%", "% d"} {
+		in := okInput()
+		in.Trans = cat(pairs(0xA4, 0x40, 3), []byte(tr), pairs(0xA4, 0x40, 3))
+		found := false
+		for _, v := range Check(in) {
+			found = found || v.Rule == RulePlaceholder
+		}
+		if !found {
+			t.Errorf("%q 應被佔位符規則擋下", tr)
+		}
+	}
+}
diff --git a/apps/hr/l10n/budget/helpers_test.go b/apps/hr/l10n/budget/helpers_test.go
new file mode 100644
index 0000000..44841e1
--- /dev/null
+++ b/apps/hr/l10n/budget/helpers_test.go
@@ -0,0 +1,102 @@
+package budget
+
+import (
+	"bytes"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+// 測試輔助。位元組全部自造，不含原版文字。
+
+// hb 把「A4 E0 %s 0A」這種記法轉成位元組：十六進位記號是一個位元組，`%` 開頭的記號原樣放進去。
+func hb(s string) []byte {
+	var out []byte
+	for _, f := range strings.Fields(s) {
+		if f[0] == '%' {
+			out = append(out, f...)
+			continue
+		}
+		v, err := strconv.ParseUint(f, 16, 8)
+		if err != nil {
+			panic(fmt.Sprintf("hb: %q: %v", f, err))
+		}
+		out = append(out, byte(v))
+	}
+	return out
+}
+
+// pairs 造 n 個雙位元組字：lead 固定，trail 從 from 起逐一加 1（呼叫端保證 trail 在 S 集）。
+func pairs(lead, from byte, n int) []byte {
+	out := make([]byte, 0, 2*n)
+	for i := 0; i < n; i++ {
+		out = append(out, lead, from+byte(i))
+	}
+	return out
+}
+
+// cat 串接多段位元組。
+func cat(parts ...[]byte) []byte {
+	return bytes.Join(parts, nil)
+}
+
+// nl 是換行。
+var nl = []byte{0x0A}
+
+// ruleSet 回傳違規的規則鍵集合（排序、去重）。
+func ruleSet(vs []Violation) []string {
+	seen := map[string]bool{}
+	for _, v := range vs {
+		seen[v.Rule] = true
+	}
+	var out []string
+	for r := range seen {
+		out = append(out, r)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// wantRules 斷言違規的規則鍵集合恰為 want，且每個 Detail 只含小寫字母、數字、`=`、`-` 與空白。
+func wantRules(t *testing.T, vs []Violation, want ...string) {
+	t.Helper()
+	sort.Strings(want)
+	got := ruleSet(vs)
+	if strings.Join(got, ",") != strings.Join(want, ",") {
+		t.Fatalf("違規規則 = %v，要 %v（%+v）", got, want, vs)
+	}
+	for _, v := range vs {
+		for _, r := range v.Detail {
+			if !(r >= 'a' && r <= 'z' || r >= '0' && r <= '9' || r == '=' || r == '-' || r == ' ') {
+				t.Fatalf("Detail 含不該有的字元 %q：%q", r, v.Detail)
+			}
+		}
+	}
+}
+
+// expandFmt 把格式位元組中依序出現的 `%s` 換成給定的展開內容。
+func expandFmt(format []byte, exps ...[]byte) []byte {
+	var out []byte
+	k := 0
+	for i := 0; i < len(format); {
+		if format[i] == '%' && i+1 < len(format) && format[i+1] == 's' {
+			out = append(out, exps[k]...)
+			k++
+			i += 2
+			continue
+		}
+		out = append(out, format[i])
+		i++
+	}
+	if k != len(exps) {
+		panic("expandFmt: 展開數與 %s 個數不符")
+	}
+	return out
+}
+
+// countS 是格式位元組中 `%s` 的個數。
+func countS(format []byte) int {
+	return bytes.Count(format, []byte("%s"))
+}
diff --git a/apps/hr/l10n/budget/sim.go b/apps/hr/l10n/budget/sim.go
new file mode 100644
index 0000000..ddd340e
--- /dev/null
+++ b/apps/hr/l10n/budget/sim.go
@@ -0,0 +1,188 @@
+package budget
+
+// `25DC:1676`（執行期 `16EC:1676`）的 S／P 分類模擬（hr `docs/spec/008` 第 2 節與第 3.5 節，
+// 證據 `docs/re/023` 第 2.1、2.2 節、`docs/re/025`）。
+//
+// 迴圈頂端：*p 為 0x00 或 0x0A，或已畫 si >= k（k ＝ (w-8)/8）就離開。
+// 本體：S 集位元組畫一個後回頂端；P 集位元組畫完後若下一個位元組是 NUL 就離開，
+// 否則**無條件再畫下一個位元組**（不查 0x0A），再回頂端。下一個位元組若是 0x0A，換行就被吃掉，兩行併成一行。
+// 離開時：*p 是 0x0A 則 si 加 1；*p 是 NUL 回 0，否則回 si。呼叫端以傳回值推進字串指標。
+
+// Mode 區分模擬器的兩個模式。`ConcreteCalls` 是具體模式（展開位元組已知，確定性模擬），
+// `LineEatsNewlineAdversarial` 是對抗模式（`%s` 展開內容未知，建置時用）。
+// `Mode`、`Concrete`、`Adversarial` 與 `Mode.String()` 目前只供測試與公開契約使用：沒有任何函式接受 `Mode`，
+// 兩個模式各有自己的入口。
+type Mode int
+
+const (
+	Concrete Mode = iota
+	Adversarial
+)
+
+func (m Mode) String() string {
+	if m == Adversarial {
+		return "adversarial"
+	}
+	return "concrete"
+}
+
+type class uint8
+
+const (
+	classS   class = iota // 單位元組路徑
+	classP                // 成對路徑
+	classEnd              // 0x00 與 0x0A：迴圈頂端先離開，不經分類
+)
+
+// classify 是 `1000:966C(c, 0)` 的結果對照：回 0 走 S 集，回 1 或 -1 走 P 集。
+// S 集 ＝ 20 至 7E、A1 至 DF；P 集 ＝ 01 至 1F、7F 至 A0、E0 至 FF（判斷表 `dseg:09D1` 推出，`docs/re/023` 第 2.1 節）。
+func classify(b byte) class {
+	switch {
+	case b == 0x00 || b == 0x0A:
+		return classEnd
+	case b >= 0x01 && b <= 0x1F, b >= 0x7F && b <= 0xA0, b >= 0xE0:
+		return classP
+	}
+	return classS
+}
+
+// at 取 s[i]，超出範圍視為結尾的 NUL（輸入已去掉結尾 NUL）。
+func at(s []byte, i int) byte {
+	if i < len(s) {
+		return s[i]
+	}
+	return 0
+}
+
+// call1676 模擬從 start 起的一次 `1676` 呼叫。ret 是傳回值（已畫位元組數，離開處為 0x0A 時加 1），
+// eat 表示步驟 4 多吃的位元組是 0x0A，done 表示離開處是 NUL（傳回 0，字串已讀完）。
+func call1676(s []byte, start, k int) (ret int, eat, done bool) {
+	p, si := start, 0
+	for {
+		c := at(s, p)
+		if c == 0x00 || c == 0x0A || si >= k {
+			break
+		}
+		p++
+		si++
+		if classify(c) == classS {
+			continue
+		}
+		// 步驟 3：寬度停止（`8*si > 最大寬`，最大寬 ＝ 8k 時不可達）或下一個位元組為 NUL 就離開
+		if 8*si > 8*k || at(s, p) == 0x00 {
+			break
+		}
+		// 步驟 4：無條件多畫下一個位元組
+		if at(s, p) == 0x0A {
+			eat = true
+		}
+		p++
+		si++
+	}
+	switch at(s, p) {
+	case 0x0A:
+		si++
+	case 0x00:
+		return 0, eat, true
+	}
+	return si, eat, false
+}
+
+// ConcreteCalls 在展開位元組已知的字串 s 上模擬一連串 `1676` 呼叫（具體模式），
+// 回傳每次呼叫起點的字串偏移與是否有 0x0A 被步驟 4 多吃；k ＝ (w-8)/8。
+//
+// s 必須是 `1676` 實際看到的緩衝：格式字串經 `_vsprintf` 展開之後，（`01A3` 路徑）再剔除所有 0x20 的結果
+// （`3E41:0423`，`docs/re/023` 第 3.1 節）。拿格式字串（還帶著 `%s`）或沒剔除 0x20 的字串呼叫會得到錯的偏移。
+//
+// 每次呼叫從迴圈頂端（同步狀態）起算，所以寬度停止不改變 P／S 相位。
+// 呼叫端（`25DC:18AC`）在字串讀完後不再呼叫，所以以 0x0A 或寬度停止結尾而後面已無位元組時，不記尾端的空呼叫。
+func ConcreteCalls(s []byte, k int) (offsets []int, eatsNewline bool) {
+	off := 0
+	for {
+		offsets = append(offsets, off)
+		ret, eat, done := call1676(s, off, k)
+		eatsNewline = eatsNewline || eat
+		off += ret
+		if done || ret == 0 || off >= len(s) { // ret == 0 只在 k <= 0 時發生，避免無窮迴圈
+			return offsets, eatsNewline
+		}
+	}
+}
+
+// 對抗模式的狀態：游標在迴圈頂端（同步），或下一個位元組已被前一個 P 集位元組多吃（位移）。
+// 狀態集合以位元表示。
+const (
+	stSync = 1 << iota
+	stOff
+)
+
+// stAny 是 `%s` 展開之後的狀態集合：展開內容任意（長度 0 至 20），所以與進入狀態無關，恆為 {同步, 位移}。
+// 從同步進入：空展開留在同步，結尾為 P 集位元組的展開使下一個字面位元組被吃。
+// 從位移進入：空展開留在位移（第一個字面位元組被吃），長度 1 的展開吃掉那個被多吃的位元組而回到同步。
+const stAny = stSync | stOff
+
+// advTok 是對抗模式的行內記號：一般位元組，或內容未知的 `%s` 展開。
+type advTok struct {
+	b   byte
+	arb bool
+}
+
+// advTokens 把一行切成記號，遇到第一個 0x0A 停止（nl 為真），遇到 NUL 或串尾也停止。
+// 只有 `%s` 的展開未知；`%d`、`%ld` 等展開成數字，與規格文字本身一樣都在 S 集，所以按字面位元組處理。
+func advTokens(line []byte) (toks []advTok, nl bool) {
+	for i := 0; i < len(line); {
+		c := line[i]
+		if c == 0x00 {
+			return toks, false
+		}
+		if c == 0x0A {
+			return toks, true
+		}
+		if c == '%' {
+			if sp, ok := parseSpec(line, i); ok {
+				if sp.conv == 's' {
+					toks = append(toks, advTok{arb: true})
+				} else {
+					for _, b := range line[i : i+sp.n] {
+						toks = append(toks, advTok{b: b})
+					}
+				}
+				i += sp.n
+				continue
+			}
+		}
+		toks = append(toks, advTok{b: c})
+		i++
+	}
+	return toks, false
+}
+
+// LineEatsNewlineAdversarial 對一行在 `%s` 展開內容任意（長度 0 至 20）的對抗模式下，
+// 任一可達狀態使行尾 0x0A 被多吃就回 true。
+//
+// line 是以 0x0A 結尾（含該 0x0A）或以項目結尾（不含）的一行；0x0A 之後的位元組不看。
+// 項目結尾的 NUL 不會被步驟 4 吃掉（步驟 3 先查 NUL），所以沒有 0x0A 結尾的行永遠回 false。
+// `%s` 緊接 0x0A 一律回 true，`%s` 緊接結尾回 false。
+func LineEatsNewlineAdversarial(line []byte) bool {
+	toks, nl := advTokens(line)
+	set := stSync
+	for _, t := range toks {
+		if t.arb {
+			set = stAny
+			continue
+		}
+		next := 0
+		if set&stSync != 0 {
+			if classify(t.b) == classP {
+				next |= stOff
+			} else {
+				next |= stSync
+			}
+		}
+		if set&stOff != 0 {
+			next |= stSync
+		}
+		set = next
+	}
+	return nl && set&stOff != 0
+}
