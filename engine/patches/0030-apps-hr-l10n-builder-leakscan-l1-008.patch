+func TestOriginalCountryBias(t *testing.T) {
+	data := readOrig(t, "COUNTRY.MES")["COUNTRY.MES"]
+	f := mustParse(t, "COUNTRY.MES", data)
+	if f.countryBias != 5 {
+		t.Errorf("偏差起點 %d，應為 5（偏移 5 至 11 多 2）", f.countryBias)
+	}
+	k := int(binary.LittleEndian.Uint16(data))
+	last := int(binary.LittleEndian.Uint32(data[2+4*(k-1):]))
+	if k != 12 || last != 2097 || len(data) != 2096 {
+		t.Errorf("K ＝ %d，末偏移 %d，檔長 %d；應為 12、2097、2096", k, last, len(data))
+	}
+	// 兩種模式：identity 保留偏差；含譯文重算精確偏移（末偏移指向檔尾 FF ＝ 檔長 - 1 起算的位置）。
+	if got := mustSerialize(t, f, nil, SerializeOptions{}); !bytes.Equal(got, data) {
+		t.Error("identity 不符")
+	}
+	repl := map[string][]byte{f.Items[0].ID: f.Items[0].Orig}
+	if _, err := f.Serialize(repl, SerializeOptions{}); err == nil {
+		t.Error("含譯文且未開 ExactCountryOffsets 應回錯")
+	}
+	exact := mustSerialize(t, f, repl, SerializeOptions{ExactCountryOffsets: true})
+	if len(exact) != len(data) {
+		t.Errorf("精確模式檔長 %d，應與原檔相同（%d）", len(exact), len(data))
+	}
+	if eLast := int(binary.LittleEndian.Uint32(exact[2+4*(k-1):])); eLast != len(exact)-1 {
+		t.Errorf("精確模式末偏移 %d，應指向最後的 FF（%d）", eLast, len(exact)-1)
+	}
+	if bytes.Equal(exact, data) {
+		t.Error("精確模式的偏移表應與原檔（含 +2 偏差）不同")
+	}
+	// 精確模式與原檔只差偏移表。
+	if !bytes.Equal(exact[2+4*k:], data[2+4*k:]) {
+		t.Error("精確模式的項目本體應與原檔相同")
+	}
+}
