+++ b/apps/hr/l10n/digest.go
@@ -0,0 +1,279 @@
+package l10n
+
+import (
+	"crypto/sha256"
+	_ "embed"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/verify"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// 輸入摘要、建置器版本與譯文表整體雜湊（docs/spec/008 第 3.2 節）。
+
+// builderGolden 是建置器的 golden 檔：合成譯文表 fixture 在 table 模式的輸出雜湊（測試產生，機器寫的文字檔）。
+// 建置器版本由它的位元組導出：建置輸出一改變，golden 就必須重產，版本隨之改變，
+// 不可能只重產 golden 而保留舊版本。見 golden_test.go。
+//
+//go:embed data/builder-golden.txt
+var builderGolden []byte
+
+// versionOf 回傳 golden 位元組的 SHA-256 前 8 碼（小寫十六進位）。
+func versionOf(golden []byte) string {
+	sum := sha256.Sum256(golden)
+	return hex.EncodeToString(sum[:4])
+}
+
+// Version 是建置器版本 `l10nBuilderVersion`（不用 app 版本字串）。
+func Version() string { return versionOf(builderGolden) }
+
+// Mode 是建置模式。
+type Mode string
+
+const (
+	// ModeTable：讀譯文表，採用 accepted 列（政策允許時含 candidate）。
+	ModeTable Mode = "table"
+	// ModeIdentity：不讀任何譯文表，全部 keep，輸出與原檔逐位元組相同。
+	ModeIdentity Mode = "identity"
+)
+
+// TableFormat 是譯文表格式的版本（第 3.3 節的 TSV；規格沒有定義「譯文表版本」，本套件以格式版本當它，記進 manifest，
+// 不進輸入摘要：格式的語意改變一定伴隨建置器輸出改變，也就是 golden 與建置器版本改變）。
+const TableFormat = "tsv-1"
+
+// sha256Hex 回傳位元組的 SHA-256（小寫十六進位）。
+func sha256Hex(b []byte) string {
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
+
+// digestInput 是輸入摘要的全部輸入。
+type digestInput struct {
+	Version   string            // 建置器版本
+	Orig      map[string]string // 九個原版輸入：檔名到 SHA-256
+	TableHash string            // 譯文表整體雜湊
+	PatchHash string            // 補丁雜湊（L1 為空字串）
+	Policy    verify.Policy     // 建置政策（模式與三個旗標）
+}
+
+// digestOf 回傳輸入摘要：下列文字的 SHA-256。每個輸入一行，順序固定，所以沒有 map 迭代順序或欄位邊界的歧義。
+//
+//	hr-l10n-input-digest v1
+//	orig <檔名> <SHA-256>        九行，依檔名字母序
+//	table <譯文表整體雜湊>
+//	patch <補丁雜湊>
+//	builder <建置器版本>
+//	policy mode=…;with-candidates=…;allow-country-offsets=…;allow-shoptab=…
+func digestOf(in digestInput) string {
+	var sb strings.Builder
+	sb.WriteString("hr-l10n-input-digest v1\n")
+	for _, n := range verify.InputNames() {
+		sb.WriteString("orig " + n + " " + in.Orig[n] + "\n")
+	}
+	sb.WriteString("table " + in.TableHash + "\n")
+	sb.WriteString("patch " + in.PatchHash + "\n")
+	sb.WriteString("builder " + in.Version + "\n")
+	sb.WriteString("policy " + in.Policy.Canonical() + "\n")
+	return sha256Hex([]byte(sb.String()))
+}
+
+// emptyTableHash 是無譯文表與 identity 模式的「譯文表整體雜湊」：空位元組串的 SHA-256。
+var emptyTableHash = sha256Hex(nil)
+
+// tableFileNames 回傳七個資料檔譯文表的檔名（大寫的 `<資料檔名>.TSV`）到資料檔名的對照。
+func tableFileNames() map[string]string {
+	want := make(map[string]string, len(dataFileNames))
+	for _, n := range dataFileNames {
+		want[strings.ToUpper(n)+".TSV"] = n
+	}
+	return want
+}
+
+// tableFileMap 列出譯文表目錄內的七個資料檔譯文表（`<資料檔名>.tsv`，檔名大小寫不分），
+// 回傳大寫資料檔名到實際路徑。目錄內其他檔案（glossary.tsv 等）與子目錄都不算。
+// 同一個資料檔有兩份大小寫不同的檔案視為錯誤（哪一份生效不明確）。
+func tableFileMap(dir string) (map[string]string, error) {
+	ents, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, fmt.Errorf("l10n: 讀譯文表目錄：%w", err)
+	}
+	want := tableFileNames()
+	out := make(map[string]string)
+	for _, e := range ents {
+		if e.IsDir() {
+			continue
+		}
+		name, ok := want[strings.ToUpper(e.Name())]
+		if !ok {
+			continue
+		}
+		if prev, dup := out[name]; dup {
+			return nil, fmt.Errorf("l10n: 譯文表目錄內 %s 有兩份大小寫不同的檔案（%s、%s）", name, filepath.Base(prev), e.Name())
+		}
+		out[name] = filepath.Join(dir, e.Name())
+	}
+	return out, nil
+}
+
+// TableHash 回傳譯文表目錄的整體雜湊：對七個資料檔的譯文表依資料檔名排序，每個檔一行
+// `<大寫資料檔名>\t<檔案內容的 SHA-256>\n`，整串取 SHA-256。所以它與檔案在目錄內的順序、目錄的位置與結構、
+// 檔名大小寫無關，只由「哪些資料檔有譯文表、內容是什麼」決定；缺檔視為該檔全 keep，不出現在雜湊內。
+// 沒有任何譯文表時取空位元組串的 SHA-256。目錄內的其他檔案（詞表等）不影響建置輸出，不進雜湊。
+func TableHash(dir string) (string, error) {
+	files, err := readTableFiles(dir)
+	if err != nil {
+		return "", err
+	}
+	return tableHashOf(files), nil
+}
+
+// readTableFiles 讀譯文表目錄內的七個資料檔譯文表，回傳大寫資料檔名到檔案位元組（依資料檔名排序讀取，
+// 出錯時點名的檔案因此是決定性的）。Build 讀這一份位元組，雜湊與解析共用，兩者不會看到不同版本的檔案。
+func readTableFiles(dir string) (map[string][]byte, error) {
+	paths, err := tableFileMap(dir)
+	if err != nil {
+		return nil, err
+	}
+	names := make([]string, 0, len(paths))
+	for n := range paths {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	out := make(map[string][]byte, len(paths))
+	for _, n := range names {
+		b, err := os.ReadFile(paths[n])
+		if err != nil {
+			return nil, fmt.Errorf("l10n: 讀譯文表 %s：%w", n, err)
+		}
+		out[n] = b
+	}
+	return out, nil
+}
+
+// tableHashOf 由 readTableFiles 的結果算整體雜湊（公式見 TableHash）。files 為空取空位元組串的 SHA-256。
+func tableHashOf(files map[string][]byte) string {
+	names := make([]string, 0, len(files))
+	for n := range files {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	var sb strings.Builder
+	for _, n := range names {
+		sb.WriteString(n + "\t" + sha256Hex(files[n]) + "\n")
+	}
+	return sha256Hex([]byte(sb.String()))
+}
+
+// requiredInputHashes 取九個原版輸入的預期 SHA-256（來源是 runtime 內嵌的 required.tsv）。
+func requiredInputHashes() (map[string]string, error) {
+	all := make(map[string]string)
+	for _, rf := range hrrt.RequiredFiles() {
+		all[strings.ToUpper(rf.Name)] = rf.SHA256
+	}
+	out := make(map[string]string, len(verify.InputNames()))
+	for _, n := range verify.InputNames() {
+		h, ok := all[n]
+		if !ok {
+			return nil, fmt.Errorf("l10n: required.tsv 沒有原版輸入 %s", n)
+		}
+		out[n] = h
+	}
+	return out, nil
+}
+
+// expectedInputHashes 回傳九個原版輸入的預期雜湊：override 非空時取它（測試與工具縫隙，必須含九個輸入），
+// 否則取 required.tsv。
+func expectedInputHashes(override map[string]string) (map[string]string, error) {
+	if len(override) == 0 {
+		return requiredInputHashes()
+	}
+	have := make(map[string]string, len(override))
+	for k, v := range override {
+		have[strings.ToUpper(k)] = v
+	}
+	out := make(map[string]string, len(verify.InputNames()))
+	for _, n := range verify.InputNames() {
+		h, ok := have[n]
+		if !ok {
+			return nil, fmt.Errorf("l10n: 原版輸入雜湊缺 %s", n)
+		}
+		out[n] = h
+	}
+	return out, nil
+}
+
+// ExpectedInputHashes 回傳九個原版輸入的預期 SHA-256（大寫檔名到小寫十六進位）：override 非空時取它
+// （測試與工具縫隙，必須含九個輸入），否則取 runtime 內嵌的 required.tsv，與 Session.Open 的來源相同。
+// `hrl10n verify` 以它作為原版輸入雜湊的預設來源，`Build` 與 `ExpectedDigest` 也經由同一個函式取表。
+func ExpectedInputHashes(override map[string]string) (map[string]string, error) {
+	return expectedInputHashes(override)
+}
+
+// readOrigInputs 讀 dir 內九個原版輸入（檔名大小寫不分），回傳大寫檔名到位元組。缺檔時列出全部缺的。
+func readOrigInputs(dir string) (map[string][]byte, error) {
+	ents, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, fmt.Errorf("l10n: 讀不到原版目錄：%w", err)
+	}
+	byUpper := make(map[string]string, len(ents))
+	for _, e := range ents {
+		byUpper[strings.ToUpper(e.Name())] = e.Name()
+	}
+	out := make(map[string][]byte, len(verify.InputNames()))
+	var missing []string
+	for _, n := range verify.InputNames() {
+		real, ok := byUpper[n]
+		if !ok {
+			missing = append(missing, n)
+			continue
+		}
+		b, err := readRegular(filepath.Join(dir, real))
+		if err != nil {
+			missing = append(missing, n)
+			continue
+		}
+		out[n] = b
+	}
+	if len(missing) > 0 {
+		return nil, fmt.Errorf("l10n: 原版目錄缺少或讀不到 %d 個輸入：%s", len(missing), strings.Join(missing, "、"))
+	}
+	return out, nil
+}
+
+// readRegular 讀一般檔案（目錄與特殊檔回錯）。
+func readRegular(p string) ([]byte, error) {
+	st, err := os.Stat(p)
+	if err != nil {
+		return nil, err
+	}
+	if !st.Mode().IsRegular() {
+		return nil, errors.New("不是一般檔案")
+	}
+	f, err := os.Open(p)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	return io.ReadAll(f)
+}
+
+// OrigInputHashes 回傳 dir 內九個原版輸入的實際 SHA-256（大寫檔名到小寫十六進位）。缺檔回錯。
+// 不與 required.tsv 比對（比對是 Build 的事）：`hrl10n verify` 用它判斷「這個包是不是由眼前這份原版建的」。
+func OrigInputHashes(dir string) (map[string]string, error) {
+	in, err := readOrigInputs(dir)
+	if err != nil {
+		return nil, err
+	}
+	out := make(map[string]string, len(in))
+	for n, b := range in {
+		out[n] = sha256Hex(b)
+	}
+	return out, nil
+}
