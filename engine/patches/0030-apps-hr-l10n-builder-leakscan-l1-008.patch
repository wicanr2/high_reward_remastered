+// tableRoot 寫一個 l10n 根目錄，內含 `<子目錄名>/` 與給定的譯文表檔（檔名到內容）。
+func tableRoot(t *testing.T, sub string, files map[string]string) string {
+	t.Helper()
+	root := t.TempDir()
+	d := filepath.Join(root, sub)
+	if err := os.MkdirAll(d, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for n, c := range files {
+		if err := os.WriteFile(filepath.Join(d, n), []byte(c), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return root
+}
+
+// tsv 造一份只有給定列的譯文表。
+func tsv(t *testing.T, rows ...l10n.Row) string {
+	t.Helper()
+	var sb strings.Builder
+	if err := (&l10n.Table{Rows: rows}).Save(&sb); err != nil {
+		t.Fatal(err)
+	}
+	return sb.String()
+}
+
+func parseKV(out string) map[string]string {
+	m := map[string]string{}
+	for _, ln := range strings.Split(strings.TrimSpace(out), "\n") {
+		k, v, _ := strings.Cut(ln, "=")
+		m[k] = v
+	}
+	return m
+}
