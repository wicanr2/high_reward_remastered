@@ -0,0 +1,69 @@
+package l10n
+
+import (
+	_ "embed"
+	"fmt"
+	"strings"
+	"sync"
+)
+
+// espWindowsTSV 是 ESPMES 項目對窗口類別的表（兩欄 id、class，1024 列，不含文句）。
+// 原稿與版控副本是 docs/re/data/024-esp-windows.tsv（docs/re/024 第 2.3 節）。
+//
+//go:embed data/esp-windows.tsv
+var espWindowsTSV string
+
+// 窗口類別（docs/spec/008 第 3.5 節的窗口表）。
+const (
+	ClassWin31x4 = "win31x4" // 01A3、06CF：256 x 67
+	ClassWin63x8 = "win63x8" // 07FE：512 x 131
+	ClassWin29x4 = "win29x4" // VS 畫面：240 x 64
+	ClassNone    = "none"    // 沒有靜態呼叫點
+)
+
+var (
+	espWinOnce sync.Once
+	espWinMap  map[string]string
+	espWinErr  error
+)
+
+func loadESPWindows() {
+	m, err := parseESPWindows(espWindowsTSV)
+	espWinMap, espWinErr = m, err
+}
+
+func parseESPWindows(s string) (map[string]string, error) {
+	lines := strings.Split(strings.TrimSuffix(s, "\n"), "\n")
+	if len(lines) == 0 || strings.TrimSuffix(lines[0], "\r") != "id\tclass" {
+		return nil, fmt.Errorf("esp-windows.tsv：表頭應為 id<TAB>class")
+	}
+	m := make(map[string]string, len(lines))
+	for i, ln := range lines[1:] {
+		ln = strings.TrimSuffix(ln, "\r")
+		f := strings.Split(ln, "\t")
+		if len(f) != 2 || f[0] == "" {
+			return nil, fmt.Errorf("esp-windows.tsv 第 %d 行：應為兩欄 id<TAB>class", i+2)
+		}
+		switch f[1] {
+		case ClassWin31x4, ClassWin63x8, ClassWin29x4, ClassNone:
+		default:
+			return nil, fmt.Errorf("esp-windows.tsv 第 %d 行：未知類別 %q", i+2, f[1])
+		}
+		if _, dup := m[f[0]]; dup {
+			return nil, fmt.Errorf("esp-windows.tsv 第 %d 行：id %s 重複", i+2, f[0])
+		}
+		m[f[0]] = f[1]
+	}
+	return m, nil
+}
+
+// ESPWindowClass 回傳 ESPMES 項目（鍵 `ESPMES#<群組>.<子>`）的窗口類別：
+// "win31x4"、"win63x8"、"win29x4" 或 "none"。表內沒有該 id 時 ok 為假。
+func ESPWindowClass(id string) (class string, ok bool) {
+	espWinOnce.Do(loadESPWindows)
+	if espWinErr != nil {
+		return "", false
+	}
+	class, ok = espWinMap[id]
+	return class, ok
+}
diff --git a/apps/hr/l10n/windows_test.go b/apps/hr/l10n/windows_test.go
new file mode 100644
index 0000000..9f09341
--- /dev/null
+++ b/apps/hr/l10n/windows_test.go
@@ -0,0 +1,118 @@
+package l10n
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"strings"
+	"testing"
+)
+
+// espWindowsSHA256 是內嵌 data/esp-windows.tsv 的 SHA-256。原稿與版控副本是 hr repo 的
+// docs/re/data/024-esp-windows.tsv（在 fork 之外，測試讀不到）：兩份必須位元組相同。
+// 更新 data/esp-windows.tsv 時，要同步更新這個值與 docs/re/data/024-esp-windows.tsv。
+const espWindowsSHA256 = "f236e42cdeda3d522d56635bf03f2565771b03e44295209eed8e4c5a4d321034"
+
+func TestESPWindowsEmbeddedHash(t *testing.T) {
+	h := sha256.Sum256([]byte(espWindowsTSV))
+	if got := hex.EncodeToString(h[:]); got != espWindowsSHA256 {
+		t.Errorf("內嵌的 data/esp-windows.tsv SHA-256 ＝ %s，守門值是 %s；更新該表時要同步更新守門值與 docs/re/data/024-esp-windows.tsv", got, espWindowsSHA256)
+	}
+}
+
+func TestESPWindowsTable(t *testing.T) {
+	espWinOnce.Do(loadESPWindows)
+	if espWinErr != nil {
+		t.Fatal(espWinErr)
+	}
+	if len(espWinMap) != 1024 {
+		t.Fatalf("鍵集合 %d 項，應為 1024", len(espWinMap))
+	}
+	count := map[string]int{}
+	for _, c := range espWinMap {
+		count[c]++
+	}
+	want := map[string]int{ClassWin31x4: 625, ClassWin63x8: 3, ClassWin29x4: 2, ClassNone: 394}
+	for c, n := range want {
+		if count[c] != n {
+			t.Errorf("類別 %s：%d 項，應為 %d", c, count[c], n)
+		}
+	}
+	if len(count) != len(want) {
+		t.Errorf("類別種類 %v", count)
+	}
+	// win63x8 是 #44.1、#44.2、#120.70；win29x4 是 #122.165、#122.166。
+	for id, c := range map[string]string{
+		"ESPMES#44.1": ClassWin63x8, "ESPMES#44.2": ClassWin63x8, "ESPMES#120.70": ClassWin63x8,
+		"ESPMES#122.165": ClassWin29x4, "ESPMES#122.166": ClassWin29x4,
+		"ESPMES#44.0": ClassWin31x4, "ESPMES#122.168": ClassWin31x4, "ESPMES#116.33": ClassNone,
+	} {
+		got, ok := ESPWindowClass(id)
+		if !ok || got != c {
+			t.Errorf("ESPWindowClass(%s) ＝ %q, %v；應為 %q", id, got, ok, c)
+		}
+	}
+	var w63, w29 []string
+	for id, c := range espWinMap {
+		switch c {
+		case ClassWin63x8:
+			w63 = append(w63, id)
+		case ClassWin29x4:
+			w29 = append(w29, id)
+		}
+	}
+	if len(w63) != 3 || len(w29) != 2 {
+		t.Errorf("win63x8 %v、win29x4 %v", w63, w29)
+	}
+	if _, ok := ESPWindowClass("ESPMES#44.3"); ok {
+		t.Error("表外的 id 應回 ok ＝ false")
+	}
+	if _, ok := ESPWindowClass("SP.MES#1"); ok {
+		t.Error("非 ESPMES 的 id 應回 ok ＝ false")
+	}
+}
+
+// 表只含 id 與類別（沒有文句）：每一列恰好兩欄，id 符合格式、類別是四種之一。
+func TestESPWindowsTableOnlyIDsAndClasses(t *testing.T) {
+	lines := strings.Split(strings.TrimSuffix(espWindowsTSV, "\n"), "\n")
+	if lines[0] != "id\tclass" {
+		t.Fatalf("表頭 %q", lines[0])
+	}
+	for i, ln := range lines[1:] {
+		f := strings.Split(ln, "\t")
+		if len(f) != 2 || !strings.HasPrefix(f[0], "ESPMES#") || !idPattern.MatchString(f[0]) {
+			t.Fatalf("第 %d 行格式不符：%q", i+2, ln)
+		}
+	}
+	if len(lines) != 1025 {
+		t.Errorf("行數 %d，應為 1025（表頭加 1024 列）", len(lines))
+	}
+}
+
+func TestParseESPWindowsRejects(t *testing.T) {
+	cases := map[string]string{
+		"表頭錯":   "x\tclass\nA#1.0\twin31x4\n",
+		"欄數錯":   "id\tclass\nESPMES#1.0\n",
+		"類別未知":  "id\tclass\nESPMES#1.0\twin1x1\n",
+		"id 重複": "id\tclass\nESPMES#1.0\tnone\nESPMES#1.0\tnone\n",
+	}
+	for name, s := range cases {
+		if _, err := parseESPWindows(s); err == nil {
+			t.Errorf("%s：應該回錯", name)
+		}
+	}
+}
+
+// 鍵集合與原版 ESPMES.MRG 解析出的 1024 個項目 id 完全相同（需原版）。
+func TestESPWindowsKeysMatchOriginalItems(t *testing.T) {
+	data := readOrig(t, "ESPMES.MRG")["ESPMES.MRG"]
+	f := mustParse(t, "ESPMES.MRG", data)
+	espWinOnce.Do(loadESPWindows)
+	if len(f.Items) != len(espWinMap) {
+		t.Fatalf("項目 %d，表 %d", len(f.Items), len(espWinMap))
+	}
+	for _, it := range f.Items {
+		if _, ok := espWinMap[it.ID]; !ok {
+			t.Errorf("表沒有 %s", it.ID)
+		}
+	}
+}
