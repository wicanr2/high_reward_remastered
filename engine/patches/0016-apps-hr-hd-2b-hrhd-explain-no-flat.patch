+// naiveFlat 是第 2b 步的逐像素定義（用遞迴 DFS，與 Verifier 的非遞迴填充獨立）：
+// 做過第 2 步的戳記（有不透明且在 Px 內卻不相符的像素），V 的 8 連通區若只含一種顏色就整區移除。
+func naiveFlat(stamps []*Stamp, px []uint8, pxW, pxH int, res [][]bool) {
+	for k, s := range stamps {
+		partial := false
+		for j := 0; j < s.H && !partial; j++ {
+			for i := 0; i < s.W; i++ {
+				x, y := s.X+i, s.Y+j
+				e := s.E[j*s.W+i]
+				if e == Transparent || x < 0 || y < 0 || x >= pxW || y >= pxH {
+					continue
+				}
+				if px[y*pxW+x] != e {
+					partial = true
+					break
+				}
+			}
+		}
+		if !partial {
+			continue
+		}
+		seen := make([]bool, s.W*s.H)
+		var dfs func(i, j int, comp *[]int, colors map[byte]bool)
+		dfs = func(i, j int, comp *[]int, colors map[byte]bool) {
+			if i < 0 || j < 0 || i >= s.W || j >= s.H || seen[j*s.W+i] || !res[k][j*s.W+i] {
+				return
+			}
+			seen[j*s.W+i] = true
+			*comp = append(*comp, j*s.W+i)
+			colors[s.E[j*s.W+i]] = true
+			for dj := -1; dj <= 1; dj++ {
+				for di := -1; di <= 1; di++ {
+					dfs(i+di, j+dj, comp, colors)
+				}
+			}
+		}
+		for j := 0; j < s.H; j++ {
+			for i := 0; i < s.W; i++ {
+				if seen[j*s.W+i] || !res[k][j*s.W+i] {
+					continue
+				}
+				var comp []int
+				colors := map[byte]bool{}
+				dfs(i, j, &comp, colors)
+				if len(colors) == 1 {
+					for _, p := range comp {
+						res[k][p] = false
+					}
+				}
+			}
+		}
+	}
+}
+
+// 第 2b 步與逐像素定義逐位元相同；KeepFlat 時等於不做第 2b 步。
+func TestVerifyFlatMatchesNaive(t *testing.T) {
+	r := rand.New(rand.NewSource(21))
+	const pxW, pxH = 120, 50
+	for _, keep := range []bool{false, true} {
+		var vf Verifier
+		vf.KeepFlat = keep
+		dropped := 0
+		for round := 0; round < 300; round++ {
+			px := make([]uint8, pxW*pxH)
+			// 低複雜度：大塊同色加少量雜訊，讓單色連通區常出現
+			for i := range px {
+				px[i] = byte((i / 17) % 3)
+			}
+			var stamps []*Stamp
+			for k := 0; k < 1+r.Intn(5); k++ {
+				s := randStamp(r, pxW, pxH)
+				for i := range s.E {
+					if s.E[i] != Transparent && r.Intn(3) != 0 {
+						s.E[i] = byte(r.Intn(2)) // 兩色為主
+					}
+				}
+				s.Seq = uint64(k + 1)
+				stamps = append(stamps, s)
+				for j := 0; j < s.H; j++ {
+					for i := 0; i < s.W; i++ {
+						x, y := s.X+i, s.Y+j
+						if x >= 0 && y >= 0 && x < pxW && y < pxH && s.E[j*s.W+i] != Transparent && r.Intn(4) != 0 {
+							px[y*pxW+x] = s.E[j*s.W+i]
+						}
+					}
+				}
+			}
+			got := vf.Run(stamps, px, pxW, pxH)
+			want := naiveVerify(stamps, px, pxW, pxH)
+			if !keep {
+				naiveFlat(stamps, px, pxW, pxH, want)
+			}
+			dropped += vf.FlatDropped
+			for k, s := range stamps {
+				for j := 0; j < s.H; j++ {
+					for i := 0; i < s.W; i++ {
+						if got[k].Get(i, j) != want[k][j*s.W+i] {
+							t.Fatalf("keep=%v round %d stamp %d：(%d,%d) 位元列 %v 逐像素 %v", keep, round, k, i, j, got[k].Get(i, j), want[k][j*s.W+i])
+						}
+					}
+				}
+			}
+		}
+		if !keep && dropped == 0 {
+			t.Fatal("測試資料沒有觸發任何單色連通區移除")
+		}
+		if keep && dropped != 0 {
+			t.Fatal("KeepFlat 時不該移除")
+		}
+	}
+}
+
+// 對話框蓋住精靈：露出的多色部分保留，被同色蓋住的單色區移除（docs/spec/004 第 5.3 節第 2b 步的動機）。
+func TestVerifyFlatDropsGhost(t *testing.T) {
+	const pxW, pxH = 64, 16
+	px := make([]uint8, pxW*pxH)
+	// 精靈 16x8：左半（x<8）顏色 1 與 2 交錯，右半全是顏色 3
+	s := &Stamp{W: 16, H: 8, X: 0, Y: 0, E: make([]byte, 16*8), Seq: 1}
+	for j := 0; j < 8; j++ {
+		for i := 0; i < 16; i++ {
+			if i < 8 {
+				s.E[j*16+i] = byte(1 + (i+j)%2)
+			} else {
+				s.E[j*16+i] = 3
+			}
+		}
+	}
+	// VRAM：左半露出（相符），右半被「顏色 3 的面板」蓋住：面板的像素剛好等於精靈右半的顏色
+	for j := 0; j < 8; j++ {
+		for i := 0; i < 16; i++ {
+			px[j*pxW+i] = s.E[j*16+i]
+		}
+	}
+	// 把左半的一個像素改掉，避免走全相符快速路徑
+	px[0] = 9
+	var vf Verifier
+	m := vf.Run([]*Stamp{s}, px, pxW, pxH)
+	left, right := 0, 0
+	for j := 0; j < 8; j++ {
+		for i := 0; i < 16; i++ {
+			if m[0].Get(i, j) {
+				if i < 8 {
+					left++
+				} else {
+					right++
+				}
+			}
+		}
+	}
+	// 右半與左半連通（精靈完整相連），整體是多色連通區：兩半都保留
+	if left == 0 || right == 0 {
+		t.Fatalf("相連的多色區不該被移除：左 %d 右 %d", left, right)
+	}
+	// 精靈中間挖空（透明）：右半成為獨立的單色區
+	for j := 0; j < 8; j++ {
+		s.E[j*16+7] = Transparent
+		s.E[j*16+8] = Transparent
+	}
+	m = vf.Run([]*Stamp{s}, px, pxW, pxH)
+	left, right = 0, 0
+	for j := 0; j < 8; j++ {
+		for i := 0; i < 16; i++ {
+			if m[0].Get(i, j) {
+				if i < 8 {
+					left++
+				} else {
+					right++
+				}
+			}
+		}
+	}
+	if left == 0 || right != 0 {
+		t.Fatalf("獨立的單色區應被移除：左 %d 右 %d", left, right)
+	}
+	if vf.FlatDropped == 0 {
+		t.Fatal("FlatDropped 應大於 0")
+	}
+}
