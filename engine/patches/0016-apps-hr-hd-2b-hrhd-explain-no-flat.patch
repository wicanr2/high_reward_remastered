+// dropFlat 做第 2b 步：V 的 8 連通區若只含一種顏色（期望像素），整區從 V 移除。
+// 單色區是弱證據：對話框、面板這類單色蓋住物也會讓精靈裡同色的區域「相符」，畫出一塊殘影
+// （docs/spec/004 第 5.3 節；審查實測 `SPOINT_012` 被對話框蓋住時 54 至 79 個像素全是單色區）。
+// 多色的連通區（精靈露出的部分）不受影響。回傳移除的像素數。
+func (v *Verifier) dropFlat(s *Stamp, vm Mask) int {
+	w, h, st := s.W, s.H, vm.Stride
+	if cap(v.todo) < len(vm.Bits) {
+		v.todo = make([]uint64, len(vm.Bits))
+	}
+	todo := v.todo[:len(vm.Bits)]
+	copy(todo, vm.Bits)
+	dropped := 0
+	for j0 := 0; j0 < h; j0++ {
+		for k := 0; k < st; k++ {
+			for todo[j0*st+k] != 0 {
+				b := bits.TrailingZeros64(todo[j0*st+k])
+				i0 := k*64 + b
+				todo[j0*st+k] &^= 1 << uint(b)
+				// 洪水填充這個連通區
+				v.stack = append(v.stack[:0], int32(j0*w+i0))
+				v.comp = append(v.comp[:0], int32(j0*w+i0))
+				var seen uint32 = 1 << (s.E[j0*w+i0] & 31)
+				for len(v.stack) > 0 {
+					p := int(v.stack[len(v.stack)-1])
+					v.stack = v.stack[:len(v.stack)-1]
+					pj, pi := p/w, p%w
+					for dj := -1; dj <= 1; dj++ {
+						for di := -1; di <= 1; di++ {
+							nj, ni := pj+dj, pi+di
+							if nj < 0 || nj >= h || ni < 0 || ni >= w {
+								continue
+							}
+							wd := &todo[nj*st+ni>>6]
+							bit := uint64(1) << (uint(ni) & 63)
+							if *wd&bit == 0 {
+								continue
+							}
+							*wd &^= bit
+							seen |= 1 << (s.E[nj*w+ni] & 31)
+							v.stack = append(v.stack, int32(nj*w+ni))
+							v.comp = append(v.comp, int32(nj*w+ni))
+						}
+					}
+				}
+				if bits.OnesCount32(seen) == 1 {
+					for _, p := range v.comp {
+						pj, pi := int(p)/w, int(p)%w
+						vm.Bits[pj*st+pi>>6] &^= 1 << (uint(pi) & 63)
+					}
+					dropped += len(v.comp)
+				}
+			}
+		}
+	}
+	return dropped
+}
