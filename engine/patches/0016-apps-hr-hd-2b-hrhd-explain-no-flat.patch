+package main
+
+import (
+	"fmt"
+
+	"github.com/wicanr2/dosgolem/apps/hr/hd"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// explainRect 列出與 Px 矩形 [x0,x1) x [y0,y1) 重疊的每個戳記：清冊 id、相符與通過驗證的像素數
+// （只算落在矩形內的），用來找出疊層在某個區域畫了什麼（例如對話框內的殘影）。
+func explainRect(f *hrrt.Frame, assets *hd.Assets, x0, y0, x1, y1 int) {
+	var vf hd.Verifier
+	masks := vf.Run(f.Stamps, f.Px, f.W, f.H)
+	var vk hd.Verifier
+	vk.KeepFlat = true
+	keep := vk.Run(f.Stamps, f.Px, f.W, f.H)
+	fmt.Printf("# 矩形 (%d,%d)-(%d,%d) 內的戳記（序號 id 位置 大小 矩形內不透明 相符 通過）\n", x0, y0, x1, y1)
+	for k, s := range f.Stamps {
+		op, ma, pa := 0, 0, 0
+		var colors [17]bool
+		allPass := 0
+		for j := 0; j < s.H; j++ {
+			y := s.Y + j
+			if y < y0 || y >= y1 {
+				continue
+			}
+			for i := 0; i < s.W; i++ {
+				x := s.X + i
+				if x < x0 || x >= x1 {
+					continue
+				}
+				e := s.E[j*s.W+i]
+				if e == hd.Transparent {
+					continue
+				}
+				op++
+				if x < f.W && y < f.H && f.Px[y*f.W+x] == e {
+					ma++
+				}
+				if masks[k].Get(i, j) {
+					colors[e] = true
+					pa++
+				}
+			}
+		}
+		for j := 0; j < s.H; j++ {
+			for i := 0; i < s.W; i++ {
+				if masks[k].Get(i, j) {
+					allPass++
+					colors[s.E[j*s.W+i]] = true
+				}
+			}
+		}
+		nc := 0
+		for _, b := range colors {
+			if b {
+				nc++
+			}
+		}
+		if op == 0 {
+			continue
+		}
+		id := ""
+		if e := assets.Lookup(s.Hash); e != nil {
+			id = e.ID
+		}
+		fmt.Printf("%d\t%s\t(%d,%d)\t%dx%d\t%d\t%d\t%d\t全部通過 %d（不做第 2b 步 %d），通過的顏色數 %d\n", s.Seq, id, s.X, s.Y, s.W, s.H, op, ma, pa, allPass, keep[k].Count(), nc)
+	}
+}
