+// 原生視窗控制可能先切換全螢幕；快捷鍵必須讀取當下視窗狀態。
+func TestFullscreenKeysUseNativeState(t *testing.T) {
+	for _, key := range []ebiten.Key{ebiten.KeyF11, ebiten.KeyEnter} {
+		t.Run(key.String(), func(t *testing.T) {
+			gr := newGameRig(t, themeOriginal, nil)
+			gr.fe.alt = key == ebiten.KeyEnter
+			gr.fe.fullscreen = true // 模擬原生按鈕或 -fullscreen 啟動
+			gr.mustFrame(key)
+			if gr.fe.fullscreen {
+				t.Error("原生全螢幕狀態為 true，快捷鍵應切回視窗")
+			}
+			gr.mustFrame()
+			gr.fe.fullscreen = false // 模擬之後由原生按鈕離開全螢幕
+			gr.mustFrame(key)
+			if !gr.fe.fullscreen {
+				t.Error("原生全螢幕狀態為 false，快捷鍵應進入全螢幕")
+			}
+		})
+	}
+}
