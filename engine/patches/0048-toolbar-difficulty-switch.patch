+package runtime
+
+// ClearMouseInput 取消前端模態操作之前的滑鼠狀態，不跑 DOS 指令。
+// 與 Machine/DOS 相同，呼叫端必須先停止並等候 Run/RunSteps 結束。
+// 只清滑鼠輸入；鍵盤、座標、範圍與遊戲機器狀態保持原值。
+func (s *Session) ClearMouseInput() {
+	s.mu.Lock()
+	keep := s.inbox[:0]
+	for _, ev := range s.inbox {
+		if ev.Kind != EvMouseMove && ev.Kind != EvMouseButton {
+			keep = append(keep, ev)
+		}
+	}
+	s.inbox = keep
+	s.mu.Unlock()
+	s.held, s.relPending, s.pollsAt = [2]bool{}, [2]bool{}, [2]int{}
+	s.d.Mouse.Buttons = 0
+	s.d.Mouse.Press, s.d.Mouse.Release = [3]uint16{}, [3]uint16{}
+}
