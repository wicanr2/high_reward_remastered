diff --git a/apps/hr/play/audio.go b/apps/hr/play/audio.go
index 90bacce..f256f63 100644
--- a/apps/hr/play/audio.go
+++ b/apps/hr/play/audio.go
@@ -92,10 +92,11 @@ type audioOut struct {
 	src  *pullSource
 	logf func(string, ...any)
 
-	be       *backend
-	stopOnce sync.Once
-	quit     chan struct{}
-	wg       sync.WaitGroup
+	be        *backend
+	stopOnce  sync.Once
+	closeOnce sync.Once
+	quit      chan struct{}
+	wg        sync.WaitGroup
 
 	mu      sync.Mutex
 	pumping bool
@@ -210,7 +211,20 @@ func (a *audioOut) startPump(gen int) {
 	}()
 }
 
+// bind 在同一個輸出上切換引擎，與有效 Read 共用互斥鎖。
+// 返回時舊 Read 已完成，之後的裝置／pump 都只會推進新 Engine。
+func (a *audioOut) bind(e *sound.Engine) {
+	a.src.mu.Lock()
+	a.src.e = e
+	a.src.last.Store(int64(time.Since(a.src.t0)))
+	a.src.mu.Unlock()
+}
+
 func (a *audioOut) close() {
+	a.closeOnce.Do(a.closeOutput)
+}
+
+func (a *audioOut) closeOutput() {
 	a.mu.Lock()
 	a.closed = true // 之後不再啟動拉取執行緒（避免與 wg.Wait 競爭）
 	a.mu.Unlock()
