+package main
+
+import (
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/wicanr2/dosgolem/apps/hr/sound"
+)
+
+func TestAudioBindWaitsAndExistingReaderUsesNewEngine(t *testing.T) {
+	old, next := sound.NewEngine(), sound.NewEngine()
+	old.MusicStart(longSMF)
+	next.MusicStart(longSMF)
+	a := &audioOut{src: newPullSource(old)}
+	reader := a.src.reader(1)
+	a.src.mu.Lock() // 模擬正在持有同一臨界區的 Read。
+	started, done := make(chan struct{}), make(chan struct{})
+	go func() { close(started); a.bind(next); close(done) }()
+	<-started
+	select {
+	case <-done:
+		a.src.mu.Unlock()
+		t.Fatal("bind沒有等待舊Read")
+	case <-time.After(10 * time.Millisecond):
+	}
+	a.src.mu.Unlock()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("未完成綁定")
+	}
+	buf := make([]byte, 4*sound.SampleRate*6)
+	if n, e := reader.Read(buf); e != nil || n != len(buf) {
+		t.Fatal(n, e)
+	}
+	if !old.Playing() || next.Playing() || !nonZero(buf) {
+		t.Fatal("新舊引擎推進錯誤")
+	}
+}
+
+func TestAudioCloseCanRepeat(t *testing.T) {
+	old := openBackendFn
+	defer func() { openBackendFn = old }()
+	dev := newFakeDevice()
+	openBackendFn = dev.factory(func(_ io.Reader, _ *fakeDevice) {})
+	a := startAudio(sound.NewEngine(), func(string, ...any) {})
+	a.close()
+	a.close()
+	if dev.stops.Load() != 1 {
+		t.Fatal("重複關閉後端", dev.stops.Load())
+	}
+}
+
+func TestSwitchAwayKeepsSingleDelayedPrefsWriter(t *testing.T) {
+	old := savePrefs
+	defer func() { savePrefs = old }()
+	first, release, second := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var mu sync.Mutex
+	var saved []string
+	savePrefs = func(_ string, p prefsPatch, _ func(string, ...any)) error {
+		mu.Lock()
+		i := len(saved)
+		saved = append(saved, p.String())
+		mu.Unlock()
+		if i == 0 {
+			close(first)
+			<-release
+		} else {
+			close(second)
+		}
+		return nil
+	}
+	w := newPrefsWriter(t.TempDir()+"/prefs.json", nil)
+	w.Submit(themePatch(themeHD))
+	select {
+	case <-first:
+	case <-time.After(time.Second):
+		t.Fatal("第一筆未開始")
+	}
+	closed := 0
+	td := &teardown{pw: w, sessionAfter: []func(){func() { closed++ }}}
+	td.switchAway()
+	td.switchAway()
+	if w.closed || closed != 1 {
+		close(release)
+		w.Close()
+		t.Fatal("切換關閉共用writer或重複收尾")
+	}
+	w.Submit(themePatch(themeAI))
+	close(release)
+	select {
+	case <-second:
+	case <-time.After(time.Second):
+		t.Fatal("新偏好未接續寫入")
+	}
+	w.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	if len(saved) != 2 || saved[0] != "{theme=hd}" || saved[1] != "{theme=ai}" {
+		t.Fatal(saved)
+	}
+}
+
+func TestSwitcherDrainWaitsForCancelledPreload(t *testing.T) {
+	r := newRig(t, themeOriginal, themeHD)
+	r.loaders[themeHD].mode = loadBlockCtx
+	r.press()
+	r.sw.Quit()
+	r.sw.Drain()
+	r.sw.Drain()
+	if r.sw.results != nil || r.sw.cancel != nil {
+		t.Fatal("舊預載未收完")
+	}
+	r.wantHold(1, 1)
+}
