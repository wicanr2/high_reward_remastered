new file mode 100644
index 0000000..c35651c
--- /dev/null
+++ b/apps/hr/play/runner_test.go
@@ -0,0 +1,73 @@
+package main
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+func TestRunnerPauseJoinsAndResumesSameState(t *testing.T) {
+	var runs, live, peak, steps atomic.Int32
+	started := make(chan struct{}, 10)
+	r := newSessionRunner(func(ctx context.Context) *hrrt.Stop {
+		runs.Add(1)
+		n := live.Add(1)
+		if n > peak.Load() {
+			peak.Store(n)
+		}
+		defer live.Add(-1)
+		steps.Add(1)
+		started <- struct{}{}
+		<-ctx.Done()
+		return nil
+	})
+	defer r.Close()
+	for i := 0; i < 4; i++ {
+		select {
+		case <-started:
+		case <-time.After(time.Second):
+			t.Fatal("未啟動")
+		}
+		r.Pause()
+		if live.Load() != 0 || steps.Load() != int32(i+1) {
+			t.Fatal("Pause 未 join", live.Load(), steps.Load())
+		}
+		select {
+		case <-r.stops:
+			t.Fatal("取消被當作停機")
+		default:
+		}
+		r.Resume()
+		r.Resume()
+	}
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("未恢復")
+	}
+	r.Close()
+	r.Close()
+	r.Resume()
+	if live.Load() != 0 || peak.Load() != 1 || runs.Load() != 5 {
+		t.Fatal("重複 Run 或 Close 後恢復", runs.Load(), live.Load(), peak.Load())
+	}
+}
+
+func TestRunnerTerminalIsNotResumed(t *testing.T) {
+	var calls atomic.Int32
+	r := newSessionRunner(func(context.Context) *hrrt.Stop { calls.Add(1); return &hrrt.Stop{Kind: hrrt.StopSteps} })
+	select {
+	case <-r.stops:
+	case <-time.After(time.Second):
+		t.Fatal("沒有真停機")
+	}
+	r.Pause()
+	r.Resume()
+	r.Close()
+	if calls.Load() != 1 {
+		t.Fatal("已停機仍重開")
+	}
+}
