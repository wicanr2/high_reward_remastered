new file mode 100644
index 0000000..a041a4d
--- /dev/null
+++ b/apps/hr/runtime/ui_input_test.go
@@ -0,0 +1,40 @@
+package runtime
+
+import (
+	"bytes"
+	"reflect"
+	"testing"
+)
+
+func TestClearMouseInputBeforeThreePolls(t *testing.T) {
+	s := hardSession(t)
+	defer s.DOS().Close()
+	s.Input(MouseButtonEvent(120, 80, 0, true))
+	s.drainInput()
+	s.Input(MouseButtonEvent(120, 80, 0, false))
+	s.drainInput()
+	if !s.held[0] || !s.relPending[0] || s.d.Mouse.Buttons != 1 {
+		t.Fatal("正對照未建立延遲放開")
+	}
+	key := KeyEvent(0x1c, '\r')
+	s.Input(MouseButtonEvent(20, 20, 1, true))
+	s.Input(key)
+	s.Input(MouseMoveEvent(3, 4))
+	mem := append([]byte(nil), s.m.Mem...)
+	cpu := *s.m.CPU
+	x, y := s.d.Mouse.X, s.d.Mouse.Y
+	s.ClearMouseInput()
+	if s.held != [2]bool{} || s.relPending != [2]bool{} || s.pollsAt != [2]int{} || s.d.Mouse.Buttons != 0 || s.d.Mouse.Press != [3]uint16{} || s.d.Mouse.Release != [3]uint16{} {
+		t.Fatal("滑鼠未立即清除")
+	}
+	if !reflect.DeepEqual(s.inbox, []Event{key}) {
+		t.Fatal("佇列未清滑鼠或遺失鍵盤", s.inbox)
+	}
+	if s.d.Mouse.X != x || s.d.Mouse.Y != y || !bytes.Equal(mem, s.m.Mem) || cpu.R != s.m.CPU.R || cpu.Seg != s.m.CPU.Seg || cpu.IP != s.m.CPU.IP || cpu.Flags != s.m.CPU.Flags {
+		t.Fatal("無關狀態改變")
+	}
+	s.drainInput()
+	if s.d.Mouse.Buttons != 0 || s.held[0] || s.held[1] {
+		t.Fatal("恢復後舊按鍵重現")
+	}
+}
