diff --git a/apps/hr/play/runner.go b/apps/hr/play/runner.go
new file mode 100644
index 0000000..de41c24
--- /dev/null
+++ b/apps/hr/play/runner.go
@@ -0,0 +1,69 @@
+package main
+
+import (
+	"context"
+	"sync/atomic"
+
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+// sessionRunner 的控制方法只由 UI 執行緒呼叫。Pause 等本輪 Run 結束，
+// Resume 才能在同一 Session 另開一輪；取消不發出假的停機事件。
+type sessionRunner struct {
+	run      func(context.Context) *hrrt.Stop
+	stops    chan *hrrt.Stop
+	cancel   context.CancelFunc
+	done     chan struct{}
+	terminal atomic.Bool
+	closed   bool
+}
+
+func newSessionRunner(run func(context.Context) *hrrt.Stop) *sessionRunner {
+	r := &sessionRunner{run: run, stops: make(chan *hrrt.Stop, 1)}
+	r.Resume()
+	return r
+}
+
+func (r *sessionRunner) Resume() {
+	if r.closed || r.terminal.Load() || r.cancel != nil {
+		return
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	r.cancel, r.done = cancel, make(chan struct{})
+	done := r.done
+	go func() {
+		defer close(done)
+		if st := r.run(ctx); st != nil {
+			r.terminal.Store(true)
+			r.stops <- st
+		}
+	}()
+}
+
+func (r *sessionRunner) Pause() {
+	if r.cancel != nil {
+		r.cancel()
+		<-r.done
+		r.cancel, r.done = nil, nil
+	}
+}
+
+func (r *sessionRunner) Close() {
+	r.closed = true
+	r.Pause()
+}
+
+// 模式重啟採當前 UI 設定；Current 在 applying 階段已綁定新素材。
+func restartPlan(base startupPlan, g *game) startupPlan {
+	if g == nil {
+		return base
+	}
+	base.Theme, base.Lang = g.sw.Current(), g.lang
+	if g.snd != nil {
+		base.Muted = g.snd.Muted()
+	}
+	if !base.Override {
+		base.Ingame = ingameChoice{Code: ingameCode(g.lang)}
+	}
+	return base
+}
