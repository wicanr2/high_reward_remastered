+)
+
+const toolbarHeight = 44
+
+var (
+	toolbarButton = image.Rect(12, 4, 292, 40)
+	toolbarRows   = [2]image.Rectangle{image.Rect(12, 44, 292, 96), image.Rect(12, 96, 292, 148)}
+	switchCancel  = image.Rect(500, 510, 730, 562)
+	switchConfirm = image.Rect(770, 510, 1000, 562)
+)
+
+func (d *difficultyGate) environment() gameEnv {
+	if d.env != nil {
+		return *d.env
+	}
+	return defaultEnv()
+}
+
+func (d *difficultyGate) language() lang {
+	if d.g != nil {
+		return d.g.lang
+	}
+	return d.lang
+}
+
+func (d *difficultyGate) cursorUI(visible bool) {
+	if d.env != nil {
+		return
+	} // 測試不碰 ebiten 的全域游標。
+	if visible {
+		ebiten.SetCursorMode(ebiten.CursorModeVisible)
+	} else {
+		ebiten.SetCursorMode(ebiten.CursorModeHidden)
+	}
+}
+
+func (d *difficultyGate) installGame(g *game, mode hrrt.Difficulty) {
+	d.g, d.mode, d.lastTitle = g, mode, ""
+	if d.toolbar {
+		cursor := g.env.cursor
+		g.env.cursor = func() (int, int) { x, y := cursor(); return x, y - toolbarHeight }
+	}
+	d.refreshTitle()
+	d.cursorUI(false)
+}
+
+func (d *difficultyGate) refreshTitle() {
+	title := tr(d.g.lang, "app.title", version) + "　[" + difficultyLabel(d.g.lang, d.mode) + "]"
+	if title != d.lastTitle {
+		d.environment().setTitle(title)
+		d.lastTitle = title
+	}
+}
+
+func (d *difficultyGate) pauseGame() {
+	if d.g.pause != nil {
+		d.g.pause()
+	}
+	d.g.btn, d.g.mx = [2]bool{}, -1
+	d.g.mouseBlocked, d.g.hideCursor = true, true
+}
+
+func (d *difficultyGate) closeMenu() {
+	d.menu, d.confirm, d.confirmFocus, d.switchPending = false, false, false, false
+	d.switchErr = nil
+	d.g.mouseBlocked, d.g.hideCursor = false, false
+	if d.g.resume != nil {
+		d.g.resume()
+	}
+}
+
+func (d *difficultyGate) openMenu() {
+	d.pauseGame()
+	d.menu, d.choice = true, 0
+	if d.mode == hrrt.DifficultyHard {
+		d.choice = 1
+	}
+	d.cursorUI(true)
+}
+
+func (d *difficultyGate) chooseMode(i int) {
+	mode := hrrt.DifficultyOriginal
+	if i == 1 {
+		mode = hrrt.DifficultyHard
+	}
+	if mode == d.mode {
+		d.closeMenu()
+		return
+	}
+	d.menu, d.confirm, d.confirmFocus, d.target = false, true, false, mode
+}
+
+func (d *difficultyGate) updateRunning() error {
+	e := d.environment()
+	if e.keyDown(ebiten.KeyControl) && justPressed(ebiten.KeyQ) {
+		return ebiten.Termination
+	}
+	if d.switchPending {
+		d.switchPending = false
+		g, err := d.start(d.target)
+		if err != nil {
+			d.confirm, d.switchErr = false, err
+			d.logf("難度切換失敗，保留 %s：%v", d.mode.String(), err)
+			return nil
+		}
+		d.confirm, d.menu, d.switchErr = false, false, nil
+		d.installGame(g, d.target)
+		d.logf("difficulty ready: %s", d.mode.String())
+		return nil
+	}
+	if d.menu || d.confirm || d.switchErr != nil {
+		d.updateMenu(e)
+		return nil
+	}
+	if d.toolbar {
+		x, y := e.cursor()
+		if e.mouseJustDown(ebiten.MouseButtonLeft) && image.Pt(x, y).In(toolbarButton) {
+			d.openMenu()
+			return nil
+		}
+		hover := y < toolbarHeight
+		if hover && (d.g.btn[0] || d.g.btn[1]) {
+			d.pauseGame()
+			if d.g.resume != nil {
+				d.g.resume()
+			}
+		}
+		d.g.mouseBlocked, d.g.hideCursor = hover, hover
+		d.cursorUI(hover)
+	}
+	err := d.g.Update()
+	d.refreshTitle()
+	return err
+}
+
+func (d *difficultyGate) updateMenu(e gameEnv) {
+	if justPressed(ebiten.KeyEscape) || e.mouseJustDown(ebiten.MouseButtonRight) {
+		d.closeMenu()
+		return
+	}
+	x, y := e.cursor()
+	click := e.mouseJustDown(ebiten.MouseButtonLeft)
+	enter := justPressed(ebiten.KeyEnter) || justPressed(ebiten.KeyNumpadEnter)
+	if d.switchErr != nil {
+		if enter || click && image.Pt(x, y).In(switchCancel) {
+			d.closeMenu()
+		}
+		return
+	}
+	if d.confirm {
+		if justPressed(ebiten.KeyTab) {
+			d.confirmFocus = !d.confirmFocus
+		}
+		if justPressed(ebiten.KeyArrowLeft) {
+			d.confirmFocus = false
+		}
+		if justPressed(ebiten.KeyArrowRight) {
+			d.confirmFocus = true
+		}
+		if enter {
+			if d.confirmFocus {
+				d.switchPending = true
+			} else {
+				d.closeMenu()
+			}
+		} else if click && image.Pt(x, y).In(switchCancel) {
+			d.closeMenu()
+		} else if click && image.Pt(x, y).In(switchConfirm) {
+			d.switchPending = true
+		}
+		return
+	}
+	if justPressed(ebiten.KeyTab) || justPressed(ebiten.KeyArrowUp) || justPressed(ebiten.KeyArrowDown) {
+		d.choice = 1 - d.choice
+	}
+	if enter {
+		d.chooseMode(d.choice)
+		return
+	}
+	if click {
+		for i, r := range toolbarRows {
+			if image.Pt(x, y).In(r) {
+				d.chooseMode(i)
+				return
+			}
+		}
+		d.closeMenu()
+	}
+}
+
+func (d *difficultyGate) drawRunning(screen *ebiten.Image) {
+	if !d.toolbar {
+		d.g.Draw(screen)
+		return
+	}
+	if d.surface == nil {
+		d.surface = ebiten.NewImage(logicalW, logicalH)
+	}
+	d.surface.Clear()
+	d.g.Draw(d.surface)
+	op := &ebiten.DrawImageOptions{}
+	op.GeoM.Translate(0, toolbarHeight)
+	screen.DrawImage(d.surface, op)
+	vector.DrawFilledRect(screen, 0, 0, logicalW, toolbarHeight, color.RGBA{12, 16, 28, 255}, false)
+	l := d.language()
+	face := d.fonts.face(l)
+	if face == nil {
+		l = langEN
+	}
+	draw := func(s string, x, y int, c color.Color) {
+		if face == nil {
+			ebitenutil.DebugPrintAt(screen, s, x, y-18)
+		} else {
+			text.Draw(screen, s, face, x, y, c)
+		}
+	}
+	fg, gold := color.RGBA{215, 222, 235, 255}, color.RGBA{240, 221, 177, 255}
+	box := func(r image.Rectangle, selected bool) {
+		vector.DrawFilledRect(screen, float32(r.Min.X), float32(r.Min.Y), float32(r.Dx()), float32(r.Dy()), color.RGBA{23, 32, 50, 255}, false)
+		c := color.RGBA{82, 97, 123, 255}
+		if selected {
+			c = gold
+		}
+		vector.StrokeRect(screen, float32(r.Min.X), float32(r.Min.Y), float32(r.Dx()), float32(r.Dy()), 1, c, false)
+	}
+	box(toolbarButton, d.menu)
+	draw(tr(l, "difficulty.toolbar", difficultyLabel(l, d.mode)), 26, 29, gold)
+	for i := 0; i < 3; i++ {
+		vector.DrawFilledRect(screen, float32(262+i*2), float32(17+i*2), float32(12-i*4), 2, gold, false)
+	}
+	if d.menu {
+		for i, r := range toolbarRows {
+			box(r, i == d.choice)
+			mode := hrrt.DifficultyOriginal
+			if i == 1 {
+				mode = hrrt.DifficultyHard
+			}
+			draw(difficultyLabel(l, mode), 30, r.Min.Y+34, fg)
+			if mode == d.mode {
+				vector.StrokeLine(screen, 258, float32(r.Min.Y+26), 264, float32(r.Min.Y+32), 2, gold, false)
+				vector.StrokeLine(screen, 264, float32(r.Min.Y+32), 277, float32(r.Min.Y+18), 2, gold, false)
+			}
+		}
+	}
+	if !d.confirm && d.switchErr == nil {
+		return
+	}
+	vector.DrawFilledRect(screen, 0, toolbarHeight, logicalW, logicalH, color.RGBA{0, 0, 0, 180}, false)
+	box(image.Rect(140, 220, 1140, 600), true)
+	lines := []string{tr(l, "difficulty.switch.title"), tr(l, "difficulty.switch.target", difficultyLabel(l, d.target)), tr(l, "difficulty.switch.save"), tr(l, "difficulty.switch.unsaved")}
+	if d.switchErr != nil {
+		lines = []string{tr(l, "difficulty.switch.error"), tr(l, "difficulty.switch.kept"), tr(l, "difficulty.switch.log")}
+	}
+	if d.switchPending {
+		lines[len(lines)-1] = tr(l, "difficulty.loading")
+	}
+	for i, s := range lines {
+		draw(s, 175, 275+i*48, fg)
+	}
+	button := func(r image.Rectangle, key string, selected bool) {
+		box(r, selected)
+		s := tr(l, key)
+		w := len(s) * 6
+		if face != nil {
+			w = font.MeasureString(face, s).Ceil()
+		}
+		draw(s, r.Min.X+(r.Dx()-w)/2, r.Min.Y+34, fg)
+	}
+	button(switchCancel, "difficulty.switch.cancel", !d.confirmFocus)
+	if d.switchErr == nil {
+		button(switchConfirm, "difficulty.switch.confirm", d.confirmFocus)
+	}
+}
+
+func validateToolbarText(l lang, face font.Face) error {
+	for _, mode := range []hrrt.Difficulty{hrrt.DifficultyOriginal, hrrt.DifficultyHard} {
+		s := tr(l, "difficulty.toolbar", difficultyLabel(l, mode))
+		if font.MeasureString(face, s).Ceil() > 232 {
+			return fmt.Errorf("%s 工具列文字越界", l)
+		}
+		if font.MeasureString(face, tr(l, "difficulty.switch.target", difficultyLabel(l, mode))).Ceil() > 930 {
+			return fmt.Errorf("%s 目標文字越界", l)
+		}
+	}
+	for _, key := range []string{"difficulty.switch.title", "difficulty.switch.save", "difficulty.switch.unsaved", "difficulty.switch.error", "difficulty.switch.kept", "difficulty.switch.log"} {
+		if font.MeasureString(face, tr(l, key)).Ceil() > 930 {
+			return fmt.Errorf("%s %s 越界", l, key)
+		}
+	}
+	for _, key := range []string{"difficulty.switch.cancel", "difficulty.switch.confirm"} {
+		if font.MeasureString(face, tr(l, key)).Ceil() > 202 {
+			return fmt.Errorf("%s %s 越界", l, key)
+		}
+	}
+	return nil
+}
