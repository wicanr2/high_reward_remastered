 	lang lang
 
@@ -153,6 +157,7 @@ func newGame(cfg gameConfig) *game {
 		s: cfg.Session, snd: cfg.Snd, sw: cfg.SW, hv: cfg.HV, fonts: cfg.Fonts, hud: newHudRenderer(),
