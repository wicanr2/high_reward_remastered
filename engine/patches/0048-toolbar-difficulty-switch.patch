+package main
+
+import (
+	"errors"
+	"reflect"
+	"testing"
+
+	"github.com/hajimehoshi/ebiten/v2"
+	hrrt "github.com/wicanr2/dosgolem/apps/hr/runtime"
+)
+
+func toolbarRig(t *testing.T) (*difficultyGate, *gameRig, *int, *int) {
+	gr := newGameRig(t, themeOriginal, nil, withSound())
+	pauses, resumes := new(int), new(int)
+	gr.g.pause = func() { *pauses++ }
+	gr.g.resume = func() { *resumes++ }
+	e := gr.fe.env()
+	d := &difficultyGate{toolbar: true, env: &e, fonts: gr.g.fonts, lang: langTW, logf: func(string, ...any) {}}
+	d.installGame(gr.g, hrrt.DifficultyOriginal)
+	return d, gr, pauses, resumes
+}
+
+func TestToolbarCoordinatesAndNoClickThrough(t *testing.T) {
+	d, gr, pauses, resumes := toolbarRig(t)
+	gr.fe.cx, gr.fe.cy = 200, 144
+	if e := d.Update(); e != nil {
+		t.Fatal(e)
+	}
+	if ev := gr.ss.take(); !reflect.DeepEqual(ev, []hrrt.Event{hrrt.MouseMoveEvent(100, 50)}) {
+		t.Fatal("工具列偏移", ev)
+	}
+	gr.fe.cy = 20
+	gr.g.btn[0] = true
+	if e := d.Update(); e != nil {
+		t.Fatal(e)
+	}
+	if ev := gr.ss.take(); len(ev) != 0 || *pauses != 1 || *resumes != 1 || gr.g.btn[0] {
+		t.Fatal("跨邊界按鍵未取消", ev, *pauses, *resumes)
+	}
+	if w, h := d.Layout(1, 1); w != 1280 || h != 844 {
+		t.Fatal(w, h)
+	}
+	d.toolbar = false
+	if w, h := d.Layout(1, 1); w != 1280 || h != 800 {
+		t.Fatal("no-toolbar", w, h)
+	}
+}
+
+func TestToolbarCancelSameModeAndDefaultEnter(t *testing.T) {
+	d, gr, pauses, resumes := toolbarRig(t)
+	d.start = func(hrrt.Difficulty) (*game, error) { t.Fatal("取消不應重建"); return nil, nil }
+	d.openMenu()
+	d.chooseMode(0)
+	if d.menu || d.confirm || *pauses != 1 || *resumes != 1 {
+		t.Fatal("同模式未恢復")
+	}
+	d.openMenu()
+	d.chooseMode(1)
+	if !d.confirm || d.confirmFocus || d.mode != hrrt.DifficultyOriginal {
+		t.Fatal("確認不是預設取消")
+	}
+	gr.fe.just[ebiten.KeyEnter] = true
+	if e := d.Update(); e != nil {
+		t.Fatal(e)
+	}
+	if d.confirm || d.g != gr.g || *resumes != 2 {
+		t.Fatal("預設Enter未取消")
+	}
+	gr.fe.just = map[ebiten.Key]bool{}
+	d.openMenu()
+	d.chooseMode(1)
+	gr.fe.just[ebiten.KeyEscape] = true
+	if e := d.Update(); e != nil {
+		t.Fatal(e)
+	}
+	if d.confirm || d.menu || *resumes != 3 {
+		t.Fatal("Esc未恢復")
+	}
+}
+
+func TestToolbarFailurePreservesGameAndSuccessfulAlternation(t *testing.T) {
+	d, gr, _, resumes := toolbarRig(t)
+	d.start = func(hrrt.Difficulty) (*game, error) { return nil, errors.New("test invalid profile") }
+	d.openMenu()
+	d.chooseMode(1)
+	d.switchPending = true
+	if e := d.Update(); e != nil {
+		t.Fatal(e)
+	}
+	if d.g != gr.g || d.mode != hrrt.DifficultyOriginal || d.switchErr == nil || *resumes != 0 {
+		t.Fatal("失敗未保留")
+	}
+	gr.fe.just[ebiten.KeyEscape] = true
+	d.Update()
+	gr.fe.just = map[ebiten.Key]bool{}
+	if d.switchErr != nil || *resumes != 1 {
+		t.Fatal("錯誤未關閉")
+	}
+	for _, want := range []hrrt.Difficulty{hrrt.DifficultyHard, hrrt.DifficultyOriginal, hrrt.DifficultyHard} {
+		next := newGameRig(t, themeOriginal, nil).g
+		d.start = func(got hrrt.Difficulty) (*game, error) {
+			if got != want {
+				t.Fatal(got, want)
+			}
+			return next, nil
+		}
+		d.openMenu()
+		i := 0
+		if want == hrrt.DifficultyHard {
+			i = 1
+		}
+		d.chooseMode(i)
+		d.switchPending = true
+		if e := d.Update(); e != nil {
+			t.Fatal(e)
+		}
+		if d.g != next || d.mode != want || d.confirm || d.menu {
+			t.Fatal("成功未換模式")
+		}
+	}
+}
+
+func TestRestartPlanKeepsCurrentPresentation(t *testing.T) {
+	gr := newGameRig(t, themeHD, []themeID{themeHD}, withSound())
+	gr.g.lang = langJA
+	gr.g.snd.SetMute(true)
+	base := startupPlan{Theme: themeOriginal, Lang: langTW, HDHooks: true}
+	got := restartPlan(base, gr.g)
+	if got.Theme != themeHD || got.Lang != langJA || !got.Muted || got.Ingame.Code != ingameCode(langJA) || !got.HDHooks {
+		t.Fatal(got)
+	}
+	base.Override = true
+	base.Ingame = ingameChoice{Code: ingameCode(langEN), Explicit: true}
+	if got := restartPlan(base, gr.g); got.Ingame != base.Ingame {
+		t.Fatal("覆蓋遺失", got)
+	}
+}
