+
+// encodeKorean keeps the L1 encoder unchanged. Only ordinary source spaces
+// become 0x21; a literal exclamation mark still uses its custom scalar code.
+func encodeKorean(text string, cs *Charmap) ([]byte, error) {
+	var out []byte
+	for off := 0; off < len(text); {
+		r, n := utf8.DecodeRuneInString(text[off:])
+		switch {
+		case r == '%':
+			n = PercentSpecLen(text[off:min(off+16, len(text))])
+			if n == 0 {
+				return nil, fmt.Errorf("malformed offset=%d", off)
+			}
+			out = append(out, text[off:off+n]...)
+		case r == ' ':
+			out = append(out, 0x21)
+		case r == '\n' || singleByteOK(r):
+			out = append(out, byte(r))
+		default:
+			c, ok := cs.toBig[r]
+			if !ok || cs.fromBig[c] != r {
+				return nil, fmt.Errorf("scalar-roundtrip U+%04X", r)
+			}
+			out = append(out, byte(c>>8), byte(c))
+		}
+		off += n
+	}
+	// Read the encoded tokens through this item's local reverse map, never Big5.
+	var decoded strings.Builder
+	for off := 0; off < len(out); {
+		b := out[off]
+		switch {
+		case b == '%':
+			n := PercentSpecLen(string(out[off:min(off+16, len(out))]))
+			if n == 0 {
+				return nil, fmt.Errorf("format-roundtrip offset=%d", off)
+			}
+			decoded.Write(out[off : off+n])
+			off += n
+		case b == 0x21:
+			decoded.WriteByte(' ')
+			off++
+		case b == '\n' || singleByteOK(rune(b)):
+			decoded.WriteByte(b)
+			off++
+		case off+1 < len(out):
+			c := uint16(b)<<8 | uint16(out[off+1])
+			r, ok := cs.fromBig[c]
+			if !ok {
+				return nil, fmt.Errorf("code-roundtrip offset=%d", off)
+			}
+			decoded.WriteRune(r)
+			off += 2
+		default:
+			return nil, fmt.Errorf("lone-roundtrip offset=%d", off)
+		}
+	}
+	if !bytes.Equal([]byte(decoded.String()), []byte(text)) {
+		return nil, errors.New("token-roundtrip mismatch")
+	}
+	return out, nil
+}
