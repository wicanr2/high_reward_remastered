+func TestKoreanSpaceAndLiteralExclamation(t *testing.T) {
+	p := loadScalar(t, codeKorean, 'α', '!', 0x3000)
+	alpha, _ := p.Lookup([]rune{'α'})
+	bang, _ := p.Lookup([]rune{'!'})
+	full, _ := p.Lookup([]rune{0x3000})
+	in := budget.Input{ID: "synthetic", File: "SP.MES", Orig: []byte("AA")}
+	for _, tc := range []struct {
+		text string
+		want []byte
+	}{
+		{" ", []byte{0x21}},
+		{"  α !  ", []byte{0x21, 0x21, byte(alpha >> 8), byte(alpha), 0x21, byte(bang >> 8), byte(bang), 0x21, 0x21}},
+		{"! !", []byte{byte(bang >> 8), byte(bang), 0x21, byte(bang >> 8), byte(bang)}},
+		{"α \n α", []byte{byte(alpha >> 8), byte(alpha), 0x21, 10, 0x21, byte(alpha >> 8), byte(alpha)}},
+		{"\u3000 ", []byte{byte(full >> 8), byte(full), 0x21}},
+	} {
+		key, out, vs := prepareScalar(in, tc.text, codeKorean, p)
+		if len(vs) != 0 || !bytes.Equal(key, tc.want) || !bytes.Equal(out, tc.want) || bytes.ContainsRune(out, 0x20) {
+			t.Fatalf("space/scalar token distinction %q: %x %v", tc.text, out, vs)
+		}
+	}
+	if _, _, vs := prepareScalar(in, "!", codeKorean, loadScalar(t, codeKorean, 'α')); len(vs) != 1 || !strings.Contains(vs[0], "missing-scalar") {
+		t.Fatal("literal exclamation bypassed fixed glyph patch", vs)
+	}
+	for _, code := range []string{codeSimplified, codeJapanese} {
+		if _, _, vs := prepareScalar(in, "α α", code, loadScalar(t, code, 'α')); len(vs) != 1 || !strings.Contains(vs[0], "space") {
+			t.Fatal("Korean source space changed another language", code, vs)
+		}
+	}
+}
+
+func TestKoreanFormatsSourceAndBoundaries(t *testing.T) {
+	p := loadScalar(t, codeKorean, 'α', '!')
+	a, _ := p.Lookup([]rune{'α'})
+	in := budget.Input{ID: "format", File: "SP.MES", Orig: []byte("%03d%ld%s")}
+	key, out, vs := prepareScalar(in, " α %03d%ld%s α ", codeKorean, p)
+	want := append([]byte{0x21, byte(a >> 8), byte(a), 0x21}, []byte("%03d%ld%s")...)
+	want = append(want, 0x21, byte(a>>8), byte(a), 0x21)
+	if len(vs) != 0 || !bytes.Equal(key, want) || !bytes.Equal(out, want) {
+		t.Fatal("format tokens changed", vs)
+	}
+	for _, tc := range []struct{ orig, text, rule string }{
+		{"AA", "\xff", "source"}, {"AA", "\t", "source"}, {"AA", "\r", "source"}, {"AA", "\x00", "source"},
+		{"AA", "\u200d", "source"}, {"AA", "\ue000", "source"}, {"AA", "\u0378", "source"}, {"AA", "\u0301", "source"},
+		{"AA", "\u2028", "source"}, {"AA", "\u00a0", "source"}, {"AA", "δ", "missing-scalar"},
+		{"%d", "% d", "placeholder"}, {"%d", "%04d", "placeholder"}, {"AA", "%%", "placeholder"},
+		{"%u", "%u", "placeholder"}, {"%s", "α %s\n", "1676"},
+		{"AA", strings.Repeat("α", 256), "length"}, {"AA", strings.Repeat(" ", 512), "length"},
+	} {
+		k, out, vs := prepareScalar(budget.Input{ID: "invalid", File: "SP.MES", Orig: []byte(tc.orig)}, tc.text, codeKorean, p)
+		if k != nil || out != nil || len(vs) == 0 || !strings.Contains(strings.Join(vs, " "), tc.rule) {
+			t.Fatalf("expected %s: %v", tc.rule, vs)
+		}
+	}
+	// The existing wrapper still uses byte widths and keeps every space, even
+	// at a newly inserted line end. Removing only newlines must recover the key.
+	text := strings.Repeat("α ", 24)
+	key, out, vs = prepareScalar(budget.Input{ID: "wrap", File: "UWASA.MES", Orig: []byte("AA")}, text, codeKorean, p)
+	if len(vs) != 0 || !bytes.ContainsRune(out, 10) || !bytes.Equal(bytes.ReplaceAll(out, []byte{10}, nil), key) || bytes.Count(out, []byte{0x21}) != 24 {
+		t.Fatal("wrapping removed source spaces", vs)
+	}
+	// A per-item corrupted local reverse map cannot pass token readback.
+	cs := &Charmap{toBig: map[rune]uint16{'α': a}, fromBig: map[uint16]rune{a: 'β'}}
+	if _, e := encodeKorean(" α", cs); e == nil {
+		t.Fatal("scalar reverse mismatch accepted")
+	}
+}
