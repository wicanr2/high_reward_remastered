diff --git a/apps/hr/l10n/budget/korean_test.go b/apps/hr/l10n/budget/korean_test.go
new file mode 100644
index 0000000..45cd5cd
--- /dev/null
+++ b/apps/hr/l10n/budget/korean_test.go
@@ -0,0 +1,38 @@
+package budget
+
+import (
+	"bytes"
+	"reflect"
+	"testing"
+)
+
+func TestKoreanSpaceIsNarrowAndSurvivesWrapping(t *testing.T) {
+	in := Input{ID: "synthetic", File: "UWASA.MES", Orig: []byte("AA"), Trans: []byte{0x21}}
+	if vs := Check(in); len(vs) != 1 || vs[0].Rule != RuleWhitelist {
+		t.Fatal("default whitelist opened", vs)
+	}
+	in.KoreanSpace = true
+	if vs := Check(in); len(vs) != 0 {
+		t.Fatal("Korean 8 px space rejected", vs)
+	}
+	in.Trans = bytes.Repeat([]byte{0x21}, 31)
+	out, vs := WrapAndCheck(in)
+	if len(vs) != 0 || bytes.Count(out, []byte{10}) != 1 || bytes.Count(out, []byte{0x21}) != 31 {
+		t.Fatal("single-byte budget or flag propagation", vs)
+	}
+	for _, raw := range [][]byte{{0x20}, {0xA4, 0x20}, {0xA4, 0x21}, {0x01}, []byte("% d"), []byte("%s\n")} {
+		in.Trans = raw
+		in.Orig = []byte("%s")
+		in.KoreanSpace = false
+		a := Check(in)
+		in.KoreanSpace = true
+		b := Check(in)
+		if !reflect.DeepEqual(a, b) {
+			t.Fatalf("flag changed non-single-space rule %x: %v %v", raw, a, b)
+		}
+	}
+	in.Trans, in.Orig = []byte("!%s\n"), []byte("%s")
+	if vs := Check(in); len(vs) != 1 || vs[0].Rule != Rule1676 {
+		t.Fatal("Korean flag bypassed adversarial newline rejection", vs)
+	}
+}
