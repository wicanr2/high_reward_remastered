+package runtime
+
+import "golang.org/x/sys/windows"
+
+func publishChallengePath(from, to string) error {
+	a, err := windows.UTF16PtrFromString(from)
+	if err != nil {
+		return err
+	}
+	b, err := windows.UTF16PtrFromString(to)
+	if err != nil {
+		return err
+	}
+	return windows.MoveFileEx(a, b, 0)
+}
diff --git a/apps/hr/runtime/challenge_rules.go b/apps/hr/runtime/challenge_rules.go
new file mode 100644
index 0000000..fc6a0a2
--- /dev/null
+++ b/apps/hr/runtime/challenge_rules.go
@@ -0,0 +1,125 @@
+package runtime
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+)
+
+// VehicleRule selects one strategy; Original also represents a disabled switch.
+type VehicleRule string
+
+const (
+	VehicleOriginal  VehicleRule = "original"
+	VehicleBalanced  VehicleRule = "balanced"
+	VehicleTransport VehicleRule = "transport"
+)
+
+// ChallengeRules is the profile identity defined by spec 017. It does not enable
+// gameplay hooks: spec 016 must be READY before a Session can consume these rules.
+type ChallengeRules struct {
+	Schema            int         `json:"schema"`
+	Revision          string      `json:"revision"`
+	DebtX5            bool        `json:"debt_x5"`
+	HalfRewards       bool        `json:"half_rewards"`
+	StagedStory       bool        `json:"staged_story"`
+	LateAircraftShops bool        `json:"late_aircraft_shops"`
+	Aircraft          VehicleRule `json:"aircraft"`
+	Tank              VehicleRule `json:"tank"`
+	WesternGuards     bool        `json:"western_guards"`
+	FortressDefenses  bool        `json:"fortress_defenses"`
+}
+
+func DefaultChallengeRules() ChallengeRules {
+	return ChallengeRules{1, "challenge-v1", true, true, true, true, VehicleBalanced, VehicleBalanced, true, true}
+}
+
+func (r ChallengeRules) Validate() error {
+	if r.Schema != 1 || r.Revision != "challenge-v1" {
+		return fmt.Errorf("自訂難度規則版本不符")
+	}
+	for _, v := range []VehicleRule{r.Aircraft, r.Tank} {
+		if v != VehicleOriginal && v != VehicleBalanced && v != VehicleTransport {
+			return fmt.Errorf("未知載具規則 %q", v)
+		}
+	}
+	return nil
+}
+
+func (r ChallengeRules) CanonicalJSON() ([]byte, error) {
+	if err := r.Validate(); err != nil {
+		return nil, err
+	}
+	return json.Marshal(r)
+}
+
+func (r ChallengeRules) Digest() (string, error) {
+	b, err := r.CanonicalJSON()
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+// DecodeChallengeRules requires every exact key, including explicit false.
+// Tokenization detects duplicates after JSON has decoded Unicode key escapes.
+func DecodeChallengeRules(b []byte) (ChallengeRules, error) {
+	var zero ChallengeRules
+	d := json.NewDecoder(bytes.NewReader(b))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return zero, fmt.Errorf("自訂難度設定必須是 JSON 物件")
+	}
+	fields := map[string]json.RawMessage{}
+	for d.More() {
+		token, err = d.Token()
+		if err != nil {
+			return zero, err
+		}
+		key, ok := token.(string)
+		if !ok {
+			return zero, fmt.Errorf("自訂難度欄位名稱錯誤")
+		}
+		if _, exists := fields[key]; exists {
+			return zero, fmt.Errorf("自訂難度重複欄位 %q", key)
+		}
+		var raw json.RawMessage
+		if err := d.Decode(&raw); err != nil {
+			return zero, err
+		}
+		fields[key] = raw
+	}
+	if token, err = d.Token(); err != nil || token != json.Delim('}') {
+		return zero, fmt.Errorf("自訂難度設定不完整")
+	}
+	if _, err = d.Token(); err != io.EOF {
+		return zero, fmt.Errorf("自訂難度設定含尾隨內容")
+	}
+	var r ChallengeRules
+	expected := map[string]any{
+		"schema": &r.Schema, "revision": &r.Revision, "debt_x5": &r.DebtX5,
+		"half_rewards": &r.HalfRewards, "staged_story": &r.StagedStory,
+		"late_aircraft_shops": &r.LateAircraftShops, "aircraft": &r.Aircraft,
+		"tank": &r.Tank, "western_guards": &r.WesternGuards, "fortress_defenses": &r.FortressDefenses,
+	}
+	if len(fields) != len(expected) {
+		return zero, fmt.Errorf("自訂難度欄位數不符")
+	}
+	for key, target := range expected {
+		raw, found := fields[key]
+		if !found || bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+			return zero, fmt.Errorf("自訂難度缺少有效欄位 %q", key)
+		}
+		if err := json.Unmarshal(raw, target); err != nil {
+			return zero, fmt.Errorf("自訂難度欄位 %q：%w", key, err)
+		}
+	}
+	if err := r.Validate(); err != nil {
+		return zero, err
+	}
+	return r, nil
+}
diff --git a/apps/hr/runtime/challenge_test.go b/apps/hr/runtime/challenge_test.go
new file mode 100644
index 0000000..5087be7
--- /dev/null
+++ b/apps/hr/runtime/challenge_test.go
@@ -0,0 +1,342 @@
+package runtime
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func TestChallengeRulesIdentityAndStrictJSON(t *testing.T) {
+	r := DefaultChallengeRules()
+	if !r.DebtX5 || !r.HalfRewards || !r.StagedStory || !r.LateAircraftShops || !r.WesternGuards || !r.FortressDefenses || r.Aircraft != VehicleBalanced || r.Tank != VehicleBalanced {
+		t.Fatal("預設不是八項全開及均衡載具")
+	}
+	if _, err := (ChallengeRules{}).Digest(); err == nil {
+		t.Fatal("零值被當作有效預設")
+	}
+	seen := map[string]bool{}
+	for mask := 0; mask < 64; mask++ {
+		for _, plane := range []VehicleRule{VehicleOriginal, VehicleBalanced, VehicleTransport} {
+			for _, tank := range []VehicleRule{VehicleOriginal, VehicleBalanced, VehicleTransport} {
+				q := r
+				q.DebtX5, q.HalfRewards, q.StagedStory = mask&1 != 0, mask&2 != 0, mask&4 != 0
+				q.LateAircraftShops, q.WesternGuards, q.FortressDefenses = mask&8 != 0, mask&16 != 0, mask&32 != 0
+				q.Aircraft, q.Tank = plane, tank
+				digest, err := q.Digest()
+				if err != nil || !isChallengeDigest(digest) || seen[digest] {
+					t.Fatal("組合身分重複或無效", mask, plane, tank, err)
+				}
+				seen[digest] = true
+				b, _ := q.CanonicalJSON()
+				decoded, err := DecodeChallengeRules(b)
+				if err != nil || decoded != q {
+					t.Fatal("設定往返失真", err)
+				}
+				var reordered map[string]any
+				json.Unmarshal(b, &reordered)
+				pretty, _ := json.MarshalIndent(reordered, "", " ")
+				decoded, err = DecodeChallengeRules(pretty)
+				if err != nil {
+					t.Fatal(err)
+				}
+				other, _ := decoded.Digest()
+				if other != digest {
+					t.Fatal("欄位順序或空白改變進度身分")
+				}
+			}
+		}
+	}
+	b, _ := r.CanonicalJSON()
+	s := string(b)
+	bad := []string{
+		`null`, `[]`, `{}`, s + `{}`, s + `x`, s[:len(s)-1],
+		strings.Replace(s, `"debt_x5":true,`, "", 1),
+		strings.Replace(s, `"debt_x5":true`, `"debt_x5":null`, 1),
+		strings.Replace(s, `"debt_x5":true`, `"Debt_x5":true`, 1),
+		strings.Replace(s, `"debt_x5":true`, `"debt_x5":1`, 1),
+		strings.Replace(s, `"schema":1`, `"schema":1.0`, 1),
+		strings.Replace(s, `"schema":1`, `"schema":2`, 1),
+		strings.Replace(s, `"challenge-v1"`, `"future"`, 1),
+		strings.Replace(s, `"aircraft":"balanced"`, `"aircraft":"unknown"`, 1),
+		strings.Replace(s, `"debt_x5":true`, `"debt_x5":true,"debt_x5":false`, 1),
+		strings.Replace(s, `"debt_x5":true`, `"debt_x5":true,"\u0064ebt_x5":false`, 1),
+		strings.Replace(s, `"debt_x5":true`, `"unknown":true`, 1),
+	}
+	for _, invalid := range bad {
+		if _, err := DecodeChallengeRules([]byte(invalid)); err == nil {
+			t.Fatalf("接受不完整或污染設定：%s", invalid)
+		}
+	}
+}
