+func TestChallengeProfilesRootAliasesAndUnmarked(t *testing.T) {
+	root := origRoot(t)
+	for _, kind := range []string{"source", "old-hard", "base", "dangling", "unmarked", "ancestor"} {
+		t.Run(kind, func(t *testing.T) {
+			base := filepath.Join(t.TempDir(), "saves")
+			custom := base + "-custom"
+			switch kind {
+			case "source":
+				if err := os.Symlink(root, custom); err != nil {
+					t.Fatal(err)
+				}
+			case "base", "old-hard":
+				target := base
+				if kind == "old-hard" {
+					target += "-hard"
+				}
+				if err := os.Mkdir(target, 0o755); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink(target, custom); err != nil {
+					t.Fatal(err)
+				}
+			case "dangling":
+				if err := os.Symlink(filepath.Join(t.TempDir(), "absent"), custom); err != nil {
+					t.Fatal(err)
+				}
+			case "unmarked":
+				if err := os.Mkdir(custom, 0o755); err != nil {
+					t.Fatal(err)
+				}
+				writeChallengeFile(t, filepath.Join(custom, "keep"), []byte("keep"))
+			case "ancestor":
+				ancestor := filepath.Join(t.TempDir(), "alias")
+				if err := os.Symlink(root, ancestor); err != nil {
+					t.Fatal(err)
+				}
+				base = filepath.Join(ancestor, "child")
+			}
+			if _, err := PrepareChallengeProfile(root, base, DefaultChallengeRules()); err == nil {
+				t.Fatal("接受根別名或未標記資料", kind)
+			}
+		})
+	}
+}
