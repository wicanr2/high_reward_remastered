+func TestChallengeProfilesFailuresPreserveData(t *testing.T) {
+	root := origRoot(t)
+	for _, kind := range []string{"marker", "root-marker", "short", "duplicate-save", "duplicate-index", "unknown", "data", "data-progress", "data-backup", "data-save", "data-lower-index", "data-link", "profile-link", "empty-target", "publication-denied"} {
+		t.Run(kind, func(t *testing.T) {
+			base := filepath.Join(t.TempDir(), "saves")
+			r := DefaultChallengeRules()
+			p, err := PrepareChallengeProfile(root, base, r)
+			if err != nil {
+				t.Fatal(err)
+			}
+			protected := filepath.Join(p.SaveDir, "fname.dat")
+			switch kind {
+			case "marker":
+				protected = filepath.Join(p.SaveDir, "difficulty.json")
+				writeChallengeFile(t, protected, []byte("keep-wrong-marker"))
+			case "root-marker":
+				protected = filepath.Join(filepath.Dir(p.SaveDir), "root.json")
+				writeChallengeFile(t, protected, []byte("keep-wrong-root"))
+			case "short":
+				protected = filepath.Join(p.SaveDir, "gamefile.000")
+				writeChallengeFile(t, protected, []byte("keep-short-save"))
+			case "duplicate-save":
+				protected = filepath.Join(p.SaveDir, "gamefile.000")
+				writeChallengeFile(t, protected, make([]byte, 31839))
+				writeChallengeFile(t, filepath.Join(p.SaveDir, "GAMEFILE.000"), bytes.Repeat([]byte{1}, 31839))
+			case "duplicate-index":
+				writeChallengeFile(t, filepath.Join(p.SaveDir, "FNAME.DAT"), readChallengeFile(t, protected))
+			case "unknown":
+				protected = filepath.Join(p.SaveDir, "unknown")
+				writeChallengeFile(t, protected, []byte("keep-unknown"))
+			case "data":
+				protected = filepath.Join(p.DataDir, "MAIN.EXE")
+				writeChallengeFile(t, protected, []byte("keep-damaged-data"))
+			case "data-progress", "data-backup", "data-save", "data-lower-index":
+				name := map[string]string{"data-progress": "FNAME.DAT", "data-backup": "FNAME.DA_", "data-save": "GAMEFILE.004", "data-lower-index": "fname.dat"}[kind]
+				protected = filepath.Join(p.DataDir, name)
+				writeChallengeFile(t, protected, []byte("keep-injected-progress"))
+			case "data-link":
+				path := filepath.Join(p.DataDir, "MAIN.EXE")
+				if err := os.Remove(path); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink(filepath.Join(root, "MAIN.EXE"), path); err != nil {
+					t.Fatal(err)
+				}
+			case "profile-link":
+				r.Tank = VehicleTransport
+				digest, _ := r.Digest()
+				if err := os.Symlink(p.SaveDir, filepath.Join(filepath.Dir(p.SaveDir), digest)); err != nil {
+					t.Fatal(err)
+				}
+			case "empty-target":
+				r.Tank = VehicleTransport
+				digest, _ := r.Digest()
+				if err := os.Mkdir(filepath.Join(filepath.Dir(p.SaveDir), digest), 0o755); err != nil {
+					t.Fatal(err)
+				}
+			case "publication-denied":
+				r.Tank = VehicleTransport
+				dir := filepath.Dir(p.SaveDir)
+				if err := os.Chmod(dir, 0o555); err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() {
+					if err := os.Chmod(dir, 0o755); err != nil {
+						t.Error(err)
+					}
+				})
+			}
+			before := readChallengeFile(t, protected)
+			if _, err := PrepareChallengeProfile(root, base, r); err == nil {
+				t.Fatal("接受不合法進度", kind)
+			}
+			if !bytes.Equal(before, readChallengeFile(t, protected)) {
+				t.Fatal("拒絕時覆寫原資料", kind)
+			}
+		})
+	}
+}
