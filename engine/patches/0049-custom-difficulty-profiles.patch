+func TestChallengePublicationAndConcurrentPreparation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "kept")
+	writeChallengeFile(t, path, []byte("original"))
+	if err := publishChallengeFile(path, []byte("replacement")); err == nil || string(readChallengeFile(t, path)) != "original" {
+		t.Fatal("發布覆寫既有檔案", err)
+	}
+	parent := t.TempDir()
+	source, target := filepath.Join(parent, "ready"), filepath.Join(parent, "existing-empty")
+	if err := os.Mkdir(source, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(target, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	writeChallengeFile(t, filepath.Join(source, "kept"), []byte("complete-profile"))
+	before, err := os.Stat(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := publishChallengePath(source, target); err == nil {
+		t.Fatal("發布替換了已存在的空目錄")
+	}
+	after, err := os.Stat(target)
+	if err != nil || !os.SameFile(before, after) {
+		t.Fatal("既有空目錄身分改變", err)
+	}
+	if string(readChallengeFile(t, filepath.Join(source, "kept"))) != "complete-profile" {
+		t.Fatal("失敗時損壞候選資料")
+	}
+	root := origRoot(t)
+	base := filepath.Join(t.TempDir(), "saves")
+	a, err := PrepareChallengeProfile(root, base, DefaultChallengeRules())
+	if err != nil {
+		t.Fatal(err)
+	}
+	kept := readChallengeFile(t, filepath.Join(a.SaveDir, "difficulty.json"))
+	r := a.Rules
+	r.Tank = VehicleTransport
+	var wg sync.WaitGroup
+	errs := make([]error, 2)
+	for i := range errs {
+		wg.Add(1)
+		go func(i int) { defer wg.Done(); _, errs[i] = PrepareChallengeProfile(root, base, r) }(i)
+	}
+	wg.Wait()
+	if errs[0] != nil && errs[1] != nil {
+		t.Fatal("並行準備沒有任何成功發布", errs)
+	}
+	if _, err := PrepareChallengeProfile(root, base, r); err != nil {
+		t.Fatal("並行後進度無法重新開啟", err)
+	}
+	if !bytes.Equal(kept, readChallengeFile(t, filepath.Join(a.SaveDir, "difficulty.json"))) {
+		t.Fatal("並行準備改動另一組進度")
+	}
+}
