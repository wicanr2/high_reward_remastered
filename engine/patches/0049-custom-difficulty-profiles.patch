diff --git a/apps/hr/runtime/challenge_profile.go b/apps/hr/runtime/challenge_profile.go
new file mode 100644
index 0000000..5cb9b28
--- /dev/null
+++ b/apps/hr/runtime/challenge_profile.go
@@ -0,0 +1,299 @@
+package runtime
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/wicanr2/dosgolem/apps/hr/patch"
+)
+
+type ChallengeProfile struct {
+	Rules            ChallengeRules
+	Digest           string
+	DataDir, SaveDir string
+}
+
+const challengeRootMarker = "{\"mode\":\"custom-root-v1\",\"source_sha256\":\"" + patch.MainEXESHA256 + "\"}\n"
+
+func challengeDirectory(path string, create bool) error {
+	st, err := os.Lstat(path)
+	if os.IsNotExist(err) && create {
+		if err = os.MkdirAll(path, 0o755); err != nil {
+			return err
+		}
+		st, err = os.Lstat(path)
+	}
+	if err != nil {
+		return err
+	}
+	if !st.IsDir() || st.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("自訂難度必須使用一般目錄：%s", path)
+	}
+	return nil
+}
+
+// publishChallengeFile publishes a fully written temporary file without replacing
+// an existing destination. The platform helper also protects empty directories.
+func publishChallengeFile(path string, b []byte) error {
+	f, err := os.CreateTemp(filepath.Dir(path), ".challenge-write-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err = f.Write(b); err == nil {
+		err = f.Chmod(0o644)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	if err = publishChallengePath(name, path); err != nil {
+		// A concurrent publisher may have won; it must have identical bytes.
+		old, readErr := regularBytes(path)
+		if readErr != nil || !bytes.Equal(old, b) {
+			return fmt.Errorf("自訂難度檔案已存在或無法發布：%s：%w", path, err)
+		}
+	}
+	return nil
+}
+
+func isChallengeDigest(name string) bool {
+	if len(name) != 64 || strings.ToLower(name) != name {
+		return false
+	}
+	_, err := hex.DecodeString(name)
+	return err == nil
+}
+
+func challengeProfileMarker(r ChallengeRules, digest string) ([]byte, error) {
+	return json.Marshal(struct {
+		Mode         string         `json:"mode"`
+		SourceSHA256 string         `json:"source_sha256"`
+		Digest       string         `json:"config_sha256"`
+		Rules        ChallengeRules `json:"rules"`
+	}{"custom-v1", patch.MainEXESHA256, digest, r})
+}
+
+func validateChallengeProgress(path string, marker []byte) error {
+	if err := challengeDirectory(path, false); err != nil {
+		return err
+	}
+	b, err := regularBytes(filepath.Join(path, "difficulty.json"))
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(b, marker) {
+		return fmt.Errorf("自訂難度進度標記或完整設定不符")
+	}
+	entries, err := os.ReadDir(path)
+	if err != nil {
+		return err
+	}
+	seen := map[string]bool{}
+	index := ""
+	for _, entry := range entries {
+		name := entry.Name()
+		upper := strings.ToUpper(name)
+		allowed := name == "difficulty.json" || upper == "FNAME.DAT"
+		for i := 0; i < 5; i++ {
+			allowed = allowed || upper == fmt.Sprintf("GAMEFILE.%03d", i)
+		}
+		st, e := os.Lstat(filepath.Join(path, name))
+		if e != nil {
+			return e
+		}
+		if !allowed || !st.Mode().IsRegular() || seen[upper] {
+			return fmt.Errorf("自訂進度含未知、重複或非一般項目：%s", name)
+		}
+		seen[upper] = true
+		if upper == "FNAME.DAT" {
+			index = filepath.Join(path, name)
+		}
+		if strings.HasPrefix(upper, "GAMEFILE.") && st.Size() != 31839 {
+			return fmt.Errorf("自訂進度 %s 長度不符，保留原檔", name)
+		}
+	}
+	if index == "" {
+		return fmt.Errorf("自訂進度缺少 FNAME")
+	}
+	b, err = regularBytes(index)
+	if err != nil {
+		return err
+	}
+	return checkProfileIndex(b)
+}
+
+// PrepareChallengeProfile prepares storage only. No Session, CPU, balance hook,
+// language pack, existing player save, or original input is modified.
+func PrepareChallengeProfile(root, base string, rules ChallengeRules) (ChallengeProfile, error) {
+	var result ChallengeProfile
+	digest, err := rules.Digest()
+	if err != nil {
+		return result, err
+	}
+	if base == "" {
+		return result, fmt.Errorf("自訂難度必須指定存檔基底")
+	}
+	custom := filepath.Clean(base) + "-custom"
+	customReal, err := realTarget(custom)
+	if err != nil {
+		return result, err
+	}
+	for _, other := range []string{root, base, SavePath(base, DifficultyHard)} {
+		real, err := realTarget(other)
+		if err != nil {
+			return result, err
+		}
+		if insidePath(real, customReal) || insidePath(customReal, real) {
+			return result, fmt.Errorf("自訂難度根與原版或舊進度重疊")
+		}
+	}
+	if err = CheckRequiredFiles(root, true); err != nil {
+		return result, err
+	}
+	if err = challengeDirectory(custom, true); err != nil {
+		return result, err
+	}
+	rootMarkerPath := filepath.Join(custom, "root.json")
+	b, err := regularBytes(rootMarkerPath)
+	if os.IsNotExist(err) {
+		entries, e := os.ReadDir(custom)
+		if e != nil {
+			return result, e
+		}
+		if len(entries) != 0 {
+			return result, fmt.Errorf("自訂難度根已有未標記內容，保留並拒絕採用")
+		}
+		err = publishChallengeFile(rootMarkerPath, []byte(challengeRootMarker))
+	} else if err == nil && string(b) != challengeRootMarker {
+		err = fmt.Errorf("自訂難度根標記不符")
+	}
+	if err != nil {
+		return result, err
+	}
+	entries, err := os.ReadDir(custom)
+	if err != nil {
+		return result, err
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		st, e := os.Lstat(filepath.Join(custom, name))
+		if e != nil {
+			return result, e
+		}
+		if name == "root.json" && st.Mode().IsRegular() {
+			continue
+		}
+		if (name == "data-v1" || isChallengeDigest(name)) && st.IsDir() && st.Mode()&os.ModeSymlink == 0 {
+			continue
+		}
+		return result, fmt.Errorf("自訂難度根有未知或非一般項目：%s", name)
+	}
+	data := filepath.Join(custom, "data-v1")
+	if err = challengeDirectory(data, true); err != nil {
+		return result, err
+	}
+	required := map[string]RequiredFile{}
+	var projection []RequiredFile
+	for _, rf := range RequiredFiles() {
+		upper := strings.ToUpper(rf.Name)
+		if upper == "FNAME.DAT" || upper == "FNAME.DA_" || strings.HasPrefix(upper, "GAMEFILE.") {
+			continue
+		}
+		required[rf.Name] = rf
+		projection = append(projection, rf)
+	}
+	entries, err = os.ReadDir(data)
+	if err != nil {
+		return result, err
+	}
+	for _, entry := range entries {
+		st, e := os.Lstat(filepath.Join(data, entry.Name()))
+		if e != nil {
+			return result, e
+		}
+		if _, ok := required[entry.Name()]; !ok || !st.Mode().IsRegular() {
+			return result, fmt.Errorf("共用資料含未知或非一般檔：%s", entry.Name())
+		}
+	}
+	sources, err := os.ReadDir(root)
+	if err != nil {
+		return result, err
+	}
+	byName := map[string]string{}
+	for _, entry := range sources {
+		byName[strings.ToUpper(entry.Name())] = entry.Name()
+	}
+	for _, rf := range projection {
+		path := filepath.Join(data, rf.Name)
+		b, err := regularBytes(path)
+		if os.IsNotExist(err) {
+			b, err = regularBytes(filepath.Join(root, byName[rf.Name]))
+			if err != nil {
+				return result, err
+			}
+			sum := sha256.Sum256(b)
+			if int64(len(b)) != rf.Size || hex.EncodeToString(sum[:]) != rf.SHA256 {
+				return result, fmt.Errorf("自訂難度來源在複製前變更：%s", rf.Name)
+			}
+			if err = publishChallengeFile(path, b); err != nil {
+				return result, err
+			}
+		} else if err != nil {
+			return result, err
+		}
+		sum := sha256.Sum256(b)
+		if int64(len(b)) != rf.Size || hex.EncodeToString(sum[:]) != rf.SHA256 {
+			return result, fmt.Errorf("共用資料雜湊不符，保留原檔：%s", rf.Name)
+		}
+	}
+	path := filepath.Join(custom, digest)
+	marker, err := challengeProfileMarker(rules, digest)
+	if err != nil {
+		return result, err
+	}
+	if _, err = os.Lstat(path); os.IsNotExist(err) {
+		temp, err := os.MkdirTemp(custom, ".challenge-profile-*")
+		if err != nil {
+			return result, err
+		}
+		defer os.RemoveAll(temp) // Only this invocation's private directory.
+		if err = os.Chmod(temp, 0o755); err != nil {
+			return result, err
+		}
+		var index strings.Builder
+		for i := 0; i < 5; i++ {
+			fmt.Fprintf(&index, "%d ----/--/-- --/--/-- EMPTY\r\n", i)
+		}
+		if err = publishChallengeFile(filepath.Join(temp, "difficulty.json"), marker); err != nil {
+			return result, err
+		}
+		if err = publishChallengeFile(filepath.Join(temp, "fname.dat"), []byte(index.String())); err != nil {
+			return result, err
+		}
+		if err = publishChallengePath(temp, path); err != nil {
+			if checkErr := validateChallengeProgress(path, marker); checkErr != nil {
+				return result, fmt.Errorf("自訂進度發布失敗：%w", err)
+			}
+		}
+	} else if err != nil {
+		return result, err
+	}
+	if err = validateChallengeProgress(path, marker); err != nil {
+		return result, err
+	}
+	return ChallengeProfile{rules, digest, data, path}, nil
+}
