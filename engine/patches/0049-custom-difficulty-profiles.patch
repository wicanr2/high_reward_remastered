+func TestChallengeProfilesReuseAndShareData(t *testing.T) {
+	root := origRoot(t)
+	base := filepath.Join(t.TempDir(), "saves")
+	old, err := Open(root, Options{SaveDir: base, Difficulty: DifficultyHard, NoDiag: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	oldIndex := readChallengeFile(t, filepath.Join(old.d.Scratch, "fname.dat"))
+	if err := os.MkdirAll(base, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	writeChallengeFile(t, filepath.Join(base, "keep"), []byte("original-progress"))
+	originalMain := readChallengeFile(t, filepath.Join(root, "MAIN.EXE"))
+	r := DefaultChallengeRules()
+	a, err := PrepareChallengeProfile(root, base, r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	game := bytes.Repeat([]byte{0x6a}, 31839)
+	writeChallengeFile(t, filepath.Join(a.SaveDir, "gamefile.000"), game)
+	index := readChallengeFile(t, filepath.Join(a.SaveDir, "fname.dat"))
+	r.Aircraft = VehicleTransport
+	b, err := PrepareChallengeProfile(root, base, r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a.SaveDir == b.SaveDir || a.Digest == b.Digest || a.DataDir != b.DataDir {
+		t.Fatal("進度未分開或資產重複投影")
+	}
+	entries, err := os.ReadDir(a.DataDir)
+	if err != nil || len(entries) != len(RequiredFiles())-1 {
+		t.Fatal("共用投影不是排除 FNAME 的完整資料集合", len(entries), err)
+	}
+	for _, rf := range RequiredFiles() {
+		if rf.Name == "FNAME.DAT" {
+			continue
+		}
+		b := readChallengeFile(t, filepath.Join(a.DataDir, rf.Name))
+		sum := sha256.Sum256(b)
+		if int64(len(b)) != rf.Size || hex.EncodeToString(sum[:]) != rf.SHA256 {
+			t.Fatal("共用投影與原始資料不符", rf.Name)
+		}
+	}
+	c, err := PrepareChallengeProfile(root, base, a.Rules)
+	if err != nil || c != a {
+		t.Fatal("切回設定未重用進度", err)
+	}
+	if !bytes.Equal(game, readChallengeFile(t, filepath.Join(c.SaveDir, "gamefile.000"))) || !bytes.Equal(index, readChallengeFile(t, filepath.Join(c.SaveDir, "fname.dat"))) {
+		t.Fatal("切換設定覆寫了進度")
+	}
+	if !bytes.Equal(oldIndex, readChallengeFile(t, filepath.Join(old.d.Scratch, "fname.dat"))) || string(readChallengeFile(t, filepath.Join(base, "keep"))) != "original-progress" || !bytes.Equal(originalMain, readChallengeFile(t, filepath.Join(root, "MAIN.EXE"))) {
+		t.Fatal("原版或舊高難度改變")
+	}
+	for _, name := range []string{"GAMEFILE.000", "FNAME.DAT", "FNAME.DA_", "fname.dat"} {
+		if _, err := os.Lstat(filepath.Join(a.DataDir, name)); !os.IsNotExist(err) {
+			t.Fatal("共用投影混入來源進度", name, err)
+		}
+	}
+	if _, err := PrepareChallengeProfile(a.DataDir, filepath.Join(t.TempDir(), "saves"), r); err == nil {
+		t.Fatal("共用投影被誤認成完整來源，未驗來源 FNAME")
+	}
+	if _, err := os.Stat(filepath.Join(b.SaveDir, "gamefile.000")); !os.IsNotExist(err) {
+		t.Fatal("新設定繼承其他組合存檔")
+	}
+	if _, err := Open(root, Options{SaveDir: a.SaveDir}); err == nil {
+		t.Fatal("原版接納了自訂進度")
+	}
+}
