+//go:build linux || darwin
+
+package glyphpatch
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+)
+
+func TestNoFollowAndNonRegularOpen(t *testing.T) {
+	dir := t.TempDir()
+	if e := os.WriteFile(filepath.Join(dir, "regular"), []byte("safe"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	if e := os.Symlink("regular", filepath.Join(dir, "link")); e != nil {
+		t.Fatal(e)
+	}
+	if e := syscall.Mkfifo(filepath.Join(dir, "fifo"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	root, e := os.OpenRoot(dir)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer root.Close()
+	if f, e := openRegular(root, "link"); e == nil {
+		f.Close()
+		t.Fatal("followed link")
+	}
+	// The nonblocking descriptor returns even if no FIFO writer exists.
+	f, e := openRegular(root, "fifo")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer f.Close()
+	info, e := f.Stat()
+	if e != nil {
+		t.Fatal(e)
+	}
+	if info.Mode().IsRegular() {
+		t.Fatal("FIFO classified regular")
+	}
+	files := synthetic(t, "en")
+	patchDir := writePatch(t, files)
+	name := filepath.Join(patchDir, "OFL.txt")
+	os.Remove(name)
+	if e := syscall.Mkfifo(name, 0600); e != nil {
+		t.Fatal(e)
+	}
+	if _, e := Load(patchDir, "en"); e == nil {
+		t.Fatal("special file accepted")
+	}
+}
diff --git a/apps/hr/l10n/glyphpatch/patch.go b/apps/hr/l10n/glyphpatch/patch.go
new file mode 100644
index 0000000..2cada4a
--- /dev/null
+++ b/apps/hr/l10n/glyphpatch/patch.go
@@ -0,0 +1,440 @@
+// Package glyphpatch validates the READY five-file/CFONT leaf contract in HR
+// docs/spec/008 section 3.4. It does not adopt translations or build packs.
+package glyphpatch
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"os"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const (
+	fileLimit    = 2 * 1024 * 1024
+	cfontSize    = 416010
+	fontHash     = "b76b0433203017ca80401b2ee0dd69350349871c4b19d504c34dbdd80541690a"
+	oflHash      = "f47ac356aaafd53b53c6c784b3d63e265bf2dc9fe452d4ba5aee4b9b0bf51ca8"
+	reservedHash = "1c841eb8a768ec79051090f39371abc582da8c30a8f2811b26a3089ee015a1fe"
+	cfontHash    = "60e55cf73ba2eb8e83018e8a9b585e22524e730e240732adb5e746b7ed54d8db"
+)
+
+var (
+	hashPattern    = regexp.MustCompile(`^[0-9a-f]{64}$`)
+	versionPattern = regexp.MustCompile(`^[A-Za-z0-9._-]+$`)
+	cpPattern      = regexp.MustCompile(`^U\+[0-9A-F]{4,6}$`)
+	codePattern    = regexp.MustCompile(`^[0-9A-F]{4}$`)
+)
+
+type record struct {
+	index int
+	glyph [30]byte
+}
+
+// Patch contains a validated immutable snapshot. Its zero value is invalid.
+type Patch struct {
+	digest   string
+	language string
+	unitSize int
+	codes    map[[2]rune]uint16
+	records  []record
+}
+
+// Language returns the validated language code, or empty for an invalid patch.
+func (p *Patch) Language() string {
+	if p == nil {
+		return ""
+	}
+	return p.language
+}
+
+// Digest returns the canonical identity of all five snapshot files.
+func (p *Patch) Digest() string {
+	if p == nil {
+		return ""
+	}
+	return p.digest
+}
+
+// Lookup returns the original prebaked code. It never allocates new codes.
+func (p *Patch) Lookup(scalars []rune) (uint16, bool) {
+	if p == nil || p.digest == "" || len(scalars) != p.unitSize {
+		return 0, false
+	}
+	var key [2]rune
+	copy(key[:], scalars)
+	v, ok := p.codes[key]
+	return v, ok
+}
+
+// Apply validates the original CFONT and returns an independent copy. With
+// positive adoption the complete patch is applied; zero adoption preserves it.
+func (p *Patch) Apply(original []byte, adopted int) ([]byte, error) {
+	if p == nil || p.digest == "" {
+		return nil, fmt.Errorf("invalid patch")
+	}
+	if adopted < 0 {
+		return nil, fmt.Errorf("negative adopted count")
+	}
+	if len(original) != cfontSize || hash(original) != cfontHash {
+		return nil, fmt.Errorf("original CFONT identity mismatch")
+	}
+	out := bytes.Clone(original)
+	if adopted > 0 {
+		for _, r := range p.records {
+			copy(out[r.index*30:r.index*30+30], r.glyph[:])
+		}
+	}
+	return out, nil
+}
+
+func hash(data []byte) string { return fmt.Sprintf("%x", sha256.Sum256(data)) }
+
+// Load reads exactly five bounded regular files once, then performs all
+// verification against that snapshot. Metadata identities are provenance;
+// they do not prove who generated the bitmap artwork.
+func Load(dir, code string) (*Patch, error) {
+	face, ok := map[string]string{"zh-CN": "2\tSC", "ja": "0\tJP", "ko": "1\tKR", "en": "3\tTC"}[code]
+	if !ok {
+		return nil, fmt.Errorf("unsupported language %q", code)
+	}
+	if unicode.Version != "15.0.0" {
+		return nil, fmt.Errorf("unsupported Unicode tables %s", unicode.Version)
+	}
+	names := []string{"glyphs-" + code + ".bin", "charmap-" + code + ".tsv", "reserved-codes.tsv", "OFL.txt", "SOURCE.txt"}
+	sort.Strings(names)
+	files, err := snapshot(dir, names)
+	if err != nil {
+		return nil, err
+	}
+	if hash(files["reserved-codes.tsv"]) != reservedHash {
+		return nil, fmt.Errorf("trusted reserved measurement mismatch")
+	}
+	reserved, err := parseReserved(files["reserved-codes.tsv"])
+	if err != nil {
+		return nil, err
+	}
+	if err := checkSource(files, code, face); err != nil {
+		return nil, err
+	}
+	mapLines, err := lines(files["charmap-"+code+".tsv"])
+	if err != nil {
+		return nil, fmt.Errorf("charmap: %w", err)
+	}
+	unitSize, header := 1, "unicode\tcode_hex"
+	if code == "en" {
+		unitSize, header = 2, "left_cp\tright_cp\tcode_hex"
+	}
+	if mapLines[0] != header {
+		return nil, fmt.Errorf("charmap header")
+	}
+	count := len(mapLines) - 1
+	if count < 1 || count > 3276 {
+		return nil, fmt.Errorf("empty or oversized charmap")
+	}
+	data := files["glyphs-"+code+".bin"]
+	if len(data) != count*32 {
+		return nil, fmt.Errorf("glyph record count or truncation")
+	}
+	domain := available(reserved)
+	if count > len(domain) {
+		return nil, fmt.Errorf("charmap exceeds available codes")
+	}
+	p := &Patch{language: code, unitSize: unitSize, codes: make(map[[2]rune]uint16, count), records: make([]record, 0, count)}
+	seenIndex := make(map[int]bool, count)
+	var previous [2]rune
+	for i, line := range mapLines[1:] {
+		fields := strings.Split(line, "\t")
+		if len(fields) != unitSize+1 {
+			return nil, fmt.Errorf("charmap row %d", i+1)
+		}
+		var key [2]rune
+		for j := 0; j < unitSize; j++ {
+			key[j], err = scalar(fields[j], code)
+			if err != nil {
+				return nil, fmt.Errorf("charmap row %d: %w", i+1, err)
+			}
+		}
+		if i > 0 && (key[0] < previous[0] || key[0] == previous[0] && key[1] <= previous[1]) {
+			return nil, fmt.Errorf("unit order or duplicate")
+		}
+		previous = key
+		value, err := parseCode(fields[unitSize])
+		if err != nil {
+			return nil, err
+		}
+		if value != domain[i] {
+			return nil, fmt.Errorf("noncanonical allocation or reserved collision")
+		}
+		if binary.BigEndian.Uint16(data[i*32:i*32+2]) != value {
+			return nil, fmt.Errorf("binary and charmap code mismatch")
+		}
+		index, err := glyphIndex(value)
+		if err != nil {
+			return nil, err
+		}
+		if seenIndex[index] {
+			return nil, fmt.Errorf("colliding glyph indices")
+		}
+		seenIndex[index] = true
+		r := record{index: index}
+		copy(r.glyph[:], data[i*32+2:(i+1)*32])
+		for row := 0; row < 15; row++ {
+			word := binary.BigEndian.Uint16(r.glyph[row*2 : row*2+2])
+			if word&1 != 0 {
+				return nil, fmt.Errorf("bit zero must be blank")
+			}
+			if code == "en" && word&0x100 != 0 {
+				return nil, fmt.Errorf("pair middle column must be blank")
+			}
+			if code == "en" && (key[0] == ' ' && word&0xfe00 != 0 || key[1] == ' ' && word&0x00fe != 0) {
+				return nil, fmt.Errorf("pair space half must be blank")
+			}
+			if code != "en" && (key[0] == ' ' || key[0] == 0x3000) && word != 0 {
+				return nil, fmt.Errorf("scalar space glyph must be blank")
+			}
+		}
+		p.codes[key] = value
+		p.records = append(p.records, r)
+	}
+	var stream strings.Builder
+	stream.WriteString("hr-l2-patch-v1\n")
+	for _, name := range names {
+		fmt.Fprintf(&stream, "%s\t%d\t%s\n", name, len(files[name]), hash(files[name]))
+	}
+	p.digest = hash([]byte(stream.String()))
+	return p, nil
+}
+
+func snapshot(dir string, names []string) (map[string][]byte, error) {
+	info, err := os.Lstat(dir)
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return nil, fmt.Errorf("patch root must be a directory")
+	}
+	root, err := os.OpenRoot(dir)
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+	d, err := root.Open(".")
+	if err != nil {
+		return nil, err
+	}
+	defer d.Close()
+	dinfo, err := d.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !os.SameFile(info, dinfo) {
+		return nil, fmt.Errorf("patch root changed")
+	}
+	entries, err := d.ReadDir(6)
+	if err != nil && err != io.EOF {
+		return nil, err
+	}
+	if len(entries) != 5 {
+		return nil, fmt.Errorf("patch must contain exactly five files")
+	}
+	actual := make([]string, len(entries))
+	for i, entry := range entries {
+		actual[i] = entry.Name()
+	}
+	sort.Strings(actual)
+	for i := range names {
+		if actual[i] != names[i] {
+			return nil, fmt.Errorf("patch file names differ")
+		}
+	}
+	files := make(map[string][]byte, 5)
+	for _, name := range names {
+		before, err := root.Lstat(name)
+		if err != nil {
+			return nil, err
+		}
+		if !before.Mode().IsRegular() || before.Size() > fileLimit {
+			return nil, fmt.Errorf("not a bounded regular file: %s", name)
+		}
+		f, err := openRegular(root, name)
+		if err != nil {
+			return nil, err
+		}
+		after, statErr := f.Stat()
+		if statErr != nil || !after.Mode().IsRegular() || !os.SameFile(before, after) || after.Size() > fileLimit {
+			f.Close()
+			return nil, fmt.Errorf("file changed or not regular: %s", name)
+		}
+		data, readErr := io.ReadAll(io.LimitReader(f, fileLimit+1))
+		closeErr := f.Close()
+		if readErr != nil {
+			return nil, readErr
+		}
+		if closeErr != nil {
+			return nil, closeErr
+		}
+		if len(data) > fileLimit {
+			return nil, fmt.Errorf("file grew beyond limit: %s", name)
+		}
+		files[name] = data
+	}
+	return files, nil
+}
+
+func lines(data []byte) ([]string, error) {
+	if !utf8.Valid(data) || bytes.HasPrefix(data, []byte{0xef, 0xbb, 0xbf}) || bytes.ContainsAny(data, "\r\x00") || len(data) == 0 || data[len(data)-1] != '\n' {
+		return nil, fmt.Errorf("requires UTF-8 without BOM, CR or NUL and terminal LF")
+	}
+	return strings.Split(string(data[:len(data)-1]), "\n"), nil
+}
+
+func parseCode(text string) (uint16, error) {
+	if !codePattern.MatchString(text) {
+		return 0, fmt.Errorf("noncanonical code")
+	}
+	v, _ := strconv.ParseUint(text, 16, 16)
+	lead, trail := int(v>>8), int(v&255)
+	if lead < 0xe0 || lead > 0xf9 || !(trail >= 0x40 && trail <= 0x7e || trail >= 0xa1 && trail <= 0xdf) {
+		return 0, fmt.Errorf("code outside domain")
+	}
+	return uint16(v), nil
+}
+
+func scalar(text, language string) (rune, error) {
+	if !cpPattern.MatchString(text) {
+		return 0, fmt.Errorf("noncanonical scalar")
+	}
+	v, _ := strconv.ParseUint(text[2:], 16, 32)
+	r := rune(v)
+	if !utf8.ValidRune(r) || fmt.Sprintf("U+%04X", r) != text {
+		return 0, fmt.Errorf("invalid scalar")
+	}
+	// Enumerate permitted categories instead of unicode.Cn, which is only
+	// exposed starting in Go 1.25. This also rejects all unassigned scalars
+	// with the module's Go 1.24 API surface and the fixed Unicode 15 table.
+	if !(unicode.IsLetter(r) || unicode.IsNumber(r) || unicode.IsPunct(r) || unicode.IsSymbol(r) || unicode.Is(unicode.Zs, r)) || unicode.IsSpace(r) && r != ' ' && !(language != "en" && r == 0x3000) {
+		return 0, fmt.Errorf("unsupported scalar")
+	}
+	return r, nil
+}
+
+func parseReserved(data []byte) (map[uint16]bool, error) {
+	ls, err := lines(data)
+	if err != nil {
+		return nil, err
+	}
+	if ls[0] != "code_hex\tsources" {
+		return nil, fmt.Errorf("reserved header")
+	}
+	out := make(map[uint16]bool)
+	var previous uint16
+	for _, line := range ls[1:] {
+		fields := strings.Split(line, "\t")
+		if len(fields) != 2 || fields[1] == "" {
+			return nil, fmt.Errorf("reserved row")
+		}
+		v, err := parseCode(fields[0])
+		if err != nil {
+			return nil, err
+		}
+		if v <= previous {
+			return nil, fmt.Errorf("reserved order or duplicate")
+		}
+		previous, out[v] = v, true
+	}
+	return out, nil
+}
+
+func available(reserved map[uint16]bool) []uint16 {
+	var out []uint16
+	for lead := 0xe0; lead <= 0xf9; lead++ {
+		for trail := 0x40; trail <= 0xdf; trail++ {
+			if trail > 0x7e && trail < 0xa1 {
+				continue
+			}
+			v := uint16(lead<<8 | trail)
+			if !reserved[v] {
+				out = append(out, v)
+			}
+		}
+	}
+	return out
+}
+
+func glyphIndex(code uint16) (int, error) {
+	lead, trail := int(code>>8), int(code&255)
+	tail := trail - 0x40
+	if trail > 0x7e {
+		tail = trail - 0x62
+	}
+	index := (lead-0xa4)*157 + tail - 0x198 + 0x305
+	if index < 0 || index >= 13867 || index*30+30 > cfontSize {
+		return 0, fmt.Errorf("glyph index outside CFONT")
+	}
+	return index, nil
+}
+
+func checkSource(files map[string][]byte, code, face string) error {
+	ls, err := lines(files["SOURCE.txt"])
+	if err != nil {
+		return fmt.Errorf("SOURCE: %w", err)
+	}
+	source := make(map[string]string)
+	previous := ""
+	for _, line := range ls {
+		fields := strings.Split(line, "\t")
+		if len(fields) != 2 || fields[1] == "" || fields[0] <= previous {
+			return fmt.Errorf("SOURCE row order or duplicate")
+		}
+		previous, source[fields[0]] = fields[0], fields[1]
+	}
+	faceParts := strings.Split(face, "\t")
+	expected := map[string]string{
+		"format": "hr-l2-source-v1", "language": code, "unicode_version": "15.0.0",
+		"font_file": "NotoSansCJK-Regular.ttc", "font_sha256": fontHash,
+		"font_version": "Version 2.004;hotconv 1.0.118;makeotfexe 2.5.65603",
+		"face_index":   faceParts[0], "face_name": "Noto Sans CJK " + faceParts[1],
+		"pillow_version": "12.3.0", "fonttools_version": "4.66.1", "cell": "15x15", "threshold": "128",
+		"pixel_size": "13", "placement": "mask-center-floor", "unit_mode": "scalar15",
+	}
+	if code == "en" {
+		expected["pixel_size"], expected["placement"], expected["unit_mode"] = "10", "pair2x7-baseline11", "pair2x7"
+		for k, v := range map[string]string{"source_canvas": "12x15", "source_anchor": "ls", "source_origin": "0,11", "source_clipping": "canvas-before-getbbox", "source_crop": "0,0,bbox-right,15", "shrink": "width-gt7:BILINEAR:7x15", "half_origin": "0,0;8,0", "blank_column": "7", "blank_scalar": "U+0020"} {
+			expected[k] = v
+		}
+	}
+	for k, v := range map[string]string{"glyphs_sha256": "glyphs-" + code + ".bin", "charmap_sha256": "charmap-" + code + ".tsv", "reserved_sha256": "reserved-codes.tsv", "ofl_sha256": "OFL.txt"} {
+		expected[k] = hash(files[v])
+	}
+	if len(source) != len(expected)+4 {
+		return fmt.Errorf("SOURCE key set")
+	}
+	for k, v := range expected {
+		if source[k] != v {
+			return fmt.Errorf("unsupported SOURCE parameter %s", k)
+		}
+	}
+	for _, key := range []string{"units_sha256", "rasterizer_sha256"} {
+		if !hashPattern.MatchString(source[key]) {
+			return fmt.Errorf("SOURCE hash %s", key)
+		}
+	}
+	if !strings.HasPrefix(source["container_image_id"], "sha256:") || !hashPattern.MatchString(strings.TrimPrefix(source["container_image_id"], "sha256:")) {
+		return fmt.Errorf("container identity")
+	}
+	if !versionPattern.MatchString(source["rasterizer_version"]) {
+		return fmt.Errorf("rasterizer version")
+	}
+	if hash(files["OFL.txt"]) != oflHash {
+		return fmt.Errorf("OFL differs from recorded font license")
+	}
+	return nil
+}
