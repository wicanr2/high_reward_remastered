+package budget
+
+import "fmt"
+
+// LimitsResult contains the original item's budgets. Specs is a fresh slice
+// with complete format specifications in their original order.
+type LimitsResult struct {
+	Width, Expanded, Rows, Length int
+	Specs                         []string
+}
+
+// Limits reads the same window, original metrics and specifications as Check.
+// It rejects unknown windows and unsupported original specifications.
+func Limits(in Input) (LimitsResult, []Violation) {
+	w, ok := WindowFor(in.File, in.Class)
+	if !ok {
+		return LimitsResult{}, []Violation{{ID: in.ID, Rule: RuleLineWidth, Detail: "unknown-window"}}
+	}
+	us := scanUnits(in.Orig)
+	var vs []Violation
+	for _, u := range us {
+		if u.bad {
+			vs = append(vs, Violation{ID: in.ID, Rule: RulePlaceholder, Detail: fmt.Sprintf("original malformed offset=%d", u.off)})
+		}
+	}
+	if len(vs) != 0 {
+		return LimitsResult{}, vs
+	}
+	e, r := itemMetrics(in.Orig, w)
+	return LimitsResult{Width: w.W, Expanded: max(w.W, e), Rows: max(w.H, r), Length: maxItemLen, Specs: specTexts(in.Orig, us)}, nil
+}
+
+// ConversionAt exposes the existing conversion parser without exposing its
+// mutable internals. n is the literal length; expanded is the saturated bound.
+func ConversionAt(b []byte, offset int) (n, expanded int, ok bool) {
+	if offset < 0 || offset >= len(b) || b[offset] != '%' {
+		return 0, 0, false
+	}
+	sp, ok := parseSpec(b, offset)
+	if !ok {
+		return 0, 0, false
+	}
+	return sp.n, sp.expand(), true
+}
