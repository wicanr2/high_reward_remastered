diff --git a/apps/hr/l10n/enpairs/prepare.go b/apps/hr/l10n/enpairs/prepare.go
new file mode 100644
index 0000000..3bda45b
--- /dev/null
+++ b/apps/hr/l10n/enpairs/prepare.go
@@ -0,0 +1,251 @@
+// Package enpairs prepares English text using a validated fixed pair patch.
+// It implements only the READY pure-function leaf in HR spec 008 section 3.5.
+// It performs no I/O, allocates no codes and does not build language packs.
+package enpairs
+
+import (
+	"fmt"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/budget"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/glyphpatch"
+)
+
+const (
+	RulePatch       = "glyph-patch"
+	RuleScalar      = "source-scalar"
+	RuleMissingPair = "missing-pair"
+)
+
+// Input's original bytes and window come from the trusted original parser.
+// Prepare cannot replace that caller's original identity/adoption checks.
+type Input struct {
+	ID, File, Class string
+	Orig            []byte
+	Text            string
+	Patch           *glyphpatch.Patch
+}
+
+type atom struct {
+	scalar   rune
+	spec     string
+	expanded int
+}
+type span struct{ start, end int }
+type solution struct {
+	lines                   []span
+	rows, literal, expanded int
+}
+
+// Prepare preserves explicit newlines, pads odd ordinary segments separately
+// at format boundaries and fixes the wrapping before testing the pair subset.
+// Every violation returns nil output. Diagnostic details contain no source text.
+func Prepare(in Input) ([]byte, []budget.Violation) {
+	fail := func(rule, detail string) ([]byte, []budget.Violation) {
+		return nil, []budget.Violation{{ID: in.ID, Rule: rule, Detail: detail}}
+	}
+	if in.Patch == nil || in.Patch.Language() != "en" || in.Patch.Digest() == "" {
+		return fail(RulePatch, "invalid-English-patch")
+	}
+	if len(in.Text) > 2044 {
+		return fail(budget.RuleLength, fmt.Sprintf("source-bytes=%d limit=2044", len(in.Text)))
+	}
+	if !utf8.ValidString(in.Text) {
+		return fail(RuleScalar, "invalid-UTF8")
+	}
+	count := utf8.RuneCountInString(in.Text)
+	if count > 511 {
+		return fail(budget.RuleLength, fmt.Sprintf("source-scalars=%d limit=511", count))
+	}
+	if unicode.Version != "15.0.0" {
+		return fail(RuleScalar, "unsupported-Unicode-version")
+	}
+	lim, vs := budget.Limits(budget.Input{ID: in.ID, File: in.File, Class: in.Class, Orig: in.Orig})
+	if len(vs) != 0 {
+		return nil, vs
+	}
+	as, specs, vs := tokenize(in.ID, in.Text)
+	if len(vs) != 0 {
+		return nil, vs
+	}
+	if len(specs) != len(lim.Specs) {
+		return fail(budget.RulePlaceholder, fmt.Sprintf("count orig=%d trans=%d", len(lim.Specs), len(specs)))
+	}
+	for i, s := range specs {
+		if s != lim.Specs[i] {
+			return fail(budget.RulePlaceholder, fmt.Sprintf("index=%d mismatch", i))
+		}
+	}
+	var lines []span
+	for start := 0; ; {
+		end := start
+		for end < len(as) && as[end].scalar != '\n' {
+			end++
+		}
+		s, ok := wrap(as, start, end, lim.Width, lim.Expanded)
+		if !ok {
+			return fail(budget.RuleLineWidth, "no-word-boundary-solution")
+		}
+		lines = append(lines, s.lines...)
+		if end == len(as) {
+			break
+		}
+		start = end + 1
+	}
+	rows, lit, exp := 0, len(lines)-1, len(lines)-1
+	for _, l := range lines {
+		a, b := metrics(as[l.start:l.end])
+		lit += a
+		exp += b
+		rows += max(1, (b+lim.Width-1)/lim.Width)
+	}
+	if rows > lim.Rows {
+		vs = append(vs, budget.Violation{ID: in.ID, Rule: budget.RuleRows, Detail: fmt.Sprintf("rows=%d limit=%d", rows, lim.Rows)})
+	}
+	if lit > lim.Length || exp > lim.Length {
+		vs = append(vs, budget.Violation{ID: in.ID, Rule: budget.RuleLength, Detail: fmt.Sprintf("raw=%d expanded=%d limit=%d", lit, exp, lim.Length)})
+	}
+	if len(vs) != 0 {
+		return nil, vs
+	}
+	out := make([]byte, 0, lit)
+	missing := make(map[[2]rune]bool)
+	for i, l := range lines {
+		if i > 0 {
+			out = append(out, '\n')
+		}
+		for j := l.start; j < l.end; {
+			if as[j].spec != "" {
+				out = append(out, as[j].spec...)
+				j++
+				continue
+			}
+			end := j
+			for end < l.end && as[end].spec == "" {
+				end++
+			}
+			for k := j; k < end; k += 2 {
+				pair := [2]rune{as[k].scalar, ' '}
+				if k+1 < end {
+					pair[1] = as[k+1].scalar
+				}
+				code, ok := in.Patch.Lookup(pair[:])
+				if !ok {
+					if !missing[pair] {
+						vs = append(vs, budget.Violation{ID: in.ID, Rule: RuleMissingPair, Detail: fmt.Sprintf("rebuild-glyph-patch U+%04X U+%04X", pair[0], pair[1])})
+						missing[pair] = true
+					}
+					continue
+				}
+				out = append(out, byte(code>>8), byte(code))
+			}
+			j = end
+		}
+	}
+	if len(vs) != 0 {
+		return nil, vs
+	}
+	vs = budget.Check(budget.Input{ID: in.ID, File: in.File, Class: in.Class, Orig: in.Orig, Trans: out})
+	if len(vs) != 0 {
+		return nil, vs
+	}
+	return out, nil
+}
+
+func tokenize(id, text string) ([]atom, []string, []budget.Violation) {
+	var as []atom
+	var specs []string
+	b := []byte(text)
+	for off := 0; off < len(b); {
+		if b[off] == '%' {
+			n, e, ok := budget.ConversionAt(b, off)
+			if !ok {
+				return nil, nil, []budget.Violation{{ID: id, Rule: budget.RulePlaceholder, Detail: fmt.Sprintf("malformed offset=%d", off)}}
+			}
+			s := string(b[off : off+n])
+			as = append(as, atom{spec: s, expanded: e})
+			specs = append(specs, s)
+			off += n
+			continue
+		}
+		r, n := utf8.DecodeRune(b[off:])
+		if r != '\n' && r != ' ' && (!unicode.IsGraphic(r) || unicode.IsMark(r) || unicode.IsSpace(r)) {
+			return nil, nil, []budget.Violation{{ID: id, Rule: RuleScalar, Detail: fmt.Sprintf("offset=%d U+%04X", off, r)}}
+		}
+		as = append(as, atom{scalar: r})
+		off += n
+	}
+	return as, specs, nil
+}
+
+func metrics(as []atom) (literal, expanded int) {
+	n := 0
+	flush := func() { a := 2 * ((n + 1) / 2); literal += a; expanded += a; n = 0 }
+	for _, a := range as {
+		if a.spec == "" {
+			n++
+			continue
+		}
+		flush()
+		literal += len(a.spec)
+		expanded += a.expanded
+	}
+	flush()
+	return
+}
+
+func wrap(as []atom, start, end, width, expandedLimit int) (solution, bool) {
+	if start == end {
+		return solution{lines: []span{{start, end}}, rows: 1}, true
+	}
+	ends := []int{}
+	for i := start; i < end; i++ {
+		if as[i].spec == "" && as[i].scalar == ' ' {
+			ends = append(ends, i)
+		}
+	}
+	ends = append(ends, end)
+	memo := make(map[int]solution)
+	known := make(map[int]bool)
+	var solve func(int) (solution, bool)
+	solve = func(pos int) (solution, bool) {
+		if known[pos] {
+			s, ok := memo[pos]
+			return s, ok
+		}
+		known[pos] = true
+		var best solution
+		found := false
+		for i := len(ends) - 1; i >= 0; i-- {
+			e := ends[i]
+			if e < pos || e == pos && e != end {
+				continue
+			}
+			lit, exp := metrics(as[pos:e])
+			if lit > width || exp > expandedLimit {
+				continue
+			}
+			s := solution{lines: []span{{pos, e}}, rows: max(1, (exp+width-1)/width), literal: lit, expanded: exp}
+			if e != end {
+				tail, ok := solve(e + 1)
+				if !ok {
+					continue
+				}
+				s.lines = append(s.lines, tail.lines...)
+				s.rows += tail.rows
+				s.literal += 1 + tail.literal
+				s.expanded += 1 + tail.expanded
+			}
+			if !found || s.rows < best.rows || s.rows == best.rows && (len(s.lines) < len(best.lines) || len(s.lines) == len(best.lines) && s.literal < best.literal) {
+				best = s
+				found = true
+			}
+		}
+		if found {
+			memo[pos] = best
+		}
+		return best, found
+	}
+	return solve(start)
+}
