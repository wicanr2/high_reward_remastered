+++ b/apps/hr/l10n/enpairs/prepare_test.go
@@ -0,0 +1,328 @@
+package enpairs
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/budget"
+	"github.com/wicanr2/dosgolem/apps/hr/l10n/glyphpatch"
+)
+
+// Only synthetic text and bitmaps are used here. The OFL text is public;
+// reserved-codes.tsv is the independent trusted measurement fixture.
+func fixture(t *testing.T, language string, pairs ...[2]rune) *glyphpatch.Patch {
+	t.Helper()
+	read := func(name string) []byte {
+		b, e := os.ReadFile(filepath.Join("..", "glyphpatch", "testdata", name))
+		if e != nil {
+			t.Fatal(e)
+		}
+		return b
+	}
+	files := map[string][]byte{"OFL.txt": read("OFL.txt"), "reserved-codes.tsv": read("reserved-codes.tsv")}
+	reserved := map[uint16]bool{}
+	for _, line := range strings.Split(string(files["reserved-codes.tsv"]), "\n")[1:] {
+		if line == "" {
+			continue
+		}
+		n, e := strconv.ParseUint(strings.Split(line, "\t")[0], 16, 16)
+		if e != nil {
+			t.Fatal(e)
+		}
+		reserved[uint16(n)] = true
+	}
+	set := map[[2]rune]bool{}
+	for _, p := range pairs {
+		set[p] = true
+	}
+	if len(set) == 0 {
+		set[[2]rune{'A', ' '}] = true
+	}
+	pairs = nil
+	for p := range set {
+		pairs = append(pairs, p)
+	}
+	sort.Slice(pairs, func(i, j int) bool {
+		return pairs[i][0] < pairs[j][0] || pairs[i][0] == pairs[j][0] && pairs[i][1] < pairs[j][1]
+	})
+	var codes []uint16
+	for lead := 0xe0; lead <= 0xf9; lead++ {
+		for trail := 0x40; trail <= 0xdf; trail++ {
+			if trail > 0x7e && trail < 0xa1 {
+				continue
+			}
+			c := uint16(lead<<8 | trail)
+			if !reserved[c] {
+				codes = append(codes, c)
+			}
+		}
+	}
+	var cmap strings.Builder
+	if language == "en" {
+		cmap.WriteString("left_cp\tright_cp\tcode_hex\n")
+	} else {
+		cmap.WriteString("unicode\tcode_hex\n")
+	}
+	for i, p := range pairs {
+		if language == "en" {
+			fmt.Fprintf(&cmap, "U+%04X\tU+%04X\t%04X\n", p[0], p[1], codes[i])
+		} else {
+			fmt.Fprintf(&cmap, "U+%04X\t%04X\n", p[0], codes[i])
+		}
+		var rec [32]byte
+		binary.BigEndian.PutUint16(rec[:2], codes[i])
+		var bits uint16
+		if p[0] != ' ' {
+			bits |= 0x8000
+		}
+		if language == "en" && p[1] != ' ' {
+			bits |= 0x0080
+		}
+		for r := 0; r < 15; r++ {
+			binary.BigEndian.PutUint16(rec[2+2*r:], bits)
+		}
+		files["glyphs-"+language+".bin"] = append(files["glyphs-"+language+".bin"], rec[:]...)
+	}
+	files["charmap-"+language+".tsv"] = []byte(cmap.String())
+	face := map[string]string{"en": "3\tTC", "ja": "0\tJP"}[language]
+	f := strings.Split(face, "\t")
+	source := map[string]string{
+		"format": "hr-l2-source-v1", "language": language, "units_sha256": strings.Repeat("a", 64), "unicode_version": "15.0.0",
+		"font_file": "NotoSansCJK-Regular.ttc", "font_sha256": "b76b0433203017ca80401b2ee0dd69350349871c4b19d504c34dbdd80541690a", "font_version": "Version 2.004;hotconv 1.0.118;makeotfexe 2.5.65603",
+		"face_index": f[0], "face_name": "Noto Sans CJK " + f[1], "pillow_version": "12.3.0", "fonttools_version": "4.66.1",
+		"pixel_size": "13", "cell": "15x15", "threshold": "128", "placement": "mask-center-floor", "unit_mode": "scalar15",
+		"container_image_id": "sha256:" + strings.Repeat("b", 64), "rasterizer_version": "synthetic-test-v1", "rasterizer_sha256": strings.Repeat("c", 64),
+	}
+	if language == "en" {
+		source["pixel_size"], source["placement"], source["unit_mode"] = "10", "pair2x7-baseline11", "pair2x7"
+		for k, v := range map[string]string{"source_canvas": "12x15", "source_anchor": "ls", "source_origin": "0,11", "source_clipping": "canvas-before-getbbox", "source_crop": "0,0,bbox-right,15", "shrink": "width-gt7:BILINEAR:7x15", "half_origin": "0,0;8,0", "blank_column": "7", "blank_scalar": "U+0020"} {
+			source[k] = v
+		}
+	}
+	for k, n := range map[string]string{"glyphs_sha256": "glyphs-" + language + ".bin", "charmap_sha256": "charmap-" + language + ".tsv", "reserved_sha256": "reserved-codes.tsv", "ofl_sha256": "OFL.txt"} {
+		source[k] = fmt.Sprintf("%x", sha256.Sum256(files[n]))
+	}
+	var keys []string
+	for k := range source {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var sb strings.Builder
+	for _, k := range keys {
+		fmt.Fprintf(&sb, "%s\t%s\n", k, source[k])
+	}
+	files["SOURCE.txt"] = []byte(sb.String())
+	dir := t.TempDir()
+	for n, b := range files {
+		if e := os.WriteFile(filepath.Join(dir, n), b, 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+	p, e := glyphpatch.Load(dir, language)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return p
+}
+
+func input(p *glyphpatch.Patch, text string) Input {
+	return Input{ID: "synthetic", File: "SYSTEM.MES", Text: text, Patch: p}
+}
+func code(t *testing.T, p *glyphpatch.Patch, a, b rune) []byte {
+	t.Helper()
+	c, ok := p.Lookup([]rune{a, b})
+	if !ok {
+		t.Fatal("test fixture missing pair")
+	}
+	return []byte{byte(c >> 8), byte(c)}
+}
+func checkFail(t *testing.T, in Input, rule string) {
+	t.Helper()
+	out, vs := Prepare(in)
+	if out != nil || len(vs) == 0 {
+		t.Fatal("failure returned output or no violation")
+	}
+	for _, v := range vs {
+		if v.ID != in.ID {
+			t.Fatal("wrong id")
+		}
+		if v.Rule == rule {
+			return
+		}
+	}
+	t.Fatalf("missing rule %s: %+v", rule, vs)
+}
+
+func TestBoundariesAndImmutability(t *testing.T) {
+	p := fixture(t, "en", [2]rune{'A', ' '}, [2]rune{'B', ' '})
+	in := input(p, "A%sB")
+	in.Orig = []byte{0xA4, '%', 's'}
+	before := bytes.Clone(in.Orig)
+	digest := p.Digest()
+	want := append(append(code(t, p, 'A', ' '), []byte("%s")...), code(t, p, 'B', ' ')...)
+	for n := 0; n < 2; n++ {
+		out, vs := Prepare(in)
+		if len(vs) != 0 || !bytes.Equal(out, want) {
+			t.Fatalf("boundary output %x %+v", out, vs)
+		}
+		out[0] = 0
+	}
+	if !bytes.Equal(in.Orig, before) || p.Digest() != digest || in.Text != "A%sB" {
+		t.Fatal("input changed")
+	}
+	for _, spec := range []string{"%s", "%d", "%ld", "%03d", "%.0d", "%10ld"} {
+		in := input(p, spec)
+		in.Orig = []byte(spec)
+		out, vs := Prepare(in)
+		if len(vs) != 0 || string(out) != spec {
+			t.Fatalf("format boundary %+v", vs)
+		}
+	}
+}
+
+func TestPreserveEmptyLinesSpacesAndFixedReorder(t *testing.T) {
+	p := fixture(t, "en", [2]rune{'A', 'B'}, [2]rune{'C', 'D'}, [2]rune{' ', ' '})
+	in := input(p, "AB  CD\n")
+	want := append(append(append(code(t, p, 'A', 'B'), code(t, p, ' ', ' ')...), code(t, p, 'C', 'D')...), '\n')
+	out, vs := Prepare(in)
+	if len(vs) != 0 || !bytes.Equal(out, want) || bytes.Contains(out, []byte{' '}) {
+		t.Fatalf("spaces %x %+v", out, vs)
+	}
+	for _, text := range []string{"AB\nCD", "CD\nAB"} {
+		out, vs := Prepare(input(p, text))
+		if len(vs) != 0 || len(out) != 5 {
+			t.Fatalf("reorder %x %+v", out, vs)
+		}
+	}
+	for _, text := range []string{"", "\n", "\n\n\n"} {
+		out, vs := Prepare(input(p, text))
+		if len(vs) != 0 || string(out) != text {
+			t.Fatalf("blank rows %+v", vs)
+		}
+	}
+	checkFail(t, input(p, "\n\n\n\n"), budget.RuleRows)
+	checkFail(t, input(p, "EF"), RuleMissingPair)
+}
+
+func TestSourceRejectionsAndNoLeak(t *testing.T) {
+	p := fixture(t, "en")
+	for _, text := range []string{"A\tB", "A\rB", "A\x00B", "A\u0301", "A\u200DB", "\uE000", "\u0378", "\u3000", "\u00A0", "\u2028", string([]byte{0xff})} {
+		checkFail(t, input(p, text), RuleScalar)
+	}
+	for _, text := range []string{"%%", "%*d", "% d", "%ls", "%f", "%.d", "%1.s", "%"} {
+		checkFail(t, input(p, text), budget.RulePlaceholder)
+	}
+	in := input(p, "%d%s")
+	in.Orig = []byte("%s%d")
+	checkFail(t, in, budget.RulePlaceholder)
+	checkFail(t, input(p, strings.Repeat("A", 512)), budget.RuleLength)
+	checkFail(t, input(p, strings.Repeat("x", 2045)), budget.RuleLength)
+	checkFail(t, input(nil, "A"), RulePatch)
+	checkFail(t, input(new(glyphpatch.Patch), "A"), RulePatch)
+	checkFail(t, input(fixture(t, "ja", [2]rune{'A', ' '}), "A"), RulePatch)
+	in = input(p, "A")
+	in.File = "unknown"
+	checkFail(t, in, budget.RuleLineWidth)
+	in = input(p, "A")
+	in.Orig = []byte("%.d")
+	checkFail(t, in, budget.RulePlaceholder)
+	in = input(p, "SECRET")
+	_, vs := Prepare(in)
+	for _, v := range vs {
+		if strings.Contains(v.Detail, in.Text) {
+			t.Fatal("source text leaked")
+		}
+	}
+}
+
+func TestWrappingBudgetAndNoCodebookFallback(t *testing.T) {
+	p := fixture(t, "en", [2]rune{'A', 'A'}, [2]rune{'A', ' '}, [2]rune{'B', 'B'}, [2]rune{'B', ' '})
+	in := input(p, strings.Repeat("A", 15)+" "+strings.Repeat("B", 15))
+	out, vs := Prepare(in)
+	if len(vs) != 0 || len(out) != 33 || out[16] != '\n' {
+		t.Fatalf("wrap %x %+v", out, vs)
+	}
+	checkFail(t, input(p, strings.Repeat("A", 31)), budget.RuleLineWidth)
+	// The wrapping is identical with a deficient codebook; missing pairs are
+	// rejected without reallocating codes or selecting a different wrapping.
+	in.Patch = fixture(t, "en", [2]rune{'A', 'A'}, [2]rune{'A', ' '}, [2]rune{'B', 'B'})
+	checkFail(t, in, RuleMissingPair)
+	// A second, equally budget-safe fold has every pair in this patch. The
+	// deterministic longer-first fold still wins, then fails on its missing
+	// space+C pair. The fixed codebook cannot steer folding.
+	in = input(fixture(t, "en", [2]rune{'A', 'B'}, [2]rune{'C', 'C'}, [2]rune{'C', ' '}, [2]rune{'D', 'E'}), "AB "+strings.Repeat("C", 25)+" DE")
+	checkFail(t, in, RuleMissingPair)
+	in = input(p, strings.Repeat("A ", 200))
+	checkFail(t, in, budget.RuleRows)
+	in = input(p, strings.Repeat("A ", 255))
+	in.File = "SP.MES"
+	in.Orig = []byte(strings.Repeat("A\n", 30))
+	checkFail(t, in, budget.RuleLength)
+	in = input(p, "A%s\nB")
+	in.Orig = []byte("%s")
+	checkFail(t, in, budget.Rule1676)
+	in = input(p, "%s%s")
+	in.Orig = []byte("%s%s")
+	out, vs = Prepare(in)
+	if len(vs) != 0 || string(out) != "%s%s" {
+		t.Fatal(vs)
+	}
+	// Explicit empty rows consume the same row budget after format expansion.
+	in.Text = "%s%s\n\n\n"
+	checkFail(t, in, budget.RuleRows)
+}
+
+func TestWrappingPriority(t *testing.T) {
+	// Independent expected line lengths: fewest rows first, then breaks, raw
+	// bytes, then the longer earlier line. No patch lookup affects this choice.
+	text := "AB " + strings.Repeat("C", 25) + " DE"
+	as, _, vs := tokenize("x", text)
+	if len(vs) != 0 {
+		t.Fatal(vs)
+	}
+	s, ok := wrap(as, 0, len(as), 30, 30)
+	if !ok || len(s.lines) != 2 || s.lines[0].end != 28 {
+		t.Fatalf("priority %+v %v", s, ok)
+	}
+	// An unbroken line fits the literal width but expands to 62 bytes,
+	// requiring three rendered rows. Two lines expand to 30 bytes each.
+	as, _, vs = tokenize("x", "AA%sAAAAAAAA AA%sAAAAAAAA")
+	if len(vs) != 0 {
+		t.Fatal(vs)
+	}
+	s, ok = wrap(as, 0, len(as), 30, 62)
+	if !ok || s.rows != 2 || len(s.lines) != 2 || s.lines[0].end != 11 {
+		t.Fatalf("expanded priority %+v", s)
+	}
+	// Both candidates have two rows and two lines. The shorter first line
+	// emits 31 bytes; the longer-first alternative emits 33 after odd pads.
+	as, _, vs = tokenize("x", "AB "+strings.Repeat("C", 24)+" DEF")
+	if len(vs) != 0 {
+		t.Fatal(vs)
+	}
+	s, ok = wrap(as, 0, len(as), 30, 30)
+	if !ok || s.rows != 2 || len(s.lines) != 2 || s.literal != 31 || s.lines[0].end != 2 {
+		t.Fatalf("literal priority %+v", s)
+	}
+}
+
+func TestSource511ScalarNewlineBoundary(t *testing.T) {
+	p := fixture(t, "en", [2]rune{'A', 'B'})
+	in := input(p, "AB"+strings.Repeat("\n", 509))
+	in.Orig = []byte(in.Text)
+	out, vs := Prepare(in)
+	want := append(code(t, p, 'A', 'B'), bytes.Repeat([]byte{'\n'}, 509)...)
+	if len(vs) != 0 || len(out) != 511 || !bytes.Equal(out, want) {
+		t.Fatalf("511-scalar boundary output=%d violations=%+v", len(out), vs)
+	}
+	in.Text += "\n"
+	checkFail(t, in, budget.RuleLength)
+}
