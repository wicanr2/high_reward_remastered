+func TestLanguagesAndSnapshot(t *testing.T) {
+	if unicode.Version != "15.0.0" {
+		t.Fatal(unicode.Version)
+	}
+	for _, language := range []string{"zh-CN", "ja", "ko", "en"} {
+		t.Run(language, func(t *testing.T) {
+			files := synthetic(t, language)
+			dir := writePatch(t, files)
+			p, e := Load(dir, language)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if p.Language() != language {
+				t.Fatal("language getter")
+			}
+			units := []rune{'A'}
+			if language == "en" {
+				units = append(units, ' ')
+			}
+			if c, ok := p.Lookup(units); !ok || c != 0xe040 {
+				t.Fatalf("lookup %04X %v", c, ok)
+			}
+			units[0] = 'X'
+			if _, ok := p.Lookup(units); ok {
+				t.Fatal("invented mapping")
+			}
+			if _, ok := p.Lookup(nil); ok {
+				t.Fatal("wrong unit size")
+			}
+			if _, ok := p.Lookup([]rune{'A', ' ', 'X'}); ok {
+				t.Fatal("wrong unit size")
+			}
+			// Neither input slices nor subsequent changes on disk alter the snapshot.
+			before := p.Digest()
+			os.WriteFile(filepath.Join(dir, "SOURCE.txt"), []byte("broken"), 0600)
+			if p.Digest() != before {
+				t.Fatal("mutable digest")
+			}
+			units[0] = 'A'
+			if c, ok := p.Lookup(units); !ok || c != 0xe040 {
+				t.Fatal("mutable codebook")
+			}
+			var names []string
+			for n := range files {
+				names = append(names, n)
+			}
+			sort.Strings(names)
+			stream := "hr-l2-patch-v1\n"
+			for _, n := range names {
+				stream += fmt.Sprintf("%s\t%d\t%s\n", n, len(files[n]), hash(files[n]))
+			}
+			if before != hash([]byte(stream)) {
+				t.Fatal("noncanonical digest")
+			}
+		})
+	}
+	for _, code := range []string{"zh-TW", "EN", "", "fr"} {
+		if _, e := Load("not-present", code); e == nil {
+			t.Fatalf("accepted %q", code)
+		}
+	}
+	var zero Patch
+	if zero.Language() != "" {
+		t.Fatal("zero language")
+	}
+	if zero.Digest() != "" {
+		t.Fatal("zero digest")
+	}
+	if _, ok := zero.Lookup([]rune{'A'}); ok {
+		t.Fatal("zero lookup")
+	}
+	if _, e := zero.Apply(nil, 0); e == nil {
+		t.Fatal("zero apply")
+	}
+	p := loadOK(t, synthetic(t, "en"), "en")
+	if out, e := p.Apply(make([]byte, cfontSize), 1); e == nil || out != nil {
+		t.Fatal("synthetic original accepted")
+	}
+	if out, e := p.Apply(nil, -1); e == nil || out != nil {
+		t.Fatal("negative adoption accepted")
+	}
+}
