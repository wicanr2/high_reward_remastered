+		{"language", "SOURCE.txt", "parameter", func(b []byte) []byte { return bytes.Replace(b, []byte("language\ten"), []byte("language\tja"), 1) }, false},
+		{"algorithm", "SOURCE.txt", "parameter", func(b []byte) []byte { return bytes.Replace(b, []byte("threshold\t128"), []byte("threshold\t127"), 1) }, false},
+		{"leadingzero", "SOURCE.txt", "parameter", func(b []byte) []byte { return bytes.Replace(b, []byte("pixel_size\t10"), []byte("pixel_size\t010"), 1) }, false},
+		{"unknownkey", "SOURCE.txt", "key set", func(b []byte) []byte { return append(b, []byte("zzz\tx\n")...) }, false},
+		{"missingkey", "SOURCE.txt", "key set", func(b []byte) []byte { return bytes.Replace(b, []byte("cell\t15x15\n"), nil, 1) }, false},
+		{"duplicatekey", "SOURCE.txt", "order", func(b []byte) []byte { return append(b, []byte("language\ten\n")...) }, false},
+		{"BOM", "SOURCE.txt", "UTF-8", func(b []byte) []byte { return append([]byte{0xef, 0xbb, 0xbf}, b...) }, false},
+		{"NUL", "SOURCE.txt", "UTF-8", func(b []byte) []byte { b[0] = 0; return b }, false},
+		{"invalidUTF8", "SOURCE.txt", "UTF-8", func(b []byte) []byte { b[0] = 255; return b }, false},
+		{"noLF", "SOURCE.txt", "UTF-8", func(b []byte) []byte { return b[:len(b)-1] }, false},
+		{"container-id", "SOURCE.txt", "container", func(b []byte) []byte { return bytes.Replace(b, []byte("sha256:"), []byte("sha255:"), 1) }, false},
+		{"source-hash", "SOURCE.txt", "SOURCE hash", func(b []byte) []byte {
+			return bytes.Replace(b, []byte(strings.Repeat("a", 64)), []byte(strings.Repeat("A", 64)), 1)
+		}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, e := Load(writePatch(t, alter(base, tc.file, tc.fn, tc.rehash)), "en")
+			if e == nil || !strings.Contains(e.Error(), tc.want) {
+				t.Fatalf("got %v; expected %s", e, tc.want)
+			}
+		})
+	}
+	for _, cp := range []string{"U+0009", "U+000A", "U+200B", "U+E000", "U+0378", "U+0301", "U+0903", "U+20DD", "U+2028", "U+2029", "U+00A0", "U+3000"} {
+		t.Run(cp, func(t *testing.T) {
+			mut := alter(base, "charmap-en.tsv", func(b []byte) []byte { return bytes.Replace(b, []byte("U+0020"), []byte(cp), 1) }, true)
+			if _, e := Load(writePatch(t, mut), "en"); e == nil || !strings.Contains(e.Error(), "unsupported scalar") {
+				t.Fatal(e)
+			}
+		})
+	}
+	// Valid provenance-only edits change identity without imposing a tool allowlist.
+	mut := alter(base, "SOURCE.txt", func(b []byte) []byte { return bytes.Replace(b, []byte("synthetic-test-v1"), []byte("new-tool-v2"), 1) }, false)
+	if loadOK(t, mut, "en").Digest() == loadOK(t, base, "en").Digest() {
+		t.Fatal("SOURCE not bound")
+	}
+}
+
+func TestFilesystemBoundary(t *testing.T) {
+	base := synthetic(t, "en")
+	for _, kind := range []string{"missing", "extra", "case", "subdirectory", "symlink", "oversize", "empty-map"} {
+		t.Run(kind, func(t *testing.T) {
+			dir := writePatch(t, base)
+			name := filepath.Join(dir, "OFL.txt")
+			switch kind {
+			case "missing":
+				os.Remove(name)
+			case "extra":
+				os.WriteFile(filepath.Join(dir, "extra"), nil, 0600)
+			case "case":
+				os.Rename(name, filepath.Join(dir, "ofl.txt"))
+			case "subdirectory":
+				os.Remove(name)
+				os.Mkdir(name, 0700)
+			case "symlink":
+				os.Remove(name)
+				os.Symlink("SOURCE.txt", name)
+			case "oversize":
+				f, e := os.OpenFile(name, os.O_WRONLY, 0600)
+				if e != nil {
+					t.Fatal(e)
+				}
+				if e = f.Truncate(fileLimit + 1); e != nil {
+					t.Fatal(e)
+				}
+				f.Close()
+			case "empty-map":
+				files := alter(base, "charmap-en.tsv", func(b []byte) []byte { return []byte("left_cp\tright_cp\tcode_hex\n") }, true)
+				for n, b := range files {
+					os.WriteFile(filepath.Join(dir, n), b, 0600)
+				}
+			}
+			if _, e := Load(dir, "en"); e == nil {
+				t.Fatal("accepted " + kind)
+			}
+		})
+	}
+	dir := writePatch(t, base)
+	link := filepath.Join(t.TempDir(), "link")
+	if e := os.Symlink(dir, link); e != nil {
+		t.Fatal(e)
+	}
+	if _, e := Load(link, "en"); e == nil {
+		t.Fatal("root link accepted")
+	}
+}
+
+func TestAllIndicesAndScalarBoundaries(t *testing.T) {
+	seen := make(map[int]bool)
+	for _, v := range available(nil) {
+		index, e := glyphIndex(v)
+		if e != nil {
+			t.Fatal(e)
+		}
+		trail := int(v & 255)
+		adjust := 64
+		if trail >= 161 {
+			adjust = 98
+		}
+		independent := (int(v>>8)-164)*157 + trail - adjust + 365
+		if index != independent || seen[index] {
+			t.Fatalf("index collision %04X", v)
+		}
+		seen[index] = true
+	}
+	if len(seen) != 3276 {
+		t.Fatal(len(seen))
+	}
+	for _, lang := range []string{"zh-CN", "ja", "ko", "en"} {
+		if _, e := scalar("U+0020", lang); e != nil {
+			t.Fatal(e)
+		}
+		_, e := scalar("U+3000", lang)
+		if (e == nil) != (lang != "en") {
+			t.Fatal(lang, e)
+		}
+	}
+}
+
+func TestConcurrentQueries(t *testing.T) {
+	p := loadOK(t, synthetic(t, "en"), "en")
+	digest := p.Digest()
+	var group sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			for j := 0; j < 100; j++ {
+				input := []rune{'A', ' '}
+				code, ok := p.Lookup(input)
+				input[0] = 'X'
+				if !ok || code != 0xe040 || p.Digest() != digest || p.Language() != "en" {
+					t.Error("concurrent query changed snapshot")
+					return
+				}
+			}
+		}()
+	}
+	group.Wait()
+}
+
+func TestScalarWhitespaceGlyphs(t *testing.T) {
+	for _, language := range []string{"zh-CN", "ja", "ko"} {
+		for _, cp := range []string{"U+0020", "U+3000"} {
+			t.Run(language+cp, func(t *testing.T) {
+				base := synthetic(t, language)
+				// Make the last unit the whitespace, keeping scalar order canonical.
+				if cp == "U+0020" {
+					base = alter(base, "charmap-"+language+".tsv", func(b []byte) []byte { return bytes.Replace(b, []byte("U+0041"), []byte(cp), 1) }, true)
+				} else {
+					base = alter(base, "charmap-"+language+".tsv", func(b []byte) []byte { return bytes.Replace(b, []byte("U+0043"), []byte(cp), 1) }, true)
+				}
+				if _, e := Load(writePatch(t, base), language); e == nil || !strings.Contains(e.Error(), "space glyph") {
+					t.Fatal(e)
+				}
+				base = alter(base, "glyphs-"+language+".bin", func(b []byte) []byte {
+					start := 2
+					if cp == "U+3000" {
+						start = 66
+					}
+					clear(b[start : start+30])
+					return b
+				}, true)
+				loadOK(t, base, language)
+			})
+		}
+	}
+}
+
+func TestLocalOriginalRoundTrip(t *testing.T) {
+	patchDir := os.Getenv("HR_PATCH_TESTDIR")
+	fontFile := os.Getenv("HR_CFONT_TESTFILE")
+	if patchDir == "" || fontFile == "" {
+		t.Skip("local OFL patch and original CFONT required")
+	}
+	p, e := Load(patchDir, "en")
+	if e != nil {
+		t.Fatal(e)
+	}
+	original, e := os.ReadFile(fontFile)
+	if e != nil {
+		if os.IsNotExist(e) {
+			t.Skip("original CFONT absent")
+		}
+		t.Fatal(e)
+	}
+	zero, e := p.Apply(original, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if !bytes.Equal(zero, original) {
+		t.Fatal("zero adoption changed original")
+	}
+	zero[0] ^= 1
+	if bytes.Equal(zero, original) {
+		t.Fatal("zero adoption aliases original")
+	}
+	changed, e := p.Apply(original, 1)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if hash(changed) != "58dc44cfc78876af26068f55f9b5a4eda65d64a9facb5cc2aed406f668498876" {
+		t.Fatal(hash(changed))
+	}
+	if len(changed) != 416010 {
+		t.Fatal("length changed")
+	}
+	b, e := os.ReadFile(filepath.Join(patchDir, "glyphs-en.bin"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	expect := make(map[int][]byte)
+	for i := 0; i < len(b); i += 32 {
+		lead, trail := int(b[i]), int(b[i+1])
+		adjust := 64
+		if trail >= 161 {
+			adjust = 98
+		}
+		index := (lead-164)*157 + trail - adjust + 365
+		expect[index] = b[i+2 : i+32]
+	}
+	if len(expect) != 230 {
+		t.Fatal("incomplete prebaked patch")
+	}
+	for i := 0; i < 13867; i++ {
+		want, ok := expect[i]
+		if !ok {
+			want = original[i*30 : (i+1)*30]
+		}
+		if !bytes.Equal(changed[i*30:(i+1)*30], want) {
+			t.Fatalf("full read-back slot %d", i)
+		}
+	}
+	if _, e := p.Apply(original, -1); e == nil {
+		t.Fatal("negative adoption")
+	}
+	if _, e := p.Apply(original[:len(original)-1], 1); e == nil {
+		t.Fatal("short original")
+	}
+	bad := bytes.Clone(original)
+	bad[0] ^= 1
+	if out, e := p.Apply(bad, 1); e == nil || out != nil {
+		t.Fatal("mismatch original accepted")
+	}
+	changed[0] ^= 1
+	again, e := p.Apply(original, 7)
+	if e != nil || hash(again) != "58dc44cfc78876af26068f55f9b5a4eda65d64a9facb5cc2aed406f668498876" {
+		t.Fatal("returned slice changed patch")
+	}
+	t.Logf("patch=%s positive=%s zero=%s; full 13867-slot read-back", p.Digest(), hash(again), hash(original))
+}
