+// All in-repository bitmaps and units below are synthetic. OFL and the
+// trusted code list are independent public text/measurement fixtures.
+func synthetic(t *testing.T, language string) map[string][]byte {
+	t.Helper()
+	read := func(name string) []byte {
+		b, e := os.ReadFile(filepath.Join("testdata", name))
+		if e != nil {
+			t.Fatal(e)
+		}
+		return b
+	}
+	files := map[string][]byte{"OFL.txt": read("OFL.txt"), "reserved-codes.tsv": read("reserved-codes.tsv")}
+	reserved, err := parseReserved(files["reserved-codes.tsv"])
+	if err != nil {
+		t.Fatal(err)
+	}
+	values := available(reserved)[:3]
+	var cmap strings.Builder
+	if language == "en" {
+		cmap.WriteString("left_cp\tright_cp\tcode_hex\n")
+	} else {
+		cmap.WriteString("unicode\tcode_hex\n")
+	}
+	for i, v := range values {
+		if language == "en" {
+			fmt.Fprintf(&cmap, "U+%04X\tU+0020\t%04X\n", 'A'+i, v)
+		} else {
+			fmt.Fprintf(&cmap, "U+%04X\t%04X\n", 'A'+i, v)
+		}
+		var record [32]byte
+		binary.BigEndian.PutUint16(record[:2], v)
+		for row := 0; row < 15; row++ {
+			binary.BigEndian.PutUint16(record[2+row*2:], uint16(0x8000>>i))
+		}
+		files["glyphs-"+language+".bin"] = append(files["glyphs-"+language+".bin"], record[:]...)
+	}
+	files["charmap-"+language+".tsv"] = []byte(cmap.String())
+	face := map[string]string{"en": "3\tTC", "zh-CN": "2\tSC", "ja": "0\tJP", "ko": "1\tKR"}[language]
+	f := strings.Split(face, "\t")
+	source := map[string]string{
+		"format": "hr-l2-source-v1", "language": language, "units_sha256": strings.Repeat("a", 64), "unicode_version": "15.0.0",
+		"font_file": "NotoSansCJK-Regular.ttc", "font_sha256": fontHash, "font_version": "Version 2.004;hotconv 1.0.118;makeotfexe 2.5.65603",
+		"face_index": f[0], "face_name": "Noto Sans CJK " + f[1], "pillow_version": "12.3.0", "fonttools_version": "4.66.1",
+		"pixel_size": "13", "cell": "15x15", "threshold": "128", "placement": "mask-center-floor", "unit_mode": "scalar15",
+		"container_image_id": "sha256:" + strings.Repeat("b", 64), "rasterizer_version": "synthetic-test-v1", "rasterizer_sha256": strings.Repeat("c", 64),
+	}
+	if language == "en" {
+		source["pixel_size"], source["placement"], source["unit_mode"] = "10", "pair2x7-baseline11", "pair2x7"
+		for k, v := range map[string]string{"source_canvas": "12x15", "source_anchor": "ls", "source_origin": "0,11", "source_clipping": "canvas-before-getbbox", "source_crop": "0,0,bbox-right,15", "shrink": "width-gt7:BILINEAR:7x15", "half_origin": "0,0;8,0", "blank_column": "7", "blank_scalar": "U+0020"} {
+			source[k] = v
+		}
+	}
+	for k, n := range map[string]string{"glyphs_sha256": "glyphs-" + language + ".bin", "charmap_sha256": "charmap-" + language + ".tsv", "reserved_sha256": "reserved-codes.tsv", "ofl_sha256": "OFL.txt"} {
+		source[k] = hash(files[n])
+	}
+	files["SOURCE.txt"] = sourceBytes(source)
+	return files
+}
+
+func sourceBytes(source map[string]string) []byte {
+	var keys []string
+	for k := range source {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var b strings.Builder
+	for _, k := range keys {
+		fmt.Fprintf(&b, "%s\t%s\n", k, source[k])
+	}
+	return []byte(b.String())
+}
+
+func alter(files map[string][]byte, name string, fn func([]byte) []byte, rehash bool) map[string][]byte {
+	out := make(map[string][]byte)
+	for n, b := range files {
+		out[n] = bytes.Clone(b)
+	}
+	out[name] = fn(out[name])
+	if rehash && name != "SOURCE.txt" {
+		key := map[string]string{"glyphs-en.bin": "glyphs_sha256", "charmap-en.tsv": "charmap_sha256", "reserved-codes.tsv": "reserved_sha256", "OFL.txt": "ofl_sha256"}[name]
+		if strings.HasPrefix(name, "glyphs-") {
+			key = "glyphs_sha256"
+		}
+		if strings.HasPrefix(name, "charmap-") {
+			key = "charmap_sha256"
+		}
+		var source = make(map[string]string)
+		for _, line := range strings.Split(strings.TrimSuffix(string(out["SOURCE.txt"]), "\n"), "\n") {
+			f := strings.Split(line, "\t")
+			source[f[0]] = f[1]
+		}
+		source[key] = hash(out[name])
+		out["SOURCE.txt"] = sourceBytes(source)
+	}
+	return out
+}
+
+func writePatch(t *testing.T, files map[string][]byte) string {
+	t.Helper()
+	dir := t.TempDir()
+	for n, b := range files {
+		if e := os.WriteFile(filepath.Join(dir, n), b, 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+	return dir
+}
+
+func loadOK(t *testing.T, files map[string][]byte, language string) *Patch {
+	t.Helper()
+	p, e := Load(writePatch(t, files), language)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return p
+}
