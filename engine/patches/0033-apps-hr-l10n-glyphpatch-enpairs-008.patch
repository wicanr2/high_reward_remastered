+package budget
+
+import (
+	"bytes"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestLimitsOriginalMetricsAndSnapshot(t *testing.T) {
+	orig := []byte("%s" + strings.Repeat("AB", 22) + "\n" + strings.Repeat("A", 31))
+	before := bytes.Clone(orig)
+	in := Input{ID: "synthetic", File: "SYSTEM.MES", Orig: orig}
+	got, vs := Limits(in)
+	if len(vs) != 0 || got.Width != 30 || got.Expanded != 64 || got.Rows != 4 || got.Length != 511 || !reflect.DeepEqual(got.Specs, []string{"%s"}) {
+		t.Fatalf("limits %+v %+v", got, vs)
+	}
+	got.Specs[0] = "%d"
+	again, _ := Limits(in)
+	if again.Specs[0] != "%s" || !bytes.Equal(orig, before) {
+		t.Fatal("input or specifications mutated")
+	}
+	// Raw percent has priority even after a lone high byte.
+	got, vs = Limits(Input{File: "SP.MES", Orig: []byte{0xA4, '%', 's'}})
+	if len(vs) != 0 || !reflect.DeepEqual(got.Specs, []string{"%s"}) {
+		t.Fatalf("percent priority %+v %+v", got, vs)
+	}
+	got, vs = Limits(Input{File: "SYSTEM.MES", Orig: []byte(strings.Repeat("A\n", 5))})
+	if len(vs) != 0 || got.Rows != 6 {
+		t.Fatalf("tail empty row %+v %+v", got, vs)
+	}
+}
+
+func TestLimitsInvalidAndConversion(t *testing.T) {
+	for _, text := range []string{"%%", "%.d", "%.s", "%1.d", "%1.s", "%ls", "%*d", "%f"} {
+		if _, vs := Limits(Input{ID: "x", File: "SP.MES", Orig: []byte(text)}); len(vs) == 0 || vs[0].ID != "x" || vs[0].Rule != RulePlaceholder {
+			t.Fatalf("accepted invalid specification")
+		}
+	}
+	if _, vs := Limits(Input{ID: "x", File: "unknown"}); len(vs) != 1 || vs[0].Rule != RuleLineWidth {
+		t.Fatal(vs)
+	}
+	for _, tc := range []struct {
+		text   string
+		n, exp int
+	}{{"%.0d", 4, 6}, {"%10ld", 5, 11}, {"%s", 2, 20}, {"%999999999999999999999999999d", 29, 1 << 20}} {
+		n, e, ok := ConversionAt([]byte(tc.text), 0)
+		if !ok || n != tc.n || e != tc.exp {
+			t.Fatalf("conversion n=%d e=%d ok=%v", n, e, ok)
+		}
+	}
+	for _, offset := range []int{-1, 0, 1, 2} {
+		if _, _, ok := ConversionAt([]byte("A"), offset); ok {
+			t.Fatal("invalid offset")
+		}
+	}
+}
