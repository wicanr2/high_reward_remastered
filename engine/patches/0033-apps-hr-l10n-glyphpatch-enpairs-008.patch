diff --git a/apps/hr/l10n/glyphpatch/open_unix.go b/apps/hr/l10n/glyphpatch/open_unix.go
new file mode 100644
index 0000000..b3ac34c
--- /dev/null
+++ b/apps/hr/l10n/glyphpatch/open_unix.go
@@ -0,0 +1,27 @@
+//go:build linux || darwin
+
+package glyphpatch
+
+import (
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// Do not follow a file replaced with a symlink after Lstat. Nonblocking open
+// also lets the caller reject a FIFO swapped into that interval via f.Stat.
+func openRegular(root *os.Root, name string) (*os.File, error) {
+	directory, err := root.Open(".")
+	if err != nil {
+		return nil, err
+	}
+	defer directory.Close()
+	// Root.OpenFile resolves symlinks before the final open syscall, so its
+	// flags alone cannot enforce this contract. Use the already-confined
+	// directory descriptor with an atomic final-component no-follow open.
+	fd, err := unix.Openat(int(directory.Fd()), name, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	return os.NewFile(uintptr(fd), name), nil
+}
